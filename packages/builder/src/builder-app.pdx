    border-radius: var(--pdx-radius-sm);
    cursor: pointer;
}

.ctl-group { display: flex; gap: 2px; }
.ctl-btn.active {
    background: var(--pdx-color-inset);
    font-weight: var(--pdx-weight-medium);
}

.spacer { flex: 1; }

.ctl-static {
    font-size: var(--pdx-text-xs);

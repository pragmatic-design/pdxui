}

.viol.error { border-left-color: var(--pdx-color-danger); }
.viol.warning { border-left-color: var(--pdx-color-warning); }
.viol.info { border-left-color: var(--pdx-color-border); }

.viol-rule {
    font-family: var(--pdx-font-mono);
    font-weight: var(--pdx-weight-medium);

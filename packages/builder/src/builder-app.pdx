    font-family: var(--pdx-font-mono);
    color: var(--pdx-color-muted);
}

.stage {
    flex: 1;
    display: flex;
    /* `safe` centring: an item WIDER than the stage aligns to the start instead of overflowing
       equally on both sides, where the left half is unreachable — a scroll container cannot
       scroll to a negative offset. Without it, "1280" on a narrow window hides its own left edge. */
    justify-content: safe center;
    overflow: auto;
    padding: var(--pdx-space-md);
    background: var(--pdx-color-inset);
    min-height: 0;
}

/* The preview is isolated on purpose: the previewed theme sets [pdx-theme] on its own
   <html>, so without the iframe it would restyle this shell too. */
.frame {
    height: 100%;
    /* A flex item shrinks by default, so the explicit width of a viewport preset would be a
       request the layout is free to ignore: "768" renders at 428 on a 460px stage, and the stage
       does not even scroll. A preview at a width nobody chose is a measurement of the wrong thing. */
    flex: none;
    /* Short fade so the reveal reads as intentional rather than as a blink. */
    transition: opacity 120ms ease-out;
    border: 1px solid var(--pdx-color-border);
    border-radius: var(--pdx-radius-sm);
    background: var(--pdx-color-bg);
}

/* ── Oracle panel ── */

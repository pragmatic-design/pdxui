<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS deployment of the PDX site (an SPA with history-mode routing).
  It needs the "URL Rewrite" module installed on IIS (https://www.iis.net/downloads/microsoft/url-rewrite).
  Without that module the <rewrite> section causes an HTTP 500.
  Harmless on GitHub Pages and other static hosts, which ignore it.
-->
<configuration>
  <system.webServer>

    <!-- SPA fallback: every request that is NOT a real file or folder → index.html,
         so an F5 on /components/pdx-button (a client-side route) does not give a 404. -->
    <rewrite>
      <rules>
        <!-- `/integrations` is BOTH an SPA route AND a real folder (the demos' iframes:
             /integrations/react|vue|angular/). The SPA rule below skips real directories, so an
             F5 on /integrations would give a 404. This rule catches ONLY the route's exact path
             → index.html; the files inside the folder (with a sub-path) do not match and are
             still served as static files. -->
        <rule name="SPA route over real folder" stopProcessing="true">
          <match url="^integrations/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>

        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <!-- do not rewrite known APIs or assets (there are none here, but the pattern is ready) -->
            <add input="{REQUEST_URI}" pattern="^/(assets|favicon|og|llms)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- MIME types IIS does not serve by default (or serves as octet-stream). -->
    <staticContent>
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" /><mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" /><mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".mjs" /><mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".wasm" /><mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>

    <!--
      Security headers.

      These headers DO arrive: `HEAD https://pdxui.com` →
      `Microsoft-IIS/8.5` and `x-content-type-options: nosniff` in the response. The site is NOT
      served by GitHub Pages, which would ignore this file and cannot send custom headers:
      `public/CNAME` is a misleading leftover, a Pages convention on a site Pages does not serve.

      The CSP — what it protects and what it does NOT. `script-src` has to allow `'unsafe-eval'`
      because the playground compiles with `new Function`, and that is the directive a CSP would
      most like to forbid. While it is there, this policy does NOT stop an injected inline script.
      It stops the rest: where script may be loaded from, plugins (`object-src 'none'`), rewriting
      the base URI, and framing by another origin (`frame-ancestors 'self'`, which a <meta
      http-equiv> could not even express; 'self' because /integrations frames the site's own
      /integrations/<app>/index.html). It is worth having; it is not the same as being protected,
      and this comment exists so that nobody reads it as a guarantee it is not.

      The other origins it names are the ones index.html loads, each by host: Google Fonts
      (fonts.googleapis.com for the stylesheet, fonts.gstatic.com for the files) and Cloudflare Web
      Analytics (static.cloudflareinsights.com for the beacon, cloudflareinsights.com where it
      reports).

      Removing `'unsafe-eval'` means moving the playground to a separate origin: the two are one
      decision, not two.

      `style-src 'unsafe-inline'` is a DIFFERENT and necessary allowance, not an oversight: the
      framework positions every floating element by writing inline style (`usePopover` does
      `content.style.position = 'fixed'`), and core+ui hold 266 assignments of that kind. Without
      it, popovers, tooltips, the select's dropdown and the calendar end up in the top-left corner.
      Inline style is a small allowance; inline SCRIPT is what a CSP exists to refuse — which is
      why the test forbids it per directive, not across the whole string.

      Asserted in `packages/core/tests/site-headers.test.ts`. In particular the test forbids
      `'unsafe-inline'` INSIDE `script-src` (not across the whole string, or it would reject the
      style-src above): it is the plausible future addition — someone adds an inline script, the
      console complains, and the quick fix is to allow it.
    -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- A long cache for assets with a hash in their name (immutable); no cache for the HTML. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public, immutable" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>

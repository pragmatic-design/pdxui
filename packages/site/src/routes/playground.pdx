<template>
  <div class="playground shell-wrap">
    <div class="pg-head">
      <h1 class="page-title metal-gradient">Playground</h1>
      <span :class="ok ? 'pg-status ok' : 'pg-status err'">{{ status }}</span>
    </div>
    <p class="page-sub">Write a real <code>.pdx</code> component — state, <code>$signal</code>, <code>$derived</code>, events. It compiles in your browser as you type.</p>

    <div class="pg-grid">
      <div class="pg-pane">
        <span class="pg-label">Editor — .pdx</span>
        <textarea class="pg-editor" spellcheck="false" :ref="editorRef" @input="onInput"></textarea>
      </div>
      <div class="pg-pane">
        <span class="pg-label">Preview</span>
        <div class="glass pg-preview" :ref="previewRef"></div>
        @if (buildError) {
          <pre class="pg-error">{{ buildError }}</pre>
        }
      </div>
    </div>
  </div>
</template>

<script setup>
@page '/playground';
@title 'Playground — PDX';
import { onMount, onDestroy, onGlobalError } from '@pdxui/core';
import { DEFAULT_SRC } from '../lib/playground-default';

let editorRef = $signal(null);
let previewRef = $signal(null);
let status = $signal('loading…');
let buildError = $signal('');
let ok = $signal(true);
let _src = $signal(DEFAULT_SRC);
let _ready = $signal(false);
let _timer = 0;
// The compiler, loaded with the route rather than with the site: it parses with TypeScript, and a
// static import would put 9.3 MB of it in the entry chunk of every page.
let _compilePdx = null;

function runBuild() {
  const _el = previewRef;
  if (!_el || !_ready) return;
  buildError = '';
  try {
    const _res = _compilePdx(_src);
    _el.innerHTML = '<' + _res.tag + '></' + _res.tag + '>';
    if (!buildError) { ok = true; status = '✓ compiled'; }
  } catch (e) {
    ok = false;
    status = '✗ compile error';
    buildError = (e && e.message) ? e.message : String(e);
  }
}

function onInput(e) {
  _src = e.target.value;
  status = 'building…';
  clearTimeout(_timer);
  _timer = setTimeout(runBuild, 250);
}

onMount(() => {
  const _ed = editorRef;
  if (_ed) _ed.value = _src;
  // Runtime errors (a component throwing during render) surface here too.
  const _dispose = onGlobalError((info) => {
    const _err = info && (info.error || info);
    ok = false;
    status = '✗ runtime error';
    buildError = (_err && _err.message) ? _err.message : String(_err);
  });
  onDestroy(_dispose);
  // Register all <pdx-*> so the user's template can use them, load the compiler, then first build.
  Promise.all([import('@pdxui/ui/all'), import('../lib/playground-compile')]).then(([, _mod]) => {
    _compilePdx = _mod.compilePdx;
    _ready = true;
    runBuild();
  });
});
</script>

<style scoped>
.playground { padding-top: 3rem; padding-bottom: 4rem; }
.pg-head { display: flex; align-items: center; gap: 1rem; }
.page-title { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin: 0; }
.pg-status { font-size: 0.78rem; font-family: var(--font-mono); padding: 3px 10px; border-radius: 999px; border: 1px solid var(--outline); }
.pg-status.ok { color: var(--status-ok); border-color: color-mix(in srgb, var(--status-ok) 40%, transparent); }
.pg-status.err { color: var(--status-err); border-color: color-mix(in srgb, var(--status-err) 40%, transparent); }
.page-sub { color: var(--ink-muted); margin-top: 0.5rem; }
.page-sub code { color: var(--gold-fixed); }
.pg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-top: 1.6rem; align-items: start; }
.pg-pane { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
.pg-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-muted); }
.pg-editor {
  width: 100%; min-height: 420px; padding: 1.1rem; border-radius: 14px; resize: vertical;
  background: var(--code-bg); border: 1px solid var(--outline); color: var(--code-ink);
  font-family: var(--font-mono); font-size: 0.86rem; line-height: 1.6; white-space: pre; tab-size: 2;
}
.pg-editor:focus { outline: none; border-color: var(--gold); box-shadow: var(--glow-gold); }
.pg-preview { min-height: 200px; padding: 2rem; border-radius: 14px; }
.pg-error {
  margin: 0; padding: 0.9rem 1rem; border-radius: 12px; white-space: pre-wrap; overflow-x: auto;
  background: color-mix(in srgb, var(--status-err) 8%, transparent); border: 1px solid color-mix(in srgb, var(--status-err) 35%, transparent); color: var(--status-err);
  font-family: var(--font-mono); font-size: 0.8rem;
}
@media (max-width: 820px) { .pg-grid { grid-template-columns: minmax(0, 1fr); } } /* bare 1fr grows to min-content */
</style>

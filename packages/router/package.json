{
  "name": "@pdxui/router",
  "version": "1.0.0-alpha.1",
  "license": "MIT",

  "publishConfig": { "access": "public" },


  "repository": { "type": "git", "url": "git+https://github.com/pragmatic-design/pdxui.git", "directory": "packages/router" },


  "homepage": "https://pdxui.com",


  "bugs": { "url": "https://github.com/pragmatic-design/pdxui/issues" },
  "type": "module",
  "description": "Compiled router for PDX UI — generates optimized ad-hoc router from @page declarations",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "custom-elements.json"
  ],
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
"development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./outlet": {
"development": "./src/outlet.ts",
      "types": "./dist/outlet.d.ts",
      "import": "./dist/outlet.js"
    },
    "./link": {
"development": "./src/link.ts",
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js"
    }
  },
  "sideEffects": [
      "src/outlet.ts",
      "src/link.ts",
      "dist/index.js",
      "dist/outlet.js",
      "dist/link.js"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pdxui/core": "workspace:*"
  },
  "peerDependencies": {
    "@pdxui/compiler": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@pdxui/compiler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pdxui/compiler": "workspace:*",
    "typescript": "^5.8.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "happy-dom": "^20.14.5"
  }
}

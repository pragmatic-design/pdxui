{
    // The package's OWN project, widened to everything it holds.
    //
    // `tsconfig.json` is the BUILD: `rootDir: src`, `outDir: dist`, and adding `tests/` to it would
    // both break the root and emit declarations for test files. So the tests get a project of their
    // own that emits nothing — the shape a monorepo usually reaches for, and the one
    // `packages/design/tsconfig.engine.json` uses too.
    //
    // It exists because a type gate that reads only `src/` leaves the test suites compiled by
    // nothing, and `tsc` pointed at an unchecked suite finds tests that cannot fail.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // The REPO root, because nothing is emitted and a test may legitimately
        // import a sibling package's source — the CLI's theme tests read the
        // builder's config. With `rootDir` at the package, TS6059 fires on every
        // such file: "not under rootDir", about a program that produces no output.
        "rootDir": "../..",
        "declaration": false,
        "declarationMap": false,
        "types": ["node"],
        "typeRoots": ["../compiler/node_modules/@types"]
    },
    // `tests/builder-themes.test.ts` reads the BUILDER's config source, which uses
    // `import.meta.env`. That property is Vite's and reaches `ImportMeta` only through the
    // builder's own ambient declaration — a file this program does not otherwise pull in.
    // `"*.ts"` is the package ROOT: `vite.config.ts` and friends. A build config that does
    // not typecheck is a build that breaks on a rename nobody sees, and `builder` and
    // `showcase` do the same.
    "include": ["*.ts", "src/**/*.ts", "tests/**/*.ts", "../builder/src/vite-env.d.ts"],
    "exclude": ["node_modules", "dist"]
}

{
  "name": "@pdxui/lsp",
  "version": "1.0.0-alpha.1",
  "license": "MIT",

  "publishConfig": { "access": "public" },


  "repository": { "type": "git", "url": "git+https://github.com/pragmatic-design/pdxui.git", "directory": "packages/lsp" },


  "homepage": "https://pdxui.com",


  "bugs": { "url": "https://github.com/pragmatic-design/pdxui/issues" },
  "type": "module",
  "description": "Language Server Protocol implementation for .pdx files",
  "main": "dist/server.cjs",
  "exports": {
    ".": {
      "development": "./src/server.ts",
      "default": "./dist/server.cjs"
    },
    "./typecheck": {
      "development": "./src/typecheck.ts",
      "default": "./dist/typecheck.cjs"
    },
    "./package.json": "./package.json"
  },

  "files": ["dist"],
  "bin": {
    "pdx-lsp": "./dist/server.cjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "pnpm build --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@pdxui/compiler": "workspace:*",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": { "optional": true }
  }
}

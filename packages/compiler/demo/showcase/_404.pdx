<template>
  <div class="not-found">
    <h1 class="code">404</h1>
    <p class="message">{{ $t('error.notFound') }}</p>
    <p class="path"><code>{{ path }}</code></p>
    <button @click="goHome" class="home-link">← {{ $t('error.backHome') }}</button>
  </div>
</template>

<script setup>
import { navigate } from '@pdxui/router';

@prop code: string = '404';
@prop path: string = '';

function goHome() {
  navigate('/dashboard');
}
</script>


<template>
  <div class="task-form">
    <h2>New Task</h2>
    <form @submit="handleSubmit">
      <div class="field">
        <label>Task *</label>
        <input type="text" :value="task.fields.text.value()"
               @input="onTextInput" @blur="onTextBlur"
               placeholder="What needs to be done?"
               :class="task.fields.text.error() ? 'input-error' : ''" />
        @if (task.fields.text.error()) {
          <span class="err">{{ task.fields.text.error() }}</span>
        }
      </div>
      <div class="field">
        <label>Category *</label>
        <select @change="onCatChange" @blur="onCatBlur">
          <option value="">Select...</option>
          <option value="design" :selected="task.fields.category.value() === 'design'">Design</option>
          <option value="dev" :selected="task.fields.category.value() === 'dev'">Development</option>
          <option value="test" :selected="task.fields.category.value() === 'test'">Testing</option>
        </select>
        @if (task.fields.category.error()) {
          <span class="err">{{ task.fields.category.error() }}</span>
        }
      </div>
      <div class="actions">
        <button type="submit" :disabled="task.submitting()" class="btn-primary">
          @if (task.submitting()) { Adding... } @else { Add Task }
        </button>
        <button type="button" @click="resetForm" class="btn-secondary">Clear</button>
        <span class="meta">{{ statusText }}</span>
      </div>
    </form>
    @if (task.state() === 'success') {
      <div class="success">Task added to store!</div>
    }
  </div>
</template>

<script setup>
import { useTasks } from './task-store.pdx';

@page '/create' { preload };
@transition 'slide-right';
@title 'New Task — TaskMgr';

const store = useTasks();

@form task: {
  text: string { required, minLength: 3 },
  category: string { required },
}

const statusText = $derived(
  task.dirty() ? 'Modified' : task.submitted() ? 'Saved' : ''
);

const handleSubmit = task.handleSubmit(async (values) => {
  await new Promise(r => setTimeout(r, 300));
  store.addTask(values.text, values.category);
});

function onTextInput(e) { task.fields.text.onChange(e.target.value); }
function onTextBlur() { task.fields.text.onBlur(); }
function onCatChange(e) { task.fields.category.onChange(e.target.value); }
function onCatBlur() { task.fields.category.onBlur(); }
function resetForm() { task.reset(); }
</script>

<style scoped>
  .task-form { background: white; border-radius: 10px; padding: 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  .task-form h2 { font-size: 1.1rem; margin: 0 0 0.8rem 0; }
  .field { margin-bottom: 10px; }
  .field label { display: block; font-size: 0.8rem; color: #666; margin-bottom: 3px; }
  .field input, .field select { width: 100%; padding: 8px 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 0.9rem; }
  .field input:focus, .field select:focus { border-color: #3949ab; outline: none; }
  .field .input-error { border-color: #e53935; }
  .err { color: #e53935; font-size: 0.75rem; margin-top: 2px; display: block; }
  .actions { display: flex; gap: 8px; align-items: center; margin-top: 12px; }
  .meta { margin-left: auto; font-size: 0.75rem; color: #888; }
  .btn-primary { padding: 8px 18px; background: #3949ab; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
  .btn-primary:hover { background: #303f9f; }
  .btn-primary:disabled { background: #bbb; cursor: not-allowed; }
  .btn-secondary { padding: 8px 18px; background: #f5f5f5; color: #333; border: 1px solid #ddd; border-radius: 6px; cursor: pointer; font-size: 0.85rem; }
  .success { margin-top: 8px; padding: 8px 12px; background: #e8f5e9; color: #2e7d32; border-radius: 6px; font-size: 0.85rem; }
</style>

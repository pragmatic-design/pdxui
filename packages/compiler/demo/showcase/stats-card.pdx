<template>
  <div class="stats-card">
    <h2>Quick Stats</h2>
    <div class="stat-grid">
      <div class="stat">
        <div class="stat-value">{{ total }}</div>
        <div class="stat-label">Total</div>
      </div>
      <div class="stat">
        <div class="stat-value">{{ done }}</div>
        <div class="stat-label">Done</div>
      </div>
      <div class="stat">
        <div class="stat-value">{{ pending }}</div>
        <div class="stat-label">Pending</div>
      </div>
      <div class="stat">
        <div class="stat-value">{{ percent }}%</div>
        <div class="stat-label">Complete</div>
      </div>
    </div>
    <div class="progress-bar">
      <div class="progress-fill" :style="barStyle"></div>
    </div>
  </div>
</template>

<script setup>
  @prop total: number = 0;
  @prop done: number = 0;

  const pending = $derived((Number(total) || 0) - (Number(done) || 0));
  const percent = $derived(
    (Number(total) || 0) > 0 ? Math.round((Number(done) || 0) / (Number(total) || 1) * 100) : 0
  );
  const barStyle = $derived(`width: ${percent}%`);
</script>

<style scoped>
  .stats-card { background: white; border-radius: 10px; padding: 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
  .stats-card h2 { font-size: 1.1rem; margin: 0 0 0.8rem 0; }
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; text-align: center; }
  .stat-value { font-size: 1.6rem; font-weight: 700; color: #3949ab; }
  .stat-label { font-size: 0.7rem; color: #999; text-transform: uppercase; letter-spacing: 0.5px; }
  .progress-bar { height: 6px; background: #e8eaf6; border-radius: 3px; margin-top: 12px; overflow: hidden; }
  .progress-fill { height: 100%; background: #4caf50; border-radius: 3px; transition: width 0.3s ease; }
</style>

<template>
  <div class="todo">
    <h3>{{ title }}</h3>
    <div class="input-row">
      <input type="text" ::value="newItem" placeholder="Add item..." @keydown.enter="addItem">
      <button @click="addItem">Add</button>
    </div>
    <span class="remaining">{{ remaining }} remaining</span>
    @for (items as item; track item.id) {
      <div class="todo-item">
        <span>{{ item.text }}</span>
        <button class="remove" @click="remove(item.id)">×</button>
      </div>
    }
    @if (items.length === 0) {
      <div class="empty">No items yet. Add one above!</div>
    }
  </div>
</template>

<script setup>
  @prop title: string = 'Todo List';

  let items = $signal([
    { id: 1, text: 'Learn @pdxui/core' },
    { id: 2, text: 'Build .pdx components' },
    { id: 3, text: 'Ship it!' },
  ]);
  let newItem = $signal('');
  let nextId = 4;

  const remaining = $derived(items.length);

  function addItem() {
    if (!newItem.trim()) return;
    items = [...items, { id: nextId++, text: newItem }];
    newItem = '';
  }

  function remove(id) {
    items = items.filter(i => i.id !== id);
  }
</script>

<style scoped>
  .todo { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
  .input-row { display: flex; gap: 0.5rem; margin: 0.75rem 0; }
  .input-row input { flex: 1; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; }
  .input-row button { padding: 0.5rem 1rem; background: #4361ee; color: white; border: none; border-radius: 4px; cursor: pointer; }
  .todo-item { display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px solid #eee; }
  .remove { background: none; border: none; color: #e63946; cursor: pointer; font-size: 1.2rem; }
  .remaining { font-size: 0.85rem; color: #666; }
  .empty { color: #888; font-style: italic; margin-top: 0.5rem; }
</style>

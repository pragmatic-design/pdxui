<template>
  <div class="demo">
    <h2>Icon System</h2>
    <p class="desc">Agnostic registry: qualsiasi set SVG. Sizing consistente. ARIA-aware.</p>

    <section>
      <h3>Icon Registry</h3>
      <div class="row">
        <button class="pdx-primary" @click="doRegister">Register "demo" set</button>
        <button class="pdx-secondary" @click="doResolve">Resolve "check"</button>
        <button class="pdx-secondary" @click="doMissing">Resolve "missing"</button>
      </div>
      <div class="result">{{ resultText }}</div>
    </section>

    <section>
      <h3>Consistent Sizing</h3>
      <p class="desc">xs(12px) sm(16px) md(20px) lg(24px) xl(32px)</p>
      <div class="size-row">
        @for (sizeList as s; track s.name) {
          <div class="size-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" :style="'width:' + s.px + 'px;height:' + s.px + 'px'">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
            <span class="size-label">{{ s.name }} ({{ s.px }}px)</span>
          </div>
        }
      </div>
    </section>

    <section>
      <h3>All Demo Icons</h3>
      <div class="icon-grid">
        @for (iconEntries as entry; track entry.name) {
          <div class="icon-cell" :ref="entry.ref">
            <span class="icon-name">{{ entry.name }}</span>
          </div>
        }
      </div>
    </section>

    <section>
      <h3>&lt;pdx-icon&gt; Component</h3>
      <p class="desc">Web Component with name/set/svg/src/size/label props. Sizing via CSS custom properties. ARIA-aware.</p>
      <div class="wc-grid">
        <div class="wc-item">
          <pdx-icon name="check" size="xs"></pdx-icon>
          <span class="size-label">xs (12px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="star" size="sm"></pdx-icon>
          <span class="size-label">sm (16px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="heart" size="md"></pdx-icon>
          <span class="size-label">md (20px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="home" size="lg"></pdx-icon>
          <span class="size-label">lg (24px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="bell" size="xl"></pdx-icon>
          <span class="size-label">xl (32px)</span>
        </div>
      </div>
      <div class="row" style="margin-top:12px">
        <span style="color:#3b82f6"><pdx-icon name="heart" size="lg"></pdx-icon></span>
        <span style="color:#ef4444"><pdx-icon name="heart" size="lg"></pdx-icon></span>
        <span style="color:#22c55e"><pdx-icon name="heart" size="lg"></pdx-icon></span>
        <span class="size-label" style="align-self:center">Color inheritance via currentColor</span>
      </div>
      <div class="row" style="margin-top:8px">
        <pdx-icon name="star" size="lg" label="Favorite"></pdx-icon>
        <span class="size-label" style="align-self:center">Semantic (role="img" + aria-label="Favorite")</span>
      </div>
      <div class="row">
        <pdx-icon name="star" size="lg"></pdx-icon>
        <span class="size-label" style="align-self:center">Decorative (aria-hidden="true")</span>
      </div>
    </section>

    <section>
      <h3>Color Inheritance</h3>
      <p class="desc">Icons inherit color from parent via currentColor.</p>
      <div class="color-row">
        @for (colors as c; track c.color) {
          <span :style="'color:' + c.color" :ref="c.ref"></span>
        }
      </div>
    </section>
  </div>
</template>

<script setup>
import { registerIconSet, resolveIcon, clearIconSets, signal, onMount } from '@pdxui/core';
import '../../../ui/src/icon/pdx-icon';

const ICONS = {
    check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>',
    x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
    plus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>',
    search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>',
    star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
    heart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>',
    home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
    user: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
    settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/></svg>',
    bell: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>',
    mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>',
};

const iconNames = Object.keys(ICONS);
const sizeList = [
    { name: 'xs', px: 12 }, { name: 'sm', px: 16 }, { name: 'md', px: 20 },
    { name: 'lg', px: 24 }, { name: 'xl', px: 32 },
];

// Pre-create refs for each icon and color
const iconEntries = iconNames.map(name => ({ name, ref: signal(null) }));
const colorList = ['#3b82f6', '#ef4444', '#22c55e', '#f59e0b', '#888'];
const colors = colorList.map(color => ({ color, ref: signal(null) }));

let resultText = $signal('Icon set registered');

// Register immediately so <pdx-icon> can resolve during mount
registerIconSet('demo', (name) => ICONS[name] || null);
resultText = 'Set "demo" registered with ' + iconNames.length + ' icons';

function doRegister() {
    clearIconSets();
    registerIconSet('demo', (name) => ICONS[name] || null);
    resultText = 'Set "demo" re-registered with ' + iconNames.length + ' icons';
}

async function doResolve() {
    const result = await resolveIcon('check');
    resultText = result ? 'Resolved "check" OK' : 'Not found — register first';
}

async function doMissing() {
    const result = await resolveIcon('nonexistent');
    resultText = result ? 'Found (unexpected)' : 'null — icon not in set (expected)';
}

onMount(() => {
    doRegister();
    // Inject SVG into grid cells and color spans via refs
    requestAnimationFrame(() => {
        for (const entry of iconEntries) {
            const el = entry.ref.peek();
            if (el) {
                const svgHtml = ICONS[entry.name];
                const wrapper = document.createElement('span');
                wrapper.style.cssText = 'display:inline-flex;width:24px;height:24px';
                wrapper.innerHTML = svgHtml;
                el.insertBefore(wrapper, el.firstChild);
            }
        }
        for (const c of colors) {
            const el = c.ref.peek();
            if (el) {
                const wrapper = document.createElement('span');
                wrapper.style.cssText = 'display:inline-flex;width:28px;height:28px';
                wrapper.innerHTML = ICONS.heart;
                el.appendChild(wrapper);
            }
        }
    });
});
</script>

<style scoped>
  .demo { max-width: 800px; display: flex; flex-direction: column; gap: 20px; }
  h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }
  h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }
  .desc { color: #666; font-size: 0.85rem; margin: 0; }
  section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
  .result { font-size: 0.9rem; padding: 8px; background: #f5f5f7; border-radius: 6px; }
  .size-row { display: flex; align-items: center; gap: 24px; margin-top: 8px; }
  .size-item { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .size-label { font-size: 0.7rem; color: #888; }
  .icon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 8px; margin-top: 8px; }
  .icon-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 12px 8px; border: 1px solid #e0e0e0; border-radius: 6px; }
  .icon-cell:hover { background: #f5f5f7; }
  .icon-name { font-size: 0.7rem; color: #666; }
  .color-row { display: flex; gap: 20px; align-items: center; margin-top: 8px; }
  .wc-grid { display: flex; gap: 24px; align-items: flex-end; margin-top: 8px; }
  .wc-item { display: flex; flex-direction: column; align-items: center; gap: 6px; }
</style>

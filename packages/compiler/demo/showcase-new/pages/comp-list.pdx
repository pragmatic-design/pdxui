<template>
  <div class="page">
    <h1 class="pdx-txt-title">List</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-list&gt;</code> — data-bound list. Supports static arrays, DataSource,
      custom item templates, loading overlay, empty state, clickable items, dividers.
    </p>

    <app-demo-comp-list-basic class="demo-section"></app-demo-comp-list-basic>

    <app-demo-comp-list-data-source class="demo-section"></app-demo-comp-list-data-source>

    <app-demo-comp-list-empty class="demo-section"></app-demo-comp-list-empty>

    <app-demo-comp-list-slot-template class="demo-section"></app-demo-comp-list-slot-template>

    <app-demo-comp-list-custom-empty class="demo-section"></app-demo-comp-list-custom-empty>

    <app-demo-comp-list-rich-item class="demo-section"></app-demo-comp-list-rich-item>

    <app-demo-comp-list-pagination class="demo-section"></app-demo-comp-list-pagination>

    <app-demo-comp-list-data-source-wrapper class="demo-section"></app-demo-comp-list-data-source-wrapper>

    <section>
      <h2 class="pdx-txt-heading section-heading">Props</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>items</code></td><td>T[]</td><td>null</td><td>Static data array</td></tr>
            <tr><td><code>source</code></td><td>DataSource</td><td>null</td><td>DataSource instance (priority over items)</td></tr>
            <tr><td><code>render-item</code></td><td>Function</td><td>null</td><td>(item, index) => HTML string or HTMLElement (escape hatch)</td></tr>
            <tr><td><code>id-field</code></td><td>String</td><td>'id'</td><td>Unique ID field name</td></tr>
            <tr><td><code>dividers</code></td><td>Boolean</td><td>false</td><td>Show dividers between items</td></tr>
            <tr><td><code>clickable</code></td><td>Boolean</td><td>false</td><td>Items are clickable (hover + cursor)</td></tr>
            <tr><td><code>bordered</code></td><td>Boolean</td><td>true</td><td>Border around list</td></tr>
            <tr><td><code>empty-title</code></td><td>String</td><td>'No items'</td><td>Empty state title</td></tr>
            <tr><td><code>empty-description</code></td><td>String</td><td>''</td><td>Empty state description</td></tr>
            <tr><td><code>empty-icon</code></td><td>String</td><td>'inbox'</td><td>Empty state icon</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="pdx-txt-heading section-heading">Slots</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Slot</th><th>Scope</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>item</code></td><td><code>{ item, index, id }</code></td><td>Custom item template. Priority: slot > render-item > default.</td></tr>
            <tr><td><code>empty</code></td><td><code>{}</code></td><td>Custom empty state (overrides empty-title/description/icon props).</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</template>

<script>
@page '/components/list';
@title 'List — PDX Components';

</script>

<style scoped>
.page { }
</style>

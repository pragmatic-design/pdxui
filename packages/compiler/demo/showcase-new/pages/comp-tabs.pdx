        <div class="opt-row"><code>variant</code><span>"line" (default), "card" (bordered bg), "pills" (segmented)</span></div>
        <div class="opt-row"><code>bordered</code><span>Add border container around tabs + panels (any variant)</span></div>
        <div class="opt-row"><code>orientation</code><span>"horizontal" (default) or "vertical"</span></div>
        <div class="opt-row"><code>mount</code><span>"eager" (default), "lazy", or "unmount"</span></div>
        <div class="opt-row"><code>activation</code><span>"automatic" (default) or "manual"</span></div>

            <tr><td><code>pdx-error</code></td><td>{}</td><td>Emitted when image fails to load</td></tr>
            <tr><td><code>pdx-zoom</code></td><td>{ zoomed: boolean }</td><td>Emitted on zoom toggle</td></tr>
          </tbody>
        </table>

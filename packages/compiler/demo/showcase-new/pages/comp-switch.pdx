<template>
  <div class="page">
    <h1 class="pdx-txt-title">Switch</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-switch&gt;</code> — toggle switch with label, description, loading state, sizes.
      Uses <code>role="switch"</code> for proper accessibility semantics.
    </p>

    <!-- ═══ Basic ═══ -->
    <app-demo-comp-switch-basic class="demo-section"></app-demo-comp-switch-basic>

    <!-- ═══ With Description ═══ -->
    <app-demo-comp-switch-description class="demo-section"></app-demo-comp-switch-description>

    <!-- ═══ Sizes ═══ -->
    <app-demo-comp-switch-sizes class="demo-section"></app-demo-comp-switch-sizes>

    <!-- ═══ Label Position ═══ -->
    <app-demo-comp-switch-label-position class="demo-section"></app-demo-comp-switch-label-position>

    <!-- ═══ Loading ═══ -->
    <app-demo-comp-switch-loading class="demo-section"></app-demo-comp-switch-loading>

    <!-- ═══ Error ═══ -->
    <app-demo-comp-switch-error class="demo-section"></app-demo-comp-switch-error>

    <!-- ═══ Composition ═══ -->
    <app-demo-comp-switch-composition class="demo-section"></app-demo-comp-switch-composition>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Reference</h2>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>checked</code><span>boolean</span><span>On/off state</span></div>
        <div class="opt-row"><code>label</code><span>string</span><span>Label text</span></div>
        <div class="opt-row"><code>description</code><span>string</span><span>Help text below label</span></div>
        <div class="opt-row"><code>size</code><span>string</span><span>sm, (default), lg</span></div>
        <div class="opt-row"><code>labelPosition</code><span>string</span><span>right (default), left</span></div>
        <div class="opt-row"><code>loading</code><span>boolean</span><span>Spinner in thumb, disabled during load</span></div>
        <div class="opt-row"><code>error</code><span>boolean</span><span>Red track color</span></div>
        <div class="opt-row"><code>disabled</code><span>boolean</span><span>Disabled state</span></div>
        <div class="opt-row"><code>value</code><span>string</span><span>What a form submits under <code>name</code> while it is on (default <code>on</code>); nothing while off</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">States and parts</h3>
      <div class="options-table">
        <div class="opt-header"><span>Selector</span><span>—</span><span>When</span></div>
        <div class="opt-row"><code>:state(checked)</code><span></span><span>It is on</span></div>
        <div class="opt-row"><code>:state(invalid) / :state(disabled)</code><span></span><span><code>error</code> / <code>disabled</code> is set; with <code>error</code> the switch is <code>aria-invalid</code></span></div>
        <div class="opt-row"><code>:state(loading)</code><span></span><span><code>loading</code> is set; the switch is <code>aria-busy</code> and takes no toggle</span></div>
        <div class="opt-row"><code>[data-part="root"] / [data-part="label"] / [data-part="description"]</code><span></span><span>The track (the native <code>role="switch"</code>), the label, the description</span></div>
      </div>
    </section>
  </div>
</template>

<script>

@page '/components/switch';
@title 'Switch Component';
</script>

<style scoped>
  .page { }
</style>

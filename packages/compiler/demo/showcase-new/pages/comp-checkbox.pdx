        <div class="opt-row"><code>size</code><span>string</span><span>sm, (default), lg</span></div>
        <div class="opt-row"><code>labelPosition</code><span>string</span><span>right (default), left</span></div>
        <div class="opt-row"><code>error</code><span>boolean</span><span>Red border for validation</span></div>
        <div class="opt-row"><code>disabled</code><span>boolean</span><span>Disabled state</span></div>
        <div class="opt-row"><code>value</code><span>string</span><span>Value in event detail</span></div>
        <div class="opt-row"><code>name</code><span>string</span><span>Form field name</span></div>

<template>
  <div class="page">
    <h1 class="pdx-txt-title">Checkbox</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-checkbox&gt;</code> — custom checkbox with label, description, indeterminate, tristate, sizes.
      Tristate cycles: unchecked → checked → indeterminate.
    </p>

    <!-- ═══ Basic ═══ -->
    <app-demo-comp-checkbox-basic class="demo-section"></app-demo-comp-checkbox-basic>

    <!-- ═══ With Description ═══ -->
    <app-demo-comp-checkbox-description class="demo-section"></app-demo-comp-checkbox-description>

    <!-- ═══ Indeterminate ═══ -->
    <app-demo-comp-checkbox-indeterminate class="demo-section"></app-demo-comp-checkbox-indeterminate>

    <!-- ═══ Tristate ═══ -->
    <app-demo-comp-checkbox-tristate class="demo-section"></app-demo-comp-checkbox-tristate>

    <!-- ═══ Sizes ═══ -->
    <app-demo-comp-checkbox-sizes class="demo-section"></app-demo-comp-checkbox-sizes>

    <!-- ═══ Label Position ═══ -->
    <app-demo-comp-checkbox-label-position class="demo-section"></app-demo-comp-checkbox-label-position>

    <!-- ═══ Error ═══ -->
    <app-demo-comp-checkbox-error class="demo-section"></app-demo-comp-checkbox-error>

    <!-- ═══ Composition ═══ -->
    <app-demo-comp-checkbox-composition class="demo-section"></app-demo-comp-checkbox-composition>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Reference</h2>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>checked</code><span>boolean</span><span>Checked state</span></div>
        <div class="opt-row"><code>indeterminate</code><span>boolean</span><span>Visual "—" state, announced as mixed; a click settles it</span></div>
        <div class="opt-row"><code>tristate</code><span>boolean</span><span>Enable 3-state cycle on click</span></div>
        <div class="opt-row"><code>label</code><span>string</span><span>Label text (or use default slot)</span></div>
        <div class="opt-row"><code>description</code><span>string</span><span>Help text below label</span></div>
        <div class="opt-row"><code>size</code><span>string</span><span>sm, (default), lg</span></div>
        <div class="opt-row"><code>labelPosition</code><span>string</span><span>right (default), left</span></div>
        <div class="opt-row"><code>error</code><span>boolean</span><span>Red border for validation</span></div>
        <div class="opt-row"><code>disabled</code><span>boolean</span><span>Disabled state</span></div>
        <div class="opt-row"><code>value</code><span>string</span><span>What a form submits under <code>name</code> while it is checked (default <code>on</code>); nothing while unchecked</span></div>
        <div class="opt-row"><code>name</code><span>string</span><span>Form field name</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Events</h3>
      <div class="options-table">
        <div class="opt-header"><span>Event</span><span>Detail</span><span>Description</span></div>
        <div class="opt-row"><code>checked-change</code><span>{ value: boolean }</span><span>A click wrote <code>checked</code>; <code>::checked</code> binds it both ways</span></div>
        <div class="opt-row"><code>indeterminate-change</code><span>{ value: boolean }</span><span>A click wrote <code>indeterminate</code> (a tristate cycle, or settling a mixed box)</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">States and parts</h3>
      <div class="options-table">
        <div class="opt-header"><span>Selector</span><span>—</span><span>When</span></div>
        <div class="opt-row"><code>:state(checked) / :state(indeterminate)</code><span></span><span>Checked / mixed (the box is <code>aria-checked="mixed"</code>)</span></div>
        <div class="opt-row"><code>:state(invalid) / :state(disabled)</code><span></span><span><code>error</code> / <code>disabled</code> is set; with <code>error</code> the box is <code>aria-invalid</code></span></div>
        <div class="opt-row"><code>[data-part="root"] / [data-part="label"] / [data-part="description"]</code><span></span><span>The box (the native checkbox), the label, the description</span></div>
      </div>
    </section>
  </div>
</template>

<script>

@page '/components/checkbox';
@title 'Checkbox Component';
</script>

<style scoped>
  .page { }
</style>

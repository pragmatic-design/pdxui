<template>
  <div class="page">
    <h1 class="pdx-txt-title">Bottom Sheet</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      Draggable sheet from the bottom edge with snap points (detents). Gesture-driven: drag the handle to resize,
      swipe down to dismiss. Focus trap, Escape close, backdrop click. Mobile-first with desktop max-width.
    </p>

    <!-- ═══ Basic ═══ -->
    <app-demo-comp-bottom-sheet-basic class="demo-section"></app-demo-comp-bottom-sheet-basic>

    <!-- ═══ Three Detents ═══ -->
    <app-demo-comp-bottom-sheet-detents class="demo-section"></app-demo-comp-bottom-sheet-detents>

    <!-- ═══ Scrollable Content ═══ -->
    <app-demo-comp-bottom-sheet-scrollable class="demo-section"></app-demo-comp-bottom-sheet-scrollable>

    <!-- ═══ With Close Button ═══ -->
    <app-demo-comp-bottom-sheet-close-button class="demo-section"></app-demo-comp-bottom-sheet-close-button>

    <!-- ═══ No Handle ═══ -->
    <app-demo-comp-bottom-sheet-no-handle class="demo-section"></app-demo-comp-bottom-sheet-no-handle>

    <!-- ═══ Action Sheet ═══ -->
    <app-demo-comp-bottom-sheet-action-sheet class="demo-section"></app-demo-comp-bottom-sheet-action-sheet>

    <!-- ═══ Nested with Dialog ═══ -->
    <app-demo-comp-bottom-sheet-stacking class="demo-section"></app-demo-comp-bottom-sheet-stacking>

    <!-- ═══ Props Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading">Props Reference</h2>
      <div class="pdx-table-responsive">
        <table class="pdx-table">
          <thead>
            <tr>
              <th>Prop</th>
              <th>Type</th>
              <th>Default</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            <tr><td><code>open</code></td><td>Boolean</td><td>false</td><td>Open/close state. A model: <code>::open</code> follows Escape, the ✕, the backdrop and a swipe down</td></tr>
            <tr><td><code>detents</code></td><td>Number[]</td><td>[0.4, 0.85]</td><td>Snap points as viewport height fractions (0-1)</td></tr>
            <tr><td><code>initialDetent</code></td><td>Number</td><td>0</td><td>Index of initial detent on open</td></tr>
            <tr><td><code>backdrop</code></td><td>Boolean</td><td>true</td><td>Show backdrop overlay</td></tr>
            <tr><td><code>closeOnBackdrop</code></td><td>Boolean</td><td>true</td><td>Close when backdrop is clicked</td></tr>
            <tr><td><code>closeOnEscape</code></td><td>Boolean</td><td>true</td><td>Close on Escape key (via overlayStack)</td></tr>
            <tr><td><code>closeOnSwipeDown</code></td><td>Boolean</td><td>true</td><td>Close when swiped below minimum detent</td></tr>
            <tr><td><code>showHandle</code></td><td>Boolean</td><td>true</td><td>Show the drag handle bar</td></tr>
            <tr><td><code>showClose</code></td><td>Boolean</td><td>false</td><td>Show close button in header</td></tr>
            <tr><td><code>label</code></td><td>String</td><td>''</td><td>Accessible label (aria-label)</td></tr>
          </tbody>
        </table>
      </div>
      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Events, states and parts</h3>
      <div class="pdx-table-responsive">
        <table class="pdx-table">
          <tbody>
            <tr><td><code>open-change</code></td><td><code>{ value }</code>: it opened, or closed itself</td></tr>
            <tr><td><code>pdx-before-close</code></td><td>Cancelable — call preventDefault() to keep it open</td></tr>
            <tr><td><code>pdx-detent-change</code></td><td><code>{ detent, index }</code>: it came to rest at a detent</td></tr>
            <tr><td><code>:state(open)</code>, <code>:state(dragging)</code></td><td>Open; being dragged (no transition)</td></tr>
            <tr><td><code>[data-part]</code></td><td><code>root</code> (the sheet), <code>backdrop</code>, <code>handle</code>, <code>header</code>, <code>close</code>, <code>body</code>, <code>footer</code></td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</template>


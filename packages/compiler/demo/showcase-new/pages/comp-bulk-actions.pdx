          <tr><td><code>count</code></td><td>number</td><td>0</td><td>Selected count — drives visibility and the label.</td></tr>
          <tr><td><code>actions</code></td><td>BulkAction[]</td><td>[]</td><td>{ key, label, icon?, tone?, disabled?, disabledReason? }</td></tr>
          <tr><td><code>label</code></td><td>string</td><td>'{count} selected'</td><td>Label template; <code>{count}</code> is substituted.</td></tr>
          <tr><td><code>clearable</code></td><td>boolean</td><td>true</td><td>Show the trailing clear (✕) button.</td></tr>

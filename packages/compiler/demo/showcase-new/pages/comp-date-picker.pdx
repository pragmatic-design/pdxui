<template>
  <div class="page">
    <h1 class="pdx-txt-title">Date Picker</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-date-picker&gt;</code> — 9 selection modes, 13 calendar systems, fiscal year/quarter,
      comparison range, presets, highlighted dates, time picker, mobile-adaptive.
      Composed of <code>&lt;pdx-calendar&gt;</code> + <code>&lt;pdx-time-picker&gt;</code>.
    </p>

    <!-- ═══ 1. Basic ═══ -->
    <app-demo-comp-date-picker-basic class="demo-section"></app-demo-comp-date-picker-basic>

    <!-- ═══ 2. Selection Modes ═══ -->
    <app-demo-comp-date-picker-selection-modes class="demo-section"></app-demo-comp-date-picker-selection-modes>

    <!-- ═══ 3. Calendar Systems ═══ -->
    <app-demo-comp-date-picker-calendar-systems class="demo-section"></app-demo-comp-date-picker-calendar-systems>

    <!-- ═══ 4. Constraints ═══ -->
    <app-demo-comp-date-picker-min-max class="demo-section"></app-demo-comp-date-picker-min-max>

    <!-- ═══ 4b. Editable ═══ -->
    <app-demo-comp-date-picker-editable class="demo-section"></app-demo-comp-date-picker-editable>

    <!-- ═══ 5. Standalone Calendar ═══ -->
    <app-demo-comp-date-picker-standalone-calendar class="demo-section"></app-demo-comp-date-picker-standalone-calendar>

    <!-- ═══ 6. Time Picker Standalone ═══ -->
    <app-demo-comp-date-picker-time-picker class="demo-section"></app-demo-comp-date-picker-time-picker>

    <!-- ═══ 7. Date Range ═══ -->
    <app-demo-comp-date-picker-date-range class="demo-section"></app-demo-comp-date-picker-date-range>

    <!-- ═══ 8. Presets ═══ -->
    <app-demo-comp-date-picker-presets class="demo-section"></app-demo-comp-date-picker-presets>

    <!-- ═══ 9. Highlighted Dates ═══ -->
    <app-demo-comp-date-picker-highlighted class="demo-section"></app-demo-comp-date-picker-highlighted>

    <!-- ═══ 10. Fiscal Year/Quarter ═══ -->
    <app-demo-comp-date-picker-fiscal class="demo-section"></app-demo-comp-date-picker-fiscal>

    <!-- ═══ 9. Inline Calendar ═══ -->
    <app-demo-comp-date-picker-inline class="demo-section"></app-demo-comp-date-picker-inline>

    <!-- ═══ 10. Sizes ═══ -->
    <app-demo-comp-date-picker-sizes class="demo-section"></app-demo-comp-date-picker-sizes>

    <!-- ═══ 11. Locales ═══ -->
    <app-demo-comp-date-picker-locale class="demo-section"></app-demo-comp-date-picker-locale>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Props Reference</h2>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>value</code><span>string</span><span>Selected ISO date</span></div>
        <div class="opt-row"><code>mode</code><span>string</span><span>date | datetime | daterange | datetimerange | time | week | month | year | quarter</span></div>
        <div class="opt-row"><code>locale</code><span>string</span><span>BCP 47 locale tag (en, it, de, ar, ja...)</span></div>
        <div class="opt-row"><code>calendar</code><span>string</span><span>gregory | islamic-umalqura | hebrew | japanese | buddhist | persian | ...</span></div>
        <div class="opt-row"><code>numberOfMonths</code><span>number</span><span>1-3 months visible (0 = auto)</span></div>
        <div class="opt-row"><code>weekNumbers</code><span>boolean</span><span>Show ISO week numbers</span></div>
        <div class="opt-row"><code>min / max</code><span>string</span><span>Min/max selectable date (ISO)</span></div>
        <div class="opt-row"><code>disabledDates</code><span>function</span><span>(iso) => boolean</span></div>
        <div class="opt-row"><code>highlightedDates</code><span>function</span><span>(iso) => string | false</span></div>
        <div class="opt-row"><code>fiscalStartMonth</code><span>number</span><span>1-12, fiscal year start month</span></div>
        <div class="opt-row"><code>presets</code><span>array</span><span>[{ label, value }] preset date options</span></div>
        <div class="opt-row"><code>showCompare</code><span>boolean</span><span>Comparison range toggle</span></div>
        <div class="opt-row"><code>inline</code><span>boolean</span><span>No popover, always visible</span></div>
        <div class="opt-row"><code>editable</code><span>boolean</span><span>The date can be typed (date and datetime modes)</span></div>
        <div class="opt-row"><code>clearable</code><span>boolean</span><span>Show clear button (default: true)</span></div>
        <div class="opt-row"><code>disabled</code><span>boolean</span><span>Disabled state</span></div>
        <div class="opt-row"><code>size</code><span>string</span><span>sm, (default), lg</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Events</h3>
      <div class="options-table">
        <div class="opt-header"><span>Event</span><span>Detail</span><span>Description</span></div>
        <div class="opt-row"><code>value-change</code><span>{ value }</span><span>Its model: the date, the date and its time, or <code>[start, end]</code> for a range</span></div>
        <div class="opt-row"><code>open-change</code><span>{ value: boolean }</span><span>The popup opened (<code>true</code>) or closed (<code>false</code>)</span></div>
        <div class="opt-row"><code>pdx-clear</code><span>—</span><span>Value cleared</span></div>
        <div class="opt-row"><code>pdx-blur</code><span>—</span><span>The focus left the picker and its panel</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Methods, states and parts</h3>
      <p class="pdx-txt-small pdx-ink-muted">
        The popup is an overlay: driven by its verbs, announced by <code>open-change</code>. What a theme or a page
        styles on <code>&lt;pdx-date-picker&gt;</code>: its custom states on the host and its parts. The classes inside are not public.
      </p>
      <div class="options-table">
        <div class="opt-header"><span>Method, state or part</span><span></span><span>What it is</span></div>
        <div class="opt-row"><code>show() / close() / toggle()</code><span></span><span>Open, close or toggle the popup</span></div>
        <div class="opt-row"><code>getDate() / getRange() / getTime() / getEndTime()</code><span></span><span>The parts of the value: the date, the range a mode covers, the times</span></div>
        <div class="opt-row"><code>focus() / blur() / clear()</code><span></span><span>Focus the trigger, leave it, empty the value</span></div>
        <div class="opt-row"><code>:state(open) / :state(disabled) / :state(readonly)</code><span></span><span>The popup is open; <code>disabled</code> or <code>readonly</code> is set</span></div>
        <div class="opt-row"><code>[data-part="root"] / [data-part="input"] / [data-part="clear"]</code><span></span><span>The trigger; its text field when <code>editable</code>; the clear button</span></div>
        <div class="opt-row"><code>[data-part="popup"] / [data-part="preset"] / [data-part="calendar"]</code><span></span><span>The panel, a dialog; a preset button; the calendar it draws</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">&lt;pdx-calendar&gt;: form, state and parts</h3>
      <p class="pdx-txt-small pdx-ink-muted">
        A standalone calendar takes part in a form when it has a <code>name</code>: it submits its model, a range or several
        dates one entry each, and a reset restores it. Its parts are its own: inside a date picker, address the picker's with
        <code>pdx-date-picker &gt; [data-part="root"]</code>.
      </p>
      <div class="options-table">
        <div class="opt-header"><span>Prop, state or part</span><span></span><span>What it is</span></div>
        <div class="opt-row"><code>name</code><span></span><span>The form entry's name; without one it submits nothing</span></div>
        <div class="opt-row"><code>:state(disabled)</code><span></span><span><code>disabled</code> is set</span></div>
        <div class="opt-row"><code>[data-part="root"] / [data-part="nav"]</code><span></span><span>The frame, a group; the navigation bar</span></div>
        <div class="opt-row"><code>[data-part="prev"] / [data-part="title"] / [data-part="next"]</code><span></span><span>The arrows and the month or year shown</span></div>
        <div class="opt-row"><code>[data-part="grid"] / [data-part="cell"]</code><span></span><span>A month's days, or the months or years; a day, month or year to pick</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Keyboard Shortcuts</h3>
      <div class="options-table">
        <div class="opt-header"><span>Key</span><span>Action</span><span>Scope</span></div>
        <div class="opt-row"><code>Arrow Left/Right</code><span>Previous/next day</span><span>Calendar grid</span></div>
        <div class="opt-row"><code>Arrow Up/Down</code><span>Previous/next week</span><span>Calendar grid</span></div>
        <div class="opt-row"><code>PageUp/Down</code><span>Previous/next month</span><span>Calendar grid</span></div>
        <div class="opt-row"><code>Shift+PageUp/Down</code><span>Previous/next year</span><span>Calendar grid</span></div>
        <div class="opt-row"><code>Home/End</code><span>Start/end of week</span><span>Calendar grid</span></div>
        <div class="opt-row"><code>Enter/Space</code><span>Select date</span><span>Calendar grid</span></div>
        <div class="opt-row"><code>Escape</code><span>Close popover</span><span>Date picker</span></div>
        <div class="opt-row"><code>Enter</code><span>Commit the typed date</span><span>Editable input</span></div>
        <div class="opt-row"><code>Alt+Arrow Down</code><span>Open the calendar</span><span>Editable input</span></div>
        <div class="opt-row"><code>Arrow Up/Down</code><span>Increment/decrement</span><span>Time segments</span></div>
        <div class="opt-row"><code>0-9</code><span>Type digits</span><span>Time segments</span></div>
        <div class="opt-row"><code>A/P</code><span>Set AM/PM</span><span>Time period</span></div>
      </div>
    </section>
  </div>
</template>

<script>
@page '/components/date-picker';
@title 'Date Picker Component';
</script>

<style scoped>
  .page { }
</style>

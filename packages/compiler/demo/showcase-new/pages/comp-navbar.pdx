<template>
  <div class="page">
    <h1 class="pdx-txt-title">Navbar</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-navbar&gt;</code> — compound responsive app header with brand, nav links,
      search, notifications, user avatar + dropdown. All interactions are live.
    </p>

    <!-- ═══ 1. Enterprise Header — fully interactive ═══ -->
    <app-demo-comp-navbar-enterprise class="demo-section"></app-demo-comp-navbar-enterprise>

    <!-- ═══ 2. Basic (no actions) ═══ -->
    <app-demo-comp-navbar-basic class="demo-section"></app-demo-comp-navbar-basic>

    <!-- ═══ 3. With Dropdown Nav Item ═══ -->
    <app-demo-comp-navbar-dropdown class="demo-section"></app-demo-comp-navbar-dropdown>

    <!-- ═══ 4. Compact ═══ -->
    <app-demo-comp-navbar-compact class="demo-section"></app-demo-comp-navbar-compact>

    <!-- ═══ 5. Responsive Preview ═══ -->
    <app-demo-comp-navbar-responsive class="demo-section"></app-demo-comp-navbar-responsive>

    <!-- ═══ Props ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Props</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>brand</code></td><td>String</td><td>''</td><td>Brand/logo text</td></tr>
            <tr><td><code>brandicon</code></td><td>String</td><td>''</td><td>Brand icon name</td></tr>
            <tr><td><code>items</code></td><td>NavbarItem[]</td><td>[]</td><td>Navigation links</td></tr>
            <tr><td><code>sticky</code></td><td>Boolean</td><td>false</td><td>Sticky at top</td></tr>
            <tr><td><code>compact</code></td><td>Boolean</td><td>false</td><td>48px height</td></tr>
            <tr><td><code>label</code></td><td>String</td><td>'Main navigation'</td><td>The navigation landmark's name; give each navbar on a page its own</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">States and parts</h3>
      <div class="options-table">
        <table>
          <thead><tr><th>Name</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>:state(sticky)</code>, <code>:state(compact)</code></td><td><code>sticky</code> or <code>compact</code> is set</td></tr>
            <tr><td><code>:state(collapsed)</code>, <code>:state(menu-open)</code></td><td>Its bar does not fit its width, so the links are behind the toggle; the drawer is open</td></tr>
            <tr><td><code>[aria-current="page"]</code></td><td>The current link, on the link itself</td></tr>
            <tr><td><code>[data-part]</code></td><td><code>bar</code>, <code>brand</code>, <code>toggle</code>, <code>nav</code>, <code>item</code>, <code>actions</code>, <code>drawer</code></td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>

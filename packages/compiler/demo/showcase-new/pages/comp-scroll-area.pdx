<template>
  <div class="page">
    <h1 class="pdx-txt-title">ScrollArea</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-scroll-area&gt;</code> — custom overlay scrollbar container. Replaces native scrollbars
      with styled, auto-hiding overlay scrollbars. Supports vertical, horizontal, and both axes.
    </p>

    <app-demo-comp-scroll-area-vertical class="demo-section"></app-demo-comp-scroll-area-vertical>

    <app-demo-comp-scroll-area-always-visible class="demo-section"></app-demo-comp-scroll-area-always-visible>

    <app-demo-comp-scroll-area-horizontal class="demo-section"></app-demo-comp-scroll-area-horizontal>

    <app-demo-comp-scroll-area-both-axes class="demo-section"></app-demo-comp-scroll-area-both-axes>

    <section>
      <h2 class="pdx-txt-heading section-heading">Props</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>type</code></td><td>String</td><td>'auto'</td><td>auto, always, hover, never</td></tr>
            <tr><td><code>axis</code></td><td>String</td><td>'vertical'</td><td>vertical, horizontal, both</td></tr>
            <tr><td><code>scroll-hide-delay</code></td><td>Number</td><td>1200</td><td>Auto-hide delay (ms)</td></tr>
            <tr><td><code>max-height</code></td><td>String</td><td>''</td><td>CSS max-height on viewport</td></tr>
            <tr><td><code>height</code></td><td>String</td><td>''</td><td>CSS height on viewport</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="pdx-txt-heading section-heading">States and parts</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Name</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>:state(at-top)</code></td><td>Scrolled to the top</td></tr>
            <tr><td><code>:state(at-bottom)</code></td><td>Scrolled to the bottom</td></tr>
            <tr><td><code>:state(at-left)</code></td><td>Scrolled to the left edge (H/both)</td></tr>
            <tr><td><code>:state(at-right)</code></td><td>Scrolled to the right edge (H/both)</td></tr>
            <tr><td><code>[data-part="viewport"]</code></td><td>The element that scrolls</td></tr>
            <tr><td><code>[data-part="scrollbar"]</code>, <code>[data-part="thumb"]</code></td><td>The overlay scrollbar's track and thumb</td></tr>
          </tbody>
        </table>

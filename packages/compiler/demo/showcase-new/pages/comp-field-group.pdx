<template>
  <div class="page">
    <h1 class="pdx-txt-title">Field Group</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-field-group&gt;</code> — scopes the fields inside it to a nested object of the form.
      Inside <code>&lt;pdx-field-group name="customer"&gt;</code>, a field written <code>name="email"</code> is
      <code>form.fields['customer.email']</code>, and <code>getValues()</code> returns <code>{ customer: { email } }</code>.
      Groups nest, and render inline, as a collapsible panel, or behind a dialog.
    </p>

    <!-- ═══ Nested object ═══ -->
    <pdx-demo-comp-field-group-nested-object class="demo-section"></pdx-demo-comp-field-group-nested-object>

    <!-- ═══ Nesting ═══ -->
    <pdx-demo-comp-field-group-groups-inside class="demo-section"></pdx-demo-comp-field-group-groups-inside>

    <!-- ═══ Display modes ═══ -->
    <pdx-demo-comp-field-group-display-modes class="demo-section"></pdx-demo-comp-field-group-display-modes>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Reference</h2>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>name</code><span>string</span><span>Key of the nested object; prefixes the names of the fields inside</span></div>
        <div class="opt-row"><code>label</code><span>string</span><span>Legend (inline, panel) or button text (dialog)</span></div>
        <div class="opt-row"><code>display</code><span>string</span><span>inline (default), panel, dialog</span></div>
        <div class="opt-row"><code>collapsed</code><span>boolean</span><span>A panel that starts closed</span></div>
      </div>
      <p class="pdx-txt-small pdx-ink-muted note">
        In a test or a measurement, select a grouped field by its full path: <code>[name="customer.email"]</code>.
        The compiler writes that path into the DOM.
      </p>
    </section>
  </div>
</template>

<script setup>
@page '/components/field-group';
@title 'Field Group Component';
</script>


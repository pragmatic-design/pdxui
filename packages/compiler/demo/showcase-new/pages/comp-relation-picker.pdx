          <tr><td><code>id-field</code></td><td>string</td><td>'id'</td><td>The field that identifies a row.</td></tr>
          <tr><td><code>searchable</code></td><td>boolean</td><td>false</td><td>A filter field under each column header, narrowing the source.</td></tr>
          <tr><td><code>add-label</code></td><td>string</td><td>'Add selected'</td><td>The add button's text.</td></tr>
          <tr><td><code>create-label</code></td><td>string</td><td>''</td><td>With a text, a create button that emits <code>pdx-create</code>.</td></tr>

            <tr><td><code>activekey</code></td><td>String</td><td>''</td><td>Currently active item key</td></tr>
            <tr><td><code>collapsed</code></td><td>Boolean</td><td>false</td><td>Icon-only collapsed mode</td></tr>
            <tr><td><code>indent</code></td><td>Number</td><td>36</td><td>Indent per nesting level (px)</td></tr>
            <tr><td><code>size</code></td><td>'md' | 'sm'</td><td>'md'</td><td>A compact menu for a dense sidebar</td></tr>
            <tr><td><code>indicator</code></td><td>'fill' | 'border'</td><td>'fill'</td><td>How the current entry is marked: a tint, or a tint and a start-edge bar</td></tr>

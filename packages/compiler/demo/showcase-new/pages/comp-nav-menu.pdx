    <section>
      <h2 class="pdx-txt-heading section-heading">Events</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Event</th><th>Detail</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>pdx-select</code></td><td><code>{ key, item, href }</code></td><td>An entry was chosen. Cancelable: <code>preventDefault()</code> stops the link.</td></tr>
            <tr><td><code>pdx-toggle</code></td><td><code>{ key, expanded }</code></td><td>A group opened or closed, for the app to keep. Does not bubble.</td></tr>
          </tbody>

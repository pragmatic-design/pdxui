<template>
  <div class="page">
    <h1 class="pdx-txt-title">AppLayout</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-app-layout&gt;</code> — application shell with header, navbar (left sidebar),
      aside (right sidebar), main content, and footer. CSS Grid layout, responsive collapse, semantic HTML.
    </p>

    <app-demo-comp-app-layout-full class="demo-section"></app-demo-comp-app-layout-full>

    <app-demo-comp-app-layout-header-navbar class="demo-section"></app-demo-comp-app-layout-header-navbar>

    <app-demo-comp-app-layout-without-border class="demo-section"></app-demo-comp-app-layout-without-border>

    <section>
      <h2 class="pdx-txt-heading section-heading">Props</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>header-height</code></td><td>String</td><td>'52px'</td><td>Header height (CSS)</td></tr>
            <tr><td><code>footer-height</code></td><td>String</td><td>''</td><td>Footer height (empty = no footer)</td></tr>
            <tr><td><code>navbar-width</code></td><td>String</td><td>'260px'</td><td>Navbar width (CSS)</td></tr>
            <tr><td><code>navbar-collapsed-width</code></td><td>String</td><td>'60px'</td><td>Width when collapsed: an icon rail; '0px' hides the navbar</td></tr>
            <tr><td><code>navbar-collapsed</code></td><td>Boolean (model)</td><td>false</td><td>Collapsed state; the navbar methods write it above the breakpoint and <code>::navbarCollapsed</code> follows; also opens and closes the drawer below the breakpoint</td></tr>
            <tr><td><code>navbar-breakpoint</code></td><td>Number</td><td>768</td><td>Below this width (px) the navbar is an overlay drawer</td></tr>
            <tr><td><code>navbar-full-height</code></td><td>Boolean</td><td>false</td><td>The navbar spans header, main and footer; the header sits over main only</td></tr>
            <tr><td><code>aside-width</code></td><td>String</td><td>''</td><td>Right sidebar width (empty = none)</td></tr>
            <tr><td><code>with-border</code></td><td>Boolean</td><td>true</td><td>Show borders between regions</td></tr>
            <tr><td><code>transition-duration</code></td><td>Number</td><td>200</td><td>Collapse animation (ms)</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="pdx-txt-heading section-heading">Methods</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Method</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>toggleNavbar()</code></td><td>Collapse or expand the navbar; below the breakpoint, open or close the drawer</td></tr>
            <tr><td><code>openNavbar()</code></td><td>Expand the navbar (or open the drawer)</td></tr>
            <tr><td><code>closeNavbar()</code></td><td>Collapse the navbar (or close the drawer)</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Event and states</h3>
      <div class="options-table">
        <table>
          <thead><tr><th>Name</th><th>Kind</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>navbar-collapsed-change</code></td><td>Event <code>{ value }</code></td><td>A method collapsed or expanded the navbar above the breakpoint; does not bubble</td></tr>
            <tr><td><code>:state(bordered)</code></td><td>State</td><td><code>with-border</code> is set</td></tr>
            <tr><td><code>:state(drawer)</code>, <code>:state(drawer-open)</code></td><td>State</td><td>Below the breakpoint the navbar is a drawer; open, with its backdrop</td></tr>
            <tr><td><code>:state(navbar-collapsed)</code>, <code>:state(navbar-gone)</code></td><td>State</td><td>Above it, collapsed to its rail; to a 0px rail</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="pdx-txt-heading section-heading">Regions</h2>
      <p class="pdx-txt-small pdx-ink-muted">
        Children are placed by <code>data-region</code>. The layout keeps your elements and gives each region its
        landmark role; everything without a <code>data-region</code> is wrapped in one <code>&lt;main&gt;</code>.
      </p>
      <div class="options-table">
        <table>
          <thead><tr><th>data-region</th><th>Landmark</th><th>Position</th><th>Part</th></tr></thead>
          <tbody>
            <tr><td><code>header</code></td><td><code>role="banner"</code></td><td>Top, full width</td><td><code>header</code></td></tr>
            <tr><td><code>navbar</code></td><td><code>role="navigation"</code>, named</td><td>Left sidebar</td><td><code>navbar</code></td></tr>
            <tr><td>(none)</td><td><code>&lt;main&gt;</code></td><td>Center content</td><td><code>main</code></td></tr>
            <tr><td><code>aside</code></td><td><code>role="complementary"</code></td><td>Right sidebar</td><td><code>aside</code></td></tr>
            <tr><td><code>footer</code></td><td><code>role="contentinfo"</code></td><td>Bottom, full width</td><td><code>footer</code></td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</template>

<script>
@page '/components/app-layout';
@title 'AppLayout — PDX Components';

</script>

<style scoped>
.page { }
/* Collapsed (mini-rail): the layout is pdx-app-layout:state(navbar-collapsed) →
   hide the text labels (font-size:0 collapses the text node; the sized pdx-icon stays) and
   centre the icons so the rail reads as an icon-only nav. */
</style>

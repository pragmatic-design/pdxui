<template>
  <div class="page">
    <h1 class="pdx-txt-title">Timeline</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-timeline&gt;</code> — displays a vertical or horizontal sequence of events.
      Supports left/right/alternate/horizontal modes, status colors, icons, pending state, clickable items.
    </p>

    <app-demo-comp-timeline-basic class="demo-section"></app-demo-comp-timeline-basic>

    <app-demo-comp-timeline-icons class="demo-section"></app-demo-comp-timeline-icons>

    <app-demo-comp-timeline-alternate class="demo-section"></app-demo-comp-timeline-alternate>

    <app-demo-comp-timeline-horizontal class="demo-section"></app-demo-comp-timeline-horizontal>

    <app-demo-comp-timeline-clickable class="demo-section"></app-demo-comp-timeline-clickable>

    <app-demo-comp-timeline-pending class="demo-section"></app-demo-comp-timeline-pending>

    <app-demo-comp-timeline-dashed class="demo-section"></app-demo-comp-timeline-dashed>

    <app-demo-comp-timeline-slot class="demo-section"></app-demo-comp-timeline-slot>

    <section>
      <h2 class="pdx-txt-heading section-heading">Slots</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Slot</th><th>Scope</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>content</code></td><td><code>{ item, index, status }</code></td><td>Custom content for each timeline entry</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="pdx-txt-heading section-heading">Props</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>items</code></td><td>Array</td><td>[]</td><td>Timeline items <code>[{ title, description?, date?, icon?, color?, status? }]</code></td></tr>
            <tr><td><code>mode</code></td><td>String</td><td>'left'</td><td>'left' | 'right' | 'alternate' | 'horizontal'</td></tr>
            <tr><td><code>reverse</code></td><td>Boolean</td><td>false</td><td>Reverse item order</td></tr>
            <tr><td><code>pending</code></td><td>Boolean</td><td>false</td><td>Show pending pulsing dot at end</td></tr>
            <tr><td><code>pending-label</code></td><td>String</td><td>'In progress...'</td><td>Pending item label text</td></tr>
            <tr><td><code>clickable</code></td><td>Boolean</td><td>false</td><td>Items are clickable (emits pdx-click)</td></tr>
            <tr><td><code>connector-style</code></td><td>String</td><td>'solid'</td><td>'solid' | 'dashed' | 'dotted'</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="pdx-txt-heading section-heading">Events</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Event</th><th>Payload</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>pdx-click</code></td><td><code>{ item, index }</code></td><td>Fired when a clickable item is clicked</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</template>

<script>
@page '/components/timeline';
@title 'Timeline — PDX Components';


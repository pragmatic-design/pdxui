      <div class="options-table">
        <table>
          <thead><tr><th>Slot</th><th>Scope</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>item</code></td><td><code>{ item, key, type }</code></td><td>Custom menu item content (leaf items only, excludes submenus).</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ═══ MenuItem Interface ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">MenuItem Interface</h2>

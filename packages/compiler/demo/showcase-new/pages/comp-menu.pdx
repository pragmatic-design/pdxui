          <tbody>
            <tr><td><code>pdx-select</code></td><td><code>{ key, item }</code></td><td>An item was activated</td></tr>
            <tr><td><code>pdx-check</code></td><td><code>{ key, checked, item }</code></td><td>A checkbox or radio item changed</td></tr>
            <tr><td><code>pdx-close</code></td><td>—</td><td>Escape on the top-level menu</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ═══ Slots ═══ -->

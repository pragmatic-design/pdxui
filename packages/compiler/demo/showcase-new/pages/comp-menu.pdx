            <tr><td><code>shortcut</code></td><td>string</td><td>Keyboard shortcut display</td></tr>
            <tr><td><code>disabled</code></td><td>boolean</td><td>Disabled state</td></tr>
            <tr><td><code>danger</code></td><td>boolean</td><td>Destructive styling</td></tr>
            <tr><td><code>checked</code></td><td>boolean</td><td>Checked state (checkbox/radio)</td></tr>
            <tr><td><code>radioGroup</code></td><td>string</td><td>Radio group name</td></tr>
            <tr><td><code>children</code></td><td>MenuItem[]</td><td>Submenu items</td></tr>
          </tbody>
        </table>

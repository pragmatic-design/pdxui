            <tr><td><code>open</code></td><td>Boolean</td><td>false</td><td>Shows the menu and focuses its first item</td></tr>
            <tr><td><code>min-width</code></td><td>Number</td><td>180</td><td>Minimum menu width (px)</td></tr>
          </tbody>
        </table>

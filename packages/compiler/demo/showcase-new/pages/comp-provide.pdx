<template>
  <div class="page">
    <h1 class="pdx-txt-title">Provide — Cascading Values</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      Blazor-style <code>CascadingValue</code> for Web Components.
      <code>&lt;pdx-provide&gt;</code> wraps children and makes values available via hierarchical
      Context Protocol. Nearest ancestor wins (scoped override).
    </p>

    <!-- ═══ Single Value ═══ -->
    <app-demo-comp-provide-single class="demo-section"></app-demo-comp-provide-single>

    <!-- ═══ Multiple Values ═══ -->
    <app-demo-comp-provide-multiple class="demo-section"></app-demo-comp-provide-multiple>

    <!-- ═══ Scoped Override ═══ -->
    <app-demo-comp-provide-scoped class="demo-section"></app-demo-comp-provide-scoped>

    <!-- ═══ Future Patterns ═══ -->
    <app-demo-comp-provide-patterns class="demo-section"></app-demo-comp-provide-patterns>

    <!-- ═══ API Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading">API Reference</h2>
      <h3 class="pdx-txt-subheading">&lt;pdx-provide&gt; Props</h3>
      <div class="props-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>:token</code></td><td>Context</td><td>null</td><td>Context token, <code>context&lt;T&gt;('name')</code> (single value mode).</td></tr>
            <tr><td><code>:value</code></td><td>any</td><td>null</td><td>Value to provide (single value mode).</td></tr>
            <tr><td><code>:values</code></td><td>Map</td><td>null</td><td>A Map of token → value (takes priority).</td></tr>
          </tbody>
        </table>
      </div>
      <h3 class="pdx-txt-subheading" style="margin-top: 1.5rem">Consumer API</h3>
      <div class="props-table">
        <table>
          <thead><tr><th>API</th><th>Usage</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>inject(token, el)</code></td><td>anywhere</td><td>Walks the DOM from el upward; throws, naming the token, when nothing provides it.</td></tr>
            <tr><td><code>inject(token, el, fallback)</code></td><td>anywhere</td><td>The same, and returns <code>fallback</code> when nothing provides it.</td></tr>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</template>

<script>
@page '/components/provide';
@title 'Provide — PDX UI';
</script>

    <pdx-demo-comp-badge-overlay class="demo-section"></pdx-demo-comp-badge-overlay>

    <!-- ═══ Interactive ═══ -->
    <pdx-demo-comp-badge-interactive class="demo-section"></pdx-demo-comp-badge-interactive>

    <!-- ═══ CSS Only ═══ -->
    <pdx-demo-comp-badge-css-only class="demo-section"></pdx-demo-comp-badge-css-only>

    <!-- ═══ Composition ═══ -->
    <pdx-demo-comp-badge-composition class="demo-section"></pdx-demo-comp-badge-composition>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Reference</h2>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>value</code><span>string</span><span>Badge content (text or number)</span></div>
        <div class="opt-row"><code>variant</code><span>string</span><span>primary, secondary, success, danger, warning, info, outline-*</span></div>
        <div class="opt-row"><code>max</code><span>number</span><span>Max count before overflow (default 99, shows "99+")</span></div>
        <div class="opt-row"><code>dot</code><span>boolean</span><span>Render as small status dot instead of text</span></div>
        <div class="opt-row"><code>pulse</code><span>boolean</span><span>Pulse animation on dot variant</span></div>
        <div class="opt-row"><code>label</code><span>string</span><span>What the badge means, read instead of its colour or bare number ("Online", "3 unread"). A dot without it is read as "&lt;variant&gt; indicator"</span></div>
        <div class="opt-row"><code>size</code><span>string</span><span>sm, (default), lg</span></div>
        <div class="opt-row"><code>hideZero</code><span>boolean</span><span>Hide when value is 0 or empty (default true)</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Accessibility</h3>
      <p class="pdx-txt-small pdx-ink-muted">
        Badge uses <code>role="status"</code> + <code>aria-live="polite"</code> so screen readers
        announce count changes automatically. <code>label</code> names it ("3 unread messages");
        a dot without one is read as its variant ("danger indicator").
      </p>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">CSS Classes</h3>
      <div class="options-table">
        <div class="opt-header"><span>Class</span><span>Description</span></div>
        <div class="opt-row"><code>.pdx-badge</code><span>Base pill badge</span></div>
        <div class="opt-row"><code>.pdx-badge-{color}</code><span>Filled variant (primary, success, danger, warning, info)</span></div>
        <div class="opt-row"><code>.pdx-badge-outline-{color}</code><span>Outline variant (bordered, transparent bg)</span></div>
        <div class="opt-row"><code>.pdx-badge-sm / -lg</code><span>Size modifiers</span></div>
        <div class="opt-row"><code>.pdx-dot</code><span>Small status dot</span></div>
        <div class="opt-row"><code>.pdx-dot-{color}</code><span>Dot color (success, danger, warning, muted, primary)</span></div>
        <div class="opt-row"><code>.pdx-dot-pulse</code><span>Pulse animation</span></div>
        <div class="opt-row"><code>.pdx-badge-anchor</code><span>Positions child badge on corner of first child</span></div>
      </div>
    </section>

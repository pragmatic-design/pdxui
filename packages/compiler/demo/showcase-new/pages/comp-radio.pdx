<template>
  <div class="page">
    <h1 class="pdx-txt-title">Radio & Groups</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-radio&gt;</code> + <code>&lt;pdx-radio-group&gt;</code> — single selection with arrow key navigation.
      Multi-selection has its own page: <code>&lt;pdx-checkbox-group&gt;</code>.
    </p>

    <!-- ═══ Basic Radio ═══ -->
    <pdx-demo-comp-radio-basic class="demo-section"></pdx-demo-comp-radio-basic>


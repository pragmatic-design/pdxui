    <app-demo-comp-card-product class="demo-section"></app-demo-comp-card-product>

    <!-- ═══ Horizontal / Article ═══ -->
    <app-demo-comp-card-horizontal class="demo-section"></app-demo-comp-card-horizontal>

    <!-- ═══ Interactive States ═══ -->
    <app-demo-comp-card-interactive class="demo-section"></app-demo-comp-card-interactive>


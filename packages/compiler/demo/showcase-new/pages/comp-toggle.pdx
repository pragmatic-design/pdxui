        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>pressed</code><span>boolean</span><span>Toggle on/off state</span></div>
        <div class="opt-row"><code>disabled</code><span>boolean</span><span>Disabled state</span></div>
        <div class="opt-row"><code>value</code><span>string</span><span>Value for group mode</span></div>

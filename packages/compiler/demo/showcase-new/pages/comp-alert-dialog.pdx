<template>
  <div class="page">
    <h1 class="pdx-txt-title">AlertDialog</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      Confirmation dialog that requires user action. Cannot close via backdrop or Escape.
      Auto-focuses Cancel (safety-first). Supports danger variant, type-to-confirm, timer-gated confirm.
    </p>

    <!-- ═══ Basic ═══ -->
    <app-demo-comp-alert-dialog-basic class="demo-section"></app-demo-comp-alert-dialog-basic>

    <!-- ═══ Danger ═══ -->
    <app-demo-comp-alert-dialog-danger class="demo-section"></app-demo-comp-alert-dialog-danger>

    <!-- ═══ Type to Confirm ═══ -->
    <app-demo-comp-alert-dialog-type-to-confirm class="demo-section"></app-demo-comp-alert-dialog-type-to-confirm>

    <!-- ═══ Timer Gated ═══ -->
    <app-demo-comp-alert-dialog-timer class="demo-section"></app-demo-comp-alert-dialog-timer>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading">Reference</h2>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Description</span></div>
        <div class="opt-row"><code>open</code><span>Open/close state. A model: <code>::open</code> follows Confirm, Cancel and Escape</span></div>
        <div class="opt-row"><code>title</code><span>Dialog title</span></div>
        <div class="opt-row"><code>message</code><span>Description text</span></div>
        <div class="opt-row"><code>variant</code><span>"default" or "danger" (red confirm)</span></div>
        <div class="opt-row"><code>confirmLabel</code><span>Confirm button text</span></div>
        <div class="opt-row"><code>cancelLabel</code><span>Cancel button text</span></div>
        <div class="opt-row"><code>confirmText</code><span>Type-to-confirm: required text match</span></div>
        <div class="opt-row"><code>confirmDelay</code><span>Timer-gated: seconds before confirm enabled</span></div>
        <div class="opt-row"><code>loading</code><span>Holds the confirm back; the panel is <code>aria-busy</code></span></div>
        <div class="opt-row"><code>closeOnEscape</code><span>Allow Escape (default false)</span></div>
      </div>
      <div class="options-table" style="margin-top:var(--pdx-space-lg)">
        <div class="opt-header"><span>Event, state or part</span><span>Description</span></div>
        <div class="opt-row"><code>open-change</code><span><code>{ value }</code>: it opened, or closed itself</span></div>
        <div class="opt-row"><code>pdx-confirm</code><span>The user confirmed; it has closed</span></div>
        <div class="opt-row"><code>pdx-cancel</code><span>The user cancelled; it has closed</span></div>
        <div class="opt-row"><code>:state(open)</code><span>The dialog is open</span></div>
        <div class="opt-row"><code>:state(loading)</code><span>Loading</span></div>
        <div class="opt-row"><code>[data-part]</code><span><code>root</code> (the panel), <code>backdrop</code>, <code>header</code>, <code>body</code>, <code>footer</code>, <code>cancel</code>, <code>confirm</code>, <code>confirm-input</code></span></div>
      </div>
    </section>
  </div>
</template>

<script>
@page '/components/alert-dialog';
@title 'AlertDialog';
</script>

<style scoped>
  .page { }
</style>

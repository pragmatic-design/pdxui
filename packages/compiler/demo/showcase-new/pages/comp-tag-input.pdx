<template>
  <div class="page">
    <h1 class="pdx-txt-title">Tag Input</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-tag-input&gt;</code> — multi-tag input with chip rendering, paste support, keyboard navigation, and duplicate prevention.
    </p>

    <!-- ═══ Console ═══ -->
    <div class="console-panel">
      <div class="console-header">
        <span class="pdx-txt-caption pdx-ink-muted">Event Console</span>
        <button class="pdx-ghost" size="sm" @click="clearLog">Clear</button>
      </div>
      <div class="console-body pdx-txt-mono">
        @if (logs.length === 0) {
          <span class="pdx-ink-muted">Interact with tag inputs below...</span>
        } @else {
          @for (logs as entry; track entry.id) {
            <div class="log-entry">
              <span class="log-time">{{ entry.time }}</span>
              <span>{{ entry.text }}</span>
            </div>
          }
        }
      </div>
    </div>

    <!-- ═══ Basic ═══ -->
    <pdx-demo-comp-tag-input-basic class="demo-section"></pdx-demo-comp-tag-input-basic>


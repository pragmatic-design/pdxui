<template>
  <div class="page">
    <h1 class="pdx-txt-title">InlineEdit</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-inline-edit&gt;</code> — click to edit any data type in-place.
      Renders the appropriate editor (input, date picker, select, switch, etc.) based on the <code>type</code> prop.
    </p>

    <!-- ═══ 1. Text ═══ -->
    <app-demo-comp-inline-edit-text class="demo-section"></app-demo-comp-inline-edit-text>

    <!-- ═══ 2. Number & Currency ═══ -->
    <app-demo-comp-inline-edit-number-currency class="demo-section"></app-demo-comp-inline-edit-number-currency>

    <!-- ═══ 3. Date & DateTime ═══ -->
    <app-demo-comp-inline-edit-date class="demo-section"></app-demo-comp-inline-edit-date>

    <!-- ═══ 4. Boolean ═══ -->
    <app-demo-comp-inline-edit-boolean class="demo-section"></app-demo-comp-inline-edit-boolean>

    <!-- ═══ 5. Select & MultiSelect ═══ -->
    <app-demo-comp-inline-edit-select class="demo-section"></app-demo-comp-inline-edit-select>

    <!-- ═══ 6. Color & Rating ═══ -->
    <app-demo-comp-inline-edit-color-rating class="demo-section"></app-demo-comp-inline-edit-color-rating>

    <!-- ═══ 7. Textarea ═══ -->
    <app-demo-comp-inline-edit-textarea class="demo-section"></app-demo-comp-inline-edit-textarea>

    <!-- ═══ 8. Action mode (buttons) ═══ -->
    <app-demo-comp-inline-edit-action-mode class="demo-section"></app-demo-comp-inline-edit-action-mode>

    <!-- ═══ 9. Disabled & Readonly ═══ -->
    <app-demo-comp-inline-edit-disabled-readonly class="demo-section"></app-demo-comp-inline-edit-disabled-readonly>

    <!-- ═══ 10. Real-world: Editable table row ═══ -->
    <app-demo-comp-inline-edit-editable-record class="demo-section"></app-demo-comp-inline-edit-editable-record>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Props Reference</h2>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>type</code><span>string</span><span>text | number | currency | date | datetime | boolean | select | multiselect | color | rating | textarea</span></div>
        <div class="opt-row"><code>value</code><span>any</span><span>Current value</span></div>
        <div class="opt-row"><code>options</code><span>array</span><span>For select/multiselect: [{ value, label }]</span></div>
        <div class="opt-row"><code>editOn</code><span>string</span><span>'click' (default) | 'dblclick' | 'icon': only the pencil button opens the editor, the value is not a tab stop</span></div>
        <div class="opt-row"><code>saveOn</code><span>string</span><span>'blur' (default, auto-save) | 'action' (confirm/cancel buttons)</span></div>
        <div class="opt-row"><code>currency</code><span>string</span><span>Currency code for type=currency (default: EUR)</span></div>
        <div class="opt-row"><code>placeholder</code><span>string</span><span>Text when value is empty</span></div>
        <div class="opt-row"><code>showIcon</code><span>boolean</span><span>Show edit pencil icon on hover (default: true)</span></div>
        <div class="opt-row"><code>label</code><span>string</span><span>The field's name, for the editor's accessible name (default: "Edit {value}")</span></div>
        <div class="opt-row"><code>disabled</code><span>boolean</span><span>Disabled state</span></div>
        <div class="opt-row"><code>readonly</code><span>boolean</span><span>Readonly state</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Events</h3>
      <div class="options-table">
        <div class="opt-header"><span>Event</span><span>Detail</span><span>Description</span></div>
        <div class="opt-row"><code>value-change</code><span>{ value }</span><span>Value confirmed (Enter, blur, or button); <code>::value</code> binds it both ways</span></div>
        <div class="opt-row"><code>pdx-cancel</code><span>—</span><span>Edit cancelled (Escape or cancel button)</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Methods</h3>
      <div class="options-table">
        <div class="opt-header"><span>Method</span><span>—</span><span>Description</span></div>
        <div class="opt-row"><code>startEdit()</code><span></span><span>Open the editor, as a click does; nothing while disabled or readonly</span></div>
        <div class="opt-row"><code>confirmEdit() / cancelEdit()</code><span></span><span>Save and close / close and keep the value (emits <code>pdx-cancel</code>)</span></div>
        <div class="opt-row"><code>focus() / blur()</code><span></span><span>Focus or blur the display, or with editOn 'icon' the pencil button</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">States and parts</h3>
      <div class="options-table">
        <div class="opt-header"><span>Selector</span><span>—</span><span>When</span></div>
        <div class="opt-row"><code>:state(disabled) / :state(readonly)</code><span></span><span><code>disabled</code> / <code>readonly</code> is set</span></div>
        <div class="opt-row"><code>:state(editing)</code><span></span><span>The editor is open</span></div>
        <div class="opt-row"><code>[data-part="root"] / [data-part="display"] / [data-part="editor"]</code><span></span><span>The frame, the value at rest (<code>role="button"</code>), the editor's container</span></div>
        <div class="opt-row"><code>[data-part="edit"]</code><span></span><span>With <code>editOn="icon"</code>, the pencil button that opens the editor; the display is then no button</span></div>
        <div class="opt-row"><code>[data-part="save"] / [data-part="cancel"]</code><span></span><span>The buttons of <code>saveOn="action"</code></span></div>
      </div>
    </section>
  </div>
</template>

<script>
@page '/components/inline-edit';
@title 'InlineEdit Component';
</script>

<style scoped>
  .page { }
</style>

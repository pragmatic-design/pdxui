    <pdx-demo-comp-dialog-no-close-button class="demo-section"></pdx-demo-comp-dialog-no-close-button>

    <!-- ═══ Nested Dialogs ═══ -->
    <pdx-demo-comp-dialog-nested class="demo-section"></pdx-demo-comp-dialog-nested>

    <!-- ═══ Initial Focus ═══ -->
    <pdx-demo-comp-dialog-initial-focus class="demo-section"></pdx-demo-comp-dialog-initial-focus>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading">Reference</h2>

      <h3 class="pdx-txt-subheading">Props</h3>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Default</span><span>Description</span></div>
        <div class="opt-row"><code>open</code><span>boolean</span><span>false</span><span>Controls visibility</span></div>
        <div class="opt-row"><code>title</code><span>string</span><span>''</span><span>Dialog header title</span></div>
        <div class="opt-row"><code>size</code><span>string</span><span>'md'</span><span>sm | md | lg | xl | full</span></div>
        <div class="opt-row"><code>close-on-backdrop</code><span>boolean</span><span>true</span><span>Close on backdrop click</span></div>
        <div class="opt-row"><code>close-on-escape</code><span>boolean</span><span>true</span><span>Close on Escape key</span></div>
        <div class="opt-row"><code>show-close</code><span>boolean</span><span>true</span><span>Show X close button in header</span></div>
        <div class="opt-row"><code>initial-focus</code><span>string</span><span>''</span><span>CSS selector for initial focus target</span></div>
        <div class="opt-row"><code>prevent-close</code><span>boolean</span><span>false</span><span>Dispatch pdx-before-close (cancelable) before closing</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Events</h3>
      <div class="options-table">
        <div class="opt-header"><span>Event</span><span>Description</span></div>
        <div class="opt-row"><code>pdx-close</code><span>Emitted when dialog closes</span></div>
        <div class="opt-row"><code>pdx-before-close</code><span>Cancelable — call preventDefault() to prevent close</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Slots</h3>
      <div class="options-table">

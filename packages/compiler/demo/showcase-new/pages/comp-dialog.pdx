        <div class="opt-row"><code>default</code><span>Dialog body content</span></div>
        <div class="opt-row"><code>footer</code><span>Footer with action buttons</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Imperative API</h3>
      <pre class="pdx-txt-mono source-code"><code>&lt;pdx-dialog :open="isOpen" title="Confirm" @pdx-close="close"&gt;
  &lt;p&gt;Are you sure?&lt;/p&gt;
  &lt;div slot="footer"&gt;
    &lt;pdx-button variant="ghost" @click="close"&gt;Cancel&lt;/pdx-button&gt;
    &lt;pdx-button variant="primary" @click="confirm"&gt;OK&lt;/pdx-button&gt;
  &lt;/div&gt;
&lt;/pdx-dialog&gt;</code></pre>

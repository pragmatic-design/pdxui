<template>
  <div class="page">
    <h1 class="pdx-txt-title">DataSource & pdx-data-source</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>DataSource</code> is the reactive data layer for lists, tables, and selects.
      <code>&lt;pdx-data-source&gt;</code> is a non-rendering component that creates one declaratively.
    </p>

    <!-- ═══ Basic: Programmatic DataSource ═══ -->
    <pdx-demo-comp-data-source-programmatic class="demo-section"></pdx-demo-comp-data-source-programmatic>

    <!-- ═══ Declarative: pdx-data-source ═══ -->
    <pdx-demo-comp-data-source-declarative class="demo-section"></pdx-demo-comp-data-source-declarative>

    <!-- ═══ Wrapping Children ═══ -->
    <pdx-demo-comp-data-source-provider class="demo-section"></pdx-demo-comp-data-source-provider>

    <!-- ═══ Remote Simulation ═══ -->
    <pdx-demo-comp-data-source-remote class="demo-section"></pdx-demo-comp-data-source-remote>

    <!-- ═══ Cascading DataSources ═══ -->
    <pdx-demo-comp-data-source-cascading class="demo-section"></pdx-demo-comp-data-source-cascading>

    <!-- ═══ Props Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading">pdx-data-source Props</h2>
      <div class="props-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>url</code></td><td>String</td><td>''</td><td>REST endpoint. Creates restTransport.</td></tr>
            <tr><td><code>:data</code></td><td>Array</td><td>null</td><td>Static data. Creates arrayTransport.</td></tr>
            <tr><td><code>:transport</code></td><td>Object</td><td>null</td><td>Custom IDataTransport (priority).</td></tr>
            <tr><td><code>id-field</code></td><td>String</td><td>'id'</td><td>Unique ID field.</td></tr>
            <tr><td><code>:page-size</code></td><td>Number</td><td>0</td><td>Pagination. 0 = none.</td></tr>
            <tr><td><code>auto-load</code></td><td>Boolean</td><td>true</td><td>Load on creation.</td></tr>
            <tr><td><code>name</code></td><td>String</td><td>''</td><td>Context key for provide (ds:{name}).</td></tr>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</template>


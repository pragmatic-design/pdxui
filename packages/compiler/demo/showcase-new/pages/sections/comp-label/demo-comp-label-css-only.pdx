<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">CSS-only (no WC)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Use <code>.pdx-field-label</code> + <code>.pdx-field-required</code> classes directly on <code>&lt;label&gt;</code> elements.
    </p>

    <div class="demo-stack">
      <label class="pdx-field-label">Standard label</label>
      <label class="pdx-field-label pdx-field-required">Required label</label>
      <label class="pdx-field-label pdx-field-optional">Optional label</label>
      <label class="pdx-field-label pdx-field-label-disabled">Disabled label</label>
      <label class="pdx-field-label pdx-field-label-xs">XS size</label>
      <label class="pdx-field-label pdx-field-label-lg">LG size</label>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;label class="pdx-field-label"&gt;Standard&lt;/label&gt;
&lt;label class="pdx-field-label pdx-field-required"&gt;Required&lt;/label&gt;
&lt;label class="pdx-field-label pdx-field-optional"&gt;Optional&lt;/label&gt;
&lt;label class="pdx-field-label pdx-field-label-disabled"&gt;Disabled&lt;/label&gt;</code></pre>
    </details>
  </section>
</template>

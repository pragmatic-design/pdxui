<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Radio</h2>
    <p class="pdx-txt-small pdx-ink-muted">Apply <code>.pdx-radio</code> to the <code>&lt;input type="radio"&gt;</code>. Group with shared <code>name</code>.</p>

    <div class="control-list">
      <label class="control-row"><input type="radio" class="pdx-radio" name="plan" value="free" /><span>Free</span></label>
      <label class="control-row"><input type="radio" class="pdx-radio" name="plan" value="pro" checked /><span>Pro</span></label>
      <label class="control-row"><input type="radio" class="pdx-radio" name="plan" value="ent" disabled /><span>Enterprise (coming soon)</span></label>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;label&gt;
  &lt;input type="radio" class="pdx-radio" name="plan" /&gt;
  Free
&lt;/label&gt;
&lt;label&gt;
  &lt;input type="radio" class="pdx-radio" name="plan" checked /&gt;
  Pro
&lt;/label&gt;</code></pre>
    </details>
  </section>
</template>

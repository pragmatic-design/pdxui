<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Checkbox</h2>
    <p class="pdx-txt-small pdx-ink-muted">Apply <code>.pdx-checkbox</code> to the <code>&lt;input type="checkbox"&gt;</code>. States: checked, indeterminate, disabled.</p>

    <div class="control-list">
      <label class="control-row"><input type="checkbox" class="pdx-checkbox" /><span>Default</span></label>
      <label class="control-row"><input type="checkbox" class="pdx-checkbox" checked /><span>Checked</span></label>
      <label class="control-row"><input type="checkbox" class="pdx-checkbox" disabled /><span>Disabled</span></label>
      <label class="control-row"><input type="checkbox" class="pdx-checkbox" checked disabled /><span>Checked disabled</span></label>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;label&gt;
  &lt;input type="checkbox" class="pdx-checkbox" /&gt;
  Default
&lt;/label&gt;
&lt;label&gt;
  &lt;input type="checkbox" class="pdx-checkbox" checked /&gt;
  Checked
&lt;/label&gt;</code></pre>
    </details>
  </section>
</template>

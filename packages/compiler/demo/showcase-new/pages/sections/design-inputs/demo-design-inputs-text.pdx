<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Text Input</h2>
    <p class="pdx-txt-small pdx-ink-muted">Single class for all text-like inputs. Focus ring, placeholder, disabled, invalid states built in.</p>

    <div class="demo-stack">
      <input class="pdx-input" type="text" placeholder="Default input" />
      <input class="pdx-input" type="text" value="With value" />
      <input class="pdx-input" type="text" placeholder="Disabled input" disabled />
      <input class="pdx-input" type="text" value="Invalid input" aria-invalid="true" />
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;input class="pdx-input" type="text" placeholder="Enter name" /&gt;
&lt;input class="pdx-input" disabled /&gt;
&lt;input class="pdx-input" aria-invalid="true" /&gt;</code></pre>
    </details>
  </section>
</template>

<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">2. Declarative Composition (Template)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Same nested DTO, but composed declaratively in the template with <code>&lt;pdx-field-group&gt;</code>.
      A field inside <code>&lt;pdx-field-group name="customer"&gt;</code> is bound by its full path,
      <code>::value="form['customer.email']"</code>.
    </p>

    <div class="demo-block">
      <pdx-form :form="declForm" @pdx-submit="saveDeclForm">
        <div class="form-grid">
          <pdx-form-field :field="declForm.orderNumber" label="Order #" required>
            <pdx-input name="orderNumber" ::value="declForm.orderNumber"></pdx-input>
          </pdx-form-field>
        </div>

        <pdx-field-group name="customer" label="Customer">
          <div class="form-grid">
            <pdx-form-field :field="declForm['customer.name']" label="Name" required>
              <pdx-input name="customer.name" ::value="declForm['customer.name']" placeholder="Full name"></pdx-input>
            </pdx-form-field>
            <pdx-form-field :field="declForm['customer.email']" label="Email" required>
              <pdx-input name="customer.email" ::value="declForm['customer.email']" type="email" placeholder="email@company.com"></pdx-input>
            </pdx-form-field>
          </div>
        </pdx-field-group>

        <pdx-field-group name="shipping" label="Shipping Address">
          <div class="form-grid-3">
            <pdx-form-field :field="declForm['shipping.street']" label="Street">
              <pdx-input name="shipping.street" ::value="declForm['shipping.street']"></pdx-input>
            </pdx-form-field>
            <pdx-form-field :field="declForm['shipping.city']" label="City">
              <pdx-input name="shipping.city" ::value="declForm['shipping.city']"></pdx-input>
            </pdx-form-field>
            <pdx-form-field :field="declForm['shipping.zip']" label="ZIP">
              <pdx-input name="shipping.zip" ::value="declForm['shipping.zip']"></pdx-input>
            </pdx-form-field>
          </div>
        </pdx-field-group>

        <pdx-form-actions submitLabel="Save Order" resetLabel="Reset"></pdx-form-actions>
      </pdx-form>

      <div class="form-output">
        <div class="form-status">
          <span :class="declDirtyClass()" :textContent="declDirtyText()"></span>
          <span :class="declValidClass()" :textContent="declValidText()"></span>
        </div>
        <strong>getValues():</strong>
        <pre class="form-json" :textContent="declValuesJson()"></pre>
      </div>
    </div>

    @raw {<details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>&lt;pdx-form :form="orderForm"&gt;
  &lt;pdx-form-field :field="orderForm.orderNumber" label="Order #" required&gt;
    &lt;pdx-input name="orderNumber" ::value="orderForm.orderNumber" /&gt;
  &lt;/pdx-form-field&gt;

  &lt;pdx-field-group name="customer" label="Customer"&gt;
    &lt;pdx-form-field :field="orderForm['customer.name']" label="Name" required&gt;
      &lt;pdx-input name="customer.name" ::value="orderForm['customer.name']" /&gt;
    &lt;/pdx-form-field&gt;
  &lt;/pdx-field-group&gt;

  &lt;pdx-field-group name="shipping" label="Shipping"&gt;
    &lt;pdx-form-field :field="orderForm['shipping.street']" label="Street"&gt;...&lt;/pdx-form-field&gt;
    &lt;pdx-form-field :field="orderForm['shipping.city']" label="City"&gt;...&lt;/pdx-form-field&gt;
  &lt;/pdx-field-group&gt;
&lt;/pdx-form&gt;

// createForm accepts nested initialValues:
const orderForm = createForm({
  initialValues: {
    orderNumber: 'ORD-042',
    customer: { name: 'Jane', email: 'jane@test.com' },
    shipping: { street: '', city: '', zip: '' },
  },
  validators: {
    'customer.name': [required()],  // dotted path validators
    'customer.email': [required(), email()],
  },
});</code></pre></details>}
  </section>
</template>

<script>
import { createForm, required, email } from '@pdxui/core';

// ─── 2. Declarative Composition ───
const declForm = createForm({
  initialValues: {
    orderNumber: 'ORD-042',
    customer: { name: 'Jane Doe', email: 'jane@acme.com' },
    shipping: { street: '123 Main St', city: 'New York', zip: '10001' },
  },
  validators: {
    'orderNumber': [required('Order number is required')],
    'customer.name': [required('Name is required')],
    'customer.email': [required('Email is required'), email('Invalid email')],
  },
});

function saveDeclForm() { declForm.validate(); }
function declDirtyText() { return 'Dirty: ' + (declForm.dirty() ? 'Yes' : 'No'); }
function declDirtyClass() { return 'form-status-badge' + (declForm.dirty() ? ' active' : ''); }
function declValidText() { return 'Valid: ' + (declForm.valid() ? 'Yes' : 'No'); }
function declValidClass() { return 'form-status-badge' + (declForm.valid() ? ' success' : ' error'); }
function declValuesJson() { const d = declForm.dirty(); return JSON.stringify(declForm.getValues(), null, 2); }
</script>

<style scoped>
  .form-json {
    margin: var(--pdx-space-xs) 0 0;
    padding: var(--pdx-space-sm);
    font-family: var(--pdx-font-mono);
    font-size: var(--pdx-text-xs);
    background: var(--pdx-color-inset);
    border-radius: var(--pdx-radius-sm);
    overflow-x: auto;
    max-height: 250px;
    white-space: pre-wrap;
  }
  .form-status { display: flex; gap: var(--pdx-space-sm); margin-bottom: var(--pdx-space-sm); }

  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .demo-block {
    margin-top: var(--pdx-space-lg);
    padding: var(--pdx-space-lg);
    border: 1px solid var(--pdx-color-border);
    border-radius: var(--pdx-radius-lg);
    background: var(--pdx-color-surface);
  }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--pdx-space-md); }
  .form-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--pdx-space-md); }
  @media (max-width: 640px) { .form-grid, .form-grid-3 { grid-template-columns: 1fr; } }
  .form-output {
    margin-top: var(--pdx-space-lg);
    padding-top: var(--pdx-space-md);
    border-top: 1px solid var(--pdx-color-border);
  }
  .form-status-badge { display: inline-block; padding: 2px 10px; border-radius: var(--pdx-radius-sm); font-size: var(--pdx-text-xs); background: var(--pdx-color-inset); color: var(--pdx-color-muted); }
  .form-status-badge.active { background: var(--pdx-color-danger); color: var(--pdx-color-danger-text); }
  .form-status-badge.success { background: var(--pdx-color-success); color: var(--pdx-color-success-text); }
  .form-status-badge.error { background: var(--pdx-color-danger); color: var(--pdx-color-danger-text); }
</style>

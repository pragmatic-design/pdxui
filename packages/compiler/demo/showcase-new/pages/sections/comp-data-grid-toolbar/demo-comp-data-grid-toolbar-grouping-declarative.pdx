<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Grouping (Declarative)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Pre-configured grouping via <code>group-by</code> prop with aggregates.
    </p>
    <div class="demo-container">
      <pdx-data-grid :source="groupDS" :columns="groupColumns" :group-by="groupByCategory" hover></pdx-data-grid>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-data-grid :source="ds" :columns="columns"
  :group-by="[{ field: 'category',
    aggregates: [
      { field: 'price', aggregate: 'sum' },
      { field: 'stock', aggregate: 'average' }
    ]}]" hover&gt;
&lt;/pdx-data-grid&gt;</code></pre>
    </details>
  </section>
</template>

<script setup>
import { createDataSource } from '@pdxui/core';
import { products } from './state.pdx';

// ─── Grouping declarative ───────────────────
const groupColumns = [
  { field: 'name', header: 'Product' },
  { field: 'category', header: 'Category' },
  { field: 'price', header: 'Price', type: 'currency' },
  { field: 'stock', header: 'Stock', type: 'number' },
];

const groupDS = createDataSource({
  data: products.slice(0, 20),
  pageSize: 0,
  group: [{ field: 'category', aggregates: [{ field: 'price', aggregate: 'sum' }, { field: 'stock', aggregate: 'average' }] }],
});

const groupByCategory = [
  { field: 'category', aggregates: [
    { field: 'price', aggregate: 'sum' },
    { field: 'stock', aggregate: 'average' },
  ]},
];
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  section { margin-bottom: var(--pdx-space-3xl); }
  .section-heading { margin-bottom: var(--pdx-space-sm); }
  .demo-container {
  padding: var(--pdx-space-md);
  border: 1px solid var(--pdx-color-border);
  border-radius: var(--pdx-radius-md);
  background: var(--pdx-color-bg);
  overflow: hidden;
}
  .source-block { margin-top: var(--pdx-space-sm); }
  .source-block summary { cursor: pointer; font-size: var(--pdx-text-xs); color: var(--pdx-color-muted); }
  .source-block pre { margin-top: var(--pdx-space-xs); padding: var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-sm); overflow-x: auto; font-size: var(--pdx-text-xs); }
</style>

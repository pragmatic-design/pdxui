<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Command Column</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>command: true</code> on a column disables sort/filter/resize/reorder automatically.
      Use the <code>col:{field}</code> slot for custom action buttons.
    </p>
    <div class="demo-container">
      <pdx-data-grid :source="commandDS" :columns="commandColumns" hover></pdx-data-grid>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>const columns = [
  { field: 'name', header: 'Name' },
  { field: 'role', header: 'Role' },
  { field: '_actions', header: '', width: 120, command: true },
];

&lt;pdx-data-grid :source="ds" :columns="columns" hover&gt;
  &lt;slot name="col:_actions" let:row let:id&gt;
    &lt;pdx-button size="xs" @click="edit(id)"&gt;Edit&lt;/pdx-button&gt;
    &lt;pdx-button size="xs" variant="danger" @click="remove(id)"&gt;
      Delete
    &lt;/pdx-button&gt;
  &lt;/slot&gt;
&lt;/pdx-data-grid&gt;</code></pre>
    </details>
  </section>
</template>

<script setup>
import { createDataSource } from '@pdxui/core';
import { typedData } from './state.pdx';

// ─── Command column ───────────────────────
const commandColumns = [
  { field: 'name', header: 'Name', width: 180 },
  { field: 'role', header: 'Role', width: 120 },
  { field: 'salary', header: 'Salary', type: 'currency', width: 120 },
  { field: '_actions', header: '', width: 140, command: true },
];

const commandDS = createDataSource({ data: typedData, pageSize: 0 });
</script>

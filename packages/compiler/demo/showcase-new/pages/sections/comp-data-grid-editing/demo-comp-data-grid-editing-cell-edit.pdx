  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .demo-container { padding: var(--pdx-space-md); border: 1px solid var(--pdx-color-border); border-radius: var(--pdx-radius-md); background: var(--pdx-color-bg); overflow: hidden; }

<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Built-in Pragmatic Icons</h2>
    <p class="pdx-txt-small pdx-ink-muted">{{ iconCount }} icons included. Zero dependencies. Register with <code>registerPragmaticIcons()</code>.</p>

    <div class="icon-grid">
      @for (iconNames as name; track name) {
        <div class="icon-cell">
          <pdx-icon :name="name" size="lg"></pdx-icon>
          <span class="pdx-txt-caption">{{ name }}</span>
        </div>
      }

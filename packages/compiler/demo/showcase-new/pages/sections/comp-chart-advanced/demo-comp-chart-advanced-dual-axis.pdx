<template>
  <section>
    <h2 class="pdx-txt-heading">Dual Y-Axis (Mixed Chart)</h2>
    <p class="pdx-txt-small pdx-ink-muted">Bar for revenue (left, currency) + Line for growth (right, %). Each series has its own scale.</p>

    <div class="demo-area">
      <pdx-chart type="bar" :data="dualAxisData" :x-field="'month'" :series-config="dualSeriesConfig" title="Revenue vs Growth" :y-axis-name="'Revenue'" :y-axis-right-name="'Growth'" :y-format="'currency'" :y-right-format="'percent'" height="340px"></pdx-chart>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-chart type="bar" :data="data"
  :series-config='[
    { "field": "revenue", "type": "bar" },
    { "field": "growth", "type": "line", "yAxisIndex": 1 }
  ]'
  :y-format="'currency'" :y-right-format="'percent'" /&gt;</code></pre>
    </details>
  </section>
</template>

<script>
const dualAxisData = [
  { month: 'Jan', revenue: 42000, growth: 5 },
  { month: 'Feb', revenue: 51000, growth: 8 },
  { month: 'Mar', revenue: 48000, growth: 12 },
  { month: 'Apr', revenue: 62000, growth: 18 },
  { month: 'May', revenue: 59000, growth: 15 },
  { month: 'Jun', revenue: 71000, growth: 22 },
  { month: 'Jul', revenue: 68000, growth: 20 },
  { month: 'Aug', revenue: 74000, growth: 25 },
];

const dualSeriesConfig = JSON.stringify([
  { field: 'revenue', name: 'Revenue', type: 'bar' },
  { field: 'growth', name: 'Growth %', type: 'line', yAxisIndex: 1, smooth: true },
]);
</script>


<template>
  <section>
    <h2 class="pdx-txt-heading">Zoom & Pan</h2>
    <p class="pdx-txt-small pdx-ink-muted">Mouse wheel to zoom, drag to pan. Set <code>zoom="inside"</code>.</p>

    <div class="demo-area">
      <pdx-chart type="line" :data="zoomData" :x-field="'day'" :y-field="'value'" :legend="false" zoom="inside" smooth height="300px" title="90-day trend (scroll to zoom, drag to pan)"></pdx-chart>
    </div>
  </section>
</template>

<script setup>
const zoomData = Array.from({ length: 90 }, (_, i) => ({
  day: 'Day ' + (i + 1),
  value: Math.round(50 + 30 * Math.sin(i / 8) + Math.random() * 15),
}));
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  section { margin-bottom: var(--pdx-space-3xl); }
  .demo-area { margin-top: var(--pdx-space-md); padding: var(--pdx-space-md); border: 1px solid var(--pdx-color-border); border-radius: var(--pdx-radius-md); background: var(--pdx-color-surface); }
</style>

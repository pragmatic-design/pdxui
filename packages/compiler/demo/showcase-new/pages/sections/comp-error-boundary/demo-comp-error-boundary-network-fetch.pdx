<template>
  <section>
    <h2 class="pdx-txt-heading">Network Fetch — Retry with Countdown</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Simulates a network request that fails. Click "Load Users" to start.
      Auto-retries up to 3 times with a live countdown, then succeeds or gives up.
    </p>
    <div class="demo-box">
      @if (netState === 'idle') {
        <div class="demo-widget">
          <button class="pdx-outline" size="sm" @click="startNetworkDemo">Load Users</button>
        </div>
      }
      @if (netState === 'loading') {
        <div class="demo-widget state-loading" role="status">
          <div class="demo-spinner"></div>
          <span class="pdx-txt-small pdx-ink-muted">Fetching /api/users...</span>
        </div>
      }
      @if (netState === 'error') {
        <div class="demo-error" role="alert">
          <div class="demo-error-icon">&#128268;</div>
          <div class="demo-error-msg">Failed to load user data</div>
          <div class="demo-error-detail">{{ netError }}</div>
          @if (netRetry < 3) {
            <div class="demo-error-meta">Retry {{ netRetry }} of 3 — next attempt in {{ netCountdown }}s</div>
            <button class="pdx-danger retry-btn" size="sm" disabled>Retrying...</button>
          } @else {
            <div class="demo-error-meta">Failed after 3 attempts.</div>
            <button class="pdx-outline retry-btn" size="sm" @click="resetNetworkDemo">Start Over</button>
          }
        </div>
      }
      @if (netState === 'success') {
        <div class="demo-widget success-widget" role="status">
          <div class="pdx-txt-small" style="color: var(--pdx-color-success); font-weight: 600">&#10003; Data loaded successfully</div>
          <div class="pdx-txt-small pdx-ink-muted">Loaded 3 users after {{ netRetry }} failed attempts.</div>
          <button class="pdx-outline" size="sm" style="margin-top: var(--pdx-space-xs)" @click="resetNetworkDemo">Reset</button>
        </div>
      }
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>@@try {
  &lt;app-user-list /&gt;
} @@catch (err) {
  &lt;div role="alert"&gt;
    {{ err instanceof Error ? err.message : String(err) }}
    &lt;button @@click="retry"&gt;Retry&lt;/button&gt;
  &lt;/div&gt;
}

// Or with onGlobalError:
onGlobalError((error, ctx) =&gt; {
  if (ctx.source === 'async') {
    showToast(error.message);
    return true; // handled
  }
});</code></pre></details>}
  </section>
</template>

<script>
// ─── Network Fetch Simulation ───────────────────────────

let netState = $signal('idle');
let netError = $signal('');
let netRetry = $signal(0);
let netCountdown = $signal(0);

// Non-signal: timer IDs don't need reactivity
const timers = { id: 0 };

function startNetworkDemo() {
  netState = 'loading';
  netRetry = 0;
  simulateFetch();
}

function simulateFetch() {
  setTimeout(() => {
    netRetry = netRetry + 1;
    netError = 'NetworkError: fetch /api/users failed (ERR_CONNECTION_REFUSED)';
    netState = 'error';

    if (netRetry < 3) {
      startCountdown(3, () => {
        netState = 'loading';
        setTimeout(() => {
          if (netRetry >= 2) {
            netState = 'success';
          } else {
            simulateFetch();
          }
        }, 800);
      });
    }
  }, 1000);
}

function startCountdown(seconds, onDone) {
  netCountdown = seconds;
  timers.id = window.setInterval(() => {
    netCountdown = netCountdown - 1;
    if (netCountdown <= 0) {
      clearInterval(timers.id);
      onDone();
    }
  }, 1000);
}

function resetNetworkDemo() {
  clearInterval(timers.id);
  timers.id = 0;
  netState = 'idle';
  netError = '';
  netRetry = 0;
  netCountdown = 0;
}
</script>

<template>
  <section>
    <h2 class="pdx-txt-heading">onGlobalError — App-wide Interceptor</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Catches all errors not handled by local boundaries. The log below shows errors intercepted globally.
    </p>
    <div class="demo-box">
      <div class="demo-widget">
        <button class="pdx-outline" size="sm" @click="triggerGlobalError">Trigger Unhandled Error</button>
      </div>
      @if (globalErrors.length > 0) {
        <div class="error-log">
          <div class="pdx-txt-small" style="font-weight: 600; margin-bottom: var(--pdx-space-xs)">Global Error Log ({{ globalErrors.length }})</div>
          @for (globalErrors as entry; track entry.id) {
            <div class="log-entry">
              <span class="log-source">{{ entry.source }}</span>
              <span class="log-msg">{{ entry.message }}</span>
              <span class="log-time">{{ entry.time }}</span>
            </div>
          }
        </div>
      }
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>import { onGlobalError } from '@pdxui/core';

onGlobalError((error, context) =&gt; {
  telemetry.log({
    source: context.source,
    component: context.component,
    message: error.message,
  });
  // return true to suppress console.error
  return true;
});</code></pre></details>}
  </section>
</template>

<script>
// ─── Global Error Interceptor Demo ──────────────────────

import { onGlobalError } from '@pdxui/core';

let globalErrors = $signal([]);
let errorId = $signal(0);

onGlobalError(function handleGlobalError(error, context) {
  errorId = errorId + 1;
  globalErrors = globalErrors.slice().concat([{
    id: errorId,
    source: context.source,
    message: error.message,
    time: new Date().toLocaleTimeString(),
  }]);
  return true;
});

function triggerGlobalError() {
  throw new Error('Unhandled click: fetchUserProfile() returned 403 Forbidden');
}
</script>

<style scoped>
.error-log {
  margin-top: var(--pdx-space-sm);
  padding: var(--pdx-space-sm);
  background: var(--pdx-color-inset);
  border-radius: var(--pdx-radius-sm);
  max-height: 160px;
  overflow-y: auto;
}
.log-entry {
  display: flex;
  gap: var(--pdx-space-sm);
  font-size: var(--pdx-text-xs);
  padding: 2px 0;
  border-bottom: 1px solid var(--pdx-color-border);
  font-family: monospace;
}
.log-entry:last-child { border-bottom: none; }
.log-source {
  color: var(--pdx-color-danger-ink);
  font-weight: 600;
  min-width: 50px;
}
.log-msg {
  flex: 1;
  color: var(--pdx-color-text);
}
.log-time {
  color: var(--pdx-color-muted);
  white-space: nowrap;
}
</style>

<template>
  <section>
    <h2 class="pdx-txt-heading">Loading — Remote Simulation</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Uses <code>delayTransport</code> to simulate 1s server latency with <code>autoLoad: false</code>.
      Data loads on first open — click to see the spinner, then options appear after 1s.
    </p>
    <div class="demo-row">
      <pdx-select label="User" :source="remoteUserDS" labelField="name" valueField="id" searchable clearable placeholder="Fetch users (1s delay)..." />
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>import { createDataSource, arrayTransport, delayTransport } from '@pdxui/core';

const remoteUserDS = createDataSource({
  transport: delayTransport({
    transport: arrayTransport({ data: users, idField: 'id' }),
    readDelay: 1000,
  }),
  idField: 'id',
});

&lt;pdx-select :source="remoteUserDS" labelField="name" valueField="id"
  searchable clearable placeholder="Fetch users (1s delay)..." /&gt;</code></pre></details>}
  </section>
</template>

<script setup>
import { createDataSource, arrayTransport, delayTransport } from '@pdxui/core';

const dsUsers = [
  { id: 1, name: 'Alice Johnson', role: 'Lead' },
  { id: 2, name: 'Bob Smith', role: 'Developer' },
  { id: 3, name: 'Charlie Brown', role: 'Designer' },
  { id: 4, name: 'Diana Prince', role: 'PM' },
  { id: 5, name: 'Edward Norton', role: 'DevOps' },
  { id: 6, name: 'Fiona Apple', role: 'QA' },
  { id: 7, name: 'George Lucas', role: 'Architect' },
  { id: 8, name: 'Helen Troy', role: 'Lead' },
];

const remoteUserDS = createDataSource({
  transport: delayTransport({
    transport: arrayTransport({ data: dsUsers, idField: 'id' }),
    readDelay: 1000,
  }),
  idField: 'id',
  autoLoad: false,
});
</script>

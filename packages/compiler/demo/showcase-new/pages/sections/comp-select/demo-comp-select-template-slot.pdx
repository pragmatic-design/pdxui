<template>
  <section>
    <h2 class="pdx-txt-heading">Custom Template — Snippets</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      The <code>item</code> and <code>selected</code> snippets draw an option in the list and the chosen one in the
      trigger, with avatars, descriptions, icons: <code>item(option, index)</code> and <code>selected(option)</code>,
      where <code>option.raw</code> is the original entry.
    </p>
    <div class="demo-row">
      <pdx-select label="Team member" :options="teamMembers" labelField="name" valueField="id" clearable placeholder="Select team member...">
        @snippet item(option) {
          <div class="team-option">
            <span class="team-avatar">{{ option.raw.initials }}</span>
            <div class="team-info">
              <span class="team-name">{{ option.label }}</span>
              <span class="team-role">{{ option.raw.role }}</span>
            </div>
          </div>
        }
        @snippet selected(option) {
          <span class="team-selected">
            <span class="team-avatar-sm">{{ option.raw.initials }}</span> {{ option.label }}
          </span>
        }
      </pdx-select>
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>&lt;pdx-select :options="teamMembers"
  labelField="name" valueField="id"
  clearable placeholder="Select team member..."&gt;

  @snippet item(option) {
    &lt;div class="team-option"&gt;
      &lt;span class="team-avatar"&gt;{{ option.raw.initials }}&lt;/span&gt;
      &lt;div class="team-info"&gt;
        &lt;span class="team-name"&gt;{{ option.label }}&lt;/span&gt;
        &lt;span class="team-role"&gt;{{ option.raw.role }}&lt;/span&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  }

  @snippet selected(option) {
    &lt;span class="team-selected"&gt;
      &lt;span class="team-avatar-sm"&gt;{{ option.raw.initials }}&lt;/span&gt; {{ option.label }}
    &lt;/span&gt;
  }

&lt;/pdx-select&gt;</code></pre></details>}
  </section>
</template>

<script>
const teamMembers = [
  { id: 1, name: 'Alice Johnson', role: 'Lead', initials: 'AJ' },
  { id: 2, name: 'Bob Smith', role: 'Developer', initials: 'BS' },
  { id: 3, name: 'Charlie Brown', role: 'Designer', initials: 'CB' },
  { id: 4, name: 'Diana Prince', role: 'PM', initials: 'DP' },
];
</script>

          <tr><td><code>align</code></td><td>string</td><td>auto</td><td>'left'|'center'|'right' (auto by type)</td></tr>
          <tr><td><code>format</code></td><td>string | fn</td><td>—</td><td>Value formatter function</td></tr>
          <tr><td><code>hidden</code></td><td>boolean</td><td>false</td><td>Hidden but available in column chooser</td></tr>
          <tr><td><code>frozen</code></td><td>string</td><td>—</td><td>'left' or 'right' for sticky columns</td></tr>
          <tr><td><code>compute</code></td><td>fn</td><td>—</td><td>Client-side computed column: (row) => value</td></tr>

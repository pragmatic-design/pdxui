          <tr><td><code>filterOperators</code></td><td>string[]</td><td>auto</td><td>Limit operators: ['contains', 'eq', 'neq', ...]</td></tr>
          <tr><td><code>filterOptions</code></td><td>{ label, value }[]</td><td>—</td><td>Predefined values for enum filter (checkbox list)</td></tr>

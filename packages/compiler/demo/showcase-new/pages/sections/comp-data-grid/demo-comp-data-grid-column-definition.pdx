          <tr><td><code>field</code></td><td>string</td><td>—</td><td>Data field path (supports 'address.city')</td></tr>
          <tr><td><code>header</code></td><td>string</td><td>auto</td><td>Display name (auto-humanized from field)</td></tr>
          <tr><td><code>type</code></td><td>ColumnType</td><td>'text'</td><td>'text'|'number'|'date'|'boolean'|'currency'|'email'|'enum'</td></tr>
          <tr><td><code>width</code></td><td>number</td><td>150</td><td>Column width in px</td></tr>
          <tr><td><code>minWidth</code></td><td>number</td><td>50</td><td>Minimum width in px</td></tr>

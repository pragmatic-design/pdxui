<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Snippets</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      A custom cell with <code>&#64;snippet cell(row, column, value)</code>, one for every column: it
      switches on <code>column.field</code>, and the columns it draws nothing for are the grid's.
      A custom header with <code>&#64;snippet header(column)</code>, the empty state with
      <code>&#64;snippet empty()</code>.
    </p>
    <div class="demo-container">
      <pdx-data-grid :data="slotData" :columns="slotColumns" label="Users" hover>
        @snippet cell(row, column, value) {
          @if (column.field === 'name') {
            <div class="user-cell">
              <pdx-avatar size="xs" :alt="row.name"></pdx-avatar>
              <strong>{{ value }}</strong>
            </div>
          }
        }
      </pdx-data-grid>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>import { status } from '@pdxui/core';

const columns = [
  { field: 'name', header: 'User', width: 220 },
  { field: 'email', header: 'Email', width: 200 },
  { field: 'role', header: 'Role', width: 120 },
  // A typed cell renderer: built DOM, no HTML string
  { field: 'status', header: 'Status', cell: status({ tones: { Active: 'success', Away: 'warning', Offline: 'muted' } }) },
];

&lt;!-- `row` is typed from :data: each row is an element of it --&gt;
&lt;pdx-data-grid :data="users" :columns="columns" hover&gt;

  &lt;!-- A custom cell for the 'name' column; the others are the grid's --&gt;
  &#64;snippet cell(row, column, value) &#123;
    &#64;if (column.field === 'name') &#123;
      &lt;div class="user-cell"&gt;
        &lt;pdx-avatar size="xs" :alt="row.name"&gt;&lt;/pdx-avatar&gt;
        &lt;strong&gt;&#123;&#123; value &#125;&#125;&lt;/strong&gt;
      &lt;/div&gt;
    &#125;
  &#125;

  &lt;!-- A custom header --&gt;
  &#64;snippet header(column) &#123;
    &#64;if (column.field === 'name') &#123;
      &lt;pdx-icon name="user" size="14"&gt;&lt;/pdx-icon&gt; &#123;&#123; column.header &#125;&#125;
    &#125;
  &#125;

  &lt;!-- A custom empty state --&gt;
  &#64;snippet empty() &#123;
    &lt;pdx-empty-state title="No results" icon="search"&gt;&lt;/pdx-empty-state&gt;
  &#125;

&lt;/pdx-data-grid&gt;</code></pre>
    </details>
  </section>
</template>

<script>
import { status } from '@pdxui/core';

// ─── Slot/cell demo — custom cell rendering ───────────
// The name column renders through the `cell` snippet in the template; the status column through a
// typed cell renderer — not a `format` function returning markup, which the grid shows as text.
const slotColumns = [
  { field: 'name', header: 'User', width: 220 },
  { field: 'email', header: 'Email', width: 200 },
  { field: 'role', header: 'Role', width: 120 },
  { field: 'status', header: 'Status', width: 110, cell: status({ tones: { Active: 'success', Away: 'warning', Offline: 'muted' } }) },
];

const slotData = [
  { id: 1, name: 'Alice Johnson', email: 'alice@acme.com', role: 'Engineer', status: 'Active' },
  { id: 2, name: 'Bob Smith', email: 'bob@acme.com', role: 'Designer', status: 'Away' },
  { id: 3, name: 'Carol White', email: 'carol@acme.com', role: 'PM', status: 'Active' },
  { id: 4, name: 'David Brown', email: 'david@acme.com', role: 'Engineer', status: 'Offline' },
];
</script>

<style scoped>
.user-cell {
  display: flex;
  align-items: center;
  gap: var(--pdx-space-xs);
}

  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  section { margin-bottom: var(--pdx-space-3xl); }
  .section-heading { margin-bottom: var(--pdx-space-sm); }
  .demo-container {
  padding: var(--pdx-space-md);
  border: 1px solid var(--pdx-color-border);
  border-radius: var(--pdx-radius-md);
  background: var(--pdx-color-bg);
  overflow: hidden;
}
  .source-block {
  margin-top: var(--pdx-space-sm);
}
  .source-block summary {
  cursor: pointer;
  font-size: var(--pdx-text-xs);
  color: var(--pdx-color-muted);
}
  .source-block pre {
  margin-top: var(--pdx-space-xs);
  padding: var(--pdx-space-sm);
  background: var(--pdx-color-inset);
  border-radius: var(--pdx-radius-sm);
  overflow-x: auto;
  font-size: var(--pdx-text-xs);
}
</style>

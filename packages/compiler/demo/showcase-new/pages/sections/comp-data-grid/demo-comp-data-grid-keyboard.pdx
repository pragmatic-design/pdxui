<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Keyboard</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Every grid is one tab stop: <kbd>Tab</kbd> enters on the cell it left, header included. A cell
      with one control — a sort button, a row checkbox, a group or detail toggle — hands the stop to
      that control.
    </p>
    <div class="options-table">
      <table>
        <thead><tr><th>Key</th><th>Action</th></tr></thead>
        <tbody>
          <tr><td><kbd>←</kbd> <kbd>→</kbd> <kbd>↑</kbd> <kbd>↓</kbd></td><td>Move one cell</td></tr>
          <tr><td><kbd>Home</kbd> / <kbd>End</kbd></td><td>First / last cell of the row</td></tr>
          <tr><td><kbd>Ctrl</kbd>+<kbd>Home</kbd> / <kbd>Ctrl</kbd>+<kbd>End</kbd></td><td>First / last cell of the grid</td></tr>
          <tr><td><kbd>PageUp</kbd> / <kbd>PageDown</kbd></td><td>Ten rows up / down</td></tr>
          <tr><td><kbd>Enter</kbd> / <kbd>Space</kbd></td><td>On a header: sort. On a checkbox or toggle: operate it</td></tr>
          <tr><td><kbd>Enter</kbd> / <kbd>F2</kbd></td><td>Edit the cell (editable grids)</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</template>

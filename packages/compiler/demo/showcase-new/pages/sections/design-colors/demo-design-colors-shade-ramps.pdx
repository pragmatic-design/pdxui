    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>/* OKLCH shade ramp: vary Lightness, keep Chroma + Hue constant */
--pdx-primary-50:  oklch(0.97 0.03 var(--pdx-hue-primary));  /* lightest */
--pdx-primary-100: oklch(0.93 0.06 var(--pdx-hue-primary));
--pdx-primary-200: oklch(0.86 0.10 var(--pdx-hue-primary));
  ...
--pdx-primary-500: oklch(0.55 0.18 var(--pdx-hue-primary));
  ...
--pdx-primary-900: oklch(0.22 0.10 var(--pdx-hue-primary));  /* darkest */

/* Use ramp tokens for tinted backgrounds, subtle borders, etc. */
.alert-danger {
  background: var(--pdx-danger-50);
  border-left: 3px solid var(--pdx-danger-500);
  color: var(--pdx-danger-800);
}</code></pre>

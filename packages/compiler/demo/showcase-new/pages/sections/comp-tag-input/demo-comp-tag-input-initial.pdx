<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">With Initial Values</h2>
    <p class="pdx-txt-small pdx-ink-muted">Pre-populated tags via the <code>:value</code> binding (array of strings).</p>

    <div class="demo-stack">
      <pdx-tag-input :value="initialTags" @pdx-change="onPrefilledChange"></pdx-tag-input>
    </div>
    <p class="pdx-txt-small pdx-ink-muted" style="margin-top:var(--pdx-space-sm)">
      Current tags: <strong>{{ prefilledTagsStr() }}</strong>
    </p>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-tag-input :value="['JavaScript', 'TypeScript', 'Rust']" @pdx-change="onChange" /&gt;</code></pre>
    </details>
  </section>
</template>

<script setup>
import { useTagInputLog } from './state.pdx';

// The page's event console (state.pdx.ts).
const tagInputLog = useTagInputLog();
function addLog(text) { tagInputLog.addLog(text); }

// Prefilled
let initialTags = $signal(['JavaScript', 'TypeScript', 'Rust']);

let prefilledTags = $signal(['JavaScript', 'TypeScript', 'Rust']);

function onPrefilledChange(e) {
    const tags = e.detail ? e.detail.tags : [];
    prefilledTags = tags;
    addLog('prefilled change: [' + tags.join(', ') + ']');
}

function prefilledTagsStr() {
    return prefilledTags.length > 0 ? prefilledTags.join(', ') : 'none';
}
</script>

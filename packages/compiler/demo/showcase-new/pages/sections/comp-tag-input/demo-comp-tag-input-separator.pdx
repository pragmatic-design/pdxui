<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Custom Separator</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Use <code>separator=";"</code> to split tags by semicolon instead of comma.
      Type values separated by <kbd>;</kbd> to add multiple tags at once.
    </p>

    <div class="demo-stack">
      <pdx-tag-input separator=";" placeholder="Use ; to separate..." @pdx-change="onSepChange"></pdx-tag-input>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-tag-input separator=";" placeholder="Use ; to separate..." /&gt;</code></pre>
    </details>
  </section>
</template>

<script>
import { useTagInputLog } from './state.pdx';

// The page's event console (state.pdx.ts).
const tagInputLog = useTagInputLog();
function addLog(text) { tagInputLog.addLog(text); }

// Custom Separator
function onSepChange(e) {
    const tags = e.detail ? e.detail.tags : [];
    addLog('separator change: [' + tags.join('; ') + ']');
}
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  kbd { font-family: var(--pdx-font-mono); font-size: 0.8em; padding: 2px 6px; background: var(--pdx-color-inset); border: 1px solid var(--pdx-color-border); border-radius: var(--pdx-radius-sm); color: var(--pdx-color-text); }
</style>

        <p class="pdx-txt-small pdx-ink-muted">Dashboard content with bordered container.</p>
      </div>
      <div data-tab-panel="tab2">
        <p class="pdx-txt-small pdx-ink-muted">Analytics content.</p>
      </div>
      <div data-tab-panel="tab3">
        <p class="pdx-txt-small pdx-ink-muted">Reports content.</p>
      </div>
    </pdx-tabs>


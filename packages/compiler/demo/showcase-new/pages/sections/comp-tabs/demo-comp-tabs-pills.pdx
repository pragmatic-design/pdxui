        <p class="pdx-txt-small pdx-ink-muted">Showing all 42 items.</p>
      </div>
      <div data-tab-panel="active" style="padding:var(--pdx-space-lg)">
        <p class="pdx-txt-small pdx-ink-muted">Showing 28 active items.</p>
      </div>
      <div data-tab-panel="completed" style="padding:var(--pdx-space-lg)">
        <p class="pdx-txt-small pdx-ink-muted">Showing 11 completed items.</p>
      </div>
      <div data-tab-panel="archived" style="padding:var(--pdx-space-lg)">
        <p class="pdx-txt-small pdx-ink-muted">Showing 3 archived items.</p>
      </div>
    </pdx-tabs>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-tabs value="all" variant="pills"&gt;
  &lt;div class="pdx-tabs" role="tablist"&gt;

<template>
  <section>
    <h3>Portal</h3>
    <p class="desc">Render content into document.body. Click to create/remove.</p>
    <div class="row">
      <button class="pdx-primary" @click="showPortal">Create Portal</button>
      <button class="pdx-danger" @click="hidePortal">Remove Portal</button>
    </div>
  </section>
</template>

<script>
import { createPortal } from '@pdxui/core';

// ── Portal ──
let portalDispose = null;
function showPortal() {
    portalDispose?.();
    const content = document.createElement('div');
    content.style.cssText = 'position:fixed;bottom:16px;right:16px;padding:16px;background:white;border-radius:12px;box-shadow:0 4px 24px rgba(0,0,0,0.15);z-index:9999;font-family:system-ui';
    content.innerHTML = '<strong>Portaled!</strong><br><small>I live in document.body</small>';
    const result = createPortal(content);
    portalDispose = result.dispose;
}
function hidePortal() { portalDispose?.(); portalDispose = null; }
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }
  .desc { color: var(--pdx-color-muted); font-size: 0.85rem; margin: 0; }
  section { padding: 16px; border: 1px solid var(--pdx-color-border); border-radius: 8px; background: var(--pdx-color-surface); }
  .row { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }
</style>

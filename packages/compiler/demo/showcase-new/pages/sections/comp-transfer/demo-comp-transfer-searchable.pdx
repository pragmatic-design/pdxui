<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Searchable</h2>
    <p class="pdx-txt-small pdx-ink-muted">Filter items by typing in the search box.</p>

    <div class="demo-row">
      <pdx-transfer
        searchable
        :items="manyItems"
        :value="['item-3', 'item-7', 'item-11']"
        sourcetitle="Available"
        targettitle="Selected"
      ></pdx-transfer>
    </div>
  </section>
</template>

<script setup>
const manyItems = Array.from({ length: 20 }, (_, i) => ({
  value: `item-${i + 1}`,
  label: `Item ${i + 1}`,
}));
</script>

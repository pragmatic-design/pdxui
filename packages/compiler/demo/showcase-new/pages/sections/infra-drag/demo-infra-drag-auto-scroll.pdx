<template>
  <section>
    <h3>Auto-Scroll</h3>
    <p class="desc">Drag the item to the top or bottom edge of the scrollable list. The list auto-scrolls.</p>
    <div class="scroll-list" :ref="scrollRef">
      <div class="scroll-item drag-handle" :ref="scrollItemRef">Drag me ↕</div>
      <div class="scroll-item">Item 2</div>
      <div class="scroll-item">Item 3</div>
      <div class="scroll-item">Item 4</div>
      <div class="scroll-item">Item 5</div>
      <div class="scroll-item">Item 6</div>
      <div class="scroll-item">Item 7</div>
      <div class="scroll-item">Item 8</div>
      <div class="scroll-item">Item 9</div>
      <div class="scroll-item">Item 10</div>
      <div class="scroll-item">Item 11</div>
      <div class="scroll-item">Item 12</div>
    </div>
  </section>
</template>

<script setup>
import { useDrag, effect, onMount, onDestroy } from '@pdxui/core';

let scrollRef = $signal(null);
let scrollItemRef = $signal(null);

const scrollDrag = useDrag(() => scrollItemRef);

onMount(() => {
    // Auto-scroll drag visual
    const d11 = effect(() => {
        const pos = scrollDrag.position();
        const el = scrollItemRef;
        if (el) el.style.transform = 'translateY(' + pos.y + 'px)';
    });

    onDestroy(() => {
        d11();
        scrollDrag.dispose();
    });
});
</script>

<style scoped>
  .scroll-list { max-height: 200px; overflow-y: auto; border: 2px dashed var(--pdx-color-border); border-radius: 8px; padding: 4px; margin-top: 8px; }
  .scroll-item { padding: 10px 14px; background: var(--pdx-color-inset); border: 1px solid var(--pdx-color-border); border-radius: 6px; margin: 4px 0; font-size: 0.85rem; }
  .scroll-item.drag-handle { background: var(--pdx-color-primary); color: var(--pdx-color-primary-text); cursor: grab; touch-action: none; user-select: none; font-weight: 600; }
</style>

      <pdx-chip variant="tonal-danger">Danger</pdx-chip>
      <pdx-chip variant="tonal-warning">Warning</pdx-chip>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-chip variant="tonal-primary"&gt;Primary&lt;/pdx-chip&gt;
&lt;pdx-chip variant="tonal-danger"&gt;Danger&lt;/pdx-chip&gt;</code></pre>
    </details>
  </section>

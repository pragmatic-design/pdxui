<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Tonal / Subtle Variants</h2>
    <p class="pdx-txt-small pdx-ink-muted">Muted background, no border. Use <code>variant="tonal-primary"</code> etc.</p>

    <div class="demo-row">
      <pdx-chip variant="tonal">Default</pdx-chip>
      <pdx-chip variant="tonal-primary">Primary</pdx-chip>

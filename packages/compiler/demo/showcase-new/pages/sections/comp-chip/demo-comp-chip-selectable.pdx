<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Selectable (Toggle)</h2>
    <p class="pdx-txt-small pdx-ink-muted"><code>selectable</code> makes the chip a toggle button (<code>role="button"</code> + <code>aria-pressed</code>): click, Enter or Space. Plain chips are not tab stops.</p>

    <div class="demo-row">
      @for (interests as item; track item.label) {
        <pdx-chip selectable variant="primary" :selected="item.selected" :value="item.label" @selected-change="e => toggleInterest(e.currentTarget.value, e.detail.value)">{{ item.label }}</pdx-chip>
      }
    </div>
    <p class="pdx-txt-small pdx-ink-muted" style="margin-top:var(--pdx-space-xs)">
      Selected: {{ selectedStr() }}
    </p>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-chip selectable variant="primary" value="Music" ::selected="music"&gt;
  Music
&lt;/pdx-chip&gt;
// selected is a model: a click writes it and announces selected-change { value }</code></pre>
    </details>
  </section>
</template>

<script>
import { useChipConsole } from './state.pdx';

const chipConsole = useChipConsole();
function addLog(text) { chipConsole.addLog(text); }

// Selectable
let interests = $signal([
    { label: 'Music', selected: true },
    { label: 'Sports', selected: false },
    { label: 'Travel', selected: true },
    { label: 'Food', selected: false },
    { label: 'Tech', selected: true },
    { label: 'Art', selected: false },
]);

// A click writes the chip's `selected` model; `selected-change` carries the new value.
function toggleInterest(val, on) {
    if (val) {
        interests = interests.map(i => i.label === val ? { label: i.label, selected: on } : i);
        addLog('toggle: ' + val + ' → ' + (on ? 'on' : 'off'));
    }
}

function selectedStr() {
    const sel = interests.filter(i => i.selected).map(i => i.label);
    return sel.length > 0 ? sel.join(', ') : 'none';
}
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .demo-row { gap: var(--pdx-space-sm); }
</style>

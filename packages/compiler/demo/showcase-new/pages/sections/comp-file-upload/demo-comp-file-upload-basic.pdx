<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">Drop files or click the zone to browse. Selected file names shown below.</p>

    <div class="demo-stack">
      <pdx-file-upload @pdx-select="onSelect"></pdx-file-upload>
      <div class="result-box">
        <span class="pdx-txt-small pdx-ink-muted">Selected: </span>
        <span class="pdx-txt-small">{{ selectedFiles }}</span>
      </div>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-file-upload @pdx-select="onSelect" /&gt;

function onSelect(e) {
  const names = e.detail.files.map(f => f.name);
  selectedFiles = names.join(', ') || 'None';
}</code></pre>
    </details>
  </section>
</template>

<script setup>
let selectedFiles = $signal('None');

function onSelect(e) {
  const names = e.detail.files.map(f => f.name);
  selectedFiles = names.join(', ') || 'None';
}
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .result-box {
    padding: var(--pdx-space-sm) var(--pdx-space-md);
    background: var(--pdx-color-inset);
    border-radius: var(--pdx-radius-md);
    border: 1px solid var(--pdx-color-border);
  }
  .opt-row-2 span { color: var(--pdx-color-muted); }
</style>

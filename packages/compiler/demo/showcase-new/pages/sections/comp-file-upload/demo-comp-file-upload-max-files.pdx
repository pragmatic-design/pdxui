      <pdx-file-upload multiple :max-files="3"></pdx-file-upload>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-file-upload multiple :max-files="3" /&gt;</code></pre>
    </details>
  </section>
</template>

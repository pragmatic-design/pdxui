<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Variants</h2>
    <p class="pdx-txt-small pdx-ink-muted">Semantic colors via <code>variant</code> attribute on the bar.</p>

    <div class="demo-stack">
      <div class="progress-label">
        <span class="pdx-txt-small pdx-ink-muted">Default (primary)</span>
      </div>
      <div class="pdx-progress">
        <div class="pdx-progress-bar" style="width: 60%"></div>

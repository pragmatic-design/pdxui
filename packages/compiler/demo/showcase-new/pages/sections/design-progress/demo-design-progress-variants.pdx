&lt;div class="pdx-progress"&gt;
  &lt;div class="pdx-progress-bar" variant="warning" style="width: 45%"&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;div class="pdx-progress"&gt;
  &lt;div class="pdx-progress-bar" variant="danger" style="width: 90%"&gt;&lt;/div&gt;

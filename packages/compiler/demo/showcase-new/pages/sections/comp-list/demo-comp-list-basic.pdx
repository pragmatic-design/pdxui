<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic (Static Array)</h2>
    <p class="pdx-txt-small pdx-ink-muted">Simple list from a static items array, each item drawn by the <code>item</code> snippet.</p>
    <div class="demo-container">
      <pdx-list :items="basicItems" clickable dividers @pdx-click="onItemClick">
        @snippet item(item) {
          <div class="basic-row"><strong>{{ item.name }}</strong><span class="basic-role">{{ item.role }}</span></div>
        }
      </pdx-list>
    </div>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="list-log">{{ listLog }}</div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-list :items="users" clickable dividers @pdx-click="onUserClick"&gt;
  &#64;snippet item(item) &#123;
    &lt;strong&gt;&#123;&#123; item.name &#125;&#125;&lt;/strong&gt; &#123;&#123; item.role &#125;&#125;
  &#125;
&lt;/pdx-list&gt;</code></pre>
    </details>
  </section>
</template>

<script>
const basicItems = [
  { id: 1, name: 'Alice Johnson', role: 'Frontend Developer' },
  { id: 2, name: 'Bob Smith', role: 'Backend Developer' },
  { id: 3, name: 'Carol White', role: 'Designer' },
  { id: 4, name: 'David Brown', role: 'Product Manager' },
  { id: 5, name: 'Eve Davis', role: 'DevOps Engineer' },
];

function onItemClick(evt) {
  listLog = 'Clicked: ' + evt.detail.item.name + ' (id: ' + evt.detail.id + ')';
}

let listLog = $signal('Click an item...');
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .demo-container { max-width: 600px; }
  .basic-row { display: flex; align-items: center; gap: var(--pdx-space-sm); padding: var(--pdx-space-sm) var(--pdx-space-md); width: 100%; }
  .basic-role { color: var(--pdx-color-muted); margin-left: auto; font-size: var(--pdx-text-xs); }
  .event-log { margin-top: var(--pdx-space-sm); padding: var(--pdx-space-xs) var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-sm); max-width: 600px; }
</style>

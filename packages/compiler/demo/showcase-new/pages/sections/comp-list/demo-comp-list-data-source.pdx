<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">With DataSource + Loading</h2>
    <p class="pdx-txt-small pdx-ink-muted">Simulates a 1.5s fetch. Shows loading overlay, then data.</p>
    <div class="demo-container">
      <pdx-list :source="fakeDS" clickable dividers id="ds-list">
        <slot name="item" let:item>
          <div class="ds-row">
            <pdx-icon name="user" size="16"></pdx-icon>
            <span>{{ item.name }}</span>
            <span class="ds-email">{{ item.email }}</span>
            <span class="ds-role">{{ item.role }}</span>
          </div>
        </slot>
      </pdx-list>
    </div>
    <button class="pdx-btn pdx-outline pdx-btn-xs" style="margin-top: var(--pdx-space-sm)" @click="reloadDS">Reload</button>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>const ds = createDataSource({
  transport: {
    read: () =&gt; fetch('/api/users').then(r =&gt; r.json()),
  },
  autoLoad: true,
});

&lt;pdx-list :source="ds" clickable dividers&gt;
  &lt;slot name="item" let:item&gt;
    &lt;span&gt;{{ item.name }}&lt;/span&gt; &lt;span class="role"&gt;{{ item.role }}&lt;/span&gt;
  &lt;/slot&gt;
&lt;/pdx-list&gt;</code></pre>
    </details>
  </section>
</template>

<script>
import { createDataSource, type DataResponse } from '@pdxui/core';

// Fake DataSource that simulates 1.5s fetch
const fakeUsers = [
  { id: 1, name: 'John Doe', email: 'john@example.com', role: 'Admin' },
  { id: 2, name: 'Jane Smith', email: 'jane@example.com', role: 'Editor' },
  { id: 3, name: 'Mike Wilson', email: 'mike@example.com', role: 'Viewer' },
  { id: 4, name: 'Sara Lee', email: 'sara@example.com', role: 'Editor' },
  { id: 5, name: 'Tom Clark', email: 'tom@example.com', role: 'Admin' },
];

const fakeDS = createDataSource<(typeof fakeUsers)[number]>({
  transport: {
    read: () => new Promise<DataResponse<(typeof fakeUsers)[number]>>(function(resolve) {
      setTimeout(function() {
        resolve({ data: fakeUsers, total: fakeUsers.length });
      }, 1500);
    }),
  },
  pageSize: 0,
  autoLoad: true,
});

function reloadDS() {
  fakeDS.refresh();
}
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .demo-container { max-width: 600px; }
  .ds-row { display: flex; align-items: center; gap: var(--pdx-space-sm); padding: var(--pdx-space-sm) var(--pdx-space-md); width: 100%; }
  .ds-email { color: var(--pdx-color-muted); font-size: var(--pdx-text-xs); }
  .ds-role { margin-left: auto; font-size: var(--pdx-text-xs); padding: 2px 8px; border-radius: 9999px; background: var(--pdx-color-inset); }
</style>

<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">DataSource + Pagination</h2>
    <p class="pdx-txt-small pdx-ink-muted">List and Pagination share the same DataSource. Page change reloads the list with loading overlay.</p>
    <div class="demo-container">
      <pdx-list :source="pagedDS" dividers bordered id="paged-list">
        @snippet item(item) {
          <div class="paged-row">
            <span class="paged-id">#{{ item.id }}</span>
            <strong>{{ item.name }}</strong>
            <span class="paged-email">{{ item.email }}</span>
            <span class="paged-dept">{{ item.dept }}</span>
          </div>
        }
      </pdx-list>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;max-width:600px;margin-top:var(--pdx-space-sm)">
      <span class="pdx-txt-small pdx-ink-muted" id="paged-info">{{ pagedInfo }}</span>
      <pdx-pagination :total="pagedTotal" :pageSize="5" :page="pagedPage" @page-change="onPageChange" id="paged-pagination"></pdx-pagination>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>const ds = createDataSource({
  transport: fakePagedTransport,
  pageSize: 5,
  autoLoad: true,
});

&lt;pdx-list :source="ds"&gt;
  &#64;snippet item(item) &#123; &lt;strong&gt;&#123;&#123; item.name &#125;&#125;&lt;/strong&gt; &#125;
&lt;/pdx-list&gt;
&lt;pdx-pagination :total="ds.total()" :pageSize="5"
  :page="ds.page()" @page-change="onPage"&gt;
&lt;/pdx-pagination&gt;</code></pre>
    </details>
  </section>
</template>

<script>
import { createDataSource, type DataRequest, type DataResponse } from '@pdxui/core';

// Paged DataSource — 23 items, 5 per page, simulates server paging
type User = { id: number; name: string; email: string; dept: string };
const allUsers: User[] = [];
for (let _userIdx = 1; _userIdx <= 23; _userIdx++) {
  allUsers.push({ id: _userIdx, name: 'User ' + _userIdx, email: 'user' + _userIdx + '@example.com', dept: _userIdx % 3 === 0 ? 'Engineering' : _userIdx % 3 === 1 ? 'Design' : 'Marketing' });
}

function _fakePagedRead(params: DataRequest) {
  return new Promise<DataResponse<User>>(function(resolve) {
    const _off = ((params.page || 1) - 1) * (params.pageSize || 5);
    const _result = allUsers.slice(_off, _off + (params.pageSize || 5));
    setTimeout(function() { resolve({ data: _result, total: allUsers.length }); }, 800);
  });
}

const pagedDS = createDataSource<User>({
  transport: { read: _fakePagedRead },
  pageSize: 5,
  autoLoad: true,
});

let pagedTotal = $signal(23);
let pagedPage = $signal(1);

// Update info text when data loads
$effect(() => {
  const loading = pagedDS.isLoading();
  const total = pagedDS.total();
  const pageNum = pagedDS.page();
  const dataLen = pagedDS.data().length;
  pagedTotal = total;
  pagedPage = pageNum;
});

const pagedInfo = $derived(pagedDS.isLoading()
  ? 'Loading...'
  : 'Showing ' + pagedDS.data().length + ' of ' + pagedDS.total() + ' items (page ' + pagedDS.page() + ')');

function onPageChange(evt) {
  pagedDS.setPage(evt.detail.value);
}
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .page { }
  .demo-container { max-width: 600px; }
  .paged-row { display: flex; align-items: center; gap: var(--pdx-space-sm); padding: var(--pdx-space-sm) var(--pdx-space-md); width: 100%; }
  .paged-id { min-width: 28px; color: var(--pdx-color-muted); font-size: var(--pdx-text-xs); }
  .paged-email { color: var(--pdx-color-muted); font-size: var(--pdx-text-xs); }
  .paged-dept { margin-left: auto; font-size: var(--pdx-text-xs); padding: 2px 8px; border-radius: 9999px; background: var(--pdx-color-inset); }
</style>

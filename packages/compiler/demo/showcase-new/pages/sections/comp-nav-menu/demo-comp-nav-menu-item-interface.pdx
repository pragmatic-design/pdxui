<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">NavMenuItem Interface</h2>
    <div class="options-table">
      <table>
        <thead><tr><th>Field</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td><code>key</code></td><td>string</td><td>Unique identifier</td></tr>
          <tr><td><code>label</code></td><td>string</td><td>Display text</td></tr>
          <tr><td><code>icon</code></td><td>string</td><td>Icon name (from Pragmatic set) or raw HTML starting with &lt;</td></tr>
          <tr><td><code>badge</code></td><td>string</td><td>Badge text (count, status)</td></tr>
          <tr><td><code>badgeVariant</code></td><td>'default' | 'primary' | 'danger' | 'success'</td><td>Badge color</td></tr>
          <tr><td><code>children</code></td><td>NavMenuItem[]</td><td>Nested items (creates collapsible group)</td></tr>
          <tr><td><code>type</code></td><td>'item' | 'header' | 'separator'</td><td>Item type</td></tr>
          <tr><td><code>href</code></td><td>string</td><td>Link URL</td></tr>
          <tr><td><code>disabled</code></td><td>boolean</td><td>Disabled state</td></tr>
          <tr><td><code>expanded</code></td><td>boolean</td><td>Initially expanded (groups)</td></tr>
          <tr><td><code>collapsed</code></td><td>boolean</td><td>A <code>header</code> with children folds its group; this starts it folded</td></tr>
          <tr><td><code>data</code></td><td>Record&lt;string, string&gt;</td><td><code>data-*</code> attributes on the entry, e.g. <code>{ test: 'to-inbox' }</code>; only a valid data name is written</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</template>

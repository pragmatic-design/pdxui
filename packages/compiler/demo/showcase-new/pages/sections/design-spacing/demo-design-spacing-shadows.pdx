    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>--pdx-shadow-color: light-dark(oklch(0 0 0 / 0.08), oklch(0 0 0 / 0.4));
--pdx-shadow-sm:  0 1px 2px var(--pdx-shadow-color);
--pdx-shadow-md:  0 4px 6px -1px ...;
--pdx-shadow-lg:  0 10px 15px -3px ...;
--pdx-shadow-xl:  0 20px 25px -5px ...;

/* Utility classes: */
.pdx-elevation-0  /* none */
.pdx-elevation-1  /* sm */
.pdx-elevation-2  /* md */
.pdx-elevation-3  /* lg */
.pdx-elevation-4  /* xl */</code></pre>

--pdx-space-md:  calc(1rem    * var(--pdx-density-factor));
--pdx-space-lg:  calc(1.5rem  * var(--pdx-density-factor));
--pdx-space-xl:  calc(2.5rem  * var(--pdx-density-factor));
--pdx-space-2xl: calc(4rem    * var(--pdx-density-factor));


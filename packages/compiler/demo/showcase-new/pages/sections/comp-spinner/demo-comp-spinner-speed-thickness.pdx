<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Custom Speed & Thickness</h2>
    <p class="pdx-txt-small pdx-ink-muted">CSS variables: <code>--pdx-spinner-speed</code> and <code>--pdx-spinner-thickness</code>.</p>
    <div class="demo-row">
      <div class="demo-item">
        <span style="--pdx-spinner-speed:0.5s"><pdx-spinner size="lg"></pdx-spinner></span>
        <span class="pdx-txt-caption pdx-ink-muted">Fast (0.5s)</span>
      </div>
      <div class="demo-item">
        <pdx-spinner size="lg"></pdx-spinner>
        <span class="pdx-txt-caption pdx-ink-muted">Default (1s)</span>
      </div>
      <div class="demo-item">
        <span style="--pdx-spinner-speed:2s"><pdx-spinner size="lg"></pdx-spinner></span>
        <span class="pdx-txt-caption pdx-ink-muted">Slow (2s)</span>
      </div>
      <div class="demo-item">
        <span style="--pdx-spinner-thickness:1"><pdx-spinner size="lg"></pdx-spinner></span>
        <span class="pdx-txt-caption pdx-ink-muted">Thin (1)</span>
      </div>
      <div class="demo-item">
        <span style="--pdx-spinner-thickness:5"><pdx-spinner size="lg"></pdx-spinner></span>
        <span class="pdx-txt-caption pdx-ink-muted">Thick (5)</span>
      </div>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;span style="--pdx-spinner-speed: 0.5s"&gt;
  &lt;pdx-spinner size="lg"&gt;&lt;/pdx-spinner&gt;
&lt;/span&gt;
&lt;span style="--pdx-spinner-thickness: 5"&gt;
  &lt;pdx-spinner size="lg"&gt;&lt;/pdx-spinner&gt;
&lt;/span&gt;</code></pre>
    </details>
  </section>
</template>

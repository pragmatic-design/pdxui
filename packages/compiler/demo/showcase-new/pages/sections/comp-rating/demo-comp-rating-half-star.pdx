<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Half-Star Precision</h2>
    <p class="pdx-txt-small pdx-ink-muted">precision=0.5 enables half-star selection.</p>

    <div class="demo-row">
      <pdx-rating :value="rating2" precision="0.5" @value-change="onRating2"></pdx-rating>
    </div>
  </section>
</template>

<script>
let rating2 = $signal(2.5);

function onRating2(e) {
  rating2 = e.detail.value;
}
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .demo-stack > div { display: flex; align-items: center; gap: var(--pdx-space-sm); }
</style>

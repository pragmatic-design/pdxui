<template>
  <section>
    <h2 class="pdx-txt-heading">Programmatic Alert</h2>
    <p class="pdx-txt-small pdx-ink-muted">Single OK button. Resolves when dismissed.</p>
    <div class="demo-row">
      <pdx-button variant="outline" size="sm" @click="onAlert">dialog.alert()</pdx-button>
    </div>
  </section>
</template>

<script setup>
import { dialog } from '@pdxui/ui/dialog';

async function onAlert() {
    await dialog.alert({ title: 'Saved', message: 'Your changes have been saved successfully.' });
}
</script>

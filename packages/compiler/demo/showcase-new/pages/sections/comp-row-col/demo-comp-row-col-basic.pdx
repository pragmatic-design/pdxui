        <pdx-col span="4"><div class="box">4</div></pdx-col>
        <pdx-col span="4"><div class="box">4</div></pdx-col>
      </pdx-row>
    </div>

    <div class="demo-area">
      <pdx-row gutter="sm">
        <pdx-col span="3"><div class="box">3</div></pdx-col>
        <pdx-col span="6"><div class="box">6</div></pdx-col>
        <pdx-col span="3"><div class="box">3</div></pdx-col>
      </pdx-row>

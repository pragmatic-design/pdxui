    <div class="demo-area">
      <pdx-row gutter="sm">
        <pdx-col span="6"><div class="box">span 6</div></pdx-col>
        <pdx-col span="6"><div class="box">span 6</div></pdx-col>
      </pdx-row>
    </div>

    <div class="demo-area">

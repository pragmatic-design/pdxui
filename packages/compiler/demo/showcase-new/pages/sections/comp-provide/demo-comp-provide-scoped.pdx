<template>
  <section>
    <h2 class="pdx-txt-heading">Scoped Override</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Nested providers of one token shadow outer ones. The nearest ancestor wins — like CSS cascading.
    </p>
    <div class="demo-box">
      <pdx-provide :token="Color" :value="'blue'">
        <div class="demo-child">
          Outer color: <strong style="color: blue">blue</strong>
        </div>
        <pdx-provide :token="Color" :value="'red'">
          <div class="demo-child">
            Inner override: <strong style="color: red">red</strong>
          </div>
        </pdx-provide>
        <div class="demo-child">
          Back to outer: <strong style="color: blue">blue</strong>
        </div>
      </pdx-provide>
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>&lt;pdx-provide :token="Color" :value="'blue'"&gt;
  &lt;!-- inject(Color, el) → 'blue' --&gt;
  &lt;pdx-provide :token="Color" :value="'red'"&gt;
    &lt;!-- inject(Color, el) → 'red' (nearest wins) --&gt;
  &lt;/pdx-provide&gt;
  &lt;!-- inject(Color, el) → 'blue' again --&gt;
&lt;/pdx-provide&gt;</code></pre></details>}
  </section>
</template>

<script>
import '@pdxui/ui/provide';
import { context } from '@pdxui/core';

const Color = context<string>('color');
</script>

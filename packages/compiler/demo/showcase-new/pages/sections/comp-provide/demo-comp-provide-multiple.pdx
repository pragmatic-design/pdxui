<template>
  <section>
    <h2 class="pdx-txt-heading">Multiple Values</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Pass an object to <code>:values</code> to provide multiple keys at once.
    </p>
    <div class="demo-box">
      <pdx-provide :values="multiValues">
        <div class="demo-child">
          theme: <strong>{{ multiValues.theme }}</strong>,
          locale: <strong>{{ multiValues.locale }}</strong>,
          debug: <strong>{{ String(multiValues.debug) }}</strong>
        </div>
      </pdx-provide>
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>&lt;pdx-provide :values="appConfig"&gt;
  &lt;!-- inject('theme'), inject('locale'), inject('debug') --&gt;
  &lt;pdx-dashboard /&gt;
&lt;/pdx-provide&gt;

const appConfig = {
  theme: 'dark',
  locale: 'en',
  debug: false,
};</code></pre></details>}
  </section>
</template>

<script setup>
import '@pdxui/ui/provide';

const multiValues = { theme: 'dark', locale: 'en', debug: false };
</script>

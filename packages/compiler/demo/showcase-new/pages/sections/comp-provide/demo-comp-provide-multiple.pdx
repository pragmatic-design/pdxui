<template>
  <section>
    <h2 class="pdx-txt-heading">Multiple Values</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Pass a <code>Map</code> of token to value to <code>:values</code> to provide several at once.
    </p>
    <div class="demo-box">
      <pdx-provide :values="multiValues">
        <div class="demo-child">
          theme: <strong>{{ config.theme }}</strong>,
          locale: <strong>{{ config.locale }}</strong>,
          debug: <strong>{{ String(config.debug) }}</strong>
        </div>
      </pdx-provide>
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>&lt;pdx-provide :values="appConfig"&gt;
  &lt;!-- inject(Theme, el), inject(Locale, el), inject(Debug, el) --&gt;
  &lt;app-dashboard /&gt;
&lt;/pdx-provide&gt;

const appConfig = new Map([
  [Theme, 'dark'],
  [Locale, 'en'],
  [Debug, false],
]);</code></pre></details>}
  </section>
</template>

<script>
import '@pdxui/ui/provide';
import { context } from '@pdxui/core';

const Theme = context<string>('theme');
const Locale = context<string>('locale');
const Debug = context<boolean>('debug');
const config = { theme: 'dark', locale: 'en', debug: false };
const multiValues = new Map<unknown, unknown>([[Theme, config.theme], [Locale, config.locale], [Debug, config.debug]]);
</script>

<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Stepper — Horizontal</h2>
    <p class="pdx-txt-small pdx-ink-muted">Multi-step wizard with done, active, and pending states via <code>data-status</code>.</p>

    <div class="pdx-stepper">
      <div class="pdx-step" data-status="done">
        <span class="pdx-step-number">&#10003;</span>
        <span class="pdx-step-label">Account</span>
      </div>
      <div class="pdx-step-connector" data-status="done"></div>
      <div class="pdx-step" data-status="done">
        <span class="pdx-step-number">&#10003;</span>
        <span class="pdx-step-label">Profile</span>
      </div>
      <div class="pdx-step-connector" data-status="active"></div>
      <div class="pdx-step" data-status="active">
        <span class="pdx-step-number">3</span>
        <span class="pdx-step-label">Payment</span>
      </div>
      <div class="pdx-step-connector" data-status="pending"></div>
      <div class="pdx-step" data-status="pending">
        <span class="pdx-step-number">4</span>
        <span class="pdx-step-label">Review</span>
      </div>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;div class="pdx-stepper"&gt;
  &lt;div class="pdx-step" data-status="done"&gt;
    &lt;span class="pdx-step-number"&gt;&amp;#10003;&lt;/span&gt;
    &lt;span class="pdx-step-label"&gt;Account&lt;/span&gt;
  &lt;/div&gt;
  &lt;div class="pdx-step-connector" data-status="done"&gt;&lt;/div&gt;
  &lt;div class="pdx-step" data-status="active"&gt;
    &lt;span class="pdx-step-number"&gt;3&lt;/span&gt;
    &lt;span class="pdx-step-label"&gt;Payment&lt;/span&gt;
  &lt;/div&gt;
  &lt;div class="pdx-step-connector" data-status="pending"&gt;&lt;/div&gt;
  &lt;div class="pdx-step" data-status="pending"&gt;
    &lt;span class="pdx-step-number"&gt;4&lt;/span&gt;
    &lt;span class="pdx-step-label"&gt;Review&lt;/span&gt;
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
    </details>
  </section>
</template>

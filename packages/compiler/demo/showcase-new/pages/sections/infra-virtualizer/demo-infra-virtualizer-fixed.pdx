<template>
  <section>
    <h3>10,000 Fixed Height Items (48px each)</h3>
    <div class="stats">
      <span>Rendered: <strong>{{ rendered1 }}</strong> / 10,000</span>
      <span>Total: <strong>{{ totalH1 }}</strong></span>
    </div>
    <div class="row">
      <button class="pdx-ghost" @click="scrollTop1">Top</button>
      <button class="pdx-ghost" @click="scrollMid1">#5000</button>
      <button class="pdx-ghost" @click="scrollEnd1">End</button>
    </div>
    <div class="scroll-box" :ref="scroll1Ref">
      <div :ref="inner1Ref" style="position:relative"></div>
    </div>
  </section>
</template>

<script setup>
import { createVirtualizer, effect, onMount } from '@pdxui/core';

let rendered1 = $signal(0);
let totalH1 = $signal('0');

let scroll1Ref = $signal(null);
let inner1Ref = $signal(null);

const COUNT1 = 10000;

let v1 = null;

function scrollTop1() { v1?.scrollTo(0); }
function scrollMid1() { v1?.scrollTo(5000, { align: 'center' }); }
function scrollEnd1() { v1?.scrollTo(COUNT1 - 1, { align: 'end' }); }

onMount(() => {
    // Wait a tick for :ref to be set
    requestAnimationFrame(() => {
        const scrollEl1 = scroll1Ref;
        const innerEl1 = inner1Ref;

        if (scrollEl1 && innerEl1) {
            v1 = createVirtualizer({
                count: () => COUNT1,
                estimateSize: () => 48,
                getScrollElement: () => scrollEl1,
                overscan: 5,
            });

            effect(() => {
                const items = v1.items();
                const total = v1.totalSize();
                rendered1 = items.length;
                totalH1 = (total / 1000).toFixed(0) + 'K px';
                innerEl1.style.height = total + 'px';
                let html = '';
                for (const item of items) {
                    html += '<div class="v-item' + (item.index % 2 === 0 ? ' even' : '') + '" style="height:48px;transform:translateY(' + item.offsetStart + 'px)"><span>#' + item.index + '</span><span class="muted">Item ' + (item.index + 1) + ' / 10,000</span></div>';
                }
                innerEl1.innerHTML = html;
            });
        }
    });
});
</script>

<style scoped>
  .row { display: flex; gap: 8px; margin-bottom: 8px; }
</style>

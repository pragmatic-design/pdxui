      </div>
      <div>
        <h3 class="pdx-txt-subheading">Multiple</h3>
        <pdx-tree label="Pick folders" selection-mode="multiple" default-expand-all :nodes="files"></pdx-tree>
      </div>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-tree selection-mode="multiple" :nodes="files"

        }
      </pdx-breadcrumb>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-breadcrumb :items="items"&gt;
  &#64;snippet item(item, _index, isLast) &#123;
    &lt;span class="crumb-custom"&gt;
      &#123;&#123; isLast ? item.label : item.label + ' →' &#125;&#125;
    &lt;/span&gt;
  &#125;
&lt;/pdx-breadcrumb&gt;

.crumb-custom {
  font-weight: 600;
  color: var(--pdx-color-primary);
}</code></pre>
    </details>
  </section>
</template>


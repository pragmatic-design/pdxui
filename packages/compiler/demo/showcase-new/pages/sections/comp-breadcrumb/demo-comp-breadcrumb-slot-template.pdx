    &lt;span class="crumb-custom"&gt;
      $&lbrace;isLast ? item.label : item.label + ' &amp;rarr;'&rbrace;
    &lt;/span&gt;
  &lt;/slot&gt;
&lt;/pdx-breadcrumb&gt;

.crumb-custom {
  font-weight: 600;
  color: var(--pdx-color-primary);
}</code></pre>
    </details>

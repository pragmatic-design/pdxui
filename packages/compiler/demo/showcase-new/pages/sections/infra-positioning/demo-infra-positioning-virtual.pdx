<template>
  <section data-test="pos-virtual">
    <h3>Virtual Element (Cursor)</h3>
    <p class="desc">Move your mouse over the area below.</p>
    <div class="cursor-area" @pointermove="onCursorMove" @pointerleave="onCursorLeave" data-test="cursor-area">
      <span class="hint">Move cursor here</span>
    </div>
  </section>
</template>

<script setup>
import { computeFloatingPosition, offset, shift, onDestroy } from '@pdxui/core';

let cursorFloatEl = null;

function onCursorMove(e) {
    if (!cursorFloatEl) {
        cursorFloatEl = document.createElement('div');
        cursorFloatEl.style.cssText = 'position:fixed;background:#1d1d2e;color:white;padding:4px 10px;border-radius:4px;font-size:0.75rem;z-index:200;pointer-events:none';
        cursorFloatEl.textContent = 'Cursor tooltip';
        document.body.appendChild(cursorFloatEl);
    }
    cursorFloatEl.style.display = 'block';

    const virtual = {
        getBoundingClientRect: function() {
            return { x: e.clientX, y: e.clientY, width: 0, height: 0, top: e.clientY, left: e.clientX, right: e.clientX, bottom: e.clientY, toJSON: function() { return this; } };
        },
    };
    const result = computeFloatingPosition(virtual, cursorFloatEl, {
        placement: 'right-start',
        middleware: [offset(12), shift({ padding: 8 })],
    });
    cursorFloatEl.style.left = result.x + 'px';
    cursorFloatEl.style.top = result.y + 'px';
}

function onCursorLeave() {
    if (cursorFloatEl) cursorFloatEl.style.display = 'none';
}

onDestroy(function() {
    if (cursorFloatEl) cursorFloatEl.remove();
});
</script>

<style scoped>
  .cursor-area { width: 100%; height: 180px; border: 2px dashed var(--pdx-color-border); border-radius: 8px; cursor: crosshair; position: relative; display: flex; align-items: center; justify-content: center; }
  .hint { color: var(--pdx-color-muted); font-size: 0.85rem; }
</style>

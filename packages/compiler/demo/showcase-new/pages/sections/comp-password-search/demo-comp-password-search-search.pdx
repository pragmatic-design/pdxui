<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Search Input</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Search icon prefix, auto-clearable, debounced <code>pdx-search</code> event.
      Press Escape to clear. Enter for immediate search.
    </p>

    <div class="demo-stack">
      <pdx-form-field label="Basic Search">
        <pdx-search-input placeholder="Search users..."></pdx-search-input>
      </pdx-form-field>

      <pdx-form-field label="With Keyboard Shortcut">
        <pdx-search-input placeholder="Search commands..." shortcut="Ctrl+K"></pdx-search-input>
      </pdx-form-field>

      <pdx-form-field label="Loading State">
        <pdx-search-input placeholder="Searching..." loading value="react"></pdx-search-input>
      </pdx-form-field>

      <pdx-form-field label="Custom Debounce (500ms)">
        <pdx-search-input placeholder="Type slowly..." debounce="500"></pdx-search-input>
      </pdx-form-field>
    </div>

    <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Sizes</h3>
    <div class="demo-stack">
      <pdx-search-input size="sm" placeholder="Small search..."></pdx-search-input>
      <pdx-search-input placeholder="Default search..."></pdx-search-input>
      <pdx-search-input size="lg" placeholder="Large search..."></pdx-search-input>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-search-input
  placeholder="Search..."
  debounce="300"
  shortcut="Ctrl+K"
  @pdx-search="onSearch"&gt;
&lt;/pdx-search-input&gt;</code></pre>
    </details>
  </section>
</template>

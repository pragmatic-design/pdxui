<template>
  <section>
    <h2 class="pdx-txt-heading">Disabled &amp; Readonly</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Non-interactive states. <code>disabled</code> greys out the swatch; <code>readonly</code> shows the color but prevents changes.
    </p>
    <div class="demo-box states-row">
      <div class="state-col">
        <p class="pdx-txt-small pdx-ink-muted">disabled</p>
        <pdx-color-picker value="#64748b" disabled />
      </div>
      <div class="state-col">
        <p class="pdx-txt-small pdx-ink-muted">readonly</p>
        <pdx-color-picker value="#8b5cf6" readonly />
      </div>
    </div>
    @raw {<details class="source"><summary>Source</summary><pre><code>&lt;pdx-color-picker value="#64748b" disabled /&gt;
&lt;pdx-color-picker value="#8b5cf6" readonly /&gt;</code></pre></details>}
  </section>
</template>

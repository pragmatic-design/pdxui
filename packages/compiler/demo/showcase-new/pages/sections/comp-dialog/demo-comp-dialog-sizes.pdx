<template>
  <section>
    <h2 class="pdx-txt-heading">Sizes</h2>
    <p class="pdx-txt-small pdx-ink-muted">5 sizes: sm (360px), md (480px, default), lg (640px), xl (800px), full.</p>
    <div class="btn-row">
      <pdx-button variant="outline" size="sm" @click="openSize" data-size="sm">Small</pdx-button>
      <pdx-button variant="outline" size="sm" @click="openSize" data-size="md">Medium</pdx-button>
      <pdx-button variant="outline" size="sm" @click="openSize" data-size="lg">Large</pdx-button>
      <pdx-button variant="outline" size="sm" @click="openSize" data-size="xl">X-Large</pdx-button>
      <pdx-button variant="outline" size="sm" @click="openSize" data-size="full">Full</pdx-button>
    </div>
    <pdx-dialog :open="sizeOpen" :title="sizeTitle" :size="currentSize" @pdx-close="closeSizeDialog">
      <p>This dialog uses the <strong>{{ currentSize }}</strong> size variant.</p>
      <p class="pdx-txt-small pdx-ink-muted" style="margin-top: var(--pdx-space-sm)">
        Resize your browser to see how the dialog adapts responsively.
      </p>
    </pdx-dialog>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-dialog :open="sizeOpen" title="Dialog" size="sm" @pdx-close="close"&gt;
  &lt;p&gt;Content&lt;/p&gt;
&lt;/pdx-dialog&gt;

&lt;!-- size: sm (360px) | md (480px) | lg (640px) | xl (800px) | full --&gt;</code></pre>
    </details>
  </section>
</template>

<script setup>
let sizeOpen = $signal(false);
let currentSize = $signal('md');
const sizeTitle = $derived('Dialog — ' + currentSize);

function openSize(e) {
  currentSize = e.currentTarget.dataset.size || 'md';
  sizeOpen = true;
}

function closeSizeDialog() { sizeOpen = false; }
</script>

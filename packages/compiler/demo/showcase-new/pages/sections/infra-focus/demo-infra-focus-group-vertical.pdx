<template>
  <section data-test="focus-group">
    <h3>Focus Group — Vertical</h3>
    <p class="desc">Click an item first, then use Arrow Up/Down to navigate, Enter/Space to select. Home/End jump to first/last. Disabled items (Cherry) are skipped.</p>
    <div class="group-list" :ref="verticalRef" data-test="group-vertical">
      @for (fruits as fruit; track fruit) {
        <div class="group-item" role="option" :aria-disabled="fruit === 'Cherry' ? 'true' : null">
          {{ fruit }}
        </div>
      }
    </div>
    <div class="log" data-test="group-log">{{ groupLog }}</div>
  </section>
</template>

<script>
import { focusGroup, onMount } from '@pdxui/core';

const fruits = ['Apple', 'Banana', 'Cherry', 'Date', 'Elderberry'];

let groupLog = $signal('');

let verticalRef = $signal(null);

onMount(() => {
    // Focus groups — use ref elements, guaranteed to be in the DOM at onMount
    if (verticalRef) {
        focusGroup(verticalRef, {
            selector: '[role="option"]',
            orientation: 'vertical',
            wrap: true,
            skipDisabled: true,
            onFocus: (el, i) => { groupLog = `Focused: ${el.textContent.trim()} (index ${i})`; },
            onSelect: (el, i) => { groupLog = `Selected: ${el.textContent.trim()} (index ${i})`; },
        });
    }
});
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  h3 { font-size: 1rem; font-weight: 600; margin-bottom: 8px; }
  .desc { color: var(--pdx-color-muted); font-size: 0.875rem; }
  section { padding: 16px; border: 1px solid var(--pdx-color-border); border-radius: 8px; display: flex; flex-direction: column; gap: 8px; }
  .group-list { display: flex; flex-direction: column; gap: 4px; }
  .group-item { padding: 8px 14px; border: 1px solid var(--pdx-color-border); border-radius: 4px; cursor: pointer; font-size: 0.875rem; transition: all 150ms; }
  .group-item:focus { background: var(--pdx-color-primary); color: var(--pdx-color-primary-text); outline: none; border-color: var(--pdx-color-primary); }
  .group-item[aria-disabled="true"] { opacity: 0.4; cursor: not-allowed; }
  .log { font-family: monospace; font-size: 0.75rem; background: var(--pdx-color-inset); padding: 8px; border-radius: 6px; white-space: pre-wrap; min-height: 32px; }
</style>

<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">2. Nested DTO (Field Groups)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>&lt;pdx-field-group name="customer"&gt;</code> scopes child fields to a nested object.
      Field <code>name="email"</code> inside the group becomes <code>form.fields['customer.email']</code>.
    </p>

    <div class="demo-block">
      <pdx-form :form="nestedForm" @pdx-submit="saveNestedForm">
        <pdx-form-field name="orderNumber" label="Order Number" required>
          <pdx-input name="orderNumber" placeholder="ORD-001"></pdx-input>
        </pdx-form-field>

        <pdx-field-group name="customer" label="Customer">
          <pdx-form-field name="name" label="Name" required>
            <pdx-input name="name" placeholder="Jane Doe"></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="email" label="Email" required>
            <pdx-input name="email" type="email" placeholder="jane@test.com"></pdx-input>
          </pdx-form-field>
        </pdx-field-group>

        <pdx-field-group name="shipping" label="Shipping Address">
          <pdx-form-field name="street" label="Street">
            <pdx-input name="street" placeholder="123 Main St"></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="city" label="City">
            <pdx-input name="city" placeholder="New York"></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="zip" label="ZIP">
            <pdx-input name="zip" placeholder="10001"></pdx-input>
          </pdx-form-field>
        </pdx-field-group>

        <pdx-form-actions submitLabel="Save Order" resetLabel="Reset"></pdx-form-actions>
      </pdx-form>

      <div class="form-status">
        <span :class="nestedDirtyClass()" :textContent="nestedDirtyText()"></span>
        <span :class="nestedValidClass()" :textContent="nestedValidText()"></span>
      </div>

      <div class="form-values">
        <strong>getValues():</strong>
        <pre :textContent="nestedValuesJson()"></pre>
      </div>
    </div>

    @raw {<details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>@form nestedForm: {
  orderNumber: string { required },
  customer: {
    name: string { required },
    email: string { required, email }
  },
  shipping: {
    street?: string,
    city?: string,
    zip?: string
  }
}

&lt;pdx-form :form="nestedForm"&gt;
  &lt;pdx-form-field name="orderNumber" label="Order Number" required&gt;
    &lt;pdx-input name="orderNumber" /&gt;
  &lt;/pdx-form-field&gt;

  &lt;pdx-field-group name="customer" label="Customer"&gt;
    &lt;pdx-form-field name="name" label="Name" required&gt;
      &lt;pdx-input name="name" /&gt;
    &lt;/pdx-form-field&gt;
    &lt;!-- compiler resolves to form.fields['customer.name'] --&gt;
  &lt;/pdx-field-group&gt;

  &lt;pdx-field-group name="shipping" label="Shipping"&gt;
    ...
  &lt;/pdx-field-group&gt;
&lt;/pdx-form&gt;</code></pre></details>}
  </section>
</template>

<script setup>
import { createForm, required, email } from '@pdxui/core';

// ─── 2. Nested DTO (Field Groups) ───
const nestedForm = createForm({
  initialValues: {
    orderNumber: 'ORD-001',
    customer: { name: 'Jane Doe', email: 'jane@test.com' },
    shipping: { street: '', city: '', zip: '' },
  },
  validators: {
    'orderNumber': [required('Order number is required')],
    'customer.name': [required('Customer name is required')],
    'customer.email': [required('Email is required'), email('Invalid email')],
  },
});

function saveNestedForm() { nestedForm.validate(); }
function nestedDirtyText() { return 'Dirty: ' + (nestedForm.dirty() ? 'Yes' : 'No'); }
function nestedDirtyClass() { return 'form-status-badge' + (nestedForm.dirty() ? ' active' : ''); }
function nestedValidText() { return 'Valid: ' + (nestedForm.valid() ? 'Yes' : 'No'); }
function nestedValidClass() { return 'form-status-badge' + (nestedForm.valid() ? ' success' : ' error'); }
function nestedValuesJson() { const v = nestedForm.dirty(); return JSON.stringify(nestedForm.getValues(), null, 2); }
</script>

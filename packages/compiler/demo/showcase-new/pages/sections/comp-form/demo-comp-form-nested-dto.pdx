<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">2. Nested DTO (Field Groups)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>&lt;pdx-field-group name="customer"&gt;</code> scopes child fields to a nested object.
      A field inside it is bound by its full path, <code>::value="form['customer.email']"</code>.
    </p>

    <div class="demo-block">
      <pdx-form :form="nestedForm" @pdx-submit="saveNestedForm">
        <pdx-form-field :field="nestedForm.orderNumber" label="Order Number" required>
          <pdx-input name="orderNumber" ::value="nestedForm.orderNumber" placeholder="ORD-001"></pdx-input>
        </pdx-form-field>

        <pdx-field-group name="customer" label="Customer">
          <pdx-form-field :field="nestedForm['customer.name']" label="Name" required>
            <pdx-input name="customer.name" ::value="nestedForm['customer.name']" placeholder="Jane Doe"></pdx-input>
          </pdx-form-field>
          <pdx-form-field :field="nestedForm['customer.email']" label="Email" required>
            <pdx-input name="customer.email" ::value="nestedForm['customer.email']" type="email" placeholder="jane@test.com"></pdx-input>
          </pdx-form-field>
        </pdx-field-group>

        <pdx-field-group name="shipping" label="Shipping Address">
          <pdx-form-field :field="nestedForm['shipping.street']" label="Street">
            <pdx-input name="shipping.street" ::value="nestedForm['shipping.street']" placeholder="123 Main St"></pdx-input>
          </pdx-form-field>
          <pdx-form-field :field="nestedForm['shipping.city']" label="City">
            <pdx-input name="shipping.city" ::value="nestedForm['shipping.city']" placeholder="New York"></pdx-input>
          </pdx-form-field>
          <pdx-form-field :field="nestedForm['shipping.zip']" label="ZIP">
            <pdx-input name="shipping.zip" ::value="nestedForm['shipping.zip']" placeholder="10001"></pdx-input>
          </pdx-form-field>
        </pdx-field-group>

        <pdx-form-actions submitLabel="Save Order" resetLabel="Reset"></pdx-form-actions>
      </pdx-form>

      <div class="form-status">
        <span :class="nestedDirtyClass()" :textContent="nestedDirtyText()"></span>
        <span :class="nestedValidClass()" :textContent="nestedValidText()"></span>
      </div>

      <div class="form-values">
        <strong>getValues():</strong>
        <pre :textContent="nestedValuesJson()"></pre>
      </div>
    </div>

    @raw {<details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>@form nestedForm: {
  orderNumber: string { required },
  customer: {
    name: string { required },
    email: string { required, email }
  },
  shipping: {
    street?: string,
    city?: string,
    zip?: string
  }
}

&lt;pdx-form :form="nestedForm"&gt;
  &lt;pdx-form-field :field="nestedForm.orderNumber" label="Order Number" required&gt;
    &lt;pdx-input name="orderNumber" ::value="nestedForm.orderNumber" /&gt;
  &lt;/pdx-form-field&gt;

  &lt;pdx-field-group name="customer" label="Customer"&gt;
    &lt;pdx-form-field :field="nestedForm['customer.name']" label="Name" required&gt;
      &lt;pdx-input name="customer.name" ::value="nestedForm['customer.name']" /&gt;
    &lt;/pdx-form-field&gt;
  &lt;/pdx-field-group&gt;

  &lt;pdx-field-group name="shipping" label="Shipping"&gt;
    ...
  &lt;/pdx-field-group&gt;
&lt;/pdx-form&gt;</code></pre></details>}
  </section>
</template>

<script>
import { createForm, required, email } from '@pdxui/core';

// ─── 2. Nested DTO (Field Groups) ───
const nestedForm = createForm({
  initialValues: {
    orderNumber: 'ORD-001',
    customer: { name: 'Jane Doe', email: 'jane@test.com' },
    shipping: { street: '', city: '', zip: '' },
  },
  validators: {
    'orderNumber': [required('Order number is required')],
    'customer.name': [required('Customer name is required')],
    'customer.email': [required('Email is required'), email('Invalid email')],
  },
});

function saveNestedForm() { nestedForm.validate(); }
function nestedDirtyText() { return 'Dirty: ' + (nestedForm.dirty() ? 'Yes' : 'No'); }
function nestedDirtyClass() { return 'form-status-badge' + (nestedForm.dirty() ? ' active' : ''); }
function nestedValidText() { return 'Valid: ' + (nestedForm.valid() ? 'Yes' : 'No'); }
function nestedValidClass() { return 'form-status-badge' + (nestedForm.valid() ? ' success' : ' error'); }
function nestedValuesJson() { const v = nestedForm.dirty(); return JSON.stringify(nestedForm.getValues(), null, 2); }
</script>

<style scoped>
  /* Moved here from the page's scoped block: a scoped style stops at nested components (#152). */
  .demo-block {
    margin-top: var(--pdx-space-lg);
    padding: var(--pdx-space-lg);
    border: 1px solid var(--pdx-color-border);
    border-radius: var(--pdx-radius-lg);
    background: var(--pdx-color-surface);
  }
  .form-values {
    margin: var(--pdx-space-md) 0 0;
    padding: var(--pdx-space-sm);
    font-size: var(--pdx-text-xs);
    background: var(--pdx-color-inset);
    border-radius: var(--pdx-radius-sm);
    overflow-x: auto;
    max-height: 200px;
  }
  .form-values pre {
    margin: var(--pdx-space-xs) 0 0;
    font-family: var(--pdx-font-mono);
    white-space: pre-wrap;
  }
</style>

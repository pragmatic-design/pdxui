<script setup>
import { createForm } from '@pdxui/core';

// ─── 7. All Types Form ───
const allTypesForm = createForm({
  initialValues: {
    text: '', password: '', number: 0, slider: 50, rating: 3,
    color: '#3b82f6', textarea: '', checkbox: false, switch: true,
  },
});
</script>


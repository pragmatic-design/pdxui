<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">6. Cross-Field Validation</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Password confirmation and date range validation — fields that depend on each other.
    </p>

    <div class="demo-block">
      <pdx-form :form="crossForm">
        <pdx-form-field name="password" label="New Password" required>
          <pdx-password-input name="password" placeholder="Min 6 characters"></pdx-password-input>
        </pdx-form-field>
        <pdx-form-field name="confirmPassword" label="Confirm Password" required>
          <pdx-password-input name="confirmPassword" placeholder="Must match"></pdx-password-input>
        </pdx-form-field>
        <div class="form-grid-2">
          <pdx-form-field name="startDate" label="Start Date" required>
            <pdx-date-picker name="startDate"></pdx-date-picker>
          </pdx-form-field>
          <pdx-form-field name="endDate" label="End Date" required>
            <pdx-date-picker name="endDate"></pdx-date-picker>
          </pdx-form-field>
        </div>
        <button type="submit" class="pdx-btn pdx-primary pdx-sm">Validate All</button>
      </pdx-form>
    </div>

    @raw {<details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>const form = createForm({
  initialValues: { password: '', confirmPassword: '', startDate: '', endDate: '' },
  validators: {
    password: [required(...), minLength(6, ...)],
    // Cross-field: reads another field's value
    confirmPassword: [required(...), (val) =&gt; {
      const pw = form.fields.password?.value();
      return val !== pw ? 'Passwords do not match' : undefined;
    }],
    endDate: [required(...), (val) =&gt; {
      const start = form.fields.startDate?.value();
      if (start &amp;&amp; val &amp;&amp; val &lt;= start)
        return 'End date must be after start date';
    }],
  },
});</code></pre></details>}
  </section>
</template>

<script setup>
import { createForm, required, minLength } from '@pdxui/core';

// ─── 6. Cross-Field Validation ───
const crossForm = createForm({ initialValues: { password: '', confirmPassword: '', startDate: '', endDate: '' }, validators: { password: [required('Password is required'), minLength(6, 'Min 6 characters')], confirmPassword: [required('Confirm is required'), (val) => { const pw = crossForm.fields.password?.value(); return val !== pw ? 'Passwords do not match' : undefined; }], startDate: [required('Start date is required')], endDate: [required('End date is required'), (val) => { const start = crossForm.fields.startDate?.value(); if (start && val && val <= start) return 'End date must be after start date'; return undefined; }] }, validateOn: 'onBlur' });
</script>

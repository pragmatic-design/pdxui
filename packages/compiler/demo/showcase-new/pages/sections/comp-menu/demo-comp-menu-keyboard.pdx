<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Keyboard</h2>
    <div class="options-table">
      <table>
        <thead><tr><th>Key</th><th>Action</th></tr></thead>
        <tbody>
          <tr><td><kbd>Arrow Down / Up</kbd></td><td>Next / previous item</td></tr>
          <tr><td><kbd>Arrow Right</kbd></td><td>Open a submenu, on its first item</td></tr>

<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Icons &amp; Keyboard Shortcuts</h2>
    <p class="pdx-txt-small pdx-ink-muted">Items with leading icons and right-aligned shortcut hints.</p>

    <div class="demo-row">
      <div class="menu-demo">
        <button class="pdx-outline" size="sm" :aria-expanded="shown === 'actions' ? 'true' : 'false'" @click="show('actions')">Actions</button>
        <pdx-menu :open="shown === 'actions'" :items="actionItems" @pdx-select="onSelect" @pdx-close="hide"></pdx-menu>
      </div>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>// { key: 'undo', label: 'Undo', icon: 'undo', shortcut: 'Ctrl+Z' }
// { key: 'find', label: 'Find', icon: 'search', shortcut: 'Ctrl+F' }</code></pre>
    </details>
  </section>
</template>

<script setup>
import { useMenuDemo } from './state.pdx';

// One menu open at a time across the sections (state.pdx.ts).
const menuDemo = useMenuDemo();
const shown = $derived(menuDemo.shown());
function show(key) { menuDemo.show(key); }
function hide(e) { menuDemo.hide(e); }
function onSelect(e) { menuDemo.onSelect(e); }

const actionItems = [
  { key: 'undo', label: 'Undo', icon: 'undo', shortcut: 'Ctrl+Z' },
  { key: 'redo', label: 'Redo', icon: 'redo', shortcut: 'Ctrl+Y' },
  { key: 'sep1', label: '', type: 'separator' },
  { key: 'find', label: 'Find', icon: 'search', shortcut: 'Ctrl+F' },
  { key: 'replace', label: 'Replace', icon: 'refresh', shortcut: 'Ctrl+H' },
];
</script>

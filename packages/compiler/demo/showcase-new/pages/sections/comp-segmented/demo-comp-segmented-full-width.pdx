<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Full Width</h2>
    <div class="demo-row">
      <pdx-segmented label="Layout" :value="layout" options='[{"label":"Grid","value":"grid"},{"label":"List","value":"list"},{"label":"Table","value":"table"}]' full @value-change="onLayout"></pdx-segmented>
    </div>
  </section>
</template>

<script>
let layout = $signal('grid');

function onLayout(e) {
  layout = e.detail.value;
}
</script>

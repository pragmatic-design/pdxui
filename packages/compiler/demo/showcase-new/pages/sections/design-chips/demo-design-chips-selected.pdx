<template>
  <section>
    <h2 class="pdx-txt-heading section-heading">Selected State</h2>
    <p class="pdx-txt-small pdx-ink-muted">Add <code>[selected]</code> attribute for active/selected appearance.</p>

    <div class="chip-row">
      <span class="pdx-chip">Unselected</span>
      <span class="pdx-chip" selected>Selected</span>
      <span class="pdx-chip pdx-chip-primary" selected>Primary selected</span>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;span class="pdx-chip" selected&gt;Selected&lt;/span&gt;</code></pre>
    </details>
  </section>
</template>

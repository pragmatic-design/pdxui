    <app-demo-comp-avatar-group-reversed class="demo-section"></app-demo-comp-avatar-group-reversed>

    <app-demo-comp-avatar-group-custom-max class="demo-section"></app-demo-comp-avatar-group-custom-max>

    <app-demo-comp-avatar-group-without-border class="demo-section"></app-demo-comp-avatar-group-without-border>

    <section>
      <h2 class="pdx-txt-heading section-heading">Props</h2>
      <div class="options-table">
        <table>
          <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
          <tbody>
            <tr><td><code>items</code></td><td>Array</td><td>null</td><td>Array of avatar items: { name, src, color }</td></tr>
            <tr><td><code>max</code></td><td>Number</td><td>5</td><td>Max visible avatars before +N overflow</td></tr>
            <tr><td><code>size</code></td><td>String</td><td>'md'</td><td>Avatar size: xs, sm, md, lg, xl</td></tr>
            <tr><td><code>overlap</code></td><td>Number</td><td>-8</td><td>Overlap in px (negative margin)</td></tr>
            <tr><td><code>direction</code></td><td>String</td><td>'row'</td><td>Flex direction: row, row-reverse</td></tr>
            <tr><td><code>clickable</code></td><td>Boolean</td><td>false</td><td>Avatars and the +N badge become buttons: click, Enter or Space</td></tr>
            <tr><td><code>bordered</code></td><td>Boolean</td><td>true</td><td>White ring border around each avatar</td></tr>
          </tbody>
        </table>
      </div>
    </section>


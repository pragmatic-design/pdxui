<template>
  <div class="page">
    <h1 class="pdx-txt-title">Password Input</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-password-input&gt;</code> — toggle visibility button, optional strength meter.
      Built on the <code>&lt;pdx-input&gt;</code> wrapper pattern.
    </p>

    <!-- Basic -->
    <app-demo-comp-password-basic class="demo-section"></app-demo-comp-password-basic>

    <!-- States -->
    <app-demo-comp-password-states class="demo-section"></app-demo-comp-password-states>

    <!-- Reference -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Reference</h2>

      <h3 class="pdx-txt-subheading">Props</h3>
      <div class="options-table">
        <div class="opt-header"><span>Prop</span><span>Type</span><span>Description</span></div>
        <div class="opt-row"><code>showStrength</code><span>boolean</span><span>Show strength meter below input</span></div>
        <div class="opt-row"><code>value</code><span>string</span><span>Current value</span></div>
        <div class="opt-row"><code>placeholder</code><span>string</span><span>Placeholder text</span></div>
        <div class="opt-row"><code>disabled</code><span>boolean</span><span>Disabled state</span></div>
        <div class="opt-row"><code>size</code><span>string</span><span>sm, (default), lg</span></div>
        <div class="opt-row"><code>error</code><span>boolean</span><span>Error state styling</span></div>
        <div class="opt-row"><code>name</code><span>string</span><span>Form field name</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Events</h3>
      <div class="options-table">
        <div class="opt-header"><span>Event</span><span>Description</span></div>
        <div class="opt-row"><code>value-change</code><span>Every keystroke: its model's event, <code>{ value }</code>, what <code>::value</code> listens to</span></div>
        <div class="opt-row"><code>change</code><span>The commit, on blur or Enter: the inner input's native event</span></div>
        <div class="opt-row"><code>pdx-focus / pdx-blur</code><span>The textbox received or lost focus</span></div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">States and parts</h3>
      <div class="options-table">
        <div class="opt-header"><span>Selector</span><span>When</span></div>
        <div class="opt-row"><code>:state(invalid)</code><span><code>error</code> is set</span></div>
        <div class="opt-row"><code>:state(disabled) / :state(loading)</code><span><code>disabled</code> / <code>loading</code> is set; while loading the textbox is <code>aria-busy</code></span></div>
        <div class="opt-row"><code>[data-part="root"] / [data-part="input"]</code><span>The frame, the native input</span></div>
        <div class="opt-row"><code>[data-part="toggle"] / [data-part="strength"]</code><span>The show/hide button, the strength meter</span></div>
      </div>
    </section>
  </div>
</template>

<script>
@page '/components/password';
@title 'Password Input';
</script>

<style scoped>
  .page { }
</style>

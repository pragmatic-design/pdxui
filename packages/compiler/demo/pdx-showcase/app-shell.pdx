<template>
  <div class="shell">
    <header class="topbar">
      <span class="brand">PDX Components</span>
      <div class="topbar-controls">
        <select @change="onThemeChange">
          <option value="neutral">Neutral</option>
          <option value="material">Material</option>
          <option value="fluent">Fluent</option>
          <option value="cupertino">Cupertino</option>
          <option value="pragmatic">Pragmatic</option>
          <option value="corporate">Corporate</option>
          <option value="playful">Playful</option>
          <option value="cyberpunk">Cyberpunk</option>
          <option value="editorial">Editorial</option>
        </select>
        <button @click="onDarkToggle" :class="isDark ? 'active' : ''">
          @if (isDark) { ☀️ Light } @else { 🌙 Dark }
        </button>
      </div>
    </header>

    <nav class="sidebar">
      <div class="nav-group">Atoms</div>
      <button @click="showPage('button')" :class="activePage === 'button' ? 'nav-active' : ''">Button</button>
      <button @click="showPage('badge')" :class="activePage === 'badge' ? 'nav-active' : ''">Badge</button>
      <div class="nav-group">Inputs</div>
      <button @click="showPage('input')" :class="activePage === 'input' ? 'nav-active' : ''">Input</button>
      <div class="nav-group">Overlay</div>
      <button @click="showPage('dialog')" :class="activePage === 'dialog' ? 'nav-active' : ''">Dialog</button>
    </nav>

    <main class="content">
      @if (activePage === 'button') {
        <pdx-page-button></pdx-page-button>
      } @else if (activePage === 'badge') {
        <pdx-page-badge></pdx-page-badge>
      } @else if (activePage === 'input') {
        <pdx-page-input></pdx-page-input>
      } @else if (activePage === 'dialog') {
        <pdx-page-dialog></pdx-page-dialog>
      }
    </main>
  </div>
</template>

<script setup>
import { useTheme } from './theme-store.pdx';

const store = useTheme();
let activePage = $signal('button');
let isDark = $signal(false);

function showPage(name) { activePage = name; }

function onThemeChange(e) { store.setTheme(e.target.value); }
function onDarkToggle() {
    store.toggleDark();
    isDark = !isDark;
}
</script>

<style scoped>
  .shell { display: grid; grid-template-columns: 200px 1fr; grid-template-rows: 48px 1fr; height: 100vh; overflow: hidden; }
  .topbar { grid-column: 1 / -1; display: flex; align-items: center; padding: 0 16px; background: var(--pdx-color-surface, white); border-bottom: 1px solid var(--pdx-color-border, #e0e0e0); z-index: 10; }
  .brand { font-weight: 700; font-size: 0.9rem; flex: 1; }
  .topbar-controls { display: flex; gap: 8px; align-items: center; }
  .topbar-controls select, .topbar-controls button { font-size: 0.8rem; padding: 4px 10px; border-radius: 4px; border: 1px solid var(--pdx-color-border, #ddd); background: var(--pdx-color-surface, white); color: var(--pdx-color-text, #333); cursor: pointer; }
  .topbar-controls button.active { background: var(--pdx-color-primary, #3b82f6); color: white; border-color: transparent; }
  .sidebar { overflow-y: auto; padding: 8px 0; background: var(--pdx-color-surface, white); border-right: 1px solid var(--pdx-color-border, #e0e0e0); }
  .nav-group { padding: 12px 14px 4px; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pdx-color-muted, #999); }
  .sidebar button { display: block; width: 100%; text-align: left; padding: 6px 14px; font-size: 0.82rem; border: none; background: none; color: var(--pdx-color-text, #333); cursor: pointer; border-left: 3px solid transparent; }
  .sidebar button:hover { background: var(--pdx-color-inset, #f5f5f7); }
  .sidebar button.nav-active { border-left-color: var(--pdx-color-primary, #3b82f6); color: var(--pdx-color-primary, #3b82f6); font-weight: 600; background: var(--pdx-color-inset, #f5f5f7); }
  .content { overflow-y: auto; padding: 24px 32px; background: var(--pdx-color-bg, #f5f5f7); }
</style>

<template>
  <div class="counter-card">
    <h3>{{ label }}</h3>
    <div class="counter-row">
      <button @click="dec">−</button>
      <span class="value">{{ count }}</span>
      <button @click="inc">+</button>
    </div>
    <span class="derived">doubled: {{ doubled }}</span>
    @if (count > 5) {
      <div class="alert">Count is greater than 5!</div>
    } @else {
      <div class="hint">Click + to go above 5</div>
    }
  </div>
</template>

<script setup>
  @prop label: string = 'Counter';
  @prop initial: number = 0;

  let count = $signal(initial);
  const doubled = $derived(count * 2);

  function inc() { count++; }
  function dec() { count--; }

  onMount(() => console.log('Counter mounted:', label));
</script>

<style scoped>
  .counter-card { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }
  .counter-row { display: flex; gap: 0.75rem; align-items: center; margin: 0.5rem 0; }
  .value { font-size: 2rem; font-weight: bold; min-width: 3rem; text-align: center; }
  .derived { font-size: 0.85rem; color: #666; }
  button { padding: 0.5rem 1rem; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; font-size: 1.2rem; }
  button:hover { background: #f0f0f0; }
  .alert { background: #fff3cd; color: #856404; padding: 0.5rem; border-radius: 4px; margin-top: 0.5rem; }
  .hint { color: #888; font-size: 0.85rem; margin-top: 0.5rem; }
</style>

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-form-field/demo-comp-form-field-error-display.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

component('pdx-demo-comp-form-field-error-display', {
  props: {},
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Error Display (touched-gated)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Error shows only when <code>touched=true</code> (user has interacted).
      This prevents showing errors on pristine fields. Use <code>showError</code> to force display (e.g. on submit).
    </p>

    <div class="demo-stack">
      <pdx-form-field label="Not touched yet" error="This field is required">
        <pdx-input placeholder="Error hidden — not touched yet"></pdx-input>
      </pdx-form-field>

      <pdx-form-field label="Touched field" error="Email is invalid" touched>
        <pdx-input placeholder="Error visible — field was touched" value="bad@"></pdx-input>
      </pdx-form-field>

      <pdx-form-field label="Force error" error="Required field" showError>
        <pdx-input placeholder="Error forced via showError (e.g. on submit)"></pdx-input>
      </pdx-form-field>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;!-- Error hidden: not touched --&gt;
&lt;pdx-form-field label="Email" error="Invalid"&gt;...&lt;/pdx-form-field&gt;

&lt;!-- Error visible: touched --&gt;
&lt;pdx-form-field label="Email" error="Invalid" touched&gt;...&lt;/pdx-form-field&gt;

&lt;!-- Error forced: on submit --&gt;
&lt;pdx-form-field label="Email" error="Required" showError&gt;...&lt;/pdx-form-field&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-form-field/demo-comp-form-field-form-integration.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-qxnwvy");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-qxnwvy"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-qxnwvy] .code-block { margin-top: var(--pdx-space-md); padding: var(--pdx-space-md); border: 1px solid var(--pdx-color-border); border-radius: var(--pdx-radius-md); background: var(--pdx-color-inset); overflow-x: auto; }\\n  [data-pdx-qxnwvy] .code-block pre { margin: 0; font-size: var(--pdx-text-xs); }\\n";
}

component('pdx-demo-comp-form-field-form-integration', {
  props: {},
  setup(ctx) {
    ctx.el.setAttribute('data-pdx-qxnwvy', '');
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">@form Integration Pattern</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      When using the PDX <code>@form</code> rune, FormField reads validation state from the form object.
      The form handles all validation — FormField is purely presentational.
    </p>

    <div class="code-block">
      <pre class="pdx-txt-mono"><code>@form contact: {
  name: string { required, minLength: 3 },
  email: string { required, email },
}

&lt;pdx-form-field
  label="Name"
  required
  :error="contact.fields.name.error()"
  :touched="contact.fields.name.touched()"&gt;
  &lt;pdx-input
    :value="contact.fields.name.value()"
    @input="contact.fields.name.onChange($event.detail.value)"
    @blur="contact.fields.name.onBlur()"&gt;
  &lt;/pdx-input&gt;
&lt;/pdx-form-field&gt;</code></pre>
    </div>
  </section>
\`,
});
"
`;


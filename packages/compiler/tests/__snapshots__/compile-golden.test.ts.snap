exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-file-upload/demo-comp-file-upload-basic.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-file-upload-basic', {
  props: {},
  setup(ctx) {
    const __selectedFiles = signal('None', { name: 'demo-comp-file-upload-basic:selectedFiles' });
function onSelect(e) {
      const names = e.detail.files.map(f => f.name);
      __selectedFiles.set(names.join(', ') || 'None');
    }
    return { selectedFiles: __selectedFiles, onSelect };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">Drop files or click the zone to browse. Selected file names shown below.</p>

    <div class="demo-stack">
      <pdx-file-upload @pdx-select=\${safeHandler(ctx.onSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')}></pdx-file-upload>
      <div class="result-box">
        <span class="pdx-txt-small pdx-ink-muted">Selected: </span>
        <span class="pdx-txt-small">\${ctx.selectedFiles}</span>
      </div>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-file-upload @pdx-select="onSelect" /&gt;

function onSelect(e) {
  const names = e.detail.files.map(f => f.name);
  selectedFiles = names.join(', ') || 'None';
}</code></pre>
    </details>
  </section>
\`,
});
"
`;


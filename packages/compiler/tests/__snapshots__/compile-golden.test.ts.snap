exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-chip/demo-comp-chip-avatar.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, eachRow, html, safeHandler, signal, when } from '@pdxui/core';
import { useChipConsole } from './state.pdx';

component('pdx-demo-comp-chip-avatar', {
  props: {},
  setup(ctx) {
const chipConsole = useChipConsole();
    
    function dropPerson(list, e) { return chipConsole.dropPerson(list, e); }
    
    // Avatar chips and the team card: removable for real. The portraits are this app's
    // (public/avatars/), not a third party's.
    function startPeople() {
        return [
            { name: 'Jane Doe', avatar: '/avatars/person-1.svg', variant: '' },
            { name: 'Alex Smith', avatar: '/avatars/person-2.svg', variant: 'primary' },
        ];
    }
    const __people = signal(startPeople(), { name: 'demo-comp-chip-avatar:people' });
    return { chipConsole, dropPerson, startPeople, people: __people };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">With Avatar</h2>
    <p class="pdx-txt-small pdx-ink-muted"><code>avatar</code> prop renders a small circle image before the label.</p>

    <div class="demo-row">
      \${eachRow(() => ctx.people(), 'name', (person) => html\`
        <pdx-chip :avatar=\${() => person().avatar} :variant=\${() => person().variant} removable :value=\${() => person().name} @pdx-remove=\${safeHandler(e => ctx.people.set(ctx.dropPerson(ctx.people(), e)), ctx.el?.tagName?.toLowerCase(), 'pdx-remove')}>\${() => person().name}</pdx-chip>
      \`)}<pdx-chip avatar="/avatars/person-3.svg" variant="tonal-success">Mary Kim</pdx-chip>
      \${when(() => ctx.people().length < 2, () => html\`
        <button class="pdx-ghost" size="sm" @click=\${safeHandler(() => ctx.people.set(ctx.startPeople()), ctx.el?.tagName?.toLowerCase(), 'click')}>Reset</button>
      \`, null)}</div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-chip avatar="https://..." removable @pdx-remove="onRemove"&gt;
  Jane Doe
&lt;/pdx-chip&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


        <p class="pdx-txt-small pdx-ink-muted">21:9 (Ultra-wide)</p>
        <pdx-aspect-ratio ratio="21/9">
          <div class="ratio-content">21:9</div>
        </pdx-aspect-ratio>
      </div>
    </div>
    <details class="source-block">
      <summary>Source</summary>

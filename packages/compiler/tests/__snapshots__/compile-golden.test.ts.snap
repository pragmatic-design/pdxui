component('pdx-demo-comp-bottom-sheet-basic', {
  props: {},
  setup(ctx) {
    const __basicOpen = signal(false, { name: 'demo-comp-bottom-sheet-basic:basicOpen' });
// Basic
    
    
    function openBasic() { __basicOpen.set(true); }
    function closeBasic() { __basicOpen.set(false); }
    return { basicOpen: __basicOpen, openBasic, closeBasic };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">Default detents: 40% and 85% of viewport. Drag the handle or swipe down to dismiss.</p>
    <pdx-button variant="outline" @click=\${safeHandler(ctx.openBasic, ctx.el?.tagName?.toLowerCase(), 'click')}>Open Bottom Sheet</pdx-button>


    <h3>Focus Trap</h3>
    <p class="desc">Tab cycles within the box. Siblings get aria-hidden.</p>
    <button class="pdx-primary" @click=\${safeHandler(ctx.activateTrap, ctx.el?.tagName?.toLowerCase(), 'click')} data-test="activate-trap">Activate Trap</button>

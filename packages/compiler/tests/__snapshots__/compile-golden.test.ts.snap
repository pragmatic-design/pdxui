{
  let __pdx_style = document.getElementById("pdx-s-u4xb1z");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-u4xb1z"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-u4xb1z] .scroll-container {\\n  height: 350px;\\n  overflow-y: auto;\\n  border: 1px solid var(--pdx-color-border);\\n  border-radius: var(--pdx-radius-md);\\n  background: var(--pdx-color-bg);\\n  position: relative;\\n}\\n[data-pdx-u4xb1z] .affix-state { margin: var(--pdx-space-sm) 0; }\\n[data-pdx-u4xb1z] .scroll-spacer {\\n  padding: var(--pdx-space-xl) var(--pdx-space-lg);\\n  min-height: 100px;\\n}\\n[data-pdx-u4xb1z] .sticky-bar {\\n  display: flex;\\n  align-items: center;\\n  gap: var(--pdx-space-sm);\\n  padding: var(--pdx-space-sm) var(--pdx-space-lg);\\n  background: var(--pdx-color-surface);\\n  border-bottom: 1px solid var(--pdx-color-border);\\n  font-size: var(--pdx-text-sm);\\n}\\n[data-pdx-u4xb1z] .scroll-content {\\n  padding: var(--pdx-space-lg);\\n  display: flex;\\n  flex-direction: column;\\n  gap: var(--pdx-space-md);\\n  font-size: var(--pdx-text-sm);\\n  min-height: 600px;\\n}\\n";
}

component('pdx-demo-comp-affix-live', {
  props: {},
  setup(ctx) {
    const __affixed = signal(false, { name: 'demo-comp-affix-live:affixed' });
    ctx.el.setAttribute('data-pdx-u4xb1z', '');
    return { affixed: __affixed };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Live Demo</h2>
    <p class="pdx-txt-small pdx-ink-muted">Scroll the box below. The toolbar sticks to the top of the scroll container, and <code>pdx-change</code> says so.</p>
    <p class="pdx-txt-small affix-state" aria-live="polite">Affixed: <strong>\${() => ctx.affixed() ? 'yes' : 'no'}</strong></p>
    <div class="scroll-container" id="affix-container">
      <div class="scroll-spacer">
        <p class="pdx-txt-small pdx-ink-muted">Scroll down to see the toolbar become sticky.</p>
      </div>
      <pdx-affix :offset-top=\${0} target="#affix-container" @pdx-change=\${safeHandler(e => ctx.affixed.set(e.detail.affixed), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}>
        <div class="sticky-bar">
          <pdx-icon name="filter" size="16"></pdx-icon>
          <strong>Sticky Toolbar</strong>
          <span class="pdx-ink-muted">— scrolls with content, then sticks</span>
        </div>
      </pdx-affix>
      <div class="scroll-content">
        <p>This content scrolls normally beneath the sticky toolbar.</p>
        <p>The <code>pdx-affix</code> component wraps any element and makes it stick to the top (or bottom) of the scroll container when the user scrolls past it.</p>
        <p>Here, inside a scroll container, it is CSS sticky: it keeps its own place in the flow, so nothing jumps.</p>
        <p>You can configure the offset from top/bottom and target a specific scroll container.</p>
        <p class="pdx-ink-muted">Keep scrolling...</p>
        <p>The state is reported by an IntersectionObserver rooted at the container — no scroll listener in this mode.</p>
        <p>When the user scrolls back up, the element returns to its normal flow position.</p>
        <p class="pdx-ink-muted">Almost there...</p>
        <p>End of scrollable content.</p>
      </div>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;div class="scroll-container" id="affix-container"&gt;
  …
  &lt;pdx-affix :offsetTop="0" target="#affix-container"
    @pdx-change="e =&gt; affixed = e.detail.affixed"&gt;
    &lt;div class="sticky-bar"&gt;Sticky Toolbar&lt;/div&gt;
  &lt;/pdx-affix&gt;
  …
&lt;/div&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


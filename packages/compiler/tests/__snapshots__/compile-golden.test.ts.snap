component('pdx-demo-atoms', {
  props: {},
  setup(ctx) {
    ctx.el.setAttribute('data-pdx-qbbqpf', '');

  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Tier 1 — Atom Components</h2>
    <p class="desc">13 building block components. Each is a Web Component (pdx-*).</p>

    <section>
      <h3>Button</h3>
      <div class="row">
        <pdx-button variant="solid">Solid</pdx-button>
        <pdx-button variant="outline">Outline</pdx-button>
        <pdx-button variant="ghost">Ghost</pdx-button>
        <pdx-button variant="link">Link</pdx-button>
        <pdx-button loading="true">Loading</pdx-button>
        <pdx-button disabled="true">Disabled</pdx-button>
      </div>
      <div class="row" style="margin-top:8px">
        <pdx-button size="xs">XS</pdx-button>
        <pdx-button size="sm">SM</pdx-button>
        <pdx-button size="md">MD</pdx-button>
        <pdx-button size="lg">LG</pdx-button>
        <pdx-button size="xl">XL</pdx-button>
      </div>
    </section>

    <section>
      <h3>Badge</h3>
      <div class="row">
        <pdx-badge value="5"></pdx-badge>
        <pdx-badge value="42" variant="primary"></pdx-badge>
        <pdx-badge value="150" max="99" variant="error"></pdx-badge>
        <pdx-badge dot="true" variant="success"></pdx-badge>
        <pdx-badge value="0" hide-zero="true"></pdx-badge>
      </div>
    </section>

    <section>
      <h3>Chip / Tag</h3>
      <div class="row">
        <pdx-chip label="Default"></pdx-chip>
        <pdx-chip label="Primary" variant="primary"></pdx-chip>
        <pdx-chip label="Removable" removable="true"></pdx-chip>
        <pdx-chip label="Success" variant="success"></pdx-chip>
        <pdx-chip label="Disabled" disabled="true"></pdx-chip>
      </div>
    </section>

    <section>
      <h3>Avatar</h3>
      <div class="row">
        <pdx-avatar alt="John Doe" size="sm"></pdx-avatar>
        <pdx-avatar alt="Jane Smith" size="md"></pdx-avatar>
        <pdx-avatar alt="A" size="lg"></pdx-avatar>
        <!-- The showcase's own portrait, not a third-party service; served from compiler/demo, /infra/atoms.html. -->
        <pdx-avatar src="../showcase-new/public/avatars/person-1.svg" alt="Photo" size="lg"></pdx-avatar>
        <pdx-avatar alt="Bob Wilson" size="xl" shape="square"></pdx-avatar>
      </div>
    </section>

    <section>
      <h3>Spinner</h3>
      <div class="row">
        <pdx-spinner size="sm"></pdx-spinner>
        <pdx-spinner size="md"></pdx-spinner>
        <pdx-spinner size="lg"></pdx-spinner>
        <pdx-spinner variant="dots" size="md"></pdx-spinner>
        <pdx-spinner variant="bar" size="md"></pdx-spinner>
      </div>
    </section>

    <section>
      <h3>Divider</h3>
      <p>Above divider</p>
      <pdx-divider></pdx-divider>
      <p>Below divider</p>
      <pdx-divider label="OR"></pdx-divider>
      <p>Below labeled divider</p>
      <pdx-divider variant="dashed"></pdx-divider>
      <p>Below dashed divider</p>
    </section>

    <section>
      <h3>Kbd</h3>
      <div class="row">
        <pdx-kbd keys="Ctrl+S"></pdx-kbd>
        <pdx-kbd keys="⌘+K"></pdx-kbd>
        <pdx-kbd keys="Shift+Enter"></pdx-kbd>
        <pdx-kbd keys="Esc"></pdx-kbd>
      </div>
    </section>

    <section>
      <h3>Input</h3>
      <div class="stack">
        <pdx-label text="Name" required="true"></pdx-label>
        <pdx-input placeholder="Enter your name..." size="md"></pdx-input>
        <pdx-label text="Email" hint="We'll never share your email"></pdx-label>
        <pdx-input type="email" placeholder="you@example.com" size="md"></pdx-input>
        <pdx-label text="Error state"></pdx-label>
        <pdx-input placeholder="Invalid input" error="true" size="md"></pdx-input>
        <pdx-label text="Disabled"></pdx-label>
        <pdx-input placeholder="Can't edit" disabled="true" size="md"></pdx-input>
      </div>
    </section>

    <section>
      <h3>Checkbox & Radio</h3>
      <div class="stack">
        <pdx-checkbox label="Accept terms" checked="false"></pdx-checkbox>
        <pdx-checkbox label="Pre-checked" checked="true"></pdx-checkbox>
        <pdx-checkbox label="Indeterminate" indeterminate="true"></pdx-checkbox>
        <pdx-checkbox label="Disabled" disabled="true"></pdx-checkbox>
      </div>
      <div class="stack" style="margin-top:12px">
        <pdx-radio label="Option A" name="group1" value="a" checked="true"></pdx-radio>
        <pdx-radio label="Option B" name="group1" value="b"></pdx-radio>
        <pdx-radio label="Option C (disabled)" name="group1" value="c" disabled="true"></pdx-radio>
      </div>
    </section>

    <section>
      <h3>Switch</h3>
      <div class="stack">
        <pdx-switch label="Notifications" checked="true"></pdx-switch>
        <pdx-switch label="Dark mode" checked="false"></pdx-switch>
        <pdx-switch label="Disabled" disabled="true"></pdx-switch>
        <pdx-switch label="Left label" label-position="left"></pdx-switch>
      </div>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > infra/demo-container.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, effect, html, measure, measureRelative, onDestroy, onMount, safeHandler, signal, useContainerSize, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-hnq9is");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-hnq9is"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-hnq9is] .demo { max-width: 800px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-hnq9is] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-hnq9is] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-hnq9is] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-hnq9is] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-hnq9is] .resize-box { resize: horizontal; overflow: auto; border: 2px dashed #e0e0e0; border-radius: 8px; padding: 12px; min-width: 200px; max-width: 100%; width: 600px; display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }\\n  [data-pdx-hnq9is] .resize-box.compact { border-color: #ef4444; }\\n  [data-pdx-hnq9is] .resize-box.medium { border-color: #f59e0b; }\\n  [data-pdx-hnq9is] .resize-box.wide { border-color: #22c55e; }\\n  [data-pdx-hnq9is] .stats { display: flex; gap: 20px; font-size: 0.9rem; }\\n  [data-pdx-hnq9is] .badges { display: flex; gap: 8px; }\\n  [data-pdx-hnq9is] .badge { padding: 2px 8px; border-radius: 99px; font-size: 0.7rem; font-weight: 600; background: #e0e0e0; color: #999; }\\n  [data-pdx-hnq9is] .badge.on { background: #3b82f6; color: white; }\\n  [data-pdx-hnq9is] .card { flex: 1; padding: 8px; background: #f5f5f7; border-radius: 6px; text-align: center; font-size: 0.8rem; }\\n  [data-pdx-hnq9is] .card-row { display: flex; gap: 8px; }\\n  [data-pdx-hnq9is] .measure-row { display: flex; gap: 24px; margin: 8px 0; }\\n  [data-pdx-hnq9is] .box-a { padding: 16px 32px; background: #3b82f6; color: white; border-radius: 8px; font-weight: 600; }\\n  [data-pdx-hnq9is] .box-b { padding: 16px 32px; background: #22c55e; color: white; border-radius: 8px; font-weight: 600; }\\n  [data-pdx-hnq9is] .log { font-family: monospace; font-size: 0.75rem; background: #f5f5f7; padding: 8px; border-radius: 6px; white-space: pre-wrap; min-height: 48px; margin: 8px 0 0; }\\n";
}

component('pdx-demo-container', {
  props: {},
  setup(ctx) {
    const __width = signal(0, { name: 'demo-container:width' });
    const __height = signal(0, { name: 'demo-container:height' });
    const __isCompact = signal(true, { name: 'demo-container:isCompact' });
    const __isMedium = signal(false, { name: 'demo-container:isMedium' });
    const __isWide = signal(false, { name: 'demo-container:isWide' });
    const __measureLog = signal('Click "Measure"', { name: 'demo-container:measureLog' });
    const __resizeRef = signal(null, { name: 'demo-container:resizeRef' });
    const __boxARef = signal(null, { name: 'demo-container:boxARef' });
    const __boxBRef = signal(null, { name: 'demo-container:boxBRef' });
/** The border's class, from the breakpoint: computed, not written by the effect (CD-D2). */
    
    
    
    
    
    
    
    
    function doMeasure() {
        const a = __boxARef();
        const b = __boxBRef();
        if (!a || !b) return;
        const mA = measure(a);
        const mB = measure(b);
        const rel = measureRelative(a, b);
        __measureLog.set('A: ' + Math.round(mA.width) + 'x' + Math.round(mA.height) + ' at (' + Math.round(mA.x) + ', ' + Math.round(mA.y) + ')\\n' +
            'B: ' + Math.round(mB.width) + 'x' + Math.round(mB.height) + ' at (' + Math.round(mB.x) + ', ' + Math.round(mB.y) + ')\\n' +
            'Relative: dx=' + Math.round(rel.dx) + ', dy=' + Math.round(rel.dy) + ', overlap=' + rel.overlap);
    }
    const bpClass = computed(() => __isCompact() ? 'compact' : __isMedium() ? 'medium' : 'wide', { name: 'demo-container:bpClass' });
    onMount(() => {
    requestAnimationFrame(() => {
        const el = __resizeRef();
        if (!el) return;

        const cs = useContainerSize(() => el);

        effect(() => {
            __width.set(cs.width());
            __height.set(cs.height());
            __isCompact.set(cs.isCompact());
            __isMedium.set(cs.isMedium());
            __isWide.set(cs.isWide());
        });
    });
});
    ctx.el.setAttribute('data-pdx-hnq9is', '');
    return { width: __width, height: __height, isCompact: __isCompact, isMedium: __isMedium, isWide: __isWide, bpClass, measureLog: __measureLog, resizeRef: __resizeRef, boxARef: __boxARef, boxBRef: __boxBRef, doMeasure };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Layout / Sizing</h2>
    <p class="desc">Signal-based container awareness, measure utilities, container queries.</p>

    <section>
      <h3>useContainerSize()</h3>
      <p class="desc">Drag the right edge to resize. Border color and content adapt to width.</p>
      <div class="resize-box" :class=\${() => ctx.bpClass()} :ref=\${ctx.resizeRef}>
        <div class="stats">
          <span>Width: <strong>\${ctx.width}px</strong></span>
          <span>Height: <strong>\${ctx.height}px</strong></span>
        </div>
        <div class="badges">
          <span class="badge" :class=\${() => ctx.isCompact() ? 'on' : ''}>Compact (&lt;480)</span>
          <span class="badge" :class=\${() => ctx.isMedium() ? 'on' : ''}>Medium (480-768)</span>
          <span class="badge" :class=\${() => ctx.isWide() ? 'on' : ''}>Wide (&gt;768)</span>
        </div>
        \${when(() => ctx.isCompact(), () => html\`
          <div class="card">Compact: stacked, minimal</div>
        \`, null)}\${when(() => ctx.isMedium(), () => html\`
          <div class="card-row"><div class="card">Col A</div><div class="card">Col B</div></div>
        \`, null)}\${when(() => ctx.isWide(), () => html\`
          <div class="card-row"><div class="card">Col A</div><div class="card">Col B</div><div class="card">Col C</div></div>
        \`, null)}</div>
    </section>

    <section>
      <h3>measure() / measureRelative()</h3>
      <div class="measure-row">
        <div class="box-a" :ref=\${ctx.boxARef}>Box A</div>
        <div class="box-b" :ref=\${ctx.boxBRef}>Box B</div>
      </div>
      <button class="pdx-primary" @click=\${safeHandler(ctx.doMeasure, ctx.el?.tagName?.toLowerCase(), 'click')}>Measure</button>
      <pre class="log">\${ctx.measureLog}</pre>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > infra/demo-datasource.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createDataSource, eachRow, effect, html, onDestroy, onMount, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-oxc18m");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-oxc18m"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-oxc18m] .demo { max-width: 700px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-oxc18m] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-oxc18m] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-oxc18m] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-oxc18m] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-oxc18m] .controls { margin-bottom: 8px; }\\n  [data-pdx-oxc18m] .input { padding: 6px 10px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 0.9rem; width: 250px; }\\n  [data-pdx-oxc18m] .row { display: flex; gap: 8px; align-items: center; }\\n  [data-pdx-oxc18m] .table-wrap { border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; }\\n  [data-pdx-oxc18m] .table-header { display: grid; grid-template-columns: 60px 1fr 1fr; background: #f5f5f7; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; color: #666; }\\n  [data-pdx-oxc18m] .table-header .col { cursor: pointer; }\\n  [data-pdx-oxc18m] .table-header .col:hover { color: #3b82f6; }\\n  [data-pdx-oxc18m] .table-row { display: grid; grid-template-columns: 60px 1fr 1fr; border-top: 1px solid #f0f0f0; }\\n  [data-pdx-oxc18m] .col { padding: 8px 12px; font-size: 0.85rem; }\\n  [data-pdx-oxc18m] .pagination { display: flex; align-items: center; gap: 12px; margin-top: 8px; font-size: 0.85rem; }\\n  [data-pdx-oxc18m] .pagination button { padding: 4px 12px; border: 1px solid #e0e0e0; border-radius: 6px; background: white; cursor: pointer; }\\n  [data-pdx-oxc18m] .pagination button:disabled { opacity: 0.4; cursor: not-allowed; }\\n  [data-pdx-oxc18m] .log { font-size: 0.8rem; margin-top: 8px; font-family: monospace; }\\n";
}

component('pdx-demo-datasource', {
  props: {},
  setup(ctx) {
    const __rows = signal([], { name: 'demo-datasource:rows' });
    const __currentPage = signal(1, { name: 'demo-datasource:currentPage' });
    const __totalPages = signal(1, { name: 'demo-datasource:totalPages' });
    const __totalItems = signal(0, { name: 'demo-datasource:totalItems' });
    const __loading = signal(false, { name: 'demo-datasource:loading' });
    const __sortDesc = signal('none', { name: 'demo-datasource:sortDesc' });
    const __filterDesc = signal('none', { name: 'demo-datasource:filterDesc' });
    const __dirty = signal(false, { name: 'demo-datasource:dirty' });
    const __addedCount = signal(0, { name: 'demo-datasource:addedCount' });
    const __updatedCount = signal(0, { name: 'demo-datasource:updatedCount' });
    const __removedCount = signal(0, { name: 'demo-datasource:removedCount' });
// ─── Mock transport (simulates server) ────────────────────────
    var mockDb = [];
    
    for (var i = 1; i <= 53; i++) {
        mockDb.push({ id: i, name: 'User ' + i, email: 'user' + i + '@test.com' });
    }
    
    var mockTransport = {
        read: function(req) {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    var filtered = mockDb;
                    // Filter
                    if (req.filter && req.filter.length > 0) {
                        var f = req.filter[0];
                        if (f.operator === 'contains' && f.field === 'name') {
                            var term = String(f.value).toLowerCase();
                            filtered = filtered.filter(function(u) { return u.name.toLowerCase().indexOf(term) >= 0; });
                        }
                    }
                    // Sort
                    if (req.sort && req.sort.length > 0) {
                        var s = req.sort[0];
                        filtered = filtered.slice().sort(function(a, b) {
                            var va = a[s.field], vb = b[s.field];
                            if (va < vb) return s.dir === 'asc' ? -1 : 1;
                            if (va > vb) return s.dir === 'asc' ? 1 : -1;
                            return 0;
                        });
                    }
                    // Paginate
                    var start = (req.page - 1) * req.pageSize;
                    var page = filtered.slice(start, start + req.pageSize);
                    resolve({ data: page, total: filtered.length });
                }, 150); // simulate network delay
            });
        },
        create: function(item) {
            return new Promise(function(resolve) {
                var newItem = { id: mockDb.length + 1, name: item.name, email: item.email };
                mockDb.push(newItem);
                resolve(newItem);
            });
        },
        destroy: function(item) {
            return new Promise(function(resolve) {
                mockDb = mockDb.filter(function(u) { return u.id !== item.id; });
                resolve();
            });
        },
    };
    
    
    // ─── DataSource ───────────────────────────────────────────────
    var ds = createDataSource({
        transport: mockTransport,
        pageSize: 10,
        autoLoad: true,
    });
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    var currentSortField = '';
    
    var currentSortDir = 'asc';
    
    
    function sortIcon(field) {
        if (currentSortField !== field) return '';
        return currentSortDir === 'asc' ? '↑' : '↓';
    }
    
    function toggleSort(field) {
        if (currentSortField === field) {
            currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
        } else {
            currentSortField = field;
            currentSortDir = 'asc';
        }
        ds.setSort([{ field: field, dir: currentSortDir }]);
        __sortDesc.set(field + ' ' + currentSortDir);
    }
    
    function sortById() { toggleSort('id'); }
    function sortByName() { toggleSort('name'); }
    
    function onFilter(e) {
        var val = e.target.value;
        if (val) {
            ds.setFilter([{ field: 'name', operator: 'contains', value: val }]);
            __filterDesc.set('name contains "' + val + '"');
        } else {
            ds.setFilter([]);
            __filterDesc.set('none');
        }
    }
    
    function prevPage() { ds.setPage(__currentPage() - 1); }
    function nextPage() { ds.setPage(__currentPage() + 1); }
    
    var addN = 100;
    
    function addItem() {
        addN++;
        ds.add({ id: addN, name: 'New User ' + addN, email: 'new' + addN + '@test.com' });
    }
    function syncChanges() { ds.sync(); }
    function cancelAll() { ds.cancelChanges(); }
    onMount(() => {
    var d1 = effect(() => {
        __rows.set(ds.data());
        __currentPage.set(ds.page());
        __totalPages.set(ds.totalPages());
        __totalItems.set(ds.total());
        __loading.set(ds.isLoading());
        __dirty.set(ds.hasChanges());
    });
    var d2 = effect(() => {
        var ch = ds.changes();
        __addedCount.set(ch.added.length);
        __updatedCount.set(ch.updated.length);
        __removedCount.set(ch.removed.length);
    });
    onDestroy(() => { d1(); d2(); ds.dispose(); });
});
    ctx.el.setAttribute('data-pdx-oxc18m', '');
    return { rows: __rows, currentPage: __currentPage, totalPages: __totalPages, totalItems: __totalItems, loading: __loading, sortDesc: __sortDesc, filterDesc: __filterDesc, dirty: __dirty, addedCount: __addedCount, updatedCount: __updatedCount, removedCount: __removedCount, sortIcon, toggleSort, sortById, sortByName, onFilter, prevPage, nextPage, addItem, syncChanges, cancelAll };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>DataSource CRUD</h2>
    <p class="desc">Signal-based data manager with pluggable transport. Server sort/filter/page + change tracking.</p>

    <section>
      <h3>Server-side Pagination + Sort</h3>
      <p class="desc">Mock transport simulates server. Click headers to sort. Use page buttons.</p>
      <div class="controls">
        <input type="text" class="input" placeholder="Filter by name..." @input=\${safeHandler(ctx.onFilter, ctx.el?.tagName?.toLowerCase(), 'input')} />
      </div>
      <div class="table-wrap">
        <div class="table-header">
          <span class="col col-id" @click=\${safeHandler(ctx.sortById, ctx.el?.tagName?.toLowerCase(), 'click')}>ID \${() => ctx.sortIcon('id')}</span>
          <span class="col col-name" @click=\${safeHandler(ctx.sortByName, ctx.el?.tagName?.toLowerCase(), 'click')}>Name \${() => ctx.sortIcon('name')}</span>
          <span class="col col-email">Email</span>
        </div>
        \${eachRow(() => ctx.rows(), 'id', (row) => html\`
          <div class="table-row">
            <span class="col col-id">\${() => row().id}</span>
            <span class="col col-name">\${() => row().name}</span>
            <span class="col col-email">\${() => row().email}</span>
          </div>
        \`)}</div>
      <div class="pagination">
        <button @click=\${safeHandler(ctx.prevPage, ctx.el?.tagName?.toLowerCase(), 'click')} :disabled=\${() => ctx.currentPage() <= 1}>← Prev</button>
        <span>Page \${ctx.currentPage} / \${ctx.totalPages} (\${ctx.totalItems} items)</span>
        <button @click=\${safeHandler(ctx.nextPage, ctx.el?.tagName?.toLowerCase(), 'click')} :disabled=\${() => ctx.currentPage() >= ctx.totalPages()}>Next →</button>
      </div>
      <div class="log">Loading: <strong>\${ctx.loading}</strong> | Sort: <strong>\${ctx.sortDesc}</strong> | Filter: <strong>\${ctx.filterDesc}</strong></div>
    </section>

    <section>
      <h3>Change Tracking</h3>
      <p class="desc">Add/update/remove items locally. Sync pushes to server. Cancel discards.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.addItem, ctx.el?.tagName?.toLowerCase(), 'click')}>+ Add User</button>
        <button @click=\${safeHandler(ctx.syncChanges, ctx.el?.tagName?.toLowerCase(), 'click')} :disabled=\${() => !ctx.dirty()} style="background:#22c55e;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Sync</button>
        <button @click=\${safeHandler(ctx.cancelAll, ctx.el?.tagName?.toLowerCase(), 'click')} :disabled=\${() => !ctx.dirty()} style="background:#666;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Cancel</button>
      </div>
      <div class="log">
        Changes: <strong>added=\${ctx.addedCount}, updated=\${ctx.updatedCount}, removed=\${ctx.removedCount}</strong>
        | Dirty: <strong>\${ctx.dirty}</strong>
      </div>
    </section>
  </div>
\`,
});
"
`;


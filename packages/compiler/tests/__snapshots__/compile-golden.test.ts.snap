exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-dialog/demo-comp-dialog-sizes.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-dialog-sizes', {
  props: {},
  setup(ctx) {
    const __sizeOpen = signal(false, { name: 'demo-comp-dialog-sizes:sizeOpen' });
    const __currentSize = signal('md', { name: 'demo-comp-dialog-sizes:currentSize' });
function openSize(e) {
      __currentSize.set(e.currentTarget.dataset.size || 'md');
      __sizeOpen.set(true);
    }
    
    function closeSizeDialog() { __sizeOpen.set(false); }
    const sizeTitle = computed(() => 'Dialog — ' + __currentSize(), { name: 'demo-comp-dialog-sizes:sizeTitle' });
    return { sizeOpen: __sizeOpen, currentSize: __currentSize, sizeTitle, openSize, closeSizeDialog };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Sizes</h2>
    <p class="pdx-txt-small pdx-ink-muted">5 sizes: sm (360px), md (480px, default), lg (640px), xl (800px), full.</p>
    <div class="btn-row">
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.openSize, ctx.el?.tagName?.toLowerCase(), 'click')} data-size="sm">Small</pdx-button>
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.openSize, ctx.el?.tagName?.toLowerCase(), 'click')} data-size="md">Medium</pdx-button>
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.openSize, ctx.el?.tagName?.toLowerCase(), 'click')} data-size="lg">Large</pdx-button>
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.openSize, ctx.el?.tagName?.toLowerCase(), 'click')} data-size="xl">X-Large</pdx-button>
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.openSize, ctx.el?.tagName?.toLowerCase(), 'click')} data-size="full">Full</pdx-button>
    </div>
    <pdx-dialog :open=\${ctx.sizeOpen} :title=\${ctx.sizeTitle} :size=\${ctx.currentSize} @pdx-close=\${safeHandler(ctx.closeSizeDialog, ctx.el?.tagName?.toLowerCase(), 'pdx-close')}>
      <p>This dialog uses the <strong>\${ctx.currentSize}</strong> size variant.</p>
      <p class="pdx-txt-small pdx-ink-muted" style="margin-top: var(--pdx-space-sm)">
        Resize your browser to see how the dialog adapts responsively.
      </p>
    </pdx-dialog>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-dialog :open="sizeOpen" title="Dialog" size="sm" @pdx-close="close"&gt;
  &lt;p&gt;Content&lt;/p&gt;
&lt;/pdx-dialog&gt;

&lt;!-- size: sm (360px) | md (480px) | lg (640px) | xl (800px) | full --&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


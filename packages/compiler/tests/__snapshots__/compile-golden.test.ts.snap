&lt;pdx-carousel :items="slides"&gt;
  &lt;slot name="slide" let:slide let:index&gt;
    &lt;div class="slide"&gt;
      &lt;pdx-badge variant="outline"&gt;Step {index + 1}&lt;/pdx-badge&gt;
      &lt;h3&gt;{slide.title}&lt;/h3&gt;
      &lt;p&gt;{slide.desc}&lt;/p&gt;
    &lt;/div&gt;
  &lt;/slot&gt;
&lt;/pdx-carousel&gt;</code></pre>
    </details>
  </section>
\`;
  },
});

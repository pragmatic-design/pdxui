const __blk0=staticBlock(staticMarkup(' <div class="demo"> <h2>Overlay System</h2> <p class="desc">Z-stack LIFO, portal, backdrop, Escape dismiss, body scroll lock.</p> <section> <h3>Stack Management</h3> <p class="desc">Push creates a visible overlay. Escape closes the top one. Modal blocks scrolling.</p> <div class="row"> <button class="pdx-primary">Push Tooltip</button> <button class="pdx-primary">Push Dialog (modal)</button> </div> <div class="row"> <button class="pdx-secondary">Pop Tooltip</button> <button class="pdx-secondary">Pop Dialog</button> <button class="pdx-ghost">Pop All Tooltips</button> <button class="pdx-ghost">Pop All Dialogs</button> <button class="pdx-ghost">Pop All</button> </div> <div class="stats"> <span>Count: <strong><!----></strong></span> <span>Modal: <strong><!----></strong></span> <span>Top: <strong><!----></strong></span> </div> <pre class="log"><!----></pre> </section> <section> <h3>Portal</h3> <p class="desc">Render content into document.body. Click to create/remove.</p> <div class="row"> <button class="pdx-primary">Create Portal</button> <button class="pdx-danger">Remove Portal</button> </div> </section> <section> <h3>Backdrop</h3> <p class="desc">Dark overlay. Click backdrop to dismiss. Blur variant adds glassmorphism.</p> <div class="row"> <button class="pdx-primary">Backdrop</button> <button class="pdx-primary">Backdrop + Blur</button> </div> </section> <section> <h3>Bottom Sheet</h3> <p class="desc">Mobile-optimized overlay. Draggable between detent points (50% / 100%). Swipe below threshold to dismiss.</p> <div class="row"> <button class="pdx-primary">Open Bottom Sheet</button> </div> </section> <section> <h3>Nested Overlays</h3> <p class="desc">Opens dialog (modal) then tooltip on top. Escape closes topmost only.</p> <button class="pdx-primary">Open Nested Demo</button> </section> </div> '));

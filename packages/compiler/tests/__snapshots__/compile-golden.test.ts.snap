              <pdx-form-field name="city" label="City" required :error=\${() => ctx.shippingForm.fields.city?.error()} :touched=\${() => ctx.shippingForm.fields.city?.touched()} :warning=\${() => ctx.shippingForm.fields.city?.warning()}>
                <pdx-input name="city" placeholder="City" @pdx-input=\${(e) => ctx.shippingForm.fields.city?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.shippingForm.fields.city?.onBlur()}></pdx-input>
              </pdx-form-field>
              <pdx-form-field name="zip" label="ZIP" required :error=\${() => ctx.shippingForm.fields.zip?.error()} :touched=\${() => ctx.shippingForm.fields.zip?.touched()} :warning=\${() => ctx.shippingForm.fields.zip?.warning()}>
                <pdx-input name="zip" placeholder="ZIP code" @pdx-input=\${(e) => ctx.shippingForm.fields.zip?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.shippingForm.fields.zip?.onBlur()}></pdx-input>
              </pdx-form-field>
            </div>
          </pdx-form>
        </div>
      </div>
    </div>


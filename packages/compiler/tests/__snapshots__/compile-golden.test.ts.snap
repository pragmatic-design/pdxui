exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-split-button/demo-comp-split-button-basic.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-mzuwsj");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-mzuwsj"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-mzuwsj] .event-log { margin-top: var(--pdx-space-sm); padding: var(--pdx-space-xs) var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-sm); }\\n";
}

component('pdx-demo-comp-split-button-basic', {
  props: {},
  setup(ctx) {
    const __splitLog = signal('Click the button or select from dropdown...', { name: 'demo-comp-split-button-basic:splitLog' });
const saveItems = [
      { key: 'save-as', label: 'Save As...', icon: 'file-text' },
      { key: 'save-copy', label: 'Save a Copy', icon: 'copy' },
      { key: 'sep', type: 'separator' },
      { key: 'export', label: 'Export', icon: 'download' },
    ];
    
    
    
    
    function onPrimary() {
      __splitLog.set('pdx-click: primary action (Save)');
    }
    
    function onSelect(e) {
      __splitLog.set('pdx-select: ' + e.detail.key + ' — ' + e.detail.item.label);
    }
    ctx.el.setAttribute('data-pdx-mzuwsj', '');
    return { saveItems, splitLog: __splitLog, onPrimary, onSelect };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click the left side for primary action. Click the arrow for dropdown.</p>
    <div class="demo-row">
      <pdx-split-button label="Save" icon="save" :items=\${() => ctx.saveItems} @pdx-click=\${safeHandler(ctx.onPrimary, ctx.el?.tagName?.toLowerCase(), 'pdx-click')} @pdx-select=\${safeHandler(ctx.onSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')}></pdx-split-button>
    </div>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="split-log">\${ctx.splitLog}</div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-split-button label="Save" icon="save" :items="items"
  @pdx-click="onSave" @pdx-select="onSelect"&gt;
&lt;/pdx-split-button&gt;

// items = [
//   { key: 'save-as', label: 'Save As...', icon: 'file-text' },
//   { key: 'save-copy', label: 'Save a Copy', icon: 'copy' },
//   { key: 'sep', type: 'separator' },
//   { key: 'export', label: 'Export', icon: 'download' },
// ]</code></pre>
    </details>
  </section>
\`,
});
"
`;


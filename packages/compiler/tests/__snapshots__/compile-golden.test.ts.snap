}

component('pdx-demo-infra-focus-trap', {
  props: {},
  setup(ctx) {
    const __trapActive = signal(false, { name: 'demo-infra-focus-trap:trapActive' });
    const __trapLog = signal('', { name: 'demo-infra-focus-trap:trapLog' });
    const __trapContainer = signal(null, { name: 'demo-infra-focus-trap:trapContainer' });
let trapDispose = null;
    
    
    
    
    function activateTrap() {
        const container = __trapContainer();
        if (!container) return;
        __trapActive.set(true);
        trapDispose = focusTrap(container, { initialFocus: 'first', restoreFocus: true });
        __trapLog.set('Trap activated — Tab cycles within the box');
    }
    
    function deactivateTrap() {
        trapDispose?.();
        trapDispose = null;
        __trapActive.set(false);
        __trapLog.set(prev => prev + '\\nTrap deactivated — focus restored');
    }
    ctx.el.setAttribute('data-pdx-qt53ms', '');
    return { trapActive: __trapActive, trapLog: __trapLog, trapDispose, trapContainer: __trapContainer, activateTrap, deactivateTrap };
  },

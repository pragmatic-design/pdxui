  __pdx_style.textContent = "\\n  [data-pdx-g85tm4] .comparison-table { margin-top: var(--pdx-space-md); }\\n  [data-pdx-g85tm4] .cmp-header, [data-pdx-g85tm4] .cmp-row { display: grid; grid-template-columns: 160px 1fr 1fr; gap: var(--pdx-space-sm); padding: var(--pdx-space-xs) var(--pdx-space-sm); font-size: var(--pdx-text-sm); }\\n  [data-pdx-g85tm4] .cmp-header { font-weight: var(--pdx-weight-semibold); border-bottom: 2px solid var(--pdx-color-border); color: var(--pdx-color-muted); font-size: var(--pdx-text-xs); text-transform: uppercase; }\\n  [data-pdx-g85tm4] .cmp-row { border-bottom: 1px solid var(--pdx-color-border); }\\n";

component('pdx-demo-comp-form-validation-modes', {
  props: {},
  setup(ctx) {
// ─── 3. Validation Modes ───
    const blurForm = createForm({
      initialValues: { email: '' },
      validators: { email: [required('Email is required'), email('Invalid email')] },
      validateOn: 'onBlur',
    });
    
    
    const changeForm = createForm({
      initialValues: { email: '' },
      validators: { email: [required('Email is required'), email('Invalid email')] },
      validateOn: 'onChange',
    });
    
    
    const submitForm = createForm({
      initialValues: { email: '' },
      validators: { email: [required('Email is required'), email('Invalid email')] },
      validateOn: 'onSubmit',
    });
    ctx.el.setAttribute('data-pdx-xzcppv', '');
    return { blurForm, changeForm, submitForm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">3. Validation Modes</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>validateOn</code> controls when validation runs: <code>onBlur</code> (default), <code>onChange</code>, or <code>onSubmit</code>.
    </p>

    <div class="demo-grid">
      <div class="demo-card">
        <h3 class="pdx-txt-small pdx-weight-semibold">onBlur (default)</h3>
        <pdx-form :form=\${() => ctx.blurForm}>
          <pdx-form-field name="email" label="Email" required :error=\${() => ctx.blurForm.fields.email?.error()} :touched=\${() => ctx.blurForm.fields.email?.touched()} :warning=\${() => ctx.blurForm.fields.email?.warning()}>
            <pdx-input name="email" placeholder="Validate on blur" @pdx-input=\${(e) => ctx.blurForm.fields.email?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.blurForm.fields.email?.onBlur()}></pdx-input>
          </pdx-form-field>
        </pdx-form>
      </div>

      <div class="demo-card">
        <h3 class="pdx-txt-small pdx-weight-semibold">onChange</h3>
        <pdx-form :form=\${() => ctx.changeForm}>
          <pdx-form-field name="email" label="Email" required :error=\${() => ctx.changeForm.fields.email?.error()} :touched=\${() => ctx.changeForm.fields.email?.touched()} :warning=\${() => ctx.changeForm.fields.email?.warning()}>
            <pdx-input name="email" placeholder="Validate on change" @pdx-input=\${(e) => ctx.changeForm.fields.email?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.changeForm.fields.email?.onBlur()}></pdx-input>
          </pdx-form-field>
        </pdx-form>
      </div>

      <div class="demo-card">
        <h3 class="pdx-txt-small pdx-weight-semibold">onSubmit</h3>
        <pdx-form :form=\${() => ctx.submitForm}>
          <pdx-form-field name="email" label="Email" required :error=\${() => ctx.submitForm.fields.email?.error()} :touched=\${() => ctx.submitForm.fields.email?.touched()} :warning=\${() => ctx.submitForm.fields.email?.warning()}>
            <pdx-input name="email" placeholder="Validate on submit" @pdx-input=\${(e) => ctx.submitForm.fields.email?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.submitForm.fields.email?.onBlur()}></pdx-input>
          </pdx-form-field>
          <button type="submit" class="pdx-btn pdx-primary pdx-sm">Submit</button>
        </pdx-form>
      </div>
    </div>

    <details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>const blurForm = createForm({
  initialValues: { email: '' },
  validators: { email: [required('...'), email('...')] },
  validateOn: 'onBlur',  // default — validates after field loses focus
});

const changeForm = createForm({ ..., validateOn: 'onChange' }); // validates on every keystroke
const submitForm = createForm({ ..., validateOn: 'onSubmit' }); // validates only on form submit</code></pre></details>
  </section>
\`,
});
"
`;


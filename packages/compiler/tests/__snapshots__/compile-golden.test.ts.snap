  __pdx_style.textContent = ".demo-box {\\n  padding: var(--pdx-space-md);\\n  border: 1px solid var(--pdx-color-border);\\n  border-radius: var(--pdx-radius-md);\\n  max-width: 400px;\\n}\\n.result {\\n  margin-top: var(--pdx-space-sm);\\n}\\n.comparison {\\n  display: flex;\\n  gap: var(--pdx-space-lg);\\n  flex-wrap: wrap;\\n}\\n.comparison-col {\\n  flex: 1;\\n  min-width: 200px;\\n  padding: var(--pdx-space-md);\\n  border: 1px solid var(--pdx-color-border);\\n  border-radius: var(--pdx-radius-md);\\n  background: var(--pdx-color-inset);\\n}\\n.comparison-col ul { padding-left: 1.2rem; margin: var(--pdx-space-xs) 0 0; }\\n.comparison-col li { margin-bottom: var(--pdx-space-2xs); }\\n\\n.props-table table { width: 100%; border-collapse: collapse; font-size: var(--pdx-text-sm); }\\n.props-table th { text-align: left; padding: var(--pdx-space-xs) var(--pdx-space-sm); border-bottom: 2px solid var(--pdx-color-border); }\\n.props-table td { padding: var(--pdx-space-xs) var(--pdx-space-sm); border-bottom: 1px solid var(--pdx-color-border); }\\n\\ndetails.source { margin-top: var(--pdx-space-sm); }\\ndetails.source summary { cursor: pointer; font-size: var(--pdx-text-sm); color: var(--pdx-color-muted); user-select: none; }\\ndetails.source pre { margin-top: var(--pdx-space-xs); padding: var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-md); font-size: var(--pdx-text-xs); overflow-x: auto; line-height: 1.5; }";
}

const __blk0=staticBlock(staticMarkup(' <div class="page"> <h1 class="pdx-txt-title">Autocomplete</h1> <p class="pdx-txt-body pdx-ink-muted intro">\\n      Text input with suggestions. Unlike Select, the value is <strong>free text</strong> — the user can type anything.\\n      Supports local arrays, remote DataSource, debounced search, forceSelection, and highlight matching.\\n    </p>  <app-demo-comp-autocomplete-basic class="demo-section"></app-demo-comp-autocomplete-basic>  <app-demo-comp-autocomplete-object-array class="demo-section"></app-demo-comp-autocomplete-object-array>  <app-demo-comp-autocomplete-remote class="demo-section"></app-demo-comp-autocomplete-remote>  <app-demo-comp-autocomplete-force-selection class="demo-section"></app-demo-comp-autocomplete-force-selection>  <app-demo-comp-autocomplete-highlight class="demo-section"></app-demo-comp-autocomplete-highlight>  <app-demo-comp-autocomplete-cascading class="demo-section"></app-demo-comp-autocomplete-cascading>  <app-demo-comp-autocomplete-creatable class="demo-section"></app-demo-comp-autocomplete-creatable>  <app-demo-comp-autocomplete-vs-select class="demo-section"></app-demo-comp-autocomplete-vs-select>  <section> <h2 class="pdx-txt-heading">Slots</h2> <div class="props-table"> <table><thead><tr><th>Slot</th><th>Scope</th><th>Description</th></tr></thead><tbody><tr><td><code>option</code></td><td><code>{ label, value, raw, highlighted, index }</code></td><td>Custom suggestion item.</td></tr></tbody></table> </div> </section>  <section> <h2 class="pdx-txt-heading">Props Reference</h2> <div class="props-table"> <table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody><tr><td><code>suggestions</code></td><td>Array</td><td>[]</td><td>Array of suggestion items (strings or objects).</td></tr><tr><td><code>source</code></td><td>DataSource</td><td>null</td><td>DataSource for remote/local querying.</td></tr><tr><td><code>label-field</code></td><td>String</td><td>label</td><td>Property name for display text (objects).</td></tr><tr><td><code>value-field</code></td><td>String</td><td>value</td><td>Property name for value (objects).</td></tr><tr><td><code>min-length</code></td><td>Number</td><td>1</td><td>Min characters before suggestions appear.</td></tr><tr><td><code>debounce</code></td><td>Number</td><td>200</td><td>Debounce delay (ms) for search.</td></tr><tr><td><code>force-selection</code></td><td>Boolean</td><td>false</td><td>Clear on blur if no match.</td></tr><tr><td><code>highlight</code></td><td>Boolean</td><td>true</td><td>Highlight matching text.</td></tr><tr><td><code>clearable</code></td><td>Boolean</td><td>false</td><td>Show clear button.</td></tr><tr><td><code>max-items</code></td><td>Number</td><td>10</td><td>Max visible suggestions.</td></tr></tbody></table> </div> </section>  <section> <h2 class="pdx-txt-heading">Events</h2> <div class="props-table"> <table><thead><tr><th>Event</th><th>Detail</th><th>Description</th></tr></thead><tbody><tr><td><code>value-change</code></td><td><code>{ value }</code></td><td>Its model: fired when a value is committed — a suggestion chosen, free text confirmed, or the field cleared. <code>value</code> is the suggestion\\'s value field, the string itself for string suggestions; <code>getText()</code> is the text shown and <code>getSelectedItem()</code> the suggestion.</td></tr><tr><td><code>query-change</code></td><td><code>{ value }</code></td><td>Fired on every keystroke, with the text typed: the query, which is not the value.</td></tr><tr><td><code>pdx-clear</code></td><td>—</td><td>Fired when clear button is clicked.</td></tr></tbody></table> </div> </section> </div> '));
component('app-comp-autocomplete', {
  props: {},
  setup(ctx) {
    useHead({ title: "Autocomplete — PDX UI" });

  },

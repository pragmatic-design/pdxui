        <div class="opt-row"><code>precision</code><span>number</span><span>Decimal places (-1 = auto from step)</span></div>
        <div class="opt-row"><code>controls</code><span>string</span><span>'both' (default: −left +right), 'right' (stacked), 'none' (hidden)</span></div>
        <div class="opt-row"><code>allowNegative</code><span>boolean</span><span>Enable sign toggle button (+/−) and keyboard sign</span></div>
        <div class="opt-row"><code>allowWheel</code><span>boolean</span><span>Enable scroll wheel when focused</span></div>

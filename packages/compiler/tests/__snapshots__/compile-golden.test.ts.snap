        const sel = gridSel.selected();
        __gridInfo.setRaw(sel.size > 0 ? 'Selected: ' + [...sel].join(', ') + ' (' + sel.size + ' rows)' : 'No rows selected');
    });
    onDestroy(() => { d1(); d2(); d3(); });
});
    ctx.el.setAttribute('data-pdx-wzxjxl', '');

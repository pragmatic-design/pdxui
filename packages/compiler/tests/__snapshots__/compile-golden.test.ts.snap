  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Composition</h2>
    <p class="pdx-txt-small pdx-ink-muted">Button groups in realistic UI contexts.</p>

    <div class="comp-card">

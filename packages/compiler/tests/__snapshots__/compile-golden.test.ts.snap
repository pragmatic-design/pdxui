exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-overlay-stack/demo-comp-overlay-stack-mixed.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';
import { dialog } from '@pdxui/ui/dialog';
import { toast } from '@pdxui/ui/toast';

component('pdx-demo-comp-overlay-stack-mixed', {
  props: {},
  setup(ctx) {
    const __declOpen = signal(false, { name: 'demo-comp-overlay-stack-mixed:declOpen' });
function openDeclarative() { __declOpen.set(true); }
    function closeDeclarative() { __declOpen.set(false); }
    
    async function onNestedConfirm() {
        const result = await dialog.confirm({
            title: 'Delete Item?',
            message: 'This programmatic confirm sits on top of the declarative dialog.',
            variant: 'danger',
            confirmLabel: 'Delete',
        });
        if (result) {
            toast.success('Item deleted!');
            __declOpen.set(false);
        }
    }
    return { declOpen: __declOpen, openDeclarative, closeDeclarative, onNestedConfirm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Declarative + Programmatic Mix</h2>
    <p class="pdx-txt-small pdx-ink-muted">A declarative <code>&lt;pdx-dialog&gt;</code> with a programmatic <code>dialog.confirm()</code> on top.</p>
    <div class="demo-row">
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.openDeclarative, ctx.el?.tagName?.toLowerCase(), 'click')}>Open Dialog</pdx-button>
    </div>
    <pdx-dialog :open=\${ctx.declOpen} title="Declarative Dialog" size="md">
      <p style="margin:0 0 var(--pdx-space-md)">This dialog is opened via <code>:open</code> binding.</p>
      <p style="margin:0">Click below to open a programmatic confirm on top of this dialog.</p>
      <span slot="footer">
        <pdx-button variant="danger" size="sm" @click=\${safeHandler(ctx.onNestedConfirm, ctx.el?.tagName?.toLowerCase(), 'click')}>Delete (Programmatic)</pdx-button>
        <pdx-button variant="ghost" size="sm" @click=\${safeHandler(ctx.closeDeclarative, ctx.el?.tagName?.toLowerCase(), 'click')}>Close</pdx-button>
      </span>
    </pdx-dialog>
  </section>
\`,
});
"
`;


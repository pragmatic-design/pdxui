exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-segmented/demo-comp-segmented-form.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler } from '@pdxui/core';
import { useSegmentedPeriod } from './state.pdx';

component('pdx-demo-comp-segmented-form', {
  props: {},
  setup(ctx) {
// The object-options control shows and sets the same period (state.pdx.ts).
    const segmentedPeriod = useSegmentedPeriod();
    const period = computed(() => segmentedPeriod.period(), { name: 'demo-comp-segmented-form:period' });
    
    
    function onPeriod(e) { segmentedPeriod.onPeriod(e); }
    
    // pdx-ignore PDX_REPEATED_LOGIC: each form demo shows its whole submit handler, so a reader copies one page and has it all
    function onSubmit(e) {
      e.preventDefault();
      const data = new FormData(e.target);
      alert('Period: ' + data.get('period'));
    }
    return { segmentedPeriod, period, onPeriod, onSubmit };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Form Integration</h2>
    <div class="demo-row">
      <form @submit=\${safeHandler(ctx.onSubmit, ctx.el?.tagName?.toLowerCase(), 'submit')}>
        <pdx-form-field label="Billing period">
          <pdx-segmented label="Billing period" :value=\${ctx.period} options='[{"label":"Monthly","value":"monthly"},{"label":"Yearly","value":"yearly"}]' name="period" @change=\${safeHandler(ctx.onPeriod, ctx.el?.tagName?.toLowerCase(), 'change')}></pdx-segmented>
        </pdx-form-field>
        <button type="submit" class="pdx-primary" style="margin-top:var(--pdx-space-sm)">Submit</button>
      </form>
    </div>
  </section>
\`,
});
"
`;


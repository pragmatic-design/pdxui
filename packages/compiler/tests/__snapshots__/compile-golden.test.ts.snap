ge: \\'Leave without saving them?\\',\\n    confirmLabel: \\'Leave\\', cancelLabel: \\'Stay\\', variant: \\'danger\\',\\n  });\\n  if (leave) preventOpen = false;\\n}</code></pre> </details> </section> '));

  __pdx_style.textContent = "\\n  [data-pdx-p04bg] .page { }\\n  [data-pdx-p04bg] .intro { margin-bottom: var(--pdx-space-xl); }\\n  [data-pdx-p04bg] .section-heading { margin-bottom: var(--pdx-space-sm); }\\n  [data-pdx-p04bg] section { margin-bottom: var(--pdx-space-3xl); }\\n\\n  \\n  [data-pdx-p04bg] .drawer-preview {\\n    margin-top: var(--pdx-space-md);\\n    display: flex;\\n    height: 240px;\\n    border: 1px solid var(--pdx-color-border);\\n    border-radius: var(--pdx-radius-lg);\\n    overflow: hidden;\\n    background: var(--pdx-color-inset);\\n  }\\n\\n  [data-pdx-p04bg] .pdx-drawer {\\n    display: flex;\\n    flex-direction: column;\\n    background: var(--pdx-color-surface);\\n    border-right: 1px solid var(--pdx-color-border);\\n    flex-shrink: 0;\\n  }\\n  [data-pdx-p04bg] .drawer-left { width: 220px; }\\n  [data-pdx-p04bg] .drawer-right {\\n    border-right: none;\\n    border-left: 1px solid var(--pdx-color-border);\\n  }\\n\\n  [data-pdx-p04bg] .pdx-drawer-header {\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    padding: var(--pdx-space-sm) var(--pdx-space-md);\\n    border-bottom: 1px solid var(--pdx-color-border);\\n  }\\n  [data-pdx-p04bg] .pdx-drawer-header h3 { margin: 0; }\\n  [data-pdx-p04bg] .pdx-drawer-body {\\n    flex: 1;\\n    padding: var(--pdx-space-md);\\n    overflow-y: auto;\\n  }\\n  [data-pdx-p04bg] .pdx-drawer-footer {\\n    display: flex;\\n    align-items: center;\\n    gap: var(--pdx-space-sm);\\n    justify-content: flex-end;\\n    padding: var(--pdx-space-sm) var(--pdx-space-md);\\n    border-top: 1px solid var(--pdx-color-border);\\n  }\\n\\n  [data-pdx-p04bg] .drawer-content-area {\\n    flex: 1;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    background: var(--pdx-color-inset);\\n  }\\n\\n  \\n  [data-pdx-p04bg] .source-block {\\n    margin-top: var(--pdx-space-md);\\n    margin-bottom: var(--pdx-space-lg);\\n    border: 1px solid var(--pdx-color-border);\\n    border-radius: var(--pdx-radius-md);\\n    overflow: hidden;\\n  }\\n  [data-pdx-p04bg] .source-block summary {\\n    padding: var(--pdx-space-xs) var(--pdx-space-md);\\n    font-size: var(--pdx-text-xs);\\n    font-weight: var(--pdx-weight-medium);\\n    color: var(--pdx-color-muted);\\n    cursor: pointer;\\n    background: var(--pdx-color-inset);\\n    user-select: none;\\n  }\\n  [data-pdx-p04bg] .source-block pre {\\n    margin: 0;\\n    padding: var(--pdx-space-md);\\n    font-size: var(--pdx-text-xs);\\n    overflow-x: auto;\\n    background: var(--pdx-color-surface);\\n  }\\n\\n  \\n  [data-pdx-p04bg] .options-table { margin-top: var(--pdx-space-md); }\\n  [data-pdx-p04bg] .opt-header, [data-pdx-p04bg] .opt-row {\\n    display: grid;\\n    grid-template-columns: 200px 80px 1fr;\\n    gap: var(--pdx-space-sm);\\n    padding: var(--pdx-space-xs) var(--pdx-space-sm);\\n    font-size: var(--pdx-text-sm);\\n    align-items: center;\\n  }\\n  [data-pdx-p04bg] .opt-header {\\n    font-weight: var(--pdx-weight-semibold);\\n    border-bottom: 2px solid var(--pdx-color-border);\\n    color: var(--pdx-color-muted);\\n    font-size: var(--pdx-text-xs);\\n    text-transform: uppercase;\\n    letter-spacing: 0.04em;\\n  }\\n  [data-pdx-p04bg] .opt-row { border-bottom: 1px solid var(--pdx-color-border); }\\n  [data-pdx-p04bg] .opt-row span { color: var(--pdx-color-muted); }\\n\\n  [data-pdx-p04bg] code {\\n    font-family: var(--pdx-font-mono);\\n    font-size: 0.85em;\\n    padding: 1px 5px;\\n    background: var(--pdx-color-inset);\\n    border-radius: var(--pdx-radius-sm);\\n    color: var(--pdx-color-text);\\n  }\\n";

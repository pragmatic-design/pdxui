import { computed, createGlobalStore, signal } from '@pdxui/core';

const __store_tasks = createGlobalStore('tasks', () => {
    const __filter = signal('all', { name: 'task-store:filter' });
    const ___nextId = signal(7, { name: 'task-store:_nextId' });
function addTask(text, category) {
      const id = ___nextId();
      ___nextId.setRaw(___nextId.peek() + 1);
      __items.setRaw([...__items.peek(), { id, text, category, done: false }]);
    }
    
    function toggleTask(id) {
      __items.setRaw(__items.peek().map(t => t.id === id ? { ...t, done: !t.done } : t));
    }
    
    function removeTask(id) {
      __items.setRaw(__items.peek().filter(t => t.id !== id));
    }
    
    function setFilter(f) {
      __filter.setRaw(f);
    }
    
    function clearDone() {
      __items.setRaw(__items.peek().filter(t => !t.done));
    }
    
    function resetStore() {
      __items.setRaw([
        { id: 1, text: 'Design @form API', category: 'design', done: true },
        { id: 2, text: 'Implement resource() cache', category: 'dev', done: true },
        { id: 3, text: 'Write integration tests', category: 'test', done: false },
        { id: 4, text: 'Fix scoped CSS bug', category: 'dev', done: true },
        { id: 5, text: 'Create showcase demo', category: 'dev', done: false },
        { id: 6, text: 'Review form validation', category: 'test', done: false },
      ]);
      __filter.setRaw('all');
      ___nextId.setRaw(7);
    }
    const __items = signal([
  { id: 1, text: 'Design @form API', category: 'design', done: true },
  { id: 2, text: 'Implement resource() cache', category: 'dev', done: true },
  { id: 3, text: 'Write integration tests', category: 'test', done: false },
  { id: 4, text: 'Fix scoped CSS bug', category: 'dev', done: true },
  { id: 5, text: 'Create showcase demo', category: 'dev', done: false },
  { id: 6, text: 'Review form validation', category: 'test', done: false },
], { name: 'task-store:items' });
    const filtered = computed(() => __filter() === 'all' ? __items()
    : __filter() === 'done' ? __items().filter(t => t.done)
    : __items().filter(t => !t.done), { name: 'task-store:filtered' });
    const stats = computed(() => ({
  total: __items().length,
  done: __items().filter(t => t.done).length,
  pending: __items().filter(t => !t.done).length,
}), { name: 'task-store:stats' });
    return { items: __items, filter: __filter, filtered, stats, addTask, toggleTask, removeTask, setFilter, clearDone, resetStore };
}, { persist: 'local' });

export function useTasks() { return __store_tasks; }

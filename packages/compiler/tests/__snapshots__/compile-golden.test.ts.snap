import { component, html } from '@pdxui/core';

component('pdx-demo-comp-list-rich-item', {
  props: {},
  setup(ctx) {
const richItems = [
      { id: 1, name: 'Alice Johnson', role: 'Frontend', status: 'Active', initials: 'AJ' },

"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler } from '@pdxui/core';
import { useToggleGroupDemo } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-tord7j");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-tord7j"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-tord7j] .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--pdx-space-sm); }\\n  [data-pdx-tord7j] .toolbar-sep { width: 1px; align-self: stretch; background: var(--pdx-color-border); }\\n";
}

component('pdx-demo-comp-toggle-group-composition', {
  props: {},
  setup(ctx) {
// The single and multiple sections show and set the same two values (state.pdx.ts).
    const toggleGroupDemo = useToggleGroupDemo();
    const align = computed(() => toggleGroupDemo.align(), { name: 'demo-comp-toggle-group-composition:align' });
    const formatting = computed(() => toggleGroupDemo.formatting(), { name: 'demo-comp-toggle-group-composition:formatting' });
    
    
    
    function setAlign(v) { toggleGroupDemo.setAlign(v); }
    function setFormatting(v) { toggleGroupDemo.setFormatting(v); }
    function sampleStyle() { return toggleGroupDemo.sampleStyle(); }
    ctx.el.setAttribute('data-pdx-tord7j', '');
    return { toggleGroupDemo, align, formatting, setAlign, setFormatting, sampleStyle };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Composition — an editor toolbar</h2>
    <p class="pdx-txt-small pdx-ink-muted">Two groups in one toolbar: formatting (multiple) and alignment (single).</p>
    <div class="comp-card">
      <div class="toolbar" role="toolbar" aria-label="Text formatting">
        <pdx-toggle-group type="multiple" label="Style" size="sm" :value=\${ctx.formatting} @pdx-change=\${safeHandler(e => ctx.setFormatting(e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}>
          <pdx-toggle value="bold" aria-label="Bold"><strong>B</strong></pdx-toggle>
          <pdx-toggle value="italic" aria-label="Italic"><em>I</em></pdx-toggle>
          <pdx-toggle value="underline" aria-label="Underline"><u>U</u></pdx-toggle>
        </pdx-toggle-group>
        <span class="toolbar-sep" aria-hidden="true"></span>
        <pdx-toggle-group type="single" label="Alignment" size="sm" :value=\${ctx.align} @pdx-change=\${safeHandler(e => ctx.setAlign(e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}>
          <pdx-toggle value="left">Left</pdx-toggle>
          <pdx-toggle value="center">Center</pdx-toggle>
          <pdx-toggle value="right">Right</pdx-toggle>
        </pdx-toggle-group>
      </div>
      <p class="pdx-txt-small sample" :style=\${() => ctx.sampleStyle() + ';text-align:' + (ctx.align() || 'left')}>
        The toolbar and the sections above share their state: press a button here and watch the groups above follow.
      </p>
    </div>
  </section>
\`,
});
"
`;


        </pdx-form-field>

        <pdx-field-group name="customer" label="Customer">
          <pdx-form-field name="customer.name" label="Name" required :error=\${() => ctx.nestedForm.fields['customer.name']?.error()} :touched=\${() => ctx.nestedForm.fields['customer.name']?.touched()} :warning=\${() => ctx.nestedForm.fields['customer.name']?.warning()}>
            <pdx-input name="customer.name" placeholder="Jane Doe" @pdx-input=\${(e) => ctx.nestedForm.fields['customer.name']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.nestedForm.fields['customer.name']?.onBlur()}></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="customer.email" label="Email" required :error=\${() => ctx.nestedForm.fields['customer.email']?.error()} :touched=\${() => ctx.nestedForm.fields['customer.email']?.touched()} :warning=\${() => ctx.nestedForm.fields['customer.email']?.warning()}>
            <pdx-input name="customer.email" type="email" placeholder="jane@test.com" @pdx-input=\${(e) => ctx.nestedForm.fields['customer.email']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.nestedForm.fields['customer.email']?.onBlur()}></pdx-input>
          </pdx-form-field>

"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-block-ui-basic', {
  props: {},
  setup(ctx) {
    const __blocked = signal(false, { name: 'demo-comp-block-ui-basic:blocked' });
function toggleBlock() { __blocked.set(prev => !prev); }
    return { blocked: __blocked, toggleBlock };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">Toggle the blocked state. Content underneath is non-interactive while blocked.</p>
    <div class="demo-actions">
      <button class="pdx-btn pdx-primary pdx-btn-xs" @click=\${safeHandler(ctx.toggleBlock, ctx.el?.tagName?.toLowerCase(), 'click')}>Toggle Block</button>
    </div>
    <div class="demo-wrap">
      <pdx-block-ui :blocked=\${ctx.blocked} id="demo-block">
        <div class="demo-panel">
          <h3>Panel Content</h3>
          <p class="pdx-txt-small pdx-ink-muted">This content is blocked during loading. Buttons are non-clickable.</p>
          <div style="display:flex;gap:8px;margin-top:var(--pdx-space-sm)">
            <button class="pdx-btn pdx-outline pdx-btn-xs">Action A</button>
            <button class="pdx-btn pdx-outline pdx-btn-xs">Action B</button>
            <button class="pdx-btn pdx-primary pdx-btn-xs">Save</button>
          </div>
        </div>
      </pdx-block-ui>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-block-ui :blocked="isLoading"&gt;
  &lt;div class="panel"&gt;
    &lt;p&gt;Content here...&lt;/p&gt;
    &lt;button&gt;Save&lt;/button&gt;
  &lt;/div&gt;
&lt;/pdx-block-ui&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-block-ui/demo-comp-block-ui-delay.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-block-ui-delay', {
  props: {},
  setup(ctx) {
    const __saving = signal(false, { name: 'demo-comp-block-ui-delay:saving' });
function save(ms) {
      __saving.set(true);
      setTimeout(function() { __saving.set(false); }, ms);
    }
    return { saving: __saving, save };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Delay and minimum duration</h2>
    <p class="pdx-txt-small pdx-ink-muted">The input is blocked at once; the overlay is drawn only after <code>delay</code> (300 ms), then kept for at least <code>min-duration</code> (200 ms). A quick save never flashes a spinner, and a slow one does not blink.</p>
    <div class="demo-actions">
      <button class="pdx-btn pdx-outline pdx-btn-xs" @click=\${safeHandler(() => ctx.save(120), ctx.el?.tagName?.toLowerCase(), 'click')}>Save in 120 ms</button>
      <button class="pdx-btn pdx-outline pdx-btn-xs" @click=\${safeHandler(() => ctx.save(350), ctx.el?.tagName?.toLowerCase(), 'click')}>Save in 350 ms</button>
    </div>
    <div class="demo-wrap">
      <pdx-block-ui :blocked=\${ctx.saving} message="Saving…">
        <div class="demo-panel">
          <p class="pdx-txt-small pdx-ink-muted">The first button blocks for less than the delay: nothing is drawn. The second is drawn at 300 ms and stays until 500.</p>
        </div>
      </pdx-block-ui>
    </div>
  </section>
\`,
});
"
`;


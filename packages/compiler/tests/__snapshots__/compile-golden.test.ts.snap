const __blk0=staticBlock(staticMarkup(' <section> <h2 class="pdx-txt-heading section-heading">Why an app needs one</h2> <p class="pdx-txt-small pdx-ink-muted">\\n      A <code>&lt;pdx-dialog&gt;</code> lives in your template, next to the state that opens it. A question asked from\\n      a function — "discard changes?" in a save handler, a confirmation before a delete — has no template to live in.\\n      The service puts it in the queue, and the outlet is the one place in the page that renders it. Mount it\\n      <strong>once</strong>, in the app shell, as the last child of the layout:\\n    </p> <pre class="pdx-txt-mono shell"><code>&lt;!-- app.pdx --&gt;\\n&lt;pdx-app-layout&gt;\\n  …\\n  &lt;pdx-router-outlet&gt;&lt;/pdx-router-outlet&gt;\\n&lt;/pdx-app-layout&gt;\\n&lt;pdx-overlay-outlet&gt;&lt;/pdx-overlay-outlet&gt;</code></pre> <p class="pdx-txt-small pdx-ink-muted">\\n      A form\\'s <code>warnUnsaved</code> guard asks through the same queue, and mounts an outlet itself when the page has none.\\n    </p> </section> '));
component('app-demo-comp-overlay-outlet-why', {
  props: {},
  setup(ctx) {
    ctx.el.setAttribute('data-pdx-w5pbb1', '');


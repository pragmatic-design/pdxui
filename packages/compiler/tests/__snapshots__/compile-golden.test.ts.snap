        focusGroup(__horizontalRef(), {
            selector: '[role="tab"]',
            orientation: 'horizontal',
            wrap: true,
        });
    }

    if (__typeaheadRef()) {
        focusGroup(__typeaheadRef(), {
            selector: '[role="option"]',
            orientation: 'vertical',
            wrap: true,
            typeAhead: true,
        });
    }
});
    ctx.el.setAttribute('data-pdx-4zdqcj', '');
    return { fruits, tabNames, countries, trapActive: __trapActive, trapLog: __trapLog, groupLog: __groupLog, trapDispose, verticalRef: __verticalRef, horizontalRef: __horizontalRef, typeaheadRef: __typeaheadRef, restoreInputRef: __restoreInputRef, restoreLog: __restoreLog, fr, trapContainer: __trapContainer, activateTrap, deactivateTrap, lastTarget, trackTarget, saveFocus, restoreFocus };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Focus Management</h2>
    <p class="desc">Focus trap, focus group (arrow nav + type-ahead), focus restore, tab order.</p>

    <!-- Focus Trap -->
    <section data-test="focus-trap">
      <h3>Focus Trap</h3>
      <p class="desc">Tab cycles within the box. Siblings get aria-hidden.</p>
      <button class="pdx-primary" @click=\${safeHandler(ctx.activateTrap, ctx.el?.tagName?.toLowerCase(), 'click')} data-test="activate-trap">Activate Trap</button>
      <div class="trap-box" :class=\${() => ctx.trapActive() ? 'active' : ''} data-test="trap-container" :ref=\${ctx.trapContainer}>
        <input class="pdx-input" placeholder="Name" data-test="trap-input-1" />
        <input class="pdx-input" placeholder="Email" data-test="trap-input-2" />
        <div class="row">
          <button class="pdx-ghost" data-test="trap-cancel">Cancel</button>
          <button class="pdx-primary" @click=\${safeHandler(ctx.deactivateTrap, ctx.el?.tagName?.toLowerCase(), 'click')} data-test="trap-save">Save & Deactivate</button>
        </div>
      </div>
      <div class="log" data-test="trap-log">\${ctx.trapLog}</div>
    </section>

    <!-- Focus Group Vertical -->
    <section data-test="focus-group">
      <h3>Focus Group — Vertical</h3>
      <p class="desc">Click an item first, then use Arrow Up/Down to navigate, Enter/Space to select. Home/End jump to first/last. Disabled items (Cherry) are skipped.</p>
      <div class="group-list" :ref=\${ctx.verticalRef} data-test="group-vertical">
        \${eachRow(() => ctx.fruits, (fruit) => fruit, (fruit) => html\`
          <div class="group-item" role="option" :aria-disabled=\${() => fruit() === 'Cherry' ? 'true' : null}>
            \${() => fruit()}
          </div>
        \`)}</div>
      <div class="log" data-test="group-log">\${ctx.groupLog}</div>
    </section>

    <!-- Focus Group Horizontal -->
    <section data-test="focus-group-h">
      <h3>Focus Group — Horizontal (Tabs)</h3>
      <p class="desc">Click a tab first, then use Arrow Left/Right to navigate. Wraps around.</p>
      <div class="group-row" :ref=\${ctx.horizontalRef} data-test="group-horizontal">
        \${eachRow(() => ctx.tabNames, (tab) => tab, (tab) => html\`
          <div class="group-item" role="tab">\${() => tab()}</div>
        \`)}</div>
    </section>

    <!-- Type-Ahead -->
    <section data-test="focus-typeahead">
      <h3>Type-Ahead Navigation</h3>
      <p class="desc">Click an item first, then type a letter to jump to matching items. Buffer clears after 500ms.</p>
      <div class="group-list" :ref=\${ctx.typeaheadRef} data-test="group-typeahead">
        \${eachRow(() => ctx.countries, (c) => c, (c) => html\`
          <div class="group-item" role="option">\${() => c()}</div>
        \`)}</div>
    </section>

    <!-- Focus Restore -->
    <section data-test="focus-restore">
      <h3>Focus Restore</h3>
      <p class="desc">1) Click one of the colored buttons to focus it. 2) "Save Focus" saves which button has focus, then moves focus to the input. 3) "Restore Focus" returns to the saved button.</p>
      <div class="row">
        <button class="pdx-primary" data-test="target-a" @click=\${safeHandler(ctx.trackTarget, ctx.el?.tagName?.toLowerCase(), 'click')}>Button A</button>
        <button class="pdx-secondary" data-test="target-b" @click=\${safeHandler(ctx.trackTarget, ctx.el?.tagName?.toLowerCase(), 'click')}>Button B</button>
        <button class="pdx-ghost" data-test="target-c" @click=\${safeHandler(ctx.trackTarget, ctx.el?.tagName?.toLowerCase(), 'click')}>Button C</button>
      </div>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.saveFocus, ctx.el?.tagName?.toLowerCase(), 'click')} data-test="save-focus">Save Focus</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.restoreFocus, ctx.el?.tagName?.toLowerCase(), 'click')} data-test="restore-focus">Restore Focus</button>
        <input class="pdx-input" placeholder="Focus moves here after save..." :ref=\${ctx.restoreInputRef} data-test="other-input" />
      </div>
      <div class="log" data-test="restore-log">\${ctx.restoreLog}</div>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > infra/demo-i18n-mobile.pdx 1`] = `

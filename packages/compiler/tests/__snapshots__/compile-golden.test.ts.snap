                function updateIframePos() {
                    var result = computeFloatingPosition(btn, iframeFloatEl, {
                        placement: 'top',
                        middleware: [offset(8), shift({ padding: 8 })],
                        iframe: iframe,
                    });
                    iframeFloatEl.style.left = result.x + 'px';
                    iframeFloatEl.style.top = result.y + 'px';
                    __iframeLog.setRaw('Positioned at x:' + Math.round(result.x) + ' y:' + Math.round(result.y) + ' — scrolls with page');
                }

                // autoUpdate: re-position on scroll/resize
                iframeAutoUpdateDispose?.();
                iframeAutoUpdateDispose = autoUpdate(iframe, iframeFloatEl, updateIframePos);
            });
        });
    });

    onDestroy(function() {
        iframeAutoUpdateDispose?.();
        if (iframeFloatEl) iframeFloatEl.remove();
    });
});

        </div>
      </div>

      <div class="nested-forms">
        <div class="nested-card">
          <h5 class="pdx-txt-small pdx-weight-medium">Customer Info</h5>
          <pdx-form :form=\${() => ctx.customerForm} name="customer">
            <pdx-form-field name="name" label="Name" required :error=\${() => ctx.customerForm.fields.name?.error()} :touched=\${() => ctx.customerForm.fields.name?.touched()} :warning=\${() => ctx.customerForm.fields.name?.warning()}>
              <pdx-input name="name" placeholder="Customer name" @pdx-input=\${(e) => ctx.customerForm.fields.name?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.customerForm.fields.name?.onBlur()}></pdx-input>
            </pdx-form-field>
            <pdx-form-field name="email" label="Email" required :error=\${() => ctx.customerForm.fields.email?.error()} :touched=\${() => ctx.customerForm.fields.email?.touched()} :warning=\${() => ctx.customerForm.fields.email?.warning()}>
              <pdx-input name="email" type="email" placeholder="Email" @pdx-input=\${(e) => ctx.customerForm.fields.email?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.customerForm.fields.email?.onBlur()}></pdx-input>
            </pdx-form-field>
          </pdx-form>
        </div>

        <div class="nested-card">
          <h5 class="pdx-txt-small pdx-weight-medium">Shipping</h5>
          <pdx-form :form=\${() => ctx.shippingForm} name="shipping">
            <pdx-form-field name="address" label="Address" required :error=\${() => ctx.shippingForm.fields.address?.error()} :touched=\${() => ctx.shippingForm.fields.address?.touched()} :warning=\${() => ctx.shippingForm.fields.address?.warning()}>
              <pdx-input name="address" placeholder="Street address" @pdx-input=\${(e) => ctx.shippingForm.fields.address?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.shippingForm.fields.address?.onBlur()}></pdx-input>
            </pdx-form-field>

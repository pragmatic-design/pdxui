exports[`compile golden — demo corpus > showcase-new/pages/sections/design-spacing/demo-design-spacing-motion.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-7w0gvl");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-7w0gvl"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  \\n  [data-pdx-7w0gvl] .motion-demo { margin-top: var(--pdx-space-md); }\\n  [data-pdx-7w0gvl] .motion-row {\\n    display: flex;\\n    align-items: center;\\n    gap: var(--pdx-space-md);\\n    padding: var(--pdx-space-sm) 0;\\n    border-bottom: 1px solid var(--pdx-color-border);\\n  }\\n  [data-pdx-7w0gvl] .motion-label { min-width: 50px; font-size: var(--pdx-text-xs); }\\n  [data-pdx-7w0gvl] .motion-bar {\\n    height: 24px;\\n    width: 48px;\\n    background: var(--pdx-color-primary);\\n    border-radius: var(--pdx-radius-sm);\\n    transition-property: width;\\n    transition-timing-function: var(--pdx-ease-standard);\\n    cursor: pointer;\\n  }\\n  [data-pdx-7w0gvl] .motion-bar.fast { transition-duration: var(--pdx-duration-fast); }\\n  [data-pdx-7w0gvl] .motion-bar.base { transition-duration: var(--pdx-duration-base); }\\n  [data-pdx-7w0gvl] .motion-bar.slow { transition-duration: var(--pdx-duration-slow); }\\n  [data-pdx-7w0gvl] .motion-bar:hover { width: 200px; }\\n";
}

component('pdx-demo-design-spacing-motion', {
  props: {},
  setup(ctx) {
    ctx.el.setAttribute('data-pdx-7w0gvl', '');
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Motion</h2>
    <p class="pdx-txt-small pdx-ink-muted">Duration and easing tokens for consistent transitions.</p>

    <div class="motion-demo">
      <div class="motion-row">
        <code class="motion-label">fast</code>
        <div class="motion-bar fast"></div>
        <span class="pdx-txt-caption pdx-ink-muted">100ms</span>
      </div>
      <div class="motion-row">
        <code class="motion-label">base</code>
        <div class="motion-bar base"></div>
        <span class="pdx-txt-caption pdx-ink-muted">200ms</span>
      </div>
      <div class="motion-row">
        <code class="motion-label">slow</code>
        <div class="motion-bar slow"></div>
        <span class="pdx-txt-caption pdx-ink-muted">350ms</span>
      </div>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>--pdx-duration-fast: 100ms;
--pdx-duration-base: 200ms;
--pdx-duration-slow: 350ms;

--pdx-ease-standard:   cubic-bezier(0.2, 0, 0, 1);
--pdx-ease-decelerate: cubic-bezier(0, 0, 0, 1);
--pdx-ease-accelerate: cubic-bezier(0.3, 0, 1, 1);

/* Shorthand: */
--pdx-transition: var(--pdx-duration) var(--pdx-ease);
transition: color var(--pdx-transition);</code></pre>
    </details>
  </section>
\`,
});
"
`;


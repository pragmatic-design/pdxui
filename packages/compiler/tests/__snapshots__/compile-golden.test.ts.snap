    return { profileForm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Display modes</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>display="inline"</code> (default) is a fieldset with its legend. <code>panel</code> folds away on a click
      on its legend — <code>collapsed</code> starts it closed. <code>dialog</code> shows a button that opens the fields in a dialog.
      The fields stay in the form whichever way they are shown.
    </p>
    <pdx-form :form=\${() => ctx.profileForm}>
      <div class="form-stack">
        <pdx-form-field name="displayName" label="Display name" :error=\${() => ctx.profileForm.fields.displayName?.error()} :touched=\${() => ctx.profileForm.fields.displayName?.touched()} :warning=\${() => ctx.profileForm.fields.displayName?.warning()}>
          <pdx-input name="displayName" @pdx-input=\${(e) => ctx.profileForm.fields.displayName?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.profileForm.fields.displayName?.onBlur()}></pdx-input>
        </pdx-form-field>
        <pdx-field-group name="contact" label="Contact (panel)" display="panel">
          <div class="form-grid-2">
            <pdx-form-field name="contact.phone" label="Phone" :error=\${() => ctx.profileForm.fields['contact.phone']?.error()} :touched=\${() => ctx.profileForm.fields['contact.phone']?.touched()} :warning=\${() => ctx.profileForm.fields['contact.phone']?.warning()}>
              <pdx-input name="contact.phone" @pdx-input=\${(e) => ctx.profileForm.fields['contact.phone']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.profileForm.fields['contact.phone']?.onBlur()}></pdx-input>
            </pdx-form-field>
            <pdx-form-field name="contact.website" label="Website" :error=\${() => ctx.profileForm.fields['contact.website']?.error()} :touched=\${() => ctx.profileForm.fields['contact.website']?.touched()} :warning=\${() => ctx.profileForm.fields['contact.website']?.warning()}>
              <pdx-input name="contact.website" @pdx-input=\${(e) => ctx.profileForm.fields['contact.website']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.profileForm.fields['contact.website']?.onBlur()}></pdx-input>
            </pdx-form-field>
          </div>
        </pdx-field-group>

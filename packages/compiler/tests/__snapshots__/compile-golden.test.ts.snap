exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-date-picker/demo-comp-date-picker-highlighted.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

component('pdx-demo-comp-date-picker-highlighted', {
  props: {},
  setup(ctx) {
function highlightFn(iso) {
      const d = parseInt(iso.split('-')[2]);
      return d === 5 || d === 15 || d === 25 ? 'event' : false;
    }
    return { highlightFn };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Highlighted Dates</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Mark specific dates with a dot indicator via <code>highlightedDates</code> callback.
      The standalone calendar below highlights the 5th, 15th, and 25th of each month.
    </p>

    <div class="demo-row">
      <pdx-calendar inline :highlighted-dates=\${() => ctx.highlightFn}></pdx-calendar>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-calendar inline :highlightedDates="highlightFn"&gt;&lt;/pdx-calendar&gt;

// highlightFn = (iso) =&gt; {
//   const d = parseInt(iso.split('-')[2]);
//   return d === 5 || d === 15 || d === 25 ? 'event' : false;
// }</code></pre>
    </details>
  </section>
\`,
});
"
`;


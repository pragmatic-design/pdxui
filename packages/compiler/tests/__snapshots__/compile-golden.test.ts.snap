============================================================
import { component, direction, effect, getComponentString, html, injectSafeAreaCSS, isRTL, onDestroy, onMount, registerComponentStrings, safeHandler, setComponentStrings, setDirection, setLocaleStrings, signal, useBottomSheet, useSafeArea } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-y860fw");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-y860fw"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-y860fw] .demo { max-width: 600px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-y860fw] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-y860fw] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-y860fw] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-y860fw] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-y860fw] .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\\n  [data-pdx-y860fw] .mock-select { margin-top: 12px; padding: 12px; border: 1px solid #e0e0e0; border-radius: 8px; display: flex; flex-direction: column; gap: 4px; }\\n  [data-pdx-y860fw] .placeholder { color: #999; font-size: 0.9rem; }\\n  [data-pdx-y860fw] .no-results { color: #999; font-size: 0.8rem; font-style: italic; }\\n  [data-pdx-y860fw] .log { font-size: 0.8rem; margin-top: 8px; font-family: monospace; }\\n  [data-pdx-y860fw] .rtl-box { display: flex; align-items: center; gap: 12px; padding: 14px; border: 1px solid #e0e0e0; border-radius: 8px; margin-top: 8px; }\\n  [data-pdx-y860fw] .icon { font-size: 1.2rem; }\\n  [data-pdx-y860fw] .action { margin-inline-start: auto; font-size: 1.2rem; }\\n  [data-pdx-y860fw] .sheet { background: white; border-radius: 16px 16px 0 0; box-shadow: 0 -4px 24px rgba(0,0,0,0.15); overflow: hidden; }\\n  [data-pdx-y860fw] .sheet-handle { width: 40px; height: 5px; background: #d0d0d0; border-radius: 3px; margin: 10px auto; cursor: grab; }\\n  [data-pdx-y860fw] .sheet-content { padding: 16px 24px 32px; }\\n  [data-pdx-y860fw] .sheet-content h4 { margin: 0 0 8px; }\\n  [data-pdx-y860fw] .sheet-content p { margin: 0 0 8px; font-size: 0.9rem; color: #666; }\\n";
}

component('pdx-demo-i18n-mobile', {
  props: {},
  setup(ctx) {
    const __selectPlaceholder = signal('Select...', { name: 'demo-i18n-mobile:selectPlaceholder' });
    const __selectNoResults = signal('No results found', { name: 'demo-i18n-mobile:selectNoResults' });
    const __dir = signal('ltr', { name: 'demo-i18n-mobile:dir' });
    const __rtl = signal(false, { name: 'demo-i18n-mobile:rtl' });
    const __sheetRef = signal(null, { name: 'demo-i18n-mobile:sheetRef' });
    const __sheetHeight = signal(0, { name: 'demo-i18n-mobile:sheetHeight' });
    const __sheetDetent = signal(0, { name: 'demo-i18n-mobile:sheetDetent' });
    const __safeTop = signal(0, { name: 'demo-i18n-mobile:safeTop' });
    const __safeRight = signal(0, { name: 'demo-i18n-mobile:safeRight' });
    const __safeBottom = signal(0, { name: 'demo-i18n-mobile:safeBottom' });
    const __safeLeft = signal(0, { name: 'demo-i18n-mobile:safeLeft' });
    const __hasInsets = signal(false, { name: 'demo-i18n-mobile:hasInsets' });
// ─── i18n: Component Strings ──────────────────────────────────
    registerComponentStrings('select', {
        placeholder: 'Select...',
        noResults: 'No results found',
    });
    
    
    
    
    
    
    
    var phSignal = getComponentString('select', 'placeholder');
    
    var nrSignal = getComponentString('select', 'noResults');
    
    
    function setEnglish() {
        setComponentStrings('select', { placeholder: 'Select...', noResults: 'No results found' });
        setDirection('ltr');
    }
    function setItalian() {
        setComponentStrings('select', { placeholder: 'Seleziona...', noResults: 'Nessun risultato' });
        setDirection('ltr');
    }
    function setArabic() {
        setComponentStrings('select', { placeholder: 'اختر...', noResults: 'لا توجد نتائج' });
        setDirection('rtl');
    }
    
    // ─── Bottom Sheet ─────────────────────────────────────────────
    
    
    
    
    var sheet = useBottomSheet(() => __sheetRef(), {
        detents: [0.25, 0.5, 1],
        onDetentChange: function(d) { __sheetDetent.set(Math.round(d * 100)); },
        onClose: function() { __sheetDetent.set(0); },
    });
    
    
    function openSheet() { sheet.open(1); }
    function closeSheet() { sheet.close(); }
    
    // ─── Safe Area ────────────────────────────────────────────────
    
    
    
    
    
    
    injectSafeAreaCSS();
    
    var sa = useSafeArea();
    onMount(() => {
    var d1 = effect(() => {
        __selectPlaceholder.set(phSignal());
        __selectNoResults.set(nrSignal());
        __dir.set(direction());
        __rtl.set(isRTL());
    });
    var d2 = effect(() => {
        __sheetHeight.set(Math.round(sheet.height()));
    });
    var d3 = effect(() => {
        var insets = sa.insets();
        __safeTop.set(insets.top);
        __safeRight.set(insets.right);
        __safeBottom.set(insets.bottom);
        __safeLeft.set(insets.left);
        __hasInsets.set(sa.hasInsets());
    });
    onDestroy(() => { d1(); d2(); d3(); sheet.dispose(); });
});
    ctx.el.setAttribute('data-pdx-y860fw', '');
    return { selectPlaceholder: __selectPlaceholder, selectNoResults: __selectNoResults, dir: __dir, rtl: __rtl, setEnglish, setItalian, setArabic, sheetRef: __sheetRef, sheetHeight: __sheetHeight, sheetDetent: __sheetDetent, openSheet, closeSheet, safeTop: __safeTop, safeRight: __safeRight, safeBottom: __safeBottom, safeLeft: __safeLeft, hasInsets: __hasInsets };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>i18n + Mobile</h2>
    <p class="desc">Component strings, RTL, Bottom Sheet, Pull-to-Refresh, Safe Area.</p>

    <!-- i18n: Component Strings -->
    <section>
      <h3>Component String Registry</h3>
      <p class="desc">Translatable default strings for components. Switch locale to see changes.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.setEnglish, ctx.el?.tagName?.toLowerCase(), 'click')}>English</button>
        <button @click=\${safeHandler(ctx.setItalian, ctx.el?.tagName?.toLowerCase(), 'click')} style="background:#22c55e;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Italiano</button>
        <button @click=\${safeHandler(ctx.setArabic, ctx.el?.tagName?.toLowerCase(), 'click')} style="background:#f59e0b;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">العربية (RTL)</button>
      </div>
      <div class="mock-select">
        <span class="placeholder">\${ctx.selectPlaceholder}</span>
        <span class="no-results">\${ctx.selectNoResults}</span>
      </div>
      <div class="log">Direction: <strong>\${ctx.dir}</strong> | RTL: <strong>\${ctx.rtl}</strong></div>
    </section>

    <!-- RTL -->
    <section>
      <h3>RTL Layout</h3>
      <p class="desc">The box below respects direction. Text alignment and icon position flip.</p>
      <div class="rtl-box" :style=\${() => 'direction:' + ctx.dir()}>
        <span class="icon">📌</span>
        <span>This text follows \${ctx.dir} direction</span>
        <span class="action">→</span>
      </div>
    </section>

    <!-- Bottom Sheet -->
    <section>
      <h3>Bottom Sheet</h3>
      <p class="desc">Drag the handle to resize. Snap to 25%, 50%, 100%. Swipe down to close.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.openSheet, ctx.el?.tagName?.toLowerCase(), 'click')}>Open Bottom Sheet</button>
      </div>
    </section>
    <div class="sheet" :ref=\${ctx.sheetRef}>
      <div class="sheet-handle"></div>
      <div class="sheet-content">
        <h4>Bottom Sheet Content</h4>
        <p>Drag the handle bar above to resize. Detents: 25%, 50%, 100%.</p>
        <p>Height: \${ctx.sheetHeight}px | Detent: \${ctx.sheetDetent}</p>
        <button @click=\${safeHandler(ctx.closeSheet, ctx.el?.tagName?.toLowerCase(), 'click')}>Close</button>
      </div>
    </div>

    <!-- Safe Area -->
    <section>
      <h3>Safe Area Insets</h3>
      <p class="desc">Reads env(safe-area-inset-*). On desktop these are 0. On mobile devices with notch, they show real values.</p>
      <div class="log">
        Top: <strong>\${ctx.safeTop}</strong>px |
        Right: <strong>\${ctx.safeRight}</strong>px |
        Bottom: <strong>\${ctx.safeBottom}</strong>px |
        Left: <strong>\${ctx.safeLeft}</strong>px |
        Has insets: <strong>\${ctx.hasInsets}</strong>
      </div>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > infra/demo-icons.pdx 1`] = `
"// 0 warning(s)

============================================================
import { clearIconSets, component, eachRow, html, onMount, registerIconSet, resolveIcon, safeHandler, signal } from '@pdxui/core';
import '../../../ui/src/icon/pdx-icon';

{
  let __pdx_style = document.getElementById("pdx-s-qdg92d");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-qdg92d"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-qdg92d] .demo { max-width: 800px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-qdg92d] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-qdg92d] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-qdg92d] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-qdg92d] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-qdg92d] .row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }\\n  [data-pdx-qdg92d] .result { font-size: 0.9rem; padding: 8px; background: #f5f5f7; border-radius: 6px; }\\n  [data-pdx-qdg92d] .size-row { display: flex; align-items: center; gap: 24px; margin-top: 8px; }\\n  [data-pdx-qdg92d] .size-item { display: flex; flex-direction: column; align-items: center; gap: 6px; }\\n  [data-pdx-qdg92d] .size-label { font-size: 0.7rem; color: #888; }\\n  [data-pdx-qdg92d] .icon-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 8px; margin-top: 8px; }\\n  [data-pdx-qdg92d] .icon-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 12px 8px; border: 1px solid #e0e0e0; border-radius: 6px; }\\n  [data-pdx-qdg92d] .icon-cell:hover { background: #f5f5f7; }\\n  [data-pdx-qdg92d] .icon-name { font-size: 0.7rem; color: #666; }\\n  [data-pdx-qdg92d] .color-row { display: flex; gap: 20px; align-items: center; margin-top: 8px; }\\n  [data-pdx-qdg92d] .wc-grid { display: flex; gap: 24px; align-items: flex-end; margin-top: 8px; }\\n  [data-pdx-qdg92d] .wc-item { display: flex; flex-direction: column; align-items: center; gap: 6px; }\\n";
}

component('pdx-demo-icons', {
  props: {},
  setup(ctx) {
    const __resultText = signal('Icon set registered', { name: 'demo-icons:resultText' });
const ICONS = {
        check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>',
        x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
        plus: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>',
        search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>',
        star: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
        heart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>',
        home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
        user: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
        settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/></svg>',
        bell: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>',
        mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>',
    };
    
    
    const iconNames = Object.keys(ICONS);
    
    const sizeList = [
        { name: 'xs', px: 12 }, { name: 'sm', px: 16 }, { name: 'md', px: 20 },
        { name: 'lg', px: 24 }, { name: 'xl', px: 32 },
    ];
    
    
    // Pre-create refs for each icon and color
    const iconEntries = iconNames.map(name => ({ name, ref: signal(null) }));
    
    const colorList = ['#3b82f6', '#ef4444', '#22c55e', '#f59e0b', '#888'];
    
    const colors = colorList.map(color => ({ color, ref: signal(null) }));
    
    
    
    
    // Register immediately so <pdx-icon> can resolve during mount
    registerIconSet('demo', (name) => ICONS[name] || null);
    
    __resultText.set('Set "demo" registered with ' + iconNames.length + ' icons');
    
    
    function doRegister() {
        clearIconSets();
        registerIconSet('demo', (name) => ICONS[name] || null);
        __resultText.set('Set "demo" re-registered with ' + iconNames.length + ' icons');
    }
    
    async function doResolve() {
        const result = await resolveIcon('check');
        __resultText.set(result ? 'Resolved "check" OK' : 'Not found — register first');
    }
    
    async function doMissing() {
        const result = await resolveIcon('nonexistent');
        __resultText.set(result ? 'Found (unexpected)' : 'null — icon not in set (expected)');
    }
    onMount(() => {
    doRegister();
    // Inject SVG into grid cells and color spans via refs
    requestAnimationFrame(() => {
        for (const entry of iconEntries) {
            const el = entry.ref.peek();
            if (el) {
                const svgHtml = ICONS[entry.name];
                const wrapper = document.createElement('span');
                wrapper.style.cssText = 'display:inline-flex;width:24px;height:24px';
                wrapper.innerHTML = svgHtml;
                el.insertBefore(wrapper, el.firstChild);
            }
        }
        for (const c of colors) {
            const el = c.ref.peek();
            if (el) {
                const wrapper = document.createElement('span');
                wrapper.style.cssText = 'display:inline-flex;width:28px;height:28px';
                wrapper.innerHTML = ICONS.heart;
                el.appendChild(wrapper);
            }
        }
    });
});
    ctx.el.setAttribute('data-pdx-qdg92d', '');
    return { ICONS, iconNames, sizeList, iconEntries, colorList, colors, resultText: __resultText, doRegister, doResolve, doMissing };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Icon System</h2>
    <p class="desc">Agnostic registry: qualsiasi set SVG. Sizing consistente. ARIA-aware.</p>

    <section>
      <h3>Icon Registry</h3>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.doRegister, ctx.el?.tagName?.toLowerCase(), 'click')}>Register "demo" set</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.doResolve, ctx.el?.tagName?.toLowerCase(), 'click')}>Resolve "check"</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.doMissing, ctx.el?.tagName?.toLowerCase(), 'click')}>Resolve "missing"</button>
      </div>
      <div class="result">\${ctx.resultText}</div>
    </section>

    <section>
      <h3>Consistent Sizing</h3>
      <p class="desc">xs(12px) sm(16px) md(20px) lg(24px) xl(32px)</p>
      <div class="size-row">
        \${eachRow(() => ctx.sizeList, 'name', (s) => html\`
          <div class="size-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" :style=\${() => 'width:' + s().px + 'px;height:' + s().px + 'px'}>
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
            <span class="size-label">\${() => s().name} (\${() => s().px}px)</span>
          </div>
        \`)}</div>
    </section>

    <section>
      <h3>All Demo Icons</h3>
      <div class="icon-grid">
        \${eachRow(() => ctx.iconEntries, 'name', (entry) => html\`
          <div class="icon-cell" :ref=\${entry().ref}>
            <span class="icon-name">\${() => entry().name}</span>
          </div>
        \`)}</div>
    </section>

    <section>
      <h3>&lt;pdx-icon&gt; Component</h3>
      <p class="desc">Web Component with name/set/svg/src/size/label props. Sizing via CSS custom properties. ARIA-aware.</p>
      <div class="wc-grid">
        <div class="wc-item">
          <pdx-icon name="check" size="xs"></pdx-icon>
          <span class="size-label">xs (12px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="star" size="sm"></pdx-icon>
          <span class="size-label">sm (16px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="heart" size="md"></pdx-icon>
          <span class="size-label">md (20px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="home" size="lg"></pdx-icon>
          <span class="size-label">lg (24px)</span>
        </div>
        <div class="wc-item">
          <pdx-icon name="bell" size="xl"></pdx-icon>
          <span class="size-label">xl (32px)</span>
        </div>
      </div>
      <div class="row" style="margin-top:12px">
        <span style="color:#3b82f6"><pdx-icon name="heart" size="lg"></pdx-icon></span>
        <span style="color:#ef4444"><pdx-icon name="heart" size="lg"></pdx-icon></span>
        <span style="color:#22c55e"><pdx-icon name="heart" size="lg"></pdx-icon></span>
        <span class="size-label" style="align-self:center">Color inheritance via currentColor</span>
      </div>
      <div class="row" style="margin-top:8px">
        <pdx-icon name="star" size="lg" label="Favorite"></pdx-icon>
        <span class="size-label" style="align-self:center">Semantic (role="img" + aria-label="Favorite")</span>
      </div>
      <div class="row">
        <pdx-icon name="star" size="lg"></pdx-icon>
        <span class="size-label" style="align-self:center">Decorative (aria-hidden="true")</span>
      </div>
    </section>

    <section>
      <h3>Color Inheritance</h3>
      <p class="desc">Icons inherit color from parent via currentColor.</p>
      <div class="color-row">
        \${eachRow(() => ctx.colors, 'color', (c) => html\`
          <span :style=\${() => 'color:' + c().color} :ref=\${c().ref}></span>
        \`)}</div>
    </section>
  </div>
\`,
});

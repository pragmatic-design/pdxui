"// 0 warning(s)

============================================================
import { component, createSelection, eachRow, effect, html, onDestroy, onMount, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-wzxjxl");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-wzxjxl"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-wzxjxl] .demo { max-width: 800px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-wzxjxl] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-wzxjxl] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-wzxjxl] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-wzxjxl] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-wzxjxl] .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 8px; }\\n  [data-pdx-wzxjxl] .list { display: flex; flex-direction: column; gap: 4px; }\\n  [data-pdx-wzxjxl] .row { display: flex; gap: 8px; margin-top: 8px; }\\n  [data-pdx-wzxjxl] .item { padding: 8px 12px; border: 1px solid #e0e0e0; border-radius: 4px; cursor: pointer; font-size: 0.85rem; user-select: none; -webkit-user-select: none; transition: all 150ms; }\\n  [data-pdx-wzxjxl] .item:hover { background: #f5f5f7; }\\n  [data-pdx-wzxjxl] .item.selected { background: #3b82f6; color: white; border-color: #3b82f6; }\\n  [data-pdx-wzxjxl] .item.disabled { opacity: 0.4; cursor: not-allowed; }\\n  [data-pdx-wzxjxl] .grid-table { width: 100%; font-size: 0.85rem; margin-top: 8px; }\\n  [data-pdx-wzxjxl] .grid-header, [data-pdx-wzxjxl] .grid-row { display: grid; grid-template-columns: 36px 1fr 1fr 1fr; align-items: center; border-bottom: 1px solid #e0e0e0; }\\n  [data-pdx-wzxjxl] .grid-header { background: #f5f5f7; font-weight: 600; }\\n  [data-pdx-wzxjxl] .grid-header span, [data-pdx-wzxjxl] .grid-row span { padding: 8px 12px; }\\n  [data-pdx-wzxjxl] .grid-row:hover { background: #f5f8ff; }\\n  [data-pdx-wzxjxl] .grid-row.selected { background: #eff6ff; }\\n  [data-pdx-wzxjxl] .grid-header, [data-pdx-wzxjxl] .grid-row { user-select: none; }\\n  [data-pdx-wzxjxl] .log { font-family: monospace; font-size: 0.75rem; background: #f5f5f7; padding: 8px; border-radius: 6px; white-space: pre-wrap; min-height: 36px; margin: 8px 0 0; }\\n";
}

component('pdx-demo-selection', {
  props: {},
  setup(ctx) {
    const __singleInfo = signal('Nothing selected', { name: 'demo-selection:singleInfo' });
    const __multiInfo = signal('Nothing selected', { name: 'demo-selection:multiInfo' });
const fruits = ['Apple', 'Banana', 'Cherry', 'Date', 'Elderberry', 'Fig', 'Grape'];
    
    const enabledFruits = fruits.filter(f => f !== 'Cherry');
    
    const people = [
        { id: 'p1', name: 'Alice Johnson', role: 'Engineer', status: 'Active' },
        { id: 'p2', name: 'Bob Smith', role: 'Designer', status: 'Active' },
        { id: 'p3', name: 'Carol Davis', role: 'Manager', status: 'Away' },
        { id: 'p4', name: 'Dave Wilson', role: 'Engineer', status: 'Active' },
        { id: 'p5', name: 'Eve Brown', role: 'QA', status: 'Active' },
    ];
    
    const allPeopleKeys = people.map(p => p.id);
    
    
    
    
    
    
    // Single
    const singleSel = createSelection({ mode: 'single', behavior: 'replace' });
    
    // Multiple
    const multiSel = createSelection({
        mode: 'multiple', behavior: 'toggle',
        disabledKeys: () => new Set(['Cherry']),
    });
    
    // Grid
    const gridSel = createSelection({ mode: 'multiple', behavior: 'toggle' });
    
    
    // Reactive class helpers — read selection signal inside a function so the
    // template effect tracks changes. Direct isSelected() calls on the selection
    // object would be transformed incorrectly by the compiler's callSignals pass
    // (it adds () to ctx.singleSel, treating the object as a signal).
    function singleClass(fruit) { return singleSel.selected().has(fruit) ? 'selected' : ''; }
    function multiClass(fruit) {
        const sel = multiSel.selected().has(fruit) ? 'selected ' : '';
        return sel + (fruit === 'Cherry' ? 'disabled' : '');
    }
    function gridClass(id) { return gridSel.selected().has(id) ? 'selected' : ''; }
    function gridIsSelected(id) { return gridSel.selected().has(id); }
    
    
    
    // Event handlers as simple functions — no inline arrows in template.
    // The compiler double-wraps arrow expressions like (e) => fn(e) into
    // () => (e) => fn(e), losing the event object. Using simple function
    // names + data attributes avoids this.
    
    function handleMultiClick(e) {
        const fruit = e.currentTarget.textContent.trim();
        if (fruit === 'Cherry') return;
        if (e.shiftKey) multiSel.extendTo(fruit, fruits);
        else multiSel.toggle(fruit);
    }
    
    function handleGridClick(e) {
        if (e.target.type === 'checkbox') return;
        const row = e.currentTarget;
        const rows = [...row.parentElement.querySelectorAll('.grid-row')];
        const idx = rows.indexOf(row);
        if (idx < 0 || idx >= people.length) return;
        const id = people[idx].id;
        if (e.shiftKey) gridSel.extendTo(id, allPeopleKeys);
        else gridSel.toggle(id);
    }
    
    function handleCheckAll(e) {
        if (e.target.checked) gridSel.selectAll(allPeopleKeys);
        else gridSel.clear();
    }
    const __gridInfo = signal('No rows selected', { name: 'demo-selection:gridInfo' });
    onMount(() => {
    const d1 = effect(() => {
        const sel = singleSel.selected();
        __singleInfo.set(sel.size > 0 ? 'Selected: ' + [...sel].join(', ') : 'Nothing selected');
    });
    const d2 = effect(() => {
        const sel = multiSel.selected();
        __multiInfo.set(sel.size > 0
            ? 'Selected (' + sel.size + '): ' + [...sel].join(', ') + '\\nAnchor: ' + multiSel.anchor()
            : 'Nothing selected');
    });
    const d3 = effect(() => {
        const sel = gridSel.selected();
        __gridInfo.set(sel.size > 0 ? 'Selected: ' + [...sel].join(', ') + ' (' + sel.size + ' rows)' : 'No rows selected');
    });
    onDestroy(() => { d1(); d2(); d3(); });
});
    ctx.el.setAttribute('data-pdx-wzxjxl', '');
    return { fruits, enabledFruits, people, allPeopleKeys, singleInfo: __singleInfo, multiInfo: __multiInfo, gridInfo: __gridInfo, singleSel, multiSel, gridSel, singleClass, multiClass, gridClass, gridIsSelected, handleMultiClick, handleGridClick, handleCheckAll };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Selection Model</h2>
    <p class="desc">Key-based: single/multiple, toggle/replace, range select (Shift+Click), disabled keys.</p>

    <section>
      <h3>Single Select (replace)</h3>
      <p class="desc">Click an item. Previous selection is replaced.</p>
      <div class="two-col">
        <div class="list">
          \${eachRow(() => ctx.fruits, (fruit) => fruit, (fruit) => html\`
            <div class="item" :class=\${() => ctx.singleClass(fruit())} @click=\${safeHandler(() => ctx.singleSel.select(fruit()), ctx.el?.tagName?.toLowerCase(), 'click')}>\${() => fruit()}</div>
          \`)}</div>
        <pre class="log">\${ctx.singleInfo}</pre>
      </div>
    </section>

    <section>
      <h3>Multiple Select (toggle + range)</h3>
      <p class="desc">Click toggles. Shift+Click for range. "Cherry" is disabled.</p>
      <div class="two-col">
        <div>
          <div class="list">
            \${eachRow(() => ctx.fruits, (fruit) => fruit, (fruit) => html\`
              <div class="item"
                :class=\${() => ctx.multiClass(fruit())}
                @click=\${safeHandler(ctx.handleMultiClick, ctx.el?.tagName?.toLowerCase(), 'click')}>\${() => fruit()}</div>
            \`)}</div>
          <div class="row">
            <button class="pdx-ghost" @click=\${safeHandler(() => ctx.multiSel.selectAll(ctx.enabledFruits), ctx.el?.tagName?.toLowerCase(), 'click')}>Select All</button>
            <button class="pdx-ghost" @click=\${safeHandler(() => ctx.multiSel.clear(), ctx.el?.tagName?.toLowerCase(), 'click')}>Clear</button>
          </div>
        </div>
        <pre class="log">\${ctx.multiInfo}</pre>
      </div>
    </section>

    <section>
      <h3>Grid Selection</h3>
      <p class="desc">Click rows. Shift+Click for range. Checkbox header selects all.</p>
      <div class="grid-table">
        <div class="grid-header">
          <span class="grid-cell-ck"><input type="checkbox" @change=\${safeHandler(ctx.handleCheckAll, ctx.el?.tagName?.toLowerCase(), 'change')} /></span>
          <span class="grid-cell-name"><strong>Name</strong></span>
          <span class="grid-cell-role"><strong>Role</strong></span>
          <span class="grid-cell-status"><strong>Status</strong></span>
        </div>
        \${eachRow(() => ctx.people, 'id', (p) => html\`
          <div class="grid-row" :class=\${() => ctx.gridClass(p().id)} @click=\${safeHandler(ctx.handleGridClick, ctx.el?.tagName?.toLowerCase(), 'click')} style="cursor:pointer">
            <span class="grid-cell-ck"><input type="checkbox" :checked=\${() => ctx.gridIsSelected(p().id)} /></span>
            <span class="grid-cell-name">\${() => p().name}</span>
            <span class="grid-cell-role">\${() => p().role}</span>
            <span class="grid-cell-status">\${() => p().status}</span>
          </div>
        \`)}</div>
      <pre class="log">\${ctx.gridInfo}</pre>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > infra/demo-sortable.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, eachRow, effect, html, onDestroy, onMount, signal, useSortable } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-qui0xl");

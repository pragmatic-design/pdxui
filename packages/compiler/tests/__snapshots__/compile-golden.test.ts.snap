component('app-demo-comp-description-list-custom-value', {
  props: {},
  setup(ctx) {
const customItems = [
      { label: 'Name', value: 'Alice Johnson' },
      { label: 'Status', value: 'Active', type: 'badge-success' },
      { label: 'Website', value: 'https://example.com', type: 'link' },
      { label: 'Tags', value: 'admin,editor,viewer', type: 'tags' },
      { label: 'Progress', value: '75', type: 'progress' },
    ];
    
    
    function renderCustomValue(item) {
      if (item.type === 'badge-success') {
        const span = document.createElement('span');
        span.style.cssText = 'display:inline-flex;padding:2px 10px;border-radius:9999px;font-size:0.75rem;font-weight:600;background:var(--pdx-color-success);color:#fff';
        span.textContent = item.value;
        return span;
      }
      if (item.type === 'link') {
        const a = document.createElement('a');
        a.href = '#';
        a.style.color = 'var(--pdx-color-primary)';
        a.textContent = item.value;
        return a;
      }
      if (item.type === 'tags') {
        const div = document.createElement('div');
        div.style.cssText = 'display:flex;gap:4px;flex-wrap:wrap';
        item.value.split(',').forEach(function(tag) {
          const chip = document.createElement('pdx-chip');
          chip.setAttribute('label', tag.trim());
          chip.setAttribute('size', 'sm');
          div.appendChild(chip);
        });
        return div;
      }
      if (item.type === 'progress') {
        const wrap = document.createElement('div');
        wrap.style.cssText = 'display:flex;align-items:center;gap:8px';
        const bar = document.createElement('div');
        bar.style.cssText = 'flex:1;height:6px;border-radius:3px;background:var(--pdx-color-inset);max-width:120px';
        const fill = document.createElement('div');
        fill.style.cssText = 'height:100%;border-radius:3px;background:var(--pdx-color-primary);width:' + item.value + '%';
        bar.appendChild(fill);
        wrap.appendChild(bar);
        const text = document.createElement('span');
        text.style.cssText = 'font-size:0.75rem;color:var(--pdx-color-muted)';
        text.textContent = item.value + '%';
        wrap.appendChild(text);
        return wrap;
      }
      return null;
    }
    ctx.el.setAttribute('data-pdx-isem6k', '');
    return { customItems, renderCustomValue };
  },
  render: (ctx) => (() => {
    const __frag=__blk0();
    const [__el5]=__walk0(__frag);
    let __el5w_items = {}; effect(() => { const __b = ctx.customItems; if (Object.is(__b, __el5w_items)) return; __el5w_items = __b; assignBoundProperty(__el5, "items", __b); });

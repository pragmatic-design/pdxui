      </pdx-form-field>

      <pdx-form-field label="Disabled">
        <pdx-slider value="60" disabled></pdx-slider>
      </pdx-form-field>
    </div>

    <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Range Mode</h3>
    <p class="pdx-txt-small pdx-ink-muted">
      Two thumbs for min/max selection. Thumbs can't cross.
    </p>

  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Render Error — @try / @catch</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      When content throws during render, the catch block shows with the actual error message.
    </p>
    <div class="demo-box">
      \${errorBoundary(() => html\`
        <div class="demo-widget">\${() => ctx.throwRenderError()}</div>
      \`, (err, retry) => html\`
        <div class="pdx-error-fallback" role="alert">
          <div class="pdx-error-icon">&#9888;</div>
          <div class="pdx-error-msg">Widget failed to render</div>
          <div class="pdx-error-detail">\${() => err.message}</div>
        </div>
      \`)}
    </div>
    <details class="source"><summary>Source</summary><pre><code>@@try {
  &lt;pdx-risky-widget /&gt;
} @@catch (err) {
  &lt;div role="alert"&gt;
    &lt;p&gt;{{ err.message }}&lt;/p&gt;
  &lt;/div&gt;
}</code></pre></details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-error-boundary/demo-comp-error-boundary-scope.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

component('pdx-demo-comp-error-boundary-scope', {
  props: {},
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Scope and Limitations</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>@try/@catch</code> and <code>&lt;pdx-error-boundary&gt;</code> catch:
    </p>
    <ul class="pdx-txt-small" style="margin: 0.5rem 0; padding-left: 1.5rem">
      <li><strong>Render errors</strong> — throw in contentFn()</li>
      <li><strong>Effect errors</strong> — throw in tracked effects</li>
      <li><strong>Event handler errors</strong> — @click, @input, etc. (compiler wraps with safeHandler, routes to nearest boundary)</li>
    </ul>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>onGlobalError()</code> is the last-resort fallback and additionally catches:
    </p>
    <ul class="pdx-txt-small" style="margin: 0.5rem 0; padding-left: 1.5rem">
      <li><strong>Unhandled event errors</strong> — when no local boundary is active</li>
      <li><strong>Async rejections</strong> — unhandled Promise rejections</li>
      <li><strong>Uncaught exceptions</strong> — window.onerror fallback</li>
    </ul>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-error-boundary/demo-comp-error-boundary-wrapper.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, component as defineComponent, computed as rawComputed, html, html as h, safeHandler, signal, signal as rawSignal } from '@pdxui/core';

component('pdx-demo-comp-error-boundary-wrapper', {
  props: {},
  setup(ctx) {
    const __boundaryErrorCount = signal(0, { name: 'demo-comp-error-boundary-wrapper:boundaryErrorCount' });
// A child that throws on a signal change, as a real widget whose data source fails: the boundary
    // catches what its children throw after the screen is up. The controls sit outside the
    // boundary, since its fallback replaces what is inside it.
    const widgetBroken = rawSignal(false);
    
    
    const widgetStatus = rawComputed(() => {
      if (widgetBroken()) throw new Error('Dashboard data source returned HTTP 500');
      return 'Dashboard widget — healthy';
    });
    
    if (!customElements.get('demo-flaky-widget')) {
      defineComponent('demo-flaky-widget', { render: () => h\`<p>\${() => widgetStatus()}</p>\` });
    }
    
    function breakWidget() { widgetBroken.set(true); }
    function fixWidget() { widgetBroken.set(false); }
    function onBoundaryError(e) { __boundaryErrorCount.set(__v => __v + 1); }
    return { boundaryErrorCount: __boundaryErrorCount, widgetBroken, widgetStatus, breakWidget, fixWidget, onBoundaryError };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">&lt;pdx-error-boundary&gt; — Component Wrapper</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Declarative error boundary with built-in fallback UI, retry button, max retries, and
      <code>pdx-error</code> event for logging. Provides <code>errorContext</code> to descendants.
    </p>
    <div class="demo-controls demo-row">
      <button class="pdx-btn pdx-btn-sm pdx-btn-outline" @click=\${safeHandler(ctx.breakWidget, ctx.el?.tagName?.toLowerCase(), 'click')}>Make it throw</button>
      <button class="pdx-btn pdx-btn-sm pdx-btn-outline" @click=\${safeHandler(ctx.fixWidget, ctx.el?.tagName?.toLowerCase(), 'click')}>Fix the data source</button>
    </div>
    <div class="demo-box">
      <pdx-error-boundary fallback-message="Dashboard widget crashed." :max-retries=\${3} @pdx-error=\${safeHandler(ctx.onBoundaryError, ctx.el?.tagName?.toLowerCase(), 'pdx-error')}>
        <div class="demo-widget">
          <demo-flaky-widget></demo-flaky-widget>
          <p class="pdx-txt-small pdx-ink-muted">Wrapped in &lt;pdx-error-boundary&gt;. "Make it throw" breaks its data source: the fallback shows, with Retry. Retry while it is still broken counts toward <code>max-retries</code>; fix it first and Retry brings it back.</p>
        </div>
      </pdx-error-boundary>
    </div>
    <p class="pdx-txt-small pdx-ink-muted">Errors logged: \${ctx.boundaryErrorCount}</p>
    <details class="source"><summary>Source</summary><pre><code>&lt;pdx-error-boundary
  fallback-message="Dashboard widget crashed."
  :max-retries="3"
  @pdx-error="onError"&gt;
  &lt;pdx-dashboard-widget /&gt;
&lt;/pdx-error-boundary&gt;</code></pre></details>
  </section>
\`,
});
"
`;


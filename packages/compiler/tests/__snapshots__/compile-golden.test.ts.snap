exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-menu/demo-comp-menu-basic.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler } from '@pdxui/core';
import { useMenuDemo } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-z2hidf");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-z2hidf"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-z2hidf] .event-log {\\n  padding: var(--pdx-space-xs) var(--pdx-space-sm);\\n  background: var(--pdx-color-inset);\\n  border-radius: var(--pdx-radius-sm);\\n}\\n";
}

component('pdx-demo-comp-menu-basic', {
  props: {},
  setup(ctx) {
// One menu open at a time across the sections, and the line every menu writes (state.pdx.ts).
    const menuDemo = useMenuDemo();
    const shown = computed(() => menuDemo.shown(), { name: 'demo-comp-menu-basic:shown' });
    const menuLog = computed(() => menuDemo.menuLog(), { name: 'demo-comp-menu-basic:menuLog' });
    
    
    
    function show(key) { menuDemo.show(key); }
    function hide(e) { menuDemo.hide(e); }
    function onSelect(e) { menuDemo.onSelect(e); }
    
    const fileItems = [
      { key: 'new', label: 'New File' },
      { key: 'open', label: 'Open...' },
      { key: 'save', label: 'Save' },
      { key: 'saveas', label: 'Save As...' },
      { key: 'sep1', label: '', type: 'separator' },
      { key: 'exit', label: 'Exit' },
    ];
    ctx.el.setAttribute('data-pdx-z2hidf', '');
    return { menuDemo, shown, menuLog, show, hide, onSelect, fileItems };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">Arrow keys move between items, Enter or Space activates, typing jumps to an item.</p>

    <div class="demo-row">
      <div class="menu-demo">
        <button class="pdx-outline" size="sm" :aria-expanded=\${() => ctx.shown() === 'basic' ? 'true' : 'false'} @click=\${safeHandler(() => ctx.show('basic'), ctx.el?.tagName?.toLowerCase(), 'click')}>File</button>
        <pdx-menu :open=\${() => ctx.shown() === 'basic'} :items=\${() => ctx.fileItems} @pdx-select=\${safeHandler(ctx.onSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')} @pdx-close=\${safeHandler(ctx.hide, ctx.el?.tagName?.toLowerCase(), 'pdx-close')}></pdx-menu>
      </div>
      <span class="event-log pdx-txt-mono pdx-txt-small" id="menu-event-log">\${ctx.menuLog}</span>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-menu :open="shown" :items="fileItems" @pdx-select="onSelect" @pdx-close="hide"&gt;&lt;/pdx-menu&gt;

// items = [
//   { key: 'new', label: 'New File' },
//   { key: 'sep1', label: '', type: 'separator' },
//   { key: 'exit', label: 'Exit' },
// ]</code></pre>
    </details>
  </section>
\`,
});
"
`;


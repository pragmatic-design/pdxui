    &lt;div class="mention-custom"&gt;
      &lt;span class="avatar"&gt;$&lbrace;item.label.charAt(0)&rbrace;&lt;/span&gt;
      &lt;span&gt;$&lbrace;item.label&rbrace;&lt;/span&gt;
    &lt;/div&gt;
  &lt;/slot&gt;
&lt;/pdx-mention&gt;

.mention-custom {
  display: flex; align-items: center; gap: 8px;
}

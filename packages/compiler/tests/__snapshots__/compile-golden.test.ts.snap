}

component('pdx-demo-infra-drag-drop-zones', {
  props: {},
  setup(ctx) {
    const __dropLog = signal('Drag cards between zones...', { name: 'demo-infra-drag-drop-zones:dropLog' });
    const __zoneARef = signal(null, { name: 'demo-infra-drag-drop-zones:zoneARef' });
    const __zoneBRef = signal(null, { name: 'demo-infra-drag-drop-zones:zoneBRef' });
    const __c1Ref = signal(null, { name: 'demo-infra-drag-drop-zones:c1Ref' });
    const __c2Ref = signal(null, { name: 'demo-infra-drag-drop-zones:c2Ref' });
    const __c3Ref = signal(null, { name: 'demo-infra-drag-drop-zones:c3Ref' });
    const __c4Ref = signal(null, { name: 'demo-infra-drag-drop-zones:c4Ref' });
// Card drags — each card sends its data-id as payload
    const c1Drag = useDrag(() => __c1Ref(), { data: function() { return 'c1'; } });
    
    const c2Drag = useDrag(() => __c2Ref(), { data: function() { return 'c2'; } });
    
    const c3Drag = useDrag(() => __c3Ref(), { data: function() { return 'c3'; } });
    
    const c4Drag = useDrag(() => __c4Ref(), { data: function() { return 'c4'; } });
    
    
    // Move card element to target zone on drop
    function moveCard(cardId, targetZone) {
        const card = ({ c1: __c1Ref(), c2: __c2Ref(), c3: __c3Ref(), c4: __c4Ref() })[cardId];
        if (card && targetZone) {
            card.style.transform = '';
            card.style.zIndex = '';
            card.style.opacity = '';
            card.style.boxShadow = '';
            targetZone.appendChild(card);
        }
    }
    
    // Drop zones — actual card movement on drop
    const dropA = useDropZone(() => __zoneARef(), {
        onDrop: function(data) {
            moveCard(data, __zoneARef());
            __dropLog.set(prev => prev + '> Moved ' + data + ' → Zone A\\n');
        },
        onEnter: function() { },
        onLeave: function() { },
    });
    
    const dropB = useDropZone(() => __zoneBRef(), {
        onDrop: function(data) {
            moveCard(data, __zoneBRef());
            __dropLog.set(prev => prev + '> Moved ' + data + ' → Zone B\\n');
        },
    });
    onMount(() => {
    // Drop zone highlight
    const d4 = effect(() => {
        const el = __zoneARef();
        if (el) el.classList.toggle('over', dropA.isOver());
    });
    const d5 = effect(() => {
        const el = __zoneBRef();
        if (el) el.classList.toggle('over', dropB.isOver());
    });

    // Card drag visual feedback
    function cardEffect(drag, getRef) {
        return effect(() => {
            const el = getRef;
            if (!el) return;
            const pos = drag.position();
            const dragging = drag.isDragging();
            if (dragging) {
                el.style.transform = 'translate(' + pos.x + 'px, ' + pos.y + 'px)';
                el.style.zIndex = '100';
                el.style.opacity = '0.85';
                el.style.boxShadow = '0 4px 16px rgba(0,0,0,0.15)';
            } else {
                el.style.transform = '';
                el.style.zIndex = '';
                el.style.opacity = '';
                el.style.boxShadow = '';
            }
        });
    }
    const d6 = cardEffect(c1Drag, __c1Ref());
    const d7 = cardEffect(c2Drag, __c2Ref());
    const d8 = cardEffect(c3Drag, __c3Ref());
    const d9 = cardEffect(c4Drag, __c4Ref());

    onDestroy(() => {
        d4(); d5(); d6(); d7(); d8(); d9();
        c1Drag.dispose(); c2Drag.dispose(); c3Drag.dispose(); c4Drag.dispose();
        dropA.dispose(); dropB.dispose();
    });
});
    ctx.el.setAttribute('data-pdx-gjs1mw', '');
    return { dropLog: __dropLog, zoneARef: __zoneARef, zoneBRef: __zoneBRef, c1Ref: __c1Ref, c2Ref: __c2Ref, c3Ref: __c3Ref, c4Ref: __c4Ref, c1Drag, c2Drag, c3Drag, c4Drag, moveCard, dropA, dropB };
  },
  render: (ctx) => html\`
  <section>
    <h3>Drop Zones</h3>
    <p class="desc">Drag cards between Zone A and Zone B. Cards move to the drop zone on release. Zone highlights when hovered.</p>
    <div class="zones">
      <div>
        <span class="zone-label">Zone A</span>
        <div class="drop-zone" :ref=\${ctx.zoneARef} data-zone="A">
          <div class="card" data-id="c1" :ref=\${ctx.c1Ref}>Task 1: Design review</div>
          <div class="card" data-id="c2" :ref=\${ctx.c2Ref}>Task 2: Code cleanup</div>
          <div class="card" data-id="c3" :ref=\${ctx.c3Ref}>Task 3: Write tests</div>
        </div>
      </div>
      <div>
        <span class="zone-label">Zone B</span>
        <div class="drop-zone" :ref=\${ctx.zoneBRef} data-zone="B">
          <div class="card" data-id="c4" :ref=\${ctx.c4Ref}>Task 4: Deploy</div>
        </div>
      </div>
    </div>
    <pre class="log">\${ctx.dropLog}</pre>
  </section>
\`,
});
"
`;


  __pdx_style.textContent = "\\n  [data-pdx-g8qtie] .task-list { background: white; border-radius: 10px; padding: 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }\\n  [data-pdx-g8qtie] .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; }\\n  [data-pdx-g8qtie] .header h2 { font-size: 1.2rem; margin: 0; }\\n  [data-pdx-g8qtie] .badge { background: #e8eaf6; color: #3949ab; padding: 2px 10px; border-radius: 12px; font-size: 0.8rem; font-weight: 600; }\\n  [data-pdx-g8qtie] .filters { display: flex; gap: 8px; align-items: center; margin-bottom: 0.8rem; font-size: 0.85rem; }\\n  [data-pdx-g8qtie] .filters select { padding: 3px 8px; border: 1px solid #ddd; border-radius: 4px; }\\n  [data-pdx-g8qtie] .page-info { margin-left: auto; color: #888; font-size: 0.8rem; }\\n  [data-pdx-g8qtie] .btn-sm { padding: 2px 8px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer; background: white; }\\n  [data-pdx-g8qtie] .btn-sm:disabled { opacity: 0.3; }\\n  [data-pdx-g8qtie] .task-row { display: flex; align-items: center; gap: 8px; padding: 8px 4px; border-bottom: 1px solid #f0f0f0; }\\n  [data-pdx-g8qtie] .task-row.done .task-text { text-decoration: line-through; color: #aaa; }\\n  [data-pdx-g8qtie] .task-text { flex: 1; font-size: 0.9rem; }\\n  [data-pdx-g8qtie] .task-cat { background: #f5f5f5; color: #666; padding: 1px 6px; border-radius: 8px; font-size: 0.7rem; }\\n  [data-pdx-g8qtie] .btn-toggle { width: 28px; height: 28px; border: 2px solid #4caf50; border-radius: 50%; cursor: pointer; background: white; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; }\\n  [data-pdx-g8qtie] .btn-toggle:hover { background: #e8f5e9; }\\n  [data-pdx-g8qtie] .btn-remove { background: none; border: none; color: #e53935; cursor: pointer; font-size: 1.1rem; padding: 4px; }\\n  [data-pdx-g8qtie] .empty { color: #888; font-style: italic; text-align: center; padding: 16px; }\\n";
}

component('pdx-task-list', {
  props: {
    title: { type: String, default: 'Tasks' }
  },
  setup(ctx) {
const store = useTasks();
    const taskCount = computed(() => store.filtered().length, { name: 'task-list:taskCount' });
    
    
    // linkedSignal: page resets when filter changes
    const page = linkedSignal({
      source: () => store.filter(),
      computation: (_f, prev) => {
        if (prev && prev.source === _f) return prev.value;
        return 1;
      },
    });
    
    
    
    
    function onFilter(e) { store.setFilter(e.target.value); }
    function prevPage() { if (page() > 1) page.set(page.peek() - 1); }
    function nextPage() { page.set(page.peek() + 1); }
    function toggleTask(id) { store.toggleTask(id); }
    function removeTask(id) { store.removeTask(id); }
    ctx.el.setAttribute('data-pdx-g8qtie', '');
    return { store, page, taskCount, onFilter, prevPage, nextPage, toggleTask, removeTask };
  },
  render: (ctx) => html\`
  <div class="task-list">
    <div class="header">
      <h2>\${ctx.title}</h2>
      <span class="badge">\${ctx.taskCount} tasks</span>
    </div>

    <div class="filters">
      <label>Filter:
        <select @change=\${safeHandler(ctx.onFilter, ctx.el?.tagName?.toLowerCase(), 'change')}>
          <option value="all" :selected=\${() => ctx.store.filter() === 'all'}>All</option>
          <option value="pending" :selected=\${() => ctx.store.filter() === 'pending'}>Pending</option>
          <option value="done" :selected=\${() => ctx.store.filter() === 'done'}>Done</option>
        </select>
      </label>
      <span class="page-info">Page \${() => ctx.page()}</span>
      <button @click=\${safeHandler(ctx.prevPage, ctx.el?.tagName?.toLowerCase(), 'click')} :disabled=\${() => ctx.page() <= 1} class="btn-sm">←</button>
      <button @click=\${safeHandler(ctx.nextPage, ctx.el?.tagName?.toLowerCase(), 'click')} class="btn-sm">→</button>
    </div>

    \${when(() => ctx.store.filtered().length === 0, () => html\`
      <div class="empty">No tasks match the filter.</div>
    \`, null)}\${eachRow(() => ctx.store.filtered(), 'id', (task) => html\`
      <div class="task-row" :class=\${() => task().done ? 'done' : ''}>
        <button @click=\${safeHandler(() => ctx.toggleTask(task().id), ctx.el?.tagName?.toLowerCase(), 'click')} class="btn-toggle">
          \${when(() => task().done, () => html\` ✓ \`, () => html\` ○ \`)}
        </button>
        <span class="task-text">\${() => task().text}</span>
        <span class="task-cat">\${() => task().category}</span>
        <button @click=\${safeHandler(() => ctx.removeTask(task().id), ctx.el?.tagName?.toLowerCase(), 'click')} class="btn-remove">×</button>
      </div>
    \`)}</div>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase/task-store.pdx 1`] = `
"// 0 warning(s)

============================================================
import { computed, createGlobalStore, signal } from '@pdxui/core';

const __store_tasks = createGlobalStore('tasks', () => {
    const __filter = signal('all', { name: 'task-store:filter' });
    const ___nextId = signal(7, { name: 'task-store:_nextId' });
function addTask(text, category) {
      const id = ___nextId();
      ___nextId.set(prev => prev + 1);
      __items.set(prev => [...prev, { id, text, category, done: false }]);
    }
    
    function toggleTask(id) {
      __items.set(prev => prev.map(t => t.id === id ? { ...t, done: !t.done } : t));
    }
    
    function removeTask(id) {
      __items.set(prev => prev.filter(t => t.id !== id));
    }
    
    function setFilter(f) {
      __filter.set(f);
    }
    
    function clearDone() {
      __items.set(prev => prev.filter(t => !t.done));
    }
    
    function resetStore() {
      __items.set([
        { id: 1, text: 'Design @form API', category: 'design', done: true },
        { id: 2, text: 'Implement resource() cache', category: 'dev', done: true },
        { id: 3, text: 'Write integration tests', category: 'test', done: false },
        { id: 4, text: 'Fix scoped CSS bug', category: 'dev', done: true },
        { id: 5, text: 'Create showcase demo', category: 'dev', done: false },
        { id: 6, text: 'Review form validation', category: 'test', done: false },
      ]);
      __filter.set('all');
      ___nextId.set(7);
    }
    const __items = signal([
  { id: 1, text: 'Design @form API', category: 'design', done: true },
  { id: 2, text: 'Implement resource() cache', category: 'dev', done: true },
  { id: 3, text: 'Write integration tests', category: 'test', done: false },
  { id: 4, text: 'Fix scoped CSS bug', category: 'dev', done: true },
  { id: 5, text: 'Create showcase demo', category: 'dev', done: false },
  { id: 6, text: 'Review form validation', category: 'test', done: false },
], { name: 'task-store:items' });
    const filtered = computed(() => __filter() === 'all' ? __items()
    : __filter() === 'done' ? __items().filter(t => t.done)
    : __items().filter(t => !t.done), { name: 'task-store:filtered' });
    const stats = computed(() => ({
  total: __items().length,
  done: __items().filter(t => t.done).length,
  pending: __items().filter(t => !t.done).length,
}), { name: 'task-store:stats' });
    return { items: __items, filter: __filter, filtered, stats, addTask, toggleTask, removeTask, setFilter, clearDone, resetStore };
}, { persist: 'local' });

export function useTasks() { return __store_tasks; }
"
`;


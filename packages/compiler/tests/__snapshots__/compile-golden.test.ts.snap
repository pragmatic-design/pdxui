  __pdx_style.textContent = "\\n  [data-pdx-bohzvf] .demo { max-width: 800px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-bohzvf] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-bohzvf] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-bohzvf] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-bohzvf] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-bohzvf] .row { display: flex; gap: 8px; flex-wrap: wrap; margin: 8px 0; }\\n  [data-pdx-bohzvf] .stats { display: flex; gap: 20px; font-size: 0.9rem; }\\n  [data-pdx-bohzvf] .log { font-family: monospace; font-size: 0.75rem; background: #f5f5f7; padding: 8px; border-radius: 6px; max-height: 120px; overflow-y: auto; white-space: pre-wrap; margin: 8px 0 0; min-height: 30px; }\\n";

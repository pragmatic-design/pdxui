  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-hqclme"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-hqclme] .wizard-tabs {\\n    display: flex;\\n    gap: 0;\\n    margin-bottom: var(--pdx-space-lg);\\n    border-bottom: 2px solid var(--pdx-color-border);\\n  }\\n  [data-pdx-hqclme] .wizard-nav {\\n    display: flex;\\n    justify-content: space-between;\\n    align-items: center;\\n    margin-top: var(--pdx-space-lg);\\n    padding-top: var(--pdx-space-md);\\n    border-top: 1px solid var(--pdx-color-border);\\n  }\\n  [data-pdx-hqclme] .confirm-summary { padding: var(--pdx-space-md); }\\n";
}

component('pdx-demo-comp-form-advanced-tab-wizard', {
  props: {},
  setup(ctx) {
    const __wizardStep = signal(0, { name: 'demo-comp-form-advanced-tab-wizard:wizardStep' });
// ─── 3. Wizard Form ───
    
    
    const wizardForm = createForm({ initialValues: { username: '', password: '', fullName: '', avatar: '' }, validators: { username: [required('Username is required'), minLength(3, 'Min 3 characters')], password: [required('Password is required'), minLength(6, 'Min 6 characters')], fullName: [required('Full name is required')] }, validateOn: 'onBlur' });
    
    const stepFields = [['username', 'password'], ['fullName', 'avatar'], []];
    
    
    function goToStep(n) { __wizardStep.set(n); }
    function prevStep() { if (__wizardStep() > 0) __wizardStep.set(prev => prev - 1); }
    function nextStep() { if (__wizardStep() >= 2) { wizardForm.validate(); return; } const fields = stepFields[__wizardStep()]; let valid = true; for (const f of fields) { const field = wizardForm.fields[f]; if (field) { field.onBlur(); const err = field.error(); if (err) valid = false; } } if (valid) __wizardStep.set(prev => prev + 1); }
    function wizardSummary() { const v = wizardForm.dirty(); return JSON.stringify({ username: wizardForm.fields.username?.value(), password: wizardForm.fields.password?.value() ? '***' : '', fullName: wizardForm.fields.fullName?.value(), avatar: wizardForm.fields.avatar?.value() }, null, 2); }
    function tabClass0() { return 'wizard-tab' + (__wizardStep() === 0 ? ' active' : ''); }
    function tabClass1() { return 'wizard-tab' + (__wizardStep() === 1 ? ' active' : ''); }
    function tabClass2() { return 'wizard-tab' + (__wizardStep() === 2 ? ' active' : ''); }
    function step0Style() { return __wizardStep() === 0 ? '' : 'display:none'; }
    function step1Style() { return __wizardStep() === 1 ? '' : 'display:none'; }
    function step2Style() { return __wizardStep() === 2 ? '' : 'display:none'; }
    function isFirstStep() { return __wizardStep() === 0; }
    function stepLabel() { return 'Step ' + (__wizardStep() + 1) + ' of 3'; }
    function nextBtnClass() { return __wizardStep() < 2 ? 'pdx-btn pdx-primary pdx-sm' : 'pdx-btn pdx-success pdx-sm'; }
    function nextBtnText() { return __wizardStep() < 2 ? 'Next →' : 'Submit ✓'; }
    ctx.el.setAttribute('data-pdx-hqclme', '');
    return { wizardStep: __wizardStep, wizardForm, stepFields, goToStep, prevStep, nextStep, wizardSummary, tabClass0, tabClass1, tabClass2, step0Style, step1Style, step2Style, isFirstStep, stepLabel, nextBtnClass, nextBtnText };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">3. Tab / Wizard Form</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Multi-step form with per-section validation. Must complete each step before advancing.
    </p>

    <div class="demo-block">
      <div class="wizard-tabs">
        <button :class=\${() => ctx.tabClass0()} @click=\${safeHandler(() => ctx.goToStep(0), ctx.el?.tagName?.toLowerCase(), 'click')}>1. Account</button>
        <button :class=\${() => ctx.tabClass1()} @click=\${safeHandler(() => ctx.goToStep(1), ctx.el?.tagName?.toLowerCase(), 'click')}>2. Profile</button>
        <button :class=\${() => ctx.tabClass2()} @click=\${safeHandler(() => ctx.goToStep(2), ctx.el?.tagName?.toLowerCase(), 'click')}>3. Confirm</button>
      </div>

      <pdx-form :form=\${() => ctx.wizardForm}>
        <div :style=\${() => ctx.step0Style()}>
          <pdx-form-field name="username" label="Username" required :error=\${() => ctx.wizardForm.fields.username?.error()} :touched=\${() => ctx.wizardForm.fields.username?.touched()} :warning=\${() => ctx.wizardForm.fields.username?.warning()}>
            <pdx-input name="username" placeholder="Choose username" @pdx-input=\${(e) => ctx.wizardForm.fields.username?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.wizardForm.fields.username?.onBlur()}></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="password" label="Password" required :error=\${() => ctx.wizardForm.fields.password?.error()} :touched=\${() => ctx.wizardForm.fields.password?.touched()} :warning=\${() => ctx.wizardForm.fields.password?.warning()}>
            <pdx-password-input name="password" placeholder="Min 6 characters" @pdx-input=\${(e) => ctx.wizardForm.fields.password?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.wizardForm.fields.password?.onBlur()}></pdx-password-input>
          </pdx-form-field>
        </div>

        <div :style=\${() => ctx.step1Style()}>
          <pdx-form-field name="fullName" label="Full Name" required :error=\${() => ctx.wizardForm.fields.fullName?.error()} :touched=\${() => ctx.wizardForm.fields.fullName?.touched()} :warning=\${() => ctx.wizardForm.fields.fullName?.warning()}>
            <pdx-input name="fullName" placeholder="John Doe" @pdx-input=\${(e) => ctx.wizardForm.fields.fullName?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.wizardForm.fields.fullName?.onBlur()}></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="avatar" label="Avatar URL" :error=\${() => ctx.wizardForm.fields.avatar?.error()} :touched=\${() => ctx.wizardForm.fields.avatar?.touched()} :warning=\${() => ctx.wizardForm.fields.avatar?.warning()}>
            <pdx-input name="avatar" type="url" placeholder="https://..." @pdx-input=\${(e) => ctx.wizardForm.fields.avatar?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.wizardForm.fields.avatar?.onBlur()}></pdx-input>
          </pdx-form-field>
        </div>

        <div :style=\${() => ctx.step2Style()}>
          <div class="confirm-summary">
            <h4 class="pdx-txt-small pdx-weight-semibold">Review your details:</h4>
            <pre class="pdx-txt-mono form-values" :text-content=\${() => ctx.wizardSummary()}></pre>
          </div>
        </div>
      </pdx-form>

      <div class="wizard-nav">
        <button class="pdx-btn pdx-ghost pdx-sm" :disabled=\${() => ctx.isFirstStep()} @click=\${safeHandler(ctx.prevStep, ctx.el?.tagName?.toLowerCase(), 'click')}>← Previous</button>
        <span class="pdx-txt-small pdx-ink-muted" :text-content=\${() => ctx.stepLabel()}></span>
        <button :class=\${() => ctx.nextBtnClass()} @click=\${safeHandler(ctx.nextStep, ctx.el?.tagName?.toLowerCase(), 'click')} :text-content=\${() => ctx.nextBtnText()}></button>
      </div>
    </div>

    <details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>let wizardStep = $signal(0);
const wizardForm = createForm({
  initialValues: { username: '', password: '', fullName: '', avatar: '' },
  validators: {
    username: [required(...), minLength(3, ...)],
    password: [required(...), minLength(6, ...)],
    fullName: [required(...)],
  },
});

// Validate current step fields before advancing
const stepFields = [['username', 'password'], ['fullName', 'avatar'], []];
function nextStep() {
  const fields = stepFields[wizardStep];
  let valid = true;
  for (const f of fields) {
    wizardForm.fields[f]?.onBlur();
    if (wizardForm.fields[f]?.error()) valid = false;
  }
  if (valid) wizardStep++;
}

// Template: :style="stepNStyle()" to show/hide panels</code></pre></details>
  </section>
\`,
});
"
`;


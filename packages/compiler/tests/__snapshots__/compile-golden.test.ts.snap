const userDS = createDataSource({
  data: [
    { id: 1, name: 'Alice Johnson', role: 'Lead' },
    { id: 2, name: 'Bob Smith', role: 'Developer' },
    ...
  ],
  idField: 'id',
});

&lt;pdx-select :source="userDS" labelField="name" valueField="id"
  searchable clearable placeholder="Search users..." /&gt;</code></pre></details>
  </section>
\`,
});
"
`;


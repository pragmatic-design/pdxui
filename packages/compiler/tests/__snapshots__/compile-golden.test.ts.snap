        bsResult?.dispose();
        const content = document.createElement('div');
        content.style.cssText = 'padding:16px;font-family:system-ui';
        content.innerHTML = '<h3 style="margin:0 0 8px">Bottom Sheet</h3><p style="color:#666;margin:0 0 12px">Drag the handle to resize. Swipe down past 50% to dismiss.</p><div style="display:flex;flex-direction:column;gap:8px"><div style="padding:12px;background:#f5f5f7;border-radius:8px">Item 1</div><div style="padding:12px;background:#f5f5f7;border-radius:8px">Item 2</div><div style="padding:12px;background:#f5f5f7;border-radius:8px">Item 3</div><div style="padding:12px;background:#f5f5f7;border-radius:8px">Item 4</div></div>';
        bsResult = createBottomSheet(content, {

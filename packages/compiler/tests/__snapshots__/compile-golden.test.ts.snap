exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-time-picker/demo-comp-time-picker-composition.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-7ax5wr");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-7ax5wr"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-7ax5wr] .form-grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--pdx-space-lg); }\\n  [data-pdx-7ax5wr] .summary { margin-top: var(--pdx-space-md); }\\n";
}

component('pdx-demo-comp-time-picker-composition', {
  props: {},
  setup(ctx) {
    const __start = signal('10:00', { name: 'demo-comp-time-picker-composition:start' });
    const __end = signal('11:30', { name: 'demo-comp-time-picker-composition:end' });
function minutes(v) {
      const [h, m] = (v || '0:0').split(':').map(Number);
      return h * 60 + m;
    }
    
    function duration() {
      const d = minutes(__end()) - minutes(__start());
      if (d <= 0) return 'end before start';
      return Math.floor(d / 60) + ' h ' + String(d % 60).padStart(2, '0') + ' min';
    }
    ctx.el.setAttribute('data-pdx-7ax5wr', '');
    return { start: __start, end: __end, minutes, duration };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Composition — booking a slot</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Inside form fields, with a label and a hint. The end cannot come before the start: its <code>min</code>
      follows the start's value.
    </p>
    <div class="comp-card">
      <div class="form-grid-2">
        <pdx-form-field label="Start" hint="Opening hours 08:00–20:00">
          <pdx-time-picker :value=\${ctx.start} format="24h" min="08:00" max="20:00" step="15" aria-label="Start" @pdx-change=\${safeHandler(e => ctx.start.set(e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-time-picker>
        </pdx-form-field>
        <pdx-form-field label="End" hint="After the start">
          <pdx-time-picker :value=\${ctx.end} format="24h" :min=\${ctx.start} max="20:00" step="15" aria-label="End" @pdx-change=\${safeHandler(e => ctx.end.set(e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-time-picker>
        </pdx-form-field>
      </div>
      <p class="pdx-txt-small summary">Booked <strong>\${ctx.start}</strong> – <strong>\${ctx.end}</strong> · \${() => ctx.duration()}</p>
    </div>
  </section>
\`,
});
"
`;


exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-file-upload/demo-comp-file-upload-size-limit.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-4gfe9k");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-4gfe9k"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-4gfe9k] .error-box {\\n    padding: var(--pdx-space-sm) var(--pdx-space-md);\\n    background: var(--pdx-color-danger-soft);\\n    border-radius: var(--pdx-radius-md);\\n    border: 1px solid var(--pdx-color-danger);\\n    color: var(--pdx-color-danger-ink);\\n  }\\n";
}

component('pdx-demo-comp-file-upload-size-limit', {
  props: {},
  setup(ctx) {
    const __errorMsg = signal('', { name: 'demo-comp-file-upload-size-limit:errorMsg' });
    const __sizeFiles = signal('', { name: 'demo-comp-file-upload-size-limit:sizeFiles' });
function onError(e) {
      __errorMsg.set(e.detail.file.name + ': ' + e.detail.error);
    }
    
    function onSizeSelect(e) {
      const names = e.detail.files.map(f => f.name);
      __sizeFiles.set(names.join(', '));
    }
    ctx.el.setAttribute('data-pdx-4gfe9k', '');
    return { errorMsg: __errorMsg, sizeFiles: __sizeFiles, onError, onSizeSelect };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Size Limit</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Max 2 MB per file. A file over the limit is refused: the component lists it under the zone
      (and announces it), and emits <code>pdx-error</code> for your app to react.
    </p>

    <div class="demo-stack">
      <pdx-file-upload :max-size=\${2097152} @pdx-error=\${safeHandler(ctx.onError, ctx.el?.tagName?.toLowerCase(), 'pdx-error')} @pdx-select=\${safeHandler(ctx.onSizeSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')}></pdx-file-upload>
      \${when(() => ctx.errorMsg(), () => html\`
        <div class="error-box">
          <span class="pdx-txt-small pdx-ink-muted">Last pdx-error: </span>
          <span class="pdx-txt-small">\${ctx.errorMsg}</span>
        </div>
      \`, null)}\${when(() => ctx.sizeFiles(), () => html\`
        <div class="result-box">
          <span class="pdx-txt-small pdx-ink-muted">Accepted: </span>
          <span class="pdx-txt-small">\${ctx.sizeFiles}</span>
        </div>
      \`, null)}</div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-file-upload :max-size="2097152"
  @pdx-error="onError" /&gt;

function onError(e) {
  errorMsg = e.detail.file.name + ': ' + e.detail.error;
}</code></pre>
    </details>
  </section>
\`,
});
"
`;


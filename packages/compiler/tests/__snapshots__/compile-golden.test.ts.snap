============================================================
import { $n, $t, awaitReady, component, computed, getLocale, html, initI18n, loadTranslations, safeHandler, setLocale, setPermissions, signal, useHead, when } from '@pdxui/core';
import { navigate, currentPath, onBeforeNavigate, onAfterNavigate } from '@pdxui/router';
import { useTasks } from './task-store.pdx';
import '@pdxui/router/outlet';
import enMessages from './translations/en.json';
import itMessages from './translations/it.json';

{
  let __pdx_style = document.getElementById("pdx-s-og4fgo");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-og4fgo"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-og4fgo] .app { min-height: 100vh; display: flex; flex-direction: column; }\\n  [data-pdx-og4fgo] .navbar { background: #1d1d2e; display: flex; align-items: center; gap: 4px; padding: 8px 20px; flex-wrap: wrap; }\\n  [data-pdx-og4fgo] .brand { color: white; font-weight: 700; font-size: 1.1rem; margin-right: 20px; }\\n  [data-pdx-og4fgo] .navbar button { background: transparent; color: rgba(255,255,255,0.7); border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 0.85rem; transition: all 0.15s; }\\n  [data-pdx-og4fgo] .navbar button:hover { background: rgba(255,255,255,0.1); color: white; }\\n  [data-pdx-og4fgo] .navbar button.active { background: rgba(255,255,255,0.15); color: white; font-weight: 600; }\\n\\n  [data-pdx-og4fgo] .locale-switch { margin-left: auto; display: flex; gap: 3px; }\\n  [data-pdx-og4fgo] .lang-btn { font-size: 0.72rem !important; padding: 4px 10px !important; border: 1px solid rgba(255,255,255,0.25) !important; border-radius: 4px; font-weight: 600; }\\n  [data-pdx-og4fgo] .lang-btn:hover { border-color: rgba(255,255,255,0.6) !important; }\\n  [data-pdx-og4fgo] .lang-active { background: white !important; color: #1d1d2e !important; border-color: white !important; }\\n\\n  [data-pdx-og4fgo] .nav-loading { background: #e3f2fd; color: #1565c0; padding: 6px 20px; font-size: 0.78rem; text-align: center; }\\n\\n  [data-pdx-og4fgo] .page-content { flex: 1; padding: 20px; max-width: 1100px; width: 100%; margin: 0 auto; }\\n  [data-pdx-og4fgo] .app-footer { background: #f0f0f0; padding: 10px 20px; display: flex; justify-content: space-between; font-size: 0.75rem; color: #888; }\\n  [data-pdx-og4fgo] .stats { font-family: monospace; }\\n  [data-pdx-og4fgo] .page-indicator { font-family: monospace; color: #aaa; }\\n\\n  [data-pdx-og4fgo] .splash { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; background: #1d1d2e; }\\n  [data-pdx-og4fgo] .splash-brand { color: white; font-size: 2.5rem; font-weight: 800; }\\n  [data-pdx-og4fgo] .splash-sub { color: rgba(255,255,255,0.5); font-size: 0.9rem; margin-top: 8px; }\\n";
}

component('pdx-app-shell', {
  props: {},
  setup(ctx) {
    const __appReady = signal(false, { name: 'app-shell:appReady' });
    const __navigating = signal(false, { name: 'app-shell:navigating' });
    const __activeLang = signal(getLocale()(), { name: 'app-shell:activeLang' });
// Redirect: / → /dashboard (declared here, auto-registered in __pdx_redirects)
    
    
    // i18n bootstrap
    initI18n({ locales: ['en', 'it'], default: 'en', detect: true, persist: true });
    
    loadTranslations('en', enMessages);
    
    loadTranslations('it', itMessages);
    
    
    // Permissions — simulates auth response from .NET backend
    // 'admin' permission is NOT set → /admin guard will block
    setPermissions(['users.view', 'tasks.manage']);
    
    
    // App bootstrap — simulates async init (auth, config, etc.)
    
    setTimeout(() => { __appReady.set(true); }, 400);
    
    
    // Navigation middleware — loading indicator
    
    onBeforeNavigate((_from, _to) => {
      __navigating.set(true);
      return true;
    });
    
    onAfterNavigate((_from, _to) => {
      __navigating.set(false);
    });
    
    
    
    const store = useTasks();
    const taskCount = computed(() => store.stats().total, { name: 'app-shell:taskCount' });
    
    
    
    
    
    
    function goTo(target) {
      navigate(target);
    }
    
    function goToUser(id) {
      // Navigate with virtual state (not in URL)
      navigate('/users/:id(number)', { id: String(id) }, { fromList: true, timestamp: Date.now() });
    }
    
    function switchLocale(lang) {
      setLocale(lang);
      __activeLang.set(lang);
    }
    const currentPage = computed(() => currentPath(), { name: 'app-shell:currentPage' });
    const formattedRevenue = computed(() => $n(98750.5, { style: 'currency', currency: 'EUR' }), { name: 'app-shell:formattedRevenue' });
    useHead({ meta: [{ name: "description", content: "TaskMgr — PDX UI showcase: Router v2 features" }] });
    ctx.el.setAttribute('data-pdx-og4fgo', '');
    return { appReady: __appReady, navigating: __navigating, currentPage, store, taskCount, formattedRevenue, activeLang: __activeLang, goTo, goToUser, switchLocale };
  },
  render: (ctx) => html\`
  \${when(() => awaitReady(ctx.appReady()), () => html\`
    <div class="app">
      <nav class="navbar">
        <span class="brand">TaskMgr</span>
        <button @click=\${safeHandler(() => ctx.goTo('/dashboard'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.currentPage() === '/dashboard' ? 'active' : ''}>\${() => $t('nav.dashboard')}</button>
        <button @click=\${safeHandler(() => ctx.goTo('/create'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.currentPage() === '/create' ? 'active' : ''}>\${() => $t('nav.newTask')}</button>
        <button @click=\${safeHandler(() => ctx.goTo('/settings'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.currentPage() === '/settings' ? 'active' : ''}>\${() => $t('nav.settings')}</button>
        <button @click=\${safeHandler(() => ctx.goToUser(1), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.currentPage().startsWith('/users') ? 'active' : ''}>User #1</button>
        <button @click=\${safeHandler(() => ctx.goTo('/admin'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.currentPage() === '/admin' ? 'active' : ''}>🔒 Admin</button>
        <button @click=\${safeHandler(() => ctx.goTo('/components'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.currentPage() === '/components' ? 'active' : ''}>🧩 Components</button>

        <div class="locale-switch">
          <button @click=\${safeHandler(() => ctx.switchLocale('en'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.activeLang() === 'en' ? 'lang-active' : ''} class="lang-btn">EN</button>
          <button @click=\${safeHandler(() => ctx.switchLocale('it'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.activeLang() === 'it' ? 'lang-active' : ''} class="lang-btn">IT</button>
        </div>
      </nav>

      \${when(() => ctx.navigating(), () => html\`
        <div class="nav-loading">\${() => $t('app.navigating')}</div>
      \`, null)}<main class="page-content">
        <pdx-router-outlet></pdx-router-outlet>
      </main>

      <footer class="app-footer">
        <span>\${() => $t('footer.brand')}</span>
        <span class="stats">\${() => $t('common.items', { count: ctx.taskCount() })} | \${ctx.formattedRevenue}</span>
        <span class="page-indicator">\${ctx.currentPage}</span>
      </footer>
    </div>
  \`, () => html\`
    <div class="splash">
      <div class="splash-brand">TaskMgr</div>
      <div class="splash-sub">\${() => $t('app.loading')}</div>
    </div>
  \`)}\`,
});
"
`;

exports[`compile golden — demo corpus > showcase/components-page.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal, useHead, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-7lnk9y");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-7lnk9y"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-7lnk9y] .components { max-width: 700px; }\\n  [data-pdx-7lnk9y] .components h1 { font-size: 1.4rem; margin: 0 0 4px; }\\n  [data-pdx-7lnk9y] .subtitle { font-size: 0.85rem; color: #888; margin: 0 0 24px; }\\n  [data-pdx-7lnk9y] section { background: white; border-radius: 10px; padding: 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 24px; }\\n  [data-pdx-7lnk9y] h2 { font-size: 1.1rem; margin: 0 0 8px; }\\n  [data-pdx-7lnk9y] h3 { font-size: 0.8rem; font-weight: 600; color: #666; margin: 16px 0 6px; text-transform: uppercase; letter-spacing: 0.03em; }\\n  [data-pdx-7lnk9y] .hint { font-size: 0.75rem; color: #aaa; margin: 0 0 12px; }\\n  [data-pdx-7lnk9y] .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\\n  [data-pdx-7lnk9y] .log { margin-top: 12px; font-size: 0.8rem; font-family: monospace; padding: 8px 12px; background: #f5f5f7; border-radius: 6px; color: #888; }\\n";
}

component('pdx-components-page', {
  props: {},
  setup(ctx) {
    const __btnLog = signal('Click a button...', { name: 'components-page:btnLog' });
    const __loading1 = signal(false, { name: 'components-page:loading1' });
    const __loading2 = signal(false, { name: 'components-page:loading2' });
function flashBtn(e) {
        var btn = e.target;
        var original = btn.textContent;
        btn.textContent = '✓ Done!';
        __btnLog.set('Clicked: ' + original.trim());
        setTimeout(function() { btn.textContent = original; }, 1000);
    }
    
    function doLoad1() {
        __loading1.set(true);
        __btnLog.set('Saving...');
        setTimeout(function() { __loading1.set(false); __btnLog.set('Saved successfully!'); }, 1500);
    }
    
    function doLoad2() {
        __loading2.set(true);
        __btnLog.set('Deleting...');
        setTimeout(function() { __loading2.set(false); __btnLog.set('Deleted.'); }, 1500);
    }
    useHead({ title: "Components — PDX Showcase" });
    ctx.el.setAttribute('data-pdx-7lnk9y', '');
    return { btnLog: __btnLog, loading1: __loading1, loading2: __loading2, flashBtn, doLoad1, doLoad2 };
  },
  render: (ctx) => html\`
  <div class="components">
    <h1>PDX Components</h1>
    <p class="subtitle">Interactive component showcase. Click buttons to test, type in inputs, open dialogs.</p>

    <section>
      <h2>Button</h2>
      <p class="hint">8 variants. Click any button — it shows feedback for 1 second.</p>

      <h3>Primary variants</h3>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Primary</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Secondary</button>
        <button class="pdx-ghost" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Ghost</button>
      </div>

      <h3>Semantic variants</h3>
      <div class="row">
        <button class="pdx-danger" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Danger</button>
        <button class="pdx-success" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Success</button>
        <button class="pdx-warning" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Warning</button>
        <button class="pdx-info" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Info</button>
      </div>

      <h3>Sizes</h3>
      <div class="row">
        <button class="pdx-primary" size="sm" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Small</button>
        <button class="pdx-primary" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Default</button>
        <button class="pdx-primary" size="lg" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Large</button>
      </div>

      <h3>Loading (click to trigger)</h3>
      <div class="row">
        <button class="pdx-primary" :class=\${() => ctx.loading1() ? 'pdx-loading' : ''} :disabled=\${ctx.loading1} @click=\${safeHandler(ctx.doLoad1, ctx.el?.tagName?.toLowerCase(), 'click')}>
          \${when(() => ctx.loading1(), () => html\` Saving... \`, () => html\` Save Changes \`)}
        </button>
        <button class="pdx-danger" :class=\${() => ctx.loading2() ? 'pdx-loading' : ''} :disabled=\${ctx.loading2} @click=\${safeHandler(ctx.doLoad2, ctx.el?.tagName?.toLowerCase(), 'click')}>
          \${when(() => ctx.loading2(), () => html\` Deleting... \`, () => html\` Delete Item \`)}
        </button>
      </div>

      <h3>Disabled</h3>
      <div class="row">
        <button class="pdx-primary" disabled>Primary</button>
        <button class="pdx-secondary" disabled>Secondary</button>
        <button class="pdx-danger" disabled>Danger</button>
      </div>

      <h3>Button Group</h3>
      <div class="pdx-btn-group">
        <button class="pdx-secondary" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Left</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Center</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.flashBtn, ctx.el?.tagName?.toLowerCase(), 'click')}>Right</button>
      </div>

      <div class="log">\${ctx.btnLog}</div>
    </section>
  </div>
\`,
});

// Auto-route: @page '/components'
if(!globalThis.__pdx_routes)globalThis.__pdx_routes=[];
const __pdx_pushRoute=(r)=>{const i=globalThis.__pdx_routes.findIndex(x=>x.path===r.path);if(i>=0)globalThis.__pdx_routes[i]=r;else globalThis.__pdx_routes.push(r);globalThis.__pdx_routeRegistered&&globalThis.__pdx_routeRegistered(r.path);};
__pdx_pushRoute({path:"/components",tag:"pdx-components-page",lazy:true,file:'./components-page.pdx'});
"
`;


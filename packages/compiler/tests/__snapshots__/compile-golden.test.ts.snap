exports[`compile golden — demo corpus > showcase/stats-card.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-u033yi");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-u033yi"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-u033yi] .stats-card { background: white; border-radius: 10px; padding: 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }\\n  [data-pdx-u033yi] .stats-card h2 { font-size: 1.1rem; margin: 0 0 0.8rem 0; }\\n  [data-pdx-u033yi] .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; text-align: center; }\\n  [data-pdx-u033yi] .stat-value { font-size: 1.6rem; font-weight: 700; color: #3949ab; }\\n  [data-pdx-u033yi] .stat-label { font-size: 0.7rem; color: #999; text-transform: uppercase; letter-spacing: 0.5px; }\\n  [data-pdx-u033yi] .progress-bar { height: 6px; background: #e8eaf6; border-radius: 3px; margin-top: 12px; overflow: hidden; }\\n  [data-pdx-u033yi] .progress-fill { height: 100%; background: #4caf50; border-radius: 3px; transition: width 0.3s ease; }\\n";
}

component('pdx-stats-card', {
  props: {
    total: { type: Number, default: 0 },
    done: { type: Number, default: 0 }
  },
  setup(ctx) {
    const total = ctx.total;
    const done = ctx.done;
    const pending = computed(() => (Number(total()) || 0) - (Number(done()) || 0), { name: 'stats-card:pending' });
    const percent = computed(() => (Number(total()) || 0) > 0 ? Math.round((Number(done()) || 0) / (Number(total()) || 1) * 100) : 0, { name: 'stats-card:percent' });
    const barStyle = computed(() => \`width: \${percent()}%\`, { name: 'stats-card:barStyle' });
    ctx.el.setAttribute('data-pdx-u033yi', '');
    return { pending, percent, barStyle };
  },
  render: (ctx) => html\`

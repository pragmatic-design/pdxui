    <!-- ═══ Scrollable Content ═══ -->
    <pdx-demo-comp-bottom-sheet-scrollable class="demo-section"></pdx-demo-comp-bottom-sheet-scrollable>

    <!-- ═══ With Close Button ═══ -->
    <pdx-demo-comp-bottom-sheet-close-button class="demo-section"></pdx-demo-comp-bottom-sheet-close-button>

    <!-- ═══ No Handle ═══ -->
    <pdx-demo-comp-bottom-sheet-no-handle class="demo-section"></pdx-demo-comp-bottom-sheet-no-handle>

    <!-- ═══ Action Sheet ═══ -->

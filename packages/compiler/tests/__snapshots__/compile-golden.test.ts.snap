rflow-y: auto; }\\n  \\n  [data-pdx-luqdaw] .sidebar-search {\\n    display: flex;\\n    align-items: center;\\n    gap: 6px;\\n    padding: 8px 12px;\\n    border-bottom: 1px solid var(--pdx-color-border);\\n    flex-shrink: 0;\\n    position: sticky;\\n    top: 0;\\n    background: var(--pdx-color-surface);\\n    z-index: 2;\\n  }\\n  [data-pdx-luqdaw] .sidebar-search-icon { flex-shrink: 0; color: var(--pdx-color-muted); display: inline-flex; }\\n  [data-pdx-luqdaw] .sidebar-search-input {\\n    flex: 1;\\n    border: none;\\n    background: transparent;\\n    color: var(--pdx-color-text);\\n    font-size: 0.8rem;\\n    outline: none;\\n    min-width: 0;\\n  }\\n  [data-pdx-luqdaw] .sidebar-search-input::placeholder { color: var(--pdx-color-muted); }\\n  [data-pdx-luqdaw] .sidebar-close {\\n    display: none;\\n    align-items: center;\\n    justify-content: center;\\n    background: none;\\n    border: none;\\n    cursor: pointer;\\n    color: var(--pdx-color-muted);\\n    padding: 2px;\\n    border-radius: var(--pdx-radius-sm);\\n    flex-shrink: 0;\\n  }\\n  [data-pdx-luqdaw] .sidebar-close:hover { background: var(--pdx-color-inset); color: var(--pdx-color-text); }\\n  [data-pdx-luqdaw] .sidebar-close pdx-icon { display: inline-flex; }\\n  \\n  [data-pdx-luqdaw] .sidebar pdx-nav-menu {\\n    --pdx-nav-level1-size: 0.82rem;\\n    --pdx-nav-level1-indent: 10px;\\n    --pdx-nav-level1-group-weight: 600;\\n    --pdx-nav-level1-group-color: var(--pdx-color-text);\\n    --pdx-nav-level1-group-space: 4px;\\n    --pdx-nav-level2-size: 0.76rem;\\n    --pdx-nav-level2-group-weight: 400;\\n    --pdx-nav-level2-group-space: 2px;\\n    --pdx-nav-level3-size: 0.72rem;\\n    --pdx-nav-level3-indent: 48px;\\n  }\\n\\n  [data-pdx-luqdaw] .content {\\n    overflow-y: auto;\\n    padding: 32px 40px;\\n    max-width: 100%;\\n    min-width: 0;\\n  }\\n  \\n  [data-pdx-luqdaw] .content section { margin-bottom: 3rem; }\\n  [data-pdx-luqdaw] .content section \\u003E h2 { margin-bottom: 0.5rem; }\\n  [data-pdx-luqdaw] .content section \\u003E h3 { margin-top: 1.5rem; margin-bottom: 0.5rem; }\\n  [data-pdx-luqdaw] .content section \\u003E p { margin-bottom: 1rem; }\\n\\n  \\n  [data-pdx-luqdaw] .page-toc {\\n    overflow-y: auto;\\n    padding: var(--pdx-space-lg) var(--pdx-space-md);\\n    border-left: 1px solid var(--pdx-color-border);\\n    font-size: 0.75rem;\\n    position: sticky;\\n    top: 52px;\\n    height: calc(100vh - 52px);\\n  }\\n  [data-pdx-luqdaw] .page-toc.toc-empty {\\n    visibility: hidden;\\n  }\\n  [data-pdx-luqdaw] .toc-title {\\n    font-size: var(--pdx-text-xs);\\n    font-weight: var(--pdx-weight-semibold);\\n    color: var(--pdx-color-muted);\\n    text-transform: uppercase;\\n    letter-spacing: 0.05em;\\n    margin-bottom: var(--pdx-space-sm);\\n    padding-left: var(--pdx-space-sm);\\n  }\\n  [data-pdx-luqdaw] .toc-nav {\\n    display: flex;\\n    flex-direction: column;\\n  }\\n  [data-pdx-luqdaw] .toc-link {\\n    display: block;\\n    padding: 4px var(--pdx-space-sm);\\n    color: var(--pdx-color-muted);\\n    text-decoration: none;\\n    border-left: 2px solid transparent;\\n    line-height: 1.5;\\n    transition: color 0.15s, border-color 0.15s;\\n    white-space: nowrap;\\n    overflow: hidden;\\n    text-overflow: ellipsis;\\n  }\\n  [data-pdx-luqdaw] .toc-link:hover {\\n    color: var(--pdx-color-text);\\n  }\\n  [data-pdx-luqdaw] .toc-link.active {\\n    color: var(--pdx-color-primary);\\n    border-left-color: var(--pdx-color-primary);\\n    font-weight: var(--pdx-weight-medium);\\n  }\\n\\n  [data-pdx-luqdaw] .menu-btn {\\n    display: none;\\n    background: none;\\n    border: none;\\n    font-size: 1.25rem;\\n    cursor: pointer;\\n    padding: 4px 8px;\\n    color: var(--pdx-color-text);\\n  }\\n\\n  \\n  [data-pdx-luqdaw] .sidebar::before {\\n    content: '';\\n    display: none;\\n  }\\n\\n  \\n  @media (max-width: 1200px) {\\n    [data-pdx-luqdaw] .app {\\n      grid-template-columns: 260px 1fr;\\n    }\\n    [data-pdx-luqdaw] .page-toc { display: none; }\\n  }\\n\\n  @media (max-width: 768px) {\\n    [data-pdx-luqdaw] .app {\\n      grid-template-columns: 1fr;\\n      overflow-x: hidden;\\n      max-width: 100vw;\\n    }\\n    [data-pdx-luqdaw] .page-toc { display: none; }\\n    [data-pdx-luqdaw] .content { min-width: 0; max-width: 100vw; padding: 20px 16px; }\\n    [data-pdx-luqdaw] .menu-btn { display: block; }\\n    \\n    [data-pdx-luqdaw] .section-label { display: none; }\\n    [data-pdx-luqdaw] .section-icon { display: inline; font-size: 1rem; }\\n    [data-pdx-luqdaw] .section-btn { padding: 4px 8px; }\\n    [data-pdx-luqdaw] .sidebar-close { display: flex; }\\n\\n    [data-pdx-luqdaw] .sidebar {\\n      position: fixed;\\n      top: 52px;\\n      left: 0;\\n      bottom: 0;\\n      width: 280px;\\n      z-index: 100;\\n      transform: translateX(-100%);\\n      transition: transform 0.25s ease;\\n      box-shadow: none;\\n    }\\n    [data-pdx-luqdaw] .sidebar.open {\\n      transform: translateX(0);\\n      box-shadow: var(--pdx-shadow-lg);\\n    }\\n    [data-pdx-luqdaw] .sidebar::before {\\n      display: block;\\n      position: fixed;\\n      top: 52px;\\n      left: 280px;\\n      right: 0;\\n      bottom: 0;\\n      background: var(--pdx-color-backdrop);\\n      pointer-events: none;\\n      opacity: 0;\\n      transition: opacity 0.25s ease;\\n    }\\n    [data-pdx-luqdaw] .sidebar.open::before {\\n      pointer-events: auto;\\n      opacity: 1;\\n    }\\n  }\\n";

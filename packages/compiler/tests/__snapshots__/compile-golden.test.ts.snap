            <pdx-input name="reference" @pdx-input=\${(e) => ctx.orderForm.fields.reference?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.orderForm.fields.reference?.onBlur()}></pdx-input>
          </pdx-form-field>
          <pdx-field-group name="customer" label="Customer">
            <div class="form-grid-2">
              <pdx-form-field name="customer.name" label="Name" required :error=\${() => ctx.orderForm.fields['customer.name']?.error()} :touched=\${() => ctx.orderForm.fields['customer.name']?.touched()} :warning=\${() => ctx.orderForm.fields['customer.name']?.warning()}>
                <pdx-input name="customer.name" @pdx-input=\${(e) => ctx.orderForm.fields['customer.name']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.orderForm.fields['customer.name']?.onBlur()}></pdx-input>
              </pdx-form-field>
              <pdx-form-field name="customer.email" label="Email" required :error=\${() => ctx.orderForm.fields['customer.email']?.error()} :touched=\${() => ctx.orderForm.fields['customer.email']?.touched()} :warning=\${() => ctx.orderForm.fields['customer.email']?.warning()}>
                <pdx-input name="customer.email" type="email" @pdx-input=\${(e) => ctx.orderForm.fields['customer.email']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.orderForm.fields['customer.email']?.onBlur()}></pdx-input>
              </pdx-form-field>
            </div>
          </pdx-field-group>
          <pdx-form-actions submitLabel="Place order"></pdx-form-actions>
        </div>
      </pdx-form>
      <div class="values">
        <span class="pdx-txt-small pdx-weight-semibold">getValues()</span>
        <pre class="pdx-txt-mono values-json">\${() => valuesJson(ctx.orderForm)}</pre>
        <span class="pdx-txt-small pdx-ink-muted">\${ctx.submitted}</span>
      </div>

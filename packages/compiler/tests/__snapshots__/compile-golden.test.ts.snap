component('pdx-demo-sortable', {
  props: {},
  setup(ctx) {
    const __items = signal([
    { id: '1', label: 'First item' },
    { id: '2', label: 'Second item' },
    { id: '3', label: 'Third item' },
    { id: '4', label: 'Fourth item' },
    { id: '5', label: 'Fifth item' },
], { name: 'demo-sortable:items' });
    const __tabs = signal([
    { id: 't1', label: 'Home' },
    { id: 't2', label: 'Profile' },
    { id: 't3', label: 'Settings' },
    { id: 't4', label: 'Help' },
], { name: 'demo-sortable:tabs' });
    const __orderLog = signal('', { name: 'demo-sortable:orderLog' });
    const __listRef = signal(null, { name: 'demo-sortable:listRef' });
    const __tabsRef = signal(null, { name: 'demo-sortable:tabsRef' });
function reorderItems(from, to) {
        var current = __items();
        var arr = current.slice();
        var moved = arr.splice(from, 1)[0];
        arr.splice(to, 0, moved);
        __items.set(arr);
        __orderLog.set(arr.map(function(i) { return i.label; }).join(' → '));
    }
    
    function reorderTabs(from, to) {
        var current = __tabs();
        var arr = current.slice();
        var moved = arr.splice(from, 1)[0];
        arr.splice(to, 0, moved);
        __tabs.set(arr);
    }
    
    const vSort = useSortable(() => __listRef(), {
        items: function() { return __items(); },
        onReorder: reorderItems,
        handle: '.grip',
    });
    
    
    const hSort = useSortable(() => __tabsRef(), {
        items: function() { return __tabs(); },
        onReorder: reorderTabs,
        axis: 'horizontal',
    });
    onMount(() => {
    __orderLog.set(__items().map(function(i) { return i.label; }).join(' → '));
    onDestroy(() => { vSort.dispose(); hSort.dispose(); });
});
    ctx.el.setAttribute('data-pdx-qui0xl', '');
    return { items: __items, tabs: __tabs, orderLog: __orderLog, listRef: __listRef, tabsRef: __tabsRef, reorderItems, reorderTabs, vSort, hSort };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Sortable List</h2>
    <p class="desc">Drag to reorder. Uses useSortable() — builds on useDrag. Ghost preview, animated gap, FLIP transitions.</p>

    <section>
      <h3>Vertical List</h3>
      <div class="list" :ref=\${ctx.listRef}>
        \${eachRow(() => ctx.items(), 'id', (item) => html\`
          <div class="list-item">
            <span class="grip">⠿</span>
            <span>\${() => item().label}</span>
          </div>
        \`)}</div>
      <pre class="log">Order: \${ctx.orderLog}</pre>
    </section>

    <section>
      <h3>Horizontal Tabs</h3>
      <div class="tabs" :ref=\${ctx.tabsRef}>
        \${eachRow(() => ctx.tabs(), 'id', (tab) => html\`
          <div class="tab">\${() => tab().label}</div>
        \`)}</div>
    </section>
  </div>
\`,
});
"
`;


exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-autocomplete/demo-comp-autocomplete-creatable.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal, when } from '@pdxui/core';

component('pdx-demo-comp-autocomplete-creatable', {
  props: {},
  setup(ctx) {
    const __tags = signal(['Bug', 'Feature', 'Enhancement', 'Documentation', 'Help Wanted', 'Good First Issue'], { name: 'demo-comp-autocomplete-creatable:tags' });
    const __tagValue = signal('', { name: 'demo-comp-autocomplete-creatable:tagValue' });
    const __createdTags = signal([], { name: 'demo-comp-autocomplete-creatable:createdTags' });
// ─── Select creatable (tags) ───
    
    
    
    
    
    function onTagCreate(e) {
      const val = e.detail.value ?? e.detail;
      __tags.set(prev => prev.slice().concat([val]));
      __createdTags.set(prev => prev.slice().concat([val]));
    }
    
    function onTagChange(e) { __tagValue.set(e.detail.value ?? e.detail); }
    return { tags: __tags, tagValue: __tagValue, createdTags: __createdTags, onTagCreate, onTagChange };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Select — Creatable Mode</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>pdx-select</code> with <code>creatable</code> prop — type a new value and press Enter or click "Create" to add it.
      Emits <code>pdx-create</code> event.
    </p>
    <div class="demo-box">
      <pdx-select
        placeholder="Pick or create a tag..."
        :options=\${ctx.tags}
        searchable
        creatable
        clearable
        @pdx-create=\${safeHandler(ctx.onTagCreate, ctx.el?.tagName?.toLowerCase(), 'pdx-create')}
        @pdx-change=\${safeHandler(ctx.onTagChange, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-select>
      <p class="pdx-txt-small pdx-ink-muted result">Tag: \${ctx.tagValue}</p>
      \${when(() => ctx.createdTags().length > 0, () => html\`
        <p class="pdx-txt-small pdx-ink-muted">Created: \${() => ctx.createdTags().join(', ')}</p>
      \`, null)}</div>
    <details class="source"><summary>Source</summary><pre><code>&lt;pdx-select
  placeholder="Pick or create a tag..."
  :options="tags"
  searchable
  creatable
  @pdx-create="onTagCreate"
  @pdx-change="onTagChange" /&gt;</code></pre></details>
  </section>
\`,
});
"
`;


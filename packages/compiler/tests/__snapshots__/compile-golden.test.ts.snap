              <pdx-input name="billing.iban" @pdx-input=\${(e) => ctx.profileForm.fields['billing.iban']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.profileForm.fields['billing.iban']?.onBlur()}></pdx-input>
            </pdx-form-field>
          </div>
        </pdx-field-group>
        <pdx-field-group name="emergency" label="Emergency contact" display="dialog">

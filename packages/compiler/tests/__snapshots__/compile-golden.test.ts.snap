            <div class="spacer"></div>
            <div class="ref-box" :ref=\${ctx.refBoxRef} data-test="reference">Reference</div>
            <div class="spacer"></div>
          </div>
        </div>
      </div>

      <div class="log" data-test="pos-log">\${ctx.posLog}</div>
    </section>

    <!-- Middleware toggles -->
    <section data-test="pos-middleware">
      <h3>Middleware Pipeline</h3>
      <p class="desc">Offset adds distance. Flip swaps side when near viewport edge (scroll down so Reference is near bottom). Shift slides along axis to stay visible.</p>
      <div class="row">
        <label><input type="checkbox" checked @change=\${safeHandler(ctx.toggleOffset, ctx.el?.tagName?.toLowerCase(), 'change')}> offset(8)</label>
        <label><input type="checkbox" checked @change=\${safeHandler(ctx.toggleFlip, ctx.el?.tagName?.toLowerCase(), 'change')}> flip()</label>
        <label><input type="checkbox" checked @change=\${safeHandler(ctx.toggleShift, ctx.el?.tagName?.toLowerCase(), 'change')}> shift()</label>
      </div>
    </section>

    <!-- Iframe positioning -->
    <section data-test="pos-iframe">
      <h3>Iframe Positioning</h3>
      <p class="desc">Floating element in the parent window positioned relative to a reference inside an iframe. Follows on scroll via autoUpdate.</p>
      <div class="iframe-container">
        <iframe :ref=\${ctx.iframeRef} srcdoc="&lt;!DOCTYPE html&gt;&lt;html&gt;&lt;body style='margin:0;padding:20px;font-family:system-ui'&gt;&lt;p style='color:#666;font-size:0.85rem'&gt;I am inside an iframe.&lt;/p&gt;&lt;button id='iframe-ref' style='padding:8px 16px;background:#3b82f6;color:white;border:none;border-radius:6px;cursor:pointer'&gt;Reference Element&lt;/button&gt;&lt;/body&gt;&lt;/html&gt;" style="width:100%;height:120px;border:1px solid #e0e0e0;border-radius:8px"></iframe>
      </div>
      <div class="log" data-test="iframe-log">\${ctx.iframeLog}</div>
    </section>

    <!-- Virtual element -->
    <section data-test="pos-virtual">
      <h3>Virtual Element (Cursor)</h3>
      <p class="desc">Move your mouse over the area below.</p>
      <div class="cursor-area" @pointermove=\${safeHandler(ctx.onCursorMove, ctx.el?.tagName?.toLowerCase(), 'pointermove')} @pointerleave=\${safeHandler(ctx.onCursorLeave, ctx.el?.tagName?.toLowerCase(), 'pointerleave')} data-test="cursor-area">
        <span class="hint">Move cursor here</span>
      </div>
    </section>
  </div>
\`,
});
"
`;


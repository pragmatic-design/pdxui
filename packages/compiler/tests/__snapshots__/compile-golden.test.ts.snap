============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-bottom-nav-preview', {
  props: {},
  setup(ctx) {
    const __navLabel = signal('Home', { name: 'demo-comp-bottom-nav-preview:navLabel' });
const navItems = [
      { key: 'home', label: 'Home', icon: 'home' },
      { key: 'search', label: 'Search', icon: 'search' },
      { key: 'add', label: 'Create', icon: 'plus-circle' },
      { key: 'messages', label: 'Messages', icon: 'message-circle' },
      { key: 'profile', label: 'Profile', icon: 'user' },
    ];
    
    
    
    
    function onNavSelect(e) {
      const nav = e.target;
      if (nav) nav.setAttribute('activekey', e.detail.key);
      __navLabel.set(e.detail.item.label);
    }
    return { navItems, navLabel: __navLabel, onNavSelect };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Preview</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click the tabs to switch. Active tab is highlighted.</p>
    <div class="phone-frame">
      <div class="phone-content">
        <p class="pdx-ink-muted pdx-txt-small phone-label" id="nav-label">\${ctx.navLabel}</p>
      </div>
      <pdx-bottom-nav :items=\${() => ctx.navItems} activekey="home" @pdx-select=\${safeHandler(ctx.onNavSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')}></pdx-bottom-nav>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-bottom-nav :items="navItems" activekey="home" @pdx-select="onSelect"&gt;
&lt;/pdx-bottom-nav&gt;

// items = [
//   { key: 'home', label: 'Home', icon: 'home' },
//   { key: 'search', label: 'Search', icon: 'search' },
//   { key: 'add', label: 'Create', icon: 'plus-circle' },
//   { key: 'messages', label: 'Messages', icon: 'message-circle' },
//   { key: 'profile', label: 'Profile', icon: 'user' },
// ]</code></pre>
    </details>
  </section>
\`,
});
"
`;


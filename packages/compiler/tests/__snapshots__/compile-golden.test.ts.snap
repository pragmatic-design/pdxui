const __blk0=staticBlock(staticMarkup(' <section> <h2 class="pdx-txt-heading">Cascading Selects</h2> <p class="pdx-txt-small pdx-ink-muted">\\n      Second select filters options based on the first select\\'s value.\\n      Uses <code>$derived</code> to recompute the filtered array reactively.\\n    </p> <div class="demo-col" style="max-width: 400px"> <div class="field"> <pdx-label text="Country"></pdx-label> <pdx-select clearable placeholder="Select country..."></pdx-select> </div> <div class="field"> <pdx-label text="City"></pdx-label> <pdx-select labelField="name" valueField="id" searchable clearable placeholder="Select city..."></pdx-select> </div> </div> <details class="source"><summary>Source</summary><pre><code>let selectedCountry = $signal(\\'\\');\\n\\nconst filteredCities = $derived(\\n  cities.filter(c =&gt; !selectedCountry || c.country === selectedCountry)\\n);\\n\\nfunction onCountryChange(e) {\\n  selectedCountry = e.detail.value;\\n}\\n\\n&lt;pdx-select :options="cascadeCountries" clearable\\n  @value-change="onCountryChange" placeholder="Select country..." /&gt;\\n\\n&lt;pdx-select :options="filteredCities" labelField="name" valueField="id"\\n  :disabled="!selectedCountry" searchable clearable\\n  placeholder="Select city..." /&gt;</code></pre></details> </section> '));
const __walk0=(r)=>{const __el0=r.firstChild.nextSibling;const __el4=__el0.firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling;const __el5=__el4.firstChild.nextSibling;const __el7=__el5.firstChild.nextSibling.nextSibling.nextSibling;const __el8=__el5.nextSibling.nextSibling;const __el10=__el8.firstChild.nextSibling.nextSibling.nextSibling;return [__el7,__el10];};
component('app-demo-comp-select-cascading', {
  props: {},
  setup(ctx) {
    const __selectedCountry = signal('', { name: 'demo-comp-select-cascading:selectedCountry' });
    const __selectedCity = signal(null, { name: 'demo-comp-select-cascading:selectedCity' });
// Cascade selects
    
    
    
    const cascadeCountries = ['USA', 'UK', 'Italy', 'Japan'];
    
    
    
    function onCountryChange(e) { __selectedCountry.setRaw(e.detail.value ?? e.detail); __selectedCity.setRaw(null); }
    function onCityChange(e) { __selectedCity.setRaw(e.detail.value ?? e.detail); }
    
    const cities = [
      { id: 1, name: 'New York', country: 'USA' },
      { id: 2, name: 'Los Angeles', country: 'USA' },
      { id: 3, name: 'Chicago', country: 'USA' },
      { id: 4, name: 'London', country: 'UK' },
      { id: 5, name: 'Manchester', country: 'UK' },
      { id: 6, name: 'Edinburgh', country: 'UK' },
      { id: 7, name: 'Rome', country: 'Italy' },

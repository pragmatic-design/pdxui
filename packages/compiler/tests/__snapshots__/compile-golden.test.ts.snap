    <div class="comp-card">
      <h3 class="pdx-txt-subheading">Create Account</h3>
      <div class="comp-form">
        <pdx-form-field label="First Name" required size="sm" showError error="">
          <pdx-input placeholder="Jane"></pdx-input>
        </pdx-form-field>

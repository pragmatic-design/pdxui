      \${eachRow(() => ctx.iconNames(), (name) => name, (name) => html\`
        <div class="icon-cell">
          <pdx-icon :name=\${() => name()} size="lg"></pdx-icon>
          <span class="pdx-txt-caption">\${() => name()}</span>
        </div>
      \`)}</div>

    <details class="source-block">

component('pdx-demo-infra-container-measure', {
  props: {},
  setup(ctx) {
    const __measureLog = signal('Click "Measure"', { name: 'demo-infra-container-measure:measureLog' });
    const __boxARef = signal(null, { name: 'demo-infra-container-measure:boxARef' });
    const __boxBRef = signal(null, { name: 'demo-infra-container-measure:boxBRef' });
function doMeasure() {
        const a = __boxARef();
        const b = __boxBRef();
        if (!a || !b) return;
        const mA = measure(a);
        const mB = measure(b);
        const rel = measureRelative(a, b);
        __measureLog.set('A: ' + Math.round(mA.width) + 'x' + Math.round(mA.height) + ' at (' + Math.round(mA.x) + ', ' + Math.round(mA.y) + ')\\n' +
            'B: ' + Math.round(mB.width) + 'x' + Math.round(mB.height) + ' at (' + Math.round(mB.x) + ', ' + Math.round(mB.y) + ')\\n' +
            'Relative: dx=' + Math.round(rel.dx) + ', dy=' + Math.round(rel.dy) + ', overlap=' + rel.overlap);
    }
    ctx.el.setAttribute('data-pdx-84p4kt', '');
    return { measureLog: __measureLog, boxARef: __boxARef, boxBRef: __boxBRef, doMeasure };
  },
  render: (ctx) => html\`

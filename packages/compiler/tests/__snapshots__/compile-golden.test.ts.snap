import { component, computed, createForm, email, html, minLength, required, safeHandler, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-mmn21l");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-mmn21l"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-mmn21l] .form-card { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }\\n  [data-pdx-mmn21l] .status-bar { display: flex; gap: 6px; margin: 8px 0; }\\n  [data-pdx-mmn21l] .tag { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.75rem; }\\n  [data-pdx-mmn21l] .tag.success { background: #d4edda; color: #155724; }\\n  [data-pdx-mmn21l] .tag.error { background: #f8d7da; color: #721c24; }\\n  [data-pdx-mmn21l] .tag.info { background: #e2e3e5; color: #383d41; }\\n  [data-pdx-mmn21l] .field { margin-bottom: 10px; }\\n  [data-pdx-mmn21l] .field label { display: block; font-size: 0.8rem; color: #666; margin-bottom: 2px; }\\n  [data-pdx-mmn21l] .field input { width: 100%; padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; }\\n  [data-pdx-mmn21l] .field input:focus { border-color: #007bff; outline: none; }\\n  [data-pdx-mmn21l] .field .input-error { border-color: #dc3545; }\\n  [data-pdx-mmn21l] .err { color: #dc3545; font-size: 0.78rem; }\\n  [data-pdx-mmn21l] .form-actions { display: flex; gap: 6px; align-items: center; margin-top: 10px; }\\n  [data-pdx-mmn21l] .meta { font-size: 0.75rem; color: #888; margin-left: auto; font-family: monospace; }\\n  [data-pdx-mmn21l] button { padding: 6px 14px; border: none; border-radius: 4px; cursor: pointer; background: #007bff; color: white; }\\n  [data-pdx-mmn21l] button:hover { background: #0069d9; }\\n  [data-pdx-mmn21l] button:disabled { background: #ccc; cursor: not-allowed; }\\n  [data-pdx-mmn21l] button.secondary { background: #6c757d; }\\n  [data-pdx-mmn21l] .success-msg { margin-top: 8px; padding: 8px; background: #d4edda; color: #155724; border-radius: 4px; }\\n";
}

component('pdx-contact-form', {
  props: {},
  setup(ctx) {
    const contact = createForm({ initialValues: { name: '', email: '', message: '' }, validators: { name: [required(), minLength(3)], email: [required(), email()] } });
const handleSubmit = contact.handleSubmit(async (values) => {
        await new Promise(r => setTimeout(r, 800));
        console.log('Submitted:', values);
      });
    
    
      function onNameInput(e) { contact.fields.name.onChange(e.target.value); }
      function onNameBlur() { contact.fields.name.onBlur(); }
      function onEmailInput(e) { contact.fields.email.onChange(e.target.value); }
      function onEmailBlur() { contact.fields.email.onBlur(); }
      function onMessageInput(e) { contact.fields.message.onChange(e.target.value); }
      function resetForm() { contact.reset(); }
    const stateClass = computed(() => contact.state() === 'success' ? 'success' : contact.state() === 'error' ? 'error' : 'info', { name: 'contact-form:stateClass' });
    ctx.el.setAttribute('data-pdx-mmn21l', '');
    return { contact, stateClass, handleSubmit, onNameInput, onNameBlur, onEmailInput, onEmailBlur, onMessageInput, resetForm };
  },
  render: (ctx) => html\`
  <div class="form-card">
    <h3>Contact Form</h3>
    <div class="status-bar">
      <span class="tag" :class=\${() => ctx.stateClass()}>\${() => ctx.contact.state()}</span>
      <span class="tag" :class=\${() => ctx.contact.valid() ? 'success' : 'error'}>valid: \${() => ctx.contact.valid()}</span>
    </div>
    <form @submit=\${safeHandler(ctx.handleSubmit, ctx.el?.tagName?.toLowerCase(), 'submit')}>
      <div class="field">
        <label>Name *</label>
        <input type="text" :value=\${() => ctx.contact.fields.name.value()}
               @input=\${safeHandler(ctx.onNameInput, ctx.el?.tagName?.toLowerCase(), 'input')} @blur=\${safeHandler(ctx.onNameBlur, ctx.el?.tagName?.toLowerCase(), 'blur')}
               :class=\${() => ctx.contact.fields.name.error() ? 'input-error' : ''} />
        \${when(() => ctx.contact.fields.name.error(), () => html\`
          <span class="err">\${() => ctx.contact.fields.name.error()}</span>
        \`, null)}</div>
      <div class="field">
        <label>Email *</label>
        <input type="email" :value=\${() => ctx.contact.fields.email.value()}
               @input=\${safeHandler(ctx.onEmailInput, ctx.el?.tagName?.toLowerCase(), 'input')} @blur=\${safeHandler(ctx.onEmailBlur, ctx.el?.tagName?.toLowerCase(), 'blur')}
               :class=\${() => ctx.contact.fields.email.error() ? 'input-error' : ''} />
        \${when(() => ctx.contact.fields.email.error(), () => html\`
          <span class="err">\${() => ctx.contact.fields.email.error()}</span>
        \`, null)}</div>
      <div class="field">
        <label>Message</label>
        <input type="text" :value=\${() => ctx.contact.fields.message.value()}
               @input=\${safeHandler(ctx.onMessageInput, ctx.el?.tagName?.toLowerCase(), 'input')} />
      </div>
      <div class="form-actions">
        <button type="submit" :disabled=\${() => ctx.contact.submitting()}>
          \${when(() => ctx.contact.submitting(), () => html\` Sending... \`, () => html\` Submit \`)}
        </button>
        <button type="button" @click=\${safeHandler(ctx.resetForm, ctx.el?.tagName?.toLowerCase(), 'click')} class="secondary">Reset</button>
        <span class="meta">dirty:\${() => ctx.contact.dirty()} touched:\${() => ctx.contact.touched()}</span>
      </div>
    </form>
    \${when(() => ctx.contact.state() === 'success', () => html\`
      <div class="success-msg">Form submitted!</div>
    \`, null)}</div>
\`,
});
"
`;

exports[`compile golden — demo corpus > counter.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, onMount, safeHandler, signal, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-up7pim");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-up7pim"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-up7pim] .counter-card { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }\\n  [data-pdx-up7pim] .counter-row { display: flex; gap: 0.75rem; align-items: center; margin: 0.5rem 0; }\\n  [data-pdx-up7pim] .value { font-size: 2rem; font-weight: bold; min-width: 3rem; text-align: center; }\\n  [data-pdx-up7pim] .derived { font-size: 0.85rem; color: #666; }\\n  [data-pdx-up7pim] button { padding: 0.5rem 1rem; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; font-size: 1.2rem; }\\n  [data-pdx-up7pim] button:hover { background: #f0f0f0; }\\n  [data-pdx-up7pim] .alert { background: #fff3cd; color: #856404; padding: 0.5rem; border-radius: 4px; margin-top: 0.5rem; }\\n  [data-pdx-up7pim] .hint { color: #888; font-size: 0.85rem; margin-top: 0.5rem; }\\n";
}

component('pdx-counter', {
  props: {
    label: { type: String, default: 'Counter' },
    initial: { type: Number, default: 0 }
  },
  setup(ctx) {
    const label = ctx.label;
    const initial = ctx.initial;
    const __count = signal(ctx.initial.peek(), { name: 'counter:count' });
function inc() { __count.set(__v => __v + 1); }
      function dec() { __count.set(__v => __v - 1); }
    const doubled = computed(() => __count() * 2, { name: 'counter:doubled' });
    onMount(() => console.log('Counter mounted:', label()));
    ctx.el.setAttribute('data-pdx-up7pim', '');
    return { count: __count, doubled, inc, dec };
  },
  render: (ctx) => html\`
  <div class="counter-card">
    <h3>\${ctx.label}</h3>
    <div class="counter-row">
      <button @click=\${safeHandler(ctx.dec, ctx.el?.tagName?.toLowerCase(), 'click')}>−</button>
      <span class="value">\${ctx.count}</span>
      <button @click=\${safeHandler(ctx.inc, ctx.el?.tagName?.toLowerCase(), 'click')}>+</button>
    </div>
    <span class="derived">doubled: \${ctx.doubled}</span>
    \${when(() => ctx.count() > 5, () => html\`
      <div class="alert">Count is greater than 5!</div>
    \`, () => html\`
      <div class="hint">Click + to go above 5</div>
    \`)}
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > effect-test.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, effect, html, onMount, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-tt8bks");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-tt8bks"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-tt8bks] .effect-demo { padding: 1rem; background: white; border-radius: 8px; }\\n";
}

component('pdx-effect-test', {
  props: {
    initial: { type: Number, default: 0 }
  },
  setup(ctx) {
    const initial = ctx.initial;
    const __count = signal(0, { name: 'effect-test:count' });
    const __mountMsg = signal('not mounted', { name: 'effect-test:mountMsg' });
function inc() { __count.set(__v => __v + 1); }
    const doubled = computed(() => __count() * 2, { name: 'effect-test:doubled' });
    ctx.track(() => {
    if (__count() > 10) {
      console.log('count exceeded 10:', __count());
    }
  }, { name: "effect-test.pdx:25" });
    onMount(() => {
    __count.set(initial());
    __mountMsg.set('mounted with ' + initial());
  });
    ctx.el.setAttribute('data-pdx-tt8bks', '');
    return { count: __count, mountMsg: __mountMsg, doubled, inc };
  },
  render: (ctx) => html\`
  <div class="effect-demo">
    <h3>Effect/Lifecycle Test</h3>
    <div>Count: \${ctx.count}</div>
    <div>Doubled: \${ctx.doubled}</div>
    <div>Mount message: \${ctx.mountMsg}</div>
    <button @click=\${safeHandler(ctx.inc, ctx.el?.tagName?.toLowerCase(), 'click')}>+</button>
  </div>
\`,
});
"
`;


              <pdx-input name="address.street" @pdx-input=\${(e) => ctx.displayForm.fields['address.street']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.displayForm.fields['address.street']?.onBlur()}></pdx-input>
            </pdx-form-field>
            <pdx-form-field name="address.city" label="City" :error=\${() => ctx.displayForm.fields['address.city']?.error()} :touched=\${() => ctx.displayForm.fields['address.city']?.touched()} :warning=\${() => ctx.displayForm.fields['address.city']?.warning()}>
              <pdx-input name="address.city" @pdx-input=\${(e) => ctx.displayForm.fields['address.city']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.displayForm.fields['address.city']?.onBlur()}></pdx-input>
            </pdx-form-field>
            <pdx-form-field name="address.zip" label="ZIP" :error=\${() => ctx.displayForm.fields['address.zip']?.error()} :touched=\${() => ctx.displayForm.fields['address.zip']?.touched()} :warning=\${() => ctx.displayForm.fields['address.zip']?.warning()}>
              <pdx-input name="address.zip" @pdx-input=\${(e) => ctx.displayForm.fields['address.zip']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.displayForm.fields['address.zip']?.onBlur()}></pdx-input>
            </pdx-form-field>

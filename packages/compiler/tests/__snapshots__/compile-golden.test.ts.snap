exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-autocomplete/demo-comp-autocomplete-remote.pdx 1`] = `
"// 0 warning(s)

============================================================
import { arrayTransport, component, createDataSource, delayTransport, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-autocomplete-remote', {
  props: {},
  setup(ctx) {
    const __countryValue = signal('', { name: 'demo-comp-autocomplete-remote:countryValue' });
// ─── Remote DataSource (simulated) ───
    const allCountries = [
      { name: 'Afghanistan', code: 'AF' }, { name: 'Albania', code: 'AL' }, { name: 'Algeria', code: 'DZ' },
      { name: 'Argentina', code: 'AR' }, { name: 'Australia', code: 'AU' }, { name: 'Austria', code: 'AT' },
      { name: 'Belgium', code: 'BE' }, { name: 'Brazil', code: 'BR' }, { name: 'Canada', code: 'CA' },
      { name: 'Chile', code: 'CL' }, { name: 'China', code: 'CN' }, { name: 'Colombia', code: 'CO' },
      { name: 'Czech Republic', code: 'CZ' }, { name: 'Denmark', code: 'DK' }, { name: 'Egypt', code: 'EG' },
      { name: 'Finland', code: 'FI' }, { name: 'France', code: 'FR' }, { name: 'Germany', code: 'DE' },
      { name: 'Greece', code: 'GR' }, { name: 'Hungary', code: 'HU' }, { name: 'India', code: 'IN' },
      { name: 'Indonesia', code: 'ID' }, { name: 'Ireland', code: 'IE' }, { name: 'Israel', code: 'IL' },
      { name: 'Italy', code: 'IT' }, { name: 'Japan', code: 'JP' }, { name: 'Mexico', code: 'MX' },
      { name: 'Netherlands', code: 'NL' }, { name: 'New Zealand', code: 'NZ' }, { name: 'Norway', code: 'NO' },
      { name: 'Poland', code: 'PL' }, { name: 'Portugal', code: 'PT' }, { name: 'Romania', code: 'RO' },
      { name: 'Russia', code: 'RU' }, { name: 'South Korea', code: 'KR' }, { name: 'Spain', code: 'ES' },
      { name: 'Sweden', code: 'SE' }, { name: 'Switzerland', code: 'CH' }, { name: 'Turkey', code: 'TR' },
      { name: 'Ukraine', code: 'UA' }, { name: 'United Kingdom', code: 'GB' }, { name: 'United States', code: 'US' },
    ];
    
    
    const countryDS = createDataSource({ transport: delayTransport({ transport: arrayTransport({ data: allCountries }), readDelay: 600 }), pageSize: 0 });
    
    
    
    function onCountryChange(e) { __countryValue.set(e.detail.value ?? e.detail); }
    return { allCountries, countryDS, countryValue: __countryValue, onCountryChange };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Remote Search — DataSource</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Connect to a DataSource for server-side search. Built-in debounce (300ms).
      Type at least 2 characters to search.
    </p>
    <div class="demo-box">
      <pdx-autocomplete
        placeholder="Search countries..."
        :source=\${() => ctx.countryDS}
        labelField="name"
        valueField="code"
        :debounce=\${300}
        :min-length=\${2}
        remote
        @pdx-change=\${safeHandler(ctx.onCountryChange, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-autocomplete>
      <p class="pdx-txt-small pdx-ink-muted result">Country: \${ctx.countryValue}</p>
    </div>
    <details class="source"><summary>Source</summary><pre><code>&lt;pdx-autocomplete
  placeholder="Search countries..."
  :source="countryDS"
  label-field="name"
  :debounce="300"
  :min-length="2" /&gt;

const countryDS = createDataSource({
  data: countries,
  pageSize: 0,
});</code></pre></details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-autocomplete/demo-comp-autocomplete-vs-select.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

component('pdx-demo-comp-autocomplete-vs-select', {
  props: {},
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Autocomplete vs Select</h2>
    <div class="comparison">
      <div class="comparison-col">
        <h3 class="pdx-txt-subheading">pdx-autocomplete</h3>
        <ul class="pdx-txt-small">
          <li>Value is <strong>free text</strong></li>
          <li>Suggestions are optional hints</li>
          <li>User can type anything</li>
          <li>Use for: search, address, mentions</li>
        </ul>
      </div>
      <div class="comparison-col">
        <h3 class="pdx-txt-subheading">pdx-select</h3>
        <ul class="pdx-txt-small">
          <li>Value is from a <strong>fixed list</strong></li>
          <li>Options are the only choices</li>
          <li>With <code>creatable</code>: user can add new options</li>
          <li>Use for: dropdowns, pickers, filters</li>
        </ul>
      </div>
    </div>
  </section>
\`,
});
"
`;


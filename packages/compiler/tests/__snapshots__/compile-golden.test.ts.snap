    function loadUser() { try { const saved = sessionStorage.getItem('pdx-demo-user42'); if (saved) { prefillForm.reset(JSON.parse(saved)); __prefillStatus.set('Loaded saved data'); return; } } catch {} const mockUser = { name: 'Jane Cooper', email: 'jane.cooper@acme.com', role: 'Editor', department: 'Engineering', bio: 'Senior frontend developer with 8 years of experience.' }; prefillForm.reset(mockUser); __prefillStatus.set('Loaded user #42 (mock)'); }
    function savePrefill() { const values = prefillForm.getValues(); sessionStorage.setItem('pdx-demo-user42', JSON.stringify(values)); prefillForm.reset(values); __prefillStatus.set('Saved at ' + new Date().toLocaleTimeString()); }
    function prefillStatusText() { return __prefillStatus(); }
    function prefillStatusClass() { return 'form-status-badge' + (__prefillStatus() !== 'No data loaded' ? ' active' : ''); }
    return { roleOptions, prefillForm, prefillStatus: __prefillStatus, loadUser, savePrefill, prefillStatusText, prefillStatusClass };
  },
  render: (ctx) => html\`
  <section>

"// 0 warning(s)

============================================================
import { component, html, safeHandler } from '@pdxui/core';
import { dialog } from '@pdxui/ui/dialog';

component('pdx-demo-comp-overlay-outlet-alert', {
  props: {},
  setup(ctx) {
function showAlert() {
      dialog.alert({ title: 'Export ready', message: 'report-2026-09.csv has been downloaded.' });
    }
    
    function showMessage() {
      dialog.open({ title: 'What is new in 2.4', message: 'Saved layouts, CSV export and a faster data grid.', size: 'md' });
    }
    return { showAlert, showMessage };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Alert and message dialog</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>dialog.alert()</code> has one OK button; <code>dialog.open()</code> a close button and a <code>size</code>.
      Both resolve when closed.
    </p>
    <div class="demo-row">
      <pdx-button @click=\${safeHandler(ctx.showAlert, ctx.el?.tagName?.toLowerCase(), 'click')}>Show alert</pdx-button>
      <pdx-button @click=\${safeHandler(ctx.showMessage, ctx.el?.tagName?.toLowerCase(), 'click')}>Open message dialog</pdx-button>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>await dialog.alert({ title: 'Export ready', message: 'report-2026-09.csv has been downloaded.' });
await dialog.open({ title: 'What is new in 2.4', message: '…', size: 'md' });</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-overlay-outlet/demo-comp-overlay-outlet-confirm.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler } from '@pdxui/core';
import { useOutletAnswer } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-z7siyd");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-z7siyd"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-z7siyd] .result { margin-top: var(--pdx-space-md); }\\n";
}

component('pdx-demo-comp-overlay-outlet-confirm', {
  props: {},
  setup(ctx) {
// The stacking section writes the same answer (state.pdx.ts).
    const outletAnswer = useOutletAnswer();
    const answer = computed(() => outletAnswer.answer(), { name: 'demo-comp-overlay-outlet-confirm:answer' });
    
    
    function askDelete() { outletAnswer.askDelete(); }
    function askTyped() { outletAnswer.askTyped(); }
    function askDelayed() { outletAnswer.askDelayed(); }
    ctx.el.setAttribute('data-pdx-z7siyd', '');
    return { outletAnswer, answer, askDelete, askTyped, askDelayed };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Confirm</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>await dialog.confirm({…})</code> resolves <code>true</code> on confirm, <code>false</code> on cancel or Escape.
      Focus starts on <em>Cancel</em>, the safe answer.
    </p>
    <div class="demo-row">
      <pdx-button variant="danger" @click=\${safeHandler(ctx.askDelete, ctx.el?.tagName?.toLowerCase(), 'click')}>Delete project…</pdx-button>
      <pdx-button variant="outline" @click=\${safeHandler(ctx.askTyped, ctx.el?.tagName?.toLowerCase(), 'click')}>Delete with type-to-confirm…</pdx-button>
      <pdx-button variant="outline" @click=\${safeHandler(ctx.askDelayed, ctx.el?.tagName?.toLowerCase(), 'click')}>Confirm after 3 seconds…</pdx-button>
    </div>
    <p class="pdx-txt-small result" aria-live="polite">Last answer: <strong>\${ctx.answer}</strong></p>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>async function askDelete() {
  const ok = await dialog.confirm({
    title: 'Delete project?',
    message: 'The project and its 12 files will be removed. This cannot be undone.',
    confirmLabel: 'Delete', cancelLabel: 'Keep it', variant: 'danger',
  });
  answer = ok ? 'deleted' : 'kept';
}

// Type the name to enable the button:
dialog.confirm({ title: 'Delete "atlas"?', confirmText: 'atlas', variant: 'danger' });
// The button waits 3 seconds:
dialog.confirm({ title: 'Publish now?', confirmDelay: 3 });</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-overlay-outlet/demo-comp-overlay-outlet-stacking.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler } from '@pdxui/core';
import { useOutletAnswer } from './state.pdx';

component('pdx-demo-comp-overlay-outlet-stacking', {
  props: {},
  setup(ctx) {
// Its answer shows in the confirm section (state.pdx.ts).
    const outletAnswer = useOutletAnswer();
    
    function stack() { outletAnswer.stack(); }
    return { outletAnswer, stack };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Stacking</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      A dialog opened while another is showing goes on top of it. Escape closes only the top one; the one below
      gets its focus back.
    </p>
    <div class="demo-row">
      <pdx-button @click=\${safeHandler(ctx.stack, ctx.el?.tagName?.toLowerCase(), 'click')}>Open two, one over the other</pdx-button>
    </div>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-overlay-outlet/demo-comp-overlay-outlet-why.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-w5pbb1");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-w5pbb1"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-w5pbb1] .shell { margin: var(--pdx-space-md) 0; }\\n";
}

component('pdx-demo-comp-overlay-outlet-why', {
  props: {},
  setup(ctx) {
    ctx.el.setAttribute('data-pdx-w5pbb1', '');
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Why an app needs one</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      A <code>&lt;pdx-dialog&gt;</code> lives in your template, next to the state that opens it. A question asked from
      a function — "discard changes?" in a save handler, a confirmation before a delete — has no template to live in.
      The service puts it in the queue, and the outlet is the one place in the page that renders it. Mount it
      <strong>once</strong>, in the app shell, as the last child of the layout:
    </p>
    <pre class="pdx-txt-mono shell"><code>&lt;!-- app.pdx --&gt;
&lt;pdx-app-layout&gt;
  …
  &lt;pdx-router-outlet&gt;&lt;/pdx-router-outlet&gt;
&lt;/pdx-app-layout&gt;
&lt;pdx-overlay-outlet&gt;&lt;/pdx-overlay-outlet&gt;</code></pre>
    <p class="pdx-txt-small pdx-ink-muted">
      A form's <code>warnUnsaved</code> guard asks through the same queue, and mounts an outlet itself when the page has none.
    </p>
  </section>
\`,
});
"
`;


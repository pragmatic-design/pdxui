  __pdx_style.textContent = "\\n[data-pdx-31vk8l] .page { max-width: 960px; }\\n[data-pdx-31vk8l] .intro { margin-bottom: var(--pdx-space-xl); }\\n[data-pdx-31vk8l] section { margin-bottom: var(--pdx-space-3xl); }\\n[data-pdx-31vk8l] .section-heading { margin-bottom: var(--pdx-space-sm); }\\n[data-pdx-31vk8l] .ct-verdict { font-size: 0.75rem; font-weight: 600; }\\n[data-pdx-31vk8l] .ct-verdict.ok { color: var(--pdx-color-success); }\\n[data-pdx-31vk8l] .ct-verdict.bad { color: var(--pdx-color-danger); }\\n";

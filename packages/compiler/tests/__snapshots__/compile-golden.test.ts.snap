"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-clwost");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-clwost"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-clwost] .anim-grid {\\n    display: flex;\\n    gap: var(--pdx-space-md);\\n    margin-top: var(--pdx-space-md);\\n    flex-wrap: wrap;\\n  }\\n  [data-pdx-clwost] .anim-cell {\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    gap: var(--pdx-space-xs);\\n  }\\n  [data-pdx-clwost] .anim-box {\\n    width: 100px;\\n    height: 60px;\\n    display: flex;\\n    align-items: center;\\n    justify-content: center;\\n    background: var(--pdx-primary-100);\\n    border: 1px solid var(--pdx-primary-300);\\n    border-radius: var(--pdx-radius-md);\\n    font-size: var(--pdx-text-sm);\\n    color: var(--pdx-primary-800);\\n    font-weight: var(--pdx-weight-medium);\\n  }\\n";
}

component('pdx-demo-design-animations-entrance', {
  props: {},
  setup(ctx) {
    const __playing = signal(false, { name: 'demo-design-animations-entrance:playing' });
function play() {
        __playing.set(false);
        setTimeout(() => { __playing.set(true); }, 30);
    }
    ctx.el.setAttribute('data-pdx-clwost', '');
    return { playing: __playing, play };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Entrance Animations</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click "Play" to trigger each animation. The class is added dynamically.</p>

    <button class="pdx-primary" style="margin-bottom:var(--pdx-space-md)" @click=\${safeHandler(ctx.play, ctx.el?.tagName?.toLowerCase(), 'click')}>Play Animations</button>

    <div class="anim-grid">
      <div class="anim-cell">
        <div class="anim-box" :class=\${() => ctx.playing() ? 'pdx-animate-fade-in' : 'anim-idle'}>fade-in</div>
        <span class="pdx-txt-caption pdx-ink-muted">.pdx-animate-fade-in</span>
      </div>
      <div class="anim-cell">
        <div class="anim-box" :class=\${() => ctx.playing() ? 'pdx-animate-slide-up' : 'anim-idle'}>slide-up</div>
        <span class="pdx-txt-caption pdx-ink-muted">.pdx-animate-slide-up</span>
      </div>
      <div class="anim-cell">
        <div class="anim-box" :class=\${() => ctx.playing() ? 'pdx-animate-slide-down' : 'anim-idle'}>slide-down</div>
        <span class="pdx-txt-caption pdx-ink-muted">.pdx-animate-slide-down</span>
      </div>
      <div class="anim-cell">
        <div class="anim-box" :class=\${() => ctx.playing() ? 'pdx-animate-scale-in' : 'anim-idle'}>scale-in</div>
        <span class="pdx-txt-caption pdx-ink-muted">.pdx-animate-scale-in</span>
      </div>
      <div class="anim-cell">
        <div class="anim-box" :class=\${() => ctx.playing() ? 'pdx-animate-bounce' : 'anim-idle'}>bounce</div>
        <span class="pdx-txt-caption pdx-ink-muted">.pdx-animate-bounce</span>
      </div>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;div class="pdx-animate-fade-in"&gt;Fades in&lt;/div&gt;
&lt;div class="pdx-animate-slide-up"&gt;Slides up&lt;/div&gt;
&lt;div class="pdx-animate-slide-down"&gt;Slides down&lt;/div&gt;
&lt;div class="pdx-animate-scale-in"&gt;Scales in&lt;/div&gt;
&lt;div class="pdx-animate-bounce"&gt;Bounces&lt;/div&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


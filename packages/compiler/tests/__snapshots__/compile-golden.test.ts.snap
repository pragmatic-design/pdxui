exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-badge/demo-comp-badge-interactive.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-badge-interactive', {
  props: {},
  setup(ctx) {
    const __notifCount = signal(3, { name: 'demo-comp-badge-interactive:notifCount' });
// Interactive demo
    
    
    function notifStr() { return '' + __notifCount(); }
    
    function addNotif() {
        __notifCount.set(prev => prev + 1);
    }
    
    function removeNotif() {
        if (__notifCount() > 0) __notifCount.set(prev => prev - 1);
    }
    
    function clearNotif() {
        __notifCount.set(0);
    }
    return { notifCount: __notifCount, notifStr, addNotif, removeNotif, clearNotif };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Interactive Demo</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click to increment/decrement. Badge uses <code>aria-live="polite"</code> — screen readers announce count changes.</p>

    <div class="demo-row">
      <span class="pdx-badge-anchor">
        <pdx-button variant="ghost" aria-label="Notifications"><pdx-icon name="bell" size="md"></pdx-icon></pdx-button>
        <pdx-badge variant="danger" :value=\${() => ctx.notifStr()}></pdx-badge>
      </span>
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.addNotif, ctx.el?.tagName?.toLowerCase(), 'click')}>+ Add</pdx-button>
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.removeNotif, ctx.el?.tagName?.toLowerCase(), 'click')}>- Remove</pdx-button>
      <pdx-button variant="ghost" size="sm" @click=\${safeHandler(ctx.clearNotif, ctx.el?.tagName?.toLowerCase(), 'click')}>Clear</pdx-button>
      <span class="pdx-txt-small pdx-ink-muted">Count: \${ctx.notifCount}</span>
    </div>
  </section>
\`,
});
"
`;


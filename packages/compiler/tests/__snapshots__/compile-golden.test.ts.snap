const __blk0=staticBlock((__frag,__d)=>{__frag.appendChild(__d.createTextNode(" "));const __el0=__d.createElement('section');__frag.appendChild(__el0);__el0.appendChild(__d.createTextNode(" "));const __el1=__d.createElement('h2');__el0.appendChild(__el1);__el1.setAttribute("class", "pdx-txt-heading section-heading");__el1.appendChild(__d.createTextNode("Custom Value Rendering"));__el0.appendChild(__d.createTextNode(" "));const __el2=__d.createElement('p');__el0.appendChild(__el2);__el2.setAttribute("class", "pdx-txt-small pdx-ink-muted");__el2.appendChild(__d.createTextNode("Use "));const __el3=__d.createElement('code');__el2.appendChild(__el3);__el3.appendChild(__d.createTextNode("render-value"));__el2.appendChild(__d.createTextNode(" callback to render badges, links, or custom HTML for each value."));__el0.appendChild(__d.createTextNode(" "));const __el4=__d.createElement('div');__el0.appendChild(__el4);__el4.setAttribute("class", "demo-container");__el4.appendChild(__d.createTextNode(" "));const __el5=__d.createElement('pdx-description-list');__el4.appendChild(__el5);__el5.setAttribute("label-width", "120px");__el4.appendChild(__d.createTextNode(" "));__el0.appendChild(__d.createTextNode(" "));const __el6=__d.createElement('details');__el0.appendChild(__el6);__el6.setAttribute("class", "source-block");__el6.appendChild(__d.createTextNode(" "));const __el7=__d.createElement('summary');__el6.appendChild(__el7);__el7.appendChild(__d.createTextNode("Source"));__el6.appendChild(__d.createTextNode(" "));const __el8=__d.createElement('pre');__el6.appendChild(__el8);__el8.setAttribute("class", "pdx-txt-mono");const __el9=__d.createElement('code');__el8.appendChild(__el9);__el9.appendChild(__d.createTextNode("const items = [\\n  { label: 'Status', value: 'Active', type: 'badge' },\\n  { label: 'Website', value: 'https://example.com', type: 'link' },\\n  { label: 'Tags', value: 'admin,editor', type: 'tags' },\\n];\\n\\nfunction renderValue(item) {\\n  if (item.type === 'badge') {\\n    const span = document.createElement('span');\\n    span.className = 'pdx-badge pdx-badge-success';\\n    span.textContent = item.value;\\n    return span;\\n  }\\n  if (item.type === 'link') {\\n    const a = document.createElement('a');\\n    a.href = sanitizeUrl(item.value) || '#'; // block javascript:/data: (good practice, in demos too)\\n    a.textContent = item.value;\\n    return a;\\n  }\\n  if (item.type === 'tags') {\\n    const div = document.createElement('div');\\n    item.value.split(',').forEach(t =\\u003E {\\n      const chip = document.createElement('pdx-chip');\\n      chip.setAttribute('label', t.trim());\\n      chip.setAttribute('size', 'sm');\\n      div.appendChild(chip);\\n    });\\n    return div;\\n  }\\n  return null; // fallback to default string render\\n}\\n\\n\\u003Cpdx-description-list :items=\\"items\\"\\n  :render-value=\\"renderValue\\"\\u003E\\n\\u003C/pdx-description-list\\u003E"));__el6.appendChild(__d.createTextNode(" "));__el0.appendChild(__d.createTextNode(" "));__frag.appendChild(__d.createTextNode(" "));});
const __walk0=(r)=>{const __el0=r.firstChild.nextSibling;const __el4=__el0.firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling;const __el5=__el4.firstChild.nextSibling;return [__el5];};
component('pdx-demo-comp-description-list-custom-value', {
  props: {},
  setup(ctx) {
const customItems = [
      { label: 'Name', value: 'Alice Johnson' },
      { label: 'Status', value: 'Active', type: 'badge-success' },
      { label: 'Website', value: 'https://example.com', type: 'link' },
      { label: 'Tags', value: 'admin,editor,viewer', type: 'tags' },
      { label: 'Progress', value: '75', type: 'progress' },
    ];
    
    
    function renderCustomValue(item) {
      if (item.type === 'badge-success') {
        const span = document.createElement('span');
        span.style.cssText = 'display:inline-flex;padding:2px 10px;border-radius:9999px;font-size:0.75rem;font-weight:600;background:var(--pdx-color-success);color:#fff';
        span.textContent = item.value;
        return span;
      }
      if (item.type === 'link') {
        const a = document.createElement('a');
        a.href = '#';
        a.style.color = 'var(--pdx-color-primary)';
        a.textContent = item.value;
        return a;
      }
      if (item.type === 'tags') {
        const div = document.createElement('div');
        div.style.cssText = 'display:flex;gap:4px;flex-wrap:wrap';
        item.value.split(',').forEach(function(tag) {
          const chip = document.createElement('pdx-chip');
          chip.setAttribute('label', tag.trim());
          chip.setAttribute('size', 'sm');
          div.appendChild(chip);
        });
        return div;
      }
      if (item.type === 'progress') {
        const wrap = document.createElement('div');

        _applyDensity(key);
        localStorage.setItem('pdx-density', key);
    }
    
    function setDark(isDark) {
        __dark.set(isDark);
        _applyScheme(isDark);
        localStorage.setItem('pdx-scheme', isDark ? 'dark' : 'light');
    }
    
    function onThemeSelect(e) { setTheme(e.detail.key); }
    function onDensitySelect(e) { setDensity(e.detail.key); }
    function toggleMode() { setDark(!__dark()); }
    function toggleSettings() { __settingsOpen.set(prev => !prev); }
    
    _applyTheme(__theme());
    
    _applyScheme(__dark());
    
    document.documentElement.setAttribute('pdx-density', __density());
    
    if (__density() !== 'normal') document.documentElement.style.setProperty('--pdx-density-factor', _densityMap[__density()] || '1');
    ctx.el.setAttribute('data-pdx-mwg9c1', '');
    return { themeItems, densityItems, theme: __theme, density: __density, dark: __dark, settingsOpen: __settingsOpen, themeLabel, densityLabel, modeIcon, setTheme, setDensity, setDark, onThemeSelect, onDensitySelect, toggleMode, toggleSettings };
  },
  render: (ctx) => html\`
  <div class="settings">
    <pdx-dropdown-menu :label=\${ctx.themeLabel} :items=\${() => ctx.themeItems} icon="palette" variant="ghost" size="xs" @pdx-select=\${safeHandler(ctx.onThemeSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')}></pdx-dropdown-menu>
    <pdx-dropdown-menu :label=\${ctx.densityLabel} :items=\${() => ctx.densityItems} icon="sliders" variant="ghost" size="xs" @pdx-select=\${safeHandler(ctx.onDensitySelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')}></pdx-dropdown-menu>
    <button class="mode-btn" @click=\${safeHandler(ctx.toggleMode, ctx.el?.tagName?.toLowerCase(), 'click')} id="mode-toggle">
      <pdx-icon :name=\${ctx.modeIcon} size="16" id="mode-icon"></pdx-icon>
    </button>
    <button class="settings-btn" @click=\${safeHandler(ctx.toggleSettings, ctx.el?.tagName?.toLowerCase(), 'click')}>
      <pdx-icon name="settings" size="16"></pdx-icon>
    </button>

    <div :class=\${() => ctx.settingsOpen() ? 'settings-panel open' : 'settings-panel'} id="settings-panel">
      <div class="settings-header">
        <strong>Settings</strong>
        <button class="settings-close" @click=\${safeHandler(ctx.toggleSettings, ctx.el?.tagName?.toLowerCase(), 'click')}><pdx-icon name="x" size="16"></pdx-icon></button>
      </div>
      <div class="settings-section">
        <label class="settings-label">Theme</label>
        <div class="settings-grid">
          \${eachRow(() => ctx.themeItems, 'key', (opt) => html\`
            <button :class=\${() => opt().key === ctx.theme() ? 'settings-chip active' : 'settings-chip'} @click=\${safeHandler(() => ctx.setTheme(opt().key), ctx.el?.tagName?.toLowerCase(), 'click')}>\${() => opt().label}</button>
          \`)}</div>
      </div>
      <div class="settings-section">
        <label class="settings-label">Density</label>
        <div class="settings-row">
          \${eachRow(() => ctx.densityItems, 'key', (opt) => html\`
            <button :class=\${() => opt().key === ctx.density() ? 'settings-chip active' : 'settings-chip'} @click=\${safeHandler(() => ctx.setDensity(opt().key), ctx.el?.tagName?.toLowerCase(), 'click')}>\${() => opt().label}</button>
          \`)}</div>
      </div>
      <div class="settings-section">
        <label class="settings-label">Color Scheme</label>
        <div class="settings-row">
          <button :class=\${() => ctx.dark() ? 'settings-chip' : 'settings-chip active'} @click=\${safeHandler(() => ctx.setDark(false), ctx.el?.tagName?.toLowerCase(), 'click')}>Light</button>
          <button :class=\${() => ctx.dark() ? 'settings-chip active' : 'settings-chip'} @click=\${safeHandler(() => ctx.setDark(true), ctx.el?.tagName?.toLowerCase(), 'click')}>Dark</button>
        </div>
      </div>
    </div>
    <div :class=\${() => ctx.settingsOpen() ? 'settings-overlay open' : 'settings-overlay'} @click=\${safeHandler(ctx.toggleSettings, ctx.el?.tagName?.toLowerCase(), 'click')}></div>
  </div>
\`,
});

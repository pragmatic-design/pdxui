exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-form/demo-comp-form-data-source.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createForm, html, required, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-form-data-source', {
  props: {},
  setup(ctx) {
    const __dsFormMessage = signal('Ready', { name: 'demo-comp-form-data-source:dsFormMessage' });
// ─── 5. DataSource Form (SessionStorage) ───
    const industryOptions = ['Technology', 'Healthcare', 'Finance', 'Education', 'Manufacturing', 'Retail'];
    
    
    // Load initial values from sessionStorage
    function loadFromStorage() {
      try {
        const raw = sessionStorage.getItem('pdx-demo-company');
        return raw ? JSON.parse(raw) : { companyName: '', industry: '', website: '', active: false };
      } catch { return { companyName: '', industry: '', website: '', active: false }; }
    }
    
    const dsForm = createForm({
      initialValues: loadFromStorage(),
      validators: { companyName: [required('Company name is required')] },
      validateOn: 'onBlur',
    });
    
    
    
    
    function saveDsForm() {
      dsForm.validate().then(valid => {
        if (!valid) { __dsFormMessage.set('Validation failed'); return; }
        sessionStorage.setItem('pdx-demo-company', JSON.stringify(dsForm.getValues()));
        __dsFormMessage.set('Saved at ' + new Date().toLocaleTimeString());
        dsForm.reset(dsForm.getValues());
      });
    }
    
    function dsDirtyText() { return 'Dirty: ' + (dsForm.dirty() ? 'Yes' : 'No'); }
    function dsDirtyClass() { return 'form-status-badge' + (dsForm.dirty() ? ' active' : ''); }
    function dsMessageText() { return __dsFormMessage(); }
    return { industryOptions, loadFromStorage, dsForm, dsFormMessage: __dsFormMessage, saveDsForm, dsDirtyText, dsDirtyClass, dsMessageText };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">6. DataSource Integration (SessionStorage)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Form bound to a DataSource that persists to <code>sessionStorage</code>.
      Changes are saved on submit and survive page refresh.
    </p>

    <div class="demo-block">
      <pdx-form :form=\${() => ctx.dsForm} @pdx-submit=\${safeHandler(ctx.saveDsForm, ctx.el?.tagName?.toLowerCase(), 'pdx-submit')}>
        <pdx-form-field name="companyName" label="Company Name" required :error=\${() => ctx.dsForm.fields.companyName?.error()} :touched=\${() => ctx.dsForm.fields.companyName?.touched()} :warning=\${() => ctx.dsForm.fields.companyName?.warning()}>
          <pdx-input name="companyName" placeholder="Acme Inc." @pdx-input=\${(e) => ctx.dsForm.fields.companyName?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.dsForm.fields.companyName?.onBlur()}></pdx-input>
        </pdx-form-field>

        <pdx-form-field name="industry" label="Industry" :error=\${() => ctx.dsForm.fields.industry?.error()} :touched=\${() => ctx.dsForm.fields.industry?.touched()} :warning=\${() => ctx.dsForm.fields.industry?.warning()}>
          <pdx-select name="industry" :options=\${() => ctx.industryOptions} placeholder="Select industry" :value=\${() => ctx.dsForm.fields.industry?.value()} @pdx-change=\${(e) => ctx.dsForm.fields.industry?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.dsForm.fields.industry?.onBlur()}></pdx-select>
        </pdx-form-field>

        <pdx-form-field name="website" label="Website" :error=\${() => ctx.dsForm.fields.website?.error()} :touched=\${() => ctx.dsForm.fields.website?.touched()} :warning=\${() => ctx.dsForm.fields.website?.warning()}>
          <pdx-input name="website" type="url" placeholder="https://example.com" @pdx-input=\${(e) => ctx.dsForm.fields.website?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.dsForm.fields.website?.onBlur()}></pdx-input>
        </pdx-form-field>

        <pdx-form-field name="active" label="" :error=\${() => ctx.dsForm.fields.active?.error()} :touched=\${() => ctx.dsForm.fields.active?.touched()} :warning=\${() => ctx.dsForm.fields.active?.warning()}>
          <pdx-switch name="active" label="Active account" :checked=\${() => ctx.dsForm.fields.active?.value()} @pdx-change=\${(e) => ctx.dsForm.fields.active?.onChange(e.detail?.checked)} @pdx-blur=\${() => ctx.dsForm.fields.active?.onBlur()}></pdx-switch>
        </pdx-form-field>

        <pdx-form-actions submitLabel="Save to Storage" resetLabel="Reset"></pdx-form-actions>
      </pdx-form>

      <div class="form-status">
        <span class="form-status-badge active">Storage: sessionStorage</span>
        <span :class=\${() => ctx.dsDirtyClass()} :text-content=\${() => ctx.dsDirtyText()}></span>
        <span class="form-status-badge" :text-content=\${() => ctx.dsMessageText()}></span>
      </div>
    </div>

    <details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>const dsForm = createForm({
  initialValues: loadFromStorage(), // load from sessionStorage
  validators: { companyName: [required('...')] },
});

&lt;pdx-form :form="dsForm" @pdx-submit="saveDsForm"&gt;
  &lt;pdx-form-field name="companyName" label="Company Name" required&gt;
    &lt;pdx-input name="companyName"&gt;&lt;/pdx-input&gt;
  &lt;/pdx-form-field&gt;
  &lt;pdx-form-actions submitLabel="Save to Storage" /&gt;
&lt;/pdx-form&gt;</code></pre></details>
  </section>
\`,
});
"

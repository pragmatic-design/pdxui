  { key: 'd1', label: '', type: 'separator' },
  { key: 'del', label: 'Delete', icon: 'trash', danger: true },
];

&lt;pdx-dropdown-menu label="Actions" :items="items" @pdx-select="onSelect" /&gt;</code></pre>
    </details>
  </section>
\`,
});
"

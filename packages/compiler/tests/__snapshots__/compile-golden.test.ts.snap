component('pdx-demo-infra-positioning-iframe', {
  props: {},
  setup(ctx) {
    const __iframeLog = signal('Click the button inside the iframe', { name: 'demo-infra-positioning-iframe:iframeLog' });
    const __iframeRef = signal(null, { name: 'demo-infra-positioning-iframe:iframeRef' });
let iframeFloatEl = null;
    

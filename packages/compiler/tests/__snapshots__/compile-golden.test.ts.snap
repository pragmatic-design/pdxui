============================================================
import { component, eachRow, html, safeHandler, signal, when } from '@pdxui/core';
import { useChipConsole } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-2i5crj");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-2i5crj"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-2i5crj] .comp-card p { margin: 0; }\\n";
}

component('pdx-demo-comp-chip-composition', {
  props: {},
  setup(ctx) {
const chipConsole = useChipConsole();
    
    function dropPerson(list, e) { return chipConsole.dropPerson(list, e); }
    
    function startTeam() {
        return [
            { name: 'Jane Doe', avatar: '/avatars/person-1.svg' },
            { name: 'Alex Smith', avatar: '/avatars/person-2.svg' },
            { name: 'Mary Kim', avatar: '/avatars/person-3.svg' },
        ];
    }
    const __team = signal(startTeam(), { name: 'demo-comp-chip-composition:team' });
    ctx.el.setAttribute('data-pdx-2i5crj', '');
    return { chipConsole, dropPerson, startTeam, team: __team };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Composition</h2>

    <div class="comp-card">
      <h3 class="pdx-txt-subheading">Filter Bar</h3>
      <p class="pdx-txt-small pdx-ink-muted">Select categories to filter.</p>
      <div class="pdx-chip-group" style="margin-top:var(--pdx-space-sm)">
        <pdx-chip selectable variant="primary" selected>All</pdx-chip>
        <pdx-chip selectable variant="primary">Active</pdx-chip>
        <pdx-chip selectable variant="primary">Pending</pdx-chip>
        <pdx-chip selectable variant="primary">Archived</pdx-chip>
      </div>
    </div>

    <div class="comp-card">
      <h3 class="pdx-txt-subheading">Article Tags</h3>
      <div class="pdx-chip-group" style="margin-top:var(--pdx-space-sm)">
        <pdx-chip variant="tonal-primary" size="sm"><pdx-icon name="tag" size="sm"></pdx-icon> JavaScript</pdx-chip>
        <pdx-chip variant="tonal-success" size="sm"><pdx-icon name="tag" size="sm"></pdx-icon> Tutorial</pdx-chip>
        <pdx-chip variant="tonal-warning" size="sm"><pdx-icon name="tag" size="sm"></pdx-icon> Advanced</pdx-chip>
      </div>
    </div>

    <div class="comp-card">
      <h3 class="pdx-txt-subheading">Team Members</h3>
      <div class="pdx-chip-group" style="margin-top:var(--pdx-space-sm)">
        \${eachRow(() => ctx.team(), 'name', (member) => html\`
          <pdx-chip :avatar=\${() => member().avatar} removable :value=\${() => member().name} @pdx-remove=\${safeHandler(e => ctx.team.set(ctx.dropPerson(ctx.team(), e)), ctx.el?.tagName?.toLowerCase(), 'pdx-remove')}>\${() => member().name}</pdx-chip>
        \`)}\${when(() => ctx.team().length === 0, () => html\`
          <button class="pdx-ghost" size="sm" @click=\${safeHandler(() => ctx.team.set(ctx.startTeam()), ctx.el?.tagName?.toLowerCase(), 'click')}>Add everyone back</button>
        \`, null)}</div>
    </div>
  </section>
\`,
});
"
`;


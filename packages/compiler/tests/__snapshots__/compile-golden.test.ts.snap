      { id: 8, name: 'Helen Troy', role: 'Lead' },
    ];
    
    
    const userDS = createDataSource({ data: dsUsers, idField: 'id' });
    return { dsUsers, userDS };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">DataSource — <code>source</code> prop</h2>

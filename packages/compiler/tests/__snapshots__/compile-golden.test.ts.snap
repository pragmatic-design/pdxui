    const crossForm = createForm({ initialValues: { password: '', confirmPassword: '', startDate: '', endDate: '' }, validators: { password: [required('Password is required'), minLength(6, 'Min 6 characters')], confirmPassword: [required('Confirm is required'), (val) => { const pw = crossForm.fields.password?.value(); return val !== pw ? 'Passwords do not match' : undefined; }], startDate: [required('Start date is required')], endDate: [required('End date is required'), (val) => { const start = crossForm.fields.startDate?.value(); if (start && val && val <= start) return 'End date must be after start date'; return undefined; }] }, validateOn: 'onBlur' });
    return { crossForm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">6. Cross-Field Validation</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Password confirmation and date range validation — fields that depend on each other.
    </p>

    <div class="demo-block">
      <pdx-form :form=\${() => ctx.crossForm}>
        <pdx-form-field name="password" label="New Password" required :error=\${() => ctx.crossForm.fields.password?.error()} :touched=\${() => ctx.crossForm.fields.password?.touched()} :warning=\${() => ctx.crossForm.fields.password?.warning()}>
          <pdx-password-input name="password" placeholder="Min 6 characters" @pdx-input=\${(e) => ctx.crossForm.fields.password?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.crossForm.fields.password?.onBlur()}></pdx-password-input>
        </pdx-form-field>
        <pdx-form-field name="confirmPassword" label="Confirm Password" required :error=\${() => ctx.crossForm.fields.confirmPassword?.error()} :touched=\${() => ctx.crossForm.fields.confirmPassword?.touched()} :warning=\${() => ctx.crossForm.fields.confirmPassword?.warning()}>
          <pdx-password-input name="confirmPassword" placeholder="Must match" @pdx-input=\${(e) => ctx.crossForm.fields.confirmPassword?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.crossForm.fields.confirmPassword?.onBlur()}></pdx-password-input>
        </pdx-form-field>
        <div class="form-grid-2">
          <pdx-form-field name="startDate" label="Start Date" required :error=\${() => ctx.crossForm.fields.startDate?.error()} :touched=\${() => ctx.crossForm.fields.startDate?.touched()} :warning=\${() => ctx.crossForm.fields.startDate?.warning()}>
            <pdx-date-picker name="startDate" :value=\${() => ctx.crossForm.fields.startDate?.value()} @pdx-change=\${(e) => ctx.crossForm.fields.startDate?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.crossForm.fields.startDate?.onBlur()}></pdx-date-picker>
          </pdx-form-field>
          <pdx-form-field name="endDate" label="End Date" required :error=\${() => ctx.crossForm.fields.endDate?.error()} :touched=\${() => ctx.crossForm.fields.endDate?.touched()} :warning=\${() => ctx.crossForm.fields.endDate?.warning()}>
            <pdx-date-picker name="endDate" :value=\${() => ctx.crossForm.fields.endDate?.value()} @pdx-change=\${(e) => ctx.crossForm.fields.endDate?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.crossForm.fields.endDate?.onBlur()}></pdx-date-picker>
          </pdx-form-field>

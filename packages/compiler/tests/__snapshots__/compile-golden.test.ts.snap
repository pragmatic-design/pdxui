exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-filter-builder/demo-comp-filter-builder-basic.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createDataSource, html, toColumnDefs } from '@pdxui/core';
import { categories, products } from './state.pdx';

component('pdx-demo-comp-filter-builder-basic', {
  props: {},
  setup(ctx) {
const fields = [
      { field: 'name', label: 'Name', type: 'text' },
      { field: 'category', label: 'Category', type: 'enum', options: categories.map(function(c) { return { label: c, value: c }; }) },
      { field: 'price', label: 'Price', type: 'currency' },
      { field: 'stock', label: 'Stock', type: 'number' },
    ];
    
    
    const columns = toColumnDefs(fields);
    
    const ds = createDataSource({ data: products, pageSize: 10 });
    return { fields, columns, ds };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Click <strong>+ Add Filter</strong>, pick a field, set operator and value. Active filters appear as chips.
    </p>
    <div class="demo-container">
      <pdx-filter-builder :fields=\${() => ctx.fields} :source=\${() => ctx.ds}></pdx-filter-builder>
      <pdx-data-grid :source=\${() => ctx.ds} :columns=\${() => ctx.columns} hover striped></pdx-data-grid>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>const fields = [
  { field: 'name', label: 'Name', type: 'text' },
  { field: 'category', label: 'Category', type: 'enum',
    options: [{ label: 'Electronics', value: 'Electronics' }, ...] },
  { field: 'price', label: 'Price', type: 'currency' },
  { field: 'stock', label: 'Stock', type: 'number' },
];

&lt;pdx-filter-builder :fields="fields" :source="ds"&gt;
&lt;/pdx-filter-builder&gt;
&lt;pdx-data-grid :source="ds" :columns="columns" hover striped&gt;
&lt;/pdx-data-grid&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-filter-builder/demo-comp-filter-builder-same-json.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createDataSource, html, toColumnDefs } from '@pdxui/core';
import { categories, products } from './state.pdx';

component('pdx-demo-comp-filter-builder-same-json', {
  props: {},
  setup(ctx) {
// Second demo — same JSON pattern
    const fields2 = [
      { field: 'name', label: 'Name', type: 'text' },
      { field: 'category', label: 'Category', type: 'enum', options: categories.map(function(c) { return { label: c, value: c }; }) },
      { field: 'price', label: 'Price', type: 'currency' },
    ];
    
    
    const columns2 = toColumnDefs(fields2);
    
    const ds2 = createDataSource({ data: products.slice(), pageSize: 10 });
    return { fields2, columns2, ds2 };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Same JSON — Grid + Filter</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      One <code>FieldDefinition[]</code> drives both the grid columns and the filter builder fields.
      Changes in the filter automatically update the grid via shared DataSource.
    </p>
    <div class="demo-container">
      <pdx-filter-builder :fields=\${() => ctx.fields2} :source=\${() => ctx.ds2}></pdx-filter-builder>
      <pdx-data-grid :source=\${() => ctx.ds2} :columns=\${() => ctx.columns2} hover striped></pdx-data-grid>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>// ONE definition drives both components
const fields = [
  { field: 'name', label: 'Name', type: 'text' },
  { field: 'category', label: 'Category', type: 'enum', options: [...] },
  { field: 'price', label: 'Price', type: 'currency' },
];
const columns = toColumnDefs(fields);

&lt;pdx-filter-builder :fields="fields" :source="ds" /&gt;
&lt;pdx-data-grid :source="ds" :columns="columns" hover /&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-form/demo-comp-form-all-controls.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createForm, html } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-2e3cuf");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-2e3cuf"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-2e3cuf] .form-grid-2 {\\n    display: grid;\\n    grid-template-columns: 1fr 1fr;\\n    gap: var(--pdx-space-md);\\n  }\\n  @media (max-width: 640px) { [data-pdx-2e3cuf] .form-grid-2 { grid-template-columns: 1fr; } }\\n";
}

component('pdx-demo-comp-form-all-controls', {
  props: {},
  setup(ctx) {
// ─── 7. All Types Form ───
    const allTypesForm = createForm({
      initialValues: {
        text: '', password: '', number: 0, slider: 50, rating: 3,
        color: '#3b82f6', textarea: '', checkbox: false, switch: true,
      },
    });
    ctx.el.setAttribute('data-pdx-2e3cuf', '');
    return { allTypesForm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">8. All Control Types in Form</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Every pdx-* control works with compiler auto-binding inside a form.
    </p>

    <div class="demo-block">
      <pdx-form :form=\${() => ctx.allTypesForm}>
        <div class="form-grid-2">
          <pdx-form-field name="text" label="Text Input" :error=\${() => ctx.allTypesForm.fields.text?.error()} :touched=\${() => ctx.allTypesForm.fields.text?.touched()} :warning=\${() => ctx.allTypesForm.fields.text?.warning()}>
            <pdx-input name="text" placeholder="Text" @pdx-input=\${(e) => ctx.allTypesForm.fields.text?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.allTypesForm.fields.text?.onBlur()}></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="password" label="Password" :error=\${() => ctx.allTypesForm.fields.password?.error()} :touched=\${() => ctx.allTypesForm.fields.password?.touched()} :warning=\${() => ctx.allTypesForm.fields.password?.warning()}>
            <pdx-password-input name="password" placeholder="Password" @pdx-input=\${(e) => ctx.allTypesForm.fields.password?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.allTypesForm.fields.password?.onBlur()}></pdx-password-input>
          </pdx-form-field>
          <pdx-form-field name="number" label="Number" :error=\${() => ctx.allTypesForm.fields.number?.error()} :touched=\${() => ctx.allTypesForm.fields.number?.touched()} :warning=\${() => ctx.allTypesForm.fields.number?.warning()}>
            <pdx-number-input name="number" :value=\${() => ctx.allTypesForm.fields.number?.value()} @pdx-change=\${(e) => ctx.allTypesForm.fields.number?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.allTypesForm.fields.number?.onBlur()}></pdx-number-input>
          </pdx-form-field>
          <pdx-form-field name="slider" label="Slider" :error=\${() => ctx.allTypesForm.fields.slider?.error()} :touched=\${() => ctx.allTypesForm.fields.slider?.touched()} :warning=\${() => ctx.allTypesForm.fields.slider?.warning()}>
            <pdx-slider name="slider" :min=\${0} :max=\${100} :value=\${() => ctx.allTypesForm.fields.slider?.value()} @pdx-change=\${(e) => ctx.allTypesForm.fields.slider?.onChange(e.detail?.value)} @pdx-blur=\${() => ctx.allTypesForm.fields.slider?.onBlur()}></pdx-slider>
          </pdx-form-field>
          <pdx-form-field name="rating" label="Rating" :error=\${() => ctx.allTypesForm.fields.rating?.error()} :touched=\${() => ctx.allTypesForm.fields.rating?.touched()} :warning=\${() => ctx.allTypesForm.fields.rating?.warning()}>
            <pdx-rating name="rating" :value=\${() => ctx.allTypesForm.fields.rating?.value()} @pdx-change=\${(e) => ctx.allTypesForm.fields.rating?.onChange(e.detail?.value)} @pdx-blur=\${() => ctx.allTypesForm.fields.rating?.onBlur()}></pdx-rating>
          </pdx-form-field>
          <pdx-form-field name="color" label="Color" :error=\${() => ctx.allTypesForm.fields.color?.error()} :touched=\${() => ctx.allTypesForm.fields.color?.touched()} :warning=\${() => ctx.allTypesForm.fields.color?.warning()}>
            <pdx-color-picker name="color" inline :value=\${() => ctx.allTypesForm.fields.color?.value()} @pdx-change=\${(e) => ctx.allTypesForm.fields.color?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.allTypesForm.fields.color?.onBlur()}></pdx-color-picker>
          </pdx-form-field>
        </div>

        <pdx-form-field name="textarea" label="Textarea" :error=\${() => ctx.allTypesForm.fields.textarea?.error()} :touched=\${() => ctx.allTypesForm.fields.textarea?.touched()} :warning=\${() => ctx.allTypesForm.fields.textarea?.warning()}>
          <pdx-textarea name="textarea" rows="2" placeholder="Multi-line text" @pdx-input=\${(e) => ctx.allTypesForm.fields.textarea?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.allTypesForm.fields.textarea?.onBlur()}></pdx-textarea>
        </pdx-form-field>


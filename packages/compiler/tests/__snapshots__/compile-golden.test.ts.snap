import '@pdxui/ui';

{
  let __pdx_style = document.getElementById("pdx-s-qbbqpf");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-qbbqpf"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-qbbqpf] .demo { max-width: 700px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-qbbqpf] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-qbbqpf] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-qbbqpf] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-qbbqpf] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-qbbqpf] .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\\n  [data-pdx-qbbqpf] .stack { display: flex; flex-direction: column; gap: 8px; }\\n  [data-pdx-qbbqpf] p { margin: 4px 0; font-size: 0.9rem; }\\n";

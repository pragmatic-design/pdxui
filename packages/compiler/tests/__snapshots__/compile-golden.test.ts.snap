e="100" allowNegative precision="2" data-pdx-v0kfbv-in></pdx-number-input> </pdx-form-field> <pdx-form-field label="Negative value"> <pdx-number-input value="-50.00" allowNegative precision="2" data-pdx-v0kfbv-in></pdx-number-input> </pdx-form-field> <pdx-form-field label="With colored number" hint="Number turns green/red based on sign"> <pdx-number-input value="250.00" allowNegative colorBySign precision="2" data-pdx-v0kfbv-in></pdx-number-input> </pdx-form-field> <pdx-form-field label="Colored negative"> <pdx-number-input value="-75.50" allowNegative colorBySign precision="2" data-pdx-v0kfbv-in></pdx-number-input> </pdx-form-field> </div> <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Locale Formatting</h3> <div class="demo-stack"> <pdx-form-field label="US Dollar"> <pdx-number-input value="1234.50" locale="en-US" currency="USD" precision="2" data-pdx-v0kfbv-in></pdx-number-input> </pdx-form-field> <pdx-form-field label="Euro (German)"> <pdx-number-input value="1234.50" locale="de-DE" currency="EUR" precision="2" data-pdx-v0kfbv-in></pdx-number-input> </pdx-form-field> </div> <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Keyboard — Two Modes</h3> <div class="shortcut-list"> <div><strong>With steppers</strong> (controls="both"/"right"): <kbd>↑</kbd>/<kbd>↓</kbd> = fixed step, <kbd>Shift</kbd> = ×10</div> <div><strong>Free mode</strong> (controls="none"): <kbd>↑</kbd>/<kbd>↓</kbd> = cursor-position step (Figma-style), <kbd>Shift</kbd> = ×10</div> <div><kbd>+</kbd> / <kbd>-</kbd> Toggle sign (when allowNegative)</div> <div><kbd>Scroll wheel</kbd> Step (when allowWheel + focused)</div> <div>Invalid chars blocked — only digits, one decimal separator</div> </div> <details class="source-block"> <summary>Source</summary> <pre class="pdx-txt-mono"><code>&lt;pdx-number-input\\n  value="1234.56"\\n  step="0.01"\\n  precision="2"\\n  min="0"\\n  max="9999"\\n  allowWheel\\n  locale="en-US"\\n  currency="USD"&gt;\\n&lt;/pdx-number
component('pdx-demo-drag', {
  props: {},
  setup(ctx) {
    const __freeDragging = signal(false, { name: 'demo-drag:freeDragging' });
    const __freeX = signal(0, { name: 'demo-drag:freeX' });
    const __freeY = signal(0, { name: 'demo-drag:freeY' });
    const __freeVel = signal(0, { name: 'demo-drag:freeVel' });
    const __dropLog = signal('Drag cards between zones...', { name: 'demo-drag:dropLog' });
    const __freeRef = signal(null, { name: 'demo-drag:freeRef' });
    const __xRef = signal(null, { name: 'demo-drag:xRef' });
    const __yRef = signal(null, { name: 'demo-drag:yRef' });
    const __zoneARef = signal(null, { name: 'demo-drag:zoneARef' });
    const __zoneBRef = signal(null, { name: 'demo-drag:zoneBRef' });
    const __c1Ref = signal(null, { name: 'demo-drag:c1Ref' });
    const __c2Ref = signal(null, { name: 'demo-drag:c2Ref' });
    const __c3Ref = signal(null, { name: 'demo-drag:c3Ref' });
    const __c4Ref = signal(null, { name: 'demo-drag:c4Ref' });
    const __kbRef = signal(null, { name: 'demo-drag:kbRef' });
    const __scrollRef = signal(null, { name: 'demo-drag:scrollRef' });
    const __scrollItemRef = signal(null, { name: 'demo-drag:scrollItemRef' });
// Drag instances with bounds
    const freeDrag = useDrag(() => __freeRef(), { bounds: 'parent' });
    
    const xDrag = useDrag(() => __xRef(), { axis: 'x', bounds: 'parent' });
    
    const yDrag = useDrag(() => __yRef(), { axis: 'y', bounds: 'parent' });
    
    const kbDrag = useDrag(() => __kbRef(), { bounds: 'parent' });
    
    const scrollDrag = useDrag(() => __scrollItemRef());
    
    
    // Card drags — each card sends its data-id as payload
    const c1Drag = useDrag(() => __c1Ref(), { data: function() { return 'c1'; } });
    
    const c2Drag = useDrag(() => __c2Ref(), { data: function() { return 'c2'; } });
    
    const c3Drag = useDrag(() => __c3Ref(), { data: function() { return 'c3'; } });
    
    const c4Drag = useDrag(() => __c4Ref(), { data: function() { return 'c4'; } });
    
    
    // Move card element to target zone on drop
    function moveCard(cardId, targetZone) {
        const card = ({ c1: __c1Ref(), c2: __c2Ref(), c3: __c3Ref(), c4: __c4Ref() })[cardId];
        if (card && targetZone) {
            card.style.transform = '';
            card.style.zIndex = '';
            card.style.opacity = '';
            card.style.boxShadow = '';
            targetZone.appendChild(card);
        }
    }
    
    // Drop zones — actual card movement on drop
    const dropA = useDropZone(() => __zoneARef(), {
        onDrop: function(data) {
            moveCard(data, __zoneARef());
            __dropLog.setRaw(__dropLog.peek() + '> Moved ' + data + ' → Zone A\\n');
        },
        onEnter: function() { },
        onLeave: function() { },
    });
    
    const dropB = useDropZone(() => __zoneBRef(), {
        onDrop: function(data) {
            moveCard(data, __zoneBRef());
            __dropLog.setRaw(__dropLog.peek() + '> Moved ' + data + ' → Zone B\\n');
        },
    });
    onMount(() => {
    // Free drag position + velocity tracking
    const d1 = effect(() => {
        __freeDragging.setRaw(freeDrag.isDragging());
        const pos = freeDrag.position();
        __freeX.setRaw(Math.round(pos.x));
        __freeY.setRaw(Math.round(pos.y));
        const vel = freeDrag.velocity();
        __freeVel.setRaw(Math.round(Math.sqrt(vel.vx * vel.vx + vel.vy * vel.vy)));
        const el = __freeRef();
        if (el) el.style.transform = 'translate(' + pos.x + 'px, ' + pos.y + 'px)';
    });

    const d2 = effect(() => {
        const pos = xDrag.position();
        const el = __xRef();
        if (el) el.style.transform = 'translateX(' + pos.x + 'px)';
    });

    const d3 = effect(() => {
        const pos = yDrag.position();
        const el = __yRef();
        if (el) el.style.transform = 'translateY(' + pos.y + 'px)';
    });

    // Drop zone highlight
    const d4 = effect(() => {
        const el = __zoneARef();
        if (el) el.classList.toggle('over', dropA.isOver());
    });
    const d5 = effect(() => {
        const el = __zoneBRef();
        if (el) el.classList.toggle('over', dropB.isOver());
    });

    // Card drag visual feedback
    function cardEffect(drag, getRef) {
        return effect(() => {
            const el = getRef;
            if (!el) return;
            const pos = drag.position();
            const dragging = drag.isDragging();
            if (dragging) {

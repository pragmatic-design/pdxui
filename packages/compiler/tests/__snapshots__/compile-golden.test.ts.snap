import { component, computed, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-select-cascading', {
  props: {},
  setup(ctx) {
    const __selectedCountry = signal('', { name: 'demo-comp-select-cascading:selectedCountry' });
    const __selectedCity = signal(null, { name: 'demo-comp-select-cascading:selectedCity' });
// Cascade selects
    
    
    
    const cascadeCountries = ['USA', 'UK', 'Italy', 'Japan'];
    
    
    
    function onCountryChange(e) { __selectedCountry.set(e.detail.value ?? e.detail); __selectedCity.set(null); }
    function onCityChange(e) { __selectedCity.set(e.detail.value ?? e.detail); }
    
    const cities = [
      { id: 1, name: 'New York', country: 'USA' },
      { id: 2, name: 'Los Angeles', country: 'USA' },
      { id: 3, name: 'Chicago', country: 'USA' },
      { id: 4, name: 'London', country: 'UK' },
      { id: 5, name: 'Manchester', country: 'UK' },
      { id: 6, name: 'Edinburgh', country: 'UK' },
      { id: 7, name: 'Rome', country: 'Italy' },
      { id: 8, name: 'Milan', country: 'Italy' },
      { id: 9, name: 'Florence', country: 'Italy' },
      { id: 10, name: 'Tokyo', country: 'Japan' },
      { id: 11, name: 'Osaka', country: 'Japan' },
      { id: 12, name: 'Kyoto', country: 'Japan' },
    ];
    const filteredCities = computed(() => cities.filter(c => !__selectedCountry() || c.country === __selectedCountry()), { name: 'demo-comp-select-cascading:filteredCities' });
    return { selectedCountry: __selectedCountry, selectedCity: __selectedCity, cascadeCountries, filteredCities, onCountryChange, onCityChange, cities };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Cascading Selects</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Second select filters options based on the first select's value.
      Uses <code>$derived</code> to recompute the filtered array reactively.
    </p>
    <div class="demo-col" style="max-width: 400px">
      <div class="field">
        <pdx-label text="Country"></pdx-label>
        <pdx-select :options=\${() => ctx.cascadeCountries} clearable placeholder="Select country..." @pdx-change=\${safeHandler(ctx.onCountryChange, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-select>
      </div>
      <div class="field">
        <pdx-label text="City"></pdx-label>
        <pdx-select :options=\${ctx.filteredCities} labelField="name" valueField="id" :value=\${ctx.selectedCity} :disabled=\${() => !ctx.selectedCountry()} searchable clearable placeholder="Select city..." @pdx-change=\${safeHandler(ctx.onCityChange, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-select>
      </div>
    </div>
    <details class="source"><summary>Source</summary><pre><code>let selectedCountry = $signal('');

const filteredCities = $derived(
  cities.filter(c => !selectedCountry || c.country === selectedCountry)
);

function onCountryChange(e) {
  selectedCountry = e.detail.value;
}

&lt;pdx-select :options="cascadeCountries" clearable
  @pdx-change="onCountryChange" placeholder="Select country..." /&gt;

&lt;pdx-select :options="filteredCities" labelField="name" valueField="id"
  :disabled="!selectedCountry" searchable clearable
  placeholder="Select city..." /&gt;</code></pre></details>
  </section>
\`,
});
"
`;


ed padding for dense views</td></tr><tr><td><code>sticky-header</code></td><td>Boolean</td><td>true</td><td>Sticky column headers on scroll</td></tr><tr><td><code>id-field</code></td><td>String</td><td>\\'id\\'</td><td>Unique identifier field</td></tr><tr><td><code>state-key</code></td><td>String</td><td>\\'\\'</td><td>LocalStorage key for state persistence</td></tr><tr><td><code>empty-title</code></td><td>String</td><td>\\'No data\\'</td><td>Empty state message</td></tr><tr><td><code>empty-icon</code></td><td>String</td><td>\\'inbox\\'</td><td>Empty state icon name</td></tr><tr><td><code>show-footer</code></td><td>Boolean</td><td>true</td><td>Show footer with row count and pagination</td></tr><tr><td><code>filterable</code></td><td>Boolean</td><td>false</td><td>Show inline filter row (shorthand for filter-mode="row")</td></tr><tr><td><code>filter-mode</code></td><td>String</td><td>\\'none\\'</td><td>\\'none\\' | \\'row\\' | \\'toolbar\\' — filter display mode</td></tr><tr><td><code>show-toolbar</code></td><td>Boolean</td><td>false</td><td>Show toolbar (sort chips, reload, columns, slots)</td></tr><tr><td><code>show-group-bar</code></td><td>Boolean</td><td>false</td><td>Show drag-to-group bar</td></tr><tr><td><code>pagination-position</code></td><td>String</td><td>\\'bottom\\'</td><td>\\'bottom\\' | \\'top\\' | \\'both\\'</td></tr><tr><td><code>page-sizes</code></td><td>Array</td><td>[]</td><td>Rows-per-page choices in the pager, e.g. [10, 20, 50]; empty offers none</td></tr><tr><td><code>selection</code></td><td>String</td><td>\\'none\\'</td><td>\\'none\\' | \\'single\\' | \\'multiple\\'</td></tr><tr><td><code>virtual-scroll</code></td><td>Boolean</td><td>false</td><td>Enable virtual scrolling for large datasets</td></tr><tr><td><code>row-height</code></td><td>Number</td><td>42</td><td>Row height for virtual scroll (px)</td></tr><tr><td><code>max-height</code></td><td>Number</td><td>400</td><td>Max height for virtual scroll container (px)</td></tr></tbody></table> 
exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-data-source/demo-comp-data-source-cascading.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-data-source-cascading', {
  props: {},
  setup(ctx) {
    const __pickedCountry = signal('', { name: 'demo-comp-data-source-cascading:pickedCountry' });
    const __pickedCity = signal(null, { name: 'demo-comp-data-source-cascading:pickedCity' });
// Cascade
    const cities = [
      { id: 1, name: 'New York', country: 'USA' },
      { id: 2, name: 'Los Angeles', country: 'USA' },
      { id: 3, name: 'Chicago', country: 'USA' },
      { id: 4, name: 'London', country: 'UK' },
      { id: 5, name: 'Manchester', country: 'UK' },
      { id: 6, name: 'Edinburgh', country: 'UK' },
      { id: 7, name: 'Rome', country: 'Italy' },
      { id: 8, name: 'Milan', country: 'Italy' },
      { id: 9, name: 'Florence', country: 'Italy' },
    ];
    const filteredCityList = computed(() => cities.filter(c => !__pickedCountry() || c.country === __pickedCountry()), { name: 'demo-comp-data-source-cascading:filteredCityList' });
    const pickedCityLabel = computed(() => {
  if (!__pickedCity()) return '';
  const c = cities.find(x => x.id === __pickedCity());
  return c ? c.name : '';
}, { name: 'demo-comp-data-source-cascading:pickedCityLabel' });
    
    
    const countryList = ['USA', 'UK', 'Italy'];
    
    
    
    
    
    
    
    function onCountryPick(e) { __pickedCountry.set(e.detail.value ?? e.detail); __pickedCity.set(null); }
    function onCityPick(e) { __pickedCity.set(e.detail.value ?? e.detail); }
    return { cities, countryList, pickedCountry: __pickedCountry, pickedCity: __pickedCity, filteredCityList, pickedCityLabel, onCountryPick, onCityPick };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Cascading DataSources</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Second select filters reactively based on the first. Uses <code>$derived</code> to recompute
      options. Changing country resets the city selection.
    </p>
    <div class="demo-col">
      <div class="field">
        <label class="pdx-txt-small pdx-weight-medium">Country</label>
        <pdx-select :options=\${() => ctx.countryList} clearable placeholder="Select country..." @pdx-change=\${safeHandler(ctx.onCountryPick, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-select>
      </div>
      <div class="field">
        <label class="pdx-txt-small pdx-weight-medium">City</label>
        <pdx-select :options=\${ctx.filteredCityList} labelField="name" valueField="id" :value=\${ctx.pickedCity} :disabled=\${() => !ctx.pickedCountry()} searchable clearable placeholder="Select city..." @pdx-change=\${safeHandler(ctx.onCityPick, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-select>
      </div>
      <p class="pdx-txt-small pdx-ink-muted">
        Selected: \${() => ctx.pickedCountry() || '—'} / \${() => ctx.pickedCityLabel() || '—'}
      </p>
    </div>
    <details class="source"><summary>Source</summary><pre><code>let pickedCountry = $signal('');
let pickedCity = $signal(null);

const filteredCityList = $derived(
  cities.filter(c => !pickedCountry || c.country === pickedCountry)
);

function onCountryPick(e) {
  pickedCountry = e.detail.value ?? e.detail;
  pickedCity = null; // reset dependent
}

&lt;pdx-select :options="countryList" clearable
  @pdx-change="onCountryPick" /&gt;

&lt;pdx-select :options="filteredCityList" labelField="name"
  valueField="id" :value="pickedCity"
  :disabled="!pickedCountry" searchable clearable /&gt;</code></pre></details>
  </section>
\`,
});
"
`;


"// 0 warning(s)

============================================================
import { component, createForm, email, html, min, minLength, required, safeHandler, setValidationLocale, signal } from '@pdxui/core';

component('pdx-demo-comp-form-advanced-validation-i18n', {
  props: {},
  setup(ctx) {
    const __currentLang = signal('en', { name: 'demo-comp-form-advanced-validation-i18n:currentLang' });
// ─── 2. Validation i18n ───
    const translations = { en: { 'validation.required': '{field} is required', 'validation.email': 'Invalid email address', 'validation.minLength': 'Must be at least {min} characters', 'validation.min': 'Must be at least {min}' }, it: { 'validation.required': '{field} è obbligatorio', 'validation.email': 'Indirizzo email non valido', 'validation.minLength': 'Minimo {min} caratteri', 'validation.min': 'Deve essere almeno {min}' }, de: { 'validation.required': '{field} ist erforderlich', 'validation.email': 'Ungültige E-Mail-Adresse', 'validation.minLength': 'Mindestens {min} Zeichen', 'validation.min': 'Muss mindestens {min} sein' } };
    
    
    
    
    function setLang(lang) { __currentLang.set(lang); const dict = translations[lang] || translations.en; setValidationLocale((key, params) => { const tmpl = dict[key]; if (!tmpl) return undefined; const merged = Object.assign({ field: 'This field', min: '?', max: '?' }, params || {}); return tmpl.replace(/\\{(\\w+)\\}/g, (_, k) => String(merged[k] ?? k)); }); i18nForm.validate(); }
    function langBtnEn() { return 'pdx-btn pdx-sm ' + (__currentLang() === 'en' ? 'pdx-primary' : 'pdx-outline'); }
    function langBtnIt() { return 'pdx-btn pdx-sm ' + (__currentLang() === 'it' ? 'pdx-primary' : 'pdx-outline'); }
    function langBtnDe() { return 'pdx-btn pdx-sm ' + (__currentLang() === 'de' ? 'pdx-primary' : 'pdx-outline'); }
    
    const i18nForm = createForm({ initialValues: { username: '', email: '', age: 0 }, validators: { username: [required('validation.required'), minLength(3, 'validation.minLength')], email: [required('validation.required'), email('validation.email')], age: [min(1, 'validation.min')] }, validateOn: 'onChange' });
    
    
    setLang('en');
    return { translations, currentLang: __currentLang, setLang, langBtnEn, langBtnIt, langBtnDe, i18nForm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">2. Validation i18n</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Switch language to see validation messages change. Uses <code>setValidationLocale()</code>
      with a custom resolver.
    </p>

    <div class="demo-block">
      <div class="demo-toolbar">
        <button :class=\${() => ctx.langBtnEn()} @click=\${safeHandler(() => ctx.setLang('en'), ctx.el?.tagName?.toLowerCase(), 'click')}>English</button>
        <button :class=\${() => ctx.langBtnIt()} @click=\${safeHandler(() => ctx.setLang('it'), ctx.el?.tagName?.toLowerCase(), 'click')}>Italiano</button>
        <button :class=\${() => ctx.langBtnDe()} @click=\${safeHandler(() => ctx.setLang('de'), ctx.el?.tagName?.toLowerCase(), 'click')}>Deutsch</button>
      </div>

      <pdx-form :form=\${() => ctx.i18nForm}>
        <div class="form-grid-2">
          <pdx-form-field name="username" label="Username" required :error=\${() => ctx.i18nForm.fields.username?.error()} :touched=\${() => ctx.i18nForm.fields.username?.touched()} :warning=\${() => ctx.i18nForm.fields.username?.warning()}>
            <pdx-input name="username" placeholder="min 3 chars" @pdx-input=\${(e) => ctx.i18nForm.fields.username?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.i18nForm.fields.username?.onBlur()}></pdx-input>
          </pdx-form-field>
          <pdx-form-field name="email" label="Email" required :error=\${() => ctx.i18nForm.fields.email?.error()} :touched=\${() => ctx.i18nForm.fields.email?.touched()} :warning=\${() => ctx.i18nForm.fields.email?.warning()}>
            <pdx-input name="email" type="email" placeholder="name@example.com" @pdx-input=\${(e) => ctx.i18nForm.fields.email?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.i18nForm.fields.email?.onBlur()}></pdx-input>
          </pdx-form-field>
        </div>
        <pdx-form-field name="age" label="Age" required :error=\${() => ctx.i18nForm.fields.age?.error()} :touched=\${() => ctx.i18nForm.fields.age?.touched()} :warning=\${() => ctx.i18nForm.fields.age?.warning()}>
          <pdx-number-input name="age" :min=\${0} :max=\${150} :value=\${() => ctx.i18nForm.fields.age?.value()} @pdx-change=\${(e) => ctx.i18nForm.fields.age?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.i18nForm.fields.age?.onBlur()}></pdx-number-input>
        </pdx-form-field>
        <button type="submit" class="pdx-btn pdx-primary pdx-sm">Validate</button>
      </pdx-form>
    </div>

    <details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>const translations = {
  en: { 'validation.required': '{field} is required', ... },
  it: { 'validation.required': '{field} è obbligatorio', ... },
};

function setLang(lang) {
  const dict = translations[lang];
  setValidationLocale((key, params) =&gt; {
    const tmpl = dict[key];
    if (!tmpl) return undefined;
    return tmpl.replace(/\\\\{(\\\\w+)\\\\}/g, (_, k) =&gt; params?.[k] ?? k);
  });
  form.validate(); // re-run to refresh messages
}

// Validators use i18n keys as messages:
validators: { email: [required('validation.required')] }</code></pre></details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-form-composition/demo-comp-form-composition-declarative.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createForm, email, html, required, safeHandler } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-tpwlwf");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-tpwlwf"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-tpwlwf] .form-json {\\n    margin: var(--pdx-space-xs) 0 0;\\n    padding: var(--pdx-space-sm);\\n    font-family: var(--pdx-font-mono);\\n    font-size: var(--pdx-text-xs);\\n    background: var(--pdx-color-inset);\\n    border-radius: var(--pdx-radius-sm);\\n    overflow-x: auto;\\n    max-height: 250px;\\n    white-space: pre-wrap;\\n  }\\n  [data-pdx-tpwlwf] .form-status { display: flex; gap: var(--pdx-space-sm); margin-bottom: var(--pdx-space-sm); }\\n";
}

component('pdx-demo-comp-form-composition-declarative', {
  props: {},
  setup(ctx) {
// ─── 2. Declarative Composition ───
    const declForm = createForm({
      initialValues: {
        orderNumber: 'ORD-042',
        customer: { name: 'Jane Doe', email: 'jane@acme.com' },
        shipping: { street: '123 Main St', city: 'New York', zip: '10001' },
      },
      validators: {
        'orderNumber': [required('Order number is required')],
        'customer.name': [required('Name is required')],
        'customer.email': [required('Email is required'), email('Invalid email')],
      },
    });
    
    
    function saveDeclForm() { declForm.validate(); }
    function declDirtyText() { return 'Dirty: ' + (declForm.dirty() ? 'Yes' : 'No'); }
    function declDirtyClass() { return 'form-status-badge' + (declForm.dirty() ? ' active' : ''); }
    function declValidText() { return 'Valid: ' + (declForm.valid() ? 'Yes' : 'No'); }
    function declValidClass() { return 'form-status-badge' + (declForm.valid() ? ' success' : ' error'); }
    function declValuesJson() { const d = declForm.dirty(); return JSON.stringify(declForm.getValues(), null, 2); }
    ctx.el.setAttribute('data-pdx-tpwlwf', '');
    return { declForm, saveDeclForm, declDirtyText, declDirtyClass, declValidText, declValidClass, declValuesJson };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">2. Declarative Composition (Template)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Same nested DTO, but composed declaratively in the template with <code>&lt;pdx-field-group&gt;</code> and compiler auto-binding.
      The compiler resolves <code>name="email"</code> inside <code>&lt;pdx-field-group name="customer"&gt;</code>
      to <code>form.fields['customer.email']</code>.
    </p>

    <div class="demo-block">
      <pdx-form :form=\${() => ctx.declForm} @pdx-submit=\${safeHandler(ctx.saveDeclForm, ctx.el?.tagName?.toLowerCase(), 'pdx-submit')}>
        <div class="form-grid">
          <pdx-form-field name="orderNumber" label="Order #" required :error=\${() => ctx.declForm.fields.orderNumber?.error()} :touched=\${() => ctx.declForm.fields.orderNumber?.touched()} :warning=\${() => ctx.declForm.fields.orderNumber?.warning()}>
            <pdx-input name="orderNumber" @pdx-input=\${(e) => ctx.declForm.fields.orderNumber?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.declForm.fields.orderNumber?.onBlur()}></pdx-input>
          </pdx-form-field>
        </div>

        <pdx-field-group name="customer" label="Customer">
          <div class="form-grid">
            <pdx-form-field name="customer.name" label="Name" required :error=\${() => ctx.declForm.fields['customer.name']?.error()} :touched=\${() => ctx.declForm.fields['customer.name']?.touched()} :warning=\${() => ctx.declForm.fields['customer.name']?.warning()}>
              <pdx-input name="customer.name" placeholder="Full name" @pdx-input=\${(e) => ctx.declForm.fields['customer.name']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.declForm.fields['customer.name']?.onBlur()}></pdx-input>
            </pdx-form-field>
            <pdx-form-field name="customer.email" label="Email" required :error=\${() => ctx.declForm.fields['customer.email']?.error()} :touched=\${() => ctx.declForm.fields['customer.email']?.touched()} :warning=\${() => ctx.declForm.fields['customer.email']?.warning()}>
              <pdx-input name="customer.email" type="email" placeholder="email@company.com" @pdx-input=\${(e) => ctx.declForm.fields['customer.email']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.declForm.fields['customer.email']?.onBlur()}></pdx-input>
            </pdx-form-field>
          </div>
        </pdx-field-group>

        <pdx-field-group name="shipping" label="Shipping Address">
          <div class="form-grid-3">
            <pdx-form-field name="shipping.street" label="Street" :error=\${() => ctx.declForm.fields['shipping.street']?.error()} :touched=\${() => ctx.declForm.fields['shipping.street']?.touched()} :warning=\${() => ctx.declForm.fields['shipping.street']?.warning()}>
              <pdx-input name="shipping.street" @pdx-input=\${(e) => ctx.declForm.fields['shipping.street']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.declForm.fields['shipping.street']?.onBlur()}></pdx-input>
            </pdx-form-field>
            <pdx-form-field name="shipping.city" label="City" :error=\${() => ctx.declForm.fields['shipping.city']?.error()} :touched=\${() => ctx.declForm.fields['shipping.city']?.touched()} :warning=\${() => ctx.declForm.fields['shipping.city']?.warning()}>
              <pdx-input name="shipping.city" @pdx-input=\${(e) => ctx.declForm.fields['shipping.city']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.declForm.fields['shipping.city']?.onBlur()}></pdx-input>
            </pdx-form-field>
            <pdx-form-field name="shipping.zip" label="ZIP" :error=\${() => ctx.declForm.fields['shipping.zip']?.error()} :touched=\${() => ctx.declForm.fields['shipping.zip']?.touched()} :warning=\${() => ctx.declForm.fields['shipping.zip']?.warning()}>
              <pdx-input name="shipping.zip" @pdx-input=\${(e) => ctx.declForm.fields['shipping.zip']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.declForm.fields['shipping.zip']?.onBlur()}></pdx-input>
            </pdx-form-field>
          </div>
        </pdx-field-group>

        <pdx-form-actions submitLabel="Save Order" resetLabel="Reset"></pdx-form-actions>
      </pdx-form>

      <div class="form-output">
        <div class="form-status">
          <span :class=\${() => ctx.declDirtyClass()} :text-content=\${() => ctx.declDirtyText()}></span>
          <span :class=\${() => ctx.declValidClass()} :text-content=\${() => ctx.declValidText()}></span>
        </div>
        <strong>getValues():</strong>
        <pre class="form-json" :text-content=\${() => ctx.declValuesJson()}></pre>
      </div>
    </div>

    <details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>&lt;pdx-form :form="orderForm"&gt;
  &lt;pdx-form-field name="orderNumber" label="Order #" required&gt;
    &lt;pdx-input name="orderNumber" /&gt;
  &lt;/pdx-form-field&gt;

  &lt;pdx-field-group name="customer" label="Customer"&gt;
    &lt;pdx-form-field name="name" label="Name" required&gt;
      &lt;pdx-input name="name" /&gt;
    &lt;/pdx-form-field&gt;
    &lt;!-- compiler resolves to form.fields['customer.name'] --&gt;
  &lt;/pdx-field-group&gt;

  &lt;pdx-field-group name="shipping" label="Shipping"&gt;
    &lt;pdx-form-field name="street" label="Street"&gt;...&lt;/pdx-form-field&gt;
    &lt;pdx-form-field name="city" label="City"&gt;...&lt;/pdx-form-field&gt;
  &lt;/pdx-field-group&gt;
&lt;/pdx-form&gt;

// createForm accepts nested initialValues:
const orderForm = createForm({
  initialValues: {
    orderNumber: 'ORD-042',
    customer: { name: 'Jane', email: 'jane@test.com' },
    shipping: { street: '', city: '', zip: '' },
  },
  validators: {
    'customer.name': [required()],  // dotted path validators
    'customer.email': [required(), email()],
  },
});</code></pre></details>
  </section>
\`,
});
"
`;


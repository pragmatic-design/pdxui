exports[`compile golden — demo corpus > showcase-new/pages/sections/infra-container/demo-infra-container-container-size.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, effect, html, onMount, signal, useContainerSize, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-nirhpg");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-nirhpg"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-nirhpg] .resize-box { resize: horizontal; overflow: auto; border: 2px dashed var(--pdx-color-border); border-radius: 8px; padding: 12px; min-width: 200px; max-width: 100%; width: 600px; display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }\\n  [data-pdx-nirhpg] .resize-box.compact { border-color: var(--pdx-color-danger); }\\n  [data-pdx-nirhpg] .resize-box.medium { border-color: var(--pdx-color-warning); }\\n  [data-pdx-nirhpg] .resize-box.wide { border-color: var(--pdx-color-success); }\\n  [data-pdx-nirhpg] .stats { display: flex; gap: 20px; font-size: 0.9rem; }\\n  [data-pdx-nirhpg] .badges { display: flex; gap: 8px; }\\n  [data-pdx-nirhpg] .badge { padding: 2px 8px; border-radius: 99px; font-size: 0.7rem; font-weight: 600; background: var(--pdx-color-inset); color: var(--pdx-color-muted); }\\n  [data-pdx-nirhpg] .badge.on { background: var(--pdx-color-primary); color: var(--pdx-color-primary-text); }\\n  [data-pdx-nirhpg] .card { flex: 1; padding: 8px; background: var(--pdx-color-inset); border-radius: 6px; text-align: center; font-size: 0.8rem; }\\n  [data-pdx-nirhpg] .card-row { display: flex; gap: 8px; }\\n";
}

component('pdx-demo-infra-container-container-size', {
  props: {},
  setup(ctx) {
    const __width = signal(0, { name: 'demo-infra-container-container-size:width' });
    const __height = signal(0, { name: 'demo-infra-container-container-size:height' });
    const __isCompact = signal(true, { name: 'demo-infra-container-container-size:isCompact' });
    const __isMedium = signal(false, { name: 'demo-infra-container-container-size:isMedium' });
    const __isWide = signal(false, { name: 'demo-infra-container-container-size:isWide' });
    const __resizeRef = signal(null, { name: 'demo-infra-container-container-size:resizeRef' });
/** The border's class, from the breakpoint: computed, not written by the effect (CD-D2). */
    const bpClass = computed(() => __isCompact() ? 'compact' : __isMedium() ? 'medium' : 'wide', { name: 'demo-infra-container-container-size:bpClass' });
    onMount(() => {
    requestAnimationFrame(() => {
        const el = __resizeRef();
        if (!el) return;

        const cs = useContainerSize(() => el);

        effect(() => {
            __width.set(cs.width());
            __height.set(cs.height());
            __isCompact.set(cs.isCompact());
            __isMedium.set(cs.isMedium());
            __isWide.set(cs.isWide());
        });
    });
});
    ctx.el.setAttribute('data-pdx-nirhpg', '');
    return { width: __width, height: __height, isCompact: __isCompact, isMedium: __isMedium, isWide: __isWide, bpClass, resizeRef: __resizeRef };
  },
  render: (ctx) => html\`

  let __pdx_style = document.getElementById("pdx-s-q0t8c6");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-q0t8c6"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-q0t8c6] .user-list { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }\\n  [data-pdx-q0t8c6] .status-bar { display: flex; gap: 6px; margin: 8px 0; }\\n  [data-pdx-q0t8c6] .tag { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.75rem; }\\n  [data-pdx-q0t8c6] .tag.success { background: #d4edda; color: #155724; }\\n  [data-pdx-q0t8c6] .tag.error { background: #f8d7da; color: #721c24; }\\n  [data-pdx-q0t8c6] .tag.info { background: #e2e3e5; color: #383d41; }\\n  [data-pdx-q0t8c6] .list { list-style: none; padding: 0; }\\n  [data-pdx-q0t8c6] .list li { padding: 6px 0; border-bottom: 1px solid #eee; font-size: 0.9rem; }\\n  [data-pdx-q0t8c6] .loading { color: #856404; background: #fff3cd; padding: 8px; border-radius: 4px; }\\n  [data-pdx-q0t8c6] .error { color: #721c24; background: #f8d7da; padding: 8px; border-radius: 4px; }\\n  [data-pdx-q0t8c6] .actions { margin-top: 8px; display: flex; gap: 6px; }\\n  [data-pdx-q0t8c6] button { padding: 6px 14px; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; background: #f8f9fa; }\\n  [data-pdx-q0t8c6] button:hover { background: #e9ecef; }\\n";
}

component('pdx-user-list', {
  props: {
    title: { type: String, default: 'Users' }
  },
  setup(ctx) {
let users = resource(() => {
        return new Promise((resolve) => {
          setTimeout(() => resolve([
            { name: 'Alice', role: 'Admin' },
            { name: 'Bob', role: 'Developer' },
            { name: 'Charlie', role: 'Designer' },
          ]), 600);
        });
      }, { key: 'demo-users', staleTime: 10000 });
    const userData = computed(() => users.data() || [], { name: 'user-list:userData' });
    const userCount = computed(() => userData().length, { name: 'user-list:userCount' });
    const stateClass = computed(() => users.state() === 'success' ? 'success' : users.state() === 'error' ? 'error' : 'info', { name: 'user-list:stateClass' });
    
    
    
    
    
    
      function doRefetch() { users.refetch(); }
      function addLocal() {
        const current = users.data() || [];
        users.mutate([...current, { name: 'New User', role: 'Guest' }]);
      }
    ctx.el.setAttribute('data-pdx-q0t8c6', '');
    return { users, userData, userCount, stateClass, doRefetch, addLocal };
  },
  render: (ctx) => html\`
  <div class="user-list">
    <h3>\${ctx.title}</h3>
    <div class="status-bar">
      <span class="tag" :class=\${() => ctx.stateClass()}>\${() => ctx.users.state()}</span>
      <span class="tag info">\${ctx.userCount} users</span>
    </div>
    \${when(() => ctx.users.loading(), () => html\`
      <div class="loading">Loading users...</div>
    \`, null)}\${when(() => ctx.users.state() === 'success' || ctx.users.state() === 'local', () => html\`
      <ul class="list">
        \${eachRow(() => ctx.userData(), 'name', (user) => html\`
          <li>\${() => user().name} — \${() => user().role}</li>
        \`)}</ul>
    \`, null)}\${when(() => ctx.users.state() === 'error', () => html\`
      <div class="error">Failed to load</div>
    \`, null)}<div class="actions">
      <button @click=\${safeHandler(ctx.doRefetch, ctx.el?.tagName?.toLowerCase(), 'click')}>Refetch</button>
      <button @click=\${safeHandler(ctx.addLocal, ctx.el?.tagName?.toLowerCase(), 'click')}>+ Add Local</button>
    </div>
  </div>
\`,
});
"
`;

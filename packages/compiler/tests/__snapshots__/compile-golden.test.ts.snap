or-warning-hover)"></div> </div> <span class="pdx-txt-small">Warning</span> <code class="pdx-txt-caption">caution</code> </div> <div class="swatch-group"> <div class="swatch-pair"> <div class="swatch" style="background:var(--pdx-color-info)"></div> <div class="swatch sm" style="background:var(--pdx-color-info-hover)"></div> </div> <span class="pdx-txt-small">Info</span> <code class="pdx-txt-caption">informational</code> </div> </div> <details class="source-block"> <summary>Source</summary> <pre class="pdx-txt-mono"><code>/* Each color: base + hover + text (where needed). The base values, from tokens.css: */\\n--pdx-color-primary:         oklch(0.35 0.02 260)\\n--pdx-color-primary-hover:   oklch(0.28 0.03 260)\\n--pdx-color-secondary:       light-dark(oklch(0.55 0.18 30), oklch(0.55 0.16 30))\\n--pdx-color-accent:          light-dark(oklch(0.55 0.12 170), oklch(0.65 0.12 170))\\n--pdx-color-danger:          light-dark(oklch(0.55 0.20 25), oklch(0.575 0.18 25))\\n--pdx-color-success:         light-dark(oklch(0.52 0.18 155), ...)\\n--pdx-color-warning:         light-dark(oklch(0.75 0.15 85), ...)\\n--pdx-color-info:            light-dark(oklch(0.52 0.16 220), ...)\\n\\n/* A theme sets its own primary, accent and hue anchor:\\n   --pdx-hue-primary: 235 (pragmatic)\\n   --pdx-hue-primary: 85  (pragmatic gold) */</code></pre> </details> </section> '));

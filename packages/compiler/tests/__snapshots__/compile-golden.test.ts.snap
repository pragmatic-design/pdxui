    <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Always-visible labels</h3>
    <div class="demo-stack">
      <pdx-slider value="42" labelAlways marks="0,50,100" label="Volume"></pdx-slider>
    </div>

    <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Keyboard</h3>
    <div class="shortcut-list">
      <div><kbd>←</kbd> / <kbd>→</kbd> / <kbd>↑</kbd> / <kbd>↓</kbd> Step by <code>step</code></div>
      <div><kbd>Page Up</kbd> / <kbd>Page Down</kbd> Step ×10</div>
      <div><kbd>Home</kbd> / <kbd>End</kbd> Jump to min/max</div>
    </div>


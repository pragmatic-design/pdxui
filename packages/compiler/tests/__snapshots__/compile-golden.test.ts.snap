import { assignBoundProperty, component, effect, staticBlock, staticMarkup } from '@pdxui/core';

const __blk0=staticBlock(staticMarkup(' <section> <h2 class="pdx-txt-heading section-heading">Lazy Loading</h2> <p class="pdx-txt-small pdx-ink-muted"> <code>loadChildren</code> fetches a node\\'s children the first time it is opened; the column says\\n      "Loading..." meanwhile. Here each country\\'s regions arrive after 600 ms. A node marked\\n      <code>isLeaf: true</code> is never asked.\\n    </p> <div class="demo-row"> <pdx-cascader placeholder="Pick a region"></pdx-cascader> </div> <details class="source-block"> <summary>Source</summary> <pre class="pdx-txt-mono"><code>const countries = [{ value: \\'it\\', label: \\'Italy\\', isLeaf: false }, …];\\nfunction loadRegions(node) {\\n  return fetch(\\'/api/regions?country=\\' + node.value).then(r =&gt; r.json());   // [{ value, label, isLeaf: true }]\\n}\\n\\n&lt;pdx-cascader :options="countries" :load-children="loadRegions"&gt;&lt;/pdx-cascader&gt;</code></pre> </details> </section> '));
const __walk0=(r)=>{const __el0=r.firstChild.nextSibling;const __el5=__el0.firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling;const __el6=__el5.firstChild.nextSibling;return [__el6];};
component('app-demo-comp-cascader-lazy', {
  props: {},
  setup(ctx) {
// Lazy loading: the countries have no children until opened; loadRegions stands in for a server.
    const lazyCountries = [
      { value: 'it', label: 'Italy', isLeaf: false },
      { value: 'fr', label: 'France', isLeaf: false },
      { value: 'jp', label: 'Japan', isLeaf: false },
    ];
    
    
    const REGIONS = {
      it: ['Lazio', 'Lombardy', 'Tuscany'],
      fr: ['Brittany', 'Normandy', 'Provence'],
      jp: ['Hokkaido', 'Kansai', 'Kanto'],
    };
    
    
    function loadRegions(node) {
      return new Promise((resolve) => setTimeout(() => resolve(
        (REGIONS[node.value] || []).map((label) => ({ value: label.toLowerCase(), label, isLeaf: true })),
      ), 600));
    }
    return { lazyCountries, REGIONS, loadRegions };
  },
  render: (ctx) => (() => {
    const __frag=__blk0();
    const [__el6]=__walk0(__frag);
    let __el6w_options = {}; effect(() => { const __b = ctx.lazyCountries; if (Object.is(__b, __el6w_options)) return; __el6w_options = __b; assignBoundProperty(__el6, "options", __b); });

const __blk0=staticBlock(staticMarkup(' <div class="page"> <h1 class="pdx-txt-title">Toolbar</h1> <p class="pdx-txt-body pdx-ink-muted intro"> <code>&lt;pdx-toolbar&gt;</code> — horizontal toolbar container with buttons, separators, groups, and spacers.\\n      It is one tab stop: ←/→ (↑/↓ when <code>vertical</code>), Home and End move between its controls,\\n      and Tab comes back to the last one used. Name it with <code>label</code>, and every icon-only button with <code>aria-label</code>.\\n    </p> <app-demo-comp-toolbar-text-editor class="demo-section"></app-demo-comp-toolbar-text-editor> <app-demo-comp-toolbar-file-actions class="demo-section"></app-demo-comp-toolbar-file-actions> <app-demo-comp-toolbar-compact class="demo-section"></app-demo-comp-toolbar-compact> <section> <h2 class="pdx-txt-heading section-heading">Props</h2> <div class="options-table"> <table><thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead><tbody><tr><td><code>compact</code></td><td>Boolean</td><td>false</td><td>Less padding</td></tr><tr><td><code>bordered</code></td><td>Boolean</td><td>false</td><td>Show border + background</td></tr><tr><td><code>vertical</code></td><td>Boolean</td><td>false</td><td>Vertical orientation: ↑/↓ move between the controls</td></tr><tr><td><code>label</code></td><td>String</td><td>\\'Toolbar\\'</td><td>The toolbar\\'s accessible name</td></tr></tbody></table> </div> </section> <section> <h2 class="pdx-txt-heading section-heading">CSS Classes</h2> <div class="options-table"> <table><thead><tr><th>Class</th><th>Description</th></tr></thead><tbody><tr><td><code>.pdx-toolbar-sep</code></td><td>Vertical separator between groups</td></tr><tr><td><code>.pdx-toolbar-spacer</code></td><td>Flexible space (push right)</td></tr><tr><td><code>.pdx-toolbar-group</code></td><td>Fused button group (joined borders)</td></tr></tbody></table> </div> </section> </div> '));

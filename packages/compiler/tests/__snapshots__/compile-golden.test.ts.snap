exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-auto-form/demo-comp-auto-form-one-json.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createDataSource, html, toColumnDefs } from '@pdxui/core';

component('pdx-demo-comp-auto-form-one-json', {
  props: {},
  setup(ctx) {
const roles = ['Engineer', 'Designer', 'PM', 'DevOps', 'QA'];
    
    
    // Tri-component demo: same fields drive filter + grid + form
    const triFields = [
      { field: 'name', label: 'Name', type: 'text' },
      { field: 'role', label: 'Role', type: 'enum', options: roles.map(function(r) { return { label: r, value: r }; }) },
      { field: 'salary', label: 'Salary', type: 'currency' },
    ];
    
    
    const triColumns = toColumnDefs(triFields);
    
    
    var triData = [
      { id: 1, name: 'Alice', role: 'Engineer', salary: 95000 },
      { id: 2, name: 'Bob', role: 'Designer', salary: 82000 },
      { id: 3, name: 'Carol', role: 'PM', salary: 105000 },
      { id: 4, name: 'David', role: 'DevOps', salary: 91000 },
      { id: 5, name: 'Eve', role: 'QA', salary: 78000 },
    ];
    
    
    const triDS = createDataSource({ data: triData, pageSize: 0 });
    return { roles, triFields, triColumns, triDS };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">One JSON — Grid + Form + Filter</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      The same <code>FieldDefinition[]</code> drives all three components.
      Filter the grid, then edit the first record in the form below and save: the grid shows the change.
    </p>
    <div class="demo-container" style="max-width:100%">
      <p class="pdx-txt-small pdx-weight-medium">Filter</p>
      <pdx-filter-builder :fields=\${() => ctx.triFields} :source=\${() => ctx.triDS}></pdx-filter-builder>
      <p class="pdx-txt-small pdx-weight-medium" style="margin-top:var(--pdx-space-md)">Grid</p>
      <pdx-data-grid :source=\${() => ctx.triDS} :columns=\${() => ctx.triColumns} hover striped></pdx-data-grid>
      <p class="pdx-txt-small pdx-weight-medium" style="margin-top:var(--pdx-space-md)">Form (edit first record)</p>
      <pdx-auto-form :fields=\${() => ctx.triFields} :source=\${() => ctx.triDS} record-id="1" layout="grid" :columns=\${12}></pdx-auto-form>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>// ONE definition → three components
const fields = [...];
&lt;pdx-filter-builder :fields="fields" :source="ds" /&gt;
&lt;pdx-data-grid :source="ds" :columns="toColumnDefs(fields)" /&gt;
&lt;pdx-auto-form :fields="fields" :source="ds" record-id="1" /&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-auto-form/demo-comp-auto-form-server-lookup.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';

component('pdx-demo-comp-auto-form-server-lookup', {
  props: {},
  setup(ctx) {
// Server-side lookup field (type: 'lookup') — options loaded on demand while typing.
    const allCities = ['Milano', 'Roma', 'Torino', 'Napoli', 'Bologna', 'Firenze', 'Venezia', 'Genova', 'Palermo', 'Bari', 'Verona'];
    
    
    function loadCities(query) {
      return new Promise(function(resolve) {
        setTimeout(function() {
          const q = (query || '').toLowerCase();
          resolve(allCities.filter(function(c) { return c.toLowerCase().includes(q); }).map(function(c) { return { label: c, value: c }; }));
        }, 200);
      });
    }
    
    const lookupSchema = {
      fields: [
        { name: 'name', label: 'Name', type: 'text', required: true, validators: [{ type: 'required' }] },
        { name: 'city', label: 'City (server lookup)', type: 'lookup', optionsSource: loadCities, placeholder: 'Type to search…' },
        { name: 'cities', label: 'Cities (multi-value)', type: 'lookup', multiple: true, optionsSource: loadCities, placeholder: 'Pick several…' },
      ],
      layout: 'grid', columns: 12,
    };
    return { allCities, loadCities, lookupSchema };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Server-side Lookup (autocomplete)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      A <code>type: 'lookup'</code> field with <code>optionsSource</code> loads its options
      <strong>from the server as you type</strong> (a remote autocomplete). Type "ro" in City;
      the multi-value lookup below it picks several, as chips.
    </p>
    <div class="demo-container">
      <pdx-auto-form :schema=\${() => ctx.lookupSchema}></pdx-auto-form>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>function loadCities(query) {
  return fetch('/api/cities?q=' + query).then(r =&gt; r.json()); // [{ label, value }]
}

const schema = { fields: [
  { name: 'name', label: 'Name', type: 'text', required: true },
  { name: 'city', label: 'City', type: 'lookup', optionsSource: loadCities },
  // many-to-many: multi-value lookup → chips, value is an array
  { name: 'cities', label: 'Cities', type: 'lookup', multiple: true, optionsSource: loadCities },
] };</code></pre>
    </details>
  </section>
\`,
});
"
`;


  __pdx_style.textContent = "\\n[data-pdx-1nn4v2] .custom-slide { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 300px; background: linear-gradient(135deg, var(--pdx-color-primary), var(--pdx-color-accent, var(--pdx-color-primary))); color: var(--pdx-color-primary-text); text-align: center; padding: var(--pdx-space-xl); }\\n[data-pdx-1nn4v2] .custom-slide h3 { margin: var(--pdx-space-sm) 0 var(--pdx-space-xs); font-size: 1.5rem; }\\n[data-pdx-1nn4v2] .custom-slide p { margin: 0; opacity: 0.85; }\\n";
}

component('pdx-demo-comp-carousel-slot-template', {
  props: {},
  setup(ctx) {
const slotSlides = [
      { title: 'Welcome', desc: 'Get started with our platform in minutes.' },
      { title: 'Features', desc: 'Explore powerful tools built for your team.' },
      { title: 'Pricing', desc: 'Simple, transparent plans for every size.' },
    ];
    ctx.el.setAttribute('data-pdx-1nn4v2', '');
    return { slotSlides };
  },
  render: (ctx) => {
    const __pdxSlot_slide_0 = (__scope) => { const { slide, index } = __scope; return html\`
          <div class="custom-slide">
            <pdx-badge variant="outline" class="slide-step">Step \${() => index + 1}</pdx-badge>
            <h3>\${slide.title}</h3>
            <p>\${slide.desc}</p>
          </div>
        \`; };
    return html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Slot Template</h2>
    <p class="pdx-txt-small pdx-ink-muted">Custom slide content via scoped slot. Receives <code>slide</code>, <code>index</code>, and <code>isActive</code>.</p>
    <div class="demo-container">
      <pdx-carousel :items=\${() => ctx.slotSlides}>
        \${slotCarrier('slide', __pdxSlot_slide_0)}

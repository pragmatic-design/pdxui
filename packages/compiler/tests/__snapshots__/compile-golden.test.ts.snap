const __blk0=staticBlock(staticMarkup(' <section> <h2 class="pdx-txt-heading section-heading">Authenticated Image</h2> <p class="pdx-txt-small pdx-ink-muted">Uses <code>:fetch-fn</code> to load images from protected endpoints. The function adds JWT headers and returns a Blob. Below: simulated auth fetch with a 1s delay (same-origin in production).</p> <div class="demo-row"> <pdx-image src="/demo-images/city.svg" alt="Authenticated" width="300px" height="200px"></pdx-image> </div> <div class="event-log pdx-txt-mono pdx-txt-small" id="auth-log"><!----></div> <details class="source-block"> <summary>Source</summary> <pre class="pdx-txt-mono"><code>// Production: fetch with JWT headers\\nfunction authFetch(url) {\\n  return fetch(url, {\\n    headers: { Authorization: \\'Bearer \\' + getToken() }\\n  }).then(r =&gt; r.blob());\\n}\\n\\n&lt;pdx-image src="/api/images/123"\\n  :fetch-fn="authFetch"&gt;\\n&lt;/pdx-image&gt;\\n\\n// Or use auth-src + auth-provider:\\n&lt;pdx-image auth-src="/api/images/123"\\n  :auth-provider="() =&gt; ({ Authorization: \\'Bearer ...\\' })"&gt;\\n&lt;/pdx-image&gt;</code></pre> </details> </section> '));
const __walk0=(r)=>{const __el0=r.firstChild.nextSibling;const __el4=__el0.firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling;const __el5=__el4.firstChild.nextSibling;const __el6=__el4.nextSibling.nextSibling;const __t7=__el6.firstChild;return [__el5,__t7];};
component('app-demo-comp-image-authenticated', {
  props: {},
  setup(ctx) {
    const __authLog = signal('Waiting for auth fetch...', { name: 'demo-comp-image-authenticated:authLog' });
const authFetchFn = function(url) {
        __authLog.setRaw('Fetching with auth: Authorization: Bearer fake-jwt-...');
        return new Promise(function(resolve) {
            setTimeout(function() {
                fetch(url).then(function(r) { return r.blob(); }).then(function(blob) {

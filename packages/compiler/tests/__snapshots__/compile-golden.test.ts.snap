"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-zdbkwz");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-zdbkwz"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-zdbkwz] .event-log { margin-top: var(--pdx-space-sm); padding: var(--pdx-space-xs) var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-sm); }\\n";
}

component('pdx-demo-comp-pagination-basic', {
  props: {},
  setup(ctx) {
    const __pageLog = signal('Click a page...', { name: 'demo-comp-pagination-basic:pageLog' });
function onPageChange(e) {
      __pageLog.set('pdx-change: page ' + e.detail.page + ', pageSize ' + e.detail.pageSize);
    }
    ctx.el.setAttribute('data-pdx-zdbkwz', '');
    return { pageLog: __pageLog, onPageChange };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">10 pages. Click page numbers or arrows to navigate.</p>
    <div class="demo-row">
      <pdx-pagination :total=\${100} :page-size=\${10} :page=\${1} @pdx-change=\${safeHandler(ctx.onPageChange, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-pagination>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-pagination :total="100" :pageSize="10" :page="1" @pdx-change="onPageChange"&gt;
&lt;/pdx-pagination&gt;</code></pre>
    </details>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="page-event-log">\${ctx.pageLog}</div>
  </section>
\`,
});
"
`;


import { component, html, onMount, staticBlock, staticMarkup, useHead } from '@pdxui/core';
import { useThemeMeasure } from './sections/design-themes/state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-31vk8l");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-31vk8l"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n@scope ([data-pdx-31vk8l]) to ([data-pdx-root] \\u003E *) {:scope .page { max-width: 960px; }\\n:scope .intro { margin-bottom: var(--pdx-space-xl); }\\n}";
}

const __blk0=staticBlock(staticMarkup(' <div class="page"> <h1 class="pdx-txt-title">Themes &amp; Tokens</h1> <p class="pdx-txt-body pdx-ink-muted intro">\\n      A theme here is not a stylesheet you override — it is a set of <strong>token</strong> values the\\n      whole library reads. This page shows the consequences rather than describing them: every shipped\\n      theme rendering the same composition, the contrast rule computed live on this page, and the\\n      DTCG export a design tool can import.\\n    </p>  <app-demo-design-themes-themes class="demo-section"></app-demo-design-themes-themes>  <app-demo-design-themes-contrast class="demo-section"></app-demo-design-themes-contrast>  <app-demo-design-themes-dtcg class="demo-section"></app-demo-design-themes-dtcg>  <app-demo-design-themes-why class="demo-section"></app-demo-design-themes-why> </div> '));
component('app-design-themes', {
  props: {},
  setup(ctx) {
// The contrast and DTCG sections show what this measures (sections/design-themes/state.pdx.ts).
    const themeMeasure = useThemeMeasure();
    
    function measure() { themeMeasure.measure(); }
    onMount(() => {
    measure();
    // The header's theme picker rewrites \`pdx-theme\` on <html>; re-measure when it does, or the
    // figures would describe the theme the page was opened with rather than the one on screen.
    const obs = new MutationObserver(measure);
    obs.observe(document.documentElement, { attributes: true, attributeFilter: ['pdx-theme', 'pdx-scheme'] });
});
    useHead({ title: "Themes & Tokens — PDX UI" });
    ctx.el.setAttribute('data-pdx-31vk8l', '');
    return { themeMeasure, measure };
  },
  render: (ctx) => (() => {
    const __frag=__blk0();
    return __frag;
  })(),
});

// Auto-route: @page '/design/themes'
if(!globalThis.__pdx_routes)globalThis.__pdx_routes=[];
const __pdx_pushRoute=(r)=>{const i=globalThis.__pdx_routes.findIndex(x=>x.path===r.path);if(i>=0)globalThis.__pdx_routes[i]=r;else globalThis.__pdx_routes.push(r);globalThis.__pdx_routeRegistered&&globalThis.__pdx_routeRegistered(r.path);};
__pdx_pushRoute({path:"/design/themes",tag:"app-design-themes",title:"Themes & Tokens — PDX UI",lazy:true,file:'./design-themes.pdx'});
"
`;


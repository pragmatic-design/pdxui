exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-timeline/demo-comp-timeline-clickable.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-qbqa1");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-qbqa1"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-qbqa1] .event-log { margin-top: var(--pdx-space-sm); padding: var(--pdx-space-xs) var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-sm); max-width: 500px; }\\n";
}

component('pdx-demo-comp-timeline-clickable', {
  props: {},
  setup(ctx) {
    const __timelineLog = signal('Click an event...', { name: 'demo-comp-timeline-clickable:timelineLog' });
const basicEvents = [
      { title: 'Order Placed', description: 'Your order #12345 has been placed.', date: 'Apr 1, 2026' },
      { title: 'Payment Confirmed', description: 'Payment received via credit card.', date: 'Apr 1, 2026' },
      { title: 'Shipped', description: 'Package left the warehouse.', date: 'Apr 3, 2026' },
      { title: 'Out for Delivery', description: 'Package is with the courier.', date: 'Apr 5, 2026' },
      { title: 'Delivered', description: 'Package delivered to front door.', date: 'Apr 5, 2026' },
    ];
    
    
    
    
    function onTimelineClick(evt) {
      __timelineLog.set('Clicked: ' + evt.detail.item.title + ' (index: ' + evt.detail.index + ')');
    }
    ctx.el.setAttribute('data-pdx-qbqa1', '');
    return { basicEvents, timelineLog: __timelineLog, onTimelineClick };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Clickable</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click an event to see the detail.</p>
    <div class="demo-container">
      <pdx-timeline :items=\${() => ctx.basicEvents} clickable @pdx-click=\${safeHandler(ctx.onTimelineClick, ctx.el?.tagName?.toLowerCase(), 'pdx-click')}></pdx-timeline>
    </div>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="timeline-log">\${ctx.timelineLog}</div>
  </section>
\`,
});
"
`;


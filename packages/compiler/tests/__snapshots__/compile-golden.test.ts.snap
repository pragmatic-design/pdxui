"// 0 warning(s)

============================================================
import { component, effect, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-wmtwfp");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-wmtwfp"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-wmtwfp] .responsive-frame {\\n  width: 700px;\\n  min-width: 280px;\\n  max-width: 100%;\\n  border: 2px solid var(--pdx-color-border);\\n  border-radius: 12px;\\n  overflow: hidden;\\n  resize: horizontal;\\n  background: var(--pdx-color-bg);\\n}\\n[data-pdx-wmtwfp] .resp-navbar-wrap {\\n  background: var(--pdx-color-surface);\\n  border-bottom: 1px solid var(--pdx-color-border);\\n}\\n[data-pdx-wmtwfp] .resp-content {\\n  padding: var(--pdx-space-xl);\\n  text-align: center;\\n  min-height: 150px;\\n  display: flex;\\n  flex-direction: column;\\n  align-items: center;\\n  justify-content: center;\\n  gap: var(--pdx-space-sm);\\n}\\n";
}

component('pdx-demo-comp-navbar-responsive', {
  props: {},
  setup(ctx) {
    const __respFrame = signal(null, { name: 'demo-comp-navbar-responsive:respFrame' });
    const __respHamburger = signal(null, { name: 'demo-comp-navbar-responsive:respHamburger' });
    const __respNav = signal(null, { name: 'demo-comp-navbar-responsive:respNav' });
    const __respDrawer = signal(null, { name: 'demo-comp-navbar-responsive:respDrawer' });
    const __respWidth = signal('Width: —', { name: 'demo-comp-navbar-responsive:respWidth' });
function toggleResp() {
      if (__respDrawer()) __respDrawer().classList.toggle('pdx-navbar-drawer-open');
    }
    
    // The frame's width decides hamburger or links. The effect runs again when the refs fill, so it
    // attaches once the elements exist, and its cleanup disconnects the observer with the page.
    ctx.track(() => {
  const frame = __respFrame();
  const hamburger = __respHamburger();
  const nav = __respNav();
  if (!frame || !hamburger || !nav) return;
  const observer = new ResizeObserver((entries) => {
    const w = Math.round(entries[0].contentRect.width);
    __respWidth.set('Width: ' + w + 'px');
    if (w < 500) {
      hamburger.style.display = 'flex';
      nav.style.display = 'none';
    } else {
      hamburger.style.display = 'none';
      nav.style.display = 'flex';
      if (__respDrawer()) __respDrawer().classList.remove('pdx-navbar-drawer-open');
    }
  });
  observer.observe(frame);
  return () => observer.disconnect();
}, { name: "demo-comp-navbar-responsive.pdx:55" });
    ctx.el.setAttribute('data-pdx-wmtwfp', '');
    return { respFrame: __respFrame, respHamburger: __respHamburger, respNav: __respNav, respDrawer: __respDrawer, respWidth: __respWidth, toggleResp };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Responsive Preview</h2>
    <p class="pdx-txt-small pdx-ink-muted">Drag the right edge to resize. Below ~500px: hamburger appears, nav links hide, drawer toggles on click.</p>
    <div class="responsive-frame" id="resp-frame" :ref=\${ctx.respFrame}>
      <div class="resp-navbar-wrap">
        <div class="pdx-navbar-bar">
          <div class="pdx-navbar-brand">
            <pdx-icon name="package" size="20"></pdx-icon>
            <strong>App</strong>
          </div>
          <button class="pdx-navbar-hamburger" id="resp-hamburger" :ref=\${ctx.respHamburger} style="display: none" @click=\${safeHandler(ctx.toggleResp, ctx.el?.tagName?.toLowerCase(), 'click')}>
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"><path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M4 18h16"></path></svg>
          </button>
          <nav class="pdx-navbar-nav" id="resp-nav" :ref=\${ctx.respNav} role="navigation">
            <a class="pdx-navbar-link active" href="#">Dashboard</a>
            <a class="pdx-navbar-link" href="#">Projects</a>
            <a class="pdx-navbar-link" href="#">Team</a>
            <a class="pdx-navbar-link" href="#">Settings</a>
          </nav>
          <div class="pdx-navbar-spacer"></div>
          <div class="pdx-navbar-actions">
            <button class="pdx-navbar-icon-btn"><pdx-icon name="bell" size="18"></pdx-icon></button>
            <span class="pdx-navbar-user"><span class="pdx-navbar-user-avatar">A</span></span>
          </div>
        </div>
        <div class="pdx-navbar-drawer" id="resp-drawer" :ref=\${ctx.respDrawer}>
          <a class="pdx-navbar-link active" href="#">Dashboard</a>
          <a class="pdx-navbar-link" href="#">Projects</a>
          <a class="pdx-navbar-link" href="#">Team</a>
          <a class="pdx-navbar-link" href="#">Settings</a>
        </div>
      </div>
      <div class="resp-content">
        <p class="pdx-ink-muted pdx-txt-small">Main content area. Drag the right edge of this frame to see responsive behavior.</p>
        <p class="pdx-txt-mono pdx-txt-small" id="resp-width-display">\${ctx.respWidth}</p>
      </div>
    </div>
  </section>
\`,
});
"
`;


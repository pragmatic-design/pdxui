  __pdx_style.textContent = "\\n  [data-pdx-qui0xl] .demo { max-width: 600px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-qui0xl] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-qui0xl] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-qui0xl] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-qui0xl] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-qui0xl] .list { display: flex; flex-direction: column; gap: 4px; }\\n  [data-pdx-qui0xl] .list-item { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 6px; user-select: none; }\\n  [data-pdx-qui0xl] .grip { cursor: grab; color: #999; font-size: 1.2rem; }\\n  [data-pdx-qui0xl] .grip:active { cursor: grabbing; }\\n  [data-pdx-qui0xl] .tabs { display: flex; gap: 4px; }\\n  [data-pdx-qui0xl] .tab { padding: 8px 18px; background: #f0f0f0; border: 1px solid #e0e0e0; border-radius: 6px 6px 0 0; cursor: grab; user-select: none; font-size: 0.9rem; }\\n  [data-pdx-qui0xl] .tab:active { cursor: grabbing; }\\n  [data-pdx-qui0xl] .log { font-family: monospace; font-size: 0.8rem; background: #f5f5f7; padding: 8px; border-radius: 6px; margin: 8px 0 0; white-space: pre-wrap; }\\n";

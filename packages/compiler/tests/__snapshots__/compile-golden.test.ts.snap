      { key: 'sep1', type: 'separator' },
      { key: 'select-all', label: 'Select All', shortcut: 'Ctrl+A' },
      { key: 'sep2', type: 'separator' },
      { key: 'delete', label: 'Delete', icon: 'trash', shortcut: 'Del', danger: true },
    ];
    ctx.el.setAttribute('data-pdx-azcbho', '');
    return { contextMenuLog, ctxLog, onSelect, menuItems };

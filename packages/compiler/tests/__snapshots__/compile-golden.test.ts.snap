            selector: '[role="option"]',
            orientation: 'vertical',
            wrap: true,
            skipDisabled: true,
            onFocus: (el, i) => { __groupLog.set(\`Focused: \${el.textContent.trim()} (index \${i})\`); },
            onSelect: (el, i) => { __groupLog.set(\`Selected: \${el.textContent.trim()} (index \${i})\`); },

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-dropdown-menu/demo-comp-dropdown-menu-checkbox-radio.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-dropdown-menu-checkbox-radio', {
  props: {},
  setup(ctx) {
    const __lastCheck = signal('—', { name: 'demo-comp-dropdown-menu-checkbox-radio:lastCheck' });
const optionItems = [
      { key: 'grid', label: 'Grid view', type: 'radio', radioGroup: 'view', checked: true },
      { key: 'list', label: 'List view', type: 'radio', radioGroup: 'view' },
      { key: 'd1', label: '', type: 'separator' },
      { key: 'compact', label: 'Compact rows', type: 'checkbox', checked: false },
      { key: 'lines', label: 'Show grid lines', type: 'checkbox', checked: true },
    ];
    
    
    function onCheck(e) { __lastCheck.set(e.detail ? (e.detail.key + ' → ' + e.detail.checked) : '—'); }
    return { lastCheck: __lastCheck, optionItems, onCheck };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Checkbox &amp; radio items</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>type: 'checkbox'</code> renders a checkbox item; <code>type: 'radio'</code> with a shared
      <code>radioGroup</code> makes a single-choice group. <code>checked</code> is the initial state.
      Toggling one emits <code>pdx-check</code> with the item and keeps the menu open.
    </p>
    <div class="demo-stack">
      <pdx-dropdown-menu label="View options" :items=\${() => ctx.optionItems} @pdx-check=\${safeHandler(ctx.onCheck, ctx.el?.tagName?.toLowerCase(), 'pdx-check')}></pdx-dropdown-menu>
      <span class="pdx-txt-small pdx-ink-muted">Last toggle: <strong>\${ctx.lastCheck}</strong></span>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>const items = [
  { key: 'grid', label: 'Grid view', type: 'radio', radioGroup: 'view', checked: true },
  { key: 'list', label: 'List view', type: 'radio', radioGroup: 'view' },
  { key: 'd1', label: '', type: 'separator' },
  { key: 'compact', label: 'Compact rows', type: 'checkbox', checked: false },
  { key: 'lines', label: 'Show grid lines', type: 'checkbox', checked: true },
];

&lt;pdx-dropdown-menu label="View options" :items="items" @pdx-check="onCheck" /&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-dropdown-menu/demo-comp-dropdown-menu-custom-trigger.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler } from '@pdxui/core';
import { useDropdownMenuLog } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-v14bfh");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-v14bfh"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n\\n[data-pdx-v14bfh] .avatar-trigger { padding: 0; border: 0; background: none; border-radius: 50%; cursor: pointer; line-height: 0; }\\n[data-pdx-v14bfh] .avatar-trigger:focus-visible { outline: 2px solid var(--pdx-color-focus); outline-offset: 2px; }\\n";
}

component('pdx-demo-comp-dropdown-menu-custom-trigger', {
  props: {},
  setup(ctx) {
// The basic section shows the same line (state.pdx.ts).
    const dropdownMenuLog = useDropdownMenuLog();
    const lastSelect = computed(() => dropdownMenuLog.lastSelect(), { name: 'demo-comp-dropdown-menu-custom-trigger:lastSelect' });
    
    
    function onSelect(e) { dropdownMenuLog.onSelect(e); }
    
    const accountItems = [
      { key: 'profile', label: 'Profile', icon: 'user' },
      { key: 'settings', label: 'Settings', icon: 'settings' },
      { key: 'd1', label: '', type: 'separator' },
      { key: 'signout', label: 'Sign out', icon: 'log-out' },
    ];
    ctx.el.setAttribute('data-pdx-v14bfh', '');
    return { dropdownMenuLog, lastSelect, onSelect, accountItems };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Custom trigger</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      An element in <code>slot="trigger"</code> is the menu button: an avatar, a chip. The dropdown gives it
      <code>aria-haspopup</code>, <code>aria-expanded</code>, the keys and the focus back on close. An element that
      is not a <code>&lt;button&gt;</code> also gets <code>role="button"</code>, a tab stop, and <kbd>Enter</kbd> / <kbd>Space</kbd>.
    </p>
    <div class="demo-row">
      <pdx-dropdown-menu :items=\${() => ctx.accountItems} placement="bottom-end" @pdx-select=\${safeHandler(ctx.onSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-select')} data-test="dd-avatar">
        <button slot="trigger" class="avatar-trigger" aria-label="Account: Ada Lovelace">
          <pdx-avatar alt="Ada Lovelace" size="sm"></pdx-avatar>
        </button>
      </pdx-dropdown-menu>
      <span class="pdx-txt-small pdx-ink-muted">Last selected: <strong>\${ctx.lastSelect}</strong></span>
    </div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-dropdown-menu :items="accountItems" placement="bottom-end"&gt;
  &lt;button slot="trigger" aria-label="Account: Ada Lovelace"&gt;
    &lt;pdx-avatar alt="Ada Lovelace" size="sm" /&gt;
  &lt;/button&gt;
&lt;/pdx-dropdown-menu&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


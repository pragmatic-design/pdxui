        <span>Phone, credit card, custom masks</span>
      </div>
      <div class="roadmap-item">
        <strong>pdx-otp-input</strong>
        <span>N-cell code entry, paste handling, auto-advance</span>
      </div>
    </div>
  </section>
\`,
});
"
`;


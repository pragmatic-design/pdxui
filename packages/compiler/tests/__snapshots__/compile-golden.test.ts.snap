  <section>
    <h2 class="pdx-txt-heading section-heading">Common Ratios</h2>
    <div class="demo-grid">
      <div class="ratio-demo">
        <p class="pdx-txt-small pdx-ink-muted">16:9 (Video)</p>
        <pdx-aspect-ratio ratio="16/9">
          <div class="ratio-content">16:9</div>
        </pdx-aspect-ratio>

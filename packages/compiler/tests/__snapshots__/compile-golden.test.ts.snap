exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-row-col/demo-comp-row-col-animated.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-qfo1fq");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-qfo1fq"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-qfo1fq] .controls {\\n    display: flex;\\n    align-items: center;\\n    gap: var(--pdx-space-md);\\n    margin-top: var(--pdx-space-md);\\n    padding: var(--pdx-space-sm) var(--pdx-space-md);\\n    background: var(--pdx-color-inset);\\n    border-radius: var(--pdx-radius-md);\\n  }\\n  [data-pdx-qfo1fq] .controls input[type=\\"range\\"] {\\n    flex: 1;\\n    max-width: 300px;\\n  }\\n";
}

component('pdx-demo-comp-row-col-animated', {
  props: {},
  setup(ctx) {
    const __sidebarSpan = signal(3, { name: 'demo-comp-row-col-animated:sidebarSpan' });
function onSliderChange(e) {
        __sidebarSpan.set(Number(e.target.value));
    }
    const contentSpan = computed(() => 12 - __sidebarSpan(), { name: 'demo-comp-row-col-animated:contentSpan' });
    ctx.el.setAttribute('data-pdx-qfo1fq', '');
    return { sidebarSpan: __sidebarSpan, contentSpan, onSliderChange };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Animated Span Change</h2>
    <p class="pdx-txt-small pdx-ink-muted">Drag the slider to change column spans. The transition is animated.</p>

    <div class="demo-area">
      <pdx-row gutter="sm" align="stretch">
        <pdx-col :span=\${ctx.sidebarSpan}><div class="box tall">Sidebar</div></pdx-col>
        <pdx-col :span=\${ctx.contentSpan}><div class="box tall accent">Content</div></pdx-col>
      </pdx-row>
    </div>

    <div class="controls">
      <label class="pdx-txt-small">Sidebar span</label>
      <input type="range" min="1" max="8" :value=\${ctx.sidebarSpan} @input=\${safeHandler(ctx.onSliderChange, ctx.el?.tagName?.toLowerCase(), 'input')} />
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-row gutter="sm"&gt;
  &lt;pdx-col :span="sidebarSpan"&gt;Sidebar&lt;/pdx-col&gt;
  &lt;pdx-col :span="contentSpan"&gt;Content&lt;/pdx-col&gt;
&lt;/pdx-row&gt;

&lt;!-- Change sidebarSpan signal and the columns animate --&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


    <details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>const prefillForm = createForm({
  initialValues: { name: '', email: '', role: '', department: '', bio: '' },
  validators: { name: [required(...)], email: [required(...), email(...)] },
});


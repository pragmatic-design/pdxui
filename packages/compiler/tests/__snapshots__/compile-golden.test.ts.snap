exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-error-boundary/demo-comp-error-boundary-network-fetch.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-vq18q8");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-vq18q8"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "/* Global: the spinner is async-action's too. */\\n.pdx-error-meta {\\n  font-size: var(--pdx-text-xs);\\n  color: var(--pdx-color-muted);\\n  margin-bottom: var(--pdx-space-sm);\\n}\\n\\n.pdx-btn-error {\\n  background: var(--pdx-color-danger);\\n  color: var(--pdx-color-danger-text);\\n  border: none;\\n  cursor: pointer;\\n}\\n.pdx-btn-error:hover { opacity: 0.85; }\\n.pdx-btn-error:disabled { opacity: 0.5; cursor: not-allowed; }\\n\\n.pdx-spinner-inline {\\n  width: 18px;\\n  height: 18px;\\n  border: 2px solid var(--pdx-color-border);\\n  border-top-color: var(--pdx-color-primary);\\n  border-radius: 50%;\\n  animation: pdx-spin 0.6s linear infinite;\\n}\\n@keyframes pdx-spin { to { transform: rotate(360deg); } }";
}

component('pdx-demo-comp-error-boundary-network-fetch', {
  props: {},
  setup(ctx) {
    const __netState = signal('idle', { name: 'demo-comp-error-boundary-network-fetch:netState' });
    const __netError = signal('', { name: 'demo-comp-error-boundary-network-fetch:netError' });
    const __netRetry = signal(0, { name: 'demo-comp-error-boundary-network-fetch:netRetry' });
    const __netCountdown = signal(0, { name: 'demo-comp-error-boundary-network-fetch:netCountdown' });
// ─── Network Fetch Simulation ───────────────────────────
    
    
    
    
    
    
    // Non-signal: timer IDs don't need reactivity
    const timers = { id: 0 };
    
    
    function startNetworkDemo() {
      __netState.set('loading');
      __netRetry.set(0);
      simulateFetch();
    }
    
    function simulateFetch() {
      setTimeout(() => {
        __netRetry.set(prev => prev + 1);
        __netError.set('NetworkError: fetch /api/users failed (ERR_CONNECTION_REFUSED)');
        __netState.set('error');
    
        if (__netRetry() < 3) {
          startCountdown(3, () => {
            __netState.set('loading');
            setTimeout(() => {
              if (__netRetry() >= 2) {
                __netState.set('success');
              } else {
                simulateFetch();
              }
            }, 800);
          });
        }
      }, 1000);
    }
    
    function startCountdown(seconds, onDone) {
      __netCountdown.set(seconds);
      timers.id = setInterval(() => {
        __netCountdown.set(prev => prev - 1);
        if (__netCountdown() <= 0) {
          clearInterval(timers.id);
          onDone();
        }
      }, 1000);
    }
    
    function resetNetworkDemo() {
      clearInterval(timers.id);
      timers.id = 0;
      __netState.set('idle');
      __netError.set('');
      __netRetry.set(0);
      __netCountdown.set(0);
    }
    return { netState: __netState, netError: __netError, netRetry: __netRetry, netCountdown: __netCountdown, timers, startNetworkDemo, simulateFetch, startCountdown, resetNetworkDemo };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Network Fetch — Retry with Countdown</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Simulates a network request that fails. Click "Load Users" to start.
      Auto-retries up to 3 times with a live countdown, then succeeds or gives up.
    </p>
    <div class="demo-box">
      \${when(() => ctx.netState() === 'idle', () => html\`
        <div class="demo-widget">
          <button class="pdx-btn pdx-btn-sm pdx-btn-outline" @click=\${safeHandler(ctx.startNetworkDemo, ctx.el?.tagName?.toLowerCase(), 'click')}>Load Users</button>
        </div>
      \`, null)}\${when(() => ctx.netState() === 'loading', () => html\`
        <div class="demo-widget state-loading" role="status">
          <div class="pdx-spinner-inline"></div>
          <span class="pdx-txt-small pdx-ink-muted">Fetching /api/users...</span>
        </div>
      \`, null)}\${when(() => ctx.netState() === 'error', () => html\`
        <div class="pdx-error-fallback" role="alert">
          <div class="pdx-error-icon">&#128268;</div>
          <div class="pdx-error-msg">Failed to load user data</div>
          <div class="pdx-error-detail">\${ctx.netError}</div>
          \${when(() => ctx.netRetry() < 3, () => html\`
            <div class="pdx-error-meta">Retry \${ctx.netRetry} of 3 — next attempt in \${ctx.netCountdown}s</div>
            <button class="pdx-btn pdx-btn-sm pdx-btn-error retry-btn" disabled>Retrying...</button>
          \`, () => html\`
            <div class="pdx-error-meta">Failed after 3 attempts.</div>
            <button class="pdx-btn pdx-btn-sm pdx-btn-outline retry-btn" @click=\${safeHandler(ctx.resetNetworkDemo, ctx.el?.tagName?.toLowerCase(), 'click')}>Start Over</button>
          \`)}
        </div>
      \`, null)}\${when(() => ctx.netState() === 'success', () => html\`
        <div class="demo-widget success-widget" role="status">
          <div class="pdx-txt-small" style="color: var(--pdx-color-success); font-weight: 600">&#10003; Data loaded successfully</div>
          <div class="pdx-txt-small pdx-ink-muted">Loaded 3 users after \${ctx.netRetry} failed attempts.</div>
          <button class="pdx-btn pdx-btn-sm pdx-btn-outline" style="margin-top: var(--pdx-space-xs)" @click=\${safeHandler(ctx.resetNetworkDemo, ctx.el?.tagName?.toLowerCase(), 'click')}>Reset</button>
        </div>
      \`, null)}</div>
    <details class="source"><summary>Source</summary><pre><code>@@try {
  &lt;pdx-user-list /&gt;
} @@catch (err) {
  &lt;div role="alert"&gt;
    {{ err.message }}
    &lt;button @@click="retry"&gt;Retry&lt;/button&gt;
  &lt;/div&gt;
}

// Or with onGlobalError:
onGlobalError((error, ctx) =&gt; {
  if (ctx.source === 'async') {
    showToast(error.message);
    return true; // handled
  }
});</code></pre></details>
  </section>
\`,
});
"
`;


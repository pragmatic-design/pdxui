  __pdx_style.textContent = "\\n[data-pdx-gvhxjx] .doc-links {\\n    display: grid;\\n    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\\n    gap: var(--pdx-space-md);\\n    margin-top: var(--pdx-space-lg);\\n}\\n[data-pdx-gvhxjx] .doc-card {\\n    display: flex; flex-direction: column; gap: 4px;\\n    padding: var(--pdx-space-md);\\n    border: 1px solid var(--pdx-color-border);\\n    border-radius: var(--pdx-radius-md);\\n    text-decoration: none;\\n    color: inherit;\\n    background: var(--pdx-color-surface);\\n}\\n[data-pdx-gvhxjx] .doc-card:hover { border-color: var(--pdx-color-primary); }\\n";

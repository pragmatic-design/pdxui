import { component, computed, html, safeHandler } from '@pdxui/core';
import { useToggleGroupDemo } from './state.pdx';

component('pdx-demo-comp-toggle-group-multiple', {
  props: {},
  setup(ctx) {
// The composition section's style group shows and sets the same value (state.pdx.ts).
    const toggleGroupDemo = useToggleGroupDemo();
    const formatting = computed(() => toggleGroupDemo.formatting(), { name: 'demo-comp-toggle-group-multiple:formatting' });
    
    
    function setFormatting(v) { toggleGroupDemo.setFormatting(v); }
    function sampleStyle() { return toggleGroupDemo.sampleStyle(); }
    return { toggleGroupDemo, formatting, setFormatting, sampleStyle };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Multiple</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Any number pressed. The event carries both forms: <code>detail.value</code> (<code>"bold,italic"</code>)
      and <code>detail.values</code> (an array).
    </p>
    <div class="demo-row">
      <pdx-toggle-group type="multiple" label="Formatting" :value=\${ctx.formatting} @pdx-change=\${safeHandler(e => ctx.setFormatting(e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}>
        <pdx-toggle value="bold" aria-label="Bold"><strong>B</strong></pdx-toggle>
        <pdx-toggle value="italic" aria-label="Italic"><em>I</em></pdx-toggle>
        <pdx-toggle value="underline" aria-label="Underline"><u>U</u></pdx-toggle>
        <pdx-toggle value="strike" aria-label="Strikethrough"><s>S</s></pdx-toggle>
      </pdx-toggle-group>
      <span class="pdx-txt-small pdx-ink-muted">value: <code class="live-value">\${() => ctx.formatting() || '(none)'}</code></span>
    </div>
    <p class="pdx-txt-small sample" :style=\${() => ctx.sampleStyle()}>Formatted sample text</p>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-toggle-group/demo-comp-toggle-group-single.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler } from '@pdxui/core';
import { useToggleGroupDemo } from './state.pdx';

component('pdx-demo-comp-toggle-group-single', {
  props: {},
  setup(ctx) {
// The composition section's alignment group shows and sets the same value (state.pdx.ts).
    const toggleGroupDemo = useToggleGroupDemo();
    const align = computed(() => toggleGroupDemo.align(), { name: 'demo-comp-toggle-group-single:align' });
    
    
    function setAlign(v) { toggleGroupDemo.setAlign(v); }
    return { toggleGroupDemo, align, setAlign };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Single</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      One pressed at a time. Pressing the pressed one again clears the value.
    </p>
    <div class="demo-row">
      <pdx-toggle-group type="single" label="Text alignment" :value=\${ctx.align} @pdx-change=\${safeHandler(e => ctx.setAlign(e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}>
        <pdx-toggle value="left">Left</pdx-toggle>
        <pdx-toggle value="center">Center</pdx-toggle>
        <pdx-toggle value="right">Right</pdx-toggle>
        <pdx-toggle value="justify">Justify</pdx-toggle>
      </pdx-toggle-group>
      <span class="pdx-txt-small pdx-ink-muted">value: <code class="live-value">\${() => ctx.align() || '(none)'}</code></span>
    </div>
    <p class="aligned pdx-txt-small" :style=\${() => 'text-align:' + (ctx.align() || 'left')}>
      This paragraph follows the group: the quick brown fox jumps over the lazy dog, and then it does it again,
      so that there are two lines to align.
    </p>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-toggle-group type="single" label="Text alignment"
  :value="align" @pdx-change="e =&gt; align = e.detail.value"&gt;
  &lt;pdx-toggle value="left"&gt;Left&lt;/pdx-toggle&gt;
  &lt;pdx-toggle value="center"&gt;Center&lt;/pdx-toggle&gt;
  &lt;pdx-toggle value="right"&gt;Right&lt;/pdx-toggle&gt;
  &lt;pdx-toggle value="justify"&gt;Justify&lt;/pdx-toggle&gt;
&lt;/pdx-toggle-group&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


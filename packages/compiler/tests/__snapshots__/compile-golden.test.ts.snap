import { component, computed, html } from '@pdxui/core';
import { useSortableTasks } from './state.pdx';

component('pdx-demo-comp-sortable-list-disabled', {
  props: {},
  setup(ctx) {
// The list the first section reorders (state.pdx.ts).
    const sortableTasks = useSortableTasks();
    const tasks = computed(() => sortableTasks.tasks(), { name: 'demo-comp-sortable-list-disabled:tasks' });
    return { sortableTasks, tasks };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Disabled</h2>
    <p class="pdx-txt-small pdx-ink-muted">The handles are dimmed, and neither the pointer nor the keyboard lifts a row.</p>

    <div class="demo-stack narrow">
      <pdx-sortable-list disabled :items=\${ctx.tasks}></pdx-sortable-list>
    </div>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-sortable-list/demo-comp-sortable-list-drag.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html, safeHandler } from '@pdxui/core';
import { useSortableTasks } from './state.pdx';

component('pdx-demo-comp-sortable-list-drag', {
  props: {},
  setup(ctx) {
// The disabled section shows the same list, in the order this one leaves it (state.pdx.ts).
    const sortableTasks = useSortableTasks();
    const tasks = computed(() => sortableTasks.tasks(), { name: 'demo-comp-sortable-list-drag:tasks' });
    const orderLine = computed(() => tasks().map(t => t.label).join(' · '), { name: 'demo-comp-sortable-list-drag:orderLine' });
    
    
    function onReorder(e) { sortableTasks.onReorder(e); }
    return { sortableTasks, tasks, onReorder, orderLine };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Drag a handle, or use the keyboard</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Grab the handle with the pointer, or Tab to it and press Space to lift, the arrows to move,
      Space to drop, Escape to cancel.
    </p>

    <div class="demo-stack narrow">
      <pdx-sortable-list :items=\${ctx.tasks} @pdx-reorder=\${safeHandler(ctx.onReorder, ctx.el?.tagName?.toLowerCase(), 'pdx-reorder')}></pdx-sortable-list>
      <p class="pdx-txt-small pdx-ink-muted">Order: \${ctx.orderLine}</p>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-sortable-list :items="tasks" @pdx-reorder="onReorder"&gt;&lt;/pdx-sortable-list&gt;

let tasks = $signal([{ id: 1, label: 'Triage' }, …]);

function onReorder(e) {
  const next = tasks.slice();
  next.splice(e.detail.to, 0, ...next.splice(e.detail.from, 1));
  tasks = next;
}</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-sortable-list/demo-comp-sortable-list-horizontal.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';
import { move } from './data.pdx';

component('pdx-demo-comp-sortable-list-horizontal', {
  props: {},
  setup(ctx) {
    const __columns = signal([
  { id: 'n', label: 'Name' },
  { id: 's', label: 'Status' },
  { id: 'o', label: 'Owner' },
], { name: 'demo-comp-sortable-list-horizontal:columns' });
function onColumnReorder(e) { __columns.set(prev => move(prev, e.detail)); }
    return { columns: __columns, onColumnReorder };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Horizontal</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>axis="horizontal"</code> lays the rows side by side, and the left/right arrows move
      them. Tab order and the announcements are the same.
    </p>

    <div class="demo-stack">
      <pdx-sortable-list axis="horizontal" :items=\${ctx.columns} @pdx-reorder=\${safeHandler(ctx.onColumnReorder, ctx.el?.tagName?.toLowerCase(), 'pdx-reorder')}></pdx-sortable-list>
    </div>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-sortable-list/demo-comp-sortable-list-rows.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal, slotCarrier } from '@pdxui/core';
import { move } from './data.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-ghfz00");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-ghfz00"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-ghfz00] .step-row { display: flex; align-items: center; gap: var(--pdx-space-sm); }\\n";
}

component('pdx-demo-comp-sortable-list-rows', {
  props: {},
  setup(ctx) {
    const __steps = signal([
  { id: 'a', label: 'Collect the logs', owner: 'Support' },
  { id: 'b', label: 'Reproduce', owner: 'Engineering' },
  { id: 'c', label: 'Ship the fix', owner: 'Engineering' },
], { name: 'demo-comp-sortable-list-rows:steps' });
function onStepReorder(e) { __steps.set(prev => move(prev, e.detail)); }
    ctx.el.setAttribute('data-pdx-ghfz00', '');
    return { steps: __steps, onStepReorder };
  },
  render: (ctx) => {
    const __pdxSlot_item_0 = (__scope) => { const { item, index } = __scope; return html\`
          <div class="step-row">
            <pdx-badge :value=\${() => index + 1}></pdx-badge>
            <div>
              <strong>\${item.label}</strong>
              <div class="pdx-txt-small pdx-ink-muted">\${item.owner}</div>
            </div>
          </div>
        \`; };
    return html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Rows you render yourself</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      The <code>item</code> slot takes over the row's content. The handle stays the component's, so
      the keyboard path keeps working whatever you put in the row.
    </p>

    <div class="demo-stack narrow">
      <pdx-sortable-list :items=\${ctx.steps} @pdx-reorder=\${safeHandler(ctx.onStepReorder, ctx.el?.tagName?.toLowerCase(), 'pdx-reorder')}>
        \${slotCarrier('item', __pdxSlot_item_0)}
      </pdx-sortable-list>
    </div>
  </section>
\`;
  },
});
"
`;


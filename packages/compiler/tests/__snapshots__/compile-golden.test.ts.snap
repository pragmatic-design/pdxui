exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-chip/demo-comp-chip-removable.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, eachRow, html, safeHandler, signal, when } from '@pdxui/core';
import { useChipConsole } from './state.pdx';

component('pdx-demo-comp-chip-removable', {
  props: {},
  setup(ctx) {
    const __tags = signal(['React', 'Vue', 'Angular', 'Svelte', 'Solid'], { name: 'demo-comp-chip-removable:tags' });
    const __tagRow = signal(null, { name: 'demo-comp-chip-removable:tagRow' });
const chipConsole = useChipConsole();
    
    function addLog(text) { chipConsole.addLog(text); }
    
    // Removable. The chip does not remove itself, and the app owns focus afterwards: without this, a
    // keyboard removal left focus on <body>.
    
    
    
    
    function removeTag(e) {
        const val = e.detail ? e.detail.value : '';
        if (!val) return;
        const at = __tags().indexOf(val);
        __tags.set(prev => prev.filter(t => t !== val));
        addLog('removed: ' + val);
        requestAnimationFrame(() => {
            const row = __tagRow();
            if (!row) return;
            const xs = row.querySelectorAll('.pdx-chip-remove');
            const next = xs[Math.min(at, xs.length - 1)] || row.querySelector('.reset-tags');
            if (next) next.focus();
        });
    }
    
    function resetTags() {
        __tags.set(['React', 'Vue', 'Angular', 'Svelte', 'Solid']);
        addLog('tags reset');
    }
    return { chipConsole, addLog, tags: __tags, tagRow: __tagRow, removeTag, resetTags };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Removable</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>removable</code> adds a close button — the chip's one tab stop, named "Remove React". The remove event carries
      <code>value</code> + <code>label</code>. The chip does not remove itself, and the app owns focus afterwards: here it moves to
      the next chip's ×, else the previous one, else Reset.
    </p>

    <div class="demo-row" :ref=\${ctx.tagRow}>
      \${eachRow(() => ctx.tags(), (tag) => tag, (tag) => html\`
        <pdx-chip removable :value=\${() => tag()} @pdx-remove=\${safeHandler(ctx.removeTag, ctx.el?.tagName?.toLowerCase(), 'pdx-remove')}>\${() => tag()}</pdx-chip>
      \`)}\${when(() => ctx.tags().length === 0, () => html\`
        <span class="pdx-txt-small pdx-ink-muted">All removed!</span>
      \`, null)}<button class="pdx-ghost reset-tags" size="sm" @click=\${safeHandler(ctx.resetTags, ctx.el?.tagName?.toLowerCase(), 'click')}>Reset</button>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-chip removable value="react" @pdx-remove="onRemove"&gt;React&lt;/pdx-chip&gt;
// event.detail = { value: "react", label: "React" }</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-chip/demo-comp-chip-selectable.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, eachRow, html, safeHandler, signal } from '@pdxui/core';
import { useChipConsole } from './state.pdx';

component('pdx-demo-comp-chip-selectable', {
  props: {},
  setup(ctx) {
    const __interests = signal([
    { label: 'Music', selected: true },
    { label: 'Sports', selected: false },
    { label: 'Travel', selected: true },
    { label: 'Food', selected: false },
    { label: 'Tech', selected: true },
    { label: 'Art', selected: false },
], { name: 'demo-comp-chip-selectable:interests' });
const chipConsole = useChipConsole();
    
    function addLog(text) { chipConsole.addLog(text); }
    
    // Selectable
    
    
    function toggleInterest(e) {
        const val = e.detail ? e.detail.value : '';
        if (val) {
            __interests.set(prev => prev.map(i => i.label === val ? { label: i.label, selected: !i.selected } : i));
            addLog('toggle: ' + val + ' → ' + (e.detail.selected ? 'on' : 'off'));
        }
    }
    
    function selectedStr() {
        const sel = __interests().filter(i => i.selected).map(i => i.label);
        return sel.length > 0 ? sel.join(', ') : 'none';
    }
    return { chipConsole, addLog, interests: __interests, toggleInterest, selectedStr };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Selectable (Toggle)</h2>
    <p class="pdx-txt-small pdx-ink-muted"><code>selectable</code> makes the chip a toggle button (<code>role="button"</code> + <code>aria-pressed</code>): click, Enter or Space. Plain chips are not tab stops.</p>

    <div class="demo-row">
      \${eachRow(() => ctx.interests(), 'label', (item) => html\`
        <pdx-chip selectable variant="primary" :selected=\${() => item().selected} :value=\${() => item().label} @pdx-toggle=\${safeHandler(ctx.toggleInterest, ctx.el?.tagName?.toLowerCase(), 'pdx-toggle')}>\${() => item().label}</pdx-chip>
      \`)}</div>
    <p class="pdx-txt-small pdx-ink-muted" style="margin-top:var(--pdx-space-xs)">
      Selected: \${() => ctx.selectedStr()}
    </p>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-chip selectable variant="primary" :selected="sel" @pdx-toggle="onToggle"&gt;
  Music
&lt;/pdx-chip&gt;
// event.detail = { selected: true, value: "Music" }</code></pre>
    </details>
  </section>
\`,
});
"
`;


isibility: hidden;\\n  }\\n  :scope .toc-title {\\n    font-size: var(--pdx-text-xs);\\n    font-weight: var(--pdx-weight-semibold);\\n    color: var(--pdx-color-muted);\\n    text-transform: uppercase;\\n    letter-spacing: 0.05em;\\n    margin-bottom: var(--pdx-space-sm);\\n    padding-left: var(--pdx-space-sm);\\n  }\\n  :scope .toc-nav {\\n    display: flex;\\n    flex-direction: column;\\n  }\\n  :scope .toc-link {\\n    display: block;\\n    padding: 4px var(--pdx-space-sm);\\n    color: var(--pdx-color-muted);\\n    text-decoration: none;\\n    border-left: 2px solid transparent;\\n    line-height: 1.5;\\n    transition: color 0.15s, border-color 0.15s;\\n    white-space: nowrap;\\n    overflow: hidden;\\n    text-overflow: ellipsis;\\n  }\\n  :scope .toc-link:hover {\\n    color: var(--pdx-color-text);\\n  }\\n  :scope .toc-link.active {\\n    color: var(--pdx-color-primary);\\n    border-left-color: var(--pdx-color-primary);\\n    font-weight: var(--pdx-weight-medium);\\n  }\\n\\n  :scope .menu-btn {\\n    display: none;\\n    background: none;\\n    border: none;\\n    font-size: 1.25rem;\\n    cursor: pointer;\\n    padding: 4px 8px;\\n    color: var(--pdx-color-text);\\n  }\\n\\n  \\n  :scope .sidebar::before {\\n    content: '';\\n    display: none;\\n  }\\n\\n  \\n  }@media (max-width: 1200px) {\\n    @scope ([data-pdx-luqdaw]) to ([data-pdx-root] \\u003E *) {:scope .app {\\n      grid-template-columns: 260px 1fr;\\n    }\\n    :scope .page-toc { display: none; }\\n  }}\\n\\n  @media (max-width: 768px) {\\n    @scope ([data-pdx-luqdaw]) to ([data-pdx-root] \\u003E *) {:scope .app {\\n      grid-template-columns: 1fr;\\n      overflow-x: hidden;\\n      max-width: 100vw;\\n    }\\n    :scope .page-toc { display: none; }\\n    :scope .content { min-width: 0; max-width: 100vw; padding: 20px 16px; }\\n    :scope .menu-btn { display: block; }\\n    \\n    :scope .section-label { display: none; }\\n    :scope .section-icon { display: inline; font-size: 1rem;
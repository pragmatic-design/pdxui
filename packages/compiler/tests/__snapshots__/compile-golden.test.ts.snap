exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-data-grid-selection/demo-comp-data-grid-selection-multiple.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createDataSource, html, safeHandler, signal } from '@pdxui/core';
import { data, columns } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-p1a3ib");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-p1a3ib"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-p1a3ib] .event-log { margin-top: var(--pdx-space-sm); padding: var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-sm); color: var(--pdx-color-muted); }\\n";
}

component('pdx-demo-comp-data-grid-selection-multiple', {
  props: {},
  setup(ctx) {
    const __selLog = signal('Select rows to see events...', { name: 'demo-comp-data-grid-selection-multiple:selLog' });
const multiDS = createDataSource({ data: data.slice(), pageSize: 0 });
    
    
    
    function onSelect(evt) {
      const count = evt.detail.count;
      const ids = evt.detail.selected;
      __selLog.set(count + ' row' + (count !== 1 ? 's' : '') + ' selected: IDs [' + ids.join(', ') + ']');
    }
    ctx.el.setAttribute('data-pdx-p1a3ib', '');
    return { multiDS, selLog: __selLog, onSelect };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Multiple Selection</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Checkbox column with select-all header. Hold <kbd>Shift</kbd> for range select.
    </p>
    <div class="demo-container">
      <pdx-data-grid :source=\${() => ctx.multiDS} :columns=\${columns} selection="multiple" hover @pdx-selection-change=\${safeHandler(ctx.onSelect, ctx.el?.tagName?.toLowerCase(), 'pdx-selection-change')}></pdx-data-grid>
    </div>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="sel-log">\${ctx.selLog}</div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-data-grid :source="ds" :columns="columns"
  selection="multiple" hover
  @pdx-selection-change="onSelect"&gt;
&lt;/pdx-data-grid&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


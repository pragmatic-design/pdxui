      <button class="pdx-secondary" @click=\${safeHandler(ctx.popTopDialog, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop Dialog</button>
      <button class="pdx-ghost" @click=\${safeHandler(ctx.popAllTooltips, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop All Tooltips</button>
      <button class="pdx-ghost" @click=\${safeHandler(ctx.popAllDialogs, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop All Dialogs</button>

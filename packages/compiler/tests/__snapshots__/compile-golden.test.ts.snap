{
  let __pdx_style = document.getElementById("pdx-s-8fijtg");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-8fijtg"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-8fijtg] .page { }\\n\\n  \\n  [data-pdx-8fijtg] .btn-row {\\n    display: flex;\\n    gap: var(--pdx-space-sm);\\n    flex-wrap: wrap;\\n    align-items: center;\\n    margin-top: var(--pdx-space-md);\\n  }\\n\\n  \\n  [data-pdx-8fijtg] .event-console {\\n    margin-bottom: var(--pdx-space-xl);\\n    border: 1px solid var(--pdx-color-border);\\n    border-radius: var(--pdx-radius-md);\\n    overflow: hidden;\\n  }\\n  [data-pdx-8fijtg] .console-header {\\n    display: flex;\\n    align-items: center;\\n    justify-content: space-between;\\n    padding: var(--pdx-space-xs) var(--pdx-space-md);\\n    background: var(--pdx-color-inset);\\n    border-bottom: 1px solid var(--pdx-color-border);\\n  }\\n  [data-pdx-8fijtg] .console-body {\\n    padding: var(--pdx-space-sm) var(--pdx-space-md);\\n    max-height: 160px;\\n    overflow-y: auto;\\n    font-size: var(--pdx-text-xs);\\n    background: var(--pdx-color-surface);\\n  }\\n  [data-pdx-8fijtg] .log-entry {\\n    display: flex;\\n    gap: var(--pdx-space-sm);\\n    padding: 2px 0;\\n    line-height: 1.5;\\n  }\\n  [data-pdx-8fijtg] .log-time { color: var(--pdx-color-muted); min-width: 90px; }\\n  [data-pdx-8fijtg] .log-variant { min-width: 80px; font-weight: var(--pdx-weight-medium); }\\n\\n  [data-pdx-8fijtg] .opt-header, [data-pdx-8fijtg] .opt-row { grid-template-columns: 120px 120px 1fr; }\\n";
}

component('pdx-comp-button', {
  props: {},
  setup(ctx) {
registerPragmaticIcons();
    
    
    // Event console: every section writes to it, the page shows it (sections/comp-button/state.pdx.ts).
    const buttonConsole = useButtonConsole();
    const logs = computed(() => buttonConsole.logs(), { name: 'comp-button:logs' });
    
    
    
    function clearLog() {
        buttonConsole.clearLog();
    }
    useHead({ title: "Button Component" });
    ctx.el.setAttribute('data-pdx-8fijtg', '');
    return { buttonConsole, logs, clearLog };
  },
  render: (ctx) => html\`
  <div class="page">
    <h1 class="pdx-txt-title">Button</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-button&gt;</code> — Web Component wrapper over Pragmatic CSS buttons.
      Props: <code>variant</code>, <code>size</code>, <code>loading</code>, <code>disabled</code>, <code>full</code>. Slot for icons + text.
    </p>

    <!-- ═══ Event Console ═══ -->
    <div class="event-console">
      <div class="console-header">
        <span class="pdx-txt-caption pdx-ink-muted">Event Console</span>
        <button class="pdx-ghost" size="sm" @click=\${safeHandler(ctx.clearLog, ctx.el?.tagName?.toLowerCase(), 'click')}>Clear</button>
      </div>
      <div class="console-body pdx-txt-mono">
        \${when(() => ctx.logs().length === 0, () => html\`
          <span class="pdx-ink-muted">Click any button below...</span>
        \`, () => html\`
          \${eachRow(() => ctx.logs(), 'id', (entry) => html\`
            <div class="log-entry">
              <span class="log-time">\${() => entry().time}</span>
              <span class="log-variant" :style=\${() => 'color:' + entry().color}>\${() => entry().variant}</span>
              <span>\${() => entry().text}</span>
            </div>
          \`)}\`)}
      </div>
    </div>

    <!-- ═══ Variants ═══ -->
    <pdx-demo-comp-button-variants class="demo-section"></pdx-demo-comp-button-variants>

    <!-- ═══ With Icons ═══ -->
    <pdx-demo-comp-button-icons class="demo-section"></pdx-demo-comp-button-icons>

    <!-- ═══ Sizes ═══ -->
    <pdx-demo-comp-button-sizes class="demo-section"></pdx-demo-comp-button-sizes>

    <!-- ═══ Toggle Button ═══ -->
    <pdx-demo-comp-button-toggle class="demo-section"></pdx-demo-comp-button-toggle>

    <!-- ═══ Loading ═══ -->
    <pdx-demo-comp-button-loading class="demo-section"></pdx-demo-comp-button-loading>

    <!-- ═══ Disabled ═══ -->
    <pdx-demo-comp-button-disabled class="demo-section"></pdx-demo-comp-button-disabled>

    <!-- ═══ Full Width ═══ -->
    <pdx-demo-comp-button-full-width class="demo-section"></pdx-demo-comp-button-full-width>

    <!-- ═══ Composition ═══ -->
    <pdx-demo-comp-button-composition class="demo-section"></pdx-demo-comp-button-composition>

    <!-- ═══ Reference ═══ -->
    <section>
      <h2 class="pdx-txt-heading section-heading">Reference</h2>
      <div class="options-table">
        <div class="opt-header">
          <span>Prop</span><span>Type</span><span>Description</span>
        </div>
        <div class="opt-row">
          <code>variant</code><span>string</span><span>primary, secondary, outline, ghost, link, danger, success, warning, info</span>
        </div>
        <div class="opt-row">
          <code>size</code><span>string</span><span>sm, (default), lg</span>
        </div>
        <div class="opt-row">
          <code>disabled</code><span>boolean</span><span>Blocks click, 50% opacity</span>
        </div>
        <div class="opt-row">
          <code>loading</code><span>boolean</span><span>Spinner overlay, aria-busy, blocks click</span>
        </div>
        <div class="opt-row">
          <code>type</code><span>string</span><span>button (default), submit, reset</span>
        </div>
        <div class="opt-row">
          <code>full</code><span>boolean</span><span>Full width (100%)</span>
        </div>
        <div class="opt-row">
          <code>aria-label</code><span>string</span><span>Names an icon-only button; forwarded to the inner &lt;button&gt;. A button with no text and no name warns in the console</span>
        </div>
      </div>

      <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">CSS vs WC</h3>
      <p class="pdx-txt-small pdx-ink-muted">
        Use CSS classes (<code>.pdx-primary</code>) on native <code>&lt;button&gt;</code> for maximum control.
        Use <code>&lt;pdx-button&gt;</code> for prop-driven API, automatic loading/disabled management, and consistent icon spacing.
      </p>
    </section>

  </div>
\`,
});

// Auto-route: @page '/components/button'
if(!globalThis.__pdx_routes)globalThis.__pdx_routes=[];
const __pdx_pushRoute=(r)=>{const i=globalThis.__pdx_routes.findIndex(x=>x.path===r.path);if(i>=0)globalThis.__pdx_routes[i]=r;else globalThis.__pdx_routes.push(r);globalThis.__pdx_routeRegistered&&globalThis.__pdx_routeRegistered(r.path);};
__pdx_pushRoute({path:"/components/button",tag:"pdx-comp-button",lazy:true,file:'./comp-button.pdx'});
"
`;


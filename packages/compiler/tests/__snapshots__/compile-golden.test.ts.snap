"// 0 warning(s)

============================================================
import { component, createForm, email, html, required, safeHandler } from '@pdxui/core';

component('pdx-demo-comp-form-basic', {
  props: {},
  setup(ctx) {
    const basicForm = createForm({ initialValues: { name: '', email: '', bio: '', notifications: false }, validators: { name: [required()], email: [required(), email()] } });
// Helper functions for template — :textContent="\${fn}" binds reactively via the template engine.
    // Each helper includes the label text so the binding is a simple function reference (no arrow wrapper).
    function basicDirtyText() { return 'Dirty: ' + (basicForm.dirty() ? 'Yes' : 'No'); }
    
    function basicValidText() { return 'Valid: ' + (basicForm.valid() ? 'Yes' : 'No'); }
    function basicStateText() { return 'State: ' + basicForm.state(); }
    function basicDirtyClass() { return 'form-status-badge' + (basicForm.dirty() ? ' active' : ''); }
    function basicValidClass() { return 'form-status-badge' + (basicForm.valid() ? ' success' : ' error'); }
    
    // ─── 1. Basic Form (via @form rune) ───
    
    // Submit through the form: validates, and the State badge above shows submitting → success.
    // The save is simulated — a real app awaits its API here.
    const saveBasic = basicForm.handleSubmit(async () => {
      await new Promise((resolve) => setTimeout(resolve, 400));
    });
    return { basicDirtyText, basicValidText, basicStateText, basicDirtyClass, basicValidClass, basicForm, saveBasic };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">1. Basic Form (Compiler Auto-Binding)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Just add <code>name="field"</code> to controls inside <code>&lt;pdx-form&gt;</code>.
      The compiler generates value binding, onChange, and onBlur automatically.
    </p>

    <div class="demo-block">
      <pdx-form :form=\${() => ctx.basicForm} @pdx-submit=\${safeHandler(ctx.saveBasic, ctx.el?.tagName?.toLowerCase(), 'pdx-submit')}>
        <pdx-form-field name="name" label="Full Name" required :error=\${() => ctx.basicForm.fields.name?.error()} :touched=\${() => ctx.basicForm.fields.name?.touched()} :warning=\${() => ctx.basicForm.fields.name?.warning()}>
          <pdx-input name="name" placeholder="John Doe" @pdx-input=\${(e) => ctx.basicForm.fields.name?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.basicForm.fields.name?.onBlur()}></pdx-input>
        </pdx-form-field>

        <pdx-form-field name="email" label="Email" required :error=\${() => ctx.basicForm.fields.email?.error()} :touched=\${() => ctx.basicForm.fields.email?.touched()} :warning=\${() => ctx.basicForm.fields.email?.warning()}>
          <pdx-input name="email" type="email" placeholder="john@example.com" @pdx-input=\${(e) => ctx.basicForm.fields.email?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.basicForm.fields.email?.onBlur()}></pdx-input>
        </pdx-form-field>

        <pdx-form-field name="bio" label="Bio" :error=\${() => ctx.basicForm.fields.bio?.error()} :touched=\${() => ctx.basicForm.fields.bio?.touched()} :warning=\${() => ctx.basicForm.fields.bio?.warning()}>
          <pdx-textarea name="bio" placeholder="Tell us about yourself..." rows="3" @pdx-input=\${(e) => ctx.basicForm.fields.bio?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.basicForm.fields.bio?.onBlur()}></pdx-textarea>
        </pdx-form-field>

        <pdx-form-field name="notifications" label="" :error=\${() => ctx.basicForm.fields.notifications?.error()} :touched=\${() => ctx.basicForm.fields.notifications?.touched()} :warning=\${() => ctx.basicForm.fields.notifications?.warning()}>
          <pdx-switch name="notifications" label="Email notifications" :checked=\${() => ctx.basicForm.fields.notifications?.value()} @pdx-change=\${(e) => ctx.basicForm.fields.notifications?.onChange(e.detail?.checked)} @pdx-blur=\${() => ctx.basicForm.fields.notifications?.onBlur()}></pdx-switch>
        </pdx-form-field>

        <pdx-form-actions submitLabel="Save Profile" resetLabel="Reset"></pdx-form-actions>
      </pdx-form>

      <div class="form-status">
        <span :class=\${() => ctx.basicDirtyClass()} :text-content=\${() => ctx.basicDirtyText()}></span>
        <span :class=\${() => ctx.basicValidClass()} :text-content=\${() => ctx.basicValidText()}></span>
        <span class="form-status-badge" :text-content=\${() => ctx.basicStateText()}></span>
      </div>
    </div>

    <details class="source-block"><summary>Source</summary><pre class="pdx-txt-mono"><code>@form basicForm: {
  name: string { required },
  email: string { required, email },
  bio?: string,
  notifications: boolean
}

// Validates, moves \\\`state\\\` through submitting → success, and rebases the form.
const saveBasic = basicForm.handleSubmit(async (values) =&gt; { await api.saveProfile(values); });

&lt;pdx-form :form="basicForm" @pdx-submit="saveBasic"&gt;
  &lt;pdx-form-field name="name" label="Full Name" required&gt;

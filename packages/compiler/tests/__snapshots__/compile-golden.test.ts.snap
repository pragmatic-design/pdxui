component('pdx-user-detail', {
  props: {},
  setup(ctx) {
    const userId = computed(() => currentParams().id, { name: 'user-detail:userId' });
    const fromList = computed(() => currentState()?.fromList === true, { name: 'user-detail:fromList' });
function goBack() { navigate('/dashboard'); }
    function goNext() {
      const next = Number(currentParams().id) + 1;
      navigate('/users/:id(number)', { id: String(next) }, { fromList: false });
    }
    const routeMeta = computed(() => currentMeta(), { name: 'user-detail:routeMeta' });
    useHead({ title: "User Detail — TaskMgr" });
    ctx.el.setAttribute('data-pdx-uxun21', '');
    return { userId, fromList, routeMeta, goBack, goNext };
  },
  render: (ctx) => html\`
  <div class="user-detail">
    <h2>User #\${ctx.userId}</h2>
    <div class="detail-card">
      <div class="field"><label>ID</label><span class="val">\${ctx.userId}</span></div>
      <div class="field"><label>Type</label><span class="val">Constrained to number</span></div>
      \${when(() => ctx.fromList(), () => html\`
        <div class="badge">Navigated from list (virtual state)</div>
      \`, null)}</div>
    <div class="nav-links">
      <button @click=\${safeHandler(ctx.goBack, ctx.el?.tagName?.toLowerCase(), 'click')} class="btn-back">← Back</button>
      <button @click=\${safeHandler(ctx.goNext, ctx.el?.tagName?.toLowerCase(), 'click')} class="btn-next">Next user →</button>
    </div>
    <div class="meta-info">
      Route meta: \${() => JSON.stringify(ctx.routeMeta())}
    </div>
  </div>
\`,
});

// Auto-route: @page '/users/:id(number)'
if(!globalThis.__pdx_routes)globalThis.__pdx_routes=[];
const __pdx_pushRoute=(r)=>{const i=globalThis.__pdx_routes.findIndex(x=>x.path===r.path);if(i>=0)globalThis.__pdx_routes[i]=r;else globalThis.__pdx_routes.push(r);globalThis.__pdx_routeRegistered&&globalThis.__pdx_routeRegistered(r.path);};
__pdx_pushRoute({path:"/users/:id(number)",tag:"pdx-user-detail",transition:"slide-right",meta:{"section":"users","permissions":["users.view"]},paramConstraints:{id:"number"},lazy:true,file:'./user-detail.pdx'});
"
`;


import { component, html, safeHandler, signal, when } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-atahge");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-atahge"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "/* The error card the render-error, healthy, network-fetch and async-action sections draw. Global,\\n   in one place, and in this order — .pdx-error-warning overrides\\n   .pdx-error-fallback by coming after it. */\\n.pdx-error-fallback {\\n  padding: var(--pdx-space-md);\\n  background: var(--pdx-color-danger-soft);\\n  border: 1px solid var(--pdx-color-danger);\\n  border-radius: var(--pdx-radius-md);\\n  text-align: center;\\n}\\n.pdx-error-warning {\\n  background: color-mix(in oklch, var(--pdx-color-warning) 10%, transparent);\\n  border-color: var(--pdx-color-warning);\\n}\\n.pdx-error-icon { font-size: 2rem; margin-bottom: var(--pdx-space-xs); }\\n.pdx-error-msg { font-weight: 600; margin-bottom: var(--pdx-space-2xs); }\\n.pdx-error-detail {\\n  font-size: var(--pdx-text-sm);\\n  color: var(--pdx-color-muted);\\n  margin-bottom: var(--pdx-space-xs);\\n  font-family: monospace;\\n  word-break: break-word;\\n}";
}

component('pdx-demo-comp-error-boundary-async-action', {
  props: {},
  setup(ctx) {
    const __formState = signal('idle', { name: 'demo-comp-error-boundary-async-action:formState' });
    const __formError = signal('', { name: 'demo-comp-error-boundary-async-action:formError' });
    const __formAttempts = signal(0, { name: 'demo-comp-error-boundary-async-action:formAttempts' });
// ─── Form Submit Simulation ─────────────────────────────
    
    
    
    
    
    function submitForm() {
      __formState.set('submitting');
      __formAttempts.set(prev => prev + 1);
      setTimeout(() => {
        if (__formAttempts() < 2) {
          __formError.set('ValidationError: "not-an-email" is not a valid email address');
          __formState.set('error');
        } else {
          __formState.set('success');
        }
      }, 800);
    }
    
    function resetForm() {
      __formState.set('idle');
      __formError.set('');
    }
    return { formState: __formState, formError: __formError, formAttempts: __formAttempts, submitForm, resetForm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Async Action — Form Submit Error</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Simulates a form submission that fails server-side validation.
      The global error interceptor (<code>onGlobalError</code>) catches event handler errors.
    </p>
    <div class="demo-box">
      \${when(() => ctx.formState() === 'idle', () => html\`
        <div class="demo-widget">
          <div class="pdx-txt-small"><strong>Email:</strong> not-an-email</div>
          <button class="pdx-btn pdx-btn-sm pdx-btn-outline" @click=\${safeHandler(ctx.submitForm, ctx.el?.tagName?.toLowerCase(), 'click')}>Submit Form</button>
        </div>
      \`, null)}\${when(() => ctx.formState() === 'submitting', () => html\`
        <div class="demo-widget state-loading">
          <div class="pdx-spinner-inline"></div>
          <span class="pdx-txt-small pdx-ink-muted">Submitting...</span>
        </div>
      \`, null)}\${when(() => ctx.formState() === 'error', () => html\`
        <div class="pdx-error-fallback pdx-error-warning" role="alert">
          <div class="pdx-error-icon">&#9888;</div>
          <div class="pdx-error-msg">Form submission failed</div>
          <div class="pdx-error-detail">\${ctx.formError}</div>
          <button class="pdx-btn pdx-btn-sm pdx-btn-outline retry-btn" @click=\${safeHandler(ctx.resetForm, ctx.el?.tagName?.toLowerCase(), 'click')}>Fix and Retry</button>
        </div>
      \`, null)}\${when(() => ctx.formState() === 'success', () => html\`
        <div class="demo-widget success-widget">
          <div class="pdx-txt-small" style="color: var(--pdx-color-success); font-weight: 600">&#10003; Form submitted</div>
          <button class="pdx-btn pdx-btn-sm pdx-btn-outline" style="margin-top: var(--pdx-space-xs)" @click=\${safeHandler(ctx.resetForm, ctx.el?.tagName?.toLowerCase(), 'click')}>Reset</button>
        </div>
      \`, null)}</div>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-error-boundary/demo-comp-error-boundary-global-error.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, eachRow, html, onGlobalError, safeHandler, signal, when } from '@pdxui/core';

component('pdx-demo-comp-error-boundary-global-error', {
  props: {},
  setup(ctx) {
    const __globalErrors = signal([], { name: 'demo-comp-error-boundary-global-error:globalErrors' });
    const __errorId = signal(0, { name: 'demo-comp-error-boundary-global-error:errorId' });
// ─── Global Error Interceptor Demo ──────────────────────
    
    
    
    
    
    
    onGlobalError(function handleGlobalError(error, context) {
      __errorId.set(prev => prev + 1);
      __globalErrors.set(prev => prev.slice().concat([{
        id: __errorId(),
        source: context.source,
        message: error.message,
        time: new Date().toLocaleTimeString(),
      }]));
      return true;
    });
    
    
    function triggerGlobalError() {
      throw new Error('Unhandled click: fetchUserProfile() returned 403 Forbidden');
    }
    return { globalErrors: __globalErrors, errorId: __errorId, triggerGlobalError };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">onGlobalError — App-wide Interceptor</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Catches all errors not handled by local boundaries. The log below shows errors intercepted globally.
    </p>
    <div class="demo-box">
      <div class="demo-widget">
        <button class="pdx-btn pdx-btn-sm pdx-btn-outline" @click=\${safeHandler(ctx.triggerGlobalError, ctx.el?.tagName?.toLowerCase(), 'click')}>Trigger Unhandled Error</button>
      </div>
      \${when(() => ctx.globalErrors().length > 0, () => html\`
        <div class="error-log">
          <div class="pdx-txt-small" style="font-weight: 600; margin-bottom: var(--pdx-space-xs)">Global Error Log (\${() => ctx.globalErrors().length})</div>
          \${eachRow(() => ctx.globalErrors(), 'id', (entry) => html\`
            <div class="log-entry">
              <span class="log-source">\${() => entry().source}</span>
              <span class="log-msg">\${() => entry().message}</span>
              <span class="log-time">\${() => entry().time}</span>
            </div>
          \`)}</div>
      \`, null)}</div>
    <details class="source"><summary>Source</summary><pre><code>import { onGlobalError } from '@pdxui/core';

onGlobalError((error, context) =&gt; {
  telemetry.log({
    source: context.source,
    component: context.component,
    message: error.message,
  });
  // return true to suppress console.error
  return true;
});</code></pre></details>
  </section>
\`,
});
"
`;


component('pdx-demo-comp-sidebar-interactive', {
  props: {},
  setup(ctx) {
    const __sidebarEl = signal(null, { name: 'demo-comp-sidebar-interactive:sidebarEl' });
    const __sidebarHeader = signal(null, { name: 'demo-comp-sidebar-interactive:sidebarHeader' });
const sidebarItems = [
      { key: 'dashboard', label: 'Dashboard', icon: 'home' },
      { key: 'analytics', label: 'Analytics', icon: 'trending-up' },
      { key: 'projects', label: 'Projects', icon: 'folder' },
      { key: 'team', label: 'Team', icon: 'users' },
      { key: 'sep1', label: '', type: 'separator' },
      { key: 'settings', label: 'Settings', icon: 'settings' },
    ];
    
    
    const _state = { open: true };
    
    
    
    
    function toggleSidebar() {
      _state.open = !_state.open;
      if (__sidebarEl()) __sidebarEl().open = _state.open;
      // Update header layout for collapsed state
      if (__sidebarHeader()) __sidebarHeader().classList.toggle('collapsed', !_state.open);
    }
    ctx.el.setAttribute('data-pdx-q83jjd', '');

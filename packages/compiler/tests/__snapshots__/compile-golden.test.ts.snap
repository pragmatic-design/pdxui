exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-wizard/demo-comp-wizard-events.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-kji6b4");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-kji6b4"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-kji6b4] .event-log {\\n  margin-top: var(--pdx-space-md);\\n  padding: var(--pdx-space-sm);\\n  background: var(--pdx-color-inset);\\n  border-radius: var(--pdx-radius-sm);\\n}\\n";
}

component('pdx-demo-comp-wizard-events', {
  props: {},
  setup(ctx) {
    const __wizardLog = signal('No events yet', { name: 'demo-comp-wizard-events:wizardLog' });
function onStepChange(e) {
      __wizardLog.set('pdx-change: step ' + e.detail.value + ' (from ' + e.detail.previous + ')');
    }
    
    function onComplete(e) {
      __wizardLog.set('pdx-complete: step ' + e.detail.value + ' — Done!');
    }
    ctx.el.setAttribute('data-pdx-kji6b4', '');
    return { wizardLog: __wizardLog, onStepChange, onComplete };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Events</h2>
    <p class="pdx-txt-small pdx-ink-muted">Listen to <code>pdx-change</code> and <code>pdx-complete</code>.</p>

    <div class="demo-box">
      <pdx-wizard @pdx-change=\${safeHandler(ctx.onStepChange, ctx.el?.tagName?.toLowerCase(), 'pdx-change')} @pdx-complete=\${safeHandler(ctx.onComplete, ctx.el?.tagName?.toLowerCase(), 'pdx-complete')}>
        <div data-wizard-step data-label="First">
          <p class="pdx-txt-body">Navigate and watch the event log below.</p>
        </div>
        <div data-wizard-step data-label="Second">
          <p class="pdx-txt-body">Almost there...</p>
        </div>
        <div data-wizard-step data-label="Done">
          <p class="pdx-txt-body">Click Complete to fire the complete event.</p>
        </div>
      </pdx-wizard>
      <div class="event-log pdx-txt-mono pdx-txt-small" id="wizard-event-log">\${ctx.wizardLog}</div>
    </div>
  </section>
\`,
});
"
`;


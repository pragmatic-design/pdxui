exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-toast/demo-comp-toast-promise.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler } from '@pdxui/core';
import { toast } from '@pdxui/ui/toast';

component('pdx-demo-comp-toast-promise', {
  props: {},
  setup(ctx) {
function showPromiseSuccess() {
      const p = new Promise(r => setTimeout(r, 2000));
      toast.promise(p, { loading: 'Saving...', success: 'Saved!', error: 'Failed!' });
    }
    
    function showPromiseFail() {
      const p = new Promise((_, r) => setTimeout(() => r('err'), 2000));
      toast.promise(p, { loading: 'Saving...', success: 'Saved!', error: 'Connection failed.' });
    }
    return { showPromiseSuccess, showPromiseFail };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Promise API</h2>
    <p class="pdx-txt-small pdx-ink-muted"><code>toast.promise()</code> — loading → success/error automatically.</p>
    <div class="btn-row">
      <pdx-button variant="primary" size="sm" @click=\${safeHandler(ctx.showPromiseSuccess, ctx.el?.tagName?.toLowerCase(), 'click')}>Save (succeeds in 2s)</pdx-button>
      <pdx-button variant="danger" size="sm" @click=\${safeHandler(ctx.showPromiseFail, ctx.el?.tagName?.toLowerCase(), 'click')}>Save (fails in 2s)</pdx-button>
    </div>
  </section>
\`,
});
"
`;


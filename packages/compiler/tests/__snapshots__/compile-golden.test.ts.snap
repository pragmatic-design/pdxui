exports[`compile golden — demo corpus > showcase-new/pages/sections/design-themes/demo-design-themes-contrast.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, eachRow, html } from '@pdxui/core';
import { useThemeMeasure } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-vvx5mv");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-vvx5mv"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-vvx5mv] .contrast-table {\\n    margin-top: var(--pdx-space-lg);\\n    border: 1px solid var(--pdx-color-border);\\n    border-radius: var(--pdx-radius-md);\\n    overflow: hidden;\\n}\\n[data-pdx-vvx5mv] .ct-head, [data-pdx-vvx5mv] .ct-row {\\n    display: grid;\\n    grid-template-columns: 90px 1fr 1fr 90px 60px;\\n    align-items: center;\\n    gap: var(--pdx-space-sm);\\n    padding: var(--pdx-space-xs) var(--pdx-space-sm);\\n}\\n[data-pdx-vvx5mv] .ct-head {\\n    grid-template-columns: 90px 1fr 1fr 90px 60px;\\n    background: var(--pdx-color-surface);\\n    border-bottom: 1px solid var(--pdx-color-border);\\n    font-size: 0.78rem;\\n    color: var(--pdx-color-muted);\\n}\\n[data-pdx-vvx5mv] .ct-head span:first-child { visibility: hidden; }\\n[data-pdx-vvx5mv] .ct-row + .ct-row { border-top: 1px solid var(--pdx-color-border); }\\n[data-pdx-vvx5mv] .ct-chip {\\n    display: inline-flex; align-items: center; justify-content: center;\\n    padding: 4px 8px; border-radius: var(--pdx-radius-sm); font-size: 0.75rem;\\n}\\n[data-pdx-vvx5mv] .ct-code { font-size: 0.75rem; overflow-wrap: anywhere; }\\n[data-pdx-vvx5mv] .ct-ratio { font-family: var(--pdx-font-mono); font-size: 0.82rem; }\\n";
}

component('pdx-demo-design-themes-contrast', {
  props: {},
  setup(ctx) {
// Measured by the page on mount and on every theme change (state.pdx.ts).
    const themeMeasure = useThemeMeasure();
    const contrast = computed(() => themeMeasure.contrast(), { name: 'demo-design-themes-contrast:contrast' });
    ctx.el.setAttribute('data-pdx-vvx5mv', '');
    return { themeMeasure, contrast };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Contrast is built in, not checked afterwards</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Every figure below is computed <strong>in this page, right now</strong>, by the same
      <code>wcagContrast</code> the theme gate runs — reading the tokens of the theme you are
      currently viewing. Change the theme in the header and the numbers change with it.
    </p>
    <p class="pdx-txt-small pdx-ink-muted">
      The rule: a coloured fill carries a <strong>white</strong> label, and when white cannot reach
      WCAG AA (4.5:1) the <em>fill</em> is darkened until it can — the label is not swapped for a dark
      one. <code>warning</code> is the single exception: a pale yellow no white will ever survive, so
      it carries a dark label by design.
    </p>

    <div class="contrast-table">
      <div class="ct-head">
        <span>Fill token</span><span>Label token</span><span>Ratio</span><span>AA</span>
      </div>
      \${eachRow(() => ctx.contrast(), 'token', (row) => html\`
        <div class="ct-row" data-contrast-row :data-token=\${() => row().token} :data-text-token=\${() => row().textToken} :data-ratio=\${() => row().ratio}>
          <span class="ct-chip" :style=\${() => 'background: var(' + row().token + '); color: var(' + row().textToken + ')'}>Label</span>
          <code class="pdx-txt-mono ct-code">\${() => row().token}</code>
          <code class="pdx-txt-mono ct-code">\${() => row().textToken}</code>
          <span class="ct-ratio">\${() => row().ratio}:1</span>
          <span :class=\${() => row().pass ? 'ct-verdict ok' : 'ct-verdict bad'}>\${() => row().pass ? 'AA' : 'fail'}</span>
        </div>
      \`)}</div>
    <p class="pdx-txt-caption pdx-ink-muted">
      Computed with <code>wcagContrast(parseColorToken(fill), parseColorToken(label))</code> from
      <code>@pdxui/design/engine</code> — the function <code>createTheme().validate()</code> and
      <code>pdx theme --strict</code> use to fail a build.
    </p>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/design-themes/demo-design-themes-dtcg.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, computed, html } from '@pdxui/core';
import { THEME_CONTRACT } from '@pdxui/design/engine';
import { useThemeMeasure } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-p4r9");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-p4r9"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-p4r9] .dtcg-block { max-height: 340px; overflow: auto; }\\n";
}

component('pdx-demo-design-themes-dtcg', {
  props: {},
  setup(ctx) {
// Measured by the page on mount and on every theme change (state.pdx.ts).
    const themeMeasure = useThemeMeasure();
    const dtcg = computed(() => themeMeasure.dtcg(), { name: 'demo-design-themes-dtcg:dtcg' });
    
    
    
    const contractSize = THEME_CONTRACT.length;
    ctx.el.setAttribute('data-pdx-p4r9', '');
    return { themeMeasure, dtcg, contractSize };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Take the tokens with you — DTCG</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      The tokens of the theme you are viewing, in the
      <a class="pdx-link" href="https://tr.designtokens.org/format/" target="_blank" rel="noreferrer">Design Tokens Community Group</a>
      format that Figma Variables and Tokens Studio import. Generated here by
      <code>toDTCGJson()</code>, over the \${ctx.contractSize} tokens a theme is expected to have an
      opinion about.
    </p>
    <details class="source-block" open>
      <summary>tokens.json</summary>

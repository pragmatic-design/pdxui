  __pdx_style.textContent = "\\n  [data-pdx-yrkjpn] .icon-grid {\\n    display: grid;\\n    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));\\n    gap: var(--pdx-space-xs);\\n    margin-top: var(--pdx-space-md);\\n  }\\n  [data-pdx-yrkjpn] .icon-cell {\\n    display: flex;\\n    flex-direction: column;\\n    align-items: center;\\n    gap: var(--pdx-space-2xs);\\n    padding: var(--pdx-space-sm) var(--pdx-space-2xs);\\n    border-radius: var(--pdx-radius-md);\\n    transition: background var(--pdx-transition);\\n  }\\n  [data-pdx-yrkjpn] .icon-cell:hover { background: var(--pdx-color-inset); }\\n";
}

component('pdx-demo-comp-icon-built-in', {
  props: {},
  setup(ctx) {
    const __iconNames = signal(getPragmaticIconNames(), { name: 'demo-comp-icon-built-in:iconNames' });

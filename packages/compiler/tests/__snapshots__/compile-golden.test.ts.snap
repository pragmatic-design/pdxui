          <button type="button" class="shell-nav-item" :aria-current=\${() => ctx.page() === 'Users' ? 'page' : null} @click=\${safeHandler(() => ctx.page.set('Users'), ctx.el?.tagName?.toLowerCase(), 'click')}><pdx-icon name="users" size="14"></pdx-icon> Users</button>
          <button type="button" class="shell-nav-item" :aria-current=\${() => ctx.page() === 'Settings' ? 'page' : null} @click=\${safeHandler(() => ctx.page.set('Settings'), ctx.el?.tagName?.toLowerCase(), 'click')}><pdx-icon name="settings" size="14"></pdx-icon> Settings</button>
        </div>
        <div class="shell-main">

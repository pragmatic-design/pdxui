    <pdx-drawer :open=\${ctx.drawerOpen} :position=\${ctx.drawerPos} label="Demo drawer" @pdx-close=\${safeHandler(ctx.closeDrawer, ctx.el?.tagName?.toLowerCase(), 'pdx-close')}>

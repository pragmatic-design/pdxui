        <pdx-menu :open=\${() => ctx.shown() === 'size'} :items=\${() => ctx.sizeItems} @pdx-close=\${safeHandler(ctx.hide, ctx.el?.tagName?.toLowerCase(), 'pdx-close')}></pdx-menu>
      </div>
    </div>

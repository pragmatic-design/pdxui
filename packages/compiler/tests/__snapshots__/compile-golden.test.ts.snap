exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-tag-input/demo-comp-tag-input-no-duplicates.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';
import { useTagInputLog } from './state.pdx';

component('pdx-demo-comp-tag-input-no-duplicates', {
  props: {},
  setup(ctx) {
    const __dupeTags = signal(['hello', 'world'], { name: 'demo-comp-tag-input-no-duplicates:dupeTags' });
    const __dupeMessage = signal('Try adding "hello" again — it will be rejected.', { name: 'demo-comp-tag-input-no-duplicates:dupeMessage' });
// The page's event console (state.pdx.ts).
    const tagInputLog = useTagInputLog();
    
    function addLog(text) { tagInputLog.addLog(text); }
    
    // No Duplicates
    
    
    
    
    function onDupeChange(e) {
        const tags = e.detail ? e.detail.tags : [];
        __dupeTags.set(tags);
        if (tags.length <= 2) {
            __dupeMessage.set('Duplicates rejected. Current: [' + tags.join(', ') + ']');
        } else {
            __dupeMessage.set('Tags: [' + tags.join(', ') + ']');
        }
        addLog('dupe-test change: [' + tags.join(', ') + ']');
    }
    return { tagInputLog, addLog, dupeTags: __dupeTags, dupeMessage: __dupeMessage, onDupeChange };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">No Duplicates (Default)</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      By default, duplicate tags are rejected. Try adding the same tag twice.
      Set <code>allow-duplicates</code> to override this behavior.
    </p>

    <div class="demo-stack">
      <pdx-tag-input :value=\${ctx.dupeTags} placeholder="Try adding 'hello' twice..." @pdx-change=\${safeHandler(ctx.onDupeChange, ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-tag-input>
    </div>
    <p class="pdx-txt-small pdx-ink-muted" style="margin-top:var(--pdx-space-sm)">
      \${ctx.dupeMessage}
    </p>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;!-- Duplicates rejected (default) --&gt;
&lt;pdx-tag-input placeholder="Try adding duplicates..." /&gt;

&lt;!-- Duplicates allowed --&gt;
&lt;pdx-tag-input allow-duplicates placeholder="Duplicates OK" /&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


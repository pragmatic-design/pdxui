      <pdx-form-field label="Price range">
        <pdx-slider value="20,80" range showLabel></pdx-slider>
      </pdx-form-field>

      <pdx-form-field label="With minimum gap (10)">
        <pdx-slider value="30,70" range minGap="10" marks="0,25,50,75,100" showLabel></pdx-slider>
      </pdx-form-field>
    </div>

    <h3 class="pdx-txt-subheading" style="margin-top:var(--pdx-space-lg)">Sizes & Colors</h3>
    <div class="demo-stack">
      <pdx-form-field label="Small">
        <pdx-slider value="30" size="sm"></pdx-slider>
      </pdx-form-field>
      <pdx-form-field label="Large">
        <pdx-slider value="70" size="lg"></pdx-slider>
      </pdx-form-field>
      <pdx-form-field label="Success color">
        <pdx-slider value="80" color="success"></pdx-slider>
      </pdx-form-field>
      <pdx-form-field label="Warning color">
        <pdx-slider value="40" color="warning"></pdx-slider>
      </pdx-form-field>

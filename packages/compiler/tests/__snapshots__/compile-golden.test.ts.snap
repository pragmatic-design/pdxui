  __pdx_style.textContent = "\\n  [data-pdx-v0kfbv] .shortcut-list { margin-top: var(--pdx-space-md); display: flex; flex-direction: column; gap: var(--pdx-space-xs); font-size: var(--pdx-text-sm); }\\n  [data-pdx-v0kfbv] .shortcut-list kbd { font-family: var(--pdx-font-mono); font-size: var(--pdx-text-xs); padding: 2px 6px; background: var(--pdx-color-inset); border: 1px solid var(--pdx-color-border); border-radius: var(--pdx-radius-sm); }\\n";

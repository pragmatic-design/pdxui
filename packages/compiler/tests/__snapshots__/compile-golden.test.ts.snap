import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-banner-auto-dismiss', {
  props: {},
  setup(ctx) {
    const __autoBanner = signal(null, { name: 'demo-comp-banner-auto-dismiss:autoBanner' });
function showAgain() { __autoBanner()?.show(); }
    return { autoBanner: __autoBanner, showAgain };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Auto-dismiss</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      This banner disappears 5 seconds after it is shown. <code>show()</code> brings it back and
      starts the 5 seconds over.
    </p>
    <div class="demo-stack">
      <pdx-banner variant="success" autoDismiss="5000" closable data-test="auto-dismiss" :ref=\${ctx.autoBanner}>Auto-dismiss in 5 seconds...</pdx-banner>
      <div>
        <button type="button" class="pdx-outline" @click=\${safeHandler(ctx.showAgain, ctx.el?.tagName?.toLowerCase(), 'click')}>Show again</button>

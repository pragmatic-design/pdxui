ateTextNode("const countries = [{ value: 'it', label: 'Italy', isLeaf: false }, …];\\nfunction loadRegions(node) {\\n  return fetch('/api/regions?country=' + node.value).then(r =\\u003E r.json());   // [{ value, label, isLeaf: true }]\\n}\\n\\n\\u003Cpdx-cascader :options=\\"countries\\" :load-children=\\"loadRegions\\"\\u003E\\u003C/pdx-cascader\\u003E"));__el7.appendChild(__d.createTextNode(" "));__el0.appendChild(__d.createTextNode(" "));__frag.appendChild(__d.createTextNode(" "));});

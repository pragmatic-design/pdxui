  __pdx_style.textContent = "\\n  [data-pdx-uq2l1n] .page { padding: 20px; }\\n";
}

component('pdx-head-test', {
  props: {},
  setup(ctx) {
    const __title = signal('Products', { name: 'head-test:title' });
    const description = computed(() => 'Showing all products', { name: 'head-test:description' });
    useHead({ title: "Products — TaskMgr" });
    useHead({ meta: [{ name: "description", content: "Browse all available products" }, { property: "og:title", content: "Products" }] });

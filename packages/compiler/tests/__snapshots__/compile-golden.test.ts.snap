  __pdx_style.textContent = "\\n  [data-pdx-9864yt] .todo { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }\\n  [data-pdx-9864yt] .input-row { display: flex; gap: 0.5rem; margin: 0.75rem 0; }\\n  [data-pdx-9864yt] .input-row input { flex: 1; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; }\\n  [data-pdx-9864yt] .input-row button { padding: 0.5rem 1rem; background: #4361ee; color: white; border: none; border-radius: 4px; cursor: pointer; }\\n  [data-pdx-9864yt] .todo-item { display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0; border-bottom: 1px solid #eee; }\\n  [data-pdx-9864yt] .remove { background: none; border: none; color: #e63946; cursor: pointer; font-size: 1.2rem; }\\n  [data-pdx-9864yt] .remaining { font-size: 0.85rem; color: #666; }\\n  [data-pdx-9864yt] .empty { color: #888; font-style: italic; margin-top: 0.5rem; }\\n";
}

component('pdx-todo-list', {
  props: {
    title: { type: String, default: 'Todo List' }
  },
  setup(ctx) {
    const __items = signal([
    { id: 1, text: 'Learn @pdxui/core' },
    { id: 2, text: 'Build .pdx components' },
    { id: 3, text: 'Ship it!' },
  ], { name: 'todo-list:items' });
    const __newItem = signal('', { name: 'todo-list:newItem' });
let nextId = 4;
    
    
    
    
      function addItem() {
        if (!__newItem().trim()) return;
        __items.set(prev => [...prev, { id: nextId++, text: __newItem() }]);
        __newItem.set('');
      }
    
      function remove(id) {
        __items.set(prev => prev.filter(i => i.id !== id));
      }
    const remaining = computed(() => __items().length, { name: 'todo-list:remaining' });
    ctx.el.setAttribute('data-pdx-9864yt', '');
    return { items: __items, newItem: __newItem, nextId, remaining, addItem, remove };
  },
  render: (ctx) => html\`
  <div class="todo">
    <h3>\${ctx.title}</h3>
    <div class="input-row">
      <input type="text" ::value=\${ctx.newItem} placeholder="Add item..." @keydown.enter=\${safeHandler(ctx.addItem, ctx.el?.tagName?.toLowerCase(), 'keydown')}>
      <button @click=\${safeHandler(ctx.addItem, ctx.el?.tagName?.toLowerCase(), 'click')}>Add</button>
    </div>
    <span class="remaining">\${ctx.remaining} remaining</span>
    \${eachRow(() => ctx.items(), 'id', (item) => html\`
      <div class="todo-item">
        <span>\${() => item().text}</span>

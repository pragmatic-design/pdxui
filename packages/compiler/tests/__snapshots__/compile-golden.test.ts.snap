      <pdx-form-field label="Basic (0-100, step 1)">
        <pdx-slider value="42"></pdx-slider>
      </pdx-form-field>

      <pdx-form-field label="With step=10 and marks" hint="Marks at every step">
        <pdx-slider value="50" step="10" marks="step" showLabel></pdx-slider>
      </pdx-form-field>


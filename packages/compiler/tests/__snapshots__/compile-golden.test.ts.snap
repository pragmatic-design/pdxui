        <pdx-menu :open=\${() => ctx.shown() === 'format'} :items=\${() => ctx.formatItems} @pdx-close=\${safeHandler(ctx.hide, ctx.el?.tagName?.toLowerCase(), 'pdx-close')}></pdx-menu>

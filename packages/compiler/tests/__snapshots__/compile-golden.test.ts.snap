component('pdx-demo-datasource', {
  props: {},
  setup(ctx) {
    const __rows = signal([], { name: 'demo-datasource:rows' });
    const __currentPage = signal(1, { name: 'demo-datasource:currentPage' });
    const __totalPages = signal(1, { name: 'demo-datasource:totalPages' });
    const __totalItems = signal(0, { name: 'demo-datasource:totalItems' });
    const __loading = signal(false, { name: 'demo-datasource:loading' });
    const __sortDesc = signal('none', { name: 'demo-datasource:sortDesc' });
    const __filterDesc = signal('none', { name: 'demo-datasource:filterDesc' });
    const __dirty = signal(false, { name: 'demo-datasource:dirty' });
    const __addedCount = signal(0, { name: 'demo-datasource:addedCount' });
    const __updatedCount = signal(0, { name: 'demo-datasource:updatedCount' });
    const __removedCount = signal(0, { name: 'demo-datasource:removedCount' });
// ─── Mock transport (simulates server) ────────────────────────
    var mockDb = [];
    
    for (var i = 1; i <= 53; i++) {
        mockDb.push({ id: i, name: 'User ' + i, email: 'user' + i + '@test.com' });
    }
    
    var mockTransport = {
        read: function(req) {
            return new Promise(function(resolve) {
                setTimeout(function() {
                    var filtered = mockDb;
                    // Filter
                    if (req.filter && req.filter.length > 0) {
                        var f = req.filter[0];
                        if (f.operator === 'contains' && f.field === 'name') {
                            var term = String(f.value).toLowerCase();
                            filtered = filtered.filter(function(u) { return u.name.toLowerCase().indexOf(term) >= 0; });
                        }
                    }
                    // Sort
                    if (req.sort && req.sort.length > 0) {
                        var s = req.sort[0];
                        filtered = filtered.slice().sort(function(a, b) {
                            var va = a[s.field], vb = b[s.field];
                            if (va < vb) return s.dir === 'asc' ? -1 : 1;
                            if (va > vb) return s.dir === 'asc' ? 1 : -1;
                            return 0;
                        });
                    }
                    // Paginate
                    var start = (req.page - 1) * req.pageSize;
                    var page = filtered.slice(start, start + req.pageSize);
                    resolve({ data: page, total: filtered.length });
                }, 150); // simulate network delay
            });
        },
        create: function(item) {
            return new Promise(function(resolve) {
                var newItem = { id: mockDb.length + 1, name: item.name, email: item.email };
                mockDb.push(newItem);
                resolve(newItem);
            });
        },
        destroy: function(item) {
            return new Promise(function(resolve) {
                mockDb = mockDb.filter(function(u) { return u.id !== item.id; });
                resolve();
            });
        },
    };
    
    
    // ─── DataSource ───────────────────────────────────────────────
    var ds = createDataSource({
        transport: mockTransport,
        pageSize: 10,
        autoLoad: true,
    });
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    var currentSortField = '';
    
    var currentSortDir = 'asc';
    
    
    function sortIcon(field) {
        if (currentSortField !== field) return '';
        return currentSortDir === 'asc' ? '↑' : '↓';
    }
    
    function toggleSort(field) {
        if (currentSortField === field) {
            currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
        } else {
            currentSortField = field;
            currentSortDir = 'asc';
        }
        ds.setSort([{ field: field, dir: currentSortDir }]);
        __sortDesc.setRaw(field + ' ' + currentSortDir);
    }
    
    function sortById() { toggleSort('id'); }
    function sortByName() { toggleSort('name'); }
    
    function onFilter(e) {
        var val = e.target.value;
        if (val) {
            ds.setFilter([{ field: 'name', operator: 'contains', value: val }]);
            __filterDesc.setRaw('name contains "' + val + '"');
        } else {
            ds.setFilter([]);
            __filterDesc.setRaw('none');
        }
    }
    
    function prevPage() { ds.setPage(__currentPage() - 1); }
    function nextPage() { ds.setPage(__currentPage() + 1); }
    
    var addN = 100;
    
    function addItem() {
        addN++;
        ds.add({ id: addN, name: 'New User ' + addN, email: 'new' + addN + '@test.com' });
    }
    function syncChanges() { ds.sync(); }
    function cancelAll() { ds.cancelChanges(); }
    onMount(() => {
    var d1 = effect(() => {
        __rows.setRaw(ds.data());
        __currentPage.setRaw(ds.page());
        __totalPages.setRaw(ds.totalPages());
        __totalItems.setRaw(ds.total());
        __loading.setRaw(ds.isLoading());
        __dirty.setRaw(ds.hasChanges());
    });
    var d2 = effect(() => {
        var ch = ds.changes();
        __addedCount.setRaw(ch.added.length);
        __updatedCount.setRaw(ch.updated.length);
        __removedCount.setRaw(ch.removed.length);
    });
    onDestroy(() => { d1(); d2(); ds.dispose(); });
});
    ctx.el.setAttribute('data-pdx-oxc18m', '');
    return { rows: __rows, currentPage: __currentPage, totalPages: __totalPages, totalItems: __totalItems, loading: __loading, sortDesc: __sortDesc, filterDesc: __filterDesc, dirty: __dirty, addedCount: __addedCount, updatedCount: __updatedCount, removedCount: __removedCount, sortIcon, toggleSort, sortById, sortByName, onFilter, prevPage, nextPage, addItem, syncChanges, cancelAll };
  },

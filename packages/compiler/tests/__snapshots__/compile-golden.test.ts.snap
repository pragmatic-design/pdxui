import { component, html } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-coihzv");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-coihzv"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  \\n  [data-pdx-coihzv] .density-demo {\\n    display: grid;\\n    grid-template-columns: repeat(3, 1fr);\\n    gap: var(--pdx-space-md);\\n    margin-top: var(--pdx-space-md);\\n  }\\n  [data-pdx-coihzv] .density-card {\\n    padding: var(--pdx-space-md);\\n    border: 1px solid var(--pdx-color-border);\\n    border-radius: var(--pdx-radius-md);\\n    background: var(--pdx-color-surface);\\n  }\\n  [data-pdx-coihzv] .density-sample {\\n    display: flex;\\n    flex-direction: column;\\n    gap: var(--pdx-space-xs);\\n    margin-top: var(--pdx-space-sm);\\n  }\\n  [data-pdx-coihzv] .density-item {\\n    padding: var(--pdx-space-xs) var(--pdx-space-sm);\\n    background: var(--pdx-color-inset);\\n    border-radius: var(--pdx-radius-sm);\\n    font-size: var(--pdx-text-sm);\\n  }\\n";
}

component('pdx-demo-design-spacing-density', {
  props: {},
  setup(ctx) {
    ctx.el.setAttribute('data-pdx-coihzv', '');
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Density</h2>
    <p class="pdx-txt-small pdx-ink-muted">All spacing tokens are multiplied by <code>--pdx-density-factor</code>. Set via <code>pdx-density</code> attribute on <code>&lt;html&gt;</code> or any container.</p>

    <div class="density-demo">
      <div class="density-card" style="--pdx-density-factor:0.75">
        <span class="pdx-txt-label pdx-ink-muted">COMPACT (0.75x)</span>
        <div class="density-sample">
          <div class="density-item">Item 1</div>
          <div class="density-item">Item 2</div>
          <div class="density-item">Item 3</div>
        </div>
      </div>
      <div class="density-card">
        <span class="pdx-txt-label pdx-ink-muted">NORMAL (1x)</span>
        <div class="density-sample">
          <div class="density-item">Item 1</div>
          <div class="density-item">Item 2</div>
          <div class="density-item">Item 3</div>
        </div>
      </div>
      <div class="density-card" style="--pdx-density-factor:1.25">
        <span class="pdx-txt-label pdx-ink-muted">COMFORT (1.25x)</span>
        <div class="density-sample">
          <div class="density-item">Item 1</div>
          <div class="density-item">Item 2</div>
          <div class="density-item">Item 3</div>
        </div>
      </div>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;html pdx-density="compact"&gt;  &lt;!-- 0.75x --&gt;
&lt;html pdx-density="normal"&gt;   &lt;!-- 1x (default) --&gt;
&lt;html pdx-density="comfort"&gt;  &lt;!-- 1.25x --&gt;

/* Or on any container for local density: */
&lt;div style="--pdx-density-factor: 0.75"&gt;
  Compact section
&lt;/div&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


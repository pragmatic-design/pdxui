        </pdx-field-group>

        <pdx-field-group name="billing" label="Billing Info" display="panel" collapsed>
          <div class="form-grid">
            <pdx-form-field name="billing.card" label="Card Number" :error=\${() => ctx.displayForm.fields['billing.card']?.error()} :touched=\${() => ctx.displayForm.fields['billing.card']?.touched()} :warning=\${() => ctx.displayForm.fields['billing.card']?.warning()}>
              <pdx-input name="billing.card" placeholder="**** **** **** ****" @pdx-input=\${(e) => ctx.displayForm.fields['billing.card']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.displayForm.fields['billing.card']?.onBlur()}></pdx-input>

"// 0 warning(s)

============================================================
import { createGlobalStore, signal } from '@pdxui/core';

const __store_theme = createGlobalStore('theme', () => {
    const __currentTheme = signal('neutral', { name: 'theme-store:currentTheme' });
    const __darkMode = signal(false, { name: 'theme-store:darkMode' });
    const __density = signal('', { name: 'theme-store:density' });
function setTheme(name) {
        __currentTheme.set(name);
        document.documentElement.setAttribute('pdx-theme', name);
    }
    
    function toggleDark() {
        __darkMode.set(prev => !prev);
        if (__darkMode()) {
            document.documentElement.setAttribute('pdx-dark', '');
            document.documentElement.setAttribute('pdx-scheme', 'dark');
        } else {
            document.documentElement.removeAttribute('pdx-dark');
            document.documentElement.setAttribute('pdx-scheme', 'light');
        }
    }
    
    function setDensity(d) {
        __density.set(d);
        if (d) {
            document.documentElement.setAttribute('pdx-density', d);
        } else {
            document.documentElement.removeAttribute('pdx-density');
        }
    }
    return { currentTheme: __currentTheme, darkMode: __darkMode, density: __density, setTheme, toggleDark, setDensity };
}, { persist: 'local' });

export function useTheme() { return __store_theme; }
"
`;


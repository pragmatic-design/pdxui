exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-field-list/demo-comp-field-list-row-slot.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createForm, html, safeHandler, signal, slotCarrier } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-iq2zco");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-iq2zco"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-iq2zco] .task-row { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--pdx-space-sm); width: 100%; }\\n";
}

component('pdx-demo-comp-field-list-row-slot', {
  props: {},
  setup(ctx) {
    const __taskValues = signal('', { name: 'demo-comp-field-list-row-slot:taskValues' });
const people = [
      { value: 'ada', label: 'Ada Lovelace' },
      { value: 'grace', label: 'Grace Hopper' },
      { value: 'alan', label: 'Alan Turing' },
    ];
    
    
    const taskFields = [
      { name: 'title', type: 'text', label: 'Task' },
      { name: 'assignee', type: 'text', label: 'Assignee' },
    ];
    
    
    const taskDefault = { title: '', assignee: '' };
    
    
    const taskForm = createForm({
      initialValues: { tasks: [{ title: 'Write the release notes', assignee: 'grace' }, { title: 'Review the API', assignee: '' }] },
    });
    
    
    
    
    function submitTasks(e) { __taskValues.set(JSON.stringify(e.detail.values, null, 2)); }
    
    function setTask(index, key, value) {
      taskForm.fields['tasks.' + index + '.' + key].onChange(value);
    }
    ctx.el.setAttribute('data-pdx-iq2zco', '');
    return { people, taskFields, taskDefault, taskForm, taskValues: __taskValues, submitTasks, setTask };
  },
  render: (ctx) => {
    const __pdxSlot_row_0 = (__scope) => { const { item, index } = __scope; return html\`
            <div class="task-row">
              <pdx-input :value=\${item.title} aria-label="Task" @pdx-input=\${safeHandler(e => ctx.setTask(index, 'title', e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-input')}></pdx-input>
              <pdx-select :options=\${() => ctx.people} :value=\${item.assignee} placeholder="Assign to…" label="Assignee" @pdx-change=\${safeHandler(e => ctx.setTask(index, 'assignee', e.detail.value), ctx.el?.tagName?.toLowerCase(), 'pdx-change')}></pdx-select>
            </div>
          \`; };
    return html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">A row of your own — the row slot</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      <code>itemFields</code> builds plain controls. A row that needs a component of its own — here a
      <code>&lt;pdx-select&gt;</code> with options — goes in the <code>row</code> slot, which receives
      <code>item</code> (that row's values) and <code>index</code>. The slot writes back through the form's field at
      <code>tasks.{index}.assignee</code>. The list still draws each row's remove button; a row that wants its own
      calls <code>remove()</code>, which the slot also receives.
    </p>
    <pdx-form :form=\${() => ctx.taskForm} @pdx-submit=\${safeHandler(ctx.submitTasks, ctx.el?.tagName?.toLowerCase(), 'pdx-submit')}>
      <div class="form-stack">
        <pdx-field-list name="tasks" label="Tasks" addLabel="+ Add task" :item-fields=\${() => ctx.taskFields} :item-default=\${() => ctx.taskDefault}>
          \${slotCarrier('row', __pdxSlot_row_0)}
        </pdx-field-list>
        <pdx-form-actions submitLabel="Save tasks"></pdx-form-actions>
      </div>
    </pdx-form>
    <pre class="pdx-txt-mono values-json" :hidden=\${() => !ctx.taskValues()}>\${ctx.taskValues}</pre>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-field-list name="tasks" :itemFields="taskFields" :itemDefault="taskDefault"&gt;
  &lt;slot name="row" let:item let:index&gt;
    &lt;pdx-input :value="item.title" @pdx-input="e =&gt; setTask(index, 'title', e.detail.value)"&gt;&lt;/pdx-input&gt;
    &lt;pdx-select :options="people" :value="item.assignee"
      @pdx-change="e =&gt; setTask(index, 'assignee', e.detail.value)"&gt;&lt;/pdx-select&gt;
  &lt;/slot&gt;
&lt;/pdx-field-list&gt;

function setTask(index, key, value) {
  taskForm.fields['tasks.' + index + '.' + key].onChange(value);
}</code></pre>
    </details>
  </section>
\`;
  },
});
"
`;


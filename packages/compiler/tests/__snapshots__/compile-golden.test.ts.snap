        <tbody>
          <tr><td><code>open</code></td><td>boolean</td><td>false</td><td>Controlled open state.</td></tr>
          <tr><td><code>schema</code></td><td>FormSchema</td><td>null</td><td>Field schema for the form.</td></tr>
          <tr><td><code>value</code></td><td>object</td><td>null</td><td>Entity to edit; null → create.</td></tr>
          <tr><td><code>position</code></td><td>left|right</td><td>right</td><td>Drawer side.</td></tr>
          <tr><td><code>size</code></td><td>string</td><td>md</td><td>sm/md/lg preset or a custom width.</td></tr>
          <tr><td><code>busy</code></td><td>boolean</td><td>false</td><td>Disable the footer buttons while persisting.</td></tr>
        </tbody>
      </table>
      <table class="options-table" style="margin-top: var(--pdx-space-lg);">
        <thead><tr><th>Event</th><th>Detail</th></tr></thead>
        <tbody>
          <tr><td><code>pdx-save</code></td><td>{ values, mode: 'create' | 'edit' }</td></tr>
          <tr><td><code>pdx-cancel</code></td><td>—</td></tr>
        </tbody>
      </table>
    </section>
  </div>
\`,
});


"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';
import { teamItems } from './state.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-o892wn");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-o892wn"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-o892wn] .event-log { margin-top: var(--pdx-space-sm); padding: var(--pdx-space-xs) var(--pdx-space-sm); background: var(--pdx-color-inset); border-radius: var(--pdx-radius-sm); }\\n";
}

component('pdx-demo-comp-avatar-group-clickable', {
  props: {},
  setup(ctx) {
    const __clickLog = signal('Click an avatar...', { name: 'demo-comp-avatar-group-clickable:clickLog' });
function onAvatarClick(e) {
      __clickLog.set('pdx-click: ' + e.detail.item.name + ' (index ' + e.detail.index + ')');
    }
    
    function onOverflowClick(e) {
      __clickLog.set('pdx-overflow-click: +' + e.detail.count + ' hidden avatars');
    }
    ctx.el.setAttribute('data-pdx-o892wn', '');
    return { clickLog: __clickLog, onAvatarClick, onOverflowClick };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Clickable</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click on an avatar or the overflow badge, or Tab to it and press Enter or Space. Each avatar is a button named by its person, the badge one named "4 more". Hover scales up.</p>
    <div class="demo-container">
      <pdx-avatar-group :items=\${teamItems} :max=\${4} :clickable=\${true} @pdx-click=\${safeHandler(ctx.onAvatarClick, ctx.el?.tagName?.toLowerCase(), 'pdx-click')} @pdx-overflow-click=\${safeHandler(ctx.onOverflowClick, ctx.el?.tagName?.toLowerCase(), 'pdx-overflow-click')}></pdx-avatar-group>
    </div>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="click-log">\${ctx.clickLog}</div>
  </section>
\`,
});
"
`;


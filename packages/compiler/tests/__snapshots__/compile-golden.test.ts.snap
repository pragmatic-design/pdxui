component('pdx-demo-comp-edit-drawer-create-edit', {
  props: {},
  setup(ctx) {
    const __drawerOpen = signal(false, { name: 'demo-comp-edit-drawer-create-edit:drawerOpen' });
    const __editing = signal(null, { name: 'demo-comp-edit-drawer-create-edit:editing' });
    const __lastSaved = signal('', { name: 'demo-comp-edit-drawer-create-edit:lastSaved' });
const schema = { fields: [
      { name: 'name', type: 'text', label: 'Name', validators: [{ type: 'required' }] },
      { name: 'role', type: 'text', label: 'Role' },
    ] };
    
    
    
    
    
    
    function openNew() { __editing.set(null); __drawerOpen.set(true); }
    function openEdit() { __editing.set({ id: 1, name: 'Alice Johnson', role: 'Engineer' }); __drawerOpen.set(true); }
    function onSave(e) { __lastSaved.set(e.detail.mode + ': ' + JSON.stringify(e.detail.values)); __drawerOpen.set(false); }
    function onCancel() { __drawerOpen.set(false); }
    ctx.el.setAttribute('data-pdx-4843ny', '');
    return { schema, drawerOpen: __drawerOpen, editing: __editing, lastSaved: __lastSaved, openNew, openEdit, onSave, onCancel };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Create &amp; Edit</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      "New" opens an empty form; "Edit" preloads an entity. Save validates (Name is required) and
      emits the values.
    </p>

    <div class="demo-row">
      <button class="pdx-primary" @click=\${safeHandler(ctx.openNew, ctx.el?.tagName?.toLowerCase(), 'click')}><pdx-icon name="plus" size="16"></pdx-icon> New</button>
      <button class="pdx-secondary" @click=\${safeHandler(ctx.openEdit, ctx.el?.tagName?.toLowerCase(), 'click')}>Edit Alice</button>
    </div>

    <div class="event-log" :show=\${() => ctx.lastSaved() !== ''}>
      <strong class="pdx-txt-small">Last saved</strong>
      <div class="pdx-txt-mono pdx-txt-small pdx-ink-muted" style="margin-top: 6px;">\${ctx.lastSaved}</div>
    </div>

    <pdx-edit-drawer
      :open=\${ctx.drawerOpen}
      :schema=\${() => ctx.schema}
      :value=\${ctx.editing}
      @pdx-save=\${safeHandler(ctx.onSave, ctx.el?.tagName?.toLowerCase(), 'pdx-save')}
      @pdx-cancel=\${safeHandler(ctx.onCancel, ctx.el?.tagName?.toLowerCase(), 'pdx-cancel')}></pdx-edit-drawer>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-edit-drawer :open="drawerOpen" :schema="schema" :value="editing"
  @pdx-save="onSave" @pdx-cancel="onCancel" /&gt;

// value = null → create; value = entity → edit
function onSave(e) { persist(e.detail.values); drawerOpen = false; }</code></pre>
    </details>
  </section>
\`,
});
"
`;


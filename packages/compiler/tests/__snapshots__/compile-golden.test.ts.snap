  __pdx_style.textContent = "\\n  [data-pdx-4zdqcj] .demo { display: flex; flex-direction: column; gap: 24px; }\\n  [data-pdx-4zdqcj] h2 { font-size: 1.5rem; font-weight: 700; }\\n  [data-pdx-4zdqcj] h3 { font-size: 1rem; font-weight: 600; margin-bottom: 8px; }\\n  [data-pdx-4zdqcj] .desc { color: #666; font-size: 0.875rem; }\\n  [data-pdx-4zdqcj] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; display: flex; flex-direction: column; gap: 8px; }\\n  [data-pdx-4zdqcj] .row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\\n  [data-pdx-4zdqcj] .trap-box { border: 2px solid #e0e0e0; border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px; }\\n  [data-pdx-4zdqcj] .trap-box.active { border-color: #3b82f6; }\\n  [data-pdx-4zdqcj] .group-list { display: flex; flex-direction: column; gap: 4px; }\\n  [data-pdx-4zdqcj] .group-row { display: flex; gap: 4px; }\\n  [data-pdx-4zdqcj] .group-item { padding: 8px 14px; border: 1px solid #e0e0e0; border-radius: 4px; cursor: pointer; font-size: 0.875rem; transition: all 150ms; }\\n  [data-pdx-4zdqcj] .group-item:focus { background: #3b82f6; color: white; outline: none; border-color: #3b82f6; }\\n  [data-pdx-4zdqcj] .group-item[aria-disabled=\\"true\\"] { opacity: 0.4; cursor: not-allowed; }\\n  [data-pdx-4zdqcj] .log { font-family: monospace; font-size: 0.75rem; background: #f5f5f7; padding: 8px; border-radius: 6px; white-space: pre-wrap; min-height: 32px; }\\n  \\n  [data-pdx-4zdqcj] [data-test=\\"target-a\\"]:focus, [data-pdx-4zdqcj] [data-test=\\"target-b\\"]:focus, [data-pdx-4zdqcj] [data-test=\\"target-c\\"]:focus {\\n    outline: 3px solid #3b82f6; outline-offset: 2px; box-shadow: 0 0 0 6px rgba(59,130,246,0.2);\\n  }\\n";
}

component('pdx-demo-focus', {
  props: {},
  setup(ctx) {
    const __trapActive = signal(false, { name: 'demo-focus:trapActive' });
    const __trapLog = signal('', { name: 'demo-focus:trapLog' });
    const __groupLog = signal('', { name: 'demo-focus:groupLog' });
    const __verticalRef = signal(null, { name: 'demo-focus:verticalRef' });
    const __horizontalRef = signal(null, { name: 'demo-focus:horizontalRef' });
    const __typeaheadRef = signal(null, { name: 'demo-focus:typeaheadRef' });
    const __restoreInputRef = signal(null, { name: 'demo-focus:restoreInputRef' });
    const __restoreLog = signal('Click a button, then Save Focus.', { name: 'demo-focus:restoreLog' });
    const __trapContainer = signal(null, { name: 'demo-focus:trapContainer' });
const fruits = ['Apple', 'Banana', 'Cherry', 'Date', 'Elderberry'];
    
    const tabNames = ['Dashboard', 'Users', 'Settings', 'Reports'];
    
    const countries = ['Argentina', 'Australia', 'Brazil', 'Canada', 'Chile', 'Denmark', 'Egypt', 'France'];
    
    
    
    
    
    let trapDispose = null;
    
    
    
    
    
    
    
    
    const fr = focusRestore();
    
    
    
    
    function activateTrap() {
        const container = __trapContainer();
        if (!container) return;
        __trapActive.set(true);
        trapDispose = focusTrap(container, { initialFocus: 'first', restoreFocus: true });
        __trapLog.set('Trap activated — Tab cycles within the box');
    }
    
    function deactivateTrap() {
        trapDispose?.();
        trapDispose = null;
        __trapActive.set(false);
        __trapLog.set(prev => prev + '\\nTrap deactivated — focus restored');
    }
    
    // Track last focused target button so save captures the right element
    let lastTarget = null;
    
    function trackTarget(e) {
        lastTarget = e.currentTarget;
        __restoreLog.set('Focused: "' + e.currentTarget.textContent.trim() + '" — now click Save.');
    }
    
    function saveFocus() {
        if (!lastTarget) { __restoreLog.set('Click a colored button first!'); return; }
        // Temporarily focus the target so fr.save() captures it
        lastTarget.focus();
        fr.save();
        const name = lastTarget.textContent.trim();
        __restoreLog.set('Saved: "' + name + '". Focus moved to input.');
        const input = __restoreInputRef();

"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-block-ui-simulated-fetch', {
  props: {},
  setup(ctx) {
    const __fetchLoading = signal(false, { name: 'demo-comp-block-ui-simulated-fetch:fetchLoading' });
    const __fetchContent = signal('Click "Load Data" to simulate a fetch...', { name: 'demo-comp-block-ui-simulated-fetch:fetchContent' });
function simulateFetch() {
      __fetchLoading.set(true);
      setTimeout(function() {
        __fetchLoading.set(false);
        __fetchContent.set('Data loaded successfully at ' + new Date().toLocaleTimeString());
      }, 2000);
    }
    return { fetchLoading: __fetchLoading, fetchContent: __fetchContent, simulateFetch };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Simulated Fetch</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click "Load Data" to block for 2 seconds, then unblock.</p>
    <div class="demo-actions">
      <button class="pdx-btn pdx-outline pdx-btn-xs" @click=\${safeHandler(ctx.simulateFetch, ctx.el?.tagName?.toLowerCase(), 'click')}>Load Data</button>
    </div>
    <div class="demo-wrap">
      <pdx-block-ui :blocked=\${ctx.fetchLoading} id="fetch-block">
        <div class="demo-panel">
          <div class="pdx-txt-small" id="fetch-content">\${ctx.fetchContent}</div>
        </div>
      </pdx-block-ui>
    </div>
  </section>
\`,
});
"
`;


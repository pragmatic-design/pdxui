exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-button/demo-comp-button-loading.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal, when } from '@pdxui/core';
import { useButtonConsole } from './state.pdx';

component('pdx-demo-comp-button-loading', {
  props: {},
  setup(ctx) {
    const __loadingPrimary = signal(false, { name: 'demo-comp-button-loading:loadingPrimary' });
    const __loadingSecondary = signal(false, { name: 'demo-comp-button-loading:loadingSecondary' });
    const __loadingDanger = signal(false, { name: 'demo-comp-button-loading:loadingDanger' });
const buttonConsole = useButtonConsole();
    
    
    
    
    
    
    function toggleLoading() {
        if (__loadingPrimary()) return;
        __loadingPrimary.set(true);
        buttonConsole.log({ target: { closest: () => ({ textContent: 'Save', getAttribute: () => 'primary', className: '' }) } });
        setTimeout(() => { __loadingPrimary.set(false); }, 2000);
    }
    
    function toggleLoadingSec() {
        if (__loadingSecondary()) return;
        __loadingSecondary.set(true);
        buttonConsole.log({ target: { closest: () => ({ textContent: 'Load Data', getAttribute: () => 'secondary', className: '' }) } });
        setTimeout(() => { __loadingSecondary.set(false); }, 2000);
    }
    
    function toggleLoadingDanger() {
        if (__loadingDanger()) return;
        __loadingDanger.set(true);
        buttonConsole.log({ target: { closest: () => ({ textContent: 'Delete', getAttribute: () => 'danger', className: '' }) } });
        setTimeout(() => { __loadingDanger.set(false); }, 2000);
    }
    return { buttonConsole, loadingPrimary: __loadingPrimary, loadingSecondary: __loadingSecondary, loadingDanger: __loadingDanger, toggleLoading, toggleLoadingSec, toggleLoadingDanger };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Loading State</h2>
    <p class="pdx-txt-small pdx-ink-muted">Set <code>loading</code> prop. Button becomes disabled with spinner overlay. <code>aria-busy="true"</code> set automatically. Click to toggle.</p>

    <div class="btn-row">
      <pdx-button variant="primary" :loading=\${ctx.loadingPrimary} @click=\${safeHandler(ctx.toggleLoading, ctx.el?.tagName?.toLowerCase(), 'click')}>
        \${when(() => ctx.loadingPrimary(), () => html\` Saving... \`, () => html\` Save \`)}
      </pdx-button>
      <pdx-button variant="secondary" :loading=\${ctx.loadingSecondary} @click=\${safeHandler(ctx.toggleLoadingSec, ctx.el?.tagName?.toLowerCase(), 'click')}>
        \${when(() => ctx.loadingSecondary(), () => html\` Loading... \`, () => html\` Load Data \`)}
      </pdx-button>
      <pdx-button variant="danger" :loading=\${ctx.loadingDanger} @click=\${safeHandler(ctx.toggleLoadingDanger, ctx.el?.tagName?.toLowerCase(), 'click')}>
        \${when(() => ctx.loadingDanger(), () => html\` Deleting... \`, () => html\` Delete \`)}
      </pdx-button>
    </div>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-button variant="primary" :loading="isSaving"&gt;
  Save
&lt;/pdx-button&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


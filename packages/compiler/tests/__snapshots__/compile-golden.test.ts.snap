 pointer; }\\n  [data-pdx-d4xbl6] .scroll-target { padding: 16px; background: #f0f0f0; border-radius: 8px; text-align: center; font-size: 0.9rem; transition: all 500ms ease; opacity: 0; transform: translateY(20px); }\\n  [data-pdx-d4xbl6] .scroll-target.pdx-in-view { opacity: 1; transform: translateY(0); }\\n";

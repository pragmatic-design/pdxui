"// 0 warning(s)

============================================================
import { component, html } from '@pdxui/core';
import '@pdxui/ui/provide';

component('pdx-demo-comp-provide-scoped', {
  props: {},
  setup(ctx) {

  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Scoped Override</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Nested providers shadow outer ones. The nearest ancestor wins — like CSS cascading.
    </p>
    <div class="demo-box">
      <pdx-provide name="color" :value=\${() => 'blue'}>
        <div class="demo-child">
          Outer color: <strong style="color: blue">blue</strong>
        </div>
        <pdx-provide name="color" :value=\${() => 'red'}>
          <div class="demo-child">
            Inner override: <strong style="color: red">red</strong>
          </div>
        </pdx-provide>
        <div class="demo-child">
          Back to outer: <strong style="color: blue">blue</strong>
        </div>
      </pdx-provide>
    </div>
    <details class="source"><summary>Source</summary><pre><code>&lt;pdx-provide name="color" :value="'blue'"&gt;
  &lt;!-- inject('color') → 'blue' --&gt;
  &lt;pdx-provide name="color" :value="'red'"&gt;
    &lt;!-- inject('color') → 'red' (nearest wins) --&gt;
  &lt;/pdx-provide&gt;
  &lt;!-- inject('color') → 'blue' again --&gt;
&lt;/pdx-provide&gt;</code></pre></details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-provide/demo-comp-provide-single.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';
import '@pdxui/ui/provide';

component('pdx-demo-comp-provide-single', {
  props: {},
  setup(ctx) {
    const __greetingMsg = signal('Hello from provider!', { name: 'demo-comp-provide-single:greetingMsg' });
function changeGreeting() {
      __greetingMsg.set(prev => prev === 'Hello from provider!' ? 'Ciao dal provider!' : 'Hello from provider!');
    }
    return { greetingMsg: __greetingMsg, changeGreeting };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Single Named Value</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Provide one value by name. Children inject it with <code>@inject</code> or <code>useProvided()</code>.
    </p>
    <div class="demo-box">
      <pdx-provide name="greeting" :value=\${ctx.greetingMsg}>
        <div class="demo-child">
          Child sees greeting: <strong>\${ctx.greetingMsg}</strong>
        </div>
        <div class="demo-controls">
          <button class="pdx-btn pdx-btn-sm pdx-btn-outline" @click=\${safeHandler(ctx.changeGreeting, ctx.el?.tagName?.toLowerCase(), 'click')}>Change Greeting</button>
        </div>
      </pdx-provide>
    </div>
    <details class="source"><summary>Source</summary><pre><code>&lt;pdx-provide name="greeting" :value="greetingMsg"&gt;
  &lt;!-- all descendants can inject('greeting') --&gt;
  &lt;pdx-my-widget /&gt;
&lt;/pdx-provide&gt;

// In pdx-my-widget setup:
const greeting = useProvided('greeting');</code></pre></details>
  </section>
\`,
});
"
`;


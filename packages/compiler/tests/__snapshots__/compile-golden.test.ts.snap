exports[`compile golden — demo corpus > showcase-new/pages/sections/design-themes/demo-design-themes-themes.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, eachRow, html } from '@pdxui/core';
import { THEME_INHERITED } from '@pdxui/design/engine';

{
  let __pdx_style = document.getElementById("pdx-s-xnl5q9");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-xnl5q9"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-xnl5q9] .theme-grid {\\n    display: grid;\\n    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));\\n    gap: var(--pdx-space-md);\\n    margin-top: var(--pdx-space-lg);\\n}\\n[data-pdx-xnl5q9] .theme-card {\\n    border: 1px solid var(--pdx-color-border);\\n    border-radius: var(--pdx-radius-md);\\n    background: var(--pdx-color-bg);\\n    color: var(--pdx-color-text);\\n    overflow: hidden;\\n}\\n[data-pdx-xnl5q9] .tc-head {\\n    padding: var(--pdx-space-xs) var(--pdx-space-sm);\\n    border-bottom: 1px solid var(--pdx-color-border);\\n    background: var(--pdx-color-surface);\\n}\\n[data-pdx-xnl5q9] .tc-name { font-family: var(--pdx-font-mono); font-size: 0.78rem; }\\n[data-pdx-xnl5q9] .tc-body { padding: var(--pdx-space-sm); display: flex; flex-direction: column; gap: var(--pdx-space-xs); }\\n[data-pdx-xnl5q9] .tc-swatches { display: flex; gap: 4px; margin-bottom: var(--pdx-space-2xs); }\\n[data-pdx-xnl5q9] .tc-sw { width: 22px; height: 22px; border-radius: var(--pdx-radius-sm); }\\n[data-pdx-xnl5q9] .tc-btn { width: 100%; }\\n[data-pdx-xnl5q9] .tc-input-wrap { width: 100%; }\\n";
}

component('pdx-demo-design-themes-themes', {
  props: {},
  setup(ctx) {
// \`neutral\` IS the base, so it is absent from THEME_INHERITED by construction — a theme that
    // inherits nothing has no row there. Everything else comes from the generated contract, so a theme
    // added to packages/design/src/themes lands here without touching this file.
    const themes = ['neutral', ...Object.keys(THEME_INHERITED)].sort();
    ctx.el.setAttribute('data-pdx-xnl5q9', '');
    return { themes };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">\${() => ctx.themes.length} themes, one composition</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      The same markup in each card. Nothing below is per-theme CSS — only the
      <code>pdx-theme</code> attribute differs, which is the whole claim: re-theming is an attribute,
      not a rebuild.
    </p>

    <div class="theme-grid" data-test="theme-grid">
      \${eachRow(() => ctx.themes, (t) => t, (t) => html\`
        <div class="theme-card" data-theme-card pdx-scheme="light" :pdx-theme=\${() => t()}>
          <div class="tc-head">
            <span class="tc-name">\${() => t()}</span>
          </div>
          <div class="tc-body">
            <div class="tc-swatches">
              <span class="tc-sw" style="background: var(--pdx-color-primary)"></span>
              <span class="tc-sw" style="background: var(--pdx-color-accent)"></span>
              <span class="tc-sw" style="background: var(--pdx-color-success)"></span>
              <span class="tc-sw" style="background: var(--pdx-color-warning)"></span>
              <span class="tc-sw" style="background: var(--pdx-color-danger)"></span>
            </div>
            <button class="pdx-btn pdx-primary tc-btn">Primary</button>
            <button class="pdx-btn pdx-outline tc-btn">Outline</button>
            <div class="tc-input-wrap pdx-input-wrap">
              <input class="pdx-input" placeholder="Input" readonly />
            </div>
          </div>
        </div>
      \`)}</div>
  </section>
\`,
});
"
`;


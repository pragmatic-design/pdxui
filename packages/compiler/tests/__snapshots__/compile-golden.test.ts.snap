    <pdx-form :form=\${() => ctx.addressForm}>
      <pdx-field-list name="addresses" label="Addresses" display="dialog" addLabel="+ Add address" :item-fields=\${() => ctx.addressFields} :item-default=\${() => ctx.addressDefault}></pdx-field-list>
    </pdx-form>
  </section>
\`,
});

}

component('pdx-demo-infra-drag-free', {
  props: {},
  setup(ctx) {
    const __freeDragging = signal(false, { name: 'demo-infra-drag-free:freeDragging' });
    const __freeX = signal(0, { name: 'demo-infra-drag-free:freeX' });
    const __freeY = signal(0, { name: 'demo-infra-drag-free:freeY' });
    const __freeVel = signal(0, { name: 'demo-infra-drag-free:freeVel' });
    const __freeRef = signal(null, { name: 'demo-infra-drag-free:freeRef' });
// Drag instances with bounds
    const freeDrag = useDrag(() => __freeRef(), { bounds: 'parent' });
    onMount(() => {
    // Free drag position + velocity tracking
    const d1 = effect(() => {
        __freeDragging.set(freeDrag.isDragging());
        const pos = freeDrag.position();
        __freeX.set(Math.round(pos.x));
        __freeY.set(Math.round(pos.y));
        const vel = freeDrag.velocity();
        __freeVel.set(Math.round(Math.sqrt(vel.vx * vel.vx + vel.vy * vel.vy)));
        const el = __freeRef();
        if (el) el.style.transform = 'translate(' + pos.x + 'px, ' + pos.y + 'px)';
    });

    onDestroy(() => {
        d1();
        freeDrag.dispose();
    });
});
    ctx.el.setAttribute('data-pdx-vubiff', '');

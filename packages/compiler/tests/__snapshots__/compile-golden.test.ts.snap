exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-infinite-scroll/demo-comp-infinite-scroll-manual.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createDataSource, effect, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-7vbk09");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-7vbk09"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-7vbk09] .load-more-wrap { display: flex; justify-content: center; padding: var(--pdx-space-md); }\\n";
}

component('pdx-demo-comp-infinite-scroll-manual', {
  props: {},
  setup(ctx) {
    const __manualItems = signal(null, { name: 'demo-comp-infinite-scroll-manual:manualItems' });
    const __manualLoadMore = signal(null, { name: 'demo-comp-infinite-scroll-manual:manualLoadMore' });
    const __manualLog = signal('Click "Load More" to fetch...', { name: 'demo-comp-infinite-scroll-manual:manualLog' });
// --- Manual demo: 50 items ---
    const manualAllItems = [];
    
    for (let _midx = 1; _midx <= 50; _midx++) {
        manualAllItems.push({ id: _midx, title: 'Manual Item ' + _midx });
    }
    
    const manualDS = createDataSource({
        transport: {
            read: function(params) {
                return new Promise(function(resolve) {
                    const _off = ((params.page || 1) - 1) * (params.pageSize || 10);
                    const _result = manualAllItems.slice(_off, _off + (params.pageSize || 10));
                    setTimeout(function() { resolve({ data: _result, total: manualAllItems.length }); }, 300);
                });
            },
        },
        pageSize: 10,
        autoLoad: true,
    });
    
    
    
    
    
    
    function onManualLoad() {
        manualDS.loadMore();
        __manualLog.set('Loading more...');
        // Hide button when no more data after load
        setTimeout(function() {
            if (__manualLoadMore() && !manualDS.hasMore()) __manualLoadMore().style.display = 'none';
        }, 500);
    }
    ctx.track(() => {
    const _data = manualDS.data();
    const _container = __manualItems();
    if (_container && _data) {
        _container.innerHTML = '';
        for (let _ri = 0; _ri < _data.length; _ri++) {
            const _item = _data[_ri];
            const _div = document.createElement('div');
            _div.className = 'scroll-item';
            _div.textContent = _item.title;
            _container.appendChild(_div);
        }
        __manualLog.set('Showing ' + _data.length + ' of ' + manualDS.total() + ' items');
    }
}, { name: "demo-comp-infinite-scroll-manual.pdx:59" });
    ctx.el.setAttribute('data-pdx-7vbk09', '');
    return { manualAllItems, manualDS, manualItems: __manualItems, manualLoadMore: __manualLoadMore, manualLog: __manualLog, onManualLoad };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Manual Trigger (Disabled auto-scroll)</h2>
    <p class="pdx-txt-small pdx-ink-muted">Auto-scroll disabled. "Load More" button inside the list at the bottom.</p>
    <div class="demo-container scroll-box" id="manual-scroll-box">
      <div id="manual-items" :ref=\${ctx.manualItems}></div>
      <div class="load-more-wrap" id="manual-load-more" :ref=\${ctx.manualLoadMore}>
        <button class="pdx-btn pdx-outline pdx-btn-sm" @click=\${safeHandler(ctx.onManualLoad, ctx.el?.tagName?.toLowerCase(), 'click')}>Load More</button>
      </div>
    </div>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="manual-log">\${ctx.manualLog}</div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>// Manual trigger — button inside scroll container
&lt;div class="scroll-box"&gt;
  &lt;div id="items"&gt;&lt;/div&gt;
  &lt;button @click="ds.loadMore()"&gt;Load More&lt;/button&gt;
&lt;/div&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


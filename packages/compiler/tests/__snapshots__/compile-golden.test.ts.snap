exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-bottom-sheet/demo-comp-bottom-sheet-action-sheet.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-bottom-sheet-action-sheet', {
  props: {},
  setup(ctx) {
    const __actionOpen = signal(false, { name: 'demo-comp-bottom-sheet-action-sheet:actionOpen' });
// Action sheet
    
    
    const actionDetents = [0.35];
    
    
    function openAction() { __actionOpen.set(true); }
    function closeAction() { __actionOpen.set(false); }
    
    function pickAction(name) {
        closeAction();
    }
    return { actionOpen: __actionOpen, actionDetents, openAction, closeAction, pickAction };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Action Sheet Pattern</h2>
    <p class="pdx-txt-small pdx-ink-muted">iOS-style action list. Small detent, list of actions, cancel at bottom.</p>
    <pdx-button variant="outline" @click=\${safeHandler(ctx.openAction, ctx.el?.tagName?.toLowerCase(), 'click')}>Show Actions</pdx-button>

    <pdx-bottom-sheet :open=\${ctx.actionOpen} :detents=\${() => ctx.actionDetents} label="Actions" @pdx-close=\${safeHandler(ctx.closeAction, ctx.el?.tagName?.toLowerCase(), 'pdx-close')}>
      <span slot="header"><strong>Choose Action</strong></span>
      <div class="action-list">
        <button class="action-item" @click=\${safeHandler(() => ctx.pickAction('Share'), ctx.el?.tagName?.toLowerCase(), 'click')}>
          <span>📤</span> Share
        </button>
        <button class="action-item" @click=\${safeHandler(() => ctx.pickAction('Copy Link'), ctx.el?.tagName?.toLowerCase(), 'click')}>
          <span>🔗</span> Copy Link
        </button>
        <button class="action-item" @click=\${safeHandler(() => ctx.pickAction('Edit'), ctx.el?.tagName?.toLowerCase(), 'click')}>
          <span>✏️</span> Edit
        </button>
        <button class="action-item danger" @click=\${safeHandler(() => ctx.pickAction('Delete'), ctx.el?.tagName?.toLowerCase(), 'click')}>
          <span>🗑️</span> Delete
        </button>
      </div>
      <span slot="footer">
        <pdx-button variant="ghost" @click=\${safeHandler(ctx.closeAction, ctx.el?.tagName?.toLowerCase(), 'click')} style="width:100%">Cancel</pdx-button>
      </span>
    </pdx-bottom-sheet>
  </section>
\`,
});
"
`;


exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-dialog/demo-comp-dialog-basic.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-comp-dialog-basic', {
  props: {},
  setup(ctx) {
    const __basicOpen = signal(false, { name: 'demo-comp-dialog-basic:basicOpen' });
function openBasic() { __basicOpen.set(true); }
    function closeBasic() { __basicOpen.set(false); }
    return { basicOpen: __basicOpen, openBasic, closeBasic };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Basic</h2>
    <p class="pdx-txt-small pdx-ink-muted">Simple informational dialog with title and close button.</p>
    <div class="btn-row">
      <pdx-button variant="primary" size="sm" @click=\${safeHandler(ctx.openBasic, ctx.el?.tagName?.toLowerCase(), 'click')}>Open Dialog</pdx-button>
    </div>
    <pdx-dialog :open=\${ctx.basicOpen} title="Welcome" @pdx-close=\${safeHandler(ctx.closeBasic, ctx.el?.tagName?.toLowerCase(), 'pdx-close')}>
      <p>This is a simple dialog with a title and close button. Click the backdrop or press Escape to close.</p>
    </pdx-dialog>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>&lt;pdx-button variant="primary" @click="openBasic"&gt;Open Dialog&lt;/pdx-button&gt;

&lt;pdx-dialog :open="basicOpen" title="Welcome" @pdx-close="closeBasic"&gt;
  &lt;p&gt;Dialog body content here.&lt;/p&gt;
&lt;/pdx-dialog&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-dialog/demo-comp-dialog-footer-actions.pdx 1`] = `

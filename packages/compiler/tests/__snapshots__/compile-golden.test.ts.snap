import { component, createBackdrop, html, safeHandler } from '@pdxui/core';

component('pdx-demo-infra-overlay-backdrop', {
  props: {},
  setup(ctx) {
// ── Backdrop ──
    let bdDispose = null;
    
    function showBdPlain() { showBd(false); }
    function showBdBlur() { showBd(true); }
    function showBd(blur) {

const __blk0=staticBlock(staticMarkup(' <section> <h2 class="pdx-txt-heading section-heading">Enum Filter (Server-side autocomplete)</h2> <p class="pdx-txt-small pdx-ink-muted">\\n      With <code>filterSearchable</code> + <code>filterOptionsSource</code> the options load on\\n      demand from the server as the user types — for large or remote value sets (lookup columns).\\n    </p> <div class="demo-container"> <pdx-data-grid hover striped></pdx-data-grid> </div> <details class="source-block"> <summary>Source</summary> <pre class="pdx-txt-mono"><code>function loadCategories(query) {\\n  return fetch(\\'/api/categories?q=\\' + query).then(r =&gt; r.json());\\n  // → [{ label, value }, ...]\\n}\\n\\n{ field: \\'category\\', header: \\'Category\\', type: \\'enum\\',\\n  filterSearchable: true,\\n  filterOptionsSource: loadCategories }</code></pre> </details> </section> '));
const __walk0=(r)=>{const __el0=r.firstChild.nextSibling;const __el5=__el0.firstChild.nextSibling.nextSibling.nextSibling.nextSibling.nextSibling;const __el6=__el5.firstChild.nextSibling;return [__el6];};
component('app-demo-comp-data-grid-filtering-enum-server', {
  props: {},
  setup(ctx) {
// Server-side autocomplete: options loaded on demand (qui simulato con un delay).
    const allTags = ['Electronics', 'Clothing', 'Books', 'Home', 'Sports', 'Garden', 'Toys', 'Beauty', 'Automotive', 'Grocery'];
    
    
    function loadCategories(query) {
      return new Promise(function(resolve) {
        setTimeout(function() {
          const q = (query || '').toLowerCase();
          resolve(allTags.filter(function(c) { return c.toLowerCase().includes(q); }).map(function(c) { return { label: c, value: c }; }));
        }, 250);
      });
    }
    
    const serverColumns = [
      { field: 'name', header: 'Product' },
      { field: 'category', header: 'Category', type: 'enum', filterSearchable: true, filterOptionsSource: loadCategories },
      { field: 'price', header: 'Price', type: 'currency' },
    ];
    
    
    const serverDS = createDataSource({ data: products.slice(), pageSize: 10 });
    ctx.el.setAttribute('data-pdx-o0zno6', '');
    return { allTags, loadCategories, serverColumns, serverDS };
  },
  render: (ctx) => (() => {
    const __frag=__blk0();
    const [__el6]=__walk0(__frag);
    let __el6w_source = {}; effect(() => { const __b = ctx.serverDS; if (Object.is(__b, __el6w_source)) return; __el6w_source = __b; assignBoundProperty(__el6, "source", __b); });

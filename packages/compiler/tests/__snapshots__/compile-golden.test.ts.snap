    const __drawerPos = signal('right', { name: 'demo-comp-drawer-positions:drawerPos' });
// Position drawer
    
    
    
    
    function openDrawer(pos) { __drawerPos.set(pos); __drawerOpen.set(true); }
    function closeDrawer() { __drawerOpen.set(false); }
    return { drawerOpen: __drawerOpen, drawerPos: __drawerPos, openDrawer, closeDrawer };
  },
  render: (ctx) => html\`

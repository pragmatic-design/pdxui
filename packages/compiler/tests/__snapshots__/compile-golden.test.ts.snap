      { name: 'Bologna', code: 'BLQ' }, { name: 'Genoa', code: 'GOA' }, { name: 'Palermo', code: 'PMO' },
      { name: 'Bari', code: 'BRI' }, { name: 'Catania', code: 'CTA' }, { name: 'Verona', code: 'VRN' },
    ];
    
    
    
    
    function onCityChange(e) { __cityValue.set(e.detail.value ? e.detail.label + ' (value: ' + e.detail.value + ')' : ''); }
    return { cities, cityValue: __cityValue, onCityChange };
  },
  render: (ctx) => html\`

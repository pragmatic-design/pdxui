exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-overlay-stack/demo-comp-overlay-stack-cascade.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler } from '@pdxui/core';
import { dialog } from '@pdxui/ui/dialog';

component('pdx-demo-comp-overlay-stack-cascade', {
  props: {},
  setup(ctx) {
async function onCascade() {
        dialog.alert({ title: 'Layer 1', message: 'First dialog. Press Escape to close.' });
        setTimeout(() => {
            dialog.alert({ title: 'Layer 2', message: 'Second dialog. Press Escape to close.' });
            setTimeout(() => {
                dialog.alert({ title: 'Layer 3 (Top)', message: 'Third dialog. Escape closes this first (LIFO).' });
            }, 100);
        }, 100);
    }
    return { onCascade };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Cascade Close (LIFO)</h2>
    <p class="pdx-txt-small pdx-ink-muted">Opens 3 dialogs stacked. Press Escape to close them one by one (LIFO order).</p>
    <div class="demo-row">
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.onCascade, ctx.el?.tagName?.toLowerCase(), 'click')}>Open 3 Stacked</pdx-button>
    </div>
  </section>
\`,
});
"
`;

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-overlay-stack/demo-comp-overlay-stack-confirm.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';
import { dialog } from '@pdxui/ui/dialog';

component('pdx-demo-comp-overlay-stack-confirm', {
  props: {},
  setup(ctx) {
    const __confirmResult = signal('(none)', { name: 'demo-comp-overlay-stack-confirm:confirmResult' });
async function onConfirm() {
        const result = await dialog.confirm({
            title: 'Save Changes?',
            message: 'You have unsaved changes. Do you want to save before leaving?',
            confirmLabel: 'Save',
            cancelLabel: 'Discard',
        });
        __confirmResult.set(result ? 'true (confirmed)' : 'false (cancelled)');
    }
    return { confirmResult: __confirmResult, onConfirm };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Programmatic Confirm</h2>
    <p class="pdx-txt-small pdx-ink-muted">Returns <code>true</code> (Confirm) or <code>false</code> (Cancel / Escape).</p>
    <div class="demo-row">
      <pdx-button variant="outline" size="sm" @click=\${safeHandler(ctx.onConfirm, ctx.el?.tagName?.toLowerCase(), 'click')}>dialog.confirm()</pdx-button>
      <span class="pdx-txt-small pdx-ink-muted">Result: \${ctx.confirmResult}</span>
    </div>
  </section>
\`,
});
"
`;


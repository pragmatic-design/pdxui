        const c = overlayStack.count();
        __topName.set(overlayStack.top() ?? 'none');
    });
    onDestroy(() => { d1(); d2(); d3(); });
});
    ctx.el.setAttribute('data-pdx-bohzvf', '');
    return { count: __count, modals: __modals, topName: __topName, logText: __logText, counter, log, overlayEls, createVisibleOverlay, removeOverlay, pushTooltip, pushDialog, popTopTooltip, popTopDialog, popAllTooltips, popAllDialogs, popAll, portalDispose, showPortal, hidePortal, bdDispose, showBdPlain, showBdBlur, showBd, bsResult, openBottomSheet, openNested };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Overlay System</h2>
    <p class="desc">Z-stack LIFO, portal, backdrop, Escape dismiss, body scroll lock.</p>

    <section>
      <h3>Stack Management</h3>
      <p class="desc">Push creates a visible overlay. Escape closes the top one. Modal blocks scrolling.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.pushTooltip, ctx.el?.tagName?.toLowerCase(), 'click')}>Push Tooltip</button>
        <button class="pdx-primary" @click=\${safeHandler(ctx.pushDialog, ctx.el?.tagName?.toLowerCase(), 'click')}>Push Dialog (modal)</button>
      </div>
      <div class="row">
        <button class="pdx-secondary" @click=\${safeHandler(ctx.popTopTooltip, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop Tooltip</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.popTopDialog, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop Dialog</button>
        <button class="pdx-ghost" @click=\${safeHandler(ctx.popAllTooltips, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop All Tooltips</button>
        <button class="pdx-ghost" @click=\${safeHandler(ctx.popAllDialogs, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop All Dialogs</button>
        <button class="pdx-ghost" @click=\${safeHandler(ctx.popAll, ctx.el?.tagName?.toLowerCase(), 'click')}>Pop All</button>
      </div>
      <div class="stats">
        <span>Count: <strong>\${ctx.count}</strong></span>
        <span>Modal: <strong>\${ctx.modals}</strong></span>
        <span>Top: <strong>\${ctx.topName}</strong></span>
      </div>
      <pre class="log">\${ctx.logText}</pre>
    </section>

    <section>
      <h3>Portal</h3>
      <p class="desc">Render content into document.body. Click to create/remove.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.showPortal, ctx.el?.tagName?.toLowerCase(), 'click')}>Create Portal</button>
        <button class="pdx-danger" @click=\${safeHandler(ctx.hidePortal, ctx.el?.tagName?.toLowerCase(), 'click')}>Remove Portal</button>
      </div>
    </section>

    <section>
      <h3>Backdrop</h3>
      <p class="desc">Dark overlay. Click backdrop to dismiss. Blur variant adds glassmorphism.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.showBdPlain, ctx.el?.tagName?.toLowerCase(), 'click')}>Backdrop</button>
        <button class="pdx-primary" @click=\${safeHandler(ctx.showBdBlur, ctx.el?.tagName?.toLowerCase(), 'click')}>Backdrop + Blur</button>
      </div>
    </section>

    <section>
      <h3>Bottom Sheet</h3>
      <p class="desc">Mobile-optimized overlay. Draggable between detent points (50% / 100%). Swipe below threshold to dismiss.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.openBottomSheet, ctx.el?.tagName?.toLowerCase(), 'click')}>Open Bottom Sheet</button>
      </div>
    </section>

    <section>
      <h3>Nested Overlays</h3>
      <p class="desc">Opens dialog (modal) then tooltip on top. Escape closes topmost only.</p>
      <button class="pdx-primary" @click=\${safeHandler(ctx.openNested, ctx.el?.tagName?.toLowerCase(), 'click')}>Open Nested Demo</button>
    </section>
  </div>
\`,
});
"
`;


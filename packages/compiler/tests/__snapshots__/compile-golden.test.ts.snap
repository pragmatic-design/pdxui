exports[`compile golden — demo corpus > task-store.pdx 1`] = `
"// 0 warning(s)

============================================================
import { computed, createGlobalStore, signal } from '@pdxui/core';

const __store_tasks = createGlobalStore('tasks', () => {
    const __items = signal([], { name: 'task-store:items' });
    const __filter = signal('all', { name: 'task-store:filter' });
function addTask(text) {
      __items.set(prev => [...prev, { id: Date.now(), text, done: false }]);
    }
    
    function toggleTask(id) {
      __items.set(prev => prev.map(t => t.id === id ? { ...t, done: !t.done } : t));
    }
    
    function removeTask(id) {
      __items.set(prev => prev.filter(t => t.id !== id));
    }
    
    function clearDone() {
      __items.set(prev => prev.filter(t => !t.done));
    }
    const filtered = computed(() => __filter() === 'all' ? __items()
    : __filter() === 'done' ? __items().filter(t => t.done)
    : __items().filter(t => !t.done), { name: 'task-store:filtered' });
    const stats = computed(() => ({
  total: __items().length,
  done: __items().filter(t => t.done).length,
  pending: __items().filter(t => !t.done).length,
}), { name: 'task-store:stats' });
    return { items: __items, filter: __filter, filtered, stats, addTask, toggleTask, removeTask, clearDone };
}, { persist: 'local' });

export function useTasks() { return __store_tasks; }
"
`;


      <div class="box-b" :ref=\${ctx.boxBRef}>Box B</div>
    </div>
    <button class="pdx-primary" @click=\${safeHandler(ctx.doMeasure, ctx.el?.tagName?.toLowerCase(), 'click')}>Measure</button>
    <pre class="log">\${ctx.measureLog}</pre>
  </section>
\`,
});
"
`;


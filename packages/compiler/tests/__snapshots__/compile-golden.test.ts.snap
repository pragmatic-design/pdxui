"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-9ufwpw");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-9ufwpw"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n[data-pdx-9ufwpw] .demo-row { display: flex; gap: var(--pdx-space-sm); align-items: center; }\\n[data-pdx-9ufwpw] .event-log { margin-top: var(--pdx-space-md); padding: var(--pdx-space-md); border: 1px solid var(--pdx-color-border); border-radius: var(--pdx-radius-md); background: var(--pdx-color-inset); }\\n[data-pdx-9ufwpw] .source-block { margin-top: var(--pdx-space-md); }\\n";
}

component('pdx-demo-comp-bulk-actions-standalone', {
  props: {},
  setup(ctx) {
    const __count = signal(3, { name: 'demo-comp-bulk-actions-standalone:count' });
    const __last = signal('', { name: 'demo-comp-bulk-actions-standalone:last' });
const actions = [
      { key: 'archive', label: 'Archive', icon: 'archive' },
      { key: 'export', label: 'Export', icon: 'download', disabled: true, disabledReason: 'Your role cannot export' },
      { key: 'delete', label: 'Delete', icon: 'trash', tone: 'danger' },
    ];
    
    
    
    
    
    function inc() { __count.set(prev => prev + 1); }
    function dec() { __count.set(prev => prev > 0 ? prev - 1 : 0); }
    function onAction(e) { __last.set('pdx-action: ' + e.detail.key); }
    function onClear() { __count.set(0); __last.set('pdx-clear'); }
    ctx.el.setAttribute('data-pdx-9ufwpw', '');
    return { actions, count: __count, last: __last, inc, dec, onAction, onClear };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Standalone bar</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Adjust the selection count to show/hide the bar; click an action or clear.
    </p>

    <div class="demo-row">
      <button class="pdx-outline" @click=\${safeHandler(ctx.dec, ctx.el?.tagName?.toLowerCase(), 'click')}>−</button>
      <span class="pdx-txt-body" style="min-width: 7ch; text-align: center;">\${ctx.count} selected</span>
      <button class="pdx-outline" @click=\${safeHandler(ctx.inc, ctx.el?.tagName?.toLowerCase(), 'click')}>+</button>
    </div>

    <div style="margin-top: var(--pdx-space-md);">
      <pdx-bulk-actions :count=\${ctx.count} :actions=\${() => ctx.actions} @pdx-action=\${safeHandler(ctx.onAction, ctx.el?.tagName?.toLowerCase(), 'pdx-action')} @pdx-clear=\${safeHandler(ctx.onClear, ctx.el?.tagName?.toLowerCase(), 'pdx-clear')}></pdx-bulk-actions>
    </div>

    <div class="event-log" :show=\${() => ctx.last() !== ''}>
      <strong class="pdx-txt-small">Last action</strong>
      <div class="pdx-txt-mono pdx-txt-small pdx-ink-muted" style="margin-top: 6px;">\${ctx.last}</div>
    </div>

    <p class="pdx-txt-small pdx-ink-muted" style="margin-top: var(--pdx-space-md);">
      <strong>Export</strong> is an action this role may not perform. It is offered and refused
      rather than withheld: an action that merely vanishes is indistinguishable from one nobody
      wrote. The button is <code>aria-disabled</code> — not <code>disabled</code>, so it stays in
      the tab order and a screen reader can reach the reason, which is read as its description.
    </p>

    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>const actions = [
  { key: 'archive', label: 'Archive', icon: 'archive' },
  { key: 'export', label: 'Export', icon: 'download',
    disabled: true, disabledReason: 'Your role cannot export' },
  { key: 'delete', label: 'Delete', icon: 'trash', tone: 'danger' },
];

&lt;pdx-bulk-actions :count="count" :actions="actions"
  @pdx-action="onAction" @pdx-clear="onClear" /&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


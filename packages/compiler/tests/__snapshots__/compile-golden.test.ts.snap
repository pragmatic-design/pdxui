          <div class="form-grid-2">
            <pdx-form-field name="billing.vat" label="VAT number" :error=\${() => ctx.profileForm.fields['billing.vat']?.error()} :touched=\${() => ctx.profileForm.fields['billing.vat']?.touched()} :warning=\${() => ctx.profileForm.fields['billing.vat']?.warning()}>
              <pdx-input name="billing.vat" @pdx-input=\${(e) => ctx.profileForm.fields['billing.vat']?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.profileForm.fields['billing.vat']?.onBlur()}></pdx-input>
            </pdx-form-field>

exports[`compile golden — demo corpus > infra/demo-a11y.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createLiveRegion, effect, html, onDestroy, onMount, safeHandler, signal, useActiveDescendant, useRovingTabindex } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-oibbx5");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-oibbx5"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-oibbx5] .demo { max-width: 600px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-oibbx5] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-oibbx5] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-oibbx5] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-oibbx5] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-oibbx5] .row { display: flex; gap: 8px; }\\n  [data-pdx-oibbx5] .input { padding: 8px 12px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 0.9rem; width: 100%; box-sizing: border-box; }\\n  [data-pdx-oibbx5] .listbox { list-style: none; padding: 0; margin: 8px 0 0; border: 1px solid #e0e0e0; border-radius: 6px; max-height: 160px; overflow-y: auto; }\\n  [data-pdx-oibbx5] .listbox li { padding: 8px 12px; cursor: pointer; font-size: 0.9rem; }\\n  [data-pdx-oibbx5] .listbox li:hover { background: #f5f5f7; }\\n  [data-pdx-oibbx5] .listbox li[data-active] { background: #3b82f6; color: white; }\\n  [data-pdx-oibbx5] .toolbar { display: flex; gap: 4px; padding: 8px; border: 1px solid #e0e0e0; border-radius: 8px; margin-top: 8px; }\\n  [data-pdx-oibbx5] .toolbar button { padding: 6px 14px; border: 1px solid #e0e0e0; border-radius: 6px; background: white; cursor: pointer; font-size: 0.85rem; }\\n  [data-pdx-oibbx5] .toolbar button:focus { outline: 2px solid #3b82f6; outline-offset: 2px; }\\n  [data-pdx-oibbx5] .toolbar button[aria-disabled=\\"true\\"] { opacity: 0.4; cursor: not-allowed; }\\n  [data-pdx-oibbx5] .log { font-size: 0.85rem; margin-top: 8px; }\\n";
}

component('pdx-demo-a11y', {
  props: {},
  setup(ctx) {
    const __adActiveId = signal('', { name: 'demo-a11y:adActiveId' });
    const __adSelected = signal('none', { name: 'demo-a11y:adSelected' });
    const __rovingIndex = signal(0, { name: 'demo-a11y:rovingIndex' });
    const __liveMsg = signal('', { name: 'demo-a11y:liveMsg' });
    const __adInputRef = signal(null, { name: 'demo-a11y:adInputRef' });
    const __adListRef = signal(null, { name: 'demo-a11y:adListRef' });
    const __rovingRef = signal(null, { name: 'demo-a11y:rovingRef' });
// Active Descendant
    const ad = useActiveDescendant(() => __adInputRef(), () => __adListRef(), {
        onActiveChange: function(id) { __adActiveId.set(id || ''); },
        onSelect: function(id, idx) {
            var items = __adListRef() ? __adListRef().querySelectorAll('[role="option"]') : [];
            __adSelected.set(items[idx] ? items[idx].textContent : '');
        },
    });
    
    
    // Roving Tabindex
    const roving = useRovingTabindex(() => __rovingRef(), {
        orientation: 'horizontal',
        onActiveChange: function(el, idx) { __rovingIndex.set(idx); },
    });
    
    
    // Live Region
    const live = createLiveRegion();
    
    let announceN = 1;
    
    
    function announcePolite() {
        var msg = 'Item saved successfully #' + announceN++;
        live.announce(msg, 'polite');
        __liveMsg.set(msg);
    }
    function announceAssertive() {
        var msg = 'Error: connection lost #' + announceN++;
        live.announce(msg, 'assertive');
        __liveMsg.set(msg);
    }
    function clearLive() { live.clear(); __liveMsg.set('cleared'); }
    onMount(() => {
    onDestroy(() => { ad.dispose(); roving.dispose(); live.dispose(); });
});
    ctx.el.setAttribute('data-pdx-oibbx5', '');
    return { adActiveId: __adActiveId, adSelected: __adSelected, rovingIndex: __rovingIndex, liveMsg: __liveMsg, adInputRef: __adInputRef, adListRef: __adListRef, rovingRef: __rovingRef, ad, roving, live, announceN, announcePolite, announceAssertive, clearLive };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Advanced Accessibility</h2>
    <p class="desc">Active Descendant, Roving Tabindex, Live Region — three a11y primitives.</p>

    <!-- Active Descendant -->
    <section>
      <h3>Active Descendant (Combobox pattern)</h3>
      <p class="desc">Type in the input. Arrow keys navigate the list. Enter selects. Escape clears.</p>
      <input type="text" :ref=\${ctx.adInputRef} role="combobox" aria-expanded="true" :aria-activedescendant=\${ctx.adActiveId} autocomplete="off" class="input" placeholder="Search fruits..." />
      <ul class="listbox" :ref=\${ctx.adListRef} role="listbox">
        <li role="option" id="fruit-0">Apple</li>
        <li role="option" id="fruit-1">Banana</li>
        <li role="option" id="fruit-2">Cherry</li>
        <li role="option" id="fruit-3">Date</li>
        <li role="option" id="fruit-4">Elderberry</li>
        <li role="option" id="fruit-5">Fig</li>
        <li role="option" id="fruit-6">Grape</li>
      </ul>
      <div class="log">Active: <strong>\${ctx.adActiveId}</strong> | Selected: <strong>\${ctx.adSelected}</strong></div>
    </section>

    <!-- Roving Tabindex -->
    <section>
      <h3>Roving Tabindex (Toolbar pattern)</h3>
      <p class="desc">Tab into the toolbar, then Arrow keys to navigate. Only the active button is tab-focusable.</p>
      <div class="toolbar" :ref=\${ctx.rovingRef} role="toolbar" aria-label="Formatting">
        <button role="tab">Bold</button>
        <button role="tab">Italic</button>
        <button role="tab">Underline</button>
        <button role="tab" aria-disabled="true">Strikethrough (disabled)</button>
        <button role="tab">Code</button>
      </div>
      <div class="log">Active index: <strong>\${ctx.rovingIndex}</strong></div>
    </section>

    <!-- Live Region -->
    <section>
      <h3>Live Region (Screen Reader)</h3>
      <p class="desc">Click buttons to announce messages. Check with a screen reader or inspect the DOM for aria-live elements.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.announcePolite, ctx.el?.tagName?.toLowerCase(), 'click')}>Announce (polite)</button>
        <button @click=\${safeHandler(ctx.announceAssertive, ctx.el?.tagName?.toLowerCase(), 'click')} style="background:#ef4444;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Announce (assertive)</button>
        <button @click=\${safeHandler(ctx.clearLive, ctx.el?.tagName?.toLowerCase(), 'click')} style="background:#666;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Clear</button>
      </div>
      <div class="log">Last: <strong>\${ctx.liveMsg}</strong></div>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > infra/demo-atoms.pdx 1`] = `

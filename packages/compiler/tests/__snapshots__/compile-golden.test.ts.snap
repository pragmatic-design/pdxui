        </pdx-form-field>
        <pdx-form-field name="email" label="Email" required :error=\${() => ctx.asyncForm.fields.email?.error()} :touched=\${() => ctx.asyncForm.fields.email?.touched()} :warning=\${() => ctx.asyncForm.fields.email?.warning()}>
          <pdx-input name="email" type="email" placeholder="Also async-checked" @pdx-input=\${(e) => ctx.asyncForm.fields.email?.onChange(e.detail?.value ?? e.target?.value)} @pdx-blur=\${() => ctx.asyncForm.fields.email?.onBlur()}></pdx-input>
        </pdx-form-field>
      </pdx-form>
      <p class="pdx-txt-small pdx-ink-muted" style="margin-top: var(--pdx-space-sm)">
        Reserved names: <code>admin</code>, <code>root</code>, <code>test</code>. Try them to see async error.
      </p>

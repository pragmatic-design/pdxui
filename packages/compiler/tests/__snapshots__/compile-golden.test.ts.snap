component('pdx-demo-comp-form-advanced-nested-forms', {
  props: {},
  setup(ctx) {
    const __nestedStatus = signal('Ready', { name: 'demo-comp-form-advanced-nested-forms:nestedStatus' });
// ─── 7. Nested Forms (Coordinator) ───
    const coordinator = createFormCoordinator();
    
    
    const customerForm = createForm({ initialValues: { name: '', email: '' }, validators: { name: [required('Name is required')], email: [required('Email is required'), email('Invalid email')] } });
    
    const shippingForm = createForm({ initialValues: { address: '', city: '', zip: '' }, validators: { address: [required('Address is required')], city: [required('City is required')], zip: [required('ZIP is required')] } });
    
    
    
    function submitAllNested() { coordinator.validateAll().then(valid => { __nestedStatus.set(valid ? 'All valid — order submitted!' : 'Fix errors above'); }); }
    function nestedStatusText() { return __nestedStatus(); }
    function nestedStatusClass() { return 'form-status-badge' + (__nestedStatus().includes('submitted') ? ' success' : __nestedStatus().includes('Fix') ? ' error' : ''); }
    
    coordinator.register('customer', customerForm);
    
    coordinator.register('shipping', shippingForm);
    ctx.el.setAttribute('data-pdx-ukmnb4', '');
    return { coordinator, customerForm, shippingForm, nestedStatus: __nestedStatus, submitAllNested, nestedStatusText, nestedStatusClass };
  },
  render: (ctx) => html\`

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-image/demo-comp-image-authenticated.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, signal } from '@pdxui/core';

component('pdx-demo-comp-image-authenticated', {
  props: {},
  setup(ctx) {
    const __authLog = signal('Waiting for auth fetch...', { name: 'demo-comp-image-authenticated:authLog' });
const authFetchFn = function(url) {
        __authLog.set('Fetching with auth: Authorization: Bearer fake-jwt-...');
        return new Promise(function(resolve) {
            setTimeout(function() {
                fetch(url).then(function(r) { return r.blob(); }).then(function(blob) {
                    __authLog.set('Auth fetch complete. Token: Bearer fake-jwt-12345');
                    resolve(blob);
                });
            }, 1000);
        });
    };
    return { authLog: __authLog, authFetchFn };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">Authenticated Image</h2>
    <p class="pdx-txt-small pdx-ink-muted">Uses <code>:fetch-fn</code> to load images from protected endpoints. The function adds JWT headers and returns a Blob. Below: simulated auth fetch with a 1s delay (same-origin in production).</p>
    <div class="demo-row">
      <pdx-image src="/demo-images/city.svg" alt="Authenticated" width="300px" height="200px" :fetch-fn=\${() => ctx.authFetchFn} :lazy=\${false}></pdx-image>
    </div>
    <div class="event-log pdx-txt-mono pdx-txt-small" id="auth-log">\${ctx.authLog}</div>
    <details class="source-block">
      <summary>Source</summary>
      <pre class="pdx-txt-mono"><code>// Production: fetch with JWT headers
function authFetch(url) {
  return fetch(url, {
    headers: { Authorization: 'Bearer ' + getToken() }
  }).then(r =&gt; r.blob());
}

&lt;pdx-image src="/api/images/123"
  :fetch-fn="authFetch"&gt;
&lt;/pdx-image&gt;

// Or use auth-src + auth-provider:
&lt;pdx-image auth-src="/api/images/123"
  :auth-provider="() =&gt; ({ Authorization: 'Bearer ...' })"&gt;
&lt;/pdx-image&gt;</code></pre>
    </details>
  </section>
\`,
});
"
`;


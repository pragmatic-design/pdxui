  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-drx6xh"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-drx6xh] .demo { max-width: 700px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-drx6xh] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-drx6xh] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-drx6xh] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-drx6xh] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-drx6xh] .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\\n  [data-pdx-drx6xh] .input { padding: 6px 10px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 0.9rem; width: 200px; }\\n  [data-pdx-drx6xh] .log { font-size: 0.85rem; margin-top: 8px; display: flex; gap: 16px; flex-wrap: wrap; }\\n\\n  \\n  [data-pdx-drx6xh] .split-container { display: flex; height: 120px; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; margin-top: 8px; }\\n  [data-pdx-drx6xh] .split-left { width: 200px; background: #eff6ff; flex-shrink: 0; overflow: hidden; }\\n  [data-pdx-drx6xh] .split-handle { width: 6px; background: #d0d0d0; cursor: col-resize; flex-shrink: 0; transition: background 150ms; }\\n  [data-pdx-drx6xh] .split-handle:hover { background: #3b82f6; }\\n  [data-pdx-drx6xh] .split-right { flex: 1; background: #f9f9f9; }\\n  [data-pdx-drx6xh] .panel-content { padding: 16px; font-size: 0.85rem; color: #666; }\\n\\n  \\n  [data-pdx-drx6xh] .toast-container { display: flex; flex-direction: column; gap: 6px; margin-top: 8px; min-height: 40px; }\\n  [data-pdx-drx6xh] .toast-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-radius: 6px; font-size: 0.85rem; animation: slideIn 200ms ease; }\\n  [data-pdx-drx6xh] .toast-info { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; }\\n  [data-pdx-drx6xh] .toast-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }\\n  [data-pdx-drx6xh] .toast-warning { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }\\n  [data-pdx-drx6xh] .toast-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }\\n  [data-pdx-drx6xh] .toast-dismiss { background: none; border: none; cursor: pointer; font-size: 1.2rem; opacity: 0.5; padding: 0 4px; }\\n  [data-pdx-drx6xh] .toast-dismiss:hover { opacity: 1; }\\n  @keyframes slideIn { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }\\n";

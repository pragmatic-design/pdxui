============================================================
import { component, html, safeHandler, signal, when } from '@pdxui/core';
import { useTheme } from './theme-store.pdx';

{
  let __pdx_style = document.getElementById("pdx-s-j826xt");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-j826xt"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-j826xt] .shell { display: grid; grid-template-columns: 200px 1fr; grid-template-rows: 48px 1fr; height: 100vh; overflow: hidden; }\\n  [data-pdx-j826xt] .topbar { grid-column: 1 / -1; display: flex; align-items: center; padding: 0 16px; background: var(--pdx-color-surface, white); border-bottom: 1px solid var(--pdx-color-border, #e0e0e0); z-index: 10; }\\n  [data-pdx-j826xt] .brand { font-weight: 700; font-size: 0.9rem; flex: 1; }\\n  [data-pdx-j826xt] .topbar-controls { display: flex; gap: 8px; align-items: center; }\\n  [data-pdx-j826xt] .topbar-controls select, [data-pdx-j826xt] .topbar-controls button { font-size: 0.8rem; padding: 4px 10px; border-radius: 4px; border: 1px solid var(--pdx-color-border, #ddd); background: var(--pdx-color-surface, white); color: var(--pdx-color-text, #333); cursor: pointer; }\\n  [data-pdx-j826xt] .topbar-controls button.active { background: var(--pdx-color-primary, #3b82f6); color: white; border-color: transparent; }\\n  [data-pdx-j826xt] .sidebar { overflow-y: auto; padding: 8px 0; background: var(--pdx-color-surface, white); border-right: 1px solid var(--pdx-color-border, #e0e0e0); }\\n  [data-pdx-j826xt] .nav-group { padding: 12px 14px 4px; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pdx-color-muted, #999); }\\n  [data-pdx-j826xt] .sidebar button { display: block; width: 100%; text-align: left; padding: 6px 14px; font-size: 0.82rem; border: none; background: none; color: var(--pdx-color-text, #333); cursor: pointer; border-left: 3px solid transparent; }\\n  [data-pdx-j826xt] .sidebar button:hover { background: var(--pdx-color-inset, #f5f5f7); }\\n  [data-pdx-j826xt] .sidebar button.nav-active { border-left-color: var(--pdx-color-primary, #3b82f6); color: var(--pdx-color-primary, #3b82f6); font-weight: 600; background: var(--pdx-color-inset, #f5f5f7); }\\n  [data-pdx-j826xt] .content { overflow-y: auto; padding: 24px 32px; background: var(--pdx-color-bg, #f5f5f7); }\\n";
}

component('pdx-app-shell', {
  props: {},
  setup(ctx) {
    const __activePage = signal('button', { name: 'app-shell:activePage' });
    const __isDark = signal(false, { name: 'app-shell:isDark' });
const store = useTheme();
    
    
    
    
    function showPage(name) { __activePage.set(name); }
    
    function onThemeChange(e) { store.setTheme(e.target.value); }
    function onDarkToggle() {
        store.toggleDark();
        __isDark.set(prev => !prev);
    }
    ctx.el.setAttribute('data-pdx-j826xt', '');
    return { store, activePage: __activePage, isDark: __isDark, showPage, onThemeChange, onDarkToggle };
  },
  render: (ctx) => html\`
  <div class="shell">
    <header class="topbar">
      <span class="brand">PDX Components</span>
      <div class="topbar-controls">
        <select @change=\${safeHandler(ctx.onThemeChange, ctx.el?.tagName?.toLowerCase(), 'change')}>
          <option value="neutral">Neutral</option>
          <option value="material">Material</option>
          <option value="fluent">Fluent</option>
          <option value="cupertino">Cupertino</option>
          <option value="pragmatic">Pragmatic</option>
          <option value="corporate">Corporate</option>
          <option value="playful">Playful</option>
          <option value="cyberpunk">Cyberpunk</option>
          <option value="editorial">Editorial</option>
        </select>
        <button @click=\${safeHandler(ctx.onDarkToggle, ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.isDark() ? 'active' : ''}>
          \${when(() => ctx.isDark(), () => html\` ☀️ Light \`, () => html\` 🌙 Dark \`)}
        </button>
      </div>
    </header>

    <nav class="sidebar">
      <div class="nav-group">Atoms</div>
      <button @click=\${safeHandler(() => ctx.showPage('button'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.activePage() === 'button' ? 'nav-active' : ''}>Button</button>
      <button @click=\${safeHandler(() => ctx.showPage('badge'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.activePage() === 'badge' ? 'nav-active' : ''}>Badge</button>
      <div class="nav-group">Inputs</div>
      <button @click=\${safeHandler(() => ctx.showPage('input'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.activePage() === 'input' ? 'nav-active' : ''}>Input</button>
      <div class="nav-group">Overlay</div>
      <button @click=\${safeHandler(() => ctx.showPage('dialog'), ctx.el?.tagName?.toLowerCase(), 'click')} :class=\${() => ctx.activePage() === 'dialog' ? 'nav-active' : ''}>Dialog</button>
    </nav>

    <main class="content">
      \${when(() => ctx.activePage() === 'button', () => html\`
        <pdx-page-button></pdx-page-button>
      \`, () => html\`\${when(() => ctx.activePage() === 'badge', () => html\`
        <pdx-page-badge></pdx-page-badge>
      \`, () => html\`\${when(() => ctx.activePage() === 'input', () => html\`
        <pdx-page-input></pdx-page-input>
      \`, () => html\`\${when(() => ctx.activePage() === 'dialog', () => html\`
        <pdx-page-dialog></pdx-page-dialog>
      \`, null)}\`)}\`)}\`)}</main>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > pdx-showcase/pages/page-badge.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal, useHead } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-4qwklb");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-4qwklb"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-4qwklb] .page { max-width: 680px; }\\n  [data-pdx-4qwklb] h2 { font-size: 1.3rem; font-weight: 700; margin: 0 0 4px; }\\n  [data-pdx-4qwklb] h3 { font-size: 0.9rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-4qwklb] .desc { font-size: 0.82rem; color: var(--pdx-color-muted, #999); margin: 0 0 20px; }\\n  [data-pdx-4qwklb] .hint { font-size: 0.75rem; color: var(--pdx-color-muted, #aaa); margin: 0 0 8px; }\\n  [data-pdx-4qwklb] section { margin-bottom: 24px; padding: 16px; border: 1px solid var(--pdx-color-border, #e0e0e0); border-radius: var(--pdx-radius-md, 8px); background: var(--pdx-color-surface, white); }\\n  [data-pdx-4qwklb] .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\\n";
}

component('pdx-page-badge', {
  props: {},
  setup(ctx) {
    const __badgeCount = signal(5, { name: 'page-badge:badgeCount' });
function increment() { __badgeCount.set(__v => __v + 1); }
    function decrement() { if (__badgeCount() > 0) __badgeCount.set(__v => __v - 1); }
    useHead({ title: "Badge — PDX Components" });
    ctx.el.setAttribute('data-pdx-4qwklb', '');
    return { badgeCount: __badgeCount, increment, decrement };
  },
  render: (ctx) => html\`
  <div class="page">
    <h2>Badge</h2>
    <p class="desc">Inline status indicator — count, dot, or capped. Click buttons to change count.</p>

    <section>
      <h3>Live Counter</h3>
      <p class="hint">Click + / - to change the badge count.</p>
      <div class="row">
        <button class="pdx-secondary" size="sm" @click=\${safeHandler(ctx.decrement, ctx.el?.tagName?.toLowerCase(), 'click')}>−</button>
        <span class="pdx-badge pdx-badge-primary">\${ctx.badgeCount}</span>
        <button class="pdx-secondary" size="sm" @click=\${safeHandler(ctx.increment, ctx.el?.tagName?.toLowerCase(), 'click')}>+</button>
        <span style="margin-left:16px">
          <span class="pdx-badge pdx-badge-danger">\${() => ctx.badgeCount() > 99 ? '99+' : ctx.badgeCount()}</span>
          (capped)
        </span>
      </div>
    </section>

    <section>
      <h3>Variants</h3>
      <div class="row">
        <span class="pdx-badge pdx-badge-primary">5</span>
        <span class="pdx-badge pdx-badge-success">12</span>
        <span class="pdx-badge pdx-badge-danger">3</span>
        <span class="pdx-badge pdx-badge-warning">7</span>
        <span class="pdx-badge pdx-badge-secondary">0</span>
      </div>
    </section>

    <section>
      <h3>Status Dots</h3>
      <div class="row" style="gap:16px">
        <span>Online <span class="pdx-dot pdx-dot-success pdx-dot-pulse"></span></span>
        <span>Busy <span class="pdx-dot pdx-dot-danger"></span></span>
        <span>Away <span class="pdx-dot pdx-dot-warning"></span></span>
        <span>Offline <span class="pdx-dot pdx-dot-muted"></span></span>
      </div>
    </section>
  </div>
\`,
});


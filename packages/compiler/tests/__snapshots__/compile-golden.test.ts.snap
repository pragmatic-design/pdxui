    ctx.el.setAttribute('data-pdx-63mwmw', '');

  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading section-heading">A Type per Level</h2>
    <p class="pdx-txt-small pdx-ink-muted">
      Custom properties on the menu, for levels 1 to 3 (the third stands for every deeper one). Here: categories bold,
      sub-groups muted, the third level smaller and further in.
    </p>
    <div class="demo-sidebar">
      <pdx-nav-menu class="tree-look" :items=\${nestedItems} activekey="users" size="sm" indicator="border"></pdx-nav-menu>

exports[`compile golden — demo corpus > showcase-new/pages/sections/comp-chart-advanced/demo-comp-chart-advanced-dynamic.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-do8btg");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-do8btg"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-do8btg] .controls { display: flex; gap: var(--pdx-space-sm); margin-top: var(--pdx-space-md); }\\n";
}

component('pdx-demo-comp-chart-advanced-dynamic', {
  props: {},
  setup(ctx) {
    const __dynamicData = signal([
  { category: 'A', value: 42 },
  { category: 'B', value: 68 },
  { category: 'C', value: 35 },
  { category: 'D', value: 91 },
  { category: 'E', value: 55 },
  { category: 'F', value: 73 },
], { name: 'demo-comp-chart-advanced-dynamic:dynamicData' });
function randomize() {
      __dynamicData.set(prev => prev.map(d => ({ ...d, value: Math.floor(Math.random() * 100) + 10 })));
    }
    ctx.el.setAttribute('data-pdx-do8btg', '');
    return { dynamicData: __dynamicData, randomize };
  },
  render: (ctx) => html\`
  <section>
    <h2 class="pdx-txt-heading">Dynamic Data</h2>
    <p class="pdx-txt-small pdx-ink-muted">Click "Randomize" to see animated data transitions.</p>

    <div class="demo-area">
      <pdx-chart type="bar" :data=\${ctx.dynamicData} :x-field=\${() => 'category'} :y-field=\${() => 'value'} :legend=\${false} height="280px"></pdx-chart>
    </div>
    <div class="controls">
      <button class="pdx-primary" @click=\${safeHandler(ctx.randomize, ctx.el?.tagName?.toLowerCase(), 'click')}>Randomize Data</button>
    </div>
  </section>
\`,
});
"
`;


  __pdx_style.textContent = "\\n  [data-pdx-mq836r] .stats { display: flex; gap: 20px; font-size: 0.9rem; }\\n  [data-pdx-mq836r] .log { font-family: monospace; font-size: 0.75rem; background: var(--pdx-color-inset); padding: 8px; border-radius: 6px; max-height: 120px; overflow-y: auto; white-space: pre-wrap; margin: 8px 0 0; min-height: 30px; }\\n";
}

component('pdx-demo-infra-overlay-stack', {
  props: {},
  setup(ctx) {
    const __count = signal(0, { name: 'demo-infra-overlay-stack:count' });
    const __modals = signal(0, { name: 'demo-infra-overlay-stack:modals' });
    const __topName = signal('none', { name: 'demo-infra-overlay-stack:topName' });
// The log, the overlay ids and the stack operations are shared with the other sections (state.pdx.ts).
    const overlayDemo = useOverlayDemo();
    const logText = computed(() => overlayDemo.logText(), { name: 'demo-infra-overlay-stack:logText' });
    
    
    function pushTooltip() { overlayDemo.pushTooltip(); }
    function pushDialog() { overlayDemo.pushDialog(); }
    function popTopTooltip() { overlayDemo.popTopTooltip(); }
    function popTopDialog() { overlayDemo.popTopDialog(); }
    function popAllTooltips() { overlayDemo.popAllTooltips(); }
    function popAllDialogs() { overlayDemo.popAllDialogs(); }
    function popAll() { overlayDemo.popAll(); }
    onMount(() => {
    const d1 = effect(() => { __count.set(overlayStack.count()); });
    const d2 = effect(() => { __modals.set(overlayStack.modalCount()); });
    const d3 = effect(() => {
        // Read the stack reactively
        const c = overlayStack.count();
        __topName.set(overlayStack.top() ?? 'none');
    });
    onDestroy(() => { d1(); d2(); d3(); });
});
    ctx.el.setAttribute('data-pdx-mq836r', '');
    return { overlayDemo, logText, pushTooltip, pushDialog, popTopTooltip, popTopDialog, popAllTooltips, popAllDialogs, popAll, count: __count, modals: __modals, topName: __topName };
  },
  render: (ctx) => html\`
  <section>
    <h3>Stack Management</h3>
    <p class="desc">Push creates a visible overlay. Escape closes the top one. Modal locks scrolling.</p>

component('pdx-demo-utilities', {
  props: {},
  setup(ctx) {
    const __clipCopied = signal('', { name: 'demo-utilities:clipCopied' });
    const __clipPasted = signal('', { name: 'demo-utilities:clipPasted' });
    const __clipSupported = signal(false, { name: 'demo-utilities:clipSupported' });
    const __clipInputRef = signal(null, { name: 'demo-utilities:clipInputRef' });
    const __panelSize = signal(200, { name: 'demo-utilities:panelSize' });
    const __panelRef = signal(null, { name: 'demo-utilities:panelRef' });
    const __handleRef = signal(null, { name: 'demo-utilities:handleRef' });
    const __toasts = signal([], { name: 'demo-utilities:toasts' });
    const __toastCount = signal(0, { name: 'demo-utilities:toastCount' });
// ─── Clipboard ────────────────────────
    
    
    
    
    
    const clip = useClipboard({
        onCopy: function(t) { __clipCopied.set(t); },
        onPaste: function(t) { __clipPasted.set(t); },
    });
    
    __clipSupported.set(clip.isSupported);
    
    
    function doCopy() {
        var input = __clipInputRef();
        if (input) clip.copy(input.value);
    }
    function doPaste() { clip.paste(); }
    
    // ─── Resize Handle ────────────────────
    
    
    
    
    const resize = useResizeHandle(() => __handleRef(), () => __panelRef(), {
        direction: 'horizontal',
        min: 100,
        max: 400,
        initialSize: 200,
    });
    
    
    
    
    // ─── Toast Queue ──────────────────────
    
    
    
    const queue = createToastQueue({
        position: 'top-right',
        maxVisible: 5,
        defaultDuration: 3000,
    });
    
    
    let toastN = 1;
    
    function addSuccess() { queue.success('Operation completed #' + toastN++); }
    function addInfo() { queue.info('Something happened #' + toastN++); }
    function addWarning() { queue.warning('Watch out #' + toastN++); }
    function addError() { queue.error('Something went wrong #' + toastN++); }
    function dismissToast(id) { queue.dismiss(id); }
    function clearToasts() { queue.clear(); }
    onMount(() => {
    const d1 = effect(() => {
        var s = resize.size();
        __panelSize.set(Math.round(s));
        var el = __panelRef();
        if (el) el.style.width = s + 'px';
    });
    onDestroy(() => { d1(); resize.dispose(); });
});
    onMount(() => {
    const d2 = effect(() => {
        __toasts.set(queue.items());
        __toastCount.set(queue.count());
    });
    onDestroy(() => { d2(); });
});
    ctx.el.setAttribute('data-pdx-drx6xh', '');
    return { clipCopied: __clipCopied, clipPasted: __clipPasted, clipSupported: __clipSupported, clipInputRef: __clipInputRef, clip, doCopy, doPaste, panelSize: __panelSize, panelRef: __panelRef, handleRef: __handleRef, resize, toasts: __toasts, toastCount: __toastCount, queue, toastN, addSuccess, addInfo, addWarning, addError, dismissToast, clearToasts };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Utility Primitives</h2>
    <p class="desc">Clipboard, Resize Handle, Toast Queue — three small infra primitives.</p>

    <!-- Clipboard -->
    <section>
      <h3>Clipboard API</h3>
      <p class="desc">Signal-based copy/paste. Try copying text, then pasting.</p>
      <div class="row">
        <input type="text" :ref=\${ctx.clipInputRef} value="Hello from PDX!" class="input" />
        <button class="pdx-primary" @click=\${safeHandler(ctx.doCopy, ctx.el?.tagName?.toLowerCase(), 'click')}>Copy</button>
        <button class="pdx-secondary" @click=\${safeHandler(ctx.doPaste, ctx.el?.tagName?.toLowerCase(), 'click')}>Paste</button>
      </div>
      <div class="log">
        <span>Copied: <strong>\${ctx.clipCopied}</strong></span>
        <span>Pasted: <strong>\${ctx.clipPasted}</strong></span>
        <span>Supported: <strong>\${ctx.clipSupported}</strong></span>
      </div>
    </section>

    <!-- Resize Handle -->
    <section>
      <h3>Resize Handle</h3>
      <p class="desc">Drag the vertical grip to resize the left panel. Min: 100px, Max: 400px.</p>
      <div class="split-container">
        <div class="split-left" :ref=\${ctx.panelRef}>
          <div class="panel-content">Left panel (\${ctx.panelSize}px)</div>
        </div>
        <div class="split-handle" :ref=\${ctx.handleRef}></div>
        <div class="split-right">
          <div class="panel-content">Right panel (fills remaining)</div>
        </div>
      </div>
    </section>

    <!-- Toast Queue -->
    <section>
      <h3>Toast Queue</h3>
      <p class="desc">Signal-based notification queue. Click buttons to add toasts. Auto-dismiss after 3s.</p>
      <div class="row">
        <button class="pdx-primary" @click=\${safeHandler(ctx.addSuccess, ctx.el?.tagName?.toLowerCase(), 'click')}>Success</button>
        <button @click=\${safeHandler(ctx.addInfo, ctx.el?.tagName?.toLowerCase(), 'click')}>Info</button>
        <button @click=\${safeHandler(ctx.addWarning, ctx.el?.tagName?.toLowerCase(), 'click')} style="background:#f59e0b;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Warning</button>
        <button @click=\${safeHandler(ctx.addError, ctx.el?.tagName?.toLowerCase(), 'click')} style="background:#ef4444;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Error</button>
        <button @click=\${safeHandler(ctx.clearToasts, ctx.el?.tagName?.toLowerCase(), 'click')} style="background:#666;color:white;border:none;padding:6px 14px;border-radius:6px;cursor:pointer">Clear All</button>
      </div>
      <div class="toast-container">
        \${eachRow(() => ctx.toasts(), 'id', (t) => html\`
          <div class="toast-item" :class=\${() => 'toast-' + t().type}>
            <span>\${() => t().type.toUpperCase()}: \${() => t().message}</span>
            <button class="toast-dismiss" @click=\${safeHandler(() => ctx.dismissToast(t().id), ctx.el?.tagName?.toLowerCase(), 'click')}>×</button>
          </div>
        \`)}</div>
      <div class="log">Count: <strong>\${ctx.toastCount}</strong></div>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > infra/demo-virtualizer.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, createVirtualizer, effect, html, onDestroy, onMount, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-njh8i4");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-njh8i4"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-njh8i4] .demo { max-width: 800px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-njh8i4] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-njh8i4] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-njh8i4] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-njh8i4] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-njh8i4] .stats { display: flex; gap: 24px; font-size: 0.9rem; margin-bottom: 8px; }\\n  [data-pdx-njh8i4] .row { display: flex; gap: 8px; margin-bottom: 8px; }\\n  [data-pdx-njh8i4] .scroll-box { height: 400px; overflow-y: auto; border: 2px solid #e0e0e0; border-radius: 8px; }\\n";
}

{
  let __pdx_style = document.getElementById("pdx-s-njh8i4-1");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-njh8i4-1"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = ".v-item { position: absolute; left: 0; right: 0; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0f0f0; font-size: 0.85rem; }\\n  .v-item:hover { background: #f5f5f7; }\\n  .v-item.even { background: rgba(0,0,0,0.02); }\\n  .v-item .muted { color: #999; font-size: 0.8rem; }";
}

component('pdx-demo-virtualizer', {
  props: {},
  setup(ctx) {
    const __rendered1 = signal(0, { name: 'demo-virtualizer:rendered1' });
    const __totalH1 = signal('0', { name: 'demo-virtualizer:totalH1' });
    const __rendered2 = signal(0, { name: 'demo-virtualizer:rendered2' });
    const __scroll1Ref = signal(null, { name: 'demo-virtualizer:scroll1Ref' });
    const __inner1Ref = signal(null, { name: 'demo-virtualizer:inner1Ref' });
    const __scroll2Ref = signal(null, { name: 'demo-virtualizer:scroll2Ref' });
    const __inner2Ref = signal(null, { name: 'demo-virtualizer:inner2Ref' });
const COUNT1 = 10000;
    
    const COUNT2 = 5000;
    
    const heights2 = Array.from({ length: COUNT2 }, () => 30 + Math.floor(Math.random() * 50));
    
    
    let v1 = null;
    
    let v2 = null;
    
    
    function scrollTop1() { v1?.scrollTo(0); }
    function scrollMid1() { v1?.scrollTo(5000, { align: 'center' }); }
    function scrollEnd1() { v1?.scrollTo(COUNT1 - 1, { align: 'end' }); }
    onMount(() => {
    // Wait a tick for :ref to be set
    requestAnimationFrame(() => {
        const scrollEl1 = __scroll1Ref();
        const innerEl1 = __inner1Ref();
        const scrollEl2 = __scroll2Ref();
        const innerEl2 = __inner2Ref();

        if (scrollEl1 && innerEl1) {
            v1 = createVirtualizer({
                count: () => COUNT1,
                estimateSize: () => 48,
                getScrollElement: () => scrollEl1,
                overscan: 5,
            });

            effect(() => {
                const items = v1.items();
                const total = v1.totalSize();
                __rendered1.set(items.length);
                __totalH1.set((total / 1000).toFixed(0) + 'K px');
                innerEl1.style.height = total + 'px';
                let html = '';
                for (const item of items) {
                    html += '<div class="v-item' + (item.index % 2 === 0 ? ' even' : '') + '" style="height:48px;transform:translateY(' + item.offsetStart + 'px)"><span>#' + item.index + '</span><span class="muted">Item ' + (item.index + 1) + ' / 10,000</span></div>';
                }
                innerEl1.innerHTML = html;
            });
        }

        if (scrollEl2 && innerEl2) {
            v2 = createVirtualizer({
                count: () => COUNT2,
                estimateSize: (i) => heights2[i],
                getScrollElement: () => scrollEl2,
                overscan: 5,
            });

            effect(() => {
                const items = v2.items();
                const total = v2.totalSize();
                __rendered2.set(items.length);
                innerEl2.style.height = total + 'px';
                let html = '';
                for (const item of items) {
                    html += '<div class="v-item' + (item.index % 2 === 0 ? ' even' : '') + '" style="height:' + item.size + 'px;transform:translateY(' + item.offsetStart + 'px)"><span>#' + item.index + '</span><span class="muted">' + item.size + 'px</span></div>';
                }
                innerEl2.innerHTML = html;
            });
        }
    });
});
    ctx.el.setAttribute('data-pdx-njh8i4', '');
    return { rendered1: __rendered1, totalH1: __totalH1, rendered2: __rendered2, scroll1Ref: __scroll1Ref, inner1Ref: __inner1Ref, scroll2Ref: __scroll2Ref, inner2Ref: __inner2Ref, COUNT1, COUNT2, heights2, v1, v2, scrollTop1, scrollMid1, scrollEnd1 };
  },
  render: (ctx) => html\`
  <div class="demo">
    <h2>Virtualization</h2>
    <p class="desc">Render only visible items. 10,000 items, binary search, GPU transforms.</p>

    <section>
      <h3>10,000 Fixed Height Items (48px each)</h3>
      <div class="stats">
        <span>Rendered: <strong>\${ctx.rendered1}</strong> / 10,000</span>
        <span>Total: <strong>\${ctx.totalH1}</strong></span>
      </div>
      <div class="row">
        <button class="pdx-ghost" @click=\${safeHandler(ctx.scrollTop1, ctx.el?.tagName?.toLowerCase(), 'click')}>Top</button>
        <button class="pdx-ghost" @click=\${safeHandler(ctx.scrollMid1, ctx.el?.tagName?.toLowerCase(), 'click')}>#5000</button>
        <button class="pdx-ghost" @click=\${safeHandler(ctx.scrollEnd1, ctx.el?.tagName?.toLowerCase(), 'click')}>End</button>
      </div>
      <div class="scroll-box" :ref=\${ctx.scroll1Ref}>
        <div :ref=\${ctx.inner1Ref} style="position:relative"></div>
      </div>
    </section>

    <section>
      <h3>Variable Heights (5,000 items, 30-80px)</h3>
      <div class="stats">
        <span>Rendered: <strong>\${ctx.rendered2}</strong> / 5,000</span>
      </div>
      <div class="scroll-box" :ref=\${ctx.scroll2Ref}>
        <div :ref=\${ctx.inner2Ref} style="position:relative"></div>
      </div>
    </section>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > paginated-list.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, html, linkedSignal, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-q8y824");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-q8y824"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-q8y824] .paginated { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }\\n  [data-pdx-q8y824] .controls { display: flex; gap: 16px; align-items: center; margin: 8px 0; flex-wrap: wrap; }\\n  [data-pdx-q8y824] .controls label { font-size: 0.85rem; color: #666; display: flex; align-items: center; gap: 6px; }\\n  [data-pdx-q8y824] select { padding: 4px 8px; border: 1px solid #ccc; border-radius: 4px; }\\n  [data-pdx-q8y824] .page-nav { display: flex; align-items: center; gap: 6px; }\\n  [data-pdx-q8y824] .page-num { min-width: 60px; text-align: center; font-weight: bold; }\\n  [data-pdx-q8y824] button { padding: 4px 12px; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; background: #f8f9fa; }\\n  [data-pdx-q8y824] button:hover { background: #e9ecef; }\\n  [data-pdx-q8y824] button:disabled { opacity: 0.4; cursor: not-allowed; }\\n  [data-pdx-q8y824] .info { font-size: 0.85rem; color: #555; margin-top: 8px; padding: 8px; background: #f8f9fa; border-radius: 4px; }\\n";
}

component('pdx-paginated-list', {
  props: {},
  setup(ctx) {
    const __category = signal('Books', { name: 'paginated-list:category' });
const page = linkedSignal({
        source: () => __category(),
        computation: (_cat, prev) => {
          if (prev && prev.source === _cat) return prev.value;
          return 1;
        },
      });
    
    
      function onCategory(e) { __category.set(e.target.value); }
      function prevPage() { if (page() > 1) page.set(page.peek() - 1); }
      function nextPage() { page.set(page.peek() + 1); }
    ctx.el.setAttribute('data-pdx-q8y824', '');
    return { category: __category, page, onCategory, prevPage, nextPage };
  },
  render: (ctx) => html\`
  <div class="paginated">
    <h3>LinkedSignal — Pagination</h3>
    <div class="controls">
      <label>Category
        <select @change=\${safeHandler(ctx.onCategory, ctx.el?.tagName?.toLowerCase(), 'change')}>
          <option value="Books" :selected=\${() => ctx.category() === 'Books'}>Books</option>
          <option value="Movies" :selected=\${() => ctx.category() === 'Movies'}>Movies</option>
          <option value="Music" :selected=\${() => ctx.category() === 'Music'}>Music</option>
        </select>
      </label>
      <div class="page-nav">
        <button @click=\${safeHandler(ctx.prevPage, ctx.el?.tagName?.toLowerCase(), 'click')} :disabled=\${() => ctx.page() <= 1}>←</button>
        <span class="page-num">Page \${() => ctx.page()}</span>
        <button @click=\${safeHandler(ctx.nextPage, ctx.el?.tagName?.toLowerCase(), 'click')}>→</button>
      </div>
    </div>
    <div class="info">
      Category: \${ctx.category} | Page resets to 1 on category change.
    </div>
  </div>
\`,
});
"
`;

exports[`compile golden — demo corpus > pdx-showcase/app-shell.pdx 1`] = `

  },
  render: (ctx) => html\`
  <div class="page">
    <h1 class="pdx-txt-title">Image</h1>
    <p class="pdx-txt-body pdx-ink-muted intro">
      <code>&lt;pdx-image&gt;</code> — rich image component with lazy loading, fallback, zoom, lightbox, and authenticated image loading.
    </p>

    <!-- Basic -->
    <pdx-demo-comp-image-basic class="demo-section"></pdx-demo-comp-image-basic>

    <!-- Object Fit -->

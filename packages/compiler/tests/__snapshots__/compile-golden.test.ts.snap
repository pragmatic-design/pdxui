  __pdx_style.textContent = "\\n  [data-pdx-oxc18m] .demo { max-width: 700px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-oxc18m] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-oxc18m] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-oxc18m] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-oxc18m] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-oxc18m] .controls { margin-bottom: 8px; }\\n  [data-pdx-oxc18m] .input { padding: 6px 10px; border: 1px solid #e0e0e0; border-radius: 6px; font-size: 0.9rem; width: 250px; }\\n  [data-pdx-oxc18m] .row { display: flex; gap: 8px; align-items: center; }\\n  [data-pdx-oxc18m] .table-wrap { border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; }\\n  [data-pdx-oxc18m] .table-header { display: grid; grid-template-columns: 60px 1fr 1fr; background: #f5f5f7; font-weight: 600; font-size: 0.8rem; text-transform: uppercase; color: #666; }\\n  [data-pdx-oxc18m] .table-header .col { cursor: pointer; }\\n  [data-pdx-oxc18m] .table-header .col:hover { color: #3b82f6; }\\n  [data-pdx-oxc18m] .table-row { display: grid; grid-template-columns: 60px 1fr 1fr; border-top: 1px solid #f0f0f0; }\\n  [data-pdx-oxc18m] .col { padding: 8px 12px; font-size: 0.85rem; }\\n  [data-pdx-oxc18m] .pagination { display: flex; align-items: center; gap: 12px; margin-top: 8px; font-size: 0.85rem; }\\n  [data-pdx-oxc18m] .pagination button { padding: 4px 12px; border: 1px solid #e0e0e0; border-radius: 6px; background: white; cursor: pointer; }\\n  [data-pdx-oxc18m] .pagination button:disabled { opacity: 0.4; cursor: not-allowed; }\\n  [data-pdx-oxc18m] .log { font-size: 0.8rem; margin-top: 8px; font-family: monospace; }\\n";

exports[`compile golden — demo corpus > showcase-new/pages/sections/infra-focus/demo-infra-focus-restore.pdx 1`] = `
"// 0 warning(s)

============================================================
import { component, focusRestore, html, safeHandler, signal } from '@pdxui/core';

component('pdx-demo-infra-focus-restore', {
  props: {},
  setup(ctx) {
    const __restoreInputRef = signal(null, { name: 'demo-infra-focus-restore:restoreInputRef' });
    const __restoreLog = signal('Click a button, then Save Focus.', { name: 'demo-infra-focus-restore:restoreLog' });
const fr = focusRestore();
    
    
    // Track last focused target button so save captures the right element
    let lastTarget = null;
    
    function trackTarget(e) {
        lastTarget = e.currentTarget;
        __restoreLog.set('Focused: "' + e.currentTarget.textContent.trim() + '" — now click Save.');
    }
    
    function saveFocus() {
        if (!lastTarget) { __restoreLog.set('Click a colored button first!'); return; }
        // Temporarily focus the target so fr.save() captures it
        lastTarget.focus();
        fr.save();
        const name = lastTarget.textContent.trim();
        __restoreLog.set('Saved: "' + name + '". Focus moved to input.');
        const input = __restoreInputRef();
        if (input) input.focus();
    }
    
    function restoreFocus() {
        fr.restore();
        const active = document.activeElement;
        const name = active ? (active.textContent || active.tagName).trim() : 'nothing';
        __restoreLog.set(prev => prev + '\\nRestored to: "' + name + '"');
    }
    return { restoreInputRef: __restoreInputRef, restoreLog: __restoreLog, fr, lastTarget, trackTarget, saveFocus, restoreFocus };
  },
  render: (ctx) => html\`
  <section data-test="focus-restore">
    <h3>Focus Restore</h3>
    <p class="desc">1) Click one of the colored buttons to focus it. 2) "Save Focus" saves which button has focus, then moves focus to the input. 3) "Restore Focus" returns to the saved button.</p>
    <div class="row">
      <button class="pdx-primary" data-test="target-a" @click=\${safeHandler(ctx.trackTarget, ctx.el?.tagName?.toLowerCase(), 'click')}>Button A</button>
      <button class="pdx-secondary" data-test="target-b" @click=\${safeHandler(ctx.trackTarget, ctx.el?.tagName?.toLowerCase(), 'click')}>Button B</button>
      <button class="pdx-ghost" data-test="target-c" @click=\${safeHandler(ctx.trackTarget, ctx.el?.tagName?.toLowerCase(), 'click')}>Button C</button>
    </div>
    <div class="row">
      <button class="pdx-primary" @click=\${safeHandler(ctx.saveFocus, ctx.el?.tagName?.toLowerCase(), 'click')} data-test="save-focus">Save Focus</button>
      <button class="pdx-secondary" @click=\${safeHandler(ctx.restoreFocus, ctx.el?.tagName?.toLowerCase(), 'click')} data-test="restore-focus">Restore Focus</button>
      <input class="pdx-input" placeholder="Focus moves here after save..." :ref=\${ctx.restoreInputRef} data-test="other-input" />
    </div>
    <div class="log" data-test="restore-log">\${ctx.restoreLog}</div>
  </section>
\`,
});
"
`;


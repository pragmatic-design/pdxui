}

component('pdx-demo-comp-button-group-composition', {
  props: {},
  setup(ctx) {
// The same alignment and formatting the toggle sections above set.
    const demo = useButtonGroupDemo();
    const formatting = computed(() => demo.formatting(), { name: 'demo-comp-button-group-composition:formatting' });
    const alignment = computed(() => demo.alignment(), { name: 'demo-comp-button-group-composition:alignment' });
    
    
    
    
    function onFormatting(e) { demo.onFormatting(e); }
    function onAlignment(e) { demo.onAlignment(e); }

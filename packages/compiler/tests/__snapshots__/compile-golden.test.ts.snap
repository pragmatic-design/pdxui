  __pdx_style.textContent = "\\n  [data-pdx-m0jy7p] .demo { max-width: 800px; display: flex; flex-direction: column; gap: 20px; }\\n  [data-pdx-m0jy7p] h2 { font-size: 1.5rem; font-weight: 700; margin: 0; }\\n  [data-pdx-m0jy7p] h3 { font-size: 1rem; font-weight: 600; margin: 0 0 8px; }\\n  [data-pdx-m0jy7p] .desc { color: #666; font-size: 0.85rem; margin: 0; }\\n  [data-pdx-m0jy7p] section { padding: 16px; border: 1px solid #e0e0e0; border-radius: 8px; background: white; }\\n  [data-pdx-m0jy7p] .stats { display: flex; gap: 20px; font-size: 0.9rem; margin-top: 8px; }\\n  [data-pdx-m0jy7p] .arena { position: relative; width: 100%; height: 250px; border: 2px dashed #e0e0e0; border-radius: 8px; }\\n  [data-pdx-m0jy7p] .arena-small { position: relative; width: 300px; height: 150px; border: 2px dashed #e0e0e0; border-radius: 8px; }\\n  [data-pdx-m0jy7p] .drag-box { position: absolute; top: 90px; left: calc(50% - 60px); width: 120px; height: 70px; background: #3b82f6; color: white; display: flex; align-items: center; justify-content: center; border-radius: 8px; cursor: grab; user-select: none; touch-action: none; font-weight: 600; }\\n  [data-pdx-m0jy7p] .drag-box:active { cursor: grabbing; opacity: 0.8; }\\n  [data-pdx-m0jy7p] .drag-box-small { position: absolute; top: 40px; left: 100px; width: 100px; height: 50px; background: #8b5cf6; color: white; display: flex; align-items: center; justify-content: center; border-radius: 8px; cursor: grab; user-select: none; touch-action: none; font-size: 0.8rem; font-weight: 600; }\\n  [data-pdx-m0jy7p] .drag-box-small:focus { outline: 3px solid #3b82f6; outline-offset: 2px; }\\n  [data-pdx-m0jy7p] .drag-small { position: absolute; background: #3b82f6; color: white; display: flex; align-items: center; justify-content: center; border-radius: 6px; cursor: grab; user-select: none; touch-action: none; font-size: 0.75rem; font-weight: 600; }\\n  [data-pdx-m0jy7p] .axis-row { display: flex; gap: 24px; align-items: flex-start; margin-top: 8px; }\\n  [data-pdx-m0jy7p] .h-track { width: 300px; height: 50px; border: 2px dashed #e0e0e0; border-radius: 8px; position: relative; }\\n  [data-pdx-m0jy7p] .h-track .drag-small { width: 80px; height: 36px; top: 7px; left: 110px; }\\n  [data-pdx-m0jy7p] .v-track { width: 50px; height: 200px; border: 2px dashed #e0e0e0; border-radius: 8px; position: relative; }\\n  [data-pdx-m0jy7p] .v-track .drag-small { width: 36px; height: 36px; top: 82px; left: 7px; }\\n  [data-pdx-m0jy7p] .zones { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 8px 0; }\\n  [data-pdx-m0jy7p] .zone-label { font-size: 0.75rem; color: #888; font-weight: 600; }\\n  [data-pdx-m0jy7p] .drop-zone { min-height: 140px; border: 2px dashed #e0e0e0; border-radius: 8px; padding: 8px; display: flex; flex-direction: column; gap: 6px; transition: all 200ms; margin-top: 4px; }\\n  [data-pdx-m0jy7p] .drop-zone.over { border-color: #3b82f6; background: #eff6ff; }\\n  [data-pdx-m0jy7p] .card { padding: 10px 14px; background: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 6px; cursor: grab; user-select: none; touch-action: none; font-size: 0.85rem; }\\n  [data-pdx-m0jy7p] .card:active { cursor: grabbing; }\\n  [data-pdx-m0jy7p] .log { font-family: monospace; font-size: 0.75rem; background: #f5f5f7; padding: 8px; border-radius: 6px; max-height: 100px; overflow-y: auto; white-space: pre-wrap; min-height: 30px; margin: 0; }\\n  [data-pdx-m0jy7p] .scroll-list { max-height: 200px; overflow-y: auto; border: 2px dashed #e0e0e0; border-radius: 8px; padding: 4px; margin-top: 8px; }\\n  [data-pdx-m0jy7p] .scroll-item { padding: 10px 14px; background: #f9f9f9; border: 1px solid #e0e0e0; border-radius: 6px; margin: 4px 0; font-size: 0.85rem; }\\n  [data-pdx-m0jy7p] .scroll-item.drag-handle { background: #3b82f6; color: white; cursor: grab; touch-action: none; user-select: none; font-weight: 600; }\\n";
}


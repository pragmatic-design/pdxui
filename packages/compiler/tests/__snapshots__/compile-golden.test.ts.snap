import { component, computed, html, safeHandler, signal } from '@pdxui/core';

{
  let __pdx_style = document.getElementById("pdx-s-tdfsr4");
  if (!__pdx_style) { __pdx_style = document.createElement('style'); __pdx_style.id = "pdx-s-tdfsr4"; document.head.appendChild(__pdx_style); }
  __pdx_style.textContent = "\\n  [data-pdx-tdfsr4] .color-card { background: white; border-radius: 8px; padding: 1rem; box-shadow: 0 1px 4px rgba(0,0,0,0.1); }\\n  [data-pdx-tdfsr4] .preview { padding: 24px; text-align: center; color: white; transition: all 0.2s ease; margin: 8px 0; }\\n  [data-pdx-tdfsr4] .emoji { font-size: 2rem; }\\n  [data-pdx-tdfsr4] .label { margin-top: 6px; font-size: 0.85rem; opacity: 0.9; }\\n  [data-pdx-tdfsr4] .controls { display: flex; flex-direction: column; gap: 6px; }\\n  [data-pdx-tdfsr4] .controls label { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: #666; }\\n  [data-pdx-tdfsr4] .controls input[type=\\"range\\"] { flex: 1; }\\n  [data-pdx-tdfsr4] .controls input[type=\\"color\\"] { width: 36px; height: 28px; border: 1px solid #ccc; border-radius: 4px; cursor: pointer; }\\n";
}

component('pdx-color-card', {
  props: {
    emoji: { type: String, default: '🎨' }
  },
  setup(ctx) {
    const __color = signal('#3b82f6', { name: 'color-card:color' });
    const __radius = signal(12, { name: 'color-card:radius' });
    const __scalePercent = signal(100, { name: 'color-card:scalePercent' });
function onColor(e) { __color.set(e.target.value); }
      function onRadius(e) { __radius.set(parseInt(e.target.value)); }
      function onScale(e) { __scalePercent.set(parseInt(e.target.value)); }
    const scale = computed(() => (__scalePercent() / 100).toFixed(2), { name: 'color-card:scale' });
    const previewStyle = computed(() => \`background: \${__color()}; border-radius: \${__radius()}px; transform: scale(\${scale()})\`, { name: 'color-card:previewStyle' });
    ctx.el.setAttribute('data-pdx-tdfsr4', '');
    return { color: __color, radius: __radius, scalePercent: __scalePercent, scale, previewStyle, onColor, onRadius, onScale };
  },
  render: (ctx) => html\`
  <div class="color-card">
    <h3>bind() CSS Demo</h3>
    <div class="preview" :style=\${() => ctx.previewStyle()}>
      <span class="emoji">\${ctx.emoji}</span>
      <div class="label">Dynamic CSS Variables</div>
    </div>
    <div class="controls">
      <label>Color
        <input type="color" :value=\${ctx.color} @input=\${safeHandler(ctx.onColor, ctx.el?.tagName?.toLowerCase(), 'input')} />
      </label>
      <label>Radius: \${ctx.radius}px
        <input type="range" min="0" max="50" :value=\${ctx.radius} @input=\${safeHandler(ctx.onRadius, ctx.el?.tagName?.toLowerCase(), 'input')} />
      </label>
      <label>Scale: \${ctx.scale}
        <input type="range" min="50" max="200" :value=\${ctx.scalePercent} @input=\${safeHandler(ctx.onScale, ctx.el?.tagName?.toLowerCase(), 'input')} />
      </label>
    </div>
  </div>
\`,
});
"
`;


<template>
  <!-- The identity group of the employee's personal data, as a SECTION of the page's form: it
       inherits that form (`from parent`, #613) and binds its fields. It is its own component for the one thing no other group has — a field that
       appears for a condition: the tax code, asked only of someone living in Italy. The rule that
       requires it is the form's (`personalRule`), not this component's. -->
  <fieldset class="group" data-test="group-identity">
    <legend class="group-title">{{ $t('employees.personal.groups.identity') }}</legend>
    <div class="grid two">
      <pdx-form-field :field="personal.firstName" :label="$t('employees.personal.fields.firstName')">
        <pdx-input name="firstName" ::value="personal.firstName" data-test="firstName"></pdx-input>
      </pdx-form-field>
      <pdx-form-field :field="personal.lastName" :label="$t('employees.personal.fields.lastName')">
        <pdx-input name="lastName" ::value="personal.lastName" data-test="lastName"></pdx-input>
      </pdx-form-field>
      <pdx-form-field :field="personal.birthDate" :label="$t('employees.personal.fields.birthDate')">
        <pdx-date-picker name="birthDate" ::value="personal.birthDate" editable data-test="birthDate"></pdx-date-picker>
      </pdx-form-field>
      <pdx-form-field :field="personal.gender" :label="$t('employees.personal.fields.gender')">
        <pdx-radio-group name="gender" ::value="personal.gender" orientation="horizontal" data-test="gender">
          <pdx-radio value="female" :label="$t('employees.personal.genders.female')"></pdx-radio>
          <pdx-radio value="male" :label="$t('employees.personal.genders.male')"></pdx-radio>
          <pdx-radio value="other" :label="$t('employees.personal.genders.other')"></pdx-radio>
        </pdx-radio-group>
      </pdx-form-field>
      <!-- CONDITIONAL: asked, and required by the form's rule, only of someone living in Italy.
           Masked to the codice fiscale's shape; the rule refuses one not complete. -->
      @show (country === 'IT') {
        <pdx-form-field :field="personal.taxCode" :label="$t('employees.personal.fields.taxCode')">
          <pdx-masked-input name="taxCode" ::value="personal.taxCode" mask="AAAAAA##A##A###A" data-test="taxCode"></pdx-masked-input>
        </pdx-form-field>
      }
      <pdx-form-field :field="personal.language" :label="$t('employees.personal.fields.language')">
        <pdx-select name="language" ::value="personal.language" :options="languages" data-test="language"></pdx-select>
      </pdx-form-field>
    </div>
  </fieldset>
</template>

<script>
import { getLocale } from '@pdxui/core';
import type { EmployeeIdentityValues } from '../data/employees';

/** The country of residence: the tax code is asked only for Italy. The form holds it; the page reads it. */
@prop country: string = '';

// This component is a section of the form above it: it names that form, which it reads when it is
// there — a section can set up before its <pdx-form> (#613).
@form personal: EmployeeIdentityValues from parent;

// `getLocale()` hands back the signal; reading it is the second call.
const localeSignal = getLocale();
const LANGUAGES = ['it', 'en', 'fr', 'de', 'es'];
/** Each language in the reader's language, from the platform rather than from a dictionary. */
const languageNames = $derived(new Intl.DisplayNames([localeSignal()], { type: 'language' }));
const languages = $derived(LANGUAGES.map(code => ({ value: code, label: languageNames.of(code) })));
</script>

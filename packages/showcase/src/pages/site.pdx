<template>
  <section class="page" data-test="site">
    <pdx-breadcrumb data-test="crumbs"></pdx-breadcrumb>
    <h1 class="pdx-txt-title">{{ record?.name ?? $t('sites.unknown') }}</h1>

    <!-- The record detail's shell, written once. -->
    <pdx-record-detail :label="$t('sites.sections')">
      <span slot="identity" class="portrait" aria-hidden="true">{{ monogram }}</span>
      <p slot="identity" class="pdx-txt-heading identity-name" data-test="identity-name">{{ record?.city ?? '' }}</p>
      <p slot="identity" class="pdx-txt-small pdx-ink-muted" data-test="identity-sub">{{ record ? $t('sites.statuses.' + record.status) : '' }}</p>

      <p slot="menu" class="menu-group pdx-txt-small pdx-ink-muted">{{ $t('sites.groups.site') }}</p>
      <button slot="menu" type="button" class="menu-row" :aria-pressed="section === 'details' ? 'true' : 'false'"
        @click="section = 'details'" data-test="section-details">{{ $t('sites.sectionNames.details') }}</button>
      <button slot="menu" type="button" class="menu-row" :aria-pressed="section === 'people' ? 'true' : 'false'"
        @click="section = 'people'" data-test="section-people">
        <span>{{ $t('sites.sectionNames.people') }}</span><span class="menu-count" data-test="people-count">{{ people.length }}</span>
      </button>
      <button slot="menu" type="button" class="menu-row" :aria-pressed="section === 'tickets' ? 'true' : 'false'"
        @click="section = 'tickets'" data-test="section-tickets">
        <span>{{ $t('sites.sectionNames.tickets') }}</span><span class="menu-count" data-test="tickets-count">{{ tickets.length }}</span>
      </button>

        <!-- Details: the form IS the section, always editable, each field saved after its pause
             (the employee's personal data's shape). -->
        <section :show="section === 'details'" data-test="details">
          <div class="section-head">
            <h2 class="pdx-txt-heading">{{ $t('sites.sectionNames.details') }}</h2>
            <span class="save-status pdx-txt-small" role="status" aria-live="polite" data-test="save-status"
              :data-state="saveState" :title="savedTitle">{{ statusText }}</span>
          </div>
          <pdx-form :form="details" data-test="details-form">
            <div class="grid two">
              <pdx-form-field name="name" :label="$t('sites.fields.name')">
                <pdx-input name="name" data-test="name"></pdx-input>
              </pdx-form-field>
              <pdx-form-field name="status" :label="$t('sites.fields.status')">
                <pdx-segmented name="status" :options="statuses" data-test="status"></pdx-segmented>
              </pdx-form-field>
              <pdx-form-field class="wide" name="address" :label="$t('sites.fields.address')">
                <pdx-input name="address" data-test="address"></pdx-input>
              </pdx-form-field>
              <pdx-form-field name="city" :label="$t('sites.fields.city')">
                <pdx-input name="city" data-test="city"></pdx-input>
              </pdx-form-field>
              <pdx-form-field name="postcode" :label="$t('sites.fields.postcode')">
                <pdx-masked-input name="postcode" mask="#####" data-test="postcode"></pdx-masked-input>
              </pdx-form-field>
              <pdx-form-field name="province" :label="$t('sites.fields.province')">
                <pdx-masked-input name="province" mask="AA" data-test="province"></pdx-masked-input>
              </pdx-form-field>
              <pdx-form-field name="phone" :label="$t('sites.fields.phone')">
                <pdx-input name="phone" type="tel" data-test="phone"></pdx-input>
              </pdx-form-field>
            </div>
          </pdx-form>
        </section>

        <!-- People: who has a current assignment here. Assigned from their own record. -->
        <section :show="section === 'people'" data-test="people">
          <h2 class="pdx-txt-heading">{{ $t('sites.sectionNames.people') }}</h2>
          <ul class="rows">
            @for (people as person; track person.id) {
              <li>
                <pdx-link :to="'/employees/' + person.id + '/personal'" data-test="person">{{ person.firstName }} {{ person.lastName }}</pdx-link>
                <span class="pdx-txt-small pdx-ink-muted">{{ roleHere(person) }}</span>
              </li>
            } @empty {
              <li data-test="no-people">
                <pdx-empty-state icon="user" :title="$t('sites.people.emptyTitle')" :description="$t('sites.people.emptyBody')"></pdx-empty-state>
              </li>
            }
          </ul>
        </section>

        <!-- Tickets: those opened at this site. -->
        <section :show="section === 'tickets'" data-test="tickets">
          <h2 class="pdx-txt-heading">{{ $t('sites.sectionNames.tickets') }}</h2>
          <ul class="rows">
            @for (tickets as ticket; track ticket.id) {
              <li>
                <pdx-link :to="'/tickets/' + ticket.id" data-test="site-ticket">{{ ticket.reference }} · {{ ticket.subject }}</pdx-link>
                <span class="pdx-txt-small pdx-ink-muted">{{ ticket.customer }}</span>
              </li>
            } @empty {
              <li data-test="no-tickets">
                <pdx-empty-state icon="inbox" :title="$t('sites.tickets.emptyTitle')" :description="$t('sites.tickets.emptyBody')"></pdx-empty-state>
              </li>
            }
          </ul>
        </section>
    </pdx-record-detail>
  </section>
</template>

<script setup>
@page '/sites/:id' { label: siteLabel };
@title record?.name ?? $t('sites.unknown');

// The trail names the site, as the customer's names the customer.
function siteLabel(params) {
  return siteById(Number(params.id))?.name ?? $t('sites.unknown');
}

import { getLocale } from '@pdxui/core';
import { siteById, siteTransport, SITE_STATUSES } from '../data/sites';
import { createAutosave } from '../data/autosave';
import { peopleAtSite } from '../data/employees';
import { ticketsAtSite } from '../data/tickets';

@prop id: string = '';

// `getLocale()` hands back the signal; reading it is the second call.
const localeSignal = getLocale();

const record = $derived(siteById(Number(id)));
const monogram = $derived((record?.name ?? '?').split(' ').map(w => w[0]).slice(0, 2).join(''));
const people = $derived(peopleAtSite(Number(id)));
const tickets = $derived(ticketsAtSite(Number(id)));
const statuses = $derived(SITE_STATUSES.map(s => ({ value: s, label: $t('sites.statuses.' + s) })));

let section = $signal('details');

/** The person's current role here, and since when. */
function roleHere(person) {
  const a = person.assignments.find(x => x.siteId === Number(id) && x.end === '');
  return a ? $t('sites.people.role', { role: a.role, start: $d(a.start, { dateStyle: 'medium' }) }) : '';
}

// ── Details: saved as they change (the employee's personal data's shape) ──
@form details: {
  name: string,
  status: string,
  address: string,
  city: string,
  postcode: string,
  province: string,
  phone: string
} {
  save: onChange;
  validate: detailsRule
};

const FIELDS = Object.keys(details.getValues());
/** A postcode as the mask draws it: five digits, and a half-typed one is not one. */
const POSTCODE = /^\d{5}$/;

function detailsRule(v) {
  const errors: Record<string, string> = {};
  if (!String(v.name ?? '').trim()) errors.name = $t('sites.nameRequired');
  if (v.postcode && !POSTCODE.test(v.postcode)) errors.postcode = $t('sites.postcodeShape');
  return errors;
}

// ── Saving (src/data/autosave.ts) ──
// The load, the queue, the state and the flush on leave are the composable's, as on the employee's
// page.
const autosave = createAutosave({
  form: details,
  fields: FIELDS,
  read: () => siteById(Number(id)),
  write: (record) => siteTransport.update(record),
});
$watch(id, () => autosave.load(), { immediate: true });

const saveState = $derived(autosave.state());
const statusText = $derived(saveState === 'saving' ? $t('sites.saving')
  : saveState === 'refused' ? $t('sites.notSaved')
  : saveState === 'saved' ? $t('sites.saved') : '');
const savedTitle = $derived(autosave.savedAt()
  ? $t('sites.savedAt', { time: new Intl.DateTimeFormat(localeSignal(), { timeStyle: 'medium' }).format(autosave.savedAt()) })
  : null);

// A change still inside its pause is saved on the way out, not lost; a refused one stays refused.
onBeforeLeave(async () => {
  await autosave.saveChanged();
  return true;
});
</script>

<style scoped>
  .page { display: flex; flex-direction: column; gap: var(--pdx-space-md); }
  /* The shell — identity, section menu, rows — is <pdx-record-detail>'s. */

  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--pdx-space-md); }
  .save-status { color: var(--pdx-color-muted); min-height: 1lh; }
  .save-status[data-state="refused"] { color: var(--pdx-color-danger-ink); }

  .grid { display: grid; gap: var(--pdx-space-md) var(--pdx-space-lg); align-items: start; }
  .grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid .wide { grid-column: 1 / -1; }

  /* A phone: one field a row. */
  @media (max-width: 640px) {
    .grid.two { grid-template-columns: minmax(0, 1fr); }
  }
</style>

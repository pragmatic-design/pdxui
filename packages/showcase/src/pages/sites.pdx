<template>
  <section class="page" data-test="sites">
    <!-- The list's header, the tickets': views of this list's own. -->
    <pdx-list-header
      :title="$t('sites.title')"
      store-key="sites"
      :default-name="$t('sites.views.default')"
      :grid="gridEl"
      :source="source"
      :base-page-size="20">
      <span class="pdx-txt-small pdx-ink-muted" data-test="total">{{ $t('sites.matching', { count: total }) }}</span>
      <pdx-button variant="primary" @click="creating.open.set(true)" data-test="new">{{ $t('sites.new') }}</pdx-button>
    </pdx-list-header>
    <p class="pdx-txt-small pdx-ink-muted">{{ $t('sites.intro') }}</p>

    <!-- A row is the way into the site, a page with its sections. No selection and no
         bulk bar: a site is closed, from its Details, never archived or deleted. -->
    <pdx-data-grid
      :ref="gridEl"
      :source="source"
      :columns="columns"
      :page-sizes="[10, 20, 50]"
      show-toolbar
      search
      row-clickable
      @pdx-row-click="e => openRecord(e.detail.row)"
      data-test="grid"></pdx-data-grid>

    <!-- CREATE IN A MODAL: a name and a city; the address is the Details', in the page. -->
    <pdx-dialog
      :open="createOpen"
      size="md"
      :title="$t('sites.new')"
      @pdx-close="creating.open.set(false)"
      data-test="create-dialog">
      <pdx-auto-form
        :schema="schema"
        :submit-label="$t('sites.create')"
        @pdx-submit="e => creating.create(e.detail?.values ?? {})"
        data-test="create-form"></pdx-auto-form>
    </pdx-dialog>
  </section>
</template>

<script setup>
// A dictionary key, for the reason in `customers.pdx`: an ancestor of `/sites/:id`, which does not
// render inside it.
@page '/sites' { label: $t('sites.title') };
@title $t('sites.title');
@scroll 'preserve';

import { createDataSource, actions, badge } from '@pdxui/core';
import { navigate } from '@pdxui/router';
import { siteTransport, SITE_STATUSES } from '../data/sites';
import { createInModal } from '../data/create-in-modal';

// Fourteen sites fit one page of twenty: the list is seen whole, and pages when it grows.
const source = createDataSource({ transport: siteTransport, pageSize: 20 });

const STATUS_TONES = { active: 'success', closed: 'muted' };

const columns = $derived([
    { field: 'name', header: $t('sites.columns.name'), filterable: true, searchable: true },
    { field: 'city', header: $t('sites.columns.city'), width: 160, searchable: true },
    { field: 'province', header: $t('sites.columns.province'), width: 120 },
    // Counted by the server as it answers, so it is not a field a sort can order by.
    { field: 'people', header: $t('sites.columns.people'), width: 110, sortable: false },
    { field: 'status', header: $t('sites.columns.status'), width: 140,
      format: (v) => $t('sites.statuses.' + String(v)), cell: badge({ tones: STATUS_TONES }), quickFilter: true,
      filterOptions: SITE_STATUSES.map(v => ({ value: v, label: $t('sites.statuses.' + v) })) },
    { field: 'id', header: '', width: 56, sortable: false,
      cell: actions([{ icon: 'eye', label: (row) => $t('sites.openRecord', { name: String(row.name) }),
                       onClick: (row) => openRecord(row) }]) },
]);

const schema = $derived({
    fields: [
        { name: 'name', label: $t('sites.fields.name'), type: 'text', required: true },
        { name: 'city', label: $t('sites.fields.city'), type: 'text', required: true },
    ],
});

// Create in a modal, then read the list again (src/data/create-in-modal.ts).
const creating = createInModal({ source, transport: siteTransport });
const createOpen = $derived(creating.open());
const total = $derived(source.total());
/** The grid, for the list header's views. A `:ref` binds into a SIGNAL. */
let gridEl = $signal(null);

function openRecord(row) {
  navigate(`/sites/${row.id}`);
}
</script>

<style scoped>
  .page { display: flex; flex-direction: column; gap: var(--pdx-space-md); }
</style>

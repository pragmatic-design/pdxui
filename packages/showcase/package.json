{
    "name": "@pdxui/showcase",
    "version": "1.0.0-alpha.0",
    "description": "A service desk built in PDX — the reference for how an app is written, and the bench that measures the production build.",
    "license": "MIT",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "npm run test:build && npm run test:timing && npm run test:dev && npm run test:hmr && npm run test:scenarios",
        "test:build": "playwright test --config tests/playwright.config.ts",
        "test:timing": "playwright test --config tests/playwright.timing.config.ts",
        "test:dev": "playwright test --config tests/playwright.dev.config.ts",
        "test:hmr": "playwright test --config tests/playwright.hmr.config.ts",
        "test:scenarios": "playwright test --config tests/playwright.scenarios.config.ts",
        "review": "playwright test --config tests/review/review.config.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@pdxui/core": "workspace:*",
        "@pdxui/design": "workspace:*",
        "@pdxui/router": "workspace:*",
        "@pdxui/ui": "workspace:*"
    },
    "devDependencies": {
        "@playwright/test": "^1.50.0",
        "vite": "^6.4.4"
    }
}

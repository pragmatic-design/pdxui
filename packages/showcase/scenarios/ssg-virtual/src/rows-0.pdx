<!-- The long list with no row written by the server: its spacers only (#930). -->
<template>
  <h1 data-test="title">The long list</h1>
  <ul class="list" data-test="list">
    @for (rows as row; track row.id) @virtual(32, serverRows: 0) {
      <li class="row">{{ row.label }}</li>
    }
  </ul>
</template>

<script>
import { ROWS } from './rows';
@page '/rows-0';
const rows = ROWS;
</script>

<style scoped>
h1 { height: 72px; margin: 0; box-sizing: border-box; padding: 16px; font-size: 24px; }
.list { height: calc(100vh - 72px); overflow: auto; margin: 0; padding: 0; list-style: none; }
.row { height: 32px; box-sizing: border-box; padding: 6px 16px; border-bottom: 1px solid #ddd; }
</style>

<!--
  pdx-switch, written in .pdx for the pilot (#137): the same component as
  src/switch-toggle/pdx-switch.ts, held to the same unit tests and certification manifest.
  Not exported: the follow-up the pilot opens decides.
-->
<template>
  <label :class="wrapClass">
    <input
      type="checkbox"
      class="pdx-toggle"
      data-part="root"
      role="switch"
      :ref="inputEl"
      ::checked="checked"
      :disabled="disabled || loading"
      :aria-checked="String(!!checked)"
      :aria-invalid="error ? 'true' : null"
      :aria-busy="loading ? 'true' : null"
      :aria-label="ariaLabel || (label ? null : uiString('switch', 'label'))" />
    @if (label || description) {
      <span class="pdx-switch-content">
        @if (label) {
          <span class="pdx-switch-label" data-part="label">{{ label }}</span>
        } @else {
          <slot></slot>
        }
        @if (description) {
          <span class="pdx-switch-desc" data-part="description">{{ description }}</span>
        }
      </span>
    } @else {
      <slot></slot>
    }
  </label>
</template>

<script>
/**
 * A toggle switch (role="switch") the user turns on and off, with a label, a description and a
 * loading state.
 *
 * @csspart root - The native checkbox with role="switch", the track drawn; the size variants key by it.
 * @csspart label - The `label` text, when set.
 * @csspart description - The `description` text, when set.
 *
 * @cssstate checked - It is on.
 * @cssstate invalid - `error` is set; the switch is aria-invalid.
 * @cssstate disabled - `disabled` is set.
 * @cssstate loading - `loading` is set; the switch is aria-busy and takes no toggle.
 *
 * @alphaevent pdx-change
 * @alphadetail checked $event.detail.value
 * @alphadetail value $event.currentTarget.value
 */
import { uiString } from '../src/shared/i18n';

// A toggle writes it (#480), and the write dispatches `checked-change`.
@model checked: boolean = false { form };
/** sm, md (the default) or lg: the track's size. */
@variants { size: { md: '.pdx-toggle-md', sm: '.pdx-toggle-sm', lg: '.pdx-toggle-lg' } = md; }
// pdx-ignore PDX_PART_NAME_TAKEN: label and description are the theme's parts; the script reads the props of those names
@part root, label, description;
// On the host as custom states (#132, #293): the track and its label carry no state class.
@state checked = !!checked;
@state invalid = !!error;
@state disabled = !!disabled;
@state loading = !!loading;
@prop disabled: boolean = false;
@prop loading: boolean = false;
@prop label: string = '';
@prop description: string = '';
/** Accessible name when there is no visible label (forwarded to the inner input) */
@prop ariaLabel: string = '';
@prop labelPosition: string = 'right';
@prop error: boolean = false;
@prop name: string = '';
@prop value: string = '';

// The host is the one submitter; an inner checkbox carrying the name too would send the value a
// second time.
@host { :name="name || null" }

@expose focus, blur, clear;

let inputEl = $signal<HTMLInputElement | null>(null);

const wrapClass = $derived('pdx-switch-wrap' + (labelPosition === 'left' ? ' pdx-switch-label-left' : ''));

// The field writes `checked` itself, two-way: a disabled or loading switch is a disabled input, which
// the user cannot change.
function focus() { inputEl?.focus(); }
function blur() { inputEl?.blur(); }
function clear() { checked = false; }
</script>

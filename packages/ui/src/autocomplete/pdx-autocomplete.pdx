<template>
  <div class="pdx-autocomplete pdx-input-wrap" data-part="root">
    <!-- pdx-ignore PDX_ONE_WAY_EDITED_FIELD: onInput writes `query` from the field and never puts back an earlier value; every other write (a pick, a clear, forceSelection's blur) changes `query`, and the binding writes it -->
    <input :value="query" class="pdx-input pdx-autocomplete-input" data-part="input"
      type="text"
      role="combobox"
      :aria-invalid="error ? 'true' : null"
      autocomplete="off"
      data-lpignore="true" data-1p-ignore="" data-form-type="other"
      :placeholder="placeholder"
      :disabled="disabled"
      :readonly="readonly"
      :aria-expanded="String(popupOpen)"
      :aria-controls="listboxId"
      :aria-activedescendant="activeIndex >= 0 ? uid + '-sug-' + activeIndex : null"
      :aria-label="label || null"
      aria-haspopup="listbox"
      aria-autocomplete="list"
      @input="onInput"
      @focus="onFocus"
      @blur="onBlur"
      @keydown="onKeydown" />
    @if (clearable && query) {
      <button class="pdx-input-clear" data-part="clear" type="button" tabindex="-1"
        :aria-label="uiString('autocomplete', 'clear')"
        @mousedown.prevent="clear()">×</button>
    }
    @if (isLoading) {
      <span class="pdx-input-spinner" data-part="spinner"></span>
    }
  </div>
  <div class="pdx-autocomplete-dropdown" data-part="popup">
    <span class="pdx-sr-only" role="status" aria-live="polite" aria-atomic="true">{{ statusText() }}</span>
    <div class="pdx-autocomplete-list" data-part="list"
      role="listbox"
      :aria-busy="isLoading ? 'true' : null"
      :id="listboxId">
      @if (filteredItems.length === 0) {
        <!-- Nothing matches: say so, as pdx-select does — not while suggestions are loading. -->
        @if (popupOpen && !isLoading) {
          <div class="pdx-autocomplete-empty">{{ uiString('autocomplete', 'noResults') }}</div>
        }
      } @else {
        @for (filteredItems as opt, idx; track idx) {
          <!-- `maxItems` shows part of the matches: each says where it stands among all of them, or a
               screen reader counts the rendered ones (A3, #287). -->
          <div class="pdx-autocomplete-option" :class="{ active: activeIndex === idx }"
            role="option" data-part="option"
            :aria-setsize="String(matches.length)"
            :aria-posinset="String(idx + 1)"
            :id="uid + '-sug-' + idx"
            :data-suggestion-index="idx"
            :aria-selected="activeIndex === idx ? 'true' : 'false'"
            @mousedown.prevent="selectSuggestion(opt)"
            @mouseenter="activeIndex = idx">
            @render option?.({ label: opt.label, value: opt.value, raw: opt._raw as T }, idx, !!query.trim()) @else {
              @if (highlight && query.trim() && matchAt(opt.label) >= 0) {
                <span>{{ opt.label.slice(0, matchAt(opt.label)) }}<mark>{{ opt.label.slice(matchAt(opt.label), matchAt(opt.label) + query.trim().length) }}</mark>{{ opt.label.slice(matchAt(opt.label) + query.trim().length) }}</span>
              } @else if (highlight && query.trim()) {
                <span>{{ opt.label }}</span>
              } @else {
                {{ opt.label }}
              }
            }
          </div>
        }
      }
    </div>
  </div>
</template>

<script>
/**
 * A text input with suggestions whose value is free text: the user can type anything, or pick a
 * suggestion from a local list or a remote data source.
 *
 * @slot option - Renders one option: a snippet `option(option, index, highlighted)`; `option.raw` is the original item.
 *
 * @csspart root - The frame: border, background and the states' colours.
 * @csspart input - The native `<input>`, the combobox.
 * @csspart clear - The clear button, while `clearable` and something is typed.
 * @csspart spinner - The loading spinner, while loading.
 * @csspart popup - The floating panel that holds the list.
 * @csspart list - The `role="listbox"`.
 * @csspart option - A suggestion of the list.
 *
 * @cssstate open - The popup is open.
 * @cssstate invalid - `error` is set.
 * @cssstate success - `success` is set.
 * @cssstate warning - `warning` is set.
 * @cssstate disabled - `disabled` is set.
 * @cssstate readonly - `readonly` is set.
 * @cssstate loading - `loading` is set, or the DataSource is loading.
 *
 * @cssprop --pdx-input-border-color - The trigger is the text input's frame, `.pdx-input-wrap`, and reads pdx-input's tokens (#761): its border at rest (the outlined input style).
 * @cssprop --pdx-input-border-color-focus - The frame's border while focused (the outlined input style).
 * @cssprop --pdx-input-border-color-invalid - The frame's border in the invalid state.
 * @cssprop --pdx-input-border-color-success - The frame's border in the success state.
 * @cssprop --pdx-input-border-color-warning - The frame's border in the warning state.
 * @cssprop --pdx-input-border-width - The frame's bottom border, in the filled input style.
 * @cssprop --pdx-input-focus-ring - The ring around the frame while focused.
 * @cssprop --pdx-input-min-height - The frame's height, at the md size.
 *
 * @alphaevent pdx-input
 * @alphaevent pdx-change
 * @alphadetail value $event.detail.value
 * @alphadetail label $event.currentTarget.getText()
 * @alphadetail item $event.currentTarget.getSelectedItem()
 * @alpharename pdx-input query-change
 */
// pdx-autocomplete — Text input with suggestions.
// Value is FREE TEXT. Supports local array, DataSource, debounce, forceSelection, highlight.
import { isDataSource, inject, untracked, generatedId, usePopover, overlayStack, effect, onDestroy } from '@pdxui/core';
import type { DataSource } from '@pdxui/core';
import { DataSourceContext } from '../data-source/data-source-context';
import { uiString, format } from '../shared/i18n';
// This component's styles travel with it, so an app ships the CSS of what it renders
// and no more.
import '@pdxui/design/components/autocomplete';

interface NormalisedOption { label: string; value: unknown; _raw: unknown; }

function normalize(items: any[], lf: string, vf: string): NormalisedOption[] {
  if (!items || !Array.isArray(items)) return [];
  return items.map(it => {
    if (typeof it === 'string' || typeof it === 'number') {
      return { label: String(it), value: it, _raw: it };
    }
    return {
      label: String(it[lf] ?? it.label ?? ''),
      value: it[vf] ?? it.value ?? it,
      _raw: it,
    };
  });
}

/** The text typed, on each keystroke: the query the suggestions are filtered by. */
@event 'query-change': { value: string };
/** Fired when the clear button empties the field, after its `value-change`. */
@event 'pdx-clear': void;
/** The popup opened (`true`) or closed (`false`): its open state, read-only, as an overlay's (#287). */
@event 'open-change': { value: boolean };
// The visual states, on the host as custom states (#132, #287): the design CSS draws the frame and
// the popup from them. Neither carries a state class. They follow the props and the popup, in one
// effect, as the TypeScript version's track kept them.
@state open = popupOpen;
@state invalid = !!error;
@state success = !!success;
@state warning = !!warning;
@state disabled = !!disabled;
@state readonly = !!readonly;
@state loading = isLoading;
@part root, input, clear, spinner, popup, list, option;
// `raw` is the app's suggestion, an element of `suggestions` (#651): the editor infers `T`.
@generic T;
@prop suggestions: T[] = [];
@prop source: Record<string, unknown> | null = null;
@prop labelField: string = 'label';
@prop valueField: string = 'value';
@prop placeholder: string = '';
@prop label: string = '';
@prop disabled: boolean = false;
@prop readonly: boolean = false;
@prop minLength: number = 1;
@prop debounce: number = 200;
@prop forceSelection: boolean = false;
@prop highlight: boolean = true;
@prop clearable: boolean = false;
@prop loading: boolean = false;
@prop name: string = '';
@prop maxItems: number = 10;
/** Enable server-side filtering via DataSource.setFilter() with debounce. */
@prop remote: boolean = false;
@prop error: boolean = false;
@prop success: boolean = false;
@prop warning: boolean = false;
// The axis inputs.css keys by (#628), reflected on the host; each value maps the class that draws
// the same size on a native field. `md` is the base look, which no class adds to.
@variants {
  /** xs, sm, md (the default), lg or xl — the same scale as pdx-input. */
  size: { md: '.pdx-input-md', xs: '.pdx-input-xs', sm: '.pdx-input-sm', lg: '.pdx-input-lg', xl: '.pdx-input-xl' } = md;
}
// The committed value (#481): a suggestion picked (its value field, or its label when it has
// none), the field cleared, or free text confirmed by leaving the field or pressing Enter with no
// option chosen. Once per edit, like a native `change`. The text typed is not the value: it is
// announced with `query-change`.
// A form submits the model: a picked suggestion's value, the code (#135). Free text typed and
// not committed yet is what leaving the field will commit, 150 ms after the blur — a click on a
// submit button is sooner, so the form takes the text now, as a native input would.
/** The model's value. A form submits it: a picked suggestion's value, not the label shown; free text as typed (#135). */
@model value: unknown = '' { attribute: string, form: () => (query === committed || forceSelection ? value : query) };
// A parent's `@snippet` sets it, positional arguments; the alpha scoped slot is not read (#492).
@slot option?: (option: { label: string; value: unknown; raw: T }, index: number, highlighted: boolean);
// The host is the one submitter, in FormData under its `name` (#133). A hidden input carrying the
// name would send the value a second time.
@host host { :name="name || null" }
// The popup is driven with the overlay verbs (#287): `show()` is the alpha `open()`.
@expose show, close, toggle, clear, getText, getSelectedItem;

const uid = generatedId('pdx-ac');
const listboxId = uid + '-lb';

let popupOpen = $signal(false);
let query = $signal('');
let activeIndex = $signal(-1);
let focused = $signal(false);
let debounceTimer: any = null;
let blurTimer: any = null;
// Tracks which query was last sent to the DS for remote search. When DS data arrives, we verify it
// matches the current query. Read and written by handlers only.
let remoteQuery = '';
let pendingRemote = $signal(false);

// ── Popover + overlay stack ──
let popover: ReturnType<typeof usePopover> | null = null;
let overlayId = '';

// ── DataSource resolution ──
// Priority: source prop > Context Protocol (pdx-data-source ancestor)
let externalDS = $signal<DataSource<any> | null>(null);

$effect(() => {
  const src = source;
  if (src) {
    if (isDataSource(src)) {
      externalDS = src as unknown as DataSource<any>;
      return;
    } else if (src instanceof HTMLElement && typeof (src as any).source === 'function') {
      externalDS = (src as any).source();
      return;
    }
  }
  // Fallback: try Context Protocol from ancestor <pdx-data-source>
  const injected = inject(DataSourceContext, host, null);
  if (injected && isDataSource(injected)) {
    externalDS = injected;
  } else {
    externalDS = null;
  }
});

// The text last committed, or set from outside: free text typed since then is committed —
// written to the model — when the field is left or Enter is pressed.
let committed = '';
// The suggestion last picked, or null for free text: what getSelectedItem() answers.
let selectedItem: unknown = null;
// The value the component last wrote to its own model, so the sync below does not read it back as
// a value set from outside. A value, not a flag raised around the write: a template handler runs in
// a batch, and the sync runs when the batch ends, after a flag would have been lowered.
const NONE: unique symbol = Symbol('none');
let ownValue: unknown = NONE;

/** Writes a committed value to the model, which dispatches `value-change`. */
function commit(next: unknown, text: string, it: unknown): void {
  committed = text;
  selectedItem = it;
  ownValue = next;
  value = next;
}

/**
 * Commit free text the way a pick is committed. The value is free text, and inside a pdx-form
 * the compiler wires this control on its model's event: typed and never picked, it would never
 * reach the form. Like a native `change`, it fires once per edit, on commit.
 */
function commitText(): void {
  const q = query;
  if (q === committed) return;
  commit(q, q, null);
}

// ── For external DS: track data signal ──
let dsData = $signal<any[]>([]);

$effect(() => {
  const ds = externalDS;
  if (!ds) return;
  const data = ds.data();
  dsData = data ?? [];
  // Clear pending flag only if data matches the query we sent
  if (pendingRemote.peek()) {
    if (remoteQuery === query.peek()) pendingRemote = false;
  }
});

// ── Suggestions ──
function readAllItems(): NormalisedOption[] {
  const lf = (labelField as string) || 'label';
  const vf = (valueField as string) || 'value';
  if (externalDS) return normalize(dsData, lf, vf);
  return normalize(suggestions as any[], lf, vf);
}
const allItems = $derived(readAllItems());

// Sync a value set from OUTSIDE → the text shown: the label of the suggestion whose value it
// is, or the value itself as free text. After `allItems`, which it reads.
$effect(() => {
  const v = value;
  // The component's own write: its text and its item are set already.
  if (v === ownValue) return;
  ownValue = NONE;
  if (v !== undefined && v !== null && v !== '') {
    const text = untracked(() => allItems.find((i) => i.value === v)?.label) ?? String(v);
    committed = text;
    selectedItem = null;
    query = text;
  }
});

/** Every suggestion that matches the query, before `maxItems` cuts the list. */
function readMatches(): NormalisedOption[] {
  const q = query.toLowerCase().trim();
  const min = minLength as number;
  if (!q || q.length < min) return [];
  // Not named `list`, the part's name: a read of it by name would bind a ref at every mount.
  const all = allItems;
  // Remote mode: DS already filtered server-side
  // But don't show stale results while debounce/loading is in flight
  if (remote && externalDS) {
    if (pendingRemote) return [];
    return all;
  }
  // Default: client-side filter
  return all.filter(i => i.label.toLowerCase().includes(q));
}
const matches = $derived(readMatches());
const filteredItems = $derived(matches.slice(0, maxItems as number));

/** Where the query starts in a label, for the highlight; -1 when it is not in it. */
function matchAt(text: string): number {
  return text.toLowerCase().indexOf(query.trim().toLowerCase());
}

// ── Actions ──
function openPopup() {
  if (disabled || readonly) return;
  popupOpen = true;
  activeIndex = -1;
}
function closePopup() {
  popupOpen = false;
  activeIndex = -1;
}
function togglePopup() {
  if (popupOpen) closePopup(); else openPopup();
}

function selectSuggestion(it: NormalisedOption) {
  query = it.label;
  // The value is the suggestion's value field — the code, the id — and the text what the
  // input shows, whatever the label. A suggestion with no value field at all sends its label.
  const hasValue = !(typeof it._raw === 'object' && it._raw !== null && it.value === it._raw);
  commit(hasValue ? it.value : it.label, it.label, it._raw);
  closePopup();
}

function onInput(e: Event) {
  const val = (e.target as HTMLInputElement).value;
  query = val;
  activeIndex = -1;
  // The query, not the value: the value is what is committed.
  queryChange({ value: val });

  const min = minLength as number;

  // Remote mode: debounced server-side filter
  if (remote && externalDS) {
    pendingRemote = true;
    if (debounceTimer) clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const ds = externalDS!;
      const lf = (labelField as string) || 'label';
      if (val.length >= min) {
        remoteQuery = val;
        ds.setFilter([{ field: lf, operator: 'contains', value: val }]);
      } else {
        pendingRemote = false;
        ds.setFilter([]);
        closePopup();
      }
    }, debounce as number);
    return;
  }

  // Default: client-side filter, immediate. A query long enough opens the list even when
  // nothing matches, so it can say "No results" rather than stay closed and silent.
  if (val.length >= min) openPopup();
  else closePopup();
}

// Remote mode: auto-open when DS data arrives
$effect(() => {
  if (!remote || !externalDS) return;
  const shownItems = filteredItems;
  if (shownItems.length > 0 && focused && query.length >= (minLength as number)) {
    // pdx-ignore PDX_EFFECT_STATE: results arriving open the popup, an event and not a value; the keys, the input and the methods also write popupOpen
    popupOpen = true;
  }
});

// Suggestions set after the user typed — loaded in a pdx-input handler, as pdx-form-template's
// lookup does — open the list when they match. onInput runs before they arrive, finds
// nothing and closes, and only a DataSource in remote mode would reopen it. Only the
// suggestions are tracked, so choosing an item — which changes the query — does not reopen it.
$effect(() => {
  void suggestions;
  untracked(() => {
    if (externalDS || popupOpen || !focused) return;
    if (query.trim().length >= (minLength as number) && filteredItems.length > 0) openPopup();
  });
});

function onFocus() {
  focused = true;
  const q = query.trim();
  const min = minLength as number;
  if (q.length >= min && filteredItems.length > 0) openPopup();
}

function onBlur() {
  focused = false;
  if (blurTimer) clearTimeout(blurTimer);
  blurTimer = setTimeout(() => {
    if (focused) return;
    closePopup();
    if (forceSelection) {
      const q = query.trim();
      if (q && !allItems.some(i => i.label.toLowerCase() === q.toLowerCase())) {
        query = '';
        commit('', '', null);
      }
    } else {
      commitText();
    }
  }, 150);
}

function onKeydown(e: KeyboardEvent) {
  if (disabled) return;
  const shownItems = filteredItems;
  switch (e.key) {
    case 'ArrowDown':
      e.preventDefault();
      if (!popupOpen && shownItems.length > 0) openPopup();
      else if (popupOpen) moveActive(1);
      break;
    case 'ArrowUp':
      e.preventDefault();
      if (popupOpen) moveActive(-1);
      break;
    case 'Enter': {
      const idx = activeIndex;
      if (popupOpen && idx >= 0 && idx < shownItems.length) {
        e.preventDefault();
        selectSuggestion(shownItems[idx]);
      } else {
        // No option chosen: the text as typed is the answer. Committed before the
        // key reaches a form that submits on Enter, so the submit carries it.
        if (popupOpen) { e.preventDefault(); closePopup(); }
        if (!forceSelection) commitText();
      }
      break;
    }
    case 'Escape':
      if (popupOpen) { e.preventDefault(); e.stopPropagation(); closePopup(); }
      break;
  }
}

function moveActive(delta: number) {
  const len = filteredItems.length;
  if (len === 0) return;
  let next = activeIndex + delta;
  if (next < 0) next = len - 1;
  if (next >= len) next = 0;
  activeIndex = next;
}

function clear() {
  query = '';
  commit('', '', null);
  pdxClear();
  closePopup();
}

function readLoading(): boolean {
  if (loading) return true;
  const ds = externalDS;
  return ds ? ds.isLoading() : false;
}
const isLoading = $derived(readLoading());

/** What the status region says while open: how many suggestions there are. */
function statusText(): string {
  const n = filteredItems.length;
  if (!popupOpen || (n === 0 && isLoading)) return '';
  return n === 0 ? uiString('autocomplete', 'noResults') : format(uiString('autocomplete', 'resultsAvailable'), { n });
}

// The popup's open state, announced when it changes (#287) — `popupOpen` is written from the keys,
// the input, the remote results and the methods alike, and a keystroke that keeps it open
// announces nothing. Untracked: a handler's reads do not subscribe this effect.
let announced = false;
$effect(() => {
  const isOpen = popupOpen;
  if (isOpen === announced) return;
  announced = isOpen;
  untracked(() => openChange({ value: isOpen }));
});

// Popover setup: deferred to after mount (querySelector needs rendered DOM)
let popoverDispose: (() => void) | null = null;
queueMicrotask(() => {
  const wrapEl = host.querySelector('.pdx-autocomplete') as HTMLElement;
  const dropdownEl = host.querySelector('.pdx-autocomplete-dropdown') as HTMLElement;
  if (!wrapEl || !dropdownEl) return;

  popover = usePopover({
    trigger: 'manual',
    placement: 'bottom-start',
    // No offset: the gap comes from `--pdx-float-offset`, and a literal 4 here would
    // duplicate the token declaring the same number.
    flip: true,
    dismissOnOutside: true,
    dismissOnEscape: false, // handled by onKeydown
    container: host, // light DOM: trigger + content are siblings inside host CE
    onOpenChange: (isOpen) => {
      if (!isOpen && popupOpen.peek()) closePopup();
    },
  });

  popover.setTrigger(wrapEl);
  popover.setContent(dropdownEl);

  // Sync popupOpen → popover + overlayStack
  const disposeSync = effect(() => {
    const isOpen = popupOpen;
    if (!popover) return;
    if (isOpen) {
      dropdownEl.style.width = wrapEl.offsetWidth + 'px';
      popover.open();
      overlayId = uid;
      const zIndex = overlayStack.push(overlayId);
      dropdownEl.style.zIndex = String(zIndex);
    } else {
      popover.close();
      dropdownEl.style.zIndex = '';
      if (overlayId) { overlayStack.pop(overlayId); overlayId = ''; }
    }
  });

  popoverDispose = () => {
    disposeSync();
    popover?.dispose();
    popover = null;
    if (overlayId) { overlayStack.pop(overlayId); overlayId = ''; }
  };
});

onDestroy(() => {
  popoverDispose?.();
  // ── Cleanup timers ──
  if (debounceTimer) clearTimeout(debounceTimer);
  if (blurTimer) clearTimeout(blurTimer);
});

/** Open the popup. */
function show() { openPopup(); }
/** Close the popup. */
function close() { closePopup(); }
/** Open the popup when closed, close it when open. */
function toggle() { togglePopup(); }
/** The text the field shows: the picked suggestion's label, or the free text. */
function getText(): string { return query.peek(); }
/** The suggestion last picked, as given; null when the value is free text or set from outside. */
function getSelectedItem(): unknown { return selectedItem; }
</script>

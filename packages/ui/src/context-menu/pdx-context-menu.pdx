<template>
  <slot></slot>
</template>

<script>
/**
 * A right-click menu that opens at the cursor, and also on a long press on mobile or Shift+F10 from
 * the keyboard.
 *
 * @slot item - Renders one menu entry: a snippet `item(item)`.
 */
// pdx-context-menu — Right-click context menu with cursor-following positioning.
// Wraps target content. Right-click (or long-press mobile) opens a floating menu at cursor.
// Items support icons, shortcuts, submenus, checkbox/radio, disabled, danger.
// Dynamic items: pass a function to generate items based on the clicked target.
//
// The panel and the area's listeners are built by the script, a frame after mount, as the
// TypeScript version built them.
import { focusGroup, onNextFrame, onDestroy } from '@pdxui/core';
import type { Dispose } from '@pdxui/core';
import type { MenuItem } from '../menu/menu-types';
import { sanitizeSVG } from '../shared/sanitize';
import { uiString, uiAttr } from '../shared/i18n';
import { warnMisshapenMenuItem } from '../shared/menu-item-shape';
import { onPressOutside } from '../shared/press-outside';
// Its items are `.pdx-menu-item`, drawn by menu.css: without it they would be styled only where some
// other component had brought the sheet.
import '@pdxui/design/components/menu';
/** `pdx-icon` the first time an item names an icon: a use that draws none never pays for the icon set. */
function loadIcon(): void {
  if (!customElements.get('pdx-icon')) void import('../icon/pdx-icon.pdx');
}

/**
 * The menu opened (`true`) or closed (`false`): its open state, read-only (#288). The parent
 * never writes it, so it is not a model, and `::open` on it is an error.
 */
@event 'open-change': { value: boolean };
/** An entry was chosen. */
@event 'pdx-select': { key: string; item: MenuItem };
// On the host as a custom state (#132, #288), set where the TypeScript version set it (#1436).
@state open;
// The panel (on <body> while the page lives, so a theme reaches it by part, not under the host's
// state), an entry, a separator and a group label, all built by the script.
@part(external) root, item, separator, label;
// The item a snippet receives is the app's, an element of `items` (#651): the editor infers `T`.
@generic T extends { key?: string; label?: string; type?: string };
/** Menu items (static array or function returning items) */
@prop items: T[] = [];
/** Disabled — prevents context menu from opening */
@prop disabled: boolean = false;
/** Min width of the menu panel */
@prop minWidth: number = 180;
// A parent's `@snippet` sets it, positional arguments; the alpha scoped slot is not read (#492).
// Less the separators and labels the menu draws itself (`type: 'separator' as const`).
@slot item?: (item: Exclude<T, { type: 'separator' | 'label' }>);
@host host;
// The overlay verbs (#288): `open(x, y)` is `show(x, y)`, and `toggle()` is new.
@expose show, close, toggle;
@expose get isOpen;

/** Open now: read by the `isOpen` getter, which a reader's effect follows, as the TypeScript version's was. */
let opened = $signal(false);
let panelEl: HTMLElement | null = null;
/** Removes the press-outside listener, added when the menu opens (#427). */
let outsideDispose: (() => void) | null = null;
let escHandler: ((e: KeyboardEvent) => void) | null = null;
let focusDispose: Dispose | null = null;
let scrollHandler: (() => void) | null = null;
// The element focused inside the trigger area when the menu opened from the keyboard. Closing
// hides the focused item, and focus would fall to <body>; it goes back here instead.
let opener: HTMLElement | null = null;

// ─── Build menu items into container ─────────────────
function buildMenuItems(list: MenuItem[], container: HTMLElement): void {
  container.innerHTML = '';
  // The parent's `item` snippet, read where the entries are drawn: one set after mount is seen.
  const snippet = item;
  for (const entry of list) {
    warnMisshapenMenuItem('pdx-context-menu', entry);
    if (entry.type === 'separator') {
      const sep = document.createElement('hr');
      sep.className = 'pdx-menu-sep';
      sep.dataset.part = 'separator';
      sep.setAttribute('role', 'separator');
      container.appendChild(sep);
      continue;
    }
    if (entry.type === 'label') {
      const lbl = document.createElement('div');
      lbl.className = 'pdx-menu-label';
      lbl.dataset.part = 'label';
      lbl.setAttribute('role', 'presentation');
      lbl.textContent = entry.label;
      container.appendChild(lbl);
      continue;
    }

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'pdx-menu-item';
    btn.dataset.part = 'item';
    if (entry.danger) btn.classList.add('pdx-menu-danger');
    if (entry.className) btn.classList.add(entry.className);
    btn.setAttribute('data-menu-key', entry.key);
    btn.disabled = !!entry.disabled;
    if (entry.lang) btn.lang = entry.lang;

    if (entry.type === 'checkbox') {
      btn.setAttribute('role', 'menuitemcheckbox');
      btn.setAttribute('aria-checked', String(!!entry.checked));
    } else if (entry.type === 'radio') {
      btn.setAttribute('role', 'menuitemradio');
      btn.setAttribute('aria-checked', String(!!entry.checked));
    } else {
      btn.setAttribute('role', 'menuitem');
    }

    // Check indicator. EMPTY, and on every checkbox/radio item so the labels line up:
    // menu.css draws the tick from `aria-checked`, and a ✓ written here as well would
    // be a second one.
    if (entry.type === 'checkbox' || entry.type === 'radio') {
      const check = document.createElement('span');
      check.className = 'pdx-menu-check';
      btn.appendChild(check);
    }

    // Content: slot > default (icon + label + shortcut)
    if (snippet) {
      btn.appendChild(snippet(entry as unknown as Exclude<T, { type: 'separator' | 'label' }>));
    } else {
      if (entry.icon) {
        if (entry.icon.startsWith('<')) {
          const icon = document.createElement('span');
          icon.className = 'pdx-menu-icon';
          icon.innerHTML = sanitizeSVG(entry.icon);
          btn.appendChild(icon);
        } else {
          loadIcon();
          const icon = document.createElement('pdx-icon');
          icon.className = 'pdx-menu-icon';
          icon.setAttribute('name', entry.icon);
          icon.setAttribute('size', '16');
          btn.appendChild(icon);
        }
      }

      const labelSpan = document.createElement('span');
      labelSpan.className = 'pdx-menu-item-label';
      labelSpan.textContent = entry.label;
      btn.appendChild(labelSpan);

      if (entry.shortcut) {
        const sc = document.createElement('span');
        sc.className = 'pdx-menu-shortcut';
        sc.textContent = entry.shortcut;
        btn.appendChild(sc);
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (entry.disabled) return;
      pdxSelect({ key: entry.key, item: entry });
      close();
    });

    container.appendChild(btn);
  }
}

// ─── Open at cursor position ─────────────────────────
function openAt(clientX: number, clientY: number): void {
  if (!panelEl) return;
  // Already open — a second right-click, a show() at another point: the menu moves, and is
  // still the same opening, so nothing is announced and the opener is kept.
  const wasOpen = opened.peek();
  if (wasOpen) {
    removeListeners();
  } else {
    // Where the focus goes back when the menu closes from inside: what had it now — a
    // focusable element in the area, or an invoker outside it (`command="--show"`).
    const focused = document.activeElement;
    opener = focused instanceof HTMLElement && focused !== document.body ? focused : null;
  }
  opened = true;

  const list = items as unknown as MenuItem[];
  buildMenuItems(list, panelEl);

  panelEl.style.display = '';
  panelEl.style.position = 'fixed';
  panelEl.style.zIndex = '1020';
  panelEl.style.minWidth = (minWidth as number) + 'px';

  // Position at cursor, then flip if overflows viewport
  panelEl.style.visibility = 'hidden';
  panelEl.style.left = clientX + 'px';
  panelEl.style.top = clientY + 'px';

  requestAnimationFrame(() => {
    if (!panelEl) return;
    const rect = panelEl.getBoundingClientRect();
    let finalX = clientX;
    let finalY = clientY;

    if (finalX + rect.width > window.innerWidth) finalX = window.innerWidth - rect.width - 4;
    if (finalY + rect.height > window.innerHeight) finalY = window.innerHeight - rect.height - 4;
    if (finalX < 0) finalX = 4;
    if (finalY < 0) finalY = 4;

    panelEl.style.left = finalX + 'px';
    panelEl.style.top = finalY + 'px';
    panelEl.style.visibility = '';

    // Focus first item
    const first = panelEl.querySelector('[role="menuitem"]:not(:disabled)') as HTMLElement;
    if (first) first.focus();

    // Focus group for keyboard nav
    if (focusDispose) focusDispose();
    focusDispose = focusGroup(panelEl, {
      orientation: 'vertical',
      wrap: true,
      selector: '[role="menuitem"]:not(:disabled), [role="menuitemcheckbox"]:not(:disabled), [role="menuitemradio"]:not(:disabled)',
    });
  });

  // Click outside → close
  outsideDispose = onPressOutside({
    inside: (t) => !panelEl || panelEl.contains(t),
    outside: () => close(),
  });

  // Scroll/resize → close (cursor-following menu loses context after scroll)
  scrollHandler = () => close();
  window.addEventListener('scroll', scrollHandler, { capture: true, passive: true });
  window.addEventListener('resize', scrollHandler, { passive: true });

  // Escape → close
  escHandler = (ev: KeyboardEvent) => {
    if (ev.key === 'Escape') { ev.preventDefault(); close(); }
  };
  document.addEventListener('keydown', escHandler, true);

  if (!wasOpen) {
    open = true;
    openChange({ value: true });
  }
}

/** The listeners an opening adds: press outside, scroll and resize, Escape, the arrow keys. */
function removeListeners(): void {
  outsideDispose?.(); outsideDispose = null;
  if (escHandler) { document.removeEventListener('keydown', escHandler, true); escHandler = null; }
  if (scrollHandler) { window.removeEventListener('scroll', scrollHandler, true); window.removeEventListener('resize', scrollHandler); scrollHandler = null; }
  if (focusDispose) { focusDispose(); focusDispose = null; }
}

function close(): void {
  if (!opened.peek()) return;
  opened = false;
  // Read before hiding: a hidden element loses focus. Only a menu that held focus gives it
  // back — a click elsewhere closes the menu and keeps focus where the user clicked.
  const hadFocus = !!panelEl && panelEl.contains(document.activeElement);
  if (panelEl) panelEl.style.display = 'none';
  if (hadFocus && opener?.isConnected) opener.focus();
  opener = null;
  removeListeners();
  open = false;
  openChange({ value: false });
}

// Open at a point, or — with none, from a method or an invoker command — over the area it
// wraps: the host draws no box of its own (`display: contents`), so its first element's.
// A line comment, not JSDoc: the element's API describes `show` as the TypeScript version's did.
function show(clientX?: number, clientY?: number): void {
  if (typeof clientX === 'number' && typeof clientY === 'number') { openAt(clientX, clientY); return; }
  const area = (host.firstElementChild as HTMLElement | null)?.getBoundingClientRect();
  openAt(area ? area.left + area.width / 2 : 0, area ? area.top + area.height / 2 : 0);
}

function toggle(clientX?: number, clientY?: number) { if (opened.peek()) close(); else show(clientX, clientY); }

function isOpen() { return opened as boolean; }

function destroy(): void {
  close();
  if (panelEl) {
    panelEl.remove();
    panelEl = null;
  }
}

// ─── Build ───────────────────────────────────────────
// Once, a frame after mount. The handlers below read `disabled` at event time, so a change of it
// takes effect without tearing the panel down.
onNextFrame(() => {
  host.style.display = 'contents';

  // Create panel (appended to body for correct z-index)
  panelEl = document.createElement('div');
  panelEl.className = 'pdx-context-menu-panel pdx-menu';
  panelEl.dataset.part = 'root';
  panelEl.setAttribute('role', 'menu');
  uiAttr(panelEl, 'aria-label', () => uiString('context-menu', 'label'));
  panelEl.style.display = 'none';
  document.body.appendChild(panelEl);

  // Right-click handler — reads disabled at event time, not closure time
  host.addEventListener('contextmenu', (e: Event) => {
    if (disabled) return;
    const me = e as MouseEvent;
    me.preventDefault();
    // Open, or — already open — move to the new point.
    openAt(me.clientX, me.clientY);
  });

  // Long-press for mobile (500ms)
  let longPressTimer: number | null = null;
  let longPressPos = { x: 0, y: 0 };
  host.addEventListener('pointerdown', (e: Event) => {
    if (disabled) return;
    const pe = e as PointerEvent;
    if (pe.pointerType !== 'touch') return;
    longPressPos = { x: pe.clientX, y: pe.clientY };
    longPressTimer = window.setTimeout(() => {
      openAt(longPressPos.x, longPressPos.y);
    }, 500);
  });
  host.addEventListener('pointerup', () => {
    if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
  });
  host.addEventListener('pointermove', (e: Event) => {
    const pe = e as PointerEvent;
    if (longPressTimer && (Math.abs(pe.clientX - longPressPos.x) > 10 || Math.abs(pe.clientY - longPressPos.y) > 10)) {
      clearTimeout(longPressTimer); longPressTimer = null;
    }
  });

  // Keyboard triggers: Shift+F10 and the ContextMenu key, on a focusable element
  // inside the area — an area with nothing focusable cannot be opened this way.
  host.addEventListener('keydown', (e: Event) => {
    if (disabled) return;
    const ke = e as KeyboardEvent;
    if ((ke.key === 'F10' && ke.shiftKey) || ke.key === 'ContextMenu') {
      ke.preventDefault();
      const rect = (ke.target as HTMLElement).getBoundingClientRect();
      openAt(rect.left + rect.width / 2, rect.top + rect.height / 2);
    }
  });
});

// Teardown on destroy only (not on prop change).
onDestroy(destroy);
</script>

<template>
  <div class="pdx-input-wrap" data-part="root">
    <input class="pdx-input" data-part="input" :ref="inputEl"
      type="text"
      autocomplete="off"
      data-lpignore="true"
      data-1p-ignore=""
      data-form-type="other"
      ::value="displayValue"
      :placeholder="getPlaceholder()"
      :inputmode="getInputmode()"
      :disabled="disabled"
      :aria-label="ariaLabel || null"
      :aria-invalid="error || !isValid() ? 'true' : null"
      @input="onInput"
      @focus="onFocus"
      @blur="onBlur" />
  </div>
</template>

<script>
/**
 * An input that formats what the user types to a pattern, a built-in preset such as phone, card or
 * date, or a custom one.
 *
 * @csspart root - The frame: border, background and the states' colours.
 * @csspart input - The native `<input>` that shows the masked text.
 *
 * @cssstate invalid - `error` is set, or a complete date or time preset value is out of range.
 * @cssstate disabled - `disabled` is set.
 *
 * @alphaevent pdx-input
 * @alphaevent pdx-change
 * @alphadetail value $event.currentTarget.value
 * @alphadetail formatted $event.currentTarget.getFormatted()
 * @alphadetail valid $event.currentTarget.isValid()
 * @alphacommit pdx-change
 */
// pdx-masked-input — Input with pattern mask (phone, credit card, date, custom).
// Auto-formats as user types, manages cursor position around mask chars.
import { dispatchCommit } from '../shared/commit-change';
import { applyMask, outOfRange, patternFor, stripMask } from './masked-input-mask';

// Typing writes it (#479), unmasked, and the write dispatches `value-change`, live. The commit, on blur
// or Enter, is the inner input's native `change`, which bubbles to the host. What the alpha events
// also carried, the formatted text and whether it is in range, the element answers itself:
// `getFormatted()` and `isValid()`.
/** The value. A form submits it, and an empty entry when it is empty, as a text input does (#135). */
@model value: string = '' { form };
/** The textbox received focus. */
@event 'pdx-focus': void;
/** The textbox lost focus. */
@event 'pdx-blur': void;
// The visual states, on the host as custom states (#132), as pdx-input's.
@state invalid = !!error || !isValid();
@state disabled = !!disabled;
@part root, input;
// The axis inputs.css keys by (#627), reflected on the host; each value maps the class that draws
// the same size on a native field. `md` is the base look, which no class adds to.
@variants {
  /** xs, sm, md (the default), lg or xl — the same scale as pdx-input. */
  size: { md: '.pdx-input-md', xs: '.pdx-input-xs', sm: '.pdx-input-sm', lg: '.pdx-input-lg', xl: '.pdx-input-xl' } = md;
}
/**
 * Mask pattern: # = digit, A = letter, * = any. Or a preset: phone, phone-intl (a 1-3 digit
 * country code, read from its prefix), card, date (MM/DD/YYYY), time (HH:MM), ssn, zip,
 * zip-ext. A complete date or time out of range sets aria-invalid.
 */
@prop mask: string = '';
@prop placeholder: string = '';
@prop ariaLabel: string = '';
@prop disabled: boolean = false;
@prop error: boolean = false;
@prop name: string = '';
/** Character shown for unfilled positions */
@prop placeholderChar: string = '_';

// The host is the one submitter: the unmasked value, under the host's name. A form-associated
// element is in FormData under its `name` ATTRIBUTE, so a `:name` binding that sets the property
// must reach the attribute. The inner input carries no name, or it would send the masked text too.
@host { :name="name || null" }

// Imperative API: focus/blur/clear
@expose focus, blur, clear, selectText, getFormatted, isValid;

let inputEl = $signal(null);
let displayValue = $signal('');
/** Bumped by every write to the field; a frame with a stale token does not write. */
let writeGen = 0;

function onInput(e: Event) {
  const input = e.target as HTMLInputElement;
  const masked = applyMask(mask as string, input.value);
  displayValue = masked;

  // Restore cursor position.
  //
  // The frame carries a generation token, and a stale one drops its write. Without it the
  // frame puts back the value captured when it was scheduled, undoing anything that has
  // changed the field since — typing, then clear(), would leave the field reading what had
  // been typed, because the keystroke's frame lands after and writes it again. Two
  // keystrokes in one frame are safe on their own (the later frame runs last and wins); a
  // write that does NOT come through here is not. (See renderGen in core's
  // renderer/helpers.ts for the same guard against the same class.)
  const gen = ++writeGen;
  requestAnimationFrame(() => {
    if (input && gen === writeGen) input.value = masked;
  });

  // `value` is the unmasked value, as the model is read (applyMask(value) is the display).
  value = stripMask(mask as string, masked);
}

/** False while a complete date or time preset value is out of range. */
function isValid(): boolean {
  return !outOfRange(mask as string, stripMask(mask as string, displayValue as string));
}

function onFocus() { pdxFocus(); }
function onBlur() { pdxBlur(); }

function getPlaceholder(): string {
  if (placeholder) return placeholder as string;
  const pattern = patternFor(mask as string);
  if (!pattern) return '';
  const pc = placeholderChar as string || '_';
  return pattern.replace(/#|A|\*/g, pc);
}

function getInputmode(): string {
  const pattern = patternFor(mask as string);
  if (!pattern) return 'text';
  // Digit slots and literals only: a numeric keyboard. The colon is in the set, or the time
  // preset would open a text keyboard for a field that takes only digits.
  return /^[#\s\-()/.+:]+$/.test(pattern) ? 'numeric' : 'text';
}

$effect(() => {
  const propVal = value as string;
  if (propVal) displayValue = applyMask(mask as string, propVal);
});

function focus() { inputEl?.focus(); }
function blur() { inputEl?.blur(); }
function clear() {
  // Invalidate any frame a keystroke left pending, or it writes the old value back
  // after this line.
  writeGen++;
  displayValue = '';
  const inp = inputEl as HTMLInputElement | null;
  if (inp) inp.value = '';
  // A commit no typing produced: the model's write, then the native change a commit makes.
  value = '';
  dispatchCommit(inp);
}
/** Select the whole text, so the next keystroke replaces it. Does not focus first. */
function selectText() { inputEl?.select(); }
/** The value as shown, with the mask's literals: `(555) 123-4567` for `5551234567`. */
function getFormatted(): string { return displayValue as string; }
</script>

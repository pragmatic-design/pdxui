<template>
  <div class="pdx-dialog-backdrop" data-part="backdrop" @click="onBackdropClick">
    <div class="pdx-dialog-panel" data-part="root" role="dialog" aria-modal="true" :ref="panelEl"
      :aria-label="title || uiString('dialog', 'label')"
      :aria-busy="loading ? 'true' : null">
      <div class="pdx-dialog-header" data-part="header">
        <span>{{ title }}</span>
        @if (showClose) {
          <button type="button" class="pdx-dialog-close" data-part="close" :aria-label="uiString('dialog', 'close')" @click="tryClose()">✕</button>
        }
      </div>
      <div class="pdx-dialog-body" data-part="body">
        <slot></slot>
      </div>
      <div class="pdx-dialog-footer" data-part="footer">
        <slot name="footer"></slot>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * Modal dialog with backdrop, focus trap and Escape-to-close.
 *
 * @summary Modal window: overlay with focus trap, z-index managed via overlayStack, Escape-to-close.
 * @slot - The dialog body (main content).
 * @slot footer - Action area at the bottom (e.g. Confirm/Cancel); hidden automatically when empty.
 */
// pdx-dialog — Modal dialog with backdrop, focus trap, Escape close.
// Uses overlayStack for z-index management and Escape coordination.
// Same pattern as pdx-drawer: backdrop + panel in the template, CSS visibility.
import { focusTrap, generatedId, onNextFrame, overlayStack } from '@pdxui/core';
import type { Dispose } from '@pdxui/core';
import { uiString } from '../shared/i18n';
import { holdModalFocus } from '../shared/modal-focus';
// This component's styles travel with it, so an app ships the CSS of what it renders
// and no more.
import '@pdxui/design/components/dialog';
// The entry `@pdxui/ui/dialog` gives the programmatic API as well as the element (#1352).
export { dialog, getDialogQueue } from './dialog-service';

// `open` is a model (#288): the dialog closes itself — Escape, the backdrop, its close button — and
// its own writes announce `open-change` `{ value }`, which `::open` follows. It replaced `pdx-close`.
@model open: boolean = false;
/** Fired (cancelable) before closing; call preventDefault() to block it. */
@event(cancelable) 'pdx-before-close': void;
// On the host as custom states (#132, #288): the design CSS draws the backdrop and the body's scroll
// shadows from them, and neither carries an attribute or a class for it.
@state open = shown;
@state loading = !!loading;
@state scroll-top = atTop;
@state scroll-bottom = atBottom;
// `backdrop`, `body` and `footer` are read by the script as their elements; the panel, the root
// part, is `panelEl`.
@part root, backdrop, header, close, body, footer;
// The axis dialog.css keys by (#633), reflected on the host and drawn on the panel, the root part;
// each value maps the class that draws the same panel elsewhere (pdx-alert-dialog, the overlay
// outlet, native markup).
@variants {
  /** sm, md (the default), lg, xl or full. */
  size: { md: '.pdx-dialog-md', sm: '.pdx-dialog-sm', lg: '.pdx-dialog-lg', xl: '.pdx-dialog-xl', full: '.pdx-dialog-full' } = md;
}
@prop title: string = '';
@prop closeOnBackdrop: boolean = true;
@prop closeOnEscape: boolean = true;
@prop showClose: boolean = true;
@prop initialfocus: string = '';
@prop preventClose: boolean = false;
/** Show loading state */
@prop loading: boolean = false;
@host host;

// Imperative API: el.show() / el.close() / el.toggle() / el.isOpen.
// `show` (not `open`) to avoid shadowing the boolean `open` model — mirrors native <dialog>.
// Each writes the model, so each announces `open-change`.
@expose show, close, toggle, isOpen;

let panelEl = $signal<HTMLElement | null>(null);
/** The `open` state: set a frame after the backdrop is placed, so the design CSS animates it in. */
let shown = $signal(false);
let atTop = $signal(false);
let atBottom = $signal(false);
/** Read-only, via a ref: `el.isOpen`. */
const isOpen = $derived(open as boolean);

let trapDispose: Dispose | null = null;
let dismissDispose: Dispose | null = null;
let overlayId = '';
let scrollCleanup: (() => void) | null = null;
let rafId = 0;
let innerRafId = 0;

/**
 * A close attempt.
 *
 * `byUser` is every way the person in front of the screen can dismiss the dialog — Escape,
 * the backdrop, the ✕. `prevent-close` blocks exactly those and nothing else: `close()` is
 * the AUTHOR asking, and it is answered, or the prop would leave a consumer with no way out
 * except assigning `open = false` and a `close()` method that lies.
 *
 * `pdx-before-close` fires either way: blocking silently would be worse than closing,
 * because an app that wants "you have unsaved changes" needs to know the attempt happened.
 */
function tryClose(byUser = true): void {
  // Always emit cancelable before-close — consumer decides whether to block. It stays on the
  // dialog, as no undeclared event bubbles (#138).
  if (!pdxBeforeClose()) return;
  if (byUser && preventClose as boolean) return;
  open = false;
}

function onBackdropClick(e: MouseEvent): void {
  if (closeOnBackdrop && e.target === e.currentTarget) tryClose();
}

function show(): void { open = true; }
// The author asking, so it is not blocked by prevent-close (see tryClose).
function close(): void { tryClose(false); }
function toggle(): void { if (open) tryClose(false); else open = true; }

function setupScrollShadow(el: HTMLElement): () => void {
  function update() {
    const { scrollTop, scrollHeight, clientHeight } = el;
    atTop = scrollTop > 4;
    atBottom = scrollTop + clientHeight < scrollHeight - 4;
  }
  el.addEventListener('scroll', update, { passive: true });
  requestAnimationFrame(update);
  return () => {
    el.removeEventListener('scroll', update);
    atTop = false;
    atBottom = false;
  };
}

function focusInitial(): void {
  // Search in the host (Light DOM: slot content is under host, not panel)
  const sel = initialfocus as string;
  if (sel) {
    const target = host.querySelector(sel) as HTMLElement;
    if (target) { target.focus(); return; }
  }
  // Default: first focusable inside the dialog body
  const body = host.querySelector('.pdx-dialog-body');
  if (body) {
    const first = body.querySelector(
      'button:not(.pdx-dialog-close), [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    ) as HTMLElement;
    if (first) { first.focus(); return; }
  }
  // Fallback: close button
  const closeBtn = host.querySelector('.pdx-dialog-close') as HTMLElement;
  if (closeBtn) closeBtn.focus();
}

function release(): void {
  if (trapDispose) { trapDispose(); trapDispose = null; }
  if (dismissDispose) { dismissDispose(); dismissDispose = null; }
  if (scrollCleanup) { scrollCleanup(); scrollCleanup = null; }
  if (overlayId) { overlayStack.pop(overlayId); overlayId = ''; }
}

// A click on the backdrop or on the dialog's text keeps focus inside.
onNextFrame(() => {
  const backdropNow = backdrop, panel = panelEl;
  if (backdropNow && panel) holdModalFocus(backdropNow, panel);
});

$effect(() => {
  const isOpenNow = open as boolean;

  // Cancel any pending open/close frame to prevent race conditions
  if (rafId) { cancelAnimationFrame(rafId); rafId = 0; }
  if (innerRafId) { cancelAnimationFrame(innerRafId); innerRafId = 0; }
  rafId = requestAnimationFrame(() => {
    rafId = 0;
    const backdropNow = backdrop, panel = panelEl;
    if (isOpenNow) {
      overlayId = generatedId('pdx-dialog');
      const zIndex = overlayStack.push(overlayId, { modal: true });
      if (backdropNow) backdropNow.style.zIndex = String(zIndex);

      // Animate in next frame (tracked for cancellation)
      innerRafId = requestAnimationFrame(() => {
        innerRafId = 0;
        // A frame after the backdrop is placed, so the design CSS animates it in.
        shown = true;
        if (panel) {
          trapDispose = focusTrap(panel, { restoreFocus: true, escapeDeactivates: false });
          // Focus after trap initializes (next microtask)
          setTimeout(() => focusInitial(), 0);
        }
        // Hide footer if no slotted content
        const footerNow = footer;
        if (footerNow) footerNow.style.display = host.querySelector('[slot="footer"]') ? '' : 'none';
        // Scroll shadow
        const bodyNow = body;
        if (bodyNow) scrollCleanup = setupScrollShadow(bodyNow);
      });

      if (closeOnEscape) {
        dismissDispose = overlayStack.onDismissTop(() => tryClose());
      }
    } else {
      // Close
      shown = false;
      release();
    }
  });

  return release;
});
</script>

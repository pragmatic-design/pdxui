<template><slot></slot></template>

<script>
/**
 * Highlights the navigation link of the section currently visible, as the user scrolls.
 *
 * @alphaevent pdx-change
 * @alpharename pdx-change section-change
 * @alphadetail section $event.detail.value
 */
// pdx-scroll-spy — Highlights navigation items based on which section is in view.
// Uses IntersectionObserver for efficient scroll detection.
// pdx-ignore-file PDX_DOCUMENT_QUERY: the sections and links it watches are the page's, outside the component, found by the selectors the app passes
import { untracked } from '@pdxui/core';

// The section in view is a read-only output (#289): announced like a model's event, `{ value }`,
// but the app cannot write it, so it is no model and `::section` stays an error.
/** The section in view changed: its `data-section`, or its id. */
@event 'section-change': { value: string };
/** CSS selector for sections to observe */
@prop sectionSelector: string = '[data-section]';
/** CSS selector for nav links to highlight */
@prop linkSelector: string = '[data-spy-link]';
/** Offset from top for activation threshold (px) */
@prop offset: number = 100;
/** Smooth scroll to section on link click */
@prop smoothScroll: boolean = true;

@expose getActiveSection;

let activeSection = $signal('');
let observer: IntersectionObserver | null = null;
// Unbind of the links' click handlers: without it they would pile up on every run of the
// effect and stay on the links (which live outside the component) after the destroy.
const linkUnbinds: Array<() => void> = [];

/** The id of the section marked active, or '' before the first measurement. */
function getActiveSection(): string {
  return untracked(() => activeSection);
}

function updateLinks(activeId: string, links: string): void {
  document.querySelectorAll(links).forEach(link => {
    const target = link.getAttribute('href')?.replace('#', '') ||
      link.getAttribute('data-spy-target') || '';
    // The links are the app's: the current one is marked by its aria-current alone, which
    // the app's CSS selects; no class is written on them (#289).
    if (target === activeId) {
      // 'page' is the semantically correct value for a link to the current section or page
      // (consistent with nav-menu/breadcrumb), not the generic 'true'.
      link.setAttribute('aria-current', 'page');
    } else {
      link.removeAttribute('aria-current');
    }
  });
}

function unbindLinks(): void {
  for (const un of linkUnbinds) un();
  linkUnbinds.length = 0;
}

// The observer and the links' handlers, a frame after each change; the effect's cleanup removes
// both, on the next run and on destroy.
$effect(() => {
  const sections = sectionSelector as string;
  const links = linkSelector as string;
  const top = offset as number;
  const smooth = smoothScroll as boolean;

  requestAnimationFrame(() => {
    // Cleanup previous observer
    if (observer) { observer.disconnect(); observer = null; }

    const found = document.querySelectorAll(sections);
    if (!found.length) return;

    // IntersectionObserver to track visible sections
    observer = new IntersectionObserver((entries) => {
      let topSection = '';
      let topY = Infinity;

      for (const entry of entries) {
        if (entry.isIntersecting) {
          const rect = entry.boundingClientRect;
          if (rect.top < topY) {
            topY = rect.top;
            topSection = entry.target.getAttribute('data-section') || entry.target.id || '';
          }
        }
      }

      // Announced when the section changes, not on every pass of the observer.
      if (topSection && topSection !== untracked(() => activeSection)) {
        activeSection = topSection;
        updateLinks(topSection, links);
        sectionChange({ value: topSection });
      }
    }, {
      rootMargin: `-${top}px 0px -50% 0px`,
      threshold: 0,
    });

    found.forEach(s => observer!.observe(s));

    // Bind link clicks for smooth scroll (named handlers + unbind)
    unbindLinks();
    if (smooth) {
      document.querySelectorAll(links).forEach(link => {
        const onLinkClick = (e: Event) => {
          const target = link.getAttribute('href')?.replace('#', '') ||
            link.getAttribute('data-spy-target') || '';
          const section = document.getElementById(target) ||
            document.querySelector(`[data-section="${target}"]`);
          if (section) {
            e.preventDefault();
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        };
        link.addEventListener('click', onLinkClick);
        linkUnbinds.push(() => link.removeEventListener('click', onLinkClick));
      });
    }
  });

  return () => {
    if (observer) { observer.disconnect(); observer = null; }
    unbindLinks();
  };
});
</script>

<template>
  <div :class="rootClass" data-part="root">
    @if (safeHref) {
      <a class="pdx-card-link" data-part="link" :href="safeHref" aria-hidden="true" tabindex="-1"></a>
    }
    @if (loading) {
      <div class="pdx-card-body">
        <div class="pdx-skeleton" style="height:1rem;width:60%;margin-bottom:var(--pdx-space-sm)"></div>
        <div class="pdx-skeleton" style="height:0.75rem;width:100%;margin-bottom:var(--pdx-space-xs)"></div>
        <div class="pdx-skeleton" style="height:0.75rem;width:80%"></div>
      </div>
    } @else {
      <slot></slot>
    }
  </div>
</template>

<script>
/**
 * A structured card with header, body, footer and media slots, which can show a loading skeleton
 * and be clickable or selectable.
 *
 * @csspart root - The card's box (`.pdx-surface-card`); the header, body and footer inside it are your markup.
 * @csspart link - The `<a>` laid across the card when it has an `href`.
 * @cssstate horizontal - `horizontal` is set: media beside the body.
 * @cssstate compact - `compact` is set: tighter sections.
 * @cssstate hoverable - It lifts on hover: `hoverable`, `clickable` or an `href`.
 * @cssstate clickable - It is pressed or followed as a whole: `clickable` or an `href`.
 * @cssstate selected - `selected` is set.
 * @cssstate disabled - `disabled` is set.
 * @cssstate loading - `loading` is set: a skeleton in place of the content, and `aria-busy`.
 */
// pdx-card — Structured card with header/body/footer/media slots.
// Enhances Pragmatic CSS cards with: loading skeleton, clickable, selectable, link overlay.
import { sanitizeUrl } from '@pdxui/core';

// `selected` is the app's to write — the card announces a click, it never selects itself — so it
// is a prop, not a model (#290). Its looks are states on the host, which base.css draws on the
// root part beside the classes of CSS-only markup.
/** The card was clicked, or pressed with Enter or Space, as `clickable`. */
@event 'pdx-click': void;
// States, not classes on the box (#290). The elevation stays a class: it is a level, 0 to 4,
// not a state.
@state horizontal = !!horizontal;
@state compact = !!compact;
@state hoverable = !!(hoverable || clickable || href);
@state clickable = !!(clickable || href);
@state selected = !!selected;
@state disabled = !!disabled;
@state loading = !!loading;
@part root, link;
// The axis base.css keys by (#632), reflected on the host; each value maps the class that draws
// the same card on native markup. `default` is the base look.
@variants {
  /** default, outline, elevated or flat. */
  variant: { default: '.pdx-card-default', outline: '.pdx-card-outline', elevated: '.pdx-card-elevated', flat: '.pdx-card-flat' } = default;
}
/** Show loading skeleton state */
@prop loading: boolean = false;
/** Make entire card clickable (emits pdx-click) */
@prop clickable: boolean = false;
/** Hoverable elevation effect */
@prop hoverable: boolean = false;
/** Horizontal layout (media + content side by side) */
@prop horizontal: boolean = false;
/** Compact padding */
@prop compact: boolean = false;
/** Selectable card (radio/checkbox style). On a clickable card, announced as pressed (`aria-pressed`). */
@prop selected: boolean = false;
/** Disabled state */
@prop disabled: boolean = false;
/**
 * Makes the card a link: it renders an `<a>` overlay across the card, so middle-click,
 * open-in-a-new-tab, copy-link-address and the status bar all work, and the address is in
 * the DOM. An interactive element inside the card stays clickable (it sits above the
 * overlay). The URL is sanitised before it is written.
 */
@prop href: string = '';
/** Shadow elevation: 0 (none), 1 (sm), 2 (md), 3 (lg), 4 (xl) */
@prop elevation: number = -1;
@host host;

const rootClass = $derived('pdx-surface pdx-surface-card'
  + ((elevation as number) >= 0 ? ' pdx-card-elevation-' + elevation : ''));

/** The address the overlay carries, sanitised — an unsafe URL is never written to the DOM. */
const safeHref = $derived(href ? sanitizeUrl(href as string) : null);

function onClick(e: Event): void {
  if (disabled) return;
  const url = href as string;
  if (url) {
    // Don't navigate if clicking an interactive element inside
    const target = e.target as HTMLElement;
    if (target.closest('a, button, input, select, textarea')) return;
    // Never navigate to an unsafe URL (href may come from data → javascript:/data: = XSS).
    const safe = sanitizeUrl(url);
    if (safe) window.location.href = safe;
    return;
  }
  if (clickable) pdxClick();
}

/**
 * The keys go where the focus is — the host, which carries the role and the tab stop. On the
 * inner div a key on the focused host would never reach the listener, so Enter and Space would
 * do nothing, while Enter on a button inside the card would press the card too.
 * A link activates on Enter only; a button on Enter and Space.
 */
function onKeydown(e: KeyboardEvent): void {
  if (e.target !== host) return;
  if (!(clickable || href) || disabled) return;
  const isLink = !!href;
  if (e.key === 'Enter' || (!isLink && e.key === ' ')) {
    e.preventDefault();
    onClick(e);
  }
}

/**
 * Click and keydown both live on the HOST, which is what carries the role and the tab
 * stop. On the inner div — the element a real pointer hits — `card.click()` on the host
 * would reach nothing and the card would look inert to anything driving it
 * programmatically. A pointer click still arrives: it bubbles
 * from whatever was hit up to here.
 */
$effect(() => {
  const el = host;
  el.addEventListener('keydown', onKeydown);
  el.addEventListener('click', onClick);
  return () => {
    el.removeEventListener('keydown', onKeydown);
    el.removeEventListener('click', onClick);
  };
});

// Role, tab stop and state on the host. A disabled clickable card keeps its role and says
// so (aria-disabled), out of the tab order; loading is aria-busy; a selected clickable card
// is pressed.
$effect(() => {
  const el = host;
  const isInteractive = !!(clickable || href);
  const isLink = !!href;
  const isDisabled = !!disabled;
  const isLoading = !!loading;
  const isSelected = !!selected;
  requestAnimationFrame(() => {
    if (isInteractive) {
      el.setAttribute('role', isLink ? 'link' : 'button');
      if (isDisabled) el.removeAttribute('tabindex');
      else el.setAttribute('tabindex', '0');
    } else {
      el.removeAttribute('tabindex');
      el.removeAttribute('role');
    }
    if (isInteractive && isDisabled) el.setAttribute('aria-disabled', 'true');
    else el.removeAttribute('aria-disabled');
    if (isLoading) el.setAttribute('aria-busy', 'true');
    else el.removeAttribute('aria-busy');
    if (isInteractive && !isLink && isSelected) el.setAttribute('aria-pressed', 'true');
    else el.removeAttribute('aria-pressed');
  });
});
</script>

<template><slot></slot></template>

<script>
/**
 * A responsive app header holding the brand, the navigation links and the user's avatar with its
 * dropdown.
 *
 * @csspart bar - The row that holds the brand, the toggle, the nav and the actions.
 * @csspart brand - The brand's icon and text.
 * @csspart toggle - The button that opens the drawer while the navbar is collapsed.
 * @csspart nav - The `<nav>` of the links in the bar.
 * @csspart item - A link, in the bar or the drawer; the current one is `aria-current="page"`.
 * @csspart actions - The navbar's children, moved to the end of the bar.
 * @csspart drawer - The `<nav>` of the links shown under the bar while collapsed.
 * @cssstate sticky - `sticky` is set: it stays at the top as the page scrolls.
 * @cssstate compact - `compact` is set: the shorter bar.
 * @cssstate collapsed - Its bar does not fit its width: the links go behind the toggle.
 * @cssstate menu-open - The drawer is open.
 */
// pdx-navbar v2 — Responsive app header.
// Props for brand + nav. Discovers existing children for actions area.
// Responsive: hamburger + drawer on mobile breakpoint.
//
// Its DOM is built by the script, a frame after mount, as the TypeScript version built it.
import { sanitizeUrl, generatedId, onDestroy, onNextFrame, untracked } from '@pdxui/core';
import { uiString, uiAttr } from '../shared/i18n';
import type { NavbarItem } from './navbar-types';
// This component's styles travel with it, so an app ships the CSS of what it renders
// and no more.
import '@pdxui/design/components/navbar';

// Nothing the navbar holds is read back by the app: no model (#289).
/** A link was chosen: its `key` and its item. */
@event 'pdx-select': { key: string; item: NavbarItem };
// States, not classes (#289). With no `.pdx-navbar` class the media query of the CSS-only markup
// does not reach it: it collapses on its own width.
@state sticky = !!sticky;
@state compact = !!compact;
@state collapsed = isCollapsed;
@state menu-open = mobileOpen;
// Every element is built by the script, a frame after mount (#1284).
@part(external) bar, brand, toggle, nav, item, actions, drawer;
/** Brand text */
@prop brand: string = '';
/** Brand icon name */
@prop(icon) brandIcon: string = '';
/** Navigation items */
@prop items: unknown[] = [];
/** Sticky */
@prop sticky: boolean = false;
/** Compact height */
@prop compact: boolean = false;
/**
 * The navigation landmark's name. Empty: the navbar.mainNav component string, «Main
 * navigation». Give each navbar on a page its own: a sub-nav, a footer nav.
 */
@prop label: string = '';
@host el;

@expose toggleMobile;

let mobileOpen = $signal(false);
let isCollapsed = $signal(false);
let built = false;
// Cleared on destroy: a frame after it touches nothing.
let alive = true;
let hamburgerEl: HTMLButtonElement | null = null;
let drawerEl: HTMLElement | null = null;
const menuId = `${generatedId('pdx-navbar')}-menu`;

/** `pdx-icon` the first time the brand or an item names an icon: a use that draws none never pays for the icon set. */
function loadIcon(): void {
  if (!customElements.get('pdx-icon')) void import('../icon/pdx-icon.pdx');
}

function setMobile(open: boolean): void {
  // A state, not a class on the drawer (#289): navbar.css shows the drawer from it.
  mobileOpen = open;
  if (hamburgerEl) hamburgerEl.setAttribute('aria-expanded', String(open));
}

/** Open or close the mobile menu, moving focus into it when it opens. */
function toggleMobile(): void {
  const next = !untracked(() => mobileOpen);
  setMobile(next);
  // Into the menu it opened, not left on the toggle.
  if (next) (drawerEl?.querySelector('a') as HTMLElement | null)?.focus();
}

// Escape closes the menu and returns to its toggle.
el.addEventListener('keydown', (e: KeyboardEvent) => {
  if (e.key !== 'Escape' || !untracked(() => mobileOpen)) return;
  e.preventDefault();
  setMobile(false);
  hamburgerEl?.focus();
});

function navName(): string {
  return (label as string) || uiString('navbar', 'mainNav');
}

// ── Collapse on the navbar's own width ──
// Not a viewport media query: at 768px of window a navbar in a column, a sidebar layout or a
// dialog would never collapse, and its actions would run past the edge. It collapses when its bar overflows, and expands again once the width
// it needed is back. The media query stays for the CSS-only `.pdx-navbar` markup.
let neededWidth = 0;
function barOverflows(barEl: HTMLElement): boolean {
  return barEl.scrollWidth > barEl.clientWidth + 1;
}
function fit(): void {
  const barEl = el.querySelector(':scope > .pdx-navbar-bar') as HTMLElement | null;
  if (!barEl) return;
  if (!untracked(() => isCollapsed)) {
    if (barOverflows(barEl)) { neededWidth = barEl.scrollWidth; setCollapsed(true); }
    return;
  }
  if (barEl.clientWidth < neededWidth) return;
  setCollapsed(false);
  if (barOverflows(barEl)) { neededWidth = barEl.scrollWidth; setCollapsed(true); }
}
function setCollapsed(value: boolean): void {
  isCollapsed = value;
  // An open menu does not outlive the collapse that showed its toggle.
  if (!value && untracked(() => mobileOpen)) setMobile(false);
}
let resizeObserver: ResizeObserver | null = null;

function buildNavItems(list: NavbarItem[], container: HTMLElement): void {
  for (const it of list) {
    const a = document.createElement('a');
    a.className = 'pdx-navbar-link';
    a.setAttribute('data-part', 'item');
    // The current link is its aria-current, which navbar.css selects: no class (#289).
    if (it.active) a.setAttribute('aria-current', 'page');
    // An item with no (safe) href is still a link: `#`, and the click below keeps it from
    // navigating. With no href the <a> is not a link and takes no focus — keyboard users
    // could not reach the app navigation.
    const safeHref = sanitizeUrl(it.href);
    a.href = safeHref || '#';
    a.setAttribute('data-nav-key', it.key);
    if (it.icon) {
      loadIcon();
      const icon = document.createElement('pdx-icon');
      icon.setAttribute('name', it.icon);
      icon.setAttribute('size', '16');
      a.appendChild(icon);
    }
    a.appendChild(document.createTextNode(it.label));
    a.addEventListener('click', (e) => {
      if (!it.href || it.href === '#') e.preventDefault();
      pdxSelect({ key: it.key, item: it });
      setMobile(false);
    });
    container.appendChild(a);
  }
}

// A frame after mount: a setup a move destroyed does not build again.
onNextFrame(() => {
  const list = items as NavbarItem[];
  const brandText = brand as string;
  const brandIconName = brandIcon as string;
  const name = navName();
  el.setAttribute('role', 'banner');

  // Capture any existing children (actions area) before restructuring
  const existingChildren = Array.from(el.childNodes);

  const barEl = document.createElement('div');
  barEl.className = 'pdx-navbar-bar';
  barEl.setAttribute('data-part', 'bar');

  // Brand
  if (brandText || brandIconName) {
    const brandEl = document.createElement('div');
    brandEl.className = 'pdx-navbar-brand';
    brandEl.setAttribute('data-part', 'brand');
    if (brandIconName) {
      loadIcon();
      const icon = document.createElement('pdx-icon');
      icon.setAttribute('name', brandIconName);
      icon.setAttribute('size', '22');
      brandEl.appendChild(icon);
    }
    if (brandText) {
      const txt = document.createElement('strong');
      txt.textContent = brandText;
      brandEl.appendChild(txt);
    }
    barEl.appendChild(brandEl);
  }

  // Hamburger
  hamburgerEl = document.createElement('button');
  hamburgerEl.type = 'button';
  hamburgerEl.className = 'pdx-navbar-hamburger';
  hamburgerEl.setAttribute('data-part', 'toggle');
  uiAttr(hamburgerEl, 'aria-label', () => uiString('navbar', 'toggle'));
  hamburgerEl.setAttribute('aria-expanded', 'false');
  hamburgerEl.setAttribute('aria-controls', menuId);
  hamburgerEl.innerHTML = '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>';
  hamburgerEl.addEventListener('click', toggleMobile);
  barEl.appendChild(hamburgerEl);

  // Desktop nav
  const navEl = document.createElement('nav');
  navEl.className = 'pdx-navbar-nav';
  navEl.setAttribute('data-part', 'nav');
  navEl.setAttribute('role', 'navigation');
  navEl.setAttribute('aria-label', name);
  buildNavItems(list, navEl);
  barEl.appendChild(navEl);

  // Spacer
  const spacer = document.createElement('div');
  spacer.className = 'pdx-navbar-spacer';
  barEl.appendChild(spacer);

  // Actions: move existing children here
  if (existingChildren.length > 0) {
    const actionsEl = document.createElement('div');
    actionsEl.className = 'pdx-navbar-actions';
    actionsEl.setAttribute('data-part', 'actions');
    for (const child of existingChildren) {
      actionsEl.appendChild(child);
    }
    barEl.appendChild(actionsEl);
  }

  el.appendChild(barEl);

  // Mobile drawer: the same navigation, so the same landmark and name. Only one of
  // the two is ever displayed.
  drawerEl = document.createElement('nav');
  drawerEl.className = 'pdx-navbar-drawer';
  drawerEl.setAttribute('data-part', 'drawer');
  drawerEl.id = menuId;
  drawerEl.setAttribute('aria-label', name);
  buildNavItems(list, drawerEl);
  el.appendChild(drawerEl);

  if (typeof ResizeObserver !== 'undefined') {
    resizeObserver = new ResizeObserver(() => fit());
    resizeObserver.observe(el);
    // Its content too: a search that widens or a name that grows needs no host resize.
    for (const part of barEl.querySelectorAll(':scope > .pdx-navbar-nav, :scope > .pdx-navbar-actions')) {
      resizeObserver.observe(part);
    }
  }
  built = true;
});

// Rebuild on prop changes: the links and the landmark's name.
$effect(() => {
  const list = items as NavbarItem[];
  const name = navName();
  if (!built) return;
  requestAnimationFrame(() => {
    if (!alive) return;
    const navEl = el.querySelector('.pdx-navbar-nav') as HTMLElement | null;
    if (navEl) { navEl.innerHTML = ''; buildNavItems(list, navEl); navEl.setAttribute('aria-label', name); }
    if (drawerEl) { drawerEl.innerHTML = ''; buildNavItems(list, drawerEl); drawerEl.setAttribute('aria-label', name); }
    // New items need a new measure: expanded first, then collapse again if they overflow.
    setCollapsed(false);
    fit();
  });
});

onDestroy(() => {
  alive = false;
  resizeObserver?.disconnect();
  resizeObserver = null;
});
</script>

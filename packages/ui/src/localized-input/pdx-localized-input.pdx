<template>
  <div class="pdx-localized-input" data-part="root" role="group" :aria-label="fieldName" :data-layout="layout">
    @if (tabbed) {
      <div class="pdx-localized-tabs" data-part="tabs" role="tablist" :aria-label="uiString('localized-input', 'languages')">
        @for (shown as culture; track culture) {
          <button type="button" class="pdx-localized-tab" data-part="tab" role="tab" :id="idOf('tab', culture)" :lang="culture"
            :aria-selected="String(culture === active)" :aria-controls="idOf('panel', culture)"
            :tabindex="culture === active ? 0 : -1" :disabled="disabled" :aria-label="tabNameOf(culture)"
            @click="select(culture)" @keydown="onTabKey($event, culture)">@if (flags && flagOf(culture)) {<pdx-flag class="pdx-localized-flag" :region="flagOf(culture)" size="sm" decorative></pdx-flag>}{{ cultureName(culture) }}@if (missingOf(culture)) {<span class="pdx-localized-marker" data-part="marker" aria-hidden="true"></span>}</button>
        }
      </div>
    }
    @if (flagLayout) {
      <pdx-dropdown-menu class="pdx-localized-culture-menu" :items="cultureItems" placement="bottom-start" @pdx-check="onCultureMenu($event)" :ref="cultureMenuEl">
        <button slot="trigger" type="button" class="pdx-localized-culture-button" data-part="cultureButton" :disabled="disabled"
          :aria-label="format(uiString('localized-input', 'language'), { language: tabNameOf(active) })">@if (flagOf(active)) {<pdx-flag class="pdx-localized-flag" :region="flagOf(active)" size="sm" decorative></pdx-flag>} @else {<span class="pdx-localized-culture-code">{{ codeOf(active) }}</span>}@if (missingOf(active)) {<span class="pdx-localized-marker" data-part="marker" aria-hidden="true"></span>}</button>
        @snippet item(it) {
          @if (flagOf(it.key)) {<pdx-flag class="pdx-localized-flag" :region="flagOf(it.key)" size="sm" decorative></pdx-flag>} @else if (anyFlag) {<span class="pdx-localized-flag-space" aria-hidden="true"></span>}
          <span class="pdx-menu-item-label">{{ it.label }}@if (missingOf(it.key)) {<span class="pdx-sr-only">, {{ uiString('localized-input', 'missing') }}</span>}</span>
          @if (missingOf(it.key)) {<span class="pdx-localized-marker" aria-hidden="true"></span>}
        }
      </pdx-dropdown-menu>
    }
    @for (shown as culture; track culture) {
      <div :class="stacked ? 'pdx-localized-row' : 'pdx-localized-panel'" data-part="panel" :id="idOf('panel', culture)"
        :role="tabbed ? 'tabpanel' : null" :aria-labelledby="tabbed ? idOf('tab', culture) : null"
        :hidden="!stacked && culture !== active">
        @if (stacked) {
          <span class="pdx-localized-row-label" aria-hidden="true" :lang="culture">@if (flags && flagOf(culture)) {<pdx-flag class="pdx-localized-flag" :region="flagOf(culture)" size="sm" decorative></pdx-flag>}{{ cultureName(culture) }}@if (missingOf(culture)) {<span class="pdx-localized-marker"></span>}</span>
        }
        @if (multiline) {
          <textarea class="pdx-input" data-part="field" :lang="culture" :dir="directionOf(culture)" :rows="rows"
            :defaultValue="mountedTextOf(culture)" :value="textOf(culture)" :placeholder="placeholderOf(culture)" :disabled="disabled" :readonly="readonly"
            :aria-label="nameOf(culture)" :aria-invalid="error ? 'true' : null" @input="write(culture, $event)"></textarea>
        } @else {
          <input type="text" class="pdx-input" data-part="field" :lang="culture" :dir="directionOf(culture)"
            :defaultValue="mountedTextOf(culture)" :value="textOf(culture)" :placeholder="placeholderOf(culture)" :disabled="disabled" :readonly="readonly"
            :aria-label="nameOf(culture)" :aria-invalid="error ? 'true' : null" @input="write(culture, $event)" />
        }
        @if (expandable && !stacked) {
          <button type="button" class="pdx-localized-expand" data-part="expandButton" :disabled="disabled" aria-haspopup="dialog"
            :aria-label="uiString('localized-input', 'allLanguages')" :title="uiString('localized-input', 'allLanguages')" @click="expanded = true"><pdx-icon name="maximize" size="sm"></pdx-icon></button>
        }
      </div>
    }
    @if (expandable && !stacked) {
      <pdx-dialog class="pdx-localized-dialog" :open="expanded" :title="fieldName" size="lg" @open-change="onExpandedChange($event)">
        <pdx-localized-input layout="stacked" :cultures="cultures" :regions="regions" :flags="flags" :multiline="multiline" :rows="rows"
          :label="fieldName" :default-culture="defaultCulture" :disabled="disabled" :readonly="readonly"
          :value="value" @value-change="onDialogValue($event)"></pdx-localized-input>
      </pdx-dialog>
    }
  </div>
</template>

<script>
/**
 * One text in several cultures, `{ [culture]: string }` — the shape of Pragmatic's LocalizedString. The
 * cultures are tabs named in their own language, the current one first, a culture with no text marked
 * in its tab's name; or, `layout="stacked"`, every culture a labelled field; or, `layout="flag"`, one
 * field whose prefix, the active culture's flag, opens a menu of the cultures. `flags` draws a culture's
 * flag beside its name, decorative: the region is the culture's subtag or `regions`' entry, and a bare
 * language with neither shows none. Each field carries its culture's `lang` and `dir`. `required` asks
 * every culture, or with `required-scope="default"` the default one; the form submits the value's JSON.
 *
 * @csspart root - The field, `role="group"` named by the label.
 * @csspart tabs - The tablist of the cultures.
 * @csspart tab - A culture's tab, named in its own language.
 * @csspart cultureButton - The flag layout's prefix: the active culture's flag (its code when it has none), a menu button.
 * @csspart marker - The dot of a culture with no text.
 * @csspart expandButton - `expandable`: the button in the field's suffix that opens every culture in a dialog.
 * @csspart panel - A culture's panel (a tabpanel), or its row when stacked.
 * @csspart field - A culture's input or textarea.
 *
 * @cssstate incomplete - Some culture has no text.
 * @cssstate invalid - `error` is set.
 * @cssstate disabled - `disabled` is set.
 * @cssstate readonly - `readonly` is set.
 */
import { generatedId, getLocale } from '@pdxui/core';
import { uiString, format } from '../shared/i18n';
import { missing, isComplete, withText, orderCultures, cultureName, directionOf, regionOf, type LocalizedText, type RequiredScope } from './localized-text';
import type { MenuItem } from '../menu/pdx-menu';
import '@pdxui/design/components/localized-input';

/** The text, by culture code. A culture with no entry, or an empty one, is missing; the form submits the JSON. */
@model value: LocalizedText | null = null { form: () => value ? JSON.stringify(value) : null, missing: () => !isComplete(value, cultures, requiredScope, defaultOf()) };
/** The cultures to edit, as codes (`en`, `it`, `fr-CA`). The current locale's comes first when it is one of them. */
@prop cultures: string[] = [];
/** The culture `required-scope="default"` asks for, and whose text an empty culture shows as its placeholder. Empty: the first culture. */
@prop defaultCulture: string = '';
/** all (the default): `required` asks every culture; default: only the default culture. */
@prop requiredScope: 'all' | 'default' = 'all';
/** tabs (the default): one culture at a time; stacked: every culture a field; flag: one field, its prefix a menu of the cultures. */
@prop layout: 'tabs' | 'stacked' | 'flag' = 'tabs';
/** A flag before each culture's name, in its tab or row. */
@prop flags: boolean = false;
/** The region whose flag a culture shows, by culture (`{ en: 'GB' }`): for a bare language, which has none, or to choose another. */
@prop regions: Record<string, string> = {};
/** A button in the field's suffix, «All languages», opens a dialog with every culture as a labelled field (tabs and flag layouts). */
@prop expandable: boolean = false;
/** A textarea per culture instead of an input. */
@prop multiline: boolean = false;
/** The textarea's rows, when `multiline`. */
@prop rows: number = 3;
/** The field's name: the group's, and in each culture's field name. Empty: «Text». */
@prop label: string = '';
/** Accessible name when there is no visible label; wins over `label`. */
@prop ariaLabel: string = '';
@prop disabled: boolean = false;
@prop readonly: boolean = false;
/** The form judges it with `required-scope`: every culture, or the default one. */
@prop required: boolean = false;
/** A custom validity message: the field is invalid while it is set. */
@prop error: string = '';
@prop name: string = '';
@part root, tabs, tab, cultureButton, marker, panel, field, expandButton;
@state incomplete = missing(value, cultures).length > 0;
@state invalid = !!error;
@state disabled = !!disabled;
@state readonly = !!readonly;
@host { :name="name || null" }

const locale = getLocale();
const id = generatedId('pdx-localized-input');
/** The culture whose tab is selected, when the user chose one; else the first. */
let chosen = $signal('');

const stacked = $derived(layout === 'stacked');
const flagLayout = $derived(layout === 'flag');
const tabbed = $derived(!stacked && !flagLayout);
const shown = $derived(orderCultures(cultures, locale()));
const active = $derived(shown.includes(chosen) ? chosen : (shown[0] ?? ''));
const fieldName = $derived(ariaLabel || label || uiString('localized-input', 'label'));

function defaultOf(): string { return defaultCulture || cultures[0] || ''; }
function idOf(kind: string, culture: string): string { return `${id}-${kind}-${culture}`; }
function textOf(culture: string): string { return value?.[culture] ?? ''; }
/**
 * The value the field mounted with. A form reset puts the model back to it (core), and resets each inner
 * field to its default value (the browser): the fields' default is this text, so the two agree. A field
 * whose text did not change across the reset would otherwise keep the browser's empty default, since its
 * binding has nothing new to write.
 */
const mounted: LocalizedText | null = value;
function mountedTextOf(culture: string): string { return mounted?.[culture] ?? ''; }
function missingOf(culture: string): boolean { return !textOf(culture).trim(); }
/** A tab's name: the culture in its own language, and «missing» after it while it has no text. */
function tabNameOf(culture: string): string {
  return missingOf(culture) ? `${cultureName(culture)}, ${uiString('localized-input', 'missing')}` : cultureName(culture);
}
function nameOf(culture: string): string { return format(uiString('localized-input', 'field'), { label: fieldName, language: cultureName(culture) }); }
/** An empty culture shows the default culture's text, so the translator sees what to translate. */
function placeholderOf(culture: string): string { return culture === defaultOf() ? '' : textOf(defaultOf()); }

function write(culture: string, e: Event): void {
  const next = withText(value, culture, (e.target as HTMLInputElement | HTMLTextAreaElement).value);
  value = Object.keys(next).length > 0 ? next : null;
}

function select(culture: string): void { chosen = culture; }

/** The region whose flag `culture` shows, `''` for none. */
function flagOf(culture: string): string { return regionOf(culture, regions ?? {}); }
/** The flag layout's prefix for a culture with no flag: its language subtag, upper case. */
function codeOf(culture: string): string { return culture.split(/[-_]/)[0].toUpperCase(); }

/** Whether some culture shows a flag: then one with none keeps a flag's room in the menu, so the names line up. */
const anyFlag = $derived(shown.some((c) => flagOf(c) !== ''));
/** The flag layout's menu: one radio item per culture, named in its own language, the active one checked. */
const cultureItems = $derived(shown.map((c): MenuItem => ({ key: c, label: cultureName(c), type: 'radio', radioGroup: 'culture', checked: c === active, lang: c })));
/** The flag layout's menu, closed once a culture is chosen. */
let cultureMenuEl = $signal<(HTMLElement & { close(): void }) | null>(null);
/**
 * A culture chosen in the menu. A radio item leaves pdx-menu open (a menu of options may take several);
 * here choosing the culture is the menu's whole job, so it closes, and close() returns the focus to the
 * button.
 */
function onCultureMenu(e: CustomEvent<{ key: string }>): void {
  chosen = e.detail.key;
  cultureMenuEl?.close();
}

/** `expandable`: whether the dialog of every culture is open. */
let expanded = $signal(false);
/** The dialog opened or closed: Escape, the close button, the backdrop. It returns the focus itself. */
function onExpandedChange(e: CustomEvent<{ value: boolean }>): void { expanded = e.detail.value; }
/** An edit in the dialog's field: the same value, at once — the dialog's field is a view of this one. */
function onDialogValue(e: CustomEvent<{ value: LocalizedText | null }>): void { value = e.detail.value; }

/** The tablist's keys: the arrows, Home and End move the focus and the selection with it. */
function onTabKey(e: KeyboardEvent, culture: string): void {
  const i = shown.indexOf(culture);
  let next = -1;
  if (e.key === 'ArrowRight') next = (i + 1) % shown.length;
  else if (e.key === 'ArrowLeft') next = (i - 1 + shown.length) % shown.length;
  else if (e.key === 'Home') next = 0;
  else if (e.key === 'End') next = shown.length - 1;
  if (next < 0) return;
  e.preventDefault();
  chosen = shown[next];
  // The part `tab` is the rendered tabs (#988): the one of that culture takes the focus.
  queueMicrotask(() => tab.find((t) => t.getAttribute('lang') === shown[next])?.focus());
}
</script>

<template>
  <!-- Interactive parts only. A plain chip is text: no role, no tab stop, no ARIA. A selectable chip is
       a toggle button: role="button", aria-pressed, Enter and Space toggle it. A removable chip's one
       tab stop is its ×. Selectable and removable: the toggle is the body and the × its sibling, inside
       a non-interactive pill, so no button nests in a button. Disabled goes where it is read: on the
       toggle, and as `disabled` on the ×. After a removal the app owns focus. -->
  <span class="pdx-chip" data-part="root" @click="toggle()" @keydown="onKeydown($event)"
    :role="toggleOnPill ? 'button' : null"
    :tabindex="toggleOnPill ? (disabled ? '-1' : '0') : null"
    :aria-pressed="toggleOnPill ? String(!!selected) : null"
    :aria-disabled="toggleOnPill && disabled ? 'true' : null">
    <span class="pdx-chip-body" data-part="body" :ref="bodyEl" @keydown="onKeydown($event)"
      :role="toggleOnBody ? 'button' : null"
      :tabindex="toggleOnBody ? (disabled ? '-1' : '0') : null"
      :aria-pressed="toggleOnBody ? String(!!selected) : null"
      :aria-disabled="toggleOnBody && disabled ? 'true' : null">
      @if (avatar) {
        <img class="pdx-chip-icon" :src="avatar" alt="" />
      }
      <slot name="icon"></slot>
      @if (label) {
        {{ label }}
      } @else {
        <slot></slot>
      }
    </span>
    @if (removable) {
      <button type="button" class="pdx-chip-remove" data-part="remove" :disabled="disabled" :aria-label="removeName" @click="onRemove($event)">×</button>
    }
  </span>
</template>

<script>
/**
 * A small tag that can be selectable or removable, with variants, an avatar and group support.
 *
 * @slot icon - An icon shown before the chip's label.
 *
 * @csspart root - The chip, the pill drawn; the variants key by it.
 * @csspart body - Its label, avatar and icon; the toggle when the chip is also removable.
 * @csspart remove - The × button, with `removable`.
 *
 * @cssstate selected - It is selected.
 * @cssstate disabled - `disabled` is set.
 *
 * @alphaevent pdx-toggle
 * @alphadetail selected $event.detail.value
 * @alphadetail value $event.currentTarget.value
 */
import { uiString, format } from '../shared/i18n';
// This component's styles travel with it, so an app ships the CSS of what it renders
// and no more.
import '@pdxui/design/components/chip';
import { onNextFrame } from '@pdxui/core';

// A click writes it (#291): `selected-change` `{ value }`, in place of `pdx-toggle`.
@model selected: boolean = false;
/** The × was pressed: the chip's value (its label when it has none) and its label. */
@event 'pdx-remove': { value: string; label: string };
// On the host as custom states (#132); the pill keeps only the CSS-only chip's class.
@state selected = !!selected;
@state disabled = !!disabled;
@part root, body, remove;
// The axes chip.css keys by (#630), reflected on the host; each value maps the class that draws the
// same look on a native chip. `outline` and `md` are the base look, which no class adds to.
@variants {
  /** outline (the default), primary, success, danger, warning, info, tonal, or tonal with a colour. */
  variant: {
    outline: '.pdx-chip-outline', primary: '.pdx-chip-primary', success: '.pdx-chip-success',
    danger: '.pdx-chip-danger', warning: '.pdx-chip-warning', info: '.pdx-chip-info', tonal: '.pdx-chip-tonal',
    tonal-primary: '.pdx-chip-tonal-primary', tonal-success: '.pdx-chip-tonal-success',
    tonal-danger: '.pdx-chip-tonal-danger', tonal-warning: '.pdx-chip-tonal-warning'
  } = outline;
  /** sm, md (the default) or lg. */
  size: { md: '.pdx-chip-md', sm: '.pdx-chip-sm', lg: '.pdx-chip-lg' } = md;
}
@prop label: string = '';
/**
 * Shows a × button — the chip's tab stop — named "Remove {label}", which emits pdx-remove. The
 * chip does not remove itself: the app removes it and owns focus afterwards (move it to the
 * next chip's ×, or the previous one), or a keyboard user is left on <body>.
 */
@prop removable: boolean = false;
/** A toggle button (role="button", aria-pressed): click, Enter or Space flips the `selected` model. */
@prop selectable: boolean = false;
@prop disabled: boolean = false;
/** Value passed in the remove event's detail for identification. */
@prop value: string = '';
/** Avatar URL — renders a small circle image before the label. */
@prop avatar: string = '';

function onRemove(e) {
  e.stopPropagation();
  if (disabled) return;
  pdxRemove({ value: value || label || '', label });
}

// The user's write of the model: it announces `selected-change` `{ value }`.
function toggle() {
  if (disabled || !selectable) return;
  selected = !selected;
}

/** Enter and Space press the toggle — whichever element carries role="button". */
function onKeydown(e) {
  if (e.currentTarget.getAttribute('role') !== 'button' || e.target !== e.currentTarget) return;
  if (e.key !== 'Enter' && e.key !== ' ') return;
  e.preventDefault();
  toggle();
}

// Where the toggle's role lives: on the pill when the chip is only selectable, on its body when a ×
// sits beside it.
const toggleOnPill = $derived(!!selectable && !removable);
const toggleOnBody = $derived(!!selectable && !!removable);

// The × is named after what it removes: the label, else the chip's text, else its value. The text is
// read after the slot content has been projected.
let bodyEl = $signal(null);
let text = $signal('');
$effect(() => {
  void label;
  onNextFrame(() => { text = (bodyEl?.textContent ?? '').trim(); });
});
const removeName = $derived(format(uiString('chip', 'remove'), { label: label || text || value || '' }).trim());
</script>

<template></template>

<script>
/**
 * A list the user can put in another order, by dragging a row's handle or from the keyboard alone.
 *
 * It emits `pdx-reorder` with the indices and never writes to `items`: the application applies the
 * move, so the array it owns stays the one source of truth.
 *
 * @slot item - Renders one row's content: a snippet `item(item, index)`. Without it the row shows
 *   the item's `label-field`.
 * @csspart list - The `role="list"` `<ul>`, framed.
 * @csspart item - A row, `<li>`. The row lifted from the keyboard carries `pdx-sortable-item-lifted`.
 * @csspart handle - A row's handle, the button the pointer grabs and the keyboard moves.
 * @csspart body - A row's content.
 * @cssstate disabled - `disabled` is set: nothing can be moved, and the handles are `aria-disabled`.
 */
// pdx-sortable-list — a list the user can reorder, by pointer and by keyboard.
//
// The component `useSortable` was written for. Without it the primitives are reachable only by
// wiring them yourself — a container getter, an items getter, an onReorder, and the render of the
// rows — and "a list the user can reorder", one of the commonest things a business screen needs,
// would start from a composable.
//
// It does NOT mutate the array. `useSortable` hands back (from, to) and this component emits them;
// the application writes the new value. That is the contract `createFieldArray` keeps, and it is
// what keeps the list one source of truth.
//
// Accessibility, from the research that designed this component:
//   - NO `aria-grabbed`. It is deprecated in WAI-ARIA 1.1, and the recommendation is accessible
//     controls instead — so the grab target is a real <button>, carrying
//     `aria-roledescription="draggable"` and pointing at off-screen instructions.
//   - Space/Enter lifts, arrows move, Space/Enter drops, Escape cancels (the dnd-kit pattern).
//   - Announcements speak POSITION, not index: "position 2 of 5".
//   - Roving tabindex over the handles, so the list costs one Tab stop.
//
// The keyboard reorder itself is `useSortable`'s: one interaction has one implementation, and the
// component keeps the half a primitive cannot know: the handle is a real button with a label in
// the app's language, the strings come from `uiString`, and `labelOf` reads the ITEM rather than
// the row's text. Those travel as `a11y` options; the state machine does not.
//
// Its DOM is built by the script, a frame after mount, as the TypeScript version built it: during a
// keyboard lift `useSortable` moves the row nodes itself (`preview: 'reorder'`), and a drop leaves
// them where they went.
import { useSortable, useRovingTabindex, onDestroy, onNextFrame, generatedId, untracked } from '@pdxui/core';
import type { Dispose } from '@pdxui/core';
import { uiString, format, uiAttr } from '../shared/i18n';
// This component's styles travel with it, so an app ships the CSS of what it renders
// and no more.
import '@pdxui/design/components/sortable-list';

// The axis sortable-list.css keys by (#292), reflected on the host: it lays the rows out, and
// decides which arrows move and which way rows shift.
@variants {
  /** vertical (the default) or horizontal. */
  axis: { vertical, horizontal } = vertical;
}
@state disabled = !!disabled;
// Every element is built by the script, a frame after mount (#1284).
@part(external) list, item, handle, body;
// The item a snippet receives is the app's, an element of `items` (#651): the editor infers `T`.
@generic T;
@prop items: T[] = [];
/** How a row is identified. Empty: the row's index. */
@prop idField: string = 'id';
/** What a row shows without an `item` slot, and what names its handle either way. */
@prop labelField: string = 'label';
/** A selector inside the row that the POINTER may grab. Empty: the rendered handle. */
@prop handle: string = '';
@prop disabled: boolean = false;
// A parent's `@snippet` sets it, positional arguments; the alpha scoped slot is not read (#492).
@slot item?: (item: T, index: number);
/** A row was dropped at another position: `from` and `to` are indices into `items`, `id` the row's `id-field`. The list is not changed: the application moves the item. */
@event 'pdx-reorder': { from: number; to: number; id: unknown };
@host el;

let listEl: HTMLElement | null = null;
const helpId = generatedId('pdx-sortable-help');
// Kept so they can be disposed. useSortable puts listeners on the DOCUMENT for the duration
// of a gesture: a host destroyed mid-drag would leave them there, moving nothing, forever.
const teardown: Dispose[] = [];
// The list exists: built a frame after mount. A plain flag, so its build does not run the redraw.
let built = false;
// Cleared on destroy: a redraw a frame away does not run on a destroyed list, as `ctx.frame` did not.
let alive = true;

// After a rebuild the DOM nodes are new: the handle at this index takes the focus back.
let refocusIndex = -1;

/** The parent's item snippet, read where the rows draw: one set after mount is the one drawn. */
function getItemSnippet() {
  return item;
}

function rows(): unknown[] {
  return (items as unknown[]) ?? [];
}

function labelOf(it: unknown, index: number): string {
  const field = labelField as string;
  const value = (it as Record<string, unknown>)?.[field];
  if (typeof value === 'string' || typeof value === 'number') return String(value);
  return typeof it === 'string' || typeof it === 'number' ? String(it) : String(index + 1);
}

function idOf(it: unknown, index: number): unknown {
  const field = idField as string;
  if (!field) return index;
  return (it as Record<string, unknown>)?.[field] ?? index;
}

function rowEls(): HTMLElement[] {
  return listEl ? (Array.from(listEl.children) as HTMLElement[]) : [];
}

// ─── Rendering ─────────────────────────────────────────────────

function buildRow(it: unknown, index: number): HTMLElement {
  const li = document.createElement('li');
  li.className = 'pdx-sortable-item';
  li.dataset.part = 'item';
  li.dataset.pdxKey = String(idOf(it, index));

  const handleEl = document.createElement('button');
  handleEl.type = 'button';
  handleEl.className = 'pdx-sortable-handle';
  handleEl.dataset.part = 'handle';
  uiAttr(handleEl, 'aria-roledescription', () => uiString('sortable-list', 'draggable'));
  handleEl.setAttribute('aria-describedby', helpId);
  uiAttr(handleEl, 'aria-label', () => format(uiString('sortable-list', 'reorder'), { label: labelOf(it, index) }));
  if (disabled as boolean) handleEl.setAttribute('aria-disabled', 'true');
  handleEl.appendChild(document.createElement('span')).className = 'pdx-sortable-grip';
  li.appendChild(handleEl);

  const bodyEl = document.createElement('div');
  bodyEl.className = 'pdx-sortable-body';
  bodyEl.dataset.part = 'body';
  const snippet = getItemSnippet();
  if (snippet) bodyEl.appendChild(snippet(it as T, index) ?? document.createDocumentFragment());
  else bodyEl.textContent = labelOf(it, index);
  li.appendChild(bodyEl);

  return li;
}

function rebuild(): void {
  if (!listEl) return;
  listEl.replaceChildren(...rows().map(buildRow));
  if (refocusIndex >= 0) {
    // A rebuild throws away the node that had the focus. Without this, a keyboard
    // reorder drops the user back at the top of the page — which is the whole gesture
    // wasted.
    rowEls()[refocusIndex]?.querySelector<HTMLElement>('.pdx-sortable-handle')?.focus();
    refocusIndex = -1;
  }
}

// ─── The reorder itself ────────────────────────────────────────

function emitReorder(from: number, to: number): void {
  if (from === to) return;
  const it = rows()[from];
  refocusIndex = to;
  pdxReorder({ from, to, id: idOf(it, from) });
}

// ─── Build ─────────────────────────────────────────────────────

// A frame after mount: a setup a move destroyed does not build again.
onNextFrame(() => {
  const vertical = (axis as string) !== 'horizontal';

  const help = document.createElement('div');
  help.id = helpId;
  help.className = 'pdx-sr-only';
  help.textContent = uiString('sortable-list', 'instructions');
  el.appendChild(help);

  listEl = document.createElement('ul');
  listEl.className = 'pdx-sortable-list';
  listEl.dataset.part = 'list';
  listEl.setAttribute('role', 'list');
  el.appendChild(listEl);

  untracked(() => rebuild());

  const sortable = useSortable(() => listEl, {
    // The keyboard reorder is the composable's. What travels from
    // here is only what it cannot know: the item's own label rather than the
    // row's text, this app's sentences through `uiString`, and the two
    // presentation choices this component makes — the rows really move, and
    // the lifted one is marked so the stylesheet can show it.
    a11y: {
      label: (index) => labelOf(rows()[index], index),
      // Set on the BUTTON in `buildRow`, where the focus is; on the row as
      // well it would be announced twice.
      roleDescription: false,
      // The component's own help element: one `uiString`, pointed at by
      // every handle's `aria-describedby`.
      instructions: false,
      messages: {
        lifted: `${uiString('sortable-list', 'lifted')} ${uiString('sortable-list', 'position')}`,
        moved: uiString('sortable-list', 'position'),
        dropped: `${uiString('sortable-list', 'dropped')} ${uiString('sortable-list', 'position')}`,
        cancelled: uiString('sortable-list', 'cancelled'),
      },
      preview: 'reorder',
      liftedClass: 'pdx-sortable-item-lifted',
    },
    disabled: () => disabled as boolean,
    items: () => rows(),
    axis: vertical ? 'vertical' : 'horizontal',
    handle: (handle as string) || '.pdx-sortable-handle',
    onReorder: emitReorder,
  });

  const roving = useRovingTabindex(() => listEl, {
    orientation: vertical ? 'vertical' : 'horizontal',
    itemSelector: '.pdx-sortable-handle',
    wrap: false,
  });

  teardown.push(sortable.dispose, roving.dispose);
  built = true;
});

// The rows redraw a frame after the items, their id or label field, `disabled` or the axis change.
$effect(() => {
  void items;
  void idField;
  void labelField;
  void disabled;
  void axis;
  if (!built) return;
  requestAnimationFrame(() => { if (alive) untracked(() => rebuild()); });
});

onDestroy(() => {
  alive = false;
  for (const dispose of teardown.splice(0)) dispose();
});
</script>

<template>
  <div class="pdx-bulk-actions" data-part="root" role="toolbar" :aria-label="uiString('bulk-actions', 'label')"
    :hidden="count <= 0"
    style="align-items:center;gap:var(--pdx-space-md);flex-wrap:wrap;max-width:100%;box-sizing:border-box;padding:var(--pdx-space-xs) var(--pdx-space-md);border:1px solid var(--pdx-color-border);border-radius:var(--pdx-radius-md);background:var(--pdx-color-inset)"
    :style="{ display: count > 0 ? 'inline-flex' : 'none' }">
    <span class="pdx-bulk-count" data-part="count" style="font-weight:600;font-size:.85rem;white-space:nowrap">{{ countLabel() }}</span>
    <div class="pdx-bulk-buttons" style="display:inline-flex;flex-wrap:wrap;align-items:center;gap:var(--pdx-space-xs)">
      @for (actions as a; track a.key) {
        <button type="button" size="sm" data-part="action" :class="'pdx-bulk-action ' + (a.tone ? 'pdx-' + a.tone : 'pdx-ghost')"
          :aria-disabled="a.disabled ? 'true' : null"
          :aria-describedby="reasonId(a)"
          style="display:inline-flex;align-items:center;gap:.35rem;white-space:nowrap"
          attach:actionIcon="a.icon"
          @click="onAction(a)">{{ a.label }}</button>
      }
    </div>
    @for (reasons() as a; track a.key) {
      <span :id="reasonId(a)" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">{{ a.disabledReason }}</span>
    }
    @if (clearable) {
      <button type="button" size="sm" data-part="clear" class="pdx-bulk-clear pdx-ghost" :aria-label="uiString('bulk-actions', 'clearSelection')"
        style="margin-inline-start:auto;flex:0 0 auto"
        @click="clear()">✕</button>
    }
  </div>
</template>

<script>
/**
 * A contextual action bar for a multi-selection: while items are selected it shows how many, a
 * button per action and a clear button.
 *
 * @csspart root - The bar, a `role="toolbar"`, shown while `count` is above 0.
 * @csspart count - The "{count} selected" label.
 * @csspart action - An action's button.
 * @csspart clear - The clear button, while `clearable`.
 */
// pdx-bulk-actions — a contextual action bar for a multi-selection (e.g. above a data-grid).
// Visible while `count > 0`; renders "{count} selected" + one button per action + a clear button.
// Event-driven and standalone: the parent feeds `count`/`actions` and reacts to pdx-action/pdx-clear.
import { generatedId } from '@pdxui/core';
import { uiString, format } from '../shared/i18n';
import type { BulkAction } from './bulk-actions-types';
// The entry gives the action type as well as the element (#1352).
export type { BulkAction };

/** Number of selected items — drives visibility and the default label. */
@prop count: number = 0;
/** Actions to offer. */
@prop actions: unknown[] = [];
/** Label template; `{count}` is substituted. Default: the `bulk-actions.selected` component string, "{count} selected". */
@prop label: string = '';
/** Show the trailing clear (✕) button. */
@prop clearable: boolean = true;
// Declared (#138): they stay on the host, which the parent listens on.
/** An action was pressed; an `aria-disabled` one emits nothing. */
@event 'pdx-action': { key: string; action: BulkAction };
/** The clear button was pressed: the parent clears its selection. */
@event 'pdx-clear': void;
@part root, count, action, clear;

// An action's button is `aria-disabled`, not `disabled`, and that is the point of the feature rather
// than a detail of it.
//
// A `disabled` button leaves the tab order, so the reason attached to it is unreachable and the
// user is back to inferring a rule from something they cannot get to — the same hole
// `useDropZone`'s `isRejected` closes. `role="toolbar"` is exactly where the ARIA
// practices recommend this form, and `surfaces/buttons.css` already paints
// `[aria-disabled="true"]` the way it paints `:disabled`, so the look is the house one.
// The reasons are visually hidden spans, with the style of an off-screen label, in the template.
//
// The bar's look is its static style in the template. Its `display` is bound on its own, from
// `count`: a fixed inline `display:inline-flex` would beat the `[hidden]` rule, and a bar at count 0
// would stay on screen with "0 selected". Narrower than its actions, the bar wraps them and never
// grows past its container: kept on one row, it is wider than a phone, and the page's sideways clip
// cuts the last actions off.

const barId = generatedId('pdx-bulk');

/**
 * An action's icon, first in its button, loading `pdx-icon` the first time one is named: a bar of
 * labels never pays for the set. Built here, not in the template, where the tag would import it with
 * the component.
 */
function actionIcon(button: Element, name: () => string | undefined) {
  const iconName = name();
  if (!iconName) return;
  if (!customElements.get('pdx-icon')) void import('../icon/pdx-icon.pdx');
  const icon = document.createElement('pdx-icon');
  icon.setAttribute('name', iconName);
  icon.setAttribute('size', '15');
  button.prepend(icon);
  return () => icon.remove();
}

// The default is `bulk-actions.selected`, in the registry rather than an English literal, which
// a locale can pluralise with an ICU block.
function countLabel(): string {
  const tpl = (label as string) || uiString('bulk-actions', 'selected');
  return format(tpl, { count: count as number });
}
// The parameters are not named `action`: that is the part's name, and a part's name read in the
// script makes it a signal of the part's elements at every mount.
function onAction(pressed: BulkAction): void {
  // The button is `aria-disabled`, not `disabled`, so the click arrives. Refusing it
  // here is what makes the mark true rather than decorative.
  if (pressed.disabled) return;
  pdxAction({ key: pressed.key, action: pressed });
}
/** The id of an action's reason, or null when it has none to give. */
function reasonId(item: BulkAction): string | null {
  return item.disabled && item.disabledReason ? `${barId}-${item.key}-why` : null;
}
/** Every reason on this bar, for the off-screen block the buttons point at. */
function reasons(): BulkAction[] {
  return (actions as BulkAction[]).filter((a) => reasonId(a) !== null);
}
function clear(): void { pdxClear(); }
</script>

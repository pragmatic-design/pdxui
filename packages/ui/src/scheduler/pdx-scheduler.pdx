<template>
  <div class="pdx-scheduler" data-part="root" role="group" :aria-label="label || uiString('scheduler', 'label')">
    <div class="pdx-scheduler-toolbar" data-part="toolbar" role="toolbar" :aria-label="uiString('scheduler', 'toolbar')">
      <button type="button" class="pdx-scheduler-button" data-part="prev" :aria-label="uiString('scheduler', 'previous')" :disabled="disabled" @click="step(-1)">‹</button>
      <button type="button" class="pdx-scheduler-button" data-part="todayButton" :disabled="disabled" @click="goToday()">{{ uiString('scheduler', 'today') }}</button>
      <button type="button" class="pdx-scheduler-button" data-part="next" :aria-label="uiString('scheduler', 'next')" :disabled="disabled" @click="step(1)">›</button>
      <div class="pdx-scheduler-period" data-part="period" :id="periodId">{{ periodText }}</div>
      @if (shownViews.length > 1) {
        <div class="pdx-scheduler-views" data-part="viewSwitcher" role="group" :aria-label="uiString('scheduler', 'views')">
          @for (shownViews as v; track v) {
            <button type="button" class="pdx-scheduler-button" :aria-pressed="v === view ? 'true' : 'false'" :disabled="disabled" @click="pick(v)">{{ viewName(v) }}</button>
          }
        </div>
      }
    </div>
    @if (view === 'month') {
      <pdx-scheduler-month class="pdx-scheduler-grid pdx-scheduler-month" data-part="grid" role="grid" :aria-labelledby="periodId" :aria-describedby="createHint" aria-readonly="true"
        :style="'--_scheduler-cols:' + perWeek + ';--_scheduler-lanes:' + dayMaxEvents" :ref="gridEl"
        :weeks="monthWeeks" :heads="monthHeads" :ref-date="refDate" :today="todayDate" :tab-cell="tabCell" :locale="loc" :rules="moveRules" :draft="draft" :hint="hintId" :event="event"
        @keydown="onKey($event)" @click="onClick($event)" @focusout="onFocusOut($event)" @pointerdown="onPointerDown($event)" @pdx-select.capture="onMenu($event)" @dblclick="onDblClick($event)"></pdx-scheduler-month>
    } @else if (view === 'year') {
      <pdx-scheduler-year :months="yearMonths" :cursor="yearCursor" :today="todayDate" :locale="loc" :ref="gridEl"
        @keydown="onYearKey($event)" @click="onYearClick($event)"></pdx-scheduler-year>
    } @else if (view === 'agenda') {
      <pdx-scheduler-agenda :groups="agendaGroups" :today="todayDate" :label-id="periodId" :locale="loc" :resources="resources" :event="event"
        @click="onClick($event)"></pdx-scheduler-agenda>
    } @else if (view === 'timeline') {
      <pdx-scheduler-timeline class="pdx-scheduler-timeline" data-part="grid" :role="isTree ? 'treegrid' : 'grid'" :aria-labelledby="periodId" :aria-describedby="createHint" aria-readonly="true"
        :aria-rowcount="tlRows.length + 1" :aria-colcount="tlColumns.length + 1" :ref="gridEl"
        :style="'--_scheduler-cols:' + tlColumns.length + ';--_scheduler-height:' + tlWindow.height() + 'px'"
        :shown="tlShown" :cols="tlCols" :tree="isTree" :tab-cell="tabCell" :first-column="tlWindow.firstColumn()" :now="tlNow" :scale="timelineScale"
        :business-hours="businessHours" :time-zone="zone" :locale="loc" :rules="moveRules" :draft="draft" :hint="hintId" :event="event"
        @metrics="metrics = $event.detail"
        @keydown="onKey($event)" @click="onClick($event)" @focusout="onFocusOut($event)" @pointerdown="onPointerDown($event)" @pdx-select.capture="onMenu($event)" @dblclick="onDblClick($event)"></pdx-scheduler-timeline>
    } @else {
      <pdx-scheduler-time-grid class="pdx-scheduler-grid" data-part="grid" role="grid" :aria-labelledby="periodId" :aria-describedby="createHint" aria-readonly="true"
        :aria-rowcount="headerRows.length + 1 + slots.length" :aria-colcount="columns.length + 1"
        :style="'--_scheduler-cols:' + columns.length + ';--_scheduler-heads:' + headerRows.length + ';--_scheduler-lanes:' + allDay.lanes + ';--_scheduler-slots:' + slots.length" :ref="gridEl"
        :header-rows="headerRows" :columns="columns" :bars="allDay.bars" :shown="shownSlots" :by-cell="byCell" :from-above="fromAbove" :first-slot="slotWin.first()"
        :now-lines="nowLines" :tab-cell="tabCell" :start-minutes="startMinutes" :slot-minutes="slotMinutes" :business-hours="businessHours" :open-at="openSlot"
        :locale="loc" :rules="moveRules" :draft="draft" :hint="hintId" :event="event"
        @metrics="slotPx = $event.detail.slot"
        @keydown="onKey($event)" @click="onClick($event)" @focusout="onFocusOut($event)" @pointerdown="onPointerDown($event)" @pdx-select.capture="onMenu($event)" @dblclick="onDblClick($event)"></pdx-scheduler-time-grid>
    }
    <span class="pdx-sr-only" :id="hintId">{{ uiString('scheduler', 'instructions') }}</span>
    <span class="pdx-sr-only" :id="createHintId">{{ uiString('scheduler', 'createInstructions') }}</span>
    @if (editing) {
      <pdx-scheduler-editor :draft="editing" :resources="resources" :zone="zone" :locale="loc"
        @save="onEditorSave($event.detail.event, $event.detail.scope)" @remove="onEditorDelete($event.detail.scope)" @discard="closeEditor()"></pdx-scheduler-editor>
    }
  </div>
</template>

<script>
/**
 * A calendar of events in time, by day and by resource. The day, week and N-days views are a grid of
 * time slots, with an all-day row, the current time and the working hours marked, and each resource
 * (a room, a technician) can have its own columns. The month view is a grid of days with the events
 * stacked in each and a «+N» where they do not fit; the year view, twelve months with the days that
 * have events marked; the agenda, a list of the period's events by day. The timeline puts each
 * resource on a row, its children under it and collapsible, along the period's slots, days or months,
 * and draws only the rows and columns in view: a thousand resources cost what a screenful does. The
 * grids are WAI-ARIA grids (a treegrid when resources nest):
 * one tab stop, the arrows from cell to cell, Enter into a cell's events and Escape back out, PageUp and
 * PageDown through periods. A click or Enter on an event emits `event-open`; on an empty slot or day,
 * `slot-open`; on the «+N» or a day of the year, it opens that day. With the mouse or a pen an event
 * is dragged to another time, day or resource and resized by its edges, and a drag over empty slots
 * creates one; each asks `before-move`, `before-resize` or `before-create` first, which the app can
 * refuse, then writes `events`. From the keyboard, Space picks a focused event up: the arrows move it
 * a slot, a day or a resource, Shift and the arrows move its end, Alt, Shift and the arrows its start,
 * Space or Enter drops it, asking the same, and Escape puts it back, each step announced. Shift and the
 * arrows on an empty cell select slots or days, drawn as a drag over them draws them, and Enter creates
 * an event there, asking `before-create`; Escape, or an arrow without Shift, drops the selection.
 * With a single pointer, an event's ⋯ offers «Move» and «Resize»: the event is picked up, and a click
 * on a slot puts it there, or ends it there, asking the same.
 * `prevent-overlap` refuses a place that overlaps another event of the same resource, and says why in
 * `rejected`.
 *
 * @csspart root - The scheduler, a `role="group"` named by `label`.
 * @csspart toolbar - The bar above the grid: previous, today, next, the period and the views.
 * @csspart prev - The button to the previous period.
 * @csspart todayButton - The button back to today.
 * @csspart next - The button to the next period.
 * @csspart period - The period on screen, which names the grid.
 * @csspart viewSwitcher - The view buttons, shown when `views` offers more than one.
 * @csspart grid - The `role="grid"` of the time slots, of the month's days, or of the timeline's rows (a `treegrid` when resources nest), which scrolls.
 * @csspart columnHeader - A day's or a resource's header, a weekday's in the month, a slot's, day's or month's in the timeline.
 * @csspart rowHeader - A resource's name at the start of its timeline row; a parent's carries the row's `aria-expanded`.
 * @csspart allDayRow - The row of all-day events.
 * @csspart slot - A cell: a time slot of a day and resource, its all-day cell, a day of the month or of the year, a resource's slot, day or month in the timeline.
 * @csspart event - An event, the box that holds its button, its edges and its ⋯; `[data-before]` / `[data-after]` mark one that goes on past the piece shown, `[data-movable]` one that can be dragged, `[data-dragging]` the one being dragged.
 * @csspart eventButton - An event's button: its name, what the `event` snippet draws; a click or Enter opens it.
 * @csspart eventMenu - An event's ⋯ button, which opens «Move» and «Resize»: shown on hover and focus, always for a coarse pointer.
 * @csspart resizeHandle - An edge of an event that resizes it, `[data-edge="start"]` or `[data-edge="end"]`.
 * @csspart more - A month day's «+N», the events that did not fit; it opens the day.
 * @csspart yearMonth - A month of the year view, a `role="grid"` of its own.
 * @csspart agendaList - The agenda's list of days.
 * @csspart nowLine - The line at the current time.
 *
 * @cssstate disabled - `disabled` is set.
 * @cssstate dragging - An event is being moved, resized or created with the pointer.
 * @cssstate lifted - An event is picked up from the keyboard.
 * @cssstate selecting - Empty slots or days are selected from the keyboard, to create an event over.
 */
import { addDays, announce, generatedId, getFirstDayOfWeek, onDestroy, onMount, today, useDropZone } from '@pdxui/core';
import { uiString, format } from '../shared/i18n';
import { resolveLocale } from '../shared/locale';
import { viewRange, stepPeriod, parseClock, zonedInstant, zonedParts } from './time';
import { buildColumns, buildSlots, buildHeaderRows, cellIndex, placeTimed, placeAllDay, nowLines as nowLinesOf, eventsFromAbove, type SchedulerEvent, type SchedulerResource, type BusinessHours } from './grid-model';
import { buildMonthWeeks, buildYearMonths, buildAgendaDays } from './calendar-model';
import { timelineRows, timelineColumns, placeTimeline, axisPosition } from './timeline-model';
import { timelineWindow } from './timeline-window';
import { slotWindow } from './time-window';
import { periodLabel, dayHeader, weekdayName, timelineHeader } from './labels';
import { gridKeyTarget, dayKeyTarget } from './grid-keys';
import { conflicts, moveEvent, resizeEvent, type DropPoint, type Placement } from './drag-model';
import { expandEvents, occurrenceId, shiftSeries } from './series';
import { schedulerDrag, type Draft } from './scheduler-drag';
import { cellAt, pointOfCell, type PointModel } from './drop-point';
import { DRAFT_ID, canDo, eventWhen } from './event-state';
import { edgePoint, keyGesture, keySelect, keyStep, type KeyGesture } from './keyboard-move';
import './scheduler-agenda.pdx';
import './scheduler-editor.pdx';
import './scheduler-month.pdx';
import './scheduler-time-grid.pdx';
import './scheduler-timeline.pdx';
import './scheduler-year.pdx';
import '@pdxui/design/components/scheduler';

type CalendarView = 'day' | 'week' | 'days' | 'month' | 'year' | 'agenda' | 'timeline';
const VIEWS: CalendarView[] = ['day', 'week', 'days', 'month', 'year', 'agenda', 'timeline'];
/** What a cell's Enter goes into: its events' buttons and their ⋯, and a month day's «+N». */
const INNER = '[data-part="eventButton"], [data-part="eventMenu"], [data-part="more"]';
/** An event, the box its button and its ⋯ are in, which carries its id. */
const EVENT = '[data-part="event"][data-id]';
type Range = { start: string; end: string; resource?: string | string[] };

/** The events. A start or end with an offset or `Z` is an instant; without one, a wall time in `time-zone`; a date alone, all day. One with `rrule` is a series, drawn once per occurrence; one with `seriesId` and `recurrenceId` replaces an occurrence of its series. Written by the scheduler after a move, resize or create the app allowed. */
@model events: SchedulerEvent[] = [];
/** The resources: each with its own columns in the time grid, where children are drawn as their leaves; each a row of the timeline, children under their parent. Empty: one column per day, one timeline row. */
@prop resources: SchedulerResource[] = [];
/** The view on screen. */
@model view: 'day' | 'week' | 'days' | 'month' | 'year' | 'agenda' | 'timeline' = 'week';
/** The views the bar offers, in order; one or none hides the switcher. */
@prop views: ('day' | 'week' | 'days' | 'month' | 'year' | 'agenda' | 'timeline')[] = ['day', 'week', 'days', 'month', 'year', 'agenda', 'timeline'];
/** The timeline's period and its columns: a day of slots, a week or a month of days, a year of months. */
@prop timelineScale: 'day' | 'week' | 'month' | 'year' = 'week';
/** The reference date (ISO). Empty: today. */
@model date: string = '';
/** How many days the `days` view shows. */
@prop days: number = 3;
/** How many days the `agenda` view lists, from the reference date. */
@prop agendaDays: number = 7;
/** How many events a day of the month shows before its «+N». */
@prop dayMaxEvents: number = 3;
/** With resources: each resource's days together (`resource`) or each day's resources (`date`). */
@prop groupBy: 'resource' | 'date' = 'resource';
/** Show Saturday and Sunday in the day columns and the month. */
@prop weekends: boolean = true;
/** The first day of the week, 0 = Sunday … 6 = Saturday; -1: the locale's. */
@prop firstDay: number = -1;
/** The first visible hour, `HH:mm`. */
@prop startHour: string = '00:00';
/** The end of the visible hours, `HH:mm`, up to `24:00`. */
@prop endHour: string = '24:00';
/** The hour the time grid opens scrolled to. */
@prop scrollTo: string = '08:00';
/** The length of a slot, in minutes. */
@prop slotMinutes: number = 30;
/** The working hours per weekday, shaded outside; a resource's own `businessHours` win in its columns. */
@prop businessHours: BusinessHours = { 1: { start: '09:00', end: '18:00' }, 2: { start: '09:00', end: '18:00' }, 3: { start: '09:00', end: '18:00' }, 4: { start: '09:00', end: '18:00' }, 5: { start: '09:00', end: '18:00' } };
/** Draw a line at the current time. */
@prop nowIndicator: boolean = true;
/** The IANA time zone events are shown in. Empty: the browser's. */
@prop timeZone: string = '';
/** Locale for dates and times. Empty: the page's language (`lang`), then the browser's. */
@prop locale: string = '';
/** The scheduler's accessible name. Empty: «Scheduler». */
@prop label: string = '';
@prop disabled: boolean = false;
/** No event is moved, resized or created; an event or resource can still allow it for itself. */
@prop readonly: boolean = false;
/** Refuse a move, resize or create that would overlap another event of the same resource. */
@prop preventOverlap: boolean = false;
/** The id of an event the scheduler creates. */
@prop createId: () => string = () => crypto.randomUUID();
/** The built-in editor: `dialog` opens it on Enter or a double click on an event, on Enter on an empty slot, and on a create; `none` leaves those to the app (`event-open`, `slot-open`, `create`). */
@prop editor: 'dialog' | 'none' = 'dialog';
/** What an event draws; without it, its time and title. */
@slot event?: (event: SchedulerEvent);
/** An event is about to move, to another time, day or resource; `preventDefault()` refuses it. For an occurrence of a series, `scope` is 'occurrence' (it becomes an override in `events`); set it to 'series' to move the whole series. */
@event(cancelable) 'before-move': { event: SchedulerEvent; from: { start: string; end: string; resource?: string | string[] }; to: { start: string; end: string; resource?: string | string[] }; conflicts: SchedulerEvent[]; scope?: 'occurrence' | 'series' };
/** An event moved; `events` is already written. `event` is the override written, or the series moved, as `scope` says. */
@event move: { event: SchedulerEvent; from: { start: string; end: string; resource?: string | string[] }; to: { start: string; end: string; resource?: string | string[] }; conflicts: SchedulerEvent[]; scope?: 'occurrence' | 'series' };
/** An event is about to be resized by one edge; `preventDefault()` refuses it. `scope` as for `before-move`. */
@event(cancelable) 'before-resize': { event: SchedulerEvent; edge: 'start' | 'end'; from: { start: string; end: string; resource?: string | string[] }; to: { start: string; end: string; resource?: string | string[] }; conflicts: SchedulerEvent[]; scope?: 'occurrence' | 'series' };
/** An event was resized; `events` is already written. `event` and `scope` as for `move`. */
@event resize: { event: SchedulerEvent; edge: 'start' | 'end'; from: { start: string; end: string; resource?: string | string[] }; to: { start: string; end: string; resource?: string | string[] }; conflicts: SchedulerEvent[]; scope?: 'occurrence' | 'series' };
/** A drag over empty slots is about to create an event there (ISO, UTC); `preventDefault()` refuses it. */
@event(cancelable) 'before-create': { start: string; end: string; resource: string | null; allDay: boolean; conflicts: SchedulerEvent[] };
/** Something the app made draggable with `useDrag` was dropped on the grid: its data and where (ISO, UTC); `preventDefault()` refuses it, else an event is created there from `data.title` and `data.duration` (minutes). */
@event(cancelable) 'external-drop': { data: unknown; start: string; end: string; resource: string | null; allDay: boolean; conflicts: SchedulerEvent[] };
/** An event was created, by a drag over empty slots, the keyboard, the editor or a drop from outside, and added to `events`. */
@event create: { event: SchedulerEvent };
/** The editor's Save is about to write an event: `previous` is it as it was, null for a new one; `preventDefault()` refuses it and the editor stays open. On an occurrence of a series, `scope` says what the reader chose: 'occurrence' writes an override, 'series' changes the series (`event` is then the series). */
@event(cancelable) 'before-save': { event: SchedulerEvent; previous: SchedulerEvent | null; isNew: boolean; scope?: 'occurrence' | 'series' };
/** The editor saved an event; `events` is already written. */
@event save: { event: SchedulerEvent; previous: SchedulerEvent | null; isNew: boolean; scope?: 'occurrence' | 'series' };
/** An event is about to be removed, from the editor's Delete or with the Delete key; `preventDefault()` refuses it. On an occurrence of a series, `scope`: 'occurrence' adds it to the series' `exdate`, 'series' removes the series (`event`) and its overrides. (Not `delete`, a reserved word, #1130.) */
@event(cancelable) 'before-remove': { event: SchedulerEvent; scope?: 'occurrence' | 'series' };
/** An event was removed; `events` is already written. */
@event remove: { event: SchedulerEvent; scope?: 'occurrence' | 'series' };
/** A move, resize or create was refused: by `prevent-overlap` (`overlap`) or by the app (`prevented`). */
@event rejected: { action: 'move' | 'resize' | 'create'; event: SchedulerEvent | null; to: { start: string; end: string; resource?: string | string[] }; reason: 'overlap' | 'prevented'; conflicts: SchedulerEvent[] };
/** An event was clicked, or Enter pressed on it. */
@event 'event-open': { event: SchedulerEvent };
/** An empty slot or day was clicked, or Enter pressed on it: its start and end (ISO, UTC), its resource, and whether it is a whole day. */
@event 'slot-open': { start: string; end: string; resource: string | null; allDay: boolean };
/** The period on screen changed, by the bar, the keyboard, or a day opened from the month or the year. */
@event 'period-change': { view: 'day' | 'week' | 'days' | 'month' | 'year' | 'agenda' | 'timeline'; start: string; end: string };
@part root, toolbar, prev, todayButton, next, period, viewSwitcher, grid, columnHeader, rowHeader, allDayRow, slot, event, eventButton, eventMenu, resizeHandle, more, yearMonth, agendaList, nowLine;
@state disabled = !!disabled;
@state dragging = draft !== null && lift === null && selection === null;
@state lifted = lift !== null;
@state selecting = selection !== null;
@host el;

let gridEl = $signal<HTMLElement | null>(null);
/**
 * The cell the grid's one tab stop is on: in the time grid row 0 is the all-day row, then a row per
 * slot; in the month, a row per week. Null: the reference date's cell, which a new period starts at.
 */
let active = $signal<{ row: number; col: number } | null>(null);
/** The day the year view's one tab stop is on; empty: the reference date. */
let yearDay = $signal('');
let now = $signal(Date.now());
/** The timeline's parents the reader collapsed. */
let collapsed = $signal<ReadonlySet<string>>(new Set());
/** The lane height and column width the timeline view measures from the theme, in px. */
let metrics = $signal({ lane: 32, column: 80 });
/** The slot height the time grid view measures from the theme, in px. */
let slotPx = $signal(36);
/** What a pointer drag would make of an event, drawn in its place until it is dropped or dropped back. */
let draft = $signal<Draft | null>(null);
/**
 * The event picked up from the keyboard: as it was, the gesture its first arrow chose, and the resource
 * and cell it is drawn in now; `origin` is the cell it was picked up in.
 */
let lift = $signal<{ event: SchedulerEvent; gesture: KeyGesture | null; resource: string | null; cell: { row: number; col: number }; origin: { row: number; col: number }; byMenu: boolean } | null>(null);
/** The empty cells selected from the keyboard: the one Shift+arrows began on, and the one they reached. */
let selection = $signal<{ anchor: { row: number; col: number }; cell: { row: number; col: number } } | null>(null);
/** The event the built-in editor is open on, and whether it is a new one. */
let editing = $signal<{ event: SchedulerEvent; isNew: boolean; series?: SchedulerEvent } | null>(null);
/** What had the focus when the editor opened: it gets it back when the editor closes. */
let editReturn: HTMLElement | null = null;

const periodId = generatedId('pdx-scheduler-period');
const hintId = generatedId('pdx-scheduler-hint');
const createHintId = generatedId('pdx-scheduler-create-hint');
const loc = $derived(resolveLocale(el, locale));
const zone = $derived(timeZone || Intl.DateTimeFormat().resolvedOptions().timeZone);
const refDate = $derived(date || today());
const weekStart = $derived(firstDay >= 0 ? firstDay : getFirstDayOfWeek(loc));
const rangeOptions = $derived({ firstDay: weekStart, days, agendaDays, timelineScale, hiddenDays: weekends ? [] : [0, 6] });
const range = $derived(viewRange(view, refDate, rangeOptions));
/** The view whose period the bar names: the timeline's scale for the timeline. */
const periodView = $derived(view === 'timeline' ? timelineScale : view);
const periodText = $derived(periodLabel(periodView, range.days, loc, refDate));
const shownViews = $derived(views.filter((v) => VIEWS.includes(v)));
/** The events the views draw: `events`, with the one being dragged in its new place, or the range being created. */
/** The events in the period, each series as its occurrences there (`seriesId`, `recurrenceId`, an id of their own). */
const expanded = $derived(expandEvents(events, { from: zonedInstant(range.start, 0, zone), to: zonedInstant(range.end, 0, zone) }, zone));
const shown = $derived(withDraft(expanded, draft));
const isTimeGrid = $derived(view === 'day' || view === 'week' || view === 'days');
const columns = $derived(buildColumns(isTimeGrid ? range.days : [], resources, groupBy));
const startMinutes = $derived(parseClock(startHour));
const endMinutes = $derived(parseClock(endHour));
const slots = $derived(buildSlots(startMinutes, endMinutes, slotMinutes));
const timed = $derived(placeTimed(shown, columns, { timeZone: zone, startMinutes, endMinutes, slotMinutes }));
const allDay = $derived(placeAllDay(shown, columns, zone));
/** The timed events by cell, `column|slot`, so a cell reads its own in one lookup. */
const byCell = $derived(cellIndex(timed, columns));
const nowParts = $derived(zonedParts(now, zone));
const todayDate = $derived(nowParts.date);
/** The current-time lines of the time grid, worked out once, not asked by each of its cells (#1085). */
const nowLines = $derived(nowIndicator && isTimeGrid ? nowLinesOf(columns, slots, slotMinutes, endMinutes, nowParts) : []);
const headerRows = $derived(buildHeaderRows(columns, range.days, resources, groupBy, {
  today: todayDate,
  dayLabel: (d) => { const h = dayHeader(d, loc); return { text: h.weekday + ' ' + h.day, full: h.full }; },
  corners: { time: uiString('scheduler', 'time'), resource: uiString('scheduler', 'resource') },
}));
const perWeek = $derived(weekends ? 7 : 5);
/** What the pointer may do with an event, for this file and the views it draws them in. */
const moveRules = $derived({ disabled, readonly, resources });
/** The grid's description of the keyboard's create, where events can be created. */
const createHint = $derived(disabled || readonly ? null : createHintId);
const monthWeeks = $derived(view === 'month' ? buildMonthWeeks(range.days, perWeek, shown, zone, dayMaxEvents) : []);
const monthHeads = $derived(monthWeeks.length ? monthWeeks[0].days.map((d) => ({ key: d, ...weekdayName(d, loc) })) : []);
const yearMonths = $derived(view === 'year' ? buildYearMonths(range.start, weekStart, expanded, zone) : []);
const yearCursor = $derived(yearDay >= range.start && yearDay < range.end ? yearDay : refDate);
const agendaGroups = $derived(view === 'agenda' ? buildAgendaDays(range.days, shown, zone) : []);
const tlColumns = $derived(view === 'timeline' ? timelineColumns(timelineScale, range.days, { timeZone: zone, startMinutes, endMinutes, slotMinutes }) : []);
const tlRows = $derived(view === 'timeline' ? placeTimeline(shown, timelineRows(resources, collapsed), tlColumns, zone) : []);
const isTree = $derived(resources.some((r) => (r.children?.length ?? 0) > 0));
/** Where the current time is along the timeline, in columns; null off the period or between columns. */
const tlNow = $derived(nowIndicator && tlColumns.some((c) => now >= c.start && now < c.end) ? axisPosition(tlColumns, now) : null);
const gridSize = $derived(view === 'month' ? { rows: monthWeeks.length, cols: perWeek }
  : view === 'timeline' ? { rows: tlRows.length, cols: tlColumns.length + 1 }
  : { rows: slots.length + 1, cols: columns.length });
/** The column `scrollTo` or the reference date is in: a day's slot at that hour, a day, the month of a year. */
const tlHomeColumn = $derived(Math.max(0, tlColumns.findIndex((c) => timelineScale === 'day' ? (c.minutes ?? 0) >= parseClock(scrollTo)
  : timelineScale === 'year' ? c.date === refDate.slice(0, 8) + '01' : c.date === refDate)));
/** The reference date's cell: its week and day in the month; in the time grid, its column at `scrollTo`, where the grid opens; the timeline's first row at that column. */
const homeCell = $derived(view === 'month'
  ? { row: Math.max(0, monthWeeks.findIndex((w) => w.days.includes(refDate))), col: Math.max(0, monthWeeks.find((w) => w.days.includes(refDate))?.days.indexOf(refDate) ?? 0) }
  : view === 'timeline' ? { row: 0, col: tlHomeColumn + 1 }
  : { row: Math.max(0, slots.findIndex((m) => m >= parseClock(scrollTo))) + 1, col: Math.max(0, columns.findIndex((c) => c.date === refDate)) });
/** The tab stop, inside the grid on screen: a view with fewer rows or columns keeps one cell reachable. */
const tabCell = $derived({ row: Math.min((active ?? homeCell).row, gridSize.rows - 1), col: Math.min((active ?? homeCell).col, gridSize.cols - 1) });
// The slots of the time grid in view, and the tab stop's wherever it is (#1085).
const slotWin = slotWindow({
  grid: () => (isTimeGrid ? gridEl : null),
  count: () => slots.length,
  slotHeight: () => slotPx,
  pinned: () => tabCell.row - 1,
});
/** The slot `scrollTo` is in, where the time grid opens. */
const openSlot = $derived(slots.findIndex((m) => m >= parseClock(scrollTo)));
const shownSlots = $derived(slotWin.rows().filter((ri) => ri < slots.length).map((ri) => ({ ri, m: slots[ri] })));
/** The events that start above the drawn slots and reach into them, drawn from the first one. */
const fromAbove = $derived(eventsFromAbove(byCell, slotWin.first(), new Set(slotWin.rows())));
// The rows and columns of the timeline in view, and the tab stop's wherever it is.
const tlWindow = timelineWindow({
  grid: () => (view === 'timeline' ? gridEl : null),
  rows: () => tlRows,
  columns: () => tlColumns.length,
  metrics: () => metrics,
  pinned: () => ({ row: tabCell.row, col: tabCell.col - 1 }),
});
const tlShown = $derived(tlWindow.rows().filter((vr) => vr.index < tlRows.length).map((vr) => ({ index: vr.index, top: vr.start, row: tlRows[vr.index] })));
const tlCols = $derived(tlWindow.columns().filter((vc) => vc.index < tlColumns.length).map((vc) => {
  const col = tlColumns[vc.index];
  return { index: vc.index, col, today: col.minutes === null && timelineScale !== 'year' && col.date === todayDate, ...timelineHeader(col, timelineScale, loc) };
}));

function viewName(v: CalendarView): string { return v === 'days' ? format(uiString('scheduler', 'daysView'), { count: days }) : uiString('scheduler', v); }

// ─── The period ────────────────────────────────────────────────────────────────

function moved(): void {
  active = null;
  const r = viewRange(view, refDate, rangeOptions);
  periodChange({ view, start: r.start, end: r.end });
  announce(periodLabel(periodView, r.days, loc, refDate));
}
function step(direction: 1 | -1): void { date = stepPeriod(view, refDate, direction, rangeOptions); moved(); }
function goToday(): void { date = today(); moved(); }
function pick(v: CalendarView): void { if (v !== view) { view = v; moved(); } }
/** A day opened from the month's «+N» or the year: the first time-grid view offered, on that day, focused. */
function openDay(d: string): void {
  const to = shownViews.find((v) => v === 'day') ?? shownViews.find((v) => v === 'week' || v === 'days') ?? 'day';
  date = d;
  view = to;
  moved();
  queueMicrotask(() => (gridEl?.querySelector('[role="gridcell"][tabindex="0"]') as HTMLElement | null)?.focus());
}

// ─── The grids: one tab stop, the arrows between cells ─────────────────────────

/** The cell of the grid a target is in: a grid cell, or a timeline row's resource, which the arrows reach too. */
function cellOf(target: EventTarget | null): HTMLElement | null {
  return target instanceof Element ? target.closest('[role="gridcell"], [data-part="rowHeader"]') as HTMLElement | null : null;
}
/** Open or close a timeline parent, keeping the focus on it. */
function toggleRow(row: number, open: boolean): void {
  const r = tlRows[row];
  if (!r?.parent || r.expanded === open) return;
  const next = new Set(collapsed);
  if (open) next.delete(r.key); else next.add(r.key);
  collapsed = next;
  focusCell(row, 0);
}
/**
 * The keys of a timeline row's resource, a treegrid's: Enter or Space opens or closes a parent, Right
 * opens a closed one, Left closes an open one or goes to a child's parent. True when the key was taken.
 */
function onRowHeaderKey(e: KeyboardEvent, row: number): boolean {
  const r = tlRows[row];
  if (!r) return false;
  if (e.key === 'Enter' || e.key === ' ') { if (r.parent) toggleRow(row, !r.expanded); return true; }
  if (e.key === 'ArrowRight' && r.parent && !r.expanded) { toggleRow(row, true); return true; }
  if (e.key === 'ArrowLeft') {
    if (r.parent && r.expanded) toggleRow(row, false);
    else if (r.level > 1) {
      for (let i = row - 1; i >= 0; i--) if (tlRows[i].level < r.level) { focusCell(i, 0); break; }
    }
    return true;
  }
  return false;
}
function focusCell(row: number, col: number): void {
  active = { row, col };
  queueMicrotask(() => {
    const cell = gridEl?.querySelector(`[data-row="${row}"][data-col="${col}"]`) as HTMLElement | null;
    cell?.focus();
  });
}
/** The slot a cell is: start and end as instants in the zone, and its resource. A month's day is a whole day. */
function slotOf(row: number, col: number) {
  const whole = (d: string, resource: string | null) => ({
    start: new Date(zonedInstant(d, 0, zone)).toISOString(), end: new Date(zonedInstant(d, 1440, zone)).toISOString(), resource, allDay: true,
  });
  if (view === 'month') return whole(monthWeeks[row].days[col], null);
  if (view === 'timeline') {
    const t = tlColumns[col - 1];
    return { start: new Date(t.start).toISOString(), end: new Date(t.end).toISOString(), resource: tlRows[row].resource?.id ?? null, allDay: t.minutes === null };
  }
  const c = columns[col];
  if (row === 0) return whole(c.date, c.resource?.id ?? null);
  const from = slots[row - 1];
  const to = Math.min(from + slotMinutes, endMinutes);
  return { start: new Date(zonedInstant(c.date, from, zone)).toISOString(), end: new Date(zonedInstant(c.date, to, zone)).toISOString(), resource: c.resource?.id ?? null, allDay: false };
}
/** An event drawn in the period, an occurrence of a series too. */
function eventById(id: string): SchedulerEvent | undefined { return expanded.find((e) => e.id === id); }

function onKey(e: KeyboardEvent): void {
  if (disabled) return;
  if (lift) { onLiftKey(e); return; }
  const cell = cellOf(e.target);
  if (!cell) return;
  const row = Number(cell.dataset.row);
  const col = Number(cell.dataset.col);
  if (e.target !== cell) {
    // Inside a cell: Space picks an event up; Escape gives the grid its keys back; Tab moves between
    // the cell's events and their ⋯. An event's ⋯ keeps its own keys: they open its menu.
    if (e.target instanceof Element && e.target.closest('pdx-dropdown-menu')) return;
    const button = e.target instanceof HTMLElement && e.target.matches('[data-part="eventButton"]') ? e.target : null;
    const id = (button?.closest(EVENT) as HTMLElement | null)?.dataset.id;
    if (e.key === ' ' && id) { e.preventDefault(); liftEvent(id, row, col, null); return; }
    // Enter edits an event the editor may change, after `event-open`; without the editor the button's
    // own click is the `event-open`.
    const ev = id ? eventById(id) : undefined;
    if (e.key === 'Enter' && ev && canEdit(ev)) { e.preventDefault(); eventOpen({ event: ev }); openEditor(ev, false); return; }
    if (e.key === 'Delete' && ev && canChange(ev)) { e.preventDefault(); if (deleteEvent(ev)) focusCell(row, col); return; }
    if (e.key === 'Escape') { e.preventDefault(); focusCell(row, col); }
    return;
  }
  if (view === 'timeline' && col === 0 && onRowHeaderKey(e, row)) { e.preventDefault(); return; }
  if (selection && (e.key === 'Enter' || e.key === 'Escape')) { e.preventDefault(); endSelection(e.key === 'Enter', row, col); return; }
  if (e.shiftKey && !e.altKey && !e.ctrlKey && !e.metaKey && e.key.startsWith('Arrow')) { e.preventDefault(); selectStep(row, col, e.key as 'ArrowUp' | 'ArrowDown' | 'ArrowLeft' | 'ArrowRight'); return; }
  // Any other key drops a selection, then does what it does.
  if (selection) dropSelection();
  if (e.key === 'Enter' || e.key === 'F2') {
    e.preventDefault();
    const inner = cell.querySelectorAll<HTMLElement>(INNER);
    if (inner.length) {
      for (const button of inner) button.tabIndex = 0;
      inner[0].focus();
    } else {
      const here = slotOf(row, col);
      slotOpen(here);
      // With the editor, an empty slot's Enter creates there: asked first, then edited.
      if (editor === 'dialog' && !readonly) {
        createOver({ start: here.start, end: here.end, resource: here.resource, wholeDay: here.allDay }, uiString('scheduler', 'newEvent'),
          (found) => beforeCreate({ start: here.start, end: here.end, resource: here.resource, allDay: here.allDay, conflicts: found }), true);
      }
    }
    return;
  }
  const target = gridKeyTarget(e, { row, col }, gridSize);
  if (!target) return;
  e.preventDefault();
  if ('period' in target) { step(target.period); focusCell(Math.min(row, gridSize.rows - 1), Math.min(col, gridSize.cols - 1)); return; }
  focusCell(target.cell.row, target.cell.col);
}

function onClick(e: MouseEvent): void {
  // The click a drag ends with is the drag's, not a click on what it was dropped on.
  if (disabled || drag.swallowClick()) return;
  if (lift?.byMenu) { placePicked(cellOf(e.target)); return; }
  if (lift) { endLift(false); return; }
  if (selection) dropSelection();
  const button = e.target instanceof Element ? e.target.closest(INNER) as HTMLElement | null : null;
  if (button?.dataset.part === 'more') { openDay(button.dataset.date ?? ''); return; }
  if (button) {
    const ev = eventById((button.closest(EVENT) as HTMLElement | null)?.dataset.id ?? '');
    if (ev) eventOpen({ event: ev });
    return;
  }
  const cell = cellOf(e.target);
  if (!cell) return;
  const row = Number(cell.dataset.row);
  const col = Number(cell.dataset.col);
  active = { row, col };
  if (cell.dataset.part === 'rowHeader') { if (tlRows[row]?.parent) toggleRow(row, !tlRows[row].expanded); return; }
  slotOpen(slotOf(row, col));
}

// The events of a cell are tab stops while the focus is among them; once it leaves them — to their
// cell with Escape, or anywhere else — they go back to tabindex -1, and the grid keeps one tab stop.
function onFocusOut(e: FocusEvent): void {
  const t = e.target instanceof HTMLElement ? e.target : null;
  if (!t?.matches(INNER)) return;
  const cell = cellOf(t);
  const next = e.relatedTarget instanceof HTMLElement ? e.relatedTarget : null;
  if (next?.matches(INNER) && cellOf(next) === cell) return;
  // Into an event's open menu, which is built on <body>: the focus comes back to its ⋯.
  if (next?.closest('[role="menu"]')) return;
  for (const button of cell?.querySelectorAll<HTMLElement>(INNER) ?? []) button.tabIndex = -1;
}

// The year: one tab stop over its days, the arrows by day and week, Enter or a click opens the day.
function onYearKey(e: KeyboardEvent): void {
  if (disabled) return;
  const at = (e.target as HTMLElement).dataset?.date;
  if (!at) return;
  if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDay(at); return; }
  const target = dayKeyTarget(e, at, { firstDay: weekStart, min: range.start, max: range.end });
  if (!target) return;
  e.preventDefault();
  if ('period' in target) {
    step(target.period);
    yearDay = refDate;
  } else yearDay = target.date;
  queueMicrotask(() => (gridEl?.querySelector(`[data-date="${yearCursor}"]`) as HTMLElement | null)?.focus());
}
function onYearClick(e: MouseEvent): void {
  if (disabled) return;
  const day = e.target instanceof Element ? e.target.closest('[data-date]') as HTMLElement | null : null;
  if (day?.dataset.date) openDay(day.dataset.date);
}

// ─── The pointer: move, resize, create ─────────────────────────────────────────

function withDraft(list: SchedulerEvent[], d: Draft | null): SchedulerEvent[] {
  if (!d) return list;
  if (d.id === '') return [...list, { id: DRAFT_ID, title: '', start: d.start, end: d.end, resource: d.resource, allDay: d.allDay === true }];
  return list.map((e) => (e.id === d.id ? placed(e, d) : e));
}
/** The event at its new range, with its resources as the placement says. */
function placed(e: SchedulerEvent, p: Placement): SchedulerEvent {
  const next: SchedulerEvent = { ...e, start: p.start, end: p.end };
  if (p.resource === undefined) delete next.resource; else next.resource = p.resource;
  return next;
}
function canMove(e: SchedulerEvent): boolean { return canDo(e, 'move', moveRules); }
function canResize(e: SchedulerEvent): boolean { return canDo(e, 'resize', moveRules); }
const rangeOf = (r: { start: string; end: string; resource?: string | string[] }): Range => (r.resource === undefined ? { start: r.start, end: r.end } : { start: r.start, end: r.end, resource: r.resource });

/** The cells of the grid on screen as points in time; null for the year and the agenda, which have none. */
function pointModel(): PointModel | null {
  if (view === 'year' || view === 'agenda') return null;
  return view === 'month' ? { view: 'month', weeks: monthWeeks, timeZone: zone }
    : view === 'timeline' ? { view: 'timeline', columns: tlColumns, rows: tlRows }
    : { view: 'time', columns, slots, timeZone: zone };
}
/** The drop point under the viewport point (`x`, `y`), in the grid on screen; null outside its cells. */
function pointAt(x: number, y: number): DropPoint | null {
  const model = pointModel();
  if (!gridEl || !model) return null;
  const cell = cellAt(gridEl, x, y);
  return cell ? pointOfCell(model, cell.row, cell.col) : null;
}
function onPointerDown(e: PointerEvent): void {
  // An event picked from its ⋯ waits for the click that places it.
  if (lift?.byMenu) return;
  if (lift) endLift(false);
  if (selection) dropSelection();
  drag.down(e);
}

// ─── The keyboard: lift, step, drop ────────────────────────────────────────────

/** Focus the button of event `id`, in `cell` when a piece of it is there: it is drawn again at every step. */
function focusEvent(id: string, cell: { row: number; col: number }): void {
  queueMicrotask(() => {
    const css = `[data-part="event"][data-id="${CSS.escape(id)}"] [data-part="eventButton"]`;
    const el = (gridEl?.querySelector(`[data-row="${cell.row}"][data-col="${cell.col}"] ${css}`) ?? gridEl?.querySelector(css)) as HTMLElement | null;
    el?.focus();
  });
}
/**
 * Event `id` in cell (`row`, `col`) picked up where it is, drawn as dragged: by Space (`gesture` null,
 * the first arrow chooses), or by its ⋯ (`move` or `end`), when a click on a slot also places it.
 */
function liftEvent(id: string, row: number, col: number, gesture: 'move' | 'end' | null): void {
  const ev = eventById(id);
  const model = pointModel();
  if (!ev || !model || (!canMove(ev) && !canResize(ev))) return;
  lift = { event: ev, gesture, resource: pointOfCell(model, row, col)?.resource ?? null, cell: { row, col }, origin: { row, col }, byMenu: gesture !== null };
  draft = { id: ev.id, start: ev.start, end: ev.end, resource: ev.resource };
  const said = gesture === null ? format(uiString('scheduler', 'lifted'), { title: ev.title, when: eventWhen(ev, zone, loc, resources) })
    : format(uiString('scheduler', gesture === 'move' ? 'picked' : 'pickedResize'), { title: ev.title });
  announce(said);
}
/** A choice in an event's ⋯: «Move» or «Resize» picks it up, for a click on a slot or the arrows. */
function onMenu(e: CustomEvent<{ key: string }>): void {
  if (disabled) return;
  const host = e.target instanceof Element ? e.target.closest(EVENT) as HTMLElement | null : null;
  const cell = cellOf(host);
  if (!host || !cell || (e.detail.key !== 'move' && e.detail.key !== 'resize')) return;
  if (lift) endLift(false);
  if (selection) dropSelection();
  const id = host.dataset.id ?? '';
  const row = Number(cell.dataset.row);
  const col = Number(cell.dataset.col);
  liftEvent(id, row, col, e.detail.key === 'move' ? 'move' : 'end');
  focusEvent(id, { row, col });
}
/**
 * A click while an event picked from its ⋯ waits: on a cell, the event moves to start there, or ends
 * there, through the same way as a drop; anywhere else it is put back.
 */
function placePicked(target: HTMLElement | null): void {
  const l = lift;
  const model = pointModel();
  const at = target ? { row: Number(target.dataset.row), col: Number(target.dataset.col) } : null;
  const point = at && model ? pointOfCell(model, at.row, at.col) : null;
  if (!l || !at || !point || l.gesture === null) { endLift(false); return; }
  draft = { id: l.event.id, ...(l.gesture === 'move'
    ? moveEvent(l.event, { point: edgePoint(l.event, 'start', l.resource, zone) }, point, zone)
    : resizeEvent(l.event, 'end', point, slotMinutes * 60_000, zone)) };
  lift = { ...l, cell: at };
  endLift(true);
}
/**
 * A key while an event is lifted: an arrow steps it, the first arrow choosing what it does (move, or
 * resize from the end or the start); Space or Enter drops it, Escape puts it back. The event keeps the
 * focus: Tab would leave it lifted somewhere else.
 */
function onLiftKey(e: KeyboardEvent): void {
  const l = lift;
  if (!l) return;
  if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); endLift(false); return; }
  if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); endLift(true); return; }
  if (e.key === 'Tab') { e.preventDefault(); return; }
  const k = keyGesture(e);
  const model = pointModel();
  if (!k || !model) return;
  e.preventDefault();
  if ((l.gesture !== null && k.gesture !== l.gesture) || !(k.gesture === 'move' ? canMove(l.event) : canResize(l.event))) return;
  const current = draft ? placed(l.event, draft) : l.event;
  const stepped = keyStep(model, gridSize, current, { gesture: k.gesture, key: k.key, resource: l.resource, cell: l.cell, step: slotMinutes * 60_000, timeZone: zone });
  if (!stepped) return;
  const resource = k.gesture === 'move' ? (pointOfCell(model, stepped.cell.row, stepped.cell.col)?.resource ?? l.resource) : l.resource;
  draft = { id: l.event.id, ...stepped.placement };
  lift = { ...l, gesture: k.gesture, resource, cell: stepped.cell };
  active = stepped.cell;
  focusEvent(l.event.id, stepped.cell);
  announce(eventWhen(placed(l.event, stepped.placement), zone, loc, resources));
}
/** The lifted event dropped where it is (`commit`), through the pointer's own way, or put back. */
function endLift(commit: boolean): void {
  const l = lift;
  const d = draft;
  lift = null;
  draft = null;
  if (!l) return;
  if (commit && d && l.gesture !== null) {
    const written = commitGesture(l.gesture === 'move' ? { kind: 'move', event: l.event } : { kind: 'resize', event: l.event, edge: l.gesture }, d);
    focusEvent(written ?? l.event.id, l.cell);
    return;
  }
  if (!commit) announce(format(uiString('scheduler', 'cancelled'), { title: l.event.title }));
  active = l.origin;
  focusEvent(l.event.id, l.origin);
}

// ─── The keyboard: select empty cells, create ──────────────────────────────────

/**
 * Shift+arrow on cell (`row`, `col`): the selection, begun there if there is none, one cell further,
 * drawn as a drag over the same cells draws it. A key that cannot take it there does nothing.
 */
function selectStep(row: number, col: number, key: 'ArrowUp' | 'ArrowDown' | 'ArrowLeft' | 'ArrowRight'): void {
  const model = pointModel();
  if (readonly || !model) return;
  const anchor = selection?.anchor ?? { row, col };
  const r = keySelect(model, gridSize, { anchor, cell: { row, col }, key, step: slotMinutes * 60_000, timeZone: zone });
  if (!r) return;
  selection = { anchor, cell: r.cell };
  draft = { id: '', start: r.range.start, end: r.range.end, resource: r.range.resource ?? undefined, allDay: r.range.allDay };
  focusCell(r.cell.row, r.cell.col);
  const dayOf = (iso: string) => zonedParts(Date.parse(iso), zone).date;
  const range: SchedulerEvent = r.range.allDay
    ? { id: '', title: '', start: dayOf(r.range.start), end: dayOf(r.range.end), allDay: true }
    : { id: '', title: '', start: r.range.start, end: r.range.end };
  if (r.range.resource !== null) range.resource = r.range.resource;
  announce(format(uiString('scheduler', 'selected'), { when: eventWhen(range, zone, loc, resources) }));
}
/** The selection forgotten, and no longer drawn. */
function dropSelection(): void {
  selection = null;
  draft = null;
}
/** Enter creates an event over the selection, through the pointer's own way; Escape drops it. The focus stays on cell (`row`, `col`). */
function endSelection(commit: boolean, row: number, col: number): void {
  const d = draft;
  dropSelection();
  if (commit && d) commitGesture({ kind: 'create' }, d);
  else announce(uiString('scheduler', 'selectCancelled'));
  focusCell(row, col);
}

const drag = schedulerDrag({
  pointAt,
  event: (id) => eventById(id),
  can: (e, what) => (what === 'move' ? canMove(e) : canResize(e)),
  canCreate: () => !disabled && !readonly,
  step: () => slotMinutes * 60_000,
  timeZone: () => zone,
  preview(d) { draft = d; },
  commit: (g, d) => commitGesture(g, d),
});

/** A gesture refused: say why, aloud and in `rejected`. */
function refuse(action: 'move' | 'resize' | 'create', event: SchedulerEvent | null, to: Range, reason: 'overlap' | 'prevented', found: SchedulerEvent[]): void {
  rejected({ action, event, to, reason, conflicts: found });
  const title = event?.title ?? uiString('scheduler', 'newEvent');
  announce(reason === 'overlap' ? format(uiString('scheduler', 'overlapRefused'), { title, count: found.length }) : format(uiString('scheduler', 'refused'), { title }));
}

/**
 * A new event over a range (instants in UTC; whole days when `wholeDay`), after asking: `ask` is the
 * app's `before-create` or `external-drop`. With `edit`, the built-in editor opens on it and its Save
 * writes it; without, it is written to `events` now, then `create`.
 */
function createOver(r: { start: string; end: string; resource: string | null; wholeDay: boolean }, title: string, ask: (found: SchedulerEvent[]) => boolean, edit: boolean): void {
  const found = conflicts(expanded, null, r, zone);
  const to = rangeOf({ start: r.start, end: r.end, resource: r.resource ?? undefined });
  if (preventOverlap && found.length) return refuse('create', null, to, 'overlap', found);
  if (!ask(found)) return refuse('create', null, to, 'prevented', found);
  const dayOf = (iso: string) => zonedParts(Date.parse(iso), zone).date;
  const made: SchedulerEvent = { id: createId(), title, start: r.wholeDay ? dayOf(r.start) : r.start, end: r.wholeDay ? dayOf(r.end) : r.end };
  if (r.wholeDay) made.allDay = true;
  if (r.resource !== null) made.resource = r.resource;
  if (edit) { openEditor(made, true); return; }
  events = [...events, made];
  create({ event: made });
  announce(format(uiString('scheduler', 'created'), { title }));
}

// ─── The built-in editor ───────────────────────────────────────────────────────

/** Whether the app may change the event at all: move it, resize it, edit it or delete it. */
function canChange(e: SchedulerEvent): boolean { return canMove(e) || canResize(e); }
/** Whether the built-in editor opens on the event. */
function canEdit(e: SchedulerEvent): boolean { return editor === 'dialog' && canChange(e); }
/** An occurrence the scheduler drew from a series, not an event of `events`. */
function isOccurrence(e: SchedulerEvent): boolean { return e.seriesId !== undefined && !events.some((x) => x.id === e.id); }

/** The editor on event `e`; for an occurrence of a series, with that series, which it repeats as. */
function openEditor(e: SchedulerEvent, isNew: boolean): void {
  editReturn = document.activeElement instanceof HTMLElement ? document.activeElement : null;
  const series = isOccurrence(e) ? events.find((x) => x.id === e.seriesId) : undefined;
  editing = series ? { event: e, isNew, series } : { event: e, isNew };
}
/** The editor closed: the focus goes back where it was, or to the grid's cell. */
function closeEditor(focusId?: string): void {
  editing = null;
  const back = editReturn;
  editReturn = null;
  if (focusId) focusEvent(focusId, active ?? tabCell);
  else if (back?.isConnected) queueMicrotask(() => back.focus());
  else focusCell(tabCell.row, tabCell.col);
}

/**
 * The series `series` as the editor's fields made its occurrence `occurrence` into `next`: moved by
 * what the occurrence moved, with the occurrence's title, notes, all day and rule. A changed rule
 * leaves the series' overrides behind (they belonged to occurrences it may no longer have).
 */
function seriesFrom(series: SchedulerEvent, occurrence: SchedulerEvent, next: SchedulerEvent): SchedulerEvent {
  const out: SchedulerEvent = { ...shiftSeries(series, occurrence, { start: next.start, end: next.end, resource: next.resource }, zone), title: next.title };
  for (const k of ['notes', 'allDay', 'rrule'] as const) {
    if (next[k] === undefined) delete out[k]; else out[k] = next[k] as never;
  }
  return out;
}

/**
 * The editor's Save: `before-save` first, which may refuse it (the editor stays open); then `events`
 * is written — a new event added; an occurrence of a series made an override of its own (`scope`
 * 'occurrence') or its series changed (`scope` 'series'); any other replaced — and `save` (and
 * `create` for a new one) is emitted.
 */
function onEditorSave(next: SchedulerEvent, scope?: 'occurrence' | 'series'): void {
  const ed = editing;
  if (!ed) return;
  const series = ed.series && scope === 'series' ? ed.series : undefined;
  const event = series ? seriesFrom(series, ed.event, next) : next;
  const previous = ed.isNew ? null : series ?? ed.event;
  const to = rangeOf(event);
  const found = conflicts(expanded, ed.isNew ? null : ed.event.id, next, zone);
  if (preventOverlap && found.length) { refuse(ed.isNew ? 'create' : 'move', previous, to, 'overlap', found); return; }
  const asked = ed.series ? { scope: scope ?? 'occurrence' } : {};
  if (!beforeSave({ event, previous, isNew: ed.isNew, ...asked })) { announce(format(uiString('scheduler', 'refused'), { title: next.title })); return; }
  let written = event;
  let focusId: string | undefined;
  if (ed.isNew) { events = [...events, event]; focusId = event.id; }
  else if (series) {
    const ruleChanged = event.rrule !== series.rrule;
    events = events.filter((x) => !(ruleChanged && x.seriesId === series.id)).map((x) => (x.id === series.id ? event : x));
    focusId = occurrenceId(series.id, next.start);
  } else if (ed.series) { written = { ...next, id: createId() }; events = [...events, written]; focusId = written.id; }
  else events = events.map((x) => (x.id === next.id ? next : x));
  save({ event: written, previous, isNew: ed.isNew, ...asked });
  if (ed.isNew) create({ event: written });
  announce(format(uiString('scheduler', 'saved'), { title: written.title }));
  closeEditor(focusId);
}

/**
 * Remove event `e`, asking `before-remove` first: out of `events`; for an occurrence of a series, its
 * start added to the series' `exdate` (`scope` 'occurrence'), or the whole series and its overrides
 * removed (`scope` 'series'). True when it is done.
 */
function deleteEvent(e: SchedulerEvent, scope?: 'occurrence' | 'series'): boolean {
  const occurrence = isOccurrence(e);
  const series = occurrence && scope === 'series' ? events.find((x) => x.id === e.seriesId) : undefined;
  const target = series ?? e;
  const asked = occurrence ? { scope: scope ?? 'occurrence' } : {};
  if (!beforeRemove({ event: target, ...asked })) { announce(format(uiString('scheduler', 'refused'), { title: e.title })); return false; }
  if (series) events = events.filter((x) => x.id !== series.id && x.seriesId !== series.id);
  else if (occurrence) {
    events = events.map((x) => (x.id === e.seriesId ? { ...x, exdate: [...(x.exdate ?? []), e.recurrenceId ?? e.start] } : x));
  } else events = events.filter((x) => x.id !== e.id);
  remove({ event: target, ...asked });
  announce(format(uiString('scheduler', 'deleted'), { title: target.title }));
  return true;
}
function onEditorDelete(scope?: 'occurrence' | 'series'): void {
  const ed = editing;
  if (ed && deleteEvent(ed.event, scope)) { editReturn = null; closeEditor(); }
}

/** A double click on an event edits it. */
function onDblClick(e: MouseEvent): void {
  if (disabled || lift) return;
  const host = e.target instanceof Element ? e.target.closest(EVENT) as HTMLElement | null : null;
  const ev = host ? eventById(host.dataset.id ?? '') : undefined;
  if (ev && canEdit(ev)) openEditor(ev, false);
}

/**
 * Something dragged from outside (a `useDrag` source of the app) dropped on the grid: an event there,
 * titled by its data's `title`, as long as its data's `duration` (minutes) or one slot; a whole day
 * on a day. `external-drop` is asked first.
 */
function dropFromOutside(data: unknown, x: number, y: number): void {
  if (disabled || readonly) return;
  const p = pointAt(x, y);
  if (!p) return;
  const info = (typeof data === 'object' && data !== null ? data : {}) as { title?: unknown; duration?: unknown };
  const minutes = typeof info.duration === 'number' && info.duration > 0 ? info.duration : slotMinutes;
  const end = p.allDay ? zonedInstant(addDays(p.date, 1), 0, zone) : p.at + minutes * 60_000;
  const r = { start: new Date(p.at).toISOString(), end: new Date(end).toISOString(), resource: p.resource, wholeDay: p.allDay };
  const title = typeof info.title === 'string' && info.title ? info.title : uiString('scheduler', 'newEvent');
  createOver(r, title, (found) => externalDrop({ data, start: r.start, end: r.end, resource: r.resource, allDay: r.wholeDay, conflicts: found }), false);
}
const dropZone = useDropZone(() => (view === 'year' || view === 'agenda' ? null : gridEl), { onDrop: (data, at) => dropFromOutside(data, at.x, at.y) });

/** What ended on a draft, from the pointer or the keyboard. */
type GestureEnd = { kind: 'create' } | { kind: 'move'; event: SchedulerEvent } | { kind: 'resize'; event: SchedulerEvent; edge: 'start' | 'end' };
/**
 * The one way a gesture changes `events`: check the overlap, ask the app, write, say. An occurrence of
 * a series asks with `scope: 'occurrence'`, which the app may set to 'series': left so, the occurrence
 * becomes an override of its own in `events`; set, the whole series moves by what the occurrence did.
 * Returns the id the changed event is drawn under now, for the focus; null when nothing changed.
 */
function commitGesture(g: GestureEnd, d: Draft): string | null {
  if (g.kind === 'create') {
    const r = { start: d.start, end: d.end, resource: typeof d.resource === 'string' ? d.resource : null, wholeDay: d.allDay === true };
    createOver(r, uiString('scheduler', 'newEvent'), (found) => beforeCreate({ start: r.start, end: r.end, resource: r.resource, allDay: r.wholeDay, conflicts: found }), editor === 'dialog');
    return null;
  }
  const e = g.event;
  if (d.start === e.start && d.end === e.end && JSON.stringify(d.resource) === JSON.stringify(e.resource)) return null;
  const from = rangeOf(e);
  const to = rangeOf(d);
  const found = conflicts(expanded, e.id, d, zone);
  if (preventOverlap && found.length) { refuse(g.kind, e, to, 'overlap', found); return null; }
  // An occurrence the scheduler drew from a series, not an event of `events`: the app says how far it goes.
  const series = e.seriesId !== undefined && !events.some((x) => x.id === e.id) ? events.find((x) => x.id === e.seriesId) : undefined;
  const asked: { scope?: 'occurrence' | 'series' } = series ? { scope: 'occurrence' } : {};
  const ok = g.kind === 'move' ? beforeMove(Object.assign(asked, { event: e, from, to, conflicts: found }))
    : beforeResize(Object.assign(asked, { event: e, edge: g.edge, from, to, conflicts: found }));
  if (!ok) { refuse(g.kind, e, to, 'prevented', found); return null; }
  const scope = series ? (asked.scope === 'series' ? 'series' : 'occurrence') : undefined;
  let next: SchedulerEvent;
  let drawnAs: string;
  if (series && scope === 'series') {
    next = shiftSeries(series, e, d, zone);
    events = events.map((x) => (x.id === series.id ? next : x));
    drawnAs = occurrenceId(series.id, d.start);
  } else if (series) {
    next = { ...placed(e, d), id: createId() };
    events = [...events, next];
    drawnAs = next.id;
  } else {
    next = placed(e, d);
    events = events.map((x) => (x.id === e.id ? next : x));
    drawnAs = next.id;
  }
  const done = { event: next, from, to, conflicts: found, ...(scope ? { scope } : {}) };
  if (g.kind === 'move') move(done);
  else resize({ ...done, edge: g.edge });
  announce(format(uiString('scheduler', g.kind === 'move' ? 'moved' : 'resized'), { title: next.title }));
  return drawnAs;
}

// ─── Mount: the clock; the time grid opens at `scrollTo` ───────────────────────

/**
 * The timeline at its home column, right of the resources: a day's slot at `scrollTo`, the reference
 * date, its month. Not while the focus is in the grid: PageDown keeps the focused cell where it is.
 */
function timelineHome(): void {
  requestAnimationFrame(() => {
    if (view !== 'timeline' || !gridEl || gridEl.contains(document.activeElement)) return;
    gridEl.scrollLeft = tlWindow.columnRect(tlHomeColumn).start;
  });
}
// It opens there, and goes back there for another period or scale: the columns are not the same ones.
$watch(tlColumns, () => timelineHome());
// The time grid opens at `scrollTo` by itself (`open-at`), from the slot height its probe measures.
$watch(gridEl, (grid) => { if (grid && view === 'timeline') timelineHome(); });
let clock: ReturnType<typeof setInterval> | undefined;
// A press anywhere outside the grid puts a lifted event back, and drops a selection: either would stay
// drawn where the keys left it.
const pressOutside = (e: PointerEvent) => {
  if (e.target instanceof Node && gridEl?.contains(e.target)) return;
  if (lift) endLift(false);
  if (selection) dropSelection();
};
onMount(() => {
  clock = setInterval(() => { now = Date.now(); }, 60_000);
  document.addEventListener('pointerdown', pressOutside, true);
});
onDestroy(() => {
  if (clock !== undefined) clearInterval(clock);
  document.removeEventListener('pointerdown', pressOutside, true);
  tlWindow.dispose(); slotWin.dispose(); drag.cancel(); dropZone.dispose();
});
</script>

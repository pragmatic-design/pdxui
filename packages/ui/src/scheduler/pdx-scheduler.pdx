<template>
  <div class="pdx-scheduler" data-part="root" role="group" :aria-label="label || uiString('scheduler', 'label')">
    <div class="pdx-scheduler-toolbar" data-part="toolbar" role="toolbar" :aria-label="uiString('scheduler', 'toolbar')">
      <button type="button" class="pdx-scheduler-button" data-part="prev" :aria-label="uiString('scheduler', 'previous')" :disabled="disabled" @click="step(-1)">‹</button>
      <button type="button" class="pdx-scheduler-button" data-part="todayButton" :disabled="disabled" @click="goToday()">{{ uiString('scheduler', 'today') }}</button>
      <button type="button" class="pdx-scheduler-button" data-part="next" :aria-label="uiString('scheduler', 'next')" :disabled="disabled" @click="step(1)">›</button>
      <div class="pdx-scheduler-period" data-part="period" :id="periodId">{{ periodText }}</div>
      @if (shownViews.length > 1) {
        <div class="pdx-scheduler-views" data-part="viewSwitcher" role="group" :aria-label="uiString('scheduler', 'views')">
          @for (shownViews as v; track v) {
            <button type="button" class="pdx-scheduler-button" :aria-pressed="v === view ? 'true' : 'false'" :disabled="disabled" @click="pick(v)">{{ viewName(v) }}</button>
          }
        </div>
      }
    </div>
    @if (view === 'month') {
      <div class="pdx-scheduler-grid pdx-scheduler-month" data-part="grid" role="grid" :aria-labelledby="periodId" aria-readonly="true"
        :style="'--_scheduler-cols:' + perWeek + ';--_scheduler-lanes:' + dayMaxEvents" :ref="gridEl"
        @keydown="onKey($event)" @click="onClick($event)" @focusout="onFocusOut($event)">
        <div role="row" class="pdx-scheduler-row pdx-scheduler-head">
          @for (monthHeads as h; track h.key) {
            <div role="columnheader" class="pdx-scheduler-header" data-part="columnHeader" :aria-label="h.full">{{ h.short }}</div>
          }
        </div>
        @for (monthWeeks as w, wi; track w.key) {
          <div role="row" class="pdx-scheduler-row">
            @for (w.days as d, di; track d) {
              <div role="gridcell" class="pdx-scheduler-cell pdx-scheduler-day" data-part="slot" :data-row="wi" :data-col="di"
                :data-outside="d.slice(0, 7) === refDate.slice(0, 7) ? null : ''" :data-today="d === todayDate ? '' : null" :aria-current="d === todayDate ? 'date' : null"
                :tabindex="tabCell.row === wi && tabCell.col === di ? 0 : -1">
                <span class="pdx-scheduler-day-number" aria-hidden="true">{{ dayHeader(d, loc).day }}</span>
                <span class="pdx-sr-only">{{ dayHeader(d, loc).full }}</span>
                @for (itemsAt(w, di) as it; track it.id) {
                  <button type="button" class="pdx-scheduler-event pdx-scheduler-bar" :data-line="it.bar ? null : ''" data-part="event" tabindex="-1" :data-id="it.event.id"
                    :style="'--_scheduler-span:' + it.span + ';--_scheduler-lane:' + it.lane + colorStyle(it.event)"
                    :data-before="it.before ? '' : null" :data-after="it.after ? '' : null" :aria-label="dayEventName(it.event, it.minutes, w, it.first, it.span)">
                    @render event?.(it.event) @else {
                      @if (!it.bar) { <span class="pdx-scheduler-event-time">{{ clockLabel(it.minutes ?? 0, loc) }}</span> }
                      <span class="pdx-scheduler-event-title">{{ it.event.title }}</span>
                    }
                  </button>
                }
                @if (w.more[di] > 0) {
                  <button type="button" class="pdx-scheduler-more" data-part="more" tabindex="-1" :data-date="d"
                    :aria-label="format(uiString('scheduler', 'moreName'), { count: w.more[di], date: dayHeader(d, loc).full })">{{ format(uiString('scheduler', 'more'), { count: w.more[di] }) }}</button>
                }
              </div>
            }
          </div>
        }
      </div>
    } @else if (view === 'year') {
      <div class="pdx-scheduler-year" :ref="gridEl" @keydown="onYearKey($event)" @click="onYearClick($event)">
        @for (yearMonths as m; track m.key) {
          <div class="pdx-scheduler-mini" data-part="yearMonth" role="grid" :aria-label="monthName(m.key, loc)" aria-readonly="true">
            <div class="pdx-scheduler-mini-title" aria-hidden="true">{{ monthName(m.key, loc) }}</div>
            <div role="row" class="pdx-scheduler-row">
              @for (monthHeadsOf(m) as h; track h.key) {
                <div role="columnheader" class="pdx-scheduler-mini-head" :aria-label="h.full">{{ h.narrow }}</div>
              }
            </div>
            @for (m.weeks as w; track w[0].date) {
              <div role="row" class="pdx-scheduler-row">
                @for (w as d; track d.date) {
                  @if (d.inMonth) {
                    <div role="gridcell" class="pdx-scheduler-mini-day" data-part="slot" :data-date="d.date" :tabindex="d.date === yearCursor ? 0 : -1"
                      :data-events="d.count > 0 ? '' : null" :data-today="d.date === todayDate ? '' : null" :aria-current="d.date === todayDate ? 'date' : null"
                      :aria-label="format(uiString('scheduler', 'dayName'), { date: dayHeader(d.date, loc).full, count: d.count })">{{ dayHeader(d.date, loc).day }}</div>
                  } @else {
                    <div role="gridcell" class="pdx-scheduler-mini-day" data-outside></div>
                  }
                }
              </div>
            }
          </div>
        }
      </div>
    } @else if (view === 'agenda') {
      <div class="pdx-scheduler-agenda" data-part="agendaList" @click="onClick($event)">
        @if (agendaGroups.length === 0) {
          <p class="pdx-scheduler-empty">{{ uiString('scheduler', 'noEvents') }}</p>
        }
        @for (agendaGroups as ad; track ad.date) {
          <div class="pdx-scheduler-agenda-day" :data-today="ad.date === todayDate ? '' : null">
            <div class="pdx-scheduler-agenda-date" :id="periodId + '-' + ad.date">{{ dayHeader(ad.date, loc).full }}</div>
            <ul class="pdx-scheduler-agenda-items" :aria-labelledby="periodId + '-' + ad.date">
              @for (ad.items as it; track it.event.id) {
                <li>
                  <button type="button" class="pdx-scheduler-agenda-event" data-part="event" :data-id="it.event.id" :style="colorStyle(it.event)">
                    <span class="pdx-scheduler-agenda-time">{{ it.allDay ? uiString('scheduler', 'allDay') : spanLabel(it.start, it.end, loc) }}</span>
                    <span class="pdx-scheduler-agenda-title">@render event?.(it.event) @else { {{ it.event.title }} }</span>
                    @if (resourceNames(it.event)) { <span class="pdx-scheduler-agenda-resource">{{ resourceNames(it.event) }}</span> }
                  </button>
                </li>
              }
            </ul>
          </div>
        }
      </div>
    } @else {
      <div class="pdx-scheduler-grid" data-part="grid" role="grid" :aria-labelledby="periodId" aria-readonly="true"
        :style="'--_scheduler-cols:' + columns.length + ';--_scheduler-heads:' + headerRows.length + ';--_scheduler-lanes:' + allDay.lanes" :ref="gridEl"
        @keydown="onKey($event)" @click="onClick($event)" @focusout="onFocusOut($event)">
        @for (headerRows as hr; track hr.key) {
          <div role="row" class="pdx-scheduler-row pdx-scheduler-head">
            <div role="columnheader" class="pdx-scheduler-corner"><span class="pdx-sr-only">{{ hr.corner }}</span></div>
            @for (hr.cells as h; track h.key) {
              <div role="columnheader" class="pdx-scheduler-header" data-part="columnHeader" :aria-label="h.full"
                :aria-colspan="h.span > 1 ? h.span : null" :style="'grid-column: span ' + h.span" :data-today="h.today ? '' : null">{{ h.text }}</div>
            }
          </div>
        }
        <div role="row" class="pdx-scheduler-row" data-part="allDayRow">
          <div role="rowheader" class="pdx-scheduler-time pdx-scheduler-allday-label">{{ uiString('scheduler', 'allDay') }}</div>
          @for (columns as c, ci; track c.key) {
            <div role="gridcell" class="pdx-scheduler-cell pdx-scheduler-allday" data-part="slot" data-row="0" :data-col="ci" :tabindex="tabCell.row === 0 && tabCell.col === ci ? 0 : -1" :style="'--_scheduler-col:' + ci">
              @for (barsAt(ci) as b; track b.id) {
                <button type="button" class="pdx-scheduler-event pdx-scheduler-bar" data-part="event" tabindex="-1" :data-id="b.id"
                  :style="'--_scheduler-span:' + b.span + ';--_scheduler-lane:' + b.lane + colorStyle(b.event, c)"
                  :data-before="b.before ? '' : null" :data-after="b.after ? '' : null" :aria-label="allDayName(b.event, c)">
                  @render event?.(b.event) @else { <span class="pdx-scheduler-event-title">{{ b.event.title }}</span> }
                </button>
              }
            </div>
          }
        </div>
        @for (slots as m, ri; track m) {
          <div role="row" class="pdx-scheduler-row">
            <div role="rowheader" class="pdx-scheduler-time" data-slot :data-hour="m % 60 === 0 ? '' : null" :data-first="ri === 0 ? '' : null">{{ clockLabel(m, loc) }}</div>
            @for (columns as c, ci; track c.key) {
              <div role="gridcell" class="pdx-scheduler-cell" data-part="slot" :data-row="ri + 1" :data-col="ci"
                :data-off="offHours(c, m) ? '' : null" :data-hour="m % 60 === 0 ? '' : null"
                :tabindex="tabCell.row === ri + 1 && tabCell.col === ci ? 0 : -1">
                @for (eventsAt(ci, ri) as p; track p.id) {
                  <button type="button" class="pdx-scheduler-event" data-part="event" tabindex="-1" :data-id="p.id"
                    :style="'--_scheduler-offset:' + p.offset + ';--_scheduler-length:' + p.length + ';--_scheduler-column:' + p.column + ';--_scheduler-columns:' + p.columns + ';--_scheduler-span:' + p.span + colorStyle(p.event, c)"
                    :data-before="p.before ? '' : null" :data-after="p.after ? '' : null" :aria-label="timedName(p, c)">
                    @render event?.(p.event) @else {
                      <span class="pdx-scheduler-event-title">{{ p.event.title }}</span>
                      <span class="pdx-scheduler-event-time">{{ timeOf(p) }}</span>
                    }
                  </button>
                }
                @if (nowAt(ci, ri) !== null) {
                  <div class="pdx-scheduler-now" data-part="nowLine" aria-hidden="true" :style="'--_scheduler-offset:' + nowAt(ci, ri)"></div>
                }
              </div>
            }
          </div>
        }
      </div>
    }
  </div>
</template>

<script>
/**
 * A calendar of events in time, by day and by resource. The day, week and N-days views are a grid of
 * time slots, with an all-day row, the current time and the working hours marked, and each resource
 * (a room, a technician) can have its own columns. The month view is a grid of days with the events
 * stacked in each and a «+N» where they do not fit; the year view, twelve months with the days that
 * have events marked; the agenda, a list of the period's events by day. The grids are WAI-ARIA grids:
 * one tab stop, the arrows from cell to cell, Enter into a cell's events and Escape back out, PageUp and
 * PageDown through periods. A click or Enter on an event emits `event-open`; on an empty slot or day,
 * `slot-open`; on the «+N» or a day of the year, it opens that day.
 *
 * @csspart root - The scheduler, a `role="group"` named by `label`.
 * @csspart toolbar - The bar above the grid: previous, today, next, the period and the views.
 * @csspart prev - The button to the previous period.
 * @csspart todayButton - The button back to today.
 * @csspart next - The button to the next period.
 * @csspart period - The period on screen, which names the grid.
 * @csspart viewSwitcher - The view buttons, shown when `views` offers more than one.
 * @csspart grid - The `role="grid"` of the time slots or of the month's days.
 * @csspart columnHeader - A day's or a resource's header, or a weekday's in the month.
 * @csspart allDayRow - The row of all-day events.
 * @csspart slot - A cell: a time slot of a day and resource, its all-day cell, a day of the month or of the year.
 * @csspart event - An event; `[data-before]` / `[data-after]` mark one that goes on past the piece shown.
 * @csspart more - A month day's «+N», the events that did not fit; it opens the day.
 * @csspart yearMonth - A month of the year view, a `role="grid"` of its own.
 * @csspart agendaList - The agenda's list of days.
 * @csspart nowLine - The line at the current time.
 *
 * @cssstate disabled - `disabled` is set.
 */
import { announce, generatedId, getFirstDayOfWeek, onDestroy, onMount, today } from '@pdxui/core';
import { uiString, format } from '../shared/i18n';
import { resolveLocale } from '../shared/locale';
import { viewRange, stepPeriod, parseClock, zonedInstant, zonedParts } from './time';
import { buildColumns, buildSlots, buildHeaderRows, cellIndex, eventResources, placeTimed, placeAllDay, isBusinessTime, type SchedulerEvent, type SchedulerResource, type BusinessHours, type Column, type PlacedEvent } from './grid-model';
import { buildMonthWeeks, buildYearMonths, buildAgendaDays, type MonthWeek, type YearMonth } from './calendar-model';
import { periodLabel, dayHeader, dayRange, clockLabel, spanLabel, monthName, weekdayName } from './labels';
import { gridKeyTarget, dayKeyTarget } from './grid-keys';
import '@pdxui/design/components/scheduler';

type CalendarView = 'day' | 'week' | 'days' | 'month' | 'year' | 'agenda';
const VIEWS: CalendarView[] = ['day', 'week', 'days', 'month', 'year', 'agenda'];
/** What a cell's Enter goes into: its events, and a month day's «+N». */
const INNER = '[data-part="event"], [data-part="more"]';

/** The events. A start or end with an offset or `Z` is an instant; without one, a wall time in `time-zone`; a date alone, all day. */
@prop events: SchedulerEvent[] = [];
/** The resources, each with its own columns in the time grid; children are drawn as their leaves. Empty: one column per day. */
@prop resources: SchedulerResource[] = [];
/** The view on screen. */
@model view: 'day' | 'week' | 'days' | 'month' | 'year' | 'agenda' = 'week';
/** The views the bar offers, in order; one or none hides the switcher. */
@prop views: ('day' | 'week' | 'days' | 'month' | 'year' | 'agenda')[] = ['day', 'week', 'days', 'month', 'year', 'agenda'];
/** The reference date (ISO). Empty: today. */
@model date: string = '';
/** How many days the `days` view shows. */
@prop days: number = 3;
/** How many days the `agenda` view lists, from the reference date. */
@prop agendaDays: number = 7;
/** How many events a day of the month shows before its «+N». */
@prop dayMaxEvents: number = 3;
/** With resources: each resource's days together (`resource`) or each day's resources (`date`). */
@prop groupBy: 'resource' | 'date' = 'resource';
/** Show Saturday and Sunday in the day columns and the month. */
@prop weekends: boolean = true;
/** The first day of the week, 0 = Sunday … 6 = Saturday; -1: the locale's. */
@prop firstDay: number = -1;
/** The first visible hour, `HH:mm`. */
@prop startHour: string = '00:00';
/** The end of the visible hours, `HH:mm`, up to `24:00`. */
@prop endHour: string = '24:00';
/** The hour the time grid opens scrolled to. */
@prop scrollTo: string = '08:00';
/** The length of a slot, in minutes. */
@prop slotMinutes: number = 30;
/** The working hours per weekday, shaded outside; a resource's own `businessHours` win in its columns. */
@prop businessHours: BusinessHours = { 1: { start: '09:00', end: '18:00' }, 2: { start: '09:00', end: '18:00' }, 3: { start: '09:00', end: '18:00' }, 4: { start: '09:00', end: '18:00' }, 5: { start: '09:00', end: '18:00' } };
/** Draw a line at the current time. */
@prop nowIndicator: boolean = true;
/** The IANA time zone events are shown in. Empty: the browser's. */
@prop timeZone: string = '';
/** Locale for dates and times. Empty: the page's language (`lang`), then the browser's. */
@prop locale: string = '';
/** The scheduler's accessible name. Empty: «Scheduler». */
@prop label: string = '';
@prop disabled: boolean = false;
/** What an event draws; without it, its time and title. */
@slot event?: (event: SchedulerEvent);
/** An event was clicked, or Enter pressed on it. */
@event 'event-open': { event: SchedulerEvent };
/** An empty slot or day was clicked, or Enter pressed on it: its start and end (ISO, UTC), its resource, and whether it is a whole day. */
@event 'slot-open': { start: string; end: string; resource: string | null; allDay: boolean };
/** The period on screen changed, by the bar, the keyboard, or a day opened from the month or the year. */
@event 'period-change': { view: 'day' | 'week' | 'days' | 'month' | 'year' | 'agenda'; start: string; end: string };
@part root, toolbar, prev, todayButton, next, period, viewSwitcher, grid, columnHeader, allDayRow, slot, event, more, yearMonth, agendaList, nowLine;
@state disabled = !!disabled;
@host el;

let gridEl = $signal<HTMLElement | null>(null);
/**
 * The cell the grid's one tab stop is on: in the time grid row 0 is the all-day row, then a row per
 * slot; in the month, a row per week. Null: the reference date's cell, which a new period starts at.
 */
let active = $signal<{ row: number; col: number } | null>(null);
/** The day the year view's one tab stop is on; empty: the reference date. */
let yearDay = $signal('');
let now = $signal(Date.now());

const periodId = generatedId('pdx-scheduler-period');
const loc = $derived(resolveLocale(el, locale));
const zone = $derived(timeZone || Intl.DateTimeFormat().resolvedOptions().timeZone);
const refDate = $derived(date || today());
const weekStart = $derived(firstDay >= 0 ? firstDay : getFirstDayOfWeek(loc));
const rangeOptions = $derived({ firstDay: weekStart, days, agendaDays, hiddenDays: weekends ? [] : [0, 6] });
const range = $derived(viewRange(view, refDate, rangeOptions));
const periodText = $derived(periodLabel(view, range.days, loc, refDate));
const shownViews = $derived(views.filter((v) => VIEWS.includes(v)));
const isTimeGrid = $derived(view === 'day' || view === 'week' || view === 'days');
const columns = $derived(buildColumns(isTimeGrid ? range.days : [], resources, groupBy));
const startMinutes = $derived(parseClock(startHour));
const endMinutes = $derived(parseClock(endHour));
const slots = $derived(buildSlots(startMinutes, endMinutes, slotMinutes));
const timed = $derived(placeTimed(events, columns, { timeZone: zone, startMinutes, endMinutes, slotMinutes }));
const allDay = $derived(placeAllDay(events, columns, zone));
/** The timed events by cell, `column|slot`, so a cell reads its own in one lookup. */
const byCell = $derived(cellIndex(timed, columns));
const todayDate = $derived(zonedParts(now, zone).date);
const headerRows = $derived(buildHeaderRows(columns, range.days, resources, groupBy, {
  today: todayDate,
  dayLabel: (d) => { const h = dayHeader(d, loc); return { text: h.weekday + ' ' + h.day, full: h.full }; },
  corners: { time: uiString('scheduler', 'time'), resource: uiString('scheduler', 'resource') },
}));
const perWeek = $derived(weekends ? 7 : 5);
const monthWeeks = $derived(view === 'month' ? buildMonthWeeks(range.days, perWeek, events, zone, dayMaxEvents) : []);
const monthHeads = $derived(monthWeeks.length ? monthWeeks[0].days.map((d) => ({ key: d, ...weekdayName(d, loc) })) : []);
const yearMonths = $derived(view === 'year' ? buildYearMonths(range.start, weekStart, events, zone) : []);
const yearCursor = $derived(yearDay >= range.start && yearDay < range.end ? yearDay : refDate);
const agendaGroups = $derived(view === 'agenda' ? buildAgendaDays(range.days, events, zone) : []);
const gridSize = $derived(view === 'month' ? { rows: monthWeeks.length, cols: perWeek } : { rows: slots.length + 1, cols: columns.length });
/** The reference date's cell: its week and day in the month; in the time grid, its column at `scrollTo`, where the grid opens. */
const homeCell = $derived(view === 'month'
  ? { row: Math.max(0, monthWeeks.findIndex((w) => w.days.includes(refDate))), col: Math.max(0, monthWeeks.find((w) => w.days.includes(refDate))?.days.indexOf(refDate) ?? 0) }
  : { row: Math.max(0, slots.findIndex((m) => m >= parseClock(scrollTo))) + 1, col: Math.max(0, columns.findIndex((c) => c.date === refDate)) });
/** The tab stop, inside the grid on screen: a view with fewer rows or columns keeps one cell reachable. */
const tabCell = $derived({ row: Math.min((active ?? homeCell).row, gridSize.rows - 1), col: Math.min((active ?? homeCell).col, gridSize.cols - 1) });

function eventsAt(ci: number, ri: number): PlacedEvent[] { return byCell.get(ci + '|' + ri) ?? []; }
function barsAt(ci: number) { return allDay.bars.filter((b) => b.first === ci); }
function itemsAt(w: MonthWeek, di: number) { return w.items.filter((it) => it.first === di); }
function monthHeadsOf(m: YearMonth) { return m.weeks[0].map((d) => ({ key: d.date, ...weekdayName(d.date, loc) })); }
function viewName(v: CalendarView): string { return v === 'days' ? format(uiString('scheduler', 'daysView'), { count: days }) : uiString('scheduler', v); }
function offHours(c: Column, minutes: number): boolean { return !isBusinessTime(c.date, minutes, c.resource?.businessHours ?? businessHours); }
function timeOf(p: PlacedEvent): string {
  const start = startMinutes + (p.slot + p.offset) * slotMinutes;
  return spanLabel(Math.round(start), Math.round(start + p.length * slotMinutes), loc);
}
function resourceNames(e: SchedulerEvent): string { return eventResources(e, resources).map((r) => r.label).join(', '); }
function where(c: Column): string { return c.resource ? ', ' + c.resource.label : ''; }
function timedName(p: PlacedEvent, c: Column): string {
  return format(uiString('scheduler', 'eventName'), { title: p.event.title, when: timeOf(p) + ', ' + dayHeader(c.date, loc).full }) + where(c);
}
function allDayName(e: SchedulerEvent, c: Column): string {
  return format(uiString('scheduler', 'eventName'), { title: e.title, when: uiString('scheduler', 'allDay') + ', ' + dayHeader(c.date, loc).full }) + where(c);
}
/** A month's event: its time (or «All day») and its days in this week, then its resources. */
function dayEventName(e: SchedulerEvent, minutes: number | null, w: MonthWeek, first: number, span: number): string {
  const when = (minutes === null ? uiString('scheduler', 'allDay') : clockLabel(minutes, loc)) + ', ' + dayRange(w.days[first], w.days[first + span - 1], loc);
  const names = resourceNames(e);
  return format(uiString('scheduler', 'eventName'), { title: e.title, when }) + (names ? ', ' + names : '');
}
/** An event's colour: its own, else its column's resource's, else its first resource's. */
function colorStyle(e: SchedulerEvent, c?: Column): string {
  const color = e.color ?? c?.resource?.color ?? eventResources(e, resources)[0]?.color;
  return color ? ';--pdx-scheduler-event-color:' + color : '';
}
/** Where the current-time line is in this cell, 0 to 1, or null when it is not here. */
function nowAt(ci: number, ri: number): number | null {
  if (!nowIndicator) return null;
  const c = columns[ci];
  const here = zonedParts(now, zone);
  if (!c || c.date !== here.date) return null;
  const from = slots[ri];
  const to = Math.min(from + slotMinutes, endMinutes);
  return here.minutes >= from && here.minutes < to ? (here.minutes - from) / slotMinutes : null;
}

// ─── The period ────────────────────────────────────────────────────────────────

function moved(): void {
  active = null;
  const r = viewRange(view, refDate, rangeOptions);
  periodChange({ view, start: r.start, end: r.end });
  announce(periodLabel(view, r.days, loc, refDate));
}
function step(direction: 1 | -1): void { date = stepPeriod(view, refDate, direction, rangeOptions); moved(); }
function goToday(): void { date = today(); moved(); }
function pick(v: CalendarView): void { if (v !== view) { view = v; moved(); } }
/** A day opened from the month's «+N» or the year: the first time-grid view offered, on that day, focused. */
function openDay(d: string): void {
  const to = shownViews.find((v) => v === 'day') ?? shownViews.find((v) => v === 'week' || v === 'days') ?? 'day';
  date = d;
  view = to;
  moved();
  queueMicrotask(() => (gridEl?.querySelector('[role="gridcell"][tabindex="0"]') as HTMLElement | null)?.focus());
}

// ─── The grids: one tab stop, the arrows between cells ─────────────────────────

function cellOf(target: EventTarget | null): HTMLElement | null {
  return target instanceof Element ? target.closest('[role="gridcell"]') as HTMLElement | null : null;
}
function focusCell(row: number, col: number): void {
  active = { row, col };
  queueMicrotask(() => {
    const cell = gridEl?.querySelector(`[data-row="${row}"][data-col="${col}"]`) as HTMLElement | null;
    cell?.focus();
  });
}
/** The slot a cell is: start and end as instants in the zone, and its resource. A month's day is a whole day. */
function slotOf(row: number, col: number) {
  const whole = (d: string, resource: string | null) => ({
    start: new Date(zonedInstant(d, 0, zone)).toISOString(), end: new Date(zonedInstant(d, 1440, zone)).toISOString(), resource, allDay: true,
  });
  if (view === 'month') return whole(monthWeeks[row].days[col], null);
  const c = columns[col];
  if (row === 0) return whole(c.date, c.resource?.id ?? null);
  const from = slots[row - 1];
  const to = Math.min(from + slotMinutes, endMinutes);
  return { start: new Date(zonedInstant(c.date, from, zone)).toISOString(), end: new Date(zonedInstant(c.date, to, zone)).toISOString(), resource: c.resource?.id ?? null, allDay: false };
}
function eventById(id: string): SchedulerEvent | undefined { return events.find((e) => e.id === id); }

function onKey(e: KeyboardEvent): void {
  if (disabled) return;
  const cell = cellOf(e.target);
  if (!cell) return;
  const row = Number(cell.dataset.row);
  const col = Number(cell.dataset.col);
  if (e.target !== cell) {
    // Inside a cell: Escape gives the grid its keys back; Tab moves between the cell's events.
    if (e.key === 'Escape') { e.preventDefault(); focusCell(row, col); }
    return;
  }
  if (e.key === 'Enter' || e.key === 'F2') {
    e.preventDefault();
    const inner = cell.querySelectorAll<HTMLElement>(INNER);
    if (inner.length) {
      for (const button of inner) button.tabIndex = 0;
      inner[0].focus();
    } else slotOpen(slotOf(row, col));
    return;
  }
  const target = gridKeyTarget(e, { row, col }, gridSize);
  if (!target) return;
  e.preventDefault();
  if ('period' in target) { step(target.period); focusCell(Math.min(row, gridSize.rows - 1), Math.min(col, gridSize.cols - 1)); return; }
  focusCell(target.cell.row, target.cell.col);
}

function onClick(e: MouseEvent): void {
  if (disabled) return;
  const button = e.target instanceof Element ? e.target.closest(INNER) as HTMLElement | null : null;
  if (button?.dataset.part === 'more') { openDay(button.dataset.date ?? ''); return; }
  if (button) {
    const ev = eventById(button.dataset.id ?? '');
    if (ev) eventOpen({ event: ev });
    return;
  }
  const cell = cellOf(e.target);
  if (!cell) return;
  const row = Number(cell.dataset.row);
  const col = Number(cell.dataset.col);
  active = { row, col };
  slotOpen(slotOf(row, col));
}

// The events of a cell are tab stops while the focus is among them; once it leaves them — to their
// cell with Escape, or anywhere else — they go back to tabindex -1, and the grid keeps one tab stop.
function onFocusOut(e: FocusEvent): void {
  const t = e.target instanceof HTMLElement ? e.target : null;
  if (!t?.matches(INNER)) return;
  const next = e.relatedTarget instanceof HTMLElement ? e.relatedTarget : null;
  if (next?.matches(INNER) && next.parentElement === t.parentElement) return;
  for (const button of t.parentElement?.querySelectorAll<HTMLElement>(INNER) ?? []) button.tabIndex = -1;
}

// The year: one tab stop over its days, the arrows by day and week, Enter or a click opens the day.
function onYearKey(e: KeyboardEvent): void {
  if (disabled) return;
  const at = (e.target as HTMLElement).dataset?.date;
  if (!at) return;
  if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openDay(at); return; }
  const target = dayKeyTarget(e, at, { firstDay: weekStart, min: range.start, max: range.end });
  if (!target) return;
  e.preventDefault();
  if ('period' in target) {
    step(target.period);
    yearDay = refDate;
  } else yearDay = target.date;
  queueMicrotask(() => (gridEl?.querySelector(`[data-date="${yearCursor}"]`) as HTMLElement | null)?.focus());
}
function onYearClick(e: MouseEvent): void {
  if (disabled) return;
  const day = e.target instanceof Element ? e.target.closest('[data-date]') as HTMLElement | null : null;
  if (day?.dataset.date) openDay(day.dataset.date);
}

// ─── Mount: the clock; the time grid opens at `scrollTo` ───────────────────────

$watch(gridEl, (grid) => {
  if (!grid || !isTimeGrid) return;
  requestAnimationFrame(() => {
    const first = slots.findIndex((m) => m >= parseClock(scrollTo));
    const row = grid.querySelector(`[data-row="${first + 1}"]`) as HTMLElement | null;
    const head = grid.querySelector('[data-part="allDayRow"] [role="rowheader"]') as HTMLElement | null;
    // From the rectangles, not offsetTop: the all-day row is sticky, and a sticky element's offsetTop
    // moves with the scroll, so a grid already scrolled (by the focus of a day opened) went elsewhere.
    if (row && head && first > 0) grid.scrollTop += row.getBoundingClientRect().top - head.getBoundingClientRect().bottom;
  });
});
let clock: ReturnType<typeof setInterval> | undefined;
onMount(() => { clock = setInterval(() => { now = Date.now(); }, 60_000); });
onDestroy(() => { if (clock !== undefined) clearInterval(clock); });
</script>

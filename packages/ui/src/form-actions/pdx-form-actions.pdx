<template>
  <div class="pdx-form-actions" data-part="root">
    <!-- What the page writes inside the tag replaces the two buttons. -->
    <slot>
      @if (resetText()) {
        <button type="reset" class="pdx-ghost" data-part="reset" :disabled="isDisabled()">{{ resetText() }}</button>
      }
      <button type="submit" class="pdx-primary" data-part="submit" :disabled="isDisabled()">@if (isSubmitting() && showLoading) {<span class="pdx-spinner pdx-spinner-sm"></span> }{{ submitText() }}</button>
    </slot>
  </div>
</template>

<script>
/**
 * The submit and reset button bar of a form, wired to the form it sits in, with configurable
 * labels, alignment and a loading state.
 *
 * @cssstate submitting - The form it sits in is submitting; its buttons are disabled meanwhile.
 *
 * @csspart root - The bar.
 * @csspart reset - The reset button, unless `reset-label="none"`.
 * @csspart submit - The submit button.
 */
// To hide the reset button, set resetLabel="none".
import { tryUseForm } from '@pdxui/core';
// Its labels' English defaults are with the library's others, in shared/i18n.ts; a locale overrides
// them with setComponentStrings('form-actions', { submit: '…', reset: '…' }).
import { uiString } from '../shared/i18n';
// This component's styles live in form.css, written where the container is rather than where the
// component is. Imported explicitly so they travel anyway.
import '@pdxui/design/components/form';

@state submitting = isSubmitting();
@part root, reset, submit;
// The bar's alignment is an axis reflected on the host, which form.css draws (#293); each value maps
// the class a native bar carries.
@variants {
  /** Where the buttons sit: end (the default), start, center, or apart. */
  align: { end: '.pdx-form-actions-end', start: '.pdx-form-actions-start', center: '.pdx-form-actions-center', between: '.pdx-form-actions-between' } = end;
}
/** Submit button label. Uses i18n registry default if not set. */
@prop submitLabel: string = '';
/** Reset button label. Set to 'none' to hide. Uses i18n registry default if not set. */
@prop resetLabel: string = '';
/** Show loading spinner on submit button while submitting. */
@prop showLoading: boolean = true;

@host el;

// Looked up when read, and kept once found: set up before its <pdx-form>, a one-time lookup at setup
// would never find it. See tryUseForm(from).
let found;
function form() { return found ??= tryUseForm(el); }

function isSubmitting() { return form()?.submitting() ?? false; }
function isDisabled() { return form()?.submitting() ?? false; }

// i18n: the prop overrides the registry. An empty string uses the registry; 'none' hides the button.
// uiString reads the registry's computed, so a locale loaded later reaches the bound text.
function submitText() { return submitLabel || uiString('form-actions', 'submit'); }
function resetText() { return resetLabel === 'none' ? '' : resetLabel || uiString('form-actions', 'reset'); }
</script>

<template></template>

<script>
/**
 * A menu drawn in place from a list of items, with checkbox and radio items, submenus and keyboard
 * navigation, shown while it is open.
 *
 * @slot item - Renders one menu entry: a snippet `item(item)`.
 */
// pdx-menu — Popup menu with items, submenus, checkbox/radio, keyboard nav, typeahead.
// Data-driven: pass `items` array. Auto-generates ARIA, keyboard nav, submenu positioning.
// Used by pdx-dropdown-menu and pdx-context-menu as the rendering engine.
//
// Its DOM is built by the script, a frame after mount, as the TypeScript version built it.
import { focusGroup, onDestroy, onNextFrame } from '@pdxui/core';
import type { Dispose, SlotFunction } from '@pdxui/core';
import { sanitizeSVG } from '../shared/sanitize';
import { warnMisshapenMenuItem } from '../shared/menu-item-shape';
import type { MenuItem } from './menu-types';
// This component's styles travel with it, so an app ships the CSS of what it renders
// and no more.
import '@pdxui/design/components/menu';

// `open` is a model (#288): the menu closes itself — Escape, a chosen entry — and its own writes
// announce `open-change` `{ value }`, which `::open` follows. It replaced `pdx-close`.
@model open: boolean = false;
@event 'pdx-select': { key: string; item: MenuItem };
@event 'pdx-check': { key: string; checked: boolean; radioGroup?: string; item: MenuItem };
// On the host as a custom state (#132, #288).
@state open = open;
// The element that is role="menu", an entry, a separator and a group label, all built by the
// script (#1284). A submenu's panel is drawn on <body>; its entries are parts all the same.
// pdx-ignore PDX_PART_NAME_TAKEN: `item` is the theme's part on each entry; the script's `item` is the snippet
@part(external) root, item, separator, label;
// The item a snippet receives is the app's, from `items` (#651): the editor infers `T`.
@generic T extends { key?: string; label?: string; type?: string };
/** Menu items (data-driven) */
@prop items: T[] = [];
/** Minimum width */
@prop minWidth: number = 180;
/** The id of the element that is `role="menu"`, for a trigger's `aria-controls`. */
@prop menuId: string = '';
/**
 * Classes added to the element that is `role="menu"`: the dropdown's panel is that element,
 * and `.pdx-dropdown-menu-panel` is what apps and the certification select it by.
 */
@prop menuClass: string = '';
/**
 * Draws one entry, as the `item` slot does: `({ item, key, type }) => Node`. For a menu built
 * from script — `pdx-dropdown-menu` hands its own `item` slot on through it.
 */
@prop renderItem: ((...args: unknown[]) => unknown) | null = null;
// A parent's `@snippet` sets it, positional arguments; the alpha scoped slot is not read (#492).
// Any entry the menu renders through the snippet (#651): an element of `items`, or a child or
// grandchild of one in a submenu, less the separators, labels and submenu triggers it draws
// itself (`type: 'separator' as const` on the app's side). Written out, because the editor
// pastes the signature where no alias is in scope.
@slot item?: (item: Exclude<T | (T extends { children?: readonly (infer C)[] } ? C | (C extends { children?: readonly (infer D)[] } ? D : never) : never), { type: 'separator' | 'label' | 'submenu' }>);
@host el;

// The overlay verbs, each a write of the model, so each announces `open-change`. `closeAll()` is
// `close()` (#288).
@expose show, close, toggle, isOpen, closeSubmenu;

let menuEl: HTMLElement | null = null;
let focusDispose: Dispose | null = null;
let subMenuCloseTimer: ReturnType<typeof setTimeout> | null = null;
let activeSubmenuKey = '';
/**
 * The open submenu's panel, on <body>. Held, not looked up by its key in the page: another menu's
 * submenu can carry the same key.
 */
let activeSubPanel: HTMLElement | null = null;
/** The items the menu on screen was drawn from: the same array again is no reason to rebuild. */
let builtFrom: MenuItem[] | null = null;
let scrollHandler: (() => void) | null = null;
let bound = false;
// Cleared on destroy: a frame after it touches nothing.
let alive = true;
/** Read-only, via a ref: `el.isOpen`. */
const isOpen = $derived(open as boolean);

// Read where it draws: a snippet set after mount is the one drawn. `renderItem` takes the scope.
function getItemSlot(): SlotFunction | undefined {
  const snippet = item;
  if (typeof snippet === 'function') return (scope) => snippet(scope.item as never) ?? document.createDocumentFragment();
  return (renderItem as SlotFunction | null) ?? undefined;
}

// ─── Build menu DOM ──────────────────────────────────
function buildMenu(list: MenuItem[], isSubmenu = false): HTMLElement {
  const menu = document.createElement('div');
  menu.className = 'pdx-menu' + (isSubmenu ? ' pdx-menu-sub-panel' : '');
  menu.setAttribute('role', 'menu');
  if (!isSubmenu) menu.setAttribute('data-part', 'root');
  const id = menuId.peek() as string;
  const extra = menuClass.peek() as string;
  if (!isSubmenu) {
    if (id) menu.id = id;
    if (extra) menu.classList.add(...extra.split(/\s+/).filter(Boolean));
  }
  menu.style.minWidth = (minWidth.peek() as number) + 'px';

  for (const entry of list) {
    warnMisshapenMenuItem('pdx-menu', entry);
    if (entry.type === 'separator') {
      const sep = document.createElement('hr');
      sep.className = 'pdx-menu-separator';
      sep.setAttribute('role', 'separator');
      sep.setAttribute('data-part', 'separator');
      menu.appendChild(sep);
      continue;
    }

    if (entry.type === 'label') {
      const lbl = document.createElement('div');
      lbl.className = 'pdx-menu-label';
      lbl.setAttribute('role', 'presentation');
      lbl.setAttribute('data-part', 'label');
      lbl.textContent = entry.label;
      menu.appendChild(lbl);
      continue;
    }

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'pdx-menu-item';
    btn.setAttribute('data-part', 'item');
    if (entry.danger) btn.classList.add('pdx-menu-danger');
    if (entry.className) btn.classList.add(entry.className);
    if (entry.type === 'submenu') btn.classList.add('pdx-menu-sub');
    btn.setAttribute('data-menu-key', entry.key);
    btn.disabled = !!entry.disabled;
    if (entry.lang) btn.lang = entry.lang;

    // ARIA role based on type
    if (entry.type === 'checkbox') {
      btn.setAttribute('role', 'menuitemcheckbox');
      btn.setAttribute('aria-checked', String(!!entry.checked));
    } else if (entry.type === 'radio') {
      btn.setAttribute('role', 'menuitemradio');
      btn.setAttribute('aria-checked', String(!!entry.checked));
      if (entry.radioGroup) btn.setAttribute('data-radio-group', entry.radioGroup);
    } else {
      btn.setAttribute('role', 'menuitem');
    }

    if (entry.type === 'submenu' && entry.children?.length) {
      btn.setAttribute('aria-haspopup', 'menu');
      btn.setAttribute('aria-expanded', 'false');
    }

    // Check indicator for checkbox/radio. EMPTY: menu.css draws the tick from
    // `aria-checked`, and a ✓ written here as well would be a second one — «✓✓».
    if (entry.type === 'checkbox' || entry.type === 'radio') {
      const check = document.createElement('span');
      check.className = 'pdx-menu-check';
      btn.appendChild(check);
    }

    // Content: slot > default (icon + label + shortcut)
    const itemSlot = getItemSlot();
    if (itemSlot && entry.type !== 'submenu') {
      btn.appendChild(itemSlot({ item: entry, key: entry.key, type: entry.type || 'item' }));
    } else {
      if (entry.icon) {
        // Raw SVG, or an icon NAME (`icon: 'copy'`). `pdx-icon` is loaded
        // the first time a name is met: a menu of SVG icons never pays for it.
        if (entry.icon.startsWith('<')) {
          const icon = document.createElement('span');
          icon.className = 'pdx-menu-icon';
          icon.innerHTML = sanitizeSVG(entry.icon);
          btn.appendChild(icon);
        } else {
          if (!customElements.get('pdx-icon')) void import('../icon/pdx-icon');
          const icon = document.createElement('pdx-icon');
          icon.className = 'pdx-menu-icon';
          icon.setAttribute('name', entry.icon);
          icon.setAttribute('size', '16');
          btn.appendChild(icon);
        }
      }

      const labelSpan = document.createElement('span');
      labelSpan.className = 'pdx-menu-item-label';
      labelSpan.textContent = entry.label;
      btn.appendChild(labelSpan);

      if (entry.shortcut) {
        const sc = document.createElement('span');
        sc.className = 'pdx-menu-shortcut';
        sc.textContent = entry.shortcut;
        btn.appendChild(sc);
      }
    }

    // Click handler. The item is read by KEY at the click: an array patched in place
    // leaves this button standing under a newer object than the one it was
    // drawn from, and the event must carry that one.
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const now = currentItem(entry);
      if (now.disabled) return;

      if (now.type === 'checkbox') {
        handleCheckbox(now, btn);
      } else if (now.type === 'radio') {
        handleRadio(now, btn, menu);
      } else if (now.type === 'submenu') {
        // A click, and Enter or Space through `focusGroup`'s onSelect, open it with the
        // focus on its first item (APG), not only hover and ArrowRight.
        if (now.children?.length) openSubmenuAndFocus(btn, now);
      } else {
        pdxSelect({ key: now.key, item: now });
        close();
      }
    });

    // Submenu hover behavior
    if (entry.type === 'submenu' && entry.children?.length) {
      btn.addEventListener('mouseenter', () => openSubmenu(btn, currentItem(entry)));
      btn.addEventListener('mouseleave', () => scheduleSubmenuClose(entry.key));
    }

    menu.appendChild(btn);
  }

  return menu;
}

// ─── Checkbox toggle ─────────────────────────────────
function handleCheckbox(entry: MenuItem, btn: HTMLElement): void {
  entry.checked = !entry.checked;
  // The tick follows `aria-checked` in menu.css.
  btn.setAttribute('aria-checked', String(entry.checked));
  pdxCheck({ key: entry.key, checked: entry.checked, item: entry });
}

// ─── Radio toggle ────────────────────────────────────
function handleRadio(entry: MenuItem, btn: HTMLElement, menu: HTMLElement): void {
  // Uncheck siblings in same radio group
  if (entry.radioGroup) {
    menu.querySelectorAll(`[data-radio-group="${entry.radioGroup}"]`).forEach(node => {
      node.setAttribute('aria-checked', 'false');
    });
  }
  entry.checked = true;
  // The tick follows `aria-checked` in menu.css.
  btn.setAttribute('aria-checked', 'true');
  pdxCheck({ key: entry.key, checked: true, radioGroup: entry.radioGroup, item: entry });
}

// ─── Submenu management ──────────────────────────────
function openSubmenu(triggerBtn: HTMLElement, entry: MenuItem): void {
  if (subMenuCloseTimer) { clearTimeout(subMenuCloseTimer); subMenuCloseTimer = null; }

  // Close any other open submenu
  if (activeSubmenuKey && activeSubmenuKey !== entry.key) {
    closeSubmenu();
  }

  if (activeSubmenuKey === entry.key) return;
  activeSubmenuKey = entry.key;

  triggerBtn.setAttribute('aria-expanded', 'true');
  triggerBtn.classList.add('active');

  const subPanel = buildMenu(entry.children!, true);
  subPanel.setAttribute('data-submenu-key', entry.key);
  activeSubPanel = subPanel;

  // Position submenu to the right of trigger. Fixed and hidden BEFORE it is measured: in the
  // flow at the end of <body> it is a block as wide as the body, so the flip below would
  // always fire and open the submenu off the left edge of the screen.
  subPanel.style.position = 'fixed';
  subPanel.style.visibility = 'hidden';
  document.body.appendChild(subPanel);
  const btnRect = triggerBtn.getBoundingClientRect();
  const subRect = subPanel.getBoundingClientRect();
  let left = btnRect.right + 2;
  let top = btnRect.top;

  // Flip if overflows viewport right
  if (left + subRect.width > window.innerWidth - 8) {
    left = btnRect.left - subRect.width - 2;
  }
  // Clamp vertical
  if (top + subRect.height > window.innerHeight - 8) {
    top = window.innerHeight - subRect.height - 8;
  }
  if (top < 8) top = 8;

  subPanel.style.left = left + 'px';
  subPanel.style.top = top + 'px';
  subPanel.style.visibility = '';
  subPanel.style.zIndex = '1010';
  subPanel.style.background = 'var(--pdx-color-surface)';
  subPanel.style.border = '1px solid var(--pdx-color-border)';
  subPanel.style.borderRadius = 'var(--pdx-radius-md)';
  subPanel.style.boxShadow = 'var(--pdx-shadow-lg)';

  // Reposition submenu on scroll/resize
  if (scrollHandler) { window.removeEventListener('scroll', scrollHandler, true); window.removeEventListener('resize', scrollHandler); }
  scrollHandler = () => {
    const sub = activeSubPanel;
    if (!sub) return;
    const bRect = triggerBtn.getBoundingClientRect();
    const sRect = sub.getBoundingClientRect();
    let l = bRect.right + 2;
    let t = bRect.top;
    if (l + sRect.width > window.innerWidth - 8) l = bRect.left - sRect.width - 2;
    if (t + sRect.height > window.innerHeight - 8) t = window.innerHeight - sRect.height - 8;
    if (t < 8) t = 8;
    sub.style.left = l + 'px';
    sub.style.top = t + 'px';
  };
  window.addEventListener('scroll', scrollHandler, { capture: true, passive: true });
  window.addEventListener('resize', scrollHandler, { passive: true });

  // Keep submenu open when hovering it
  subPanel.addEventListener('mouseenter', () => {
    if (subMenuCloseTimer) { clearTimeout(subMenuCloseTimer); subMenuCloseTimer = null; }
  });
  subPanel.addEventListener('mouseleave', () => scheduleSubmenuClose(entry.key));
  // ArrowLeft and Escape close the submenu and return to its item (APG). The submenu lives
  // on <body>, outside the host whose keydown handler knows them, so it handles them here.
  // The item is looked up by KEY in the menu as it is now, not the button captured here:
  // a menu whose items were set again while the submenu was open has drawn new buttons,
  // and focusing the old, detached one sends the focus nowhere.
  subPanel.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'Escape') return;
    e.preventDefault();
    e.stopPropagation();
    closeSubmenu();
    const current = menuEl?.querySelector(`[data-menu-key="${entry.key}"]`) as HTMLElement | null;
    (current ?? triggerBtn).focus();
  });

  // Focus group for submenu keyboard nav
  focusGroup(subPanel, {
    selector: '.pdx-menu-item:not([disabled])',
    orientation: 'vertical',
    wrap: true,
    typeAhead: true,
    onSelect: (node) => node.click(),
  });
}

/**
 * An opening's focus, on the first enabled entry — unless the reader moved into the menu, or
 * one of its submenus (on <body>), WHILE it opened: pulled back to the first entry, the
 * ArrowRight they pressed on a submenu's entry would land on another one. `before` is
 * the focus when the opening began; a focus left inside from an earlier opening is not a move.
 */
function focusFirstUnlessMoved(menu: HTMLElement, before: Element | null): void {
  const active = document.activeElement;
  const moved = active !== before && !!active && (menu.contains(active) || !!active.closest?.('[data-submenu-key]'));
  if (moved) return;
  (menu.querySelector('.pdx-menu-item:not([disabled])') as HTMLElement | null)?.focus();
}

/**
 * Open a submenu and move the focus to its first enabled item — what ArrowRight, Enter and
 * Space do. Unless the reader moved into it before the frame: the first item would take the
 * focus back, and their Enter would pick it.
 */
function openSubmenuAndFocus(triggerBtn: HTMLElement, entry: MenuItem): void {
  const before = document.activeElement;
  openSubmenu(triggerBtn, entry);
  requestAnimationFrame(() => {
    const sub = activeSubmenuKey === entry.key ? activeSubPanel : null;
    if (sub) focusFirstUnlessMoved(sub, before);
  });
}

function scheduleSubmenuClose(key: string): void {
  subMenuCloseTimer = setTimeout(() => {
    if (activeSubmenuKey === key) closeSubmenu();
  }, 150);
}

/** Close only the open submenu, leaving the menu itself open. */
function closeSubmenu(): void {
  if (!activeSubmenuKey) return;
  const sub = activeSubPanel;
  activeSubPanel = null;
  // The focus inside the panel about to go goes back to its item. A close the POINTER
  // caused — leaving the submenu — moves no focus otherwise, and it falls to <body>, where the
  // menu's keys, Escape included, reach nobody. A focus elsewhere is left where it is.
  const hadFocus = !!sub?.contains(document.activeElement);
  if (sub) sub.remove();
  if (hadFocus) (menuEl?.querySelector(`[data-menu-key="${activeSubmenuKey}"]`) as HTMLElement | null)?.focus();
  if (scrollHandler) { window.removeEventListener('scroll', scrollHandler, true); window.removeEventListener('resize', scrollHandler); scrollHandler = null; }
  // Reset trigger button state
  if (menuEl) {
    const trigger = menuEl.querySelector(`[data-menu-key="${activeSubmenuKey}"]`);
    if (trigger) {
      trigger.setAttribute('aria-expanded', 'false');
      trigger.classList.remove('active');
    }
  }
  activeSubmenuKey = '';
}

/** Close the submenu and the menu. */
function close(): void {
  // A write of the model, so it announces `open-change`; the owner that placed the menu
  // (pdx-dropdown-menu) hears that and takes it away.
  closeSubmenu();
  open = false;
}

// Opens it.
function show(): void { open = true; }

// Toggles it open/closed.
function toggle(): void { if (open.peek()) close(); else open = true; }

// ─── Arrow Right/Left for submenu keyboard nav ──────
function onKeydown(e: KeyboardEvent): void {
  if (!menuEl) return;

  if (e.key === 'ArrowRight') {
    const focused = menuEl.querySelector('.pdx-menu-item:focus') as HTMLElement;
    if (focused?.classList.contains('pdx-menu-sub')) {
      e.preventDefault();
      const key = focused.getAttribute('data-menu-key') || '';
      const found = findItem(items.peek() as unknown as MenuItem[], key);
      if (found?.children?.length) openSubmenuAndFocus(focused, found);
    }
  }

  if (e.key === 'ArrowLeft') {
    if (activeSubmenuKey) {
      e.preventDefault();
      const key = activeSubmenuKey;
      closeSubmenu();
      // Refocus the parent trigger
      const trigger = menuEl.querySelector(`[data-menu-key="${key}"]`) as HTMLElement;
      if (trigger) trigger.focus();
    }
  }

  if (e.key === 'Escape') {
    if (activeSubmenuKey) {
      e.preventDefault();
      e.stopPropagation();
      const key = activeSubmenuKey;
      closeSubmenu();
      const trigger = menuEl.querySelector(`[data-menu-key="${key}"]`) as HTMLElement;
      if (trigger) trigger.focus();
    } else {
      close();
    }
  }
}

/** The object the menu holds for this item NOW: the newest array's, after a patch in place. */
function currentItem(entry: MenuItem): MenuItem {
  return (builtFrom && findItem(builtFrom, entry.key)) || entry;
}

// ─── Update in place ─────────────────────
/**
 * Two arrays draw the same elements when only `checked`, `disabled` or a label differ: same
 * keys in the same order, same types, groups, icons, shortcuts, classes and languages, and
 * children of the same shape. A label drawn by the `item` slot is the slot's to draw, so with
 * a slot a changed label is a change of shape.
 */
function sameShape(a: MenuItem[], b: MenuItem[], slotted: boolean): boolean {
  if (a.length !== b.length) return false;
  for (let i = 0; i < a.length; i++) {
    const x = a[i], y = b[i];
    if (x.key !== y.key || (x.type ?? 'item') !== (y.type ?? 'item') || x.radioGroup !== y.radioGroup
      || x.icon !== y.icon || x.shortcut !== y.shortcut || !!x.danger !== !!y.danger
      || x.className !== y.className || x.lang !== y.lang) return false;
    if (slotted && x.label !== y.label) return false;
    if (!sameShape(x.children ?? [], y.children ?? [], slotted)) return false;
  }
  return true;
}

/** Write what may change into the elements `buildMenu` drew, one element per item, in order. */
function patchMenu(menu: HTMLElement, list: MenuItem[]): void {
  const nodes = menu.children;
  list.forEach((entry, i) => {
    const node = nodes[i] as HTMLElement | undefined;
    if (!node || entry.type === 'separator') return;
    if (entry.type === 'label') { node.textContent = entry.label; return; }
    (node as HTMLButtonElement).disabled = !!entry.disabled;
    if (entry.type === 'checkbox' || entry.type === 'radio') node.setAttribute('aria-checked', String(!!entry.checked));
    const text = node.querySelector(':scope > .pdx-menu-item-label');
    if (text) text.textContent = entry.label;
  });
}

function findItem(list: MenuItem[], key: string): MenuItem | null {
  for (const entry of list) {
    if (entry.key === key) return entry;
    if (entry.children) {
      const found = findItem(entry.children, key);
      if (found) return found;
    }
  }
  return null;
}

function bindFocusGroup(menu: HTMLElement): void {
  focusDispose = focusGroup(menu, {
    selector: '.pdx-menu-item:not([disabled])',
    orientation: 'vertical',
    wrap: true,
    typeAhead: true,
    onSelect: (node) => node.click(),
  });
}

// ─── Mount ───────────────────────────────────────────
// A frame after mount: a setup a move destroyed does not build again.
onNextFrame(() => {
  bound = true;
  const list = items.peek() as unknown as MenuItem[];
  const isOpenNow = open.peek() as boolean;
  if (!list.length) return;

  const menu = buildMenu(list);
  builtFrom = list;
  menuEl = menu;
  el.appendChild(menu);

  // Keyboard handlers
  el.addEventListener('keydown', onKeydown);

  // Focus group for main menu
  bindFocusGroup(menu);

  // Initial visibility
  el.style.display = isOpenNow ? '' : 'none';

  // Focus first item when opened
  if (isOpenNow) {
    const before = document.activeElement;
    requestAnimationFrame(() => focusFirstUnlessMoved(menu, before));
  }
});

// React to open changes, the parent's or the menu's own. Opening records where the focus was; a
// close while the focus is in the menu gives it back there — the button that opened it, an
// invoker with `command="--show"` (#288) — rather than to <body> once the menu hides.
let returnFocus: HTMLElement | null = null;
$effect(() => {
  const isOpenNow = open as boolean;
  if (!bound) return;

  const before = document.activeElement;
  if (isOpenNow) {
    returnFocus = before instanceof HTMLElement && before !== document.body ? before : null;
  } else {
    const inside = !!before && (el.contains(before) || !!before.closest?.('[data-submenu-key]'));
    if (inside && returnFocus?.isConnected) returnFocus.focus();
    returnFocus = null;
  }
  requestAnimationFrame(() => {
    if (!alive) return;
    el.style.display = isOpenNow ? '' : 'none';
    if (isOpenNow) {
      if (menuEl) focusFirstUnlessMoved(menuEl, before);
    } else {
      closeSubmenu();
    }
  });
});

// React to items changes (rebuild menu)
$effect(() => {
  const list = items as unknown as MenuItem[];
  if (!bound || !list.length) return;

  requestAnimationFrame(() => {
    if (!alive) return;
    // The menu on screen was drawn from these very items: nothing to rebuild. On mount both
    // the build and this effect run in the same turn, and this one would build the menu a SECOND
    // time from the same array — under load, after a reader has already moved the focus into it.
    if (list === builtFrom) return;
    const oldMenu = menuEl;
    // Same keys, same shape: the elements under the pointer stay, and so does the focus.
    // A radio that moved is not a reason to draw the menu again.
    if (oldMenu && builtFrom && sameShape(builtFrom, list, !!getItemSlot())) {
      patchMenu(oldMenu, list);
      if (activeSubmenuKey) {
        const sub = activeSubPanel;
        const parent = findItem(list, activeSubmenuKey);
        if (sub && parent?.children) patchMenu(sub, parent.children);
      }
      builtFrom = list;
      return;
    }
    // The item holding the focus goes with the old menu: its key comes back in the new one.
    // A rebuild under an open menu would drop the focus to <body>, where Escape reaches
    // nobody — the same lookup by key the submenu's return makes.
    const focusedKey = oldMenu?.contains(document.activeElement)
      ? (document.activeElement as HTMLElement).getAttribute('data-menu-key')
      : null;
    if (oldMenu) oldMenu.remove();
    if (focusDispose) { focusDispose(); focusDispose = null; }

    const menu = buildMenu(list);
    // The first build waits for items when they come after mount: its listener goes with it.
    if (!menuEl) el.addEventListener('keydown', onKeydown);
    builtFrom = list;
    menuEl = menu;
    el.appendChild(menu);
    if (focusedKey) (menu.querySelector(`[data-menu-key="${focusedKey}"]`) as HTMLElement | null)?.focus();

    bindFocusGroup(menu);
  });
});

// Teardown on destroy only: an effect's cleanup runs the first time what it read changes.
onDestroy(() => {
  alive = false;
  el.removeEventListener('keydown', onKeydown);
  if (focusDispose) { focusDispose(); focusDispose = null; }
  closeSubmenu();
});
</script>

<template>
  <div class="pdx-input-wrap" data-part="root" @click="onWrapClick">
    <input class="pdx-input" data-part="input" :ref="inputEl"
      :type="visible ? 'text' : 'password'"
      ::value="value"
      :placeholder="placeholder"
      :disabled="disabled"
      :readonly="readonly"
      :required="required"
      :name="name"
      :aria-label="ariaLabel || null"
      :aria-invalid="error ? 'true' : null"
      :aria-describedby="describedBy()"
      :aria-busy="loading ? 'true' : null"
      autocomplete="current-password"
      @input="onInput"
      @focus="onFocus"
      @blur="onBlur" />
    <button class="pdx-input-suffix-interactive pdx-password-toggle" data-part="toggle" type="button"
      :aria-label="uiString('password-input', visible ? 'hide' : 'show')"
      :disabled="disabled"
      @click="toggleVisibility">{{ visible ? '○' : '◉' }}</button>
  </div>
  @if (showStrength && strength() > 0) {
    <div class="pdx-password-strength" data-part="strength" aria-hidden="true">
      <div class="pdx-password-strength-track">
        <div class="pdx-password-strength-fill" :style="'width:' + (strength() * 25) + '%;background:' + strengthColor()"></div>
      </div>
      <span class="pdx-password-strength-label" :style="'color:' + strengthColor()">{{ strengthLabel() }}</span>
    </div>
  }
  @if (showStrength) {
    <span class="pdx-sr-only" :id="strengthId" aria-live="polite">{{ strengthLabel() }}</span>
  }
</template>

<script>
/**
 * A password field the user can reveal or hide, with an optional strength meter below it.
 *
 * @csspart root - The frame: border, background and the states' colours.
 * @csspart input - The native `<input>`, the textbox a form submits.
 * @csspart toggle - The button that reveals or hides the password.
 * @csspart strength - The strength meter under the frame, with `show-strength` and something typed.
 *
 * @cssstate invalid - `error` is set.
 * @cssstate disabled - `disabled` is set.
 * @cssstate loading - `loading` is set.
 *
 * @alphaevent pdx-input
 * @alphaevent pdx-change
 * @alphadetail value $event.currentTarget.value
 * @alphacommit pdx-change
 */
// pdx-password-input — Input with toggle visibility and optional strength meter.
// Uses pdx-input wrapper pattern. Toggle button in suffix position.
import { generatedId, onNextFrame, untracked } from '@pdxui/core';
import { uiString } from '../shared/i18n';
import { dispatchCommit } from '../shared/commit-change';

// Typing writes it (#479), and the write dispatches `value-change`, live. The commit, on blur or
// Enter, is the inner input's native `change`, which bubbles to the host. The inner
// <input type="password"> submits: `name` and form ownership are what password managers read. The host
// submits nothing of its own, or it would send the value a second time (#135): its form value is null;
// the model is still the form's, for a reset.
@model value: string = '' { form: () => null };
/** The textbox received focus. */
@event 'pdx-focus': void;
/** The textbox lost focus. */
@event 'pdx-blur': void;
// The visual states, on the host as custom states (#132), as pdx-input's.
@state invalid = !!error;
@state disabled = !!disabled;
@state loading = !!loading;
// pdx-ignore PDX_PART_NAME_TAKEN: `strength` is the theme's part on the meter; the script's `strength` is its score
@part root, input, toggle, strength;
// The axis inputs.css keys by (#627), reflected on the host; each value maps the class that draws
// the same size on a native field. `md` is the base look, which no class adds to.
@variants {
  /** xs, sm, md (the default), lg or xl — the same scale as pdx-input. */
  size: { md: '.pdx-input-md', xs: '.pdx-input-xs', sm: '.pdx-input-sm', lg: '.pdx-input-lg', xl: '.pdx-input-xl' } = md;
}
@prop placeholder: string = '';
@prop disabled: boolean = false;
@prop readonly: boolean = false;
@prop required: boolean = false;
@prop error: boolean = false;
@prop name: string = '';
@prop ariaLabel: string = '';
/** Show strength meter below input */
@prop showStrength: boolean = false;
/** Show loading state */
@prop loading: boolean = false;

// Imperative API: focus/blur/clear
@expose focus, blur, clear, selectText;

let inputEl = $signal(null);
let visible = $signal(false);
let liveValue = $signal('');

// A native reset puts a field back to its default value, which a property binding never sets: the
// default is the value the component mounted with, so the field's own reset and the host's model agree.
const mounted = value;
onNextFrame(() => {
  if (inputEl) inputEl.defaultValue = mounted === null || mounted === undefined ? '' : String(mounted);
});

function toggleVisibility() {
  if (disabled) return;
  visible = !untracked(() => visible);
}

// The model is the field's, two-way (`::value`); the meter follows what is typed, empty included.
function onInput(e: Event) {
  liveValue = (e.target as HTMLInputElement).value;
}

function onFocus() { pdxFocus(); }
function onBlur() { pdxBlur(); }

function onWrapClick(e: Event) {
  const t = e.target as HTMLElement;
  if (t.tagName === 'INPUT' || t.tagName === 'BUTTON') return;
  inputEl?.focus();
}

// Strength: 0=none (empty), 1=weak, 2=fair, 3=good, 4=strong. Anything typed is at least weak:
// "abc" does not score 0 and show no label at all. Plain functions, read where they are bound, as the
// TypeScript version read them: a $derived each would be a computed made at every mount.
function strength(): number {
  const v = liveValue as string;
  if (!v) return 0;
  let score = 0;
  if (v.length >= 8) score++;
  if (v.length >= 12) score++;
  if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
  if (/\d/.test(v)) score++;
  if (/[^A-Za-z0-9]/.test(v)) score++;
  return Math.max(1, Math.min(4, score));
}

function strengthLabel(): string {
  const s = strength();
  if (s === 0) return '';
  if (s === 1) return uiString('password-input', 'weak');
  if (s === 2) return uiString('password-input', 'fair');
  if (s === 3) return uiString('password-input', 'good');
  return uiString('password-input', 'strong');
}

// The meter's text describes the input, and is announced politely as it changes, not
// visual only.
const strengthId = generatedId('pdx-pw-strength');
function describedBy(): string | null {
  return showStrength && strength() > 0 ? strengthId : null;
}

function strengthColor(): string {
  const s = strength();
  if (s <= 1) return 'var(--pdx-color-danger)';
  if (s === 2) return 'var(--pdx-color-warning)';
  if (s === 3) return 'var(--pdx-color-info, var(--pdx-color-primary))';
  return 'var(--pdx-color-success)';
}

$effect(() => {
  const propVal = value as string;
  if (propVal) liveValue = propVal;
});

function focus() { inputEl?.focus(); }
function blur() { inputEl?.blur(); }
// A commit no typing produced: the model's write, then the native change a commit makes.
function clear() {
  liveValue = '';
  const inp = inputEl as HTMLInputElement | null;
  if (inp) inp.value = '';
  value = '';
  dispatchCommit(inp);
}
/** Select the whole text, so the next keystroke replaces it. Does not focus first. */
function selectText() { inputEl?.select(); }
</script>

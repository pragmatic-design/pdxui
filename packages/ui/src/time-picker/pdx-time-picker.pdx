<template></template>

<script>
/**
 * A segmented time input: the user sets the hour, minute, optional seconds and AM/PM with the
 * keyboard, the mouse wheel or typed digits, and the value is always `HH:mm` on the 24-hour clock.
 *
 * @csspart root - The frame, a `role="group"` that holds the segments.
 * @csspart segment - A segment, a `role="spinbutton"`: the hour, the minute, the second or AM/PM.
 * @csspart arrow - An arrow above or below a segment, which steps it.
 * @csspart separator - The `:` between two segments.
 *
 * @cssstate disabled - `disabled` is set.
 *
 * @alphaevent pdx-change
 * @alphaevent pdx-input
 * @alphadetail value $event.detail.value
 */
// pdx-time-picker — Segmented time input (hour:minute:second AM/PM).
// Each segment has visible up/down arrow buttons + keyboard + mouse wheel.
// 12h/24h auto-detected from locale via Intl.DateTimeFormat.
//
// Its segments are built by the script a frame after mount, as the TypeScript version built them,
// and only their text changes after (never destroy focused elements). The script's own names are not
// the parts' names (a segment is `which`): a part's name read in the script makes it a signal of the
// part's elements at every mount.
import { getComponentString, is12HourClock, onDestroy, onNextFrame } from '@pdxui/core';
import { resolveLocale } from '../shared/locale';
import './time-picker-strings';
// This component's styles travel with it, so an app ships the CSS of what it renders
// and no more.
import '@pdxui/design/components/time-picker';

// `HH:mm[:ss]` on the 24-hour clock, or '' for no time (#481). Each step of an arrow, the wheel, a
// typed digit and the AM/PM toggle writes it, and the write dispatches `value-change`.
// A form submits it as it is, and resets it (#135).
@model value: string = '' { form: () => value };
/** Fired when a segment loses the focus. */
@event 'pdx-blur': void;
// The visual state, on the host as a custom state (#132, #287): the design CSS draws the frame from
// it. The frame carries no state class. It has no popup, so no `open`.
@state disabled = !!disabled;
// Every element is built by the script.
@part(external) root, segment, arrow, separator;
// The axis its stylesheet keys by (#628), reflected on the host; each value maps the class that
// draws the same size on native markup. `md` is the base look, which no class adds to.
@variants {
  /** sm, md (the default) or lg: the fields' size. */
  size: { md: '.pdx-time-picker-md', sm: '.pdx-time-picker-sm', lg: '.pdx-time-picker-lg' } = md;
}
@prop format: string = 'auto';
@prop showSeconds: boolean = false;
@prop step: number = 1;
@prop min: string = '';
@prop max: string = '';
@prop disabled: boolean = false;
@prop name: string = '';
/** Locale for the 12h/24h default. Empty: the page's language (`lang`), then the browser's. */
@prop locale: string = '';
@prop ariaLabel: string = '';
// The host is the one submitter (#135), in FormData under its `name` (#133).
@host host { :name="name || null" }

// Imperative API: focus/blur/clear (clear empties the picker: "--", value '')
@expose focus, blur, clear;

let hourNow = $signal(0);
let minuteNow = $signal(0);
let secondNow = $signal(0);
let periodNow = $signal<'AM' | 'PM'>('AM');
// Empty is a state, as in the native <input type="time">: `value` '' shows "--", with no
// aria-valuenow. 00:00 would say midnight, not «no time».
// The value effect writes it from a parent's value, and the arrows, digits and clear() write it
// too: it does not follow from what the effect reads.
let emptyNow = $signal(!(value as string));
// The value this component last wrote to the host, so the value effect can tell its own
// reflection from a parent's change.
let _reflected: string | null = null;
// The digits typed into the focused segment so far. Read only by the handlers: a plain variable.
let _digitBuffer = '';
let _digitTimer: ReturnType<typeof setTimeout> | null = null;

function is12h(): boolean {
  const fmt = format as string;
  if (fmt === '12h') return true;
  if (fmt === '24h') return false;
  return is12HourClock(resolveLocale(host, locale as string));
}

function parseTime(val: string): void {
  if (!val) return;
  emptyNow = false;
  const pieces = val.split(':').map(Number);
  let h = pieces[0] || 0;
  minuteNow = pieces[1] || 0;
  secondNow = pieces[2] || 0;
  if (is12h()) {
    if (h >= 12) { periodNow = 'PM'; h = h === 12 ? 12 : h - 12; }
    else { periodNow = 'AM'; if (h === 0) h = 12; }
  }
  hourNow = h;
}

setTimeout(() => parseTime(value.peek() as string), 0);
// An external reset to '' included
$effect(() => {
  const val = value as string;
  if (val === _reflected) return; // our own reflection: the segments already show it
  if (val) parseTime(val);
  else { hourNow = 0; minuteNow = 0; secondNow = 0; emptyNow = true; }
});
// The digit timer does not outlive the component.
onDestroy(() => { if (_digitTimer) { clearTimeout(_digitTimer); _digitTimer = null; } });

function formatOutput(): string {
  let h = hourNow.peek();
  const m = minuteNow.peek();
  const s = secondNow.peek();
  if (is12h()) {
    const period = periodNow.peek();
    if (period === 'AM' && h === 12) h = 0;
    else if (period === 'PM' && h !== 12) h += 12;
  }
  const hh = String(h).padStart(2, '0');
  const mm = String(m).padStart(2, '0');
  if (showSeconds) return `${hh}:${mm}:${String(s).padStart(2, '0')}`;
  return `${hh}:${mm}`;
}

// ─── min / max ─────────────────────────────────────
// The bound is enforced here, at
// the one point where a new value leaves the component, so arrows, wheel, typed digits and
// the AM/PM toggle are all covered once instead of four times.

/** A `HH:mm[:ss]` bound as seconds since midnight, or null when absent or unreadable. */
function bound(raw: string): number | null {
  if (!raw) return null;
  const pieces = raw.split(':').map(Number);
  const [h, m] = pieces;
  if (!Number.isFinite(h) || !Number.isFinite(m)) return null;
  const sec = Number.isFinite(pieces[2]) ? pieces[2] : 0;
  return h * 3600 + m * 60 + sec;
}

/** The segments as seconds since midnight, on the 24h clock the value is emitted in. */
function currentSeconds(): number {
  let h = hourNow.peek();
  if (is12h()) {
    const period = periodNow.peek();
    if (period === 'AM' && h === 12) h = 0;
    else if (period === 'PM' && h !== 12) h += 12;
  }
  return h * 3600 + minuteNow.peek() * 60 + secondNow.peek();
}

/** Write seconds-since-midnight back into the segments, in the clock currently in use. */
function setSeconds(total: number): void {
  let h = Math.floor(total / 3600) % 24;
  minuteNow = Math.floor(total / 60) % 60;
  secondNow = total % 60;
  if (is12h()) {
    periodNow = h >= 12 ? 'PM' : 'AM';
    h = h % 12 === 0 ? 12 : h % 12;
  }
  hourNow = h;
}

/** Pull the segments back inside [min, max]. The `value` prop is never clamped — see the test. */
function clampToRange(): void {
  const lo = bound(min as string);
  const hi = bound(max as string);
  if (lo === null && hi === null) return;
  const now = currentSeconds();
  if (lo !== null && now < lo) setSeconds(lo);
  else if (hi !== null && now > hi) setSeconds(hi);
}

function emitChange(): void {
  const empty = emptyNow.peek();
  if (!empty) clampToRange();
  const val = empty ? '' : formatOutput();
  // The model, which dispatches `value-change`. `_reflected` first, so the value effect sees
  // its own write.
  _reflected = val;
  value = val;
}

/** The first arrow, digit or wheel step on an empty picker starts from `min`, else 00:00. */
function leaveEmpty(): void {
  if (!emptyNow.peek()) return;
  setSeconds(bound(min as string) ?? 0);
  emptyNow = false;
}

function adjustSegment(which: string, delta: number): void {
  leaveEmpty();
  const stepBy = step as number;
  if (which === 'hour') {
    const maxH = is12h() ? 12 : 23;
    const minH = is12h() ? 1 : 0;
    let h = hourNow.peek() + delta;
    if (h > maxH) h = minH;
    if (h < minH) h = maxH;
    hourNow = h;
  } else if (which === 'minute') {
    let m = minuteNow.peek() + delta * stepBy;
    if (m >= 60) m = 0;
    if (m < 0) m = 60 - stepBy;
    minuteNow = m;
  } else if (which === 'second') {
    let s = secondNow.peek() + delta * stepBy;
    if (s >= 60) s = 0;
    if (s < 0) s = 60 - stepBy;
    secondNow = s;
  } else if (which === 'period') {
    periodNow = periodNow.peek() === 'AM' ? 'PM' : 'AM';
  }
  emitChange();
}

function handleDigit(digit: string, which: string): void {
  leaveEmpty();
  if (which === 'period') {
    if (digit.toLowerCase() === 'a') periodNow = 'AM';
    else if (digit.toLowerCase() === 'p') periodNow = 'PM';
    emitChange();
    return;
  }
  if (_digitTimer) clearTimeout(_digitTimer);
  const buffer = _digitBuffer + digit;
  _digitBuffer = buffer;
  const num = parseInt(buffer, 10);
  let commit = false;
  if (which === 'hour') {
    const maxH = is12h() ? 12 : 23;
    if (num <= maxH) { hourNow = num; commit = buffer.length >= 2 || num * 10 > maxH; }
    else { hourNow = parseInt(digit, 10); commit = true; }
  } else if (which === 'minute') {
    if (num <= 59) { minuteNow = num; commit = buffer.length >= 2 || num * 10 > 59; }
    else { minuteNow = parseInt(digit, 10); commit = true; }
  } else if (which === 'second') {
    if (num <= 59) { secondNow = num; commit = buffer.length >= 2 || num * 10 > 59; }
    else { secondNow = parseInt(digit, 10); commit = true; }
  }
  if (commit) { _digitBuffer = ''; advanceSegment(); }
  else { _digitTimer = setTimeout(() => { _digitBuffer = ''; advanceSegment(); }, 1000); }
  emitChange();
}

function advanceSegment(): void {
  // Focus next segment via DOM
  const segments = host.querySelectorAll<HTMLElement>('.pdx-time-value');
  const current = host.querySelector('.pdx-time-value:focus') as HTMLElement;
  if (!current) return;
  const idx = Array.from(segments).indexOf(current);
  if (idx < segments.length - 1) segments[idx + 1].focus();
}

function onSegmentKeydown(e: KeyboardEvent, which: string): void {
  if (disabled) return;
  if (e.key === 'ArrowUp') { e.preventDefault(); adjustSegment(which, 1); }
  else if (e.key === 'ArrowDown') { e.preventDefault(); adjustSegment(which, -1); }
  else if (e.key === 'Tab') { /* default */ }
  else if (/^[0-9]$/.test(e.key)) { e.preventDefault(); handleDigit(e.key, which); }
  else if (/^[aApP]$/.test(e.key) && which === 'period') { e.preventDefault(); handleDigit(e.key, which); }
}

function onWheel(e: WheelEvent, which: string): void {
  e.preventDefault();
  adjustSegment(which, e.deltaY < 0 ? 1 : -1);
}

// ─── Render ────────────────────────────────────────
// Build DOM once, update textContent reactively (never destroy focused elements)

let _hourEl: HTMLElement | null = null;
let _minuteEl: HTMLElement | null = null;
let _secondEl: HTMLElement | null = null;
let _periodEl: HTMLElement | null = null;
let _groupEl: HTMLElement | null = null;
let _built = false;

/** The group's name: aria-label, else time-picker.label — a string a locale can reach. */
const groupName = (): string => (ariaLabel as string) || getComponentString('time-picker', 'label')();
$effect(() => {
  const n = groupName();
  if (_groupEl) _groupEl.setAttribute('aria-label', n);
});

// Build structure once (onNextFrame: a setup a move destroyed does not build again)
onNextFrame(() => {
  if (_built) return;
  _built = true;
  const showSec = showSeconds as boolean;
  const use12h_ = is12h();

  const wrap = document.createElement('div');
  // No state class: `disabled` is the host's :state(disabled) (#287).
  wrap.className = 'pdx-time-picker';
  wrap.setAttribute('data-part', 'root');
  wrap.setAttribute('role', 'group');
  wrap.setAttribute('aria-label', groupName());
  _groupEl = wrap;

  const hourCol = buildSegment('hour', '00', getComponentString('time-picker', 'hour')());
  _hourEl = hourCol.querySelector('.pdx-time-value')!;
  wrap.appendChild(hourCol);
  wrap.appendChild(buildSeparator(':'));

  const minCol = buildSegment('minute', '00', getComponentString('time-picker', 'minute')());
  _minuteEl = minCol.querySelector('.pdx-time-value')!;
  wrap.appendChild(minCol);

  if (showSec) {
    wrap.appendChild(buildSeparator(':'));
    const secCol = buildSegment('second', '00', getComponentString('time-picker', 'second')());
    _secondEl = secCol.querySelector('.pdx-time-value')!;
    wrap.appendChild(secCol);
  }
  if (use12h_) {
    const perCol = buildSegment('period', 'AM', getComponentString('time-picker', 'period')());
    _periodEl = perCol.querySelector('.pdx-time-value')!;
    wrap.appendChild(perCol);
  }
  host.appendChild(wrap);
});

// `disabled`, set before or after the build: every segment out of the tab order while it holds
// (#287); the host's state is the @state above. Read first, so the effect subscribes before the frame
// builds.
$effect(() => {
  const off = !!disabled;
  requestAnimationFrame(() => {
    for (const seg of [_hourEl, _minuteEl, _secondEl, _periodEl]) seg?.setAttribute('tabindex', off ? '-1' : '0');
  });
});

// Update effect: only change textContent (preserves focus)
$effect(() => {
  const h = hourNow;
  const m = minuteNow;
  const s = secondNow;
  const period = periodNow;
  const empty = emptyNow;
  const emptyText = getComponentString('time-picker', 'empty')();

  /**
   * A segment's text and spinbutton value, a number, and `said` when the number is not what to
   * say (AM/PM); empty shows "--" and says so, with no number.
   */
  const show = (seg: HTMLElement | null, text: string, now: string, said?: string): void => {
    if (!seg) return;
    if (empty) {
      seg.textContent = '--';
      seg.removeAttribute('aria-valuenow');
      seg.setAttribute('aria-valuetext', emptyText);
    } else {
      seg.textContent = text;
      seg.setAttribute('aria-valuenow', now);
      if (said === undefined) seg.removeAttribute('aria-valuetext'); else seg.setAttribute('aria-valuetext', said);
    }
  };

  requestAnimationFrame(() => {
    show(_hourEl, String(h).padStart(2, '0'), String(h));
    show(_minuteEl, String(m).padStart(2, '0'), String(m));
    show(_secondEl, String(s).padStart(2, '0'), String(s));
    // A spinbutton's value is a number: AM is 0 and PM 1, the word its value text.
    show(_periodEl, period, period === 'PM' ? '1' : '0', period);
  });
});

function buildSegment(which: string, display: string, label: string): HTMLElement {
  const col = document.createElement('div');
  col.className = 'pdx-time-col' + (which === 'period' ? ' pdx-time-period-col' : '');

  // Up arrow button
  const upBtn = document.createElement('button');
  upBtn.type = 'button';
  upBtn.className = 'pdx-time-arrow pdx-time-arrow-up';
  upBtn.setAttribute('data-part', 'arrow');
  upBtn.setAttribute('tabindex', '-1');
  upBtn.setAttribute('aria-hidden', 'true');
  upBtn.textContent = '▲';
  upBtn.addEventListener('click', (e) => { e.preventDefault(); adjustSegment(which, 1); });
  col.appendChild(upBtn);

  // Value display (focusable, editable)
  const val = document.createElement('div');
  val.className = 'pdx-time-value' + (which === 'period' ? ' pdx-time-period' : '');
  val.setAttribute('role', 'spinbutton');
  val.setAttribute('data-part', 'segment');
  val.setAttribute('tabindex', disabled ? '-1' : '0');
  val.setAttribute('aria-label', label);
  // The segment's value and range for the WAI-ARIA spinbutton pattern, numbers all: AM/PM is 0
  // or 1, its word in aria-valuetext.
  if (which === 'period') {
    val.setAttribute('aria-valuenow', display === 'PM' ? '1' : '0');
    val.setAttribute('aria-valuetext', display);
    val.setAttribute('aria-valuemin', '0');
    val.setAttribute('aria-valuemax', '1');
  } else val.setAttribute('aria-valuenow', display);
  if (which === 'hour') {
    val.setAttribute('aria-valuemin', is12h() ? '1' : '0');
    val.setAttribute('aria-valuemax', is12h() ? '12' : '23');
  } else if (which === 'minute' || which === 'second') {
    val.setAttribute('aria-valuemin', '0');
    val.setAttribute('aria-valuemax', '59');
  }
  val.textContent = display;
  val.addEventListener('keydown', (e) => onSegmentKeydown(e, which));
  val.addEventListener('wheel', (e) => onWheel(e, which), { passive: false });
  val.addEventListener('focus', () => { _digitBuffer = ''; });
  val.addEventListener('blur', () => pdxBlur());
  col.appendChild(val);

  // Down arrow button
  const downBtn = document.createElement('button');
  downBtn.type = 'button';
  downBtn.className = 'pdx-time-arrow pdx-time-arrow-down';
  downBtn.setAttribute('data-part', 'arrow');
  downBtn.setAttribute('tabindex', '-1');
  downBtn.setAttribute('aria-hidden', 'true');
  downBtn.textContent = '▼';
  downBtn.addEventListener('click', (e) => { e.preventDefault(); adjustSegment(which, -1); });
  col.appendChild(downBtn);

  return col;
}

function buildSeparator(char: string): HTMLElement {
  const sep = document.createElement('span');
  sep.className = 'pdx-time-separator';
  sep.setAttribute('data-part', 'separator');
  sep.textContent = char;
  sep.setAttribute('aria-hidden', 'true');
  return sep;
}

function focus() { (host.querySelector('input, textarea, [tabindex]:not([tabindex="-1"]), button') as HTMLElement | null)?.focus(); }
function blur() { (host.querySelector('input, textarea, [tabindex]:not([tabindex="-1"]), button') as HTMLElement | null)?.blur(); }
function clear() {
  hourNow = is12h() ? 12 : 0;
  minuteNow = 0;
  secondNow = 0;
  periodNow = 'AM';
  emptyNow = true;
  emitChange();
}
</script>

      "name": "show",
      "parameters": [],
      "description": "Shows it."
    },
    {
      "kind": "method",
      "name": "close",
      "parameters": [],
      "description": "Closes it."
    },
    {
      "kind": "method",
      "name": "toggle",
      "parameters": [],
      "description": "Toggles it open/closed."
    },
    {
      "kind": "field",
      "name": "isOpen",

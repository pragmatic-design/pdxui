      "description": "Read-only, via a ref: `el.isOpen`."
    },
    {
      "kind": "method",
      "name": "confirm",
      "parameters": [],
      "description": "Confirm and close, as the confirm button does. Does nothing while that button is held back — loading, a countdown running, or a confirmation phrase not yet typed."
    },
    {
      "kind": "method",
      "name": "cancel",
      "parameters": [],

  "slots": [
    {
      "name": "tag",
      "description": "Renders one tag: a snippet `tag(tag, index)`.",
      "signature": "(tag: string, index: number)"
    }
  ],
  "cssParts": [
    {
      "name": "root",
      "description": "The frame, `role=\"group\"`: border, background and the states' colours."
    },
    {
      "name": "input",
      "description": "The text box where a tag is typed; gone while `disabled`, `readonly` or at `max-tags`."
    },
    {
      "name": "tag",
      "description": "One tag, a chip."
    },
    {
      "name": "remove",
      "description": "A tag's remove button, while neither `disabled` nor `readonly`."
    }

{
  "kind": "class",
  "customElement": true,
  "name": "PdxContextMenu",
  "tagName": "pdx-context-menu",
  "category": "Navigation",
  "order": 61,
  "description": "A right-click menu that opens at the cursor, and also on a long press on mobile or Shift+F10 from\nthe keyboard.",
  "generics": [
    "T extends { key?: string; label?: string; type?: string }"
  ],
  "members": [
    {
      "kind": "field",
      "name": "items",
      "description": "Menu items (static array or function returning items)",
      "type": {
        "text": "T[]"
      },
      "default": "[]"
    },
    {
      "kind": "field",
      "name": "disabled",
      "description": "Disabled — prevents context menu from opening",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "disabled"
    },
    {
      "kind": "field",
      "name": "minWidth",
      "description": "Min width of the menu panel",
      "type": {
        "text": "number"
      },
      "default": "180",
      "attribute": "minwidth"
    },
    {
      "kind": "method",
      "name": "show",
      "parameters": [
        {
          "name": "clientX",
          "type": {
            "text": "number"
          },
          "optional": true
        },
        {
          "name": "clientY",
          "type": {
            "text": "number"
          },
          "optional": true
        }
      ],
      "description": "Shows it."
    },
    {
      "kind": "method",
      "name": "close",
      "parameters": [],
      "description": "Closes it."
    },
    {
      "kind": "method",
      "name": "toggle",
      "parameters": [
        {
          "name": "clientX",
          "type": {
            "text": "number"
          },
          "optional": true
        },
        {
          "name": "clientY",
          "type": {
            "text": "number"
          },
          "optional": true
        }
      ],
      "description": "Toggles it open/closed."
    },
    {
      "kind": "field",
      "name": "isOpen",
      "readonly": true,
      "description": "Read-only, via a ref: `el.isOpen`."
    }
  ],
  "events": [
    {
      "name": "open-change",
      "type": {
        "text": "CustomEvent"
      },
      "description": "The menu opened (`true`) or closed (`false`): its open state, read-only (#288). The parent\nnever writes it, so it is not a model, and `::open` on it is an error.",
      "detail": "{ value: boolean }"
    },
    {
      "name": "pdx-select",
      "type": {
        "text": "CustomEvent"
      },
      "description": "An entry was chosen.",
      "detail": "{ key: string; item: MenuItem }"
    }
  ],
  "roles": [
    "menu",
    "menuitem",
    "menuitemcheckbox",
    "menuitemradio",
    "presentation",
    "separator"
  ],
  "attributes": [

      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "showcount"
    },
    {
      "kind": "field",
      "name": "wordCount",
      "description": "Counts words instead of characters.",
      "type": {
        "text": "boolean"
      },
      "default": "false",

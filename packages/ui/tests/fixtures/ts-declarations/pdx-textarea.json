      "kind": "field",
      "name": "maxRows",
      "description": "Maximum rows when auto-growing.",
      "type": {
        "text": "number"
      },
      "default": "0",
      "attribute": "maxrows"
    },
    {
      "kind": "field",
      "name": "maxlength",

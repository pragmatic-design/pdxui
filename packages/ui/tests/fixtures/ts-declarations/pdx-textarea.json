{
  "kind": "class",
  "customElement": true,
  "name": "PdxTextarea",
  "tagName": "pdx-textarea",
  "category": "Specialized Inputs",
  "order": 20,
  "description": "A multi-line text input with auto-resize, a character or word count and validation states.",
  "members": [
    {
      "kind": "field",
      "name": "placeholder",
      "description": "Placeholder text shown while empty.",
      "type": {
        "text": "string"
      },
      "default": "''",
      "attribute": "placeholder"
    },
    {
      "kind": "field",
      "name": "disabled",
      "description": "Disables interaction and dims the control.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "disabled"
    },
    {
      "kind": "field",
      "name": "readonly",
      "description": "Makes the value read-only — visible but not editable.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "readonly"
    },
    {
      "kind": "field",
      "name": "required",

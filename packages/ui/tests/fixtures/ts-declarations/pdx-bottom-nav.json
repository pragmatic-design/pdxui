{
  "kind": "class",
  "customElement": true,
  "name": "PdxBottomNav",
  "tagName": "pdx-bottom-nav",
  "category": "Navigation",
  "order": 56,
  "description": "A mobile tab bar fixed at the bottom of the screen, with three to five items that carry icons and\noptional badges.",
  "members": [
    {
      "kind": "field",
      "name": "items",
      "description": "The data items to render.",
      "type": {
        "text": "unknown[]"
      },
      "default": "[]"
    },
    {
      "kind": "field",
      "name": "activeKey",
      "description": "Key of the active item.",
      "type": {
        "text": "string"
      },
      "default": "''",
      "attribute": "activekey"
    }
  ],
  "events": [
    {
      "name": "pdx-select",
      "type": {
        "text": "CustomEvent"
      },
      "description": "An item was chosen: its `key` and its item.",
      "detail": "{ key: string; item: BottomNavItem }"
    }
  ],
  "roles": [
    "navigation"
  ],
  "attributes": [
    {
      "name": "activekey",
      "fieldName": "activeKey",
      "description": "Key of the active item.",
      "type": {
        "text": "string"
      },
      "default": "''"
    }
  ],
  "shapes": [
    {
      "name": "BottomNavItem",
      "fields": [
        "key: string",
        "label: string",
        "icon: string",
        "badge?: string",
        "badgeVariant?: 'default' | 'primary' | 'danger'"
      ]
    }
  ],
  "cssParts": [
    {
      "name": "bar",
      "description": "The row of items."
    },
    {
      "name": "item",
      "description": "An item, a button; the current one is `aria-current=\"page\"`."
    },
    {
      "name": "icon",
      "description": "An item's icon, and the badge over it."
    },
    {
      "name": "badge",
      "description": "An item's count."
    },
    {
      "name": "label",
      "description": "An item's text."
    }
  ],
  "cssStates": [
    {
      "name": "ready",
      "description": "Its bar is drawn, pinned to the bottom of the viewport."
    }
  ]
}

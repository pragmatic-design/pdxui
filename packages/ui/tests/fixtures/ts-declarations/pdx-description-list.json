{
  "kind": "class",
  "customElement": true,
  "name": "PdxDescriptionList",
  "tagName": "pdx-description-list",
  "category": "Data Display",
  "order": 83,
  "description": "Key-value pairs in a structured layout, horizontal or vertical and in one or more columns, with\nvalues as plain text or custom HTML.",

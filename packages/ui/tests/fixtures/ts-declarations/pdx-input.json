    {
      "kind": "field",
      "name": "success",
      "description": "Applies the success state styling.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "success"
    },
    {
      "kind": "field",
      "name": "warning",
      "description": "Applies the warning state styling.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "warning"
    },
    {
      "kind": "field",
      "name": "clearable",

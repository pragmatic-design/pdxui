{
  "kind": "class",
  "customElement": true,
  "name": "PdxInput",
  "tagName": "pdx-input",
  "category": "Atoms",
  "order": 12,
  "description": "A text input with prefix and suffix content, a clear button and loading and validation states,\nand the base of the specialized inputs.",
  "members": [
    {
      "kind": "field",
      "name": "type",
      "description": "Native input type (text, email, password, …).",
      "type": {
        "text": "'text' | 'email' | 'password' | 'number' | 'tel' | 'url' | 'search' | 'date' | 'time'"
      },
      "default": "'text'",
      "attribute": "type"
    },
    {
      "kind": "field",
      "name": "placeholder",
      "description": "Placeholder text shown while empty.",
      "type": {
        "text": "string"
      },
      "default": "''",
      "attribute": "placeholder"
    },
    {
      "kind": "field",
      "name": "disabled",
      "description": "Disables interaction and dims the control.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "disabled"
    },
    {
      "kind": "field",
      "name": "readonly",
      "description": "Makes the value read-only — visible but not editable.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "readonly"
    },
    {
      "kind": "field",
      "name": "required",
      "description": "Marks the field as required.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "required"
    },

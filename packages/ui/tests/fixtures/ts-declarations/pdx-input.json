      "kind": "method",
      "name": "focus",
      "parameters": [],
      "description": "Moves focus to it."
    },
    {
      "kind": "method",
      "name": "blur",
      "parameters": [],
      "description": "Removes focus from it."
    },
    {
      "kind": "method",
      "name": "clear",
      "parameters": [],

        "text": "boolean"
      },
      "default": "false"
    },
    {
      "name": "error",
      "fieldName": "error",
      "description": "Marks the control as invalid.",
      "type": {
        "text": "string"
      },
      "default": "''"
    },
    {
      "name": "description",
      "fieldName": "description",
      "description": "Secondary descriptive text.",
      "type": {
        "text": "string"
      },
      "default": "''"
    },
    {
      "name": "collapsible",
      "fieldName": "collapsible",
      "description": "Allows the group to collapse.",
      "type": {
        "text": "boolean"
      },
      "default": "false"
    },
    {
      "name": "variant",
      "fieldName": "variant",

        "text": "'bordered' | 'filled' | 'plain'"
      },
      "default": "'bordered'"
    },
    {
      "name": "size",
      "fieldName": "size",
      "description": "sm, md (the default) or lg.",
      "type": {
        "text": "'md' | 'sm' | 'lg'"
      },
      "default": "'md'"
    },
    {
      "name": "collapsed",
      "fieldName": "collapsed",
      "description": "Whether a collapsible fieldset is collapsed.",
      "type": {
        "text": "boolean"
      },
      "default": "false"

  ],
  "slots": [
    {
      "name": "",
      "description": "The content placed inside the element."
    }
  ],
  "cssParts": [
    {
      "name": "root",
      "description": "The native `<fieldset>`."
    },
    {
      "name": "legend",
      "description": "The `<legend>`: the text and, when collapsible, the toggle."
    },
    {
      "name": "toggle",
      "description": "The collapse button in the legend."
    },
    {
      "name": "description",
      "description": "The description under the legend, with `description`."
    },
    {
      "name": "content",
      "description": "The slotted controls."
    },
    {
      "name": "error",
      "description": "The error message, with `error`; it is the fieldset's description."
    }
  ],
  "cssStates": [
    {
      "name": "invalid",
      "description": "`invalid`, or an `error` is set: the border turns to the danger colour."
    },
    {
      "name": "collapsed",
      "description": "`collapsed`: the content is hidden and the chevron turned."
    },
    {
      "name": "collapsible",
      "description": "`collapsible`: the legend holds the toggle."
    },
    {
      "name": "disabled",
      "description": "`disabled`: every control inside is disabled, by the native fieldset."
    }
  ]

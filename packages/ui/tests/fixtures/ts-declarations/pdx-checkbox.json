{
  "kind": "class",
  "customElement": true,
  "name": "PdxCheckbox",
  "tagName": "pdx-checkbox",
  "category": "Atoms",
  "order": 13,
  "description": "A checkbox with a label and a description, which can be indeterminate or, as a tristate, cycle\nthrough unchecked, checked and indeterminate.",

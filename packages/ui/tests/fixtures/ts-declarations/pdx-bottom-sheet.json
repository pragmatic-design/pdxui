      "fieldName": "showClose",
      "description": "Show close button. Default: false",
      "type": {
        "text": "boolean"
      },
      "default": "false"
    },
    {
      "name": "label",
      "fieldName": "label",
      "description": "Label for accessibility.",
      "type": {
        "text": "string"
      },
      "default": "''"
    },
    {
      "name": "open",
      "fieldName": "open",
      "description": "Whether it is open.",
      "type": {
        "text": "boolean"
      },
      "default": "false"
    }
  ],

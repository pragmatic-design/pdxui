{
  "kind": "class",
  "customElement": true,
  "name": "PdxDrawer",
  "tagName": "pdx-drawer",
  "category": "Overlay + Containers",
  "order": 95,
  "description": "A panel that slides in from any edge, over the page or pushing it, with swipe-to-close and a focus\ntrap.",
  "members": [
    {
      "kind": "field",
      "name": "position",
      "description": "Position: left, right (default), top, bottom",
      "type": {
        "text": "'left' | 'right' | 'top' | 'bottom'"
      },
      "default": "'right'",
      "attribute": "position"
    },
    {
      "kind": "field",
      "name": "size",
      "description": "Size: sm (280px), md (380px), lg (520px), or ANY custom CSS width (e.g. \"640px\").\nOpen-ended on purpose → NOT declared as a closed enum.",
      "type": {
        "text": "string"
      },
      "default": "'md'",
      "attribute": "size"
    },
    {
      "kind": "field",
      "name": "mode",
      "description": "Mode: overlay (default) or push (shifts page content)",
      "type": {
        "text": "'overlay' | 'push'"
      },
      "default": "'overlay'",
      "attribute": "mode"
    },
    {
      "kind": "field",
      "name": "closeOnBackdrop",

{
  "kind": "class",
  "customElement": true,
  "name": "PdxFab",
  "tagName": "pdx-fab",
  "category": "Navigation",
  "order": 66,
  "description": "A floating action button that can open a speed dial of actions, in four directions and four layouts.",
  "members": [
    {
      "kind": "field",
      "name": "icon",
      "description": "Main button icon name",
      "type": {
        "text": "string"
      },
      "default": "'plus'",
      "attribute": "icon",
      "iconName": true
    },
    {
      "kind": "field",
      "name": "label",
      "description": "Main button label (screen reader). Empty: the fab.label component string, «Actions».",
      "type": {
        "text": "string"
      },
      "default": "''",
      "attribute": "label"
    },
    {
      "kind": "field",
      "name": "actions",
      "description": "Speed dial actions",
      "type": {
        "text": "unknown[]"
      },
      "default": "[]"
    },
    {
      "kind": "field",
      "name": "direction",
      "description": "Speed dial direction: up (default), down, left, right",
      "type": {
        "text": "string"
      },
      "default": "'up'",
      "attribute": "direction"
    },
    {
      "kind": "field",
      "name": "type",
      "description": "Speed dial layout: linear (default), circle, semi-circle, quarter-circle",
      "type": {
        "text": "string"
      },
      "default": "'linear'",
      "attribute": "type"
    },
    {
      "kind": "field",
      "name": "showTooltip",
      "description": "Show tooltip labels next to actions",
      "type": {
        "text": "boolean"
      },
      "default": "true",
      "attribute": "showtooltip"
    },
    {
      "kind": "field",
      "name": "mask",
      "description": "Show mask overlay when open",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "mask"
    },
    {
      "kind": "field",
      "name": "trigger",
      "description": "Trigger mode: click (default), hover",
      "type": {
        "text": "string"
      },
      "default": "'click'",
      "attribute": "trigger"
    },
    {
      "kind": "field",
      "name": "variant",
      "description": "primary (the default), secondary or danger.",
      "type": {
        "text": "'primary' | 'secondary' | 'danger'"
      },
      "default": "'primary'",
      "attribute": "variant"
    },
    {
      "kind": "field",
      "name": "size",
      "description": "sm, md (the default) or lg.",
      "type": {
        "text": "'md' | 'sm' | 'lg'"
      },
      "default": "'md'",
      "attribute": "size"
    },
    {
      "kind": "field",
      "name": "position",
      "description": "bottom-right (the default), bottom-left, top-right or top-left.",
      "type": {
        "text": "'bottom-right' | 'bottom-left' | 'top-right' | 'top-left'"
      },
      "default": "'bottom-right'",
      "attribute": "position"
    },
    {
      "kind": "method",
      "name": "show",
      "parameters": [],
      "description": "Shows it."
    },
    {
      "kind": "method",
      "name": "close",
      "parameters": [],
      "description": "Closes it."
    },
    {
      "kind": "method",
      "name": "toggle",
      "parameters": [],
      "description": "Toggles it open/closed."
    },
    {
      "kind": "field",
      "name": "isOpen",
      "readonly": true,
      "description": "Read-only, via a ref: `el.isOpen`."
    }
  ],
  "variants": [
    {
      "name": "variant",
      "values": [
        "primary",
        "secondary",
        "danger"
      ],
      "default": "primary",
      "native": {
        "primary": ".pdx-fab-primary",
        "secondary": ".pdx-fab-secondary",
        "danger": ".pdx-fab-danger"
      }
    },
    {
      "name": "size",
      "values": [
        "md",
        "sm",
        "lg"
      ],
      "default": "md",
      "native": {
        "md": ".pdx-fab-md",
        "sm": ".pdx-fab-sm",
        "lg": ".pdx-fab-lg"
      }
    },
    {
      "name": "position",
      "values": [
        "bottom-right",
        "bottom-left",
        "top-right",
        "top-left"
      ],
      "default": "bottom-right"
    }
  ],
  "events": [
    {
      "name": "open-change",
      "type": {
        "text": "CustomEvent"
      },
      "description": "The speed dial opened (`true`) or closed (`false`): its open state, read-only (#288). The\nparent never writes it, so it is not a model, and `::open` on it is an error.",
      "detail": "{ value: boolean }"
    },
    {
      "name": "pdx-click",
      "type": {
        "text": "CustomEvent"
      },
      "description": "The button was pressed, on a FAB with no speed dial.",
      "detail": "Record<string, never>"
    },
    {
      "name": "pdx-select",
      "type": {
        "text": "CustomEvent"
      },
      "description": "An action of the speed dial was chosen.",
      "detail": "{ key: string; action: FabAction }"
    }
  ],
  "roles": [
    "menu",
    "menuitem"
  ],
  "attributes": [
    {
      "name": "icon",

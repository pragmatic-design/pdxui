    },
    {
      "name": "group",
      "description": "The element reached as `[data-part=\"group\"]`."
    },
    {
      "name": "option",
      "description": "The element reached as `[data-part=\"option\"]`."
    },
    {
      "name": "empty",
      "description": "The element reached as `[data-part=\"empty\"]`."
    },
    {
      "name": "footer",
      "description": "The element reached as `[data-part=\"footer\"]`."
    }
  ],
  "cssStates": [
    {

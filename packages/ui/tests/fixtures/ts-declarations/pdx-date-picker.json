        "text": "'md' | 'xs' | 'sm' | 'lg' | 'xl'"
      },
      "default": "'md'",
      "attribute": "size"
    },
    {
      "kind": "field",
      "name": "value",
      "description": "The date, or `[start, end]` with `mode=\"daterange\"` or `\"datetimerange\"`. A form submits it; a range as two entries, one per date (#135).",

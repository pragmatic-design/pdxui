        "text": "string | string[]"
      },
      "default": "''",
      "attribute": "value"
    },
    {
      "kind": "method",
      "name": "getDate",
      "parameters": [],
      "description": "The date chosen, ISO: the range's start in a range or week mode; '' with none."
    },
    {
      "kind": "method",
      "name": "getRange",
      "parameters": [],
      "description": "The range chosen, or the one a week, month, quarter or year covers: `[start, end]`, ISO dates."
    },
    {
      "kind": "method",
      "name": "getTime",
      "parameters": [],
      "description": "The time, `HH:mm[:ss]`: the start's in a range."
    },
    {
      "kind": "method",
      "name": "getEndTime",
      "parameters": [],
      "description": "The end's time in a range with times."
    },
    {
      "kind": "method",
      "name": "focus",
      "parameters": [],
      "description": "Moves focus to it."
    },
    {
      "kind": "method",
      "name": "blur",
      "parameters": [],
      "description": "Removes focus from it."
    },
    {
      "kind": "method",
      "name": "clear",
      "parameters": [],
      "description": "Clears the value."
    },
    {
      "kind": "method",
      "name": "show",
      "parameters": [],
      "description": "Open the popup; open already, it stays open."
    },
    {
      "kind": "method",
      "name": "close",
      "parameters": [],
      "description": "Close the popup."
    },
    {
      "kind": "method",
      "name": "toggle",
      "parameters": [],
      "description": "Open the popup when closed, close it when open."
    }

{
  "kind": "class",
  "customElement": true,
  "name": "PdxDialog",
  "tagName": "pdx-dialog",
  "category": "Overlay + Containers",
  "order": 93,
  "summary": "Modal window: overlay with focus trap, z-index managed via overlayStack, Escape-to-close.",
  "description": "Modal dialog with backdrop, focus trap and Escape-to-close.",
  "members": [
    {
      "kind": "field",
      "name": "title",
      "description": "The dialog heading.",
      "type": {
        "text": "string"
      },
      "default": "''",
      "attribute": "title"
    },
    {
      "kind": "field",
      "name": "closeOnBackdrop",
      "description": "Close when the backdrop is clicked.",
      "type": {
        "text": "boolean"
      },
      "default": "true",
      "attribute": "closeonbackdrop"
    },
    {
      "kind": "field",
      "name": "closeOnEscape",
      "description": "Close when the Escape key is pressed.",
      "type": {
        "text": "boolean"
      },
      "default": "true",
      "attribute": "closeonescape"
    },
    {
      "kind": "field",
      "name": "showClose",
      "description": "Shows the close (×) button.",
      "type": {
        "text": "boolean"
      },
      "default": "true",
      "attribute": "showclose"
    },
    {
      "kind": "field",
      "name": "initialfocus",
      "description": "Selector of the element to focus on open.",
      "type": {
        "text": "string"
      },
      "default": "''",
      "attribute": "initialfocus"
    },
    {
      "kind": "field",
      "name": "preventClose",
      "description": "Blocks all dismiss paths (must close programmatically).",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "preventclose"
    },
    {
      "kind": "field",
      "name": "loading",
      "description": "Show loading state",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "loading"
    },
    {
      "kind": "field",
      "name": "size",
      "description": "sm, md (the default), lg, xl or full.",
      "type": {
        "text": "'md' | 'sm' | 'lg' | 'xl' | 'full'"
      },
      "default": "'md'",
      "attribute": "size"
    },
    {
      "kind": "field",
      "name": "open",
      "description": "Whether it is open.",
      "type": {
        "text": "boolean"
      },
      "default": "false",
      "attribute": "open"
    },
    {
      "kind": "method",
      "name": "show",
      "parameters": [],
      "description": "Shows it."
    },
    {
      "kind": "method",
      "name": "close",
      "parameters": [],
      "description": "Closes it."
    },
    {
      "kind": "method",
      "name": "toggle",
      "parameters": [],
      "description": "Toggles it open/closed."
    },
    {
      "kind": "field",
      "name": "isOpen",
      "readonly": true,
      "description": "Read-only, via a ref: `el.isOpen`."
    }
  ],

{
    // The package's OWN project, widened to everything it holds.
    //
    // `tsconfig.json` is the BUILD: `rootDir: src`, `outDir: dist`, and adding `tests/` to it would
    // both break the root and emit declarations for test files. So the tests get a project of their
    // own that emits nothing — the shape a monorepo usually reaches for, and the one
    // `packages/design/tsconfig.engine.json` uses too.
    //
    // It exists because a type gate that reads only `src/` leaves the test suites — most of the
    // package's files — compiled by nothing, and an unchecked suite hides tests that cannot fail.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // The REPO root, because nothing is emitted and a test may legitimately
        // import a sibling package's source — the CLI's theme tests read the
        // builder's config. With `rootDir` at the package, TS6059 fires on every
        // such file: "not under rootDir", about a program that produces no output.
        "rootDir": "../..",
        "declaration": false,
        "declarationMap": false,
        "types": ["node"],
        "typeRoots": ["../compiler/node_modules/@types"]
    },
    // The unit tests import the ROUTER's source directly, and its ambient globals live in a
    // `.d.ts` — a file an import graph never reaches, because only `include` pulls one in.
    // Without it the router's own source fails to typecheck HERE while passing in its own
    // package: 23 errors about `_keepAlive`, `PdxNavigateEvent` and `globalThis`.
    // `"*.ts"` is the package ROOT: `vite.config.ts` and friends. A build config that does
    // not typecheck is a build that breaks on a rename nobody sees, as `builder` and `showcase`
    // also hold.
    "include": ["*.ts", "src/**/*.ts", "tests/**/*.ts", "../router/src/pdx-globals.d.ts"],
    "exclude": ["node_modules", "dist"]
}

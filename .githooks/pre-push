#!/bin/sh
# Pre-push gate. Fastest to slowest (fail-fast):
#   1) Quality outside the UI: typecheck + lint (core·compiler·router·ui·lsp·cli·design engine)  (seconds)
#   2) The site demos regenerated, then the suites the push affects: `pnpm test:affected`   (minutes)
#   2b) The compiler benchmarks, alone                               (seconds)
#   3) Only with PDX_CERTIFY=1: component certification (Dim 1-4) and, when Docker answers, the
#      visual regression (Dim 5)
#
# Phase 2 runs the vitest suites of the packages the push changes and of those built on them, plus
# core and cli, whose suites read the whole repository; a change outside packages/ runs every vitest
# suite (scripts/test-affected.mjs). The browser suites — design, builder, site, showcase — are CI's,
# which shards them and runs every suite on every pull request: here they cost ~12 of the ~17
# minutes the full `pnpm test` took (2026-11-14), and CI then spent them again (#1074). Measured the
# same day: every vitest suite (a change outside packages/) 252 s; a change to ui alone (ui, core,
# cli) 194 s. PDX_TEST_ALL=1 runs the full `pnpm test` here, as before.
#
# Certification is CI's, by default. It ran here too, and with it a push took about 25 minutes
# that CI then spent again (#60). certify.yml runs Dim 1-5 on every pull request, with no path
# filter, so every change is certified before it can be merged. Set PDX_CERTIFY=1 to run it here
# first — worth it for a change to a component's look or geometry, where a red seen before the
# push saves a round trip.
#
# Skipping:
#   - Skip everything once:          git push --no-verify
#   - Skip quality only (env):       PDX_SKIP_QUALITY=1
#   - Skip the suites only (env):    PDX_SKIP_TESTS=1
#   - Every suite, browser too (env): PDX_TEST_ALL=1
#   - Skip the benchmarks (env):     PDX_SKIP_PERF=1
# Adding:
#   - Certify before the push (env): PDX_CERTIFY=1   (and PDX_SKIP_VISUAL=1 to leave out Dim 5)

# The gate runs in a clean git environment. Git exports GIT_DIR to a hook — in a linked worktree it
# points at .git/worktrees/<name> — and the suites call git themselves: `git ls-files` from a
# subfolder then lists paths from the repository root (docs-language.test.ts reads files that do not
# exist), `git status` per package returns the whole tree (publish-local.test.ts overflows its
# buffer), and a fixture's `git init` + `git config` in a temporary folder writes into the real
# repository's config instead. Each git call must find its repository from its own folder.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX GIT_OBJECT_DIRECTORY

# ── Phase 1: quality (typecheck + lint) on core·compiler·router·ui·lsp·cli·vscode·design engine ──
if [ "$PDX_SKIP_QUALITY" = "1" ]; then
    echo "[pre-push] PDX_SKIP_QUALITY=1 -> quality skipped"
else
    echo "[pre-push] Quality: typecheck + lint (core · compiler · router · ui · lsp · cli · vscode · design engine)"
    pnpm typecheck || { echo "[pre-push] FAILED: typecheck. (override: git push --no-verify)"; exit 1; }
    pnpm lint || { echo "[pre-push] FAILED: lint (errors). (override: git push --no-verify)"; exit 1; }
    echo "[pre-push] OK: quality."
fi

# ── Phase 2: the suites the push affects (every suite with PDX_TEST_ALL=1) ──
if [ "$PDX_SKIP_TESTS" = "1" ]; then
    echo "[pre-push] PDX_SKIP_TESTS=1 -> suites skipped"
else
    # The site's demo pages are generated from the showcase and git-ignored. CI regenerates them in
    # `pnpm build`; here they were whatever the last port-demos wrote, maybe on another branch, and
    # the site's design check failed the push on demos of another commit (#1073).
    echo "[pre-push] Site demos: port-demos.mjs"
    node packages/site/scripts/port-demos.mjs || { echo "[pre-push] FAILED: port-demos. (override: git push --no-verify)"; exit 1; }
    if [ "$PDX_TEST_ALL" = "1" ]; then
        echo "[pre-push] Suites: pnpm test, every package  (PDX_TEST_ALL=1)"
        pnpm test || { echo "[pre-push] FAILED: suites. Push blocked. (override: git push --no-verify)"; exit 1; }
    else
        echo "[pre-push] Suites: pnpm test:affected  (every suite: PDX_TEST_ALL=1; none: PDX_SKIP_TESTS=1)"
        pnpm test:affected || { echo "[pre-push] FAILED: suites. Push blocked. (override: git push --no-verify)"; exit 1; }
    fi
    echo "[pre-push] OK: suites."
fi

# ── Phase 2b: the compiler benchmarks, ON THEIR OWN ──
#
# They stay out of `pnpm test` because there six packages compile in parallel, and a clock measures
# the machine's load as much as the compiler's cost: the gate turns red with nothing broken, and
# green on the next run. Here they run alone, the only place where the number means
# something. It takes seconds.
if [ "$PDX_SKIP_PERF" = "1" ]; then
    echo "[pre-push] PDX_SKIP_PERF=1 -> benchmarks skipped"
else
    echo "[pre-push] Compiler benchmarks: pnpm test:perf  (skip with: PDX_SKIP_PERF=1)"
    pnpm test:perf || { echo "[pre-push] FAILED: compiler benchmarks. (override: git push --no-verify)"; exit 1; }
    echo "[pre-push] OK: benchmarks."
fi

# ── Phase 3: certification, only when asked ──
if [ "$PDX_CERTIFY" != "1" ]; then
    echo "[pre-push] Certification is left to CI (certify.yml, every pull request). PDX_CERTIFY=1 runs it here first."
    exit 0
fi

echo "[pre-push] Component certification: pnpm certify"
pnpm certify
status=$?
if [ $status -ne 0 ]; then
    echo "[pre-push] FAILED: a component regression. Push blocked. (override: git push --no-verify)"
    exit $status
fi
echo "[pre-push] OK: components certified."

# Dim 5 needs the container: when the daemon is not there it says so and carries on, so a machine
# without Docker can still push with PDX_CERTIFY=1.
if [ "$PDX_SKIP_VISUAL" = "1" ]; then
    echo "[pre-push] PDX_SKIP_VISUAL=1 -> visual regression skipped"
    exit 0
fi

if ! docker info >/dev/null 2>&1; then
    echo "[pre-push] Docker is not answering -> visual regression skipped (Dim 5 is left to CI)"
    exit 0
fi

echo "[pre-push] Visual regression: pnpm certify:visual  (skip with: PDX_SKIP_VISUAL=1)"
pnpm certify:visual
status=$?
if [ $status -ne 0 ]; then
    echo "[pre-push] FAILED: screenshots differ from the baselines. Push blocked. (override: git push --no-verify)"
    exit $status
fi
echo "[pre-push] OK: visual regression."
exit 0

#!/bin/sh
# Pre-push gate. Four phases, fastest to slowest (fail-fast):
#   1) Quality outside the UI: typecheck + lint (core·compiler·router·ui·lsp·cli·design engine)  (seconds)
#   2) The suites: pnpm test, every package                          (~1 minute)
#   3) UI component certification (Dim 1-4) + the behavior suite     (minutes)
#   4) Visual regression (Dim 5) in the container, if Docker answers  (~2 minutes)
#
# Phase 2 is the only gate that runs every package's suite: `pnpm coverage` filters on four
# packages, so without it ui, cli and design would be covered by no gate at all. It is cheaper
# than certify and runs first.
#
# Skipping:
#   - Skip everything once:          git push --no-verify
#   - Skip quality only (env):       PDX_SKIP_QUALITY=1
#   - Skip the suites only (env):    PDX_SKIP_TESTS=1
#   - Skip certify only (env):       PDX_SKIP_CERTIFY=1
#   - Skip the visual only (env):    PDX_SKIP_VISUAL=1

# ── Phase 1: quality (typecheck + lint) on core·compiler·router·ui·lsp·cli·vscode·design engine ──
if [ "$PDX_SKIP_QUALITY" = "1" ]; then
    echo "[pre-push] PDX_SKIP_QUALITY=1 -> quality skipped"
else
    echo "[pre-push] Quality: typecheck + lint (core · compiler · router · ui · lsp · cli · vscode · design engine)"
    pnpm typecheck || { echo "[pre-push] FAILED: typecheck. (override: git push --no-verify)"; exit 1; }
    pnpm lint || { echo "[pre-push] FAILED: lint (errors). (override: git push --no-verify)"; exit 1; }
    echo "[pre-push] OK: quality."
fi

# ── Phase 2: the suites (every package) ──
if [ "$PDX_SKIP_TESTS" = "1" ]; then
    echo "[pre-push] PDX_SKIP_TESTS=1 -> suites skipped"
else
    echo "[pre-push] Suites: pnpm test  (skip with: PDX_SKIP_TESTS=1)"
    pnpm test || { echo "[pre-push] FAILED: suites. Push blocked. (override: git push --no-verify)"; exit 1; }
    echo "[pre-push] OK: suites."
fi

# ── Phase 2b: the compiler benchmarks, ON THEIR OWN ──
#
# They stay out of `pnpm test` because there six packages compile in parallel, and a clock measures
# the machine's load as much as the compiler's cost: the gate turns red with nothing broken, and
# green on the next run. Here they run alone, the only place where the number means
# something. It takes seconds.
if [ "$PDX_SKIP_PERF" = "1" ]; then
    echo "[pre-push] PDX_SKIP_PERF=1 -> benchmarks skipped"
else
    echo "[pre-push] Compiler benchmarks: pnpm test:perf  (skip with: PDX_SKIP_PERF=1)"
    pnpm test:perf || { echo "[pre-push] FAILED: compiler benchmarks. (override: git push --no-verify)"; exit 1; }
    echo "[pre-push] OK: benchmarks."
fi

# ── Phase 3: component certification (Dim 1-4 + the behavior suite) ──
if [ "$PDX_SKIP_CERTIFY" = "1" ]; then
    echo "[pre-push] PDX_SKIP_CERTIFY=1 -> certification skipped"
else
    echo "[pre-push] Component certification: pnpm certify  (skip with: PDX_SKIP_CERTIFY=1)"
    pnpm certify
    status=$?
    if [ $status -ne 0 ]; then
        echo "[pre-push] FAILED: a component regression. Push blocked. (override: git push --no-verify)"
        exit $status
    fi
    echo "[pre-push] OK: components certified."
fi

# ── Phase 4: visual regression (Dim 5, Docker) ──
#
# A visual check that runs only in CI lets screenshots change without a red anyone sees, so it
# runs before the push when Docker answers; when the daemon is not there it says so and carries
# on, so a machine without Docker can still push.
if [ "$PDX_SKIP_VISUAL" = "1" ]; then
    echo "[pre-push] PDX_SKIP_VISUAL=1 -> visual regression skipped"
    exit 0
fi

if ! docker info >/dev/null 2>&1; then
    echo "[pre-push] Docker is not answering -> visual regression skipped (Dim 5 is left to CI)"
    exit 0
fi

echo "[pre-push] Visual regression: pnpm certify:visual  (skip with: PDX_SKIP_VISUAL=1)"
pnpm certify:visual
status=$?
if [ $status -ne 0 ]; then
    echo "[pre-push] FAILED: screenshots differ from the baselines. Push blocked. (override: git push --no-verify)"
    exit $status
fi
echo "[pre-push] OK: visual regression."
exit 0

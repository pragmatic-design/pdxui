<template>
  <form class="pdx-form" @submit="handleSubmit">
    <div class="field">
      <label for="name-input">Name</label>
      <input id="name-input" type="text" ::value="name" :disabled="submitting" />
      @if (nameError) {
        <span class="error">{{ nameError }}</span>
      }
    </div>

    <div class="field">
      <label for="email-input">Email</label>
      <input id="email-input" type="email" ::value="email" :disabled="submitting" />
      @if (emailError) {
        <span class="error">{{ emailError }}</span>
      }
    </div>

    <div class="actions">
      <button type="submit" :disabled="submitting">
        @if (submitting) { Saving... } @else { Save }
      </button>
      <button type="button" @click="reset" :disabled="submitting">Reset</button>
    </div>
  </form>
</template>

<script setup>
  @prop initialName: string = '';
  @prop initialEmail: string = '';
  @event formsubmit: { name: string; email: string };

  let name = $signal(initialName);
  let email = $signal(initialEmail);
  let submitting = $signal(false);

  const nameError = $derived(name.length === 0 ? 'Name is required' : '');
  const emailError = $derived(
    email.length === 0 ? 'Email is required' :
    !email.includes('@') ? 'Invalid email' : ''
  );
  const isValid = $derived(!nameError && !emailError);

  function handleSubmit(e) {
    e.preventDefault();
    if (!isValid) return;
    submitting = true;
    $emit('formsubmit', { name, email });
  }

  function reset() {
    name = initialName;
    email = initialEmail;
  }
</script>

<style scoped>
  .pdx-form { display: flex; flex-direction: column; gap: 1rem; max-width: 400px; }
  .field { display: flex; flex-direction: column; gap: 0.25rem; }
  .field label { font-weight: 600; font-size: 0.875rem; }
  .field input { padding: 0.5rem; border: 1px solid var(--pdx-color-border-strong); border-radius: 4px; }
  .field input:disabled { opacity: 0.6; }
  .error { color: var(--pdx-color-danger-ink); font-size: 0.8rem; }
  .actions { display: flex; gap: 0.5rem; }
  button { padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer; }
  button[type="submit"] { background: var(--pdx-color-primary); color: var(--pdx-color-primary-text); border: none; }
  button[type="submit"]:disabled { opacity: 0.6; cursor: not-allowed; }
  button[type="button"] { background: var(--pdx-color-surface); border: 1px solid var(--pdx-color-border-strong); }
</style>

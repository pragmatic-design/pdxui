.githooks/** text eol=lf
*.sh text eol=lf

# A script that starts with `#!`: checked out with CRLF, its shebang ends in `\r` and vitest cannot
# import it. Every .mjs/.cjs, so a new script is covered, and the CLI's entry by name.
# packages/core/tests/shebang-eol.test.ts fails on a shebang file this misses.
*.mjs text eol=lf
*.cjs text eol=lf
packages/cli/src/index.ts text eol=lf

# Generated by tests/tooling/generate.ts, which writes LF: without this every run of
# `pnpm certify` dirties 15 tracked files with no change of content.
packages/ui/tests/scenarios/generated/** text eol=lf

# Written by packages/ui/scripts/gen-manifest.mjs and gen-exports.mjs, which both emit LF.
# Same cure as above, and it is only half of the cure: `text eol=lf` settles the line TERMINATORS,
# so `pnpm build` does not report these two as modified. It does nothing for a `\r\n` sitting
# INSIDE a JSON string value — that is content to git, and it is fixed in the generator instead
# (normalizeEol in gen-manifest.mjs).
packages/ui/custom-elements.json text eol=lf
packages/ui/package.json text eol=lf
